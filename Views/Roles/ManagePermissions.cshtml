@model IEnumerable<Manage_KPI_or_OKR_System.Models.Permission>
@using System.Globalization
@{
    var role = ViewBag.Role as Manage_KPI_or_OKR_System.Models.Role;
    var rolePermissionIds = ViewBag.RolePermissionIds as List<int> ?? new List<int>();
    var canEditPermissions = ViewBag.CanEditPermissions is bool canEdit && canEdit;
    ViewData["Title"] = $"Cấu hình quyền cho {role?.RoleName}";

    (string Key, string Title, string Icon, string Accent, string SoftBg, string SoftBorder) GetGroupMeta(string? code)
    {
        var normalized = (code ?? string.Empty).ToUpperInvariant();

        if (normalized.StartsWith("EMPLOYEES_")) return ("employees", "Quản lý Nhân viên", "people-fill", "#1a73e8", "rgba(26, 115, 232, 0.08)", "rgba(26, 115, 232, 0.16)");
        if (normalized.StartsWith("DEPARTMENTS_")) return ("departments", "Quản lý Phòng ban", "building-fill", "#0f9d58", "rgba(15, 157, 88, 0.08)", "rgba(15, 157, 88, 0.16)");
        if (normalized.StartsWith("POSITIONS_")) return ("positions", "Quản lý Chức vụ", "person-badge-fill", "#7c4dff", "rgba(124, 77, 255, 0.08)", "rgba(124, 77, 255, 0.16)");
        if (normalized.StartsWith("KPIS_")) return ("kpis", "Quản lý KPI", "speedometer2", "#f29900", "rgba(242, 153, 0, 0.08)", "rgba(242, 153, 0, 0.16)");
        if (normalized.StartsWith("KPICHECKINS_")) return ("kpicheckins", "Cập nhật tiến độ KPI", "check2-square", "#0f9d58", "rgba(15, 157, 88, 0.08)", "rgba(15, 157, 88, 0.16)");
        if (normalized.StartsWith("OKRS_")) return ("okrs", "Quản lý OKR / Mục tiêu", "bullseye", "#d93025", "rgba(217, 48, 37, 0.08)", "rgba(217, 48, 37, 0.16)");
        if (normalized.StartsWith("EVALPERIODS_")) return ("evalperiods", "Kỳ đánh giá", "calendar3", "#4285f4", "rgba(66, 133, 244, 0.08)", "rgba(66, 133, 244, 0.16)");
        if (normalized.StartsWith("EVALRESULTS_")) return ("evalresults", "Kết quả đánh giá", "award-fill", "#0f9d58", "rgba(15, 157, 88, 0.08)", "rgba(15, 157, 88, 0.16)");
        if (normalized.StartsWith("EVALREPORTS_")) return ("evalreports", "Báo cáo đánh giá", "bar-chart-fill", "#1a73e8", "rgba(26, 115, 232, 0.08)", "rgba(26, 115, 232, 0.16)");
        if (normalized.StartsWith("BONUSRULES_")) return ("bonusrules", "Quy tắc thưởng", "cash-coin", "#f29900", "rgba(242, 153, 0, 0.08)", "rgba(242, 153, 0, 0.16)");
        if (normalized.StartsWith("MISSIONS_")) return ("missions", "Sứ mệnh & Tầm nhìn", "compass-fill", "#5b6cff", "rgba(91, 108, 255, 0.08)", "rgba(91, 108, 255, 0.16)");
        if (normalized.StartsWith("SYSUSERS_")) return ("sysusers", "Người dùng hệ thống", "shield-lock-fill", "#1557b0", "rgba(21, 87, 176, 0.08)", "rgba(21, 87, 176, 0.16)");
        if (normalized.StartsWith("ROLES_")) return ("roles", "Phân quyền (Roles)", "diagram-3-fill", "#d93025", "rgba(217, 48, 37, 0.08)", "rgba(217, 48, 37, 0.16)");
        if (normalized.StartsWith("AUDITLOGS_")) return ("auditlogs", "Nhật ký hệ thống", "journal-text", "#5f6368", "rgba(95, 99, 104, 0.08)", "rgba(95, 99, 104, 0.16)");

        if (normalized.StartsWith("WORKITEMS_")) return ("workitems", "Công việc (Kanban)", "kanban", "#10b981", "rgba(16, 185, 129, 0.08)", "rgba(16, 185, 129, 0.16)");
        if (normalized.StartsWith("WORKPROJECTS_")) return ("workprojects", "Dự án cộng tác", "folder-fill", "#3b82f6", "rgba(59, 130, 246, 0.08)", "rgba(59, 130, 246, 0.16)");
        if (normalized.StartsWith("CHECKINS_")) return ("checkins", "Check-in tiến độ", "check2-circle", "#6366f1", "rgba(99, 102, 241, 0.08)", "rgba(99, 102, 241, 0.16)");
        if (normalized.StartsWith("CATALOG_")) return ("catalog", "Danh mục hệ thống", "list-nested", "#8b5cf6", "rgba(139, 92, 246, 0.08)", "rgba(139, 92, 246, 0.16)");
        if (normalized.StartsWith("EVALUATIONS_")) return ("evaluations", "Đánh giá hiệu suất", "trophy-fill", "#f59e0b", "rgba(245, 158, 11, 0.08)", "rgba(245, 158, 11, 0.16)");
        if (normalized.StartsWith("BONUS_")) return ("bonus", "Thưởng & Bonus", "gift-fill", "#ec4899", "rgba(236, 72, 153, 0.08)", "rgba(236, 72, 153, 0.16)");
        if (normalized.StartsWith("REPORTS_")) return ("reports", "Báo cáo tổng hợp", "file-earmark-bar-graph", "#06b6d4", "rgba(6, 182, 212, 0.08)", "rgba(6, 182, 212, 0.16)");

        if (normalized.StartsWith("ADMIN_")) return ("legacy-admin", "Cấu hình Hệ thống (cũ)", "gear-fill", "#5f6368", "rgba(95, 99, 104, 0.08)", "rgba(95, 99, 104, 0.16)");
        if (normalized.StartsWith("HR_")) return ("legacy-hr", "Quản trị Nhân sự (cũ)", "people-fill", "#5f6368", "rgba(95, 99, 104, 0.08)", "rgba(95, 99, 104, 0.16)");
        if (normalized.StartsWith("MANAGER_")) return ("legacy-manager", "Quản lý OKR & KPI (cũ)", "clipboard-data-fill", "#5f6368", "rgba(95, 99, 104, 0.08)", "rgba(95, 99, 104, 0.16)");
        if (normalized.StartsWith("EMPLOYEE_")) return ("legacy-employee", "Tác vụ Nhân viên (cũ)", "person-fill", "#5f6368", "rgba(95, 99, 104, 0.08)", "rgba(95, 99, 104, 0.16)");
        if (normalized.StartsWith("SALES_")) return ("legacy-sales", "Kinh doanh & Khách hàng (cũ)", "graph-up-arrow", "#5f6368", "rgba(95, 99, 104, 0.08)", "rgba(95, 99, 104, 0.16)");
        if (normalized.StartsWith("WAREHOUSE_")) return ("legacy-warehouse", "Quản lý Kho (cũ)", "boxes", "#5f6368", "rgba(95, 99, 104, 0.08)", "rgba(95, 99, 104, 0.16)");
        if (normalized.StartsWith("DELIVERY_")) return ("legacy-delivery", "Vận chuyển (cũ)", "truck", "#5f6368", "rgba(95, 99, 104, 0.08)", "rgba(95, 99, 104, 0.16)");

        return ("other", "Nhóm khác", "grid-3x3-gap-fill", "#5f6368", "rgba(95, 99, 104, 0.08)", "rgba(95, 99, 104, 0.16)");
    }

    (string Label, string ClassName) GetActionMeta(string? code)
    {
        var normalized = (code ?? string.Empty).ToUpperInvariant();
        var parts = normalized.Split('_', StringSplitOptions.RemoveEmptyEntries);
        var action = parts.Length > 0 ? parts[parts.Length - 1] : string.Empty;

        return action switch
        {
            "VIEW" => ("Xem", "action-view"),
            "CREATE" => ("Tạo", "action-create"),
            "EDIT" => ("Sửa", "action-edit"),
            "DELETE" => ("Xóa", "action-delete"),
            "REVIEW" => ("Duyệt", "action-review"),
            _ => ("Khác", "action-other")
        };
    }

    var permissions = Model?.ToList() ?? new List<Manage_KPI_or_OKR_System.Models.Permission>();
    var selectedPermissionSet = rolePermissionIds.Distinct().ToHashSet();
    var groupedPermissions = permissions
        .Select(permission => new { Permission = permission, Meta = GetGroupMeta(permission.PermissionCode) })
        .GroupBy(x => x.Meta.Key)
        .Select(g => new
        {
            Key = g.Key,
            Title = g.First().Meta.Title,
            Icon = g.First().Meta.Icon,
            Accent = g.First().Meta.Accent,
            SoftBg = g.First().Meta.SoftBg,
            SoftBorder = g.First().Meta.SoftBorder,
            Permissions = g.Select(x => x.Permission)
                .OrderBy(p => p.PermissionName)
                .ThenBy(p => p.PermissionCode)
                .ToList()
        })
        .OrderBy(g => g.Title)
        .ToList();

    var totalPermissions = permissions.Count;
    var selectedPermissions = permissions.Count(p => selectedPermissionSet.Contains(p.Id));
    var groupCount = groupedPermissions.Count;
    var selectedGroupCount = groupedPermissions.Count(g => g.Permissions.Any(p => selectedPermissionSet.Contains(p.Id)));
    var selectionPercent = totalPermissions == 0 ? 0 : (int)Math.Round((double)selectedPermissions * 100 / totalPermissions);
    var roleDescription = string.IsNullOrWhiteSpace(role?.Description)
        ? "Thiết lập quyền truy cập cho vai trò này."
        : role!.Description!;
}

<div class="container-fluid px-0 permissions-page">
    <!-- PAGE HEADER -->
    <div class="page-header d-flex justify-content-between align-items-center gap-3 mb-3.5">
        <div>
            <h1 class="h4 font-weight-bold mb-1">
                Cấu hình quyền: <span class="text-primary">@role?.RoleName</span>
            </h1>
            <div class="page-breadcrumb">
                <a asp-action="Index">Quản lý roles</a>
                <i class="bi bi-chevron-right separator"></i>
                <span>Cấu hình quyền</span>
            </div>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <!-- HERO SUMMARY (VIBRANT & HIGH CONTRAST) -->
    <div class="permissions-hero mb-3.5">
        <div class="permissions-hero-content">
            <div class="min-w-0">
                <span class="permissions-hero-kicker">
                    <i class="bi bi-shield-lock-fill me-1.5"></i> Permission Mapping
                </span>
                <h2 class="permissions-hero-title">@role?.RoleName</h2>
                <p class="permissions-hero-copy mb-0">@roleDescription</p>
            </div>
            <div class="permissions-hero-summary">
                <div class="permissions-hero-summary-label">Tiến độ cấu hình</div>
                <div class="permissions-hero-summary-value">
                    <span id="selectedPermissionHero">@selectedPermissions</span><span class="permissions-hero-total opacity-75">/@totalPermissions</span>
                </div>
                <div class="permissions-hero-progress">
                    <div id="selectedPermissionHeroBar" style="transform:scaleX(@((selectionPercent / 100d).ToString(CultureInfo.InvariantCulture)));transform-origin:left;"></div>
                </div>
                <div class="permissions-hero-summary-meta">@selectionPercent% permission đã được gán</div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS (EVEN GRID) -->
    <div class="permissions-stats-grid mb-3.5">
        <div class="permission-stat-card">
            <div class="permission-stat-icon text-primary">
                <i class="bi bi-key-fill"></i>
            </div>
            <div>
                <div class="permission-stat-value">@totalPermissions</div>
                <div class="permission-stat-label">Tổng quyền</div>
            </div>
        </div>
        <div class="permission-stat-card">
            <div class="permission-stat-icon text-success">
                <i class="bi bi-check2-square"></i>
            </div>
            <div>
                <div id="selectedPermissionCount" class="permission-stat-value text-success">@selectedPermissions</div>
                <div class="permission-stat-label">Đã chọn</div>
            </div>
        </div>
        <div class="permission-stat-card">
            <div class="permission-stat-icon text-info">
                <i class="bi bi-collection-fill"></i>
            </div>
            <div>
                <div class="permission-stat-value text-info">@groupCount</div>
                <div class="permission-stat-label">Nhóm chức năng</div>
            </div>
        </div>
        <div class="permission-stat-card">
            <div class="permission-stat-icon text-warning">
                <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div>
                <div id="selectedGroupCount" class="permission-stat-value text-warning">@selectedGroupCount</div>
                <div class="permission-stat-label">Nhóm kích hoạt</div>
            </div>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="content-card permission-toolbar-card mb-3.5">
        <div class="card-body-custom p-2.5 px-3">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2.5">
                <div class="permission-search-wrap">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           id="permissionSearch"
                           class="form-control"
                           placeholder="Tìm theo tên quyền hoặc mã quyền..."
                           autocomplete="off">
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" id="selectVisiblePermissions" class="btn btn-sm btn-outline-primary rounded-pill px-3" disabled="@(canEditPermissions ? null : "disabled")">
                        <i class="bi bi-check2-all me-1"></i> Chọn đang hiển thị
                    </button>
                    <button type="button" id="clearAllPermissions" class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled="@(canEditPermissions ? null : "disabled")">
                        <i class="bi bi-eraser me-1"></i> Bỏ chọn tất cả
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- FORM & MASONRY MULTI-COLUMN CARDS GRID -->
    <form asp-action="UpdatePermissions" method="post" id="permissionForm">
        <input type="hidden" name="roleId" value="@role?.Id" />

        <div class="permissions-cards-grid">
            @foreach (var group in groupedPermissions)
            {
                var checkedCount = group.Permissions.Count(p => selectedPermissionSet.Contains(p.Id));
                var isFullyChecked = checkedCount == group.Permissions.Count && group.Permissions.Count > 0;

                <div class="permission-group-col" data-group-column="@group.Key">
                    <div class="content-card permission-group-card"
                         style="--group-accent:@group.Accent; --group-soft:@group.SoftBg; --group-border:@group.SoftBorder;">
                        <div class="card-header-custom permission-group-header border-bottom">
                            <div class="permission-group-header-inner">
                                <div class="permission-group-title-wrap">
                                    <div class="permission-group-icon">
                                        <i class="bi bi-@group.Icon"></i>
                                    </div>
                                    <div class="permission-group-text">
                                        <h6 class="mb-0 text-truncate fw-bold group-title" title="@group.Title">@group.Title</h6>
                                        <div class="permission-group-meta">
                                            <span id="group-counter-@group.Key">@checkedCount/@group.Permissions.Count đã chọn</span>
                                        </div>
                                    </div>
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold select-all-group"
                                        data-group="@group.Key"
                                        disabled="@(canEditPermissions ? null : "disabled")">
                                    @(isFullyChecked ? "Bỏ chọn tất cả" : "Chọn tất cả")
                                </button>
                            </div>
                        </div>
                        <div class="card-body-custom p-2.5 px-3">
                            <div class="permission-list">
                                @foreach (var permission in group.Permissions)
                                {
                                    var actionMeta = GetActionMeta(permission.PermissionCode);
                                    var isChecked = selectedPermissionSet.Contains(permission.Id);
                                    var permissionName = string.IsNullOrWhiteSpace(permission.PermissionName) ? permission.PermissionCode : permission.PermissionName;

                                    <label class="permission-item @(isChecked ? "is-checked" : string.Empty)"
                                           data-permission-item
                                           data-group-key="@group.Key"
                                           data-filter-text="@($"{permissionName} {permission.PermissionCode}".ToLowerInvariant())">
                                        <input class="form-check-input permission-checkbox"
                                               type="checkbox"
                                               name="permissionIds"
                                               value="@permission.Id"
                                               data-group-key="@group.Key"
                                               disabled="@(canEditPermissions ? null : "disabled")"
                                               @(isChecked ? "checked" : string.Empty)>
                                        <div class="permission-item-content">
                                            <div class="permission-item-top">
                                                <span class="permission-name" title="@permissionName">@permissionName</span>
                                                <span class="permission-action-badge @actionMeta.ClassName">@actionMeta.Label</span>
                                            </div>
                                            <div class="permission-code">@permission.PermissionCode</div>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- SAVE BAR -->
        <div class="permission-save-bar mt-4 mb-4">
            <div class="permission-save-summary">
                <div class="permission-save-title">
                    Đã chọn <strong id="selectedPermissionFooter">@selectedPermissions</strong> trên <strong>@totalPermissions</strong> permission
                </div>
                <div class="permission-save-progress">
                    <div id="selectedPermissionFooterBar" style="transform:scaleX(@((selectionPercent / 100d).ToString(CultureInfo.InvariantCulture)));transform-origin:left;"></div>
                </div>
            </div>
            @if (canEditPermissions)
            {
                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <button type="reset" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Hoàn tác</button>
                    <button type="submit" class="btn-primary-custom rounded-pill px-4 shadow-sm btn-sm" style="height: 36px;">
                        <i class="bi bi-save me-1.5"></i> Lưu cấu hình quyền
                    </button>
                </div>
            }
            else
            {
                <div class="text-muted small"><i class="bi bi-eye me-1" aria-hidden="true"></i>Chế độ chỉ xem</div>
            }
        </div>
    </form>
</div>

<style>
    .permissions-page .mb-3\.5 {
        margin-bottom: 1.25rem !important;
    }

    /* HERO BANNER - MODERN WHITE CARD THEME */
    .permissions-page .permissions-hero {
        position: relative !important;
        overflow: hidden !important;
        padding: 18px 24px !important;
        border-radius: 14px !important;
        background: #ffffff !important;
        color: #1e293b !important;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05), 0 4px 12px -2px rgba(15, 23, 42, 0.03) !important;
        border: 1px solid #e2e8f0 !important;
        margin-bottom: 1.25rem !important;
    }

    .permissions-page .permissions-hero-content {
        position: relative !important;
        z-index: 1 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        gap: 20px !important;
    }

    .permissions-page .permissions-hero-kicker {
        display: inline-flex !important;
        align-items: center !important;
        padding: 4px 12px !important;
        border-radius: 999px !important;
        background: #eef2ff !important;
        color: #4f46e5 !important;
        font-size: 0.68rem !important;
        font-weight: 750 !important;
        letter-spacing: 0.06em !important;
        text-transform: uppercase !important;
        margin-bottom: 6px !important;
        border: 1px solid #c7d2fe !important;
    }

    .permissions-page .permissions-hero-title {
        font-size: 1.35rem !important;
        font-weight: 850 !important;
        color: #1e293b !important;
        margin: 0 0 4px !important;
        line-height: 1.25 !important;
        letter-spacing: -0.015em !important;
        text-shadow: none !important;
    }

    .permissions-page .permissions-hero-copy {
        max-width: 680px !important;
        color: #64748b !important;
        font-size: 0.84rem !important;
        line-height: 1.55 !important;
    }

    /* TIẾN ĐỘ CẤU HÌNH - SOFT SUMMARY CARD */
    .permissions-page .permissions-hero-summary {
        min-width: 220px !important;
        padding: 14px 20px !important;
        border-radius: 12px !important;
        background: #f8fafc !important;
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
        color: #1e293b !important;
    }

    .permissions-page .permissions-hero-summary-label {
        font-size: 0.68rem !important;
        text-transform: uppercase !important;
        letter-spacing: 0.07em !important;
        color: #64748b !important;
        font-weight: 800 !important;
    }

    .permissions-page .permissions-hero-summary-value {
        margin: 4px 0 !important;
        font-size: 1.7rem !important;
        line-height: 1.15 !important;
        font-weight: 850 !important;
        color: #1e293b !important;
        letter-spacing: -0.02em !important;
    }

    .permissions-page .permissions-hero-summary-value #selectedPermissionHero {
        color: #1e293b !important;
    }

    .permissions-page .permissions-hero-summary-value .permissions-hero-total {
        color: #94a3b8 !important;
        font-weight: 650 !important;
        font-size: 1.35rem !important;
    }

    .permissions-page .permissions-hero-progress {
        width: 100% !important;
        height: 7px !important;
        border-radius: 999px !important;
        overflow: hidden !important;
        background: #e2e8f0 !important;
        border: none !important;
        margin-top: 6px !important;
    }

    .permissions-page .permissions-hero-progress > div {
        height: 100% !important;
        border-radius: inherit !important;
        background: linear-gradient(90deg, #4f46e5 0%, #06b6d4 100%) !important;
        box-shadow: none !important;
        width: 100% !important;
        transform-origin: left !important;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }

    .permissions-page .permissions-hero-summary-meta {
        margin-top: 6px !important;
        color: #64748b !important;
        font-size: 0.76rem !important;
        font-weight: 600 !important;
    }

    /* STATS GRID - SHARP & CRISP */
    .permissions-page .permissions-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.25rem;
    }

    .permissions-page .permission-stat-card {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
        padding: 14px 18px;
        border-radius: 12px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .permissions-page .permission-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    }

    .permissions-page .permission-stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        background: #f1f5f9;
        flex-shrink: 0;
    }

    .permissions-page .permission-stat-value {
        font-size: 1.35rem;
        font-weight: 850;
        color: #0f172a;
        line-height: 1.1;
    }

    .permissions-page .permission-stat-label {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 600;
        margin-top: 2px;
    }

    .permissions-page .permission-toolbar-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .permissions-page .permission-search-wrap {
        position: relative;
        width: min(100%, 380px);
    }

    .permissions-page .permission-search-wrap i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 0.85rem;
    }

