@model IEnumerable<Manage_KPI_or_OKR_System.Models.Role>
@{
    ViewData["Title"] = "Phân quyền Hệ thống";

    var roles = Model?.ToList() ?? new List<Manage_KPI_or_OKR_System.Models.Role>();
    var orderedRoles = roles
        .OrderByDescending(role => IsProtectedRole(role.RoleName))
        .ThenBy(role => role.RoleName)
        .ToList();
    var activeRoles = roles.Count(role => role.IsActive != false);
    var protectedRoles = roles.Count(role => IsProtectedRole(role.RoleName));
    var describedRoles = roles.Count(role => !string.IsNullOrWhiteSpace(role.Description));
    var isRoleAdmin = User.IsInRole("Admin") || User.IsInRole("Administrator");
    var canCreateRoles = isRoleAdmin || User.HasClaim("Permission", "ROLES_CREATE");
    var canDeleteRoles = isRoleAdmin || User.HasClaim("Permission", "ROLES_DELETE");

    bool IsProtectedRole(string? roleName)
    {
        var normalized = (roleName ?? string.Empty).Trim().ToLowerInvariant();
        return normalized is "admin" or "administrator";
    }

    string GetRoleKind(string? roleName)
    {
        var normalized = (roleName ?? string.Empty).Trim().ToLowerInvariant();

        if (IsProtectedRole(roleName)) return "Vai trò hệ thống";
        if (normalized.Contains("director")) return "Vai trò điều hành";
        if (normalized.Contains("manager") || normalized.Contains("leader")) return "Vai trò quản lý";
        if (normalized.Contains("hr") || normalized.Contains("human")) return "Vai trò nhân sự";
        if (normalized.Contains("sale") || normalized.Contains("business")) return "Vai trò kinh doanh";
        if (normalized.Contains("employee")) return "Vai trò nhân viên";
        return "Vai trò tùy chỉnh";
    }

    string GetRoleIcon(string? roleName)
    {
        var normalized = (roleName ?? string.Empty).Trim().ToLowerInvariant();

        if (IsProtectedRole(roleName)) return "bi-shield-lock";
        if (normalized.Contains("director") || normalized.Contains("manager") || normalized.Contains("leader")) return "bi-briefcase";
        if (normalized.Contains("hr") || normalized.Contains("human")) return "bi-people";
        return "bi-person-badge";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <style>
        .roles-page .roles-header-copy {
            max-width: 680px;
            margin: 0 0 0.35rem;
            color: var(--evaluation-muted);
            font-size: 0.88rem;
        }

        .roles-page .roles-header-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.6rem;
            flex-wrap: wrap;
        }

        .roles-page .roles-header-actions form {
            margin: 0;
        }

        .roles-page .roles-summary {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .roles-page .roles-summary article:nth-child(1) strong { color: #1d4ed8; }
        .roles-page .roles-summary article:nth-child(2) strong { color: #087466; }
        .roles-page .roles-summary article:nth-child(3) strong { color: #b42318; }
        .roles-page .roles-summary article:nth-child(4) strong { color: #6b6478; }

        .roles-page .roles-table {
            min-width: 880px;
        }

        .roles-page .role-identity {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 190px;
        }

        .roles-page .role-mark {
            display: inline-grid;
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
            place-items: center;
            border-radius: 8px;
            background: var(--evaluation-brand-soft);
            color: var(--evaluation-brand);
            font-size: 1rem;
        }

        .roles-page .role-mark--system {
            border: 1px solid #f4c8c3;
            background: #fff0ee;
            color: #b42318;
        }

        .roles-page .role-identity strong,
        .roles-page .role-identity small {
            display: block;
        }

        .roles-page .role-identity strong {
            font-size: 0.92rem;
        }

        .roles-page .role-identity small,
        .roles-page .role-description,
        .roles-page .role-created {
            color: var(--evaluation-muted);
            font-size: 0.78rem;
        }

        .roles-page .role-description {
            max-width: 420px;
            line-height: 1.5;
        }

        .roles-page .role-kind {
            display: inline-flex;
            align-items: center;
            min-height: 28px;
            border: 1px solid var(--evaluation-line);
            border-radius: 7px;
            padding: 0.3rem 0.55rem;
            background: var(--evaluation-soft);
            color: #475467;
            font-size: 0.72rem;
            font-weight: 750;
            white-space: nowrap;
        }

        .roles-page .role-kind--system {
            border-color: #f4c8c3;
            background: #fff0ee;
            color: #b42318;
        }

        .roles-page .role-manage-action {
            min-height: 36px;
            padding: 0.5rem 0.75rem;
            font-size: 0.75rem;
            white-space: nowrap;
        }

        .roles-page .role-manage-action.is-disabled {
            color: var(--evaluation-muted);
            cursor: default;
            opacity: 0.8;
        }

        .roles-page .role-card-description {
            min-height: 2.4rem;
            line-height: 1.55;
        }

        @@media (max-width: 900px) {
            .roles-page .roles-summary {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .roles-page .roles-summary article:last-child {
                grid-column: auto;
            }

            .roles-page .role-card .evaluation-card-footer {
                align-items: flex-end;
            }
        }

        @@media (max-width: 575.98px) {
            .roles-page .evaluation-page-header {
                flex-direction: column;
            }

            .roles-page .roles-header-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                width: 100%;
            }

            .roles-page .roles-header-actions form,
            .roles-page .roles-header-actions button,
            .roles-page .roles-header-actions a {
                width: 100%;
            }

            .roles-page .evaluation-page-header .evaluation-primary-action span {
                display: inline;
            }

            .roles-page .role-card .evaluation-card-footer {
                display: grid;
            }

            .roles-page .role-card .evaluation-card-footer > a,
            .roles-page .role-card .evaluation-card-footer > span {
                width: 100%;
            }
        }
    </style>
}

<div class="evaluation-page roles-page">
    <header class="evaluation-page-header">
        <div>
            <h1>Phân quyền Hệ thống</h1>
            <p class="roles-header-copy">Quản lý vai trò và phạm vi truy cập của từng nhóm người dùng trong hệ thống.</p>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Hệ thống</span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Phân quyền</span>
            </nav>
        </div>
        @if (canCreateRoles)
        {
            <div class="roles-header-actions">
                <form asp-action="SyncPermissions" method="post">
                    <button type="submit" class="evaluation-secondary-action">
                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                        <span>Đồng bộ quyền</span>
                    </button>
                </form>
                <a asp-action="Create" class="evaluation-primary-action page-create-action">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>Tạo vai trò</span>
                </a>
            </div>
        }
    </header>

    <section class="evaluation-summary roles-summary" aria-label="Tổng quan phân quyền">
        <article>
            <span>Tổng vai trò</span>
            <strong>@roles.Count</strong>
            <small>Nhóm quyền trong hệ thống</small>
        </article>
        <article>
            <span>Đang hoạt động</span>
            <strong>@activeRoles</strong>
            <small>Có thể gán cho tài khoản</small>
        </article>
        <article>
            <span>Vai trò hệ thống</span>
            <strong>@protectedRoles</strong>
            <small>Được bảo vệ khỏi chỉnh sửa</small>
        </article>
        <article>
            <span>Đã có mô tả</span>
            <strong>@describedRoles</strong>
            <small>@describedRoles / @roles.Count vai trò đầy đủ thông tin</small>
        </article>
    </section>

    <section class="evaluation-results" aria-labelledby="roleResultsHeading">
        <div class="evaluation-results-heading">
            <strong id="roleResultsHeading">Danh sách vai trò</strong>
            <span>@roles.Count vai trò được hiển thị</span>
        </div>

        @if (!orderedRoles.Any())
        {
            <div class="evaluation-empty" role="status">
                <span class="evaluation-empty-icon"><i class="bi bi-shield-x" aria-hidden="true"></i></span>
                <h2>Chưa có vai trò nào</h2>
                <p>Tạo vai trò đầu tiên để phân tách phạm vi truy cập theo chức năng và trách nhiệm.</p>
                @if (canCreateRoles)
                {
                    <a asp-action="Create" class="evaluation-primary-action page-create-action"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Tạo vai trò</span></a>
                }
            </div>
        }
        else
        {
            <div class="evaluation-table-shell">
                <table class="evaluation-table roles-table" aria-label="Danh sách vai trò hệ thống">
                    <thead>
                        <tr>
                            <th>Vai trò</th>
                            <th>Mô tả</th>
                            <th>Phạm vi</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in orderedRoles)
                        {
                            var isProtected = IsProtectedRole(role.RoleName);
                            var isActive = role.IsActive != false;
                            var roleName = string.IsNullOrWhiteSpace(role.RoleName) ? $"Vai trò #{role.Id}" : role.RoleName;
                            var description = string.IsNullOrWhiteSpace(role.Description) ? "Chưa có mô tả phạm vi quyền hạn." : role.Description;
                            var roleKind = GetRoleKind(role.RoleName);
                            <tr>
                                <td>
                                    <div class="role-identity">
                                        <span class="role-mark @(isProtected ? "role-mark--system" : string.Empty)" aria-hidden="true">
                                            <i class="bi @GetRoleIcon(role.RoleName)"></i>
                                        </span>
                                        <div>
                                            <strong>@roleName</strong>
                                            <small>Mã vai trò: #@role.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td><div class="role-description">@description</div></td>
                                <td><span class="role-kind @(isProtected ? "role-kind--system" : string.Empty)">@roleKind</span></td>
                                <td>
                                    <span class="evaluation-status @(isActive ? "evaluation-status--running" : "evaluation-status--closed")">
                                        <span aria-hidden="true"></span>@(isActive ? "Đang hoạt động" : "Tạm khóa")
                                    </span>
                                </td>
                                <td><span class="role-created">@(role.CreatedAt?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</span></td>
                                <td>
                                    <div class="evaluation-actions">
                                        @if (isProtected)
                                        {
                                            <span class="evaluation-secondary-action role-manage-action is-disabled" aria-label="Vai trò hệ thống được bảo vệ">
                                                <i class="bi bi-lock" aria-hidden="true"></i>Hệ thống
                                            </span>
                                        }
                                        else
                                        {
                                            <a asp-action="ManagePermissions" asp-route-id="@role.Id" class="evaluation-secondary-action role-manage-action" aria-label="Cấu hình quyền cho @roleName">
                                                <i class="bi bi-sliders" aria-hidden="true"></i>Cấu hình quyền
                                            </a>
                                        }
                                        @if (canDeleteRoles && !isProtected)
                                        {
                                            <form asp-action="Delete" asp-route-id="@role.Id" method="post"
                                                  data-app-confirm
                                                  data-confirm-title="Xóa vai trò?"
                                                  data-confirm-message="Vai trò “@roleName” sẽ bị xóa nếu không còn tài khoản sử dụng."
                                                  data-confirm-tone="danger"
                                                  data-confirm-label="Xóa vai trò">
                                                <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa vai trò" aria-label="Xóa vai trò @roleName">
                                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="evaluation-mobile-list">
                @foreach (var role in orderedRoles)
                {
                    var isProtected = IsProtectedRole(role.RoleName);
                    var isActive = role.IsActive != false;
                    var roleName = string.IsNullOrWhiteSpace(role.RoleName) ? $"Vai trò #{role.Id}" : role.RoleName;
                    var description = string.IsNullOrWhiteSpace(role.Description) ? "Chưa có mô tả phạm vi quyền hạn." : role.Description;
                    <article class="evaluation-period-card role-card">
                        <div class="evaluation-card-topline">
                            <span class="evaluation-status @(isActive ? "evaluation-status--running" : "evaluation-status--closed")">
                                <span aria-hidden="true"></span>@(isActive ? "Đang hoạt động" : "Tạm khóa")
                            </span>
                            <span class="role-kind @(isProtected ? "role-kind--system" : string.Empty)">@GetRoleKind(role.RoleName)</span>
                        </div>
                        <h2>@roleName</h2>
                        <p class="role-card-description">@description</p>
                        <dl>
                            <div><dt>Mã vai trò</dt><dd>#@role.Id</dd></div>
                            <div><dt>Ngày tạo</dt><dd>@(role.CreatedAt?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</dd></div>
                        </dl>
                        <div class="evaluation-card-footer">
                            @if (isProtected)
                            {
                                <span class="evaluation-secondary-action role-manage-action is-disabled"><i class="bi bi-lock" aria-hidden="true"></i>Vai trò hệ thống</span>
                            }
                            else
                            {
                                <a asp-action="ManagePermissions" asp-route-id="@role.Id">Cấu hình quyền</a>
                            }
                            @if (canDeleteRoles && !isProtected)
                            {
                                <div class="evaluation-actions">
                                    <form asp-action="Delete" asp-route-id="@role.Id" method="post"
                                          data-app-confirm
                                          data-confirm-title="Xóa vai trò?"
                                          data-confirm-message="Vai trò “@roleName” sẽ bị xóa nếu không còn tài khoản sử dụng."
                                          data-confirm-tone="danger"
                                          data-confirm-label="Xóa vai trò">
                                        <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" aria-label="Xóa vai trò @roleName trên thẻ di động">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
