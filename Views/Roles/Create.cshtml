@model Manage_KPI_or_OKR_System.Models.Role

@{
    ViewData["Title"] = "Tạo Vai Trò Mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cf-page role-create-page" data-create-form>
    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Tạo vai trò mới</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Vai trò &amp; phân quyền</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Tạo mới</span>
            </nav>
            <p class="cf-header__description">Tạo nhóm vai trò để phân quyền truy cập phù hợp cho người dùng trong hệ thống.</p>
        </div>
        <a asp-action="Index" class="cf-back-action">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại</span>
        </a>
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="roleCreateHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="roleCreateHeading">Thông tin vai trò</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
            </div>

            <form id="roleCreateForm"
                  asp-action="Create"
                  method="post"
                  class="cf-form"
                  data-create-form-element>
                <div asp-validation-summary="All" class="cf-alert" role="alert" tabindex="-1" data-error-summary></div>

                <section class="cf-section" aria-labelledby="roleIdentityHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                        <div>
                            <h3 id="roleIdentityHeading">Thông tin định danh</h3>
                            <p>Đặt tên rõ ràng và mô tả ngắn gọn phạm vi sử dụng của vai trò.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field cf-field--full">
                            <div class="cf-label-row">
                                <label asp-for="RoleName">Tên vai trò <span class="cf-required" aria-label="bắt buộc">*</span></label>
                                <span class="cf-counter" for="RoleName" data-character-counter></span>
                            </div>
                            <input asp-for="RoleName"
                                   class="form-control cf-control role-name-input"
                                   maxlength="50"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="Ví dụ: Manager, Sales, ContentEditor"
                                   aria-describedby="roleNameHint"
                                   required />
                            <span asp-validation-for="RoleName" class="cf-validation"></span>
                            <p id="roleNameHint" class="cf-hint">Tối đa 50 ký tự và không được trùng với vai trò đã có.</p>
                        </div>

                        <div class="cf-field cf-field--full">
                            <div class="cf-label-row">
                                <label asp-for="Description">Mô tả vai trò</label>
                                <span class="cf-counter" for="Description" data-character-counter></span>
                            </div>
                            <textarea asp-for="Description"
                                      class="form-control cf-control"
                                      rows="5"
                                      maxlength="255"
                                      placeholder="Mô tả trách nhiệm hoặc phạm vi quyền hạn của vai trò..."
                                      aria-describedby="roleDescriptionHint"></textarea>
                            <span asp-validation-for="Description" class="cf-validation"></span>
                            <p id="roleDescriptionHint" class="cf-hint">Mô tả giúp quản trị viên chọn đúng vai trò khi gán cho người dùng.</p>
                        </div>
                    </div>

                    <div class="cf-inline-note">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <span>Vai trò sẽ được kích hoạt ngay sau khi tạo. Bạn có thể cấu hình quyền chi tiết ở bước tiếp theo.</span>
                    </div>
                </section>

                <div class="cf-actions">
                    <a asp-action="Index" class="cf-secondary-action">Hủy</a>
                    <button type="submit"
                            class="cf-primary-action"
                            data-submit-button
                            data-default-label="Tạo vai trò"
                            data-loading-label="Đang tạo...">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span data-submit-label>Tạo vai trò</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide role-create-guide" aria-labelledby="rolePreviewHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
                <div>
                    <h2 id="rolePreviewHeading">Vai trò sắp tạo</h2>
                </div>
            </div>
            <p>Thông tin được cập nhật theo dữ liệu đang nhập để bạn kiểm tra nhanh trước khi lưu.</p>

            <dl class="cf-preview-list role-preview-list">
                <div>
                    <dt>Tên vai trò</dt>
                    <dd id="previewRoleName">Chưa nhập</dd>
                </div>
                <div>
                    <dt>Mô tả</dt>
                    <dd id="previewRoleDescription">Chưa có mô tả</dd>
                </div>
                <div>
                    <dt>Trạng thái</dt>
                    <dd>Đang hoạt động</dd>
                </div>
                <div>
                    <dt>Bước tiếp theo</dt>
                    <dd>Cấu hình quyền</dd>
                </div>
            </dl>

            <ul class="cf-guide__list role-create-guide__list">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Dùng tên ngắn gọn, dễ nhận biết và thống nhất với quy ước nội bộ.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Mỗi tên vai trò phải là duy nhất trong hệ thống.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Quyền truy cập chi tiết vẫn có thể điều chỉnh sau khi tạo.</span></li>
            </ul>

            <div class="cf-guide__note">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>Hệ thống sẽ kiểm tra tên trùng trước khi lưu vai trò mới.</span>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <style>
        .role-name-input {
            font-weight: 750;
        }

        .role-preview-list dd {
            min-height: 1.15rem;
            overflow-wrap: anywhere;
        }

        .role-create-guide__list {
            margin-top: 1rem;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
    <script>
        (function () {
            "use strict";

            const nameInput = document.getElementById("RoleName");
            const descriptionInput = document.getElementById("Description");
            const previewName = document.getElementById("previewRoleName");
            const previewDescription = document.getElementById("previewRoleDescription");

            function updatePreview() {
                if (previewName && nameInput) {
                    previewName.textContent = nameInput.value.trim() || "Chưa nhập";
                }

                if (previewDescription && descriptionInput) {
                    previewDescription.textContent = descriptionInput.value.trim() || "Chưa có mô tả";
                }
            }

            [nameInput, descriptionInput].forEach(input => input?.addEventListener("input", updatePreview));
            updatePreview();
        })();
    </script>
}
