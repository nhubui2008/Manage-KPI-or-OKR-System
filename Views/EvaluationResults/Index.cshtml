@model List<Manage_KPI_or_OKR_System.Models.EvaluationResult>
@using System.Globalization
@{
    ViewData["Title"] = "Kết quả Đánh giá";
    var employees = ViewBag.Employees as Dictionary<int, string> ?? new Dictionary<int, string>();
    var periods = ViewBag.Periods as Dictionary<int, string> ?? new Dictionary<int, string>();
    var ranks = ViewBag.Ranks as Dictionary<int, string> ?? new Dictionary<int, string>();
    var workflowEmployees = ViewBag.WorkflowEmployees as Dictionary<int, string> ?? new Dictionary<int, string>();
    var allEmployees = ViewBag.AllEmployees as List<Manage_KPI_or_OKR_System.Models.Employee> ?? new List<Manage_KPI_or_OKR_System.Models.Employee>();
    var allPeriods = ViewBag.AllPeriods as List<Manage_KPI_or_OKR_System.Models.EvaluationPeriod> ?? new List<Manage_KPI_or_OKR_System.Models.EvaluationPeriod>();
    var allRanks = ViewBag.AllRanks as List<Manage_KPI_or_OKR_System.Models.GradingRank> ?? new List<Manage_KPI_or_OKR_System.Models.GradingRank>();
    var classificationsList = ViewBag.Classifications as List<string> ?? new List<string> { "Xuất sắc", "Giỏi", "Khá", "Trung bình", "Yếu" };
    var rankScaleJson = System.Text.Json.JsonSerializer.Serialize(allRanks
        .Where(r => r.MinScore.HasValue)
        .OrderByDescending(r => r.MinScore)
        .Select(r => new
        {
            id = r.Id,
            rankCode = r.RankCode ?? "N/A",
            description = r.Description ?? "Chưa phân loại",
            minScore = r.MinScore ?? 0
        }));

    bool canManage = User.IsInRole("Admin") || User.IsInRole("Administrator") || User.IsInRole("Manager") || User.IsInRole("HR");
    bool canSubmitEvaluation = ViewBag.CanSubmitEvaluation == true;
    bool canReviewEvaluation = ViewBag.CanReviewEvaluation == true;
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
    var resultCount = Model?.Count ?? 0;
    var pendingReviewCount = Model?.Count(r => string.Equals(r.SubmissionStatus, "PendingDirectorReview", StringComparison.OrdinalIgnoreCase)) ?? 0;
    var approvedCount = Model?.Count(r => string.Equals(r.SubmissionStatus, "Approved", StringComparison.OrdinalIgnoreCase)) ?? 0;
    var rejectedCount = Model?.Count(r => string.Equals(r.SubmissionStatus, "Rejected", StringComparison.OrdinalIgnoreCase)) ?? 0;

    string SubmissionText(string? status) => status switch
    {
        "PendingDirectorReview" => "Chờ giám đốc duyệt",
        "Approved" => "Giám đốc đã duyệt",
        "Rejected" => "Giám đốc từ chối",
        _ => "Bản nháp"
    };

    string SubmissionBadge(string? status) => status switch
    {
        "PendingDirectorReview" => "bg-warning bg-opacity-10 text-warning border-warning",
        "Approved" => "bg-success bg-opacity-10 text-success border-success",
        "Rejected" => "bg-danger bg-opacity-10 text-danger border-danger",
        _ => "bg-secondary bg-opacity-10 text-secondary border-secondary"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-results.css" asp-append-version="true" />
}

<div class="evaluation-page evaluation-results-page">
    <div class="d-none">@Html.AntiForgeryToken()</div>
    <script id="evaluationRankScaleConfig" type="application/json">@Html.Raw(rankScaleJson)</script>

    <header class="evaluation-page-header">
        <div>
            <h1>Kết quả Đánh giá</h1>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Kết quả Đánh giá</span>
            </nav>
        </div>
        <div class="evaluation-results-actions">
            @if (canSubmitEvaluation || canReviewEvaluation)
            {
                <a asp-action="ReviewBoard" class="evaluation-secondary-action">
                    <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                    <span>Duyệt đánh giá &amp; kết quả</span>
                </a>
            }
            @if (canManage)
            {
                <a asp-action="Create" class="evaluation-primary-action">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>Thêm kết quả</span>
                </a>
            }
        </div>
    </header>

    <section class="evaluation-summary evaluation-results-summary" aria-label="Tổng quan kết quả đánh giá">
        <article>
            <span>Kết quả hiện có</span>
            <strong>@resultCount.ToString("N0")</strong>
            <small>Trong phạm vi được phép xem</small>
        </article>
        <article>
            <span>Chờ giám đốc duyệt</span>
            <strong>@pendingReviewCount.ToString("N0")</strong>
            <small>Cần xem xét và ra quyết định</small>
        </article>
        <article>
            <span>Đã duyệt</span>
            <strong>@approvedCount.ToString("N0")</strong>
            <small>Kết quả đã được xác nhận</small>
        </article>
        <article>
            <span>Cần rà soát</span>
            <strong>@rejectedCount.ToString("N0")</strong>
            <small>Kết quả bị từ chối cần cập nhật</small>
        </article>
    </section>

    <section class="evaluation-results evaluation-results-panel" aria-labelledby="evaluationResultsHeading">
        <div class="evaluation-results-heading">
            <div>
                <p class="evaluation-eyebrow" id="evaluationResultsHeading">Danh sách kết quả</p>
                <strong>@resultCount.ToString("N0") kết quả đánh giá</strong>
            </div>
            <span>Điểm số, xếp hạng và trạng thái phê duyệt</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="evaluation-table-shell evaluation-results-desktop">
                <table class="evaluation-table evaluation-results-table" aria-label="Danh sách kết quả đánh giá">
                    <thead>
                        <tr>
                            <th>Nhân viên</th>
                            <th>Kỳ đánh giá</th>
                            <th>Tổng điểm</th>
                            <th>Xếp hạng</th>
                            <th>Phân loại</th>
                            <th>Trạng thái duyệt</th>
                            <th>Nhận xét</th>
                            @if (canManage || canSubmitEvaluation || canReviewEvaluation)
                            {
                                <th class="text-end">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var empName = r.EmployeeId.HasValue && employees.ContainsKey(r.EmployeeId.Value) ? employees[r.EmployeeId.Value] : "N/A";
                            var periodName = r.PeriodId.HasValue && periods.ContainsKey(r.PeriodId.Value) ? periods[r.PeriodId.Value] : "N/A";
                            var rankCode = r.RankId.HasValue && ranks.ContainsKey(r.RankId.Value) ? ranks[r.RankId.Value] : "N/A";
                            var scoreColor = r.TotalScore >= 90 ? "success" : r.TotalScore >= 70 ? "primary" : r.TotalScore >= 50 ? "warning" : "danger";
                            var submitterName = r.SubmittedById.HasValue && workflowEmployees.ContainsKey(r.SubmittedById.Value) ? workflowEmployees[r.SubmittedById.Value] : "";
                            var scoreForEdit = r.TotalScore?.ToString("0.##", CultureInfo.InvariantCulture) ?? "0";

                            <tr>
                                <td>
                                    <div class="evaluation-result-person">
                                        <span class="evaluation-result-avatar" aria-hidden="true">@(empName.Length > 0 ? empName[0].ToString() : "?")</span>
                                        <strong>@empName</strong>
                                    </div>
                                </td>
                                <td><span class="evaluation-result-period">@periodName</span></td>
                                <td>
                                    <span class="evaluation-result-score evaluation-result-score--@scoreColor">
                                        @(r.TotalScore % 1 == 0 ? r.TotalScore?.ToString("0") : r.TotalScore?.ToString("0.#"))đ
                                    </span>
                                </td>
                                <td><span class="evaluation-result-rank">@rankCode</span></td>
                                <td><span class="evaluation-result-classification">@(r.Classification ?? "Chưa phân loại")</span></td>
                                <td>
                                    <span class="evaluation-result-status @SubmissionBadge(r.SubmissionStatus)">
                                        @SubmissionText(r.SubmissionStatus)
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(submitterName))
                                    {
                                        <div class="evaluation-result-submitter">Gửi bởi: @submitterName</div>
                                    }
                                </td>
                                <td>
                                    <span class="evaluation-result-comment" title="@(r.ReviewComment ?? "Chưa có nhận xét")">
                                        @(string.IsNullOrWhiteSpace(r.ReviewComment) ? "Chưa có nhận xét" : r.ReviewComment)
                                    </span>
                                </td>
                                @if (canManage || canSubmitEvaluation || canReviewEvaluation)
                                {
                                    <td>
                                        <div class="evaluation-actions">
                                            @if (canManage)
                                            {
                                                <button type="button"
                                                        class="evaluation-icon-button js-edit-result"
                                                        title="Sửa"
                                                        aria-label="Sửa kết quả của @empName"
                                                        data-id="@r.Id"
                                                        data-employee-id="@r.EmployeeId"
                                                        data-period-id="@r.PeriodId"
                                                        data-score="@scoreForEdit"
                                                        data-rank-id="@r.RankId"
                                                        data-classification="@(r.Classification ?? "")"
                                                        data-review-comment="@(r.ReviewComment ?? "")">
                                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                </button>
                                                <form asp-action="Delete" method="post" style="display:inline;"
                                                      data-app-confirm
                                                      data-confirm-title="Xóa vĩnh viễn kết quả đánh giá?"
                                                      data-confirm-message="Kết quả đánh giá và lịch sử điểm liên quan sẽ bị xóa vĩnh viễn. Thao tác này không thể hoàn tác."
                                                      data-confirm-tone="danger"
                                                      data-confirm-label="Xóa vĩnh viễn"
                                                      data-confirm-require-text="XÓA"
                                                      data-confirm-require-label="Nhập “XÓA” để xác nhận xóa kết quả">
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa kết quả của @empName">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (canSubmitEvaluation && (string.IsNullOrWhiteSpace(r.SubmissionStatus) || r.SubmissionStatus == "Draft" || r.SubmissionStatus == "Rejected"))
                                            {
                                                <form asp-action="SubmitForDirectorReview" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                    <button type="submit" class="evaluation-icon-button" title="Gửi giám đốc duyệt" aria-label="Gửi kết quả của @empName cho giám đốc duyệt">
                                                        <i class="bi bi-send-check" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="evaluation-mobile-list evaluation-results-mobile">
                @foreach (var r in Model)
                {
                    var empName = r.EmployeeId.HasValue && employees.ContainsKey(r.EmployeeId.Value) ? employees[r.EmployeeId.Value] : "N/A";
                    var periodName = r.PeriodId.HasValue && periods.ContainsKey(r.PeriodId.Value) ? periods[r.PeriodId.Value] : "N/A";
                    var rankCode = r.RankId.HasValue && ranks.ContainsKey(r.RankId.Value) ? ranks[r.RankId.Value] : "N/A";
                    var scoreColor = r.TotalScore >= 90 ? "success" : r.TotalScore >= 70 ? "primary" : r.TotalScore >= 50 ? "warning" : "danger";
                    var submitterName = r.SubmittedById.HasValue && workflowEmployees.ContainsKey(r.SubmittedById.Value) ? workflowEmployees[r.SubmittedById.Value] : "";
                    var scoreForEdit = r.TotalScore?.ToString("0.##", CultureInfo.InvariantCulture) ?? "0";

                    <article class="evaluation-result-card">
                        <header class="evaluation-result-card__header">
                            <div class="evaluation-result-person">
                                <span class="evaluation-result-avatar" aria-hidden="true">@(empName.Length > 0 ? empName[0].ToString() : "?")</span>
                                <div>
                                    <strong>@empName</strong>
                                    <p class="evaluation-result-card__period">@periodName</p>
                                </div>
                            </div>
                            <span class="evaluation-result-score evaluation-result-score--@scoreColor">
                                @(r.TotalScore % 1 == 0 ? r.TotalScore?.ToString("0") : r.TotalScore?.ToString("0.#"))đ
                            </span>
                        </header>

                        <dl class="evaluation-result-card__details">
                            <div>
                                <dt>Xếp hạng</dt>
                                <dd><span class="evaluation-result-rank">@rankCode</span></dd>
                            </div>
                            <div>
                                <dt>Phân loại</dt>
                                <dd>@(r.Classification ?? "Chưa phân loại")</dd>
                            </div>
                            <div>
                                <dt>Trạng thái duyệt</dt>
                                <dd>
                                    <span class="evaluation-result-status @SubmissionBadge(r.SubmissionStatus)">
                                        @SubmissionText(r.SubmissionStatus)
                                    </span>
                                </dd>
                            </div>
                            <div>
                                <dt>Người gửi</dt>
                                <dd>@(string.IsNullOrWhiteSpace(submitterName) ? "Chưa gửi duyệt" : submitterName)</dd>
                            </div>
                        </dl>

                        <p class="evaluation-result-card__comment">
                            <strong>Nhận xét:</strong> @(string.IsNullOrWhiteSpace(r.ReviewComment) ? "Chưa có nhận xét" : r.ReviewComment)
                        </p>

                        @if (canManage || canSubmitEvaluation || canReviewEvaluation)
                        {
                            <footer class="evaluation-result-card__footer">
                                @if (canManage)
                                {
                                    <button type="button"
                                            class="evaluation-icon-button js-edit-result"
                                            title="Sửa"
                                            aria-label="Sửa kết quả của @empName"
                                            data-id="@r.Id"
                                            data-employee-id="@r.EmployeeId"
                                            data-period-id="@r.PeriodId"
                                            data-score="@scoreForEdit"
                                            data-rank-id="@r.RankId"
                                            data-classification="@(r.Classification ?? "")"
                                            data-review-comment="@(r.ReviewComment ?? "")">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    </button>
                                    <form asp-action="Delete" method="post"
                                          data-app-confirm
                                          data-confirm-title="Xóa vĩnh viễn kết quả đánh giá?"
                                          data-confirm-message="Kết quả đánh giá và lịch sử điểm liên quan sẽ bị xóa vĩnh viễn. Thao tác này không thể hoàn tác."
                                          data-confirm-tone="danger"
                                          data-confirm-label="Xóa vĩnh viễn"
                                          data-confirm-require-text="XÓA"
                                          data-confirm-require-label="Nhập “XÓA” để xác nhận xóa kết quả">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa kết quả của @empName">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                                @if (canSubmitEvaluation && (string.IsNullOrWhiteSpace(r.SubmissionStatus) || r.SubmissionStatus == "Draft" || r.SubmissionStatus == "Rejected"))
                                {
                                    <form asp-action="SubmitForDirectorReview" method="post">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="evaluation-icon-button" title="Gửi giám đốc duyệt" aria-label="Gửi kết quả của @empName cho giám đốc duyệt">
                                            <i class="bi bi-send-check" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </footer>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <div class="evaluation-empty">
                <span class="evaluation-empty-icon"><i class="bi bi-award" aria-hidden="true"></i></span>
                <h2>Chưa có kết quả đánh giá</h2>
                <p>Kết quả sẽ xuất hiện tại đây sau khi điểm số và xếp hạng được lưu cho nhân viên.</p>
                @if (canManage)
                {
                    <a asp-action="Create" class="evaluation-primary-action">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        Thêm kết quả đầu tiên
                    </a>
                }
            </div>
        }
    </section>

    <!-- Create Modal -->
    <div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content evaluation-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalTitle"><i class="bi bi-award me-2" aria-hidden="true"></i>Thêm Kết quả Đánh giá</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <form asp-action="Create" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label"><span>Nhân viên</span></label>
                            <select name="EmployeeId" class="form-select evaluation-modal-control" required>
                                <option value="">-- Chọn nhân viên --</option>
                                @foreach (var e in allEmployees)
                                {
                                    <option value="@e.Id">@e.FullName (@e.EmployeeCode)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><span>Kỳ đánh giá</span></label>
                            <select name="PeriodId" class="form-select evaluation-modal-control" required>
                                <option value="">-- Chọn kỳ --</option>
                                @foreach (var p in allPeriods)
                                {
                                    <option value="@p.Id">@p.PeriodName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><span>Tổng điểm</span></label>
                            <input type="number" name="TotalScore" id="createTotalScore" class="form-control evaluation-modal-control js-score-input" step="0.01" min="0" max="100" required data-rank-output="createRankDisplay" data-classification-output="createClassificationDisplay" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><span>Xếp hạng</span></label>
                            <input type="text" id="createRankDisplay" class="form-control evaluation-modal-control" value="Tự động theo tổng điểm" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><span>Phân loại</span></label>
                            <input type="text" id="createClassificationDisplay" class="form-control evaluation-modal-control" value="Tự động theo tổng điểm" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><span>Nhận xét đánh giá</span></label>
                            <textarea name="ReviewComment" class="form-control evaluation-modal-control" rows="4" maxlength="2000" placeholder="Nhập nhận xét hoặc để trống để bổ sung sau"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="evaluation-secondary-action" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="evaluation-primary-action">Lưu kết quả</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content evaluation-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle"><i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Sửa Kết quả Đánh giá (<span id="editModalScoreHeader">0</span>đ)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <form asp-action="Edit" method="post">
                    <div class="modal-body">
                        <input type="hidden" name="Id" id="editId" />
                        <div class="mb-3">
                            <label class="form-label"><span>Nhân viên</span></label>
                            <select name="EmployeeId" id="editEmployeeId" class="form-select evaluation-modal-control" required>
                                <option value="">-- Chọn nhân viên --</option>
                                @foreach (var e in allEmployees)
                                {
                                    <option value="@e.Id">@e.FullName (@e.EmployeeCode)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><span>Kỳ đánh giá</span></label>
                            <select name="PeriodId" id="editPeriodId" class="form-select evaluation-modal-control" required>
                                <option value="">-- Chọn kỳ --</option>
                                @foreach (var p in allPeriods)
                                {
                                    <option value="@p.Id">@p.PeriodName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><span>Tổng điểm</span></label>
                            <input type="number" name="TotalScore" id="editTotalScore" class="form-control evaluation-modal-control js-score-input" step="0.01" min="0" max="100" required data-rank-output="editRankDisplay" data-classification-output="editClassificationDisplay" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><span>Xếp hạng</span></label>
                            <input type="text" id="editRankDisplay" class="form-control evaluation-modal-control" value="Tự động theo tổng điểm" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><span>Phân loại</span></label>
                            <input type="text" id="editClassificationDisplay" class="form-control evaluation-modal-control" value="Tự động theo tổng điểm" readonly />
                        </div>
                        <div>
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                <label for="editReviewComment" class="mb-0">
                                    <span class="mb-0">Nhận xét đánh giá</span>
                                </label>
                                <button type="button" class="evaluation-secondary-action evaluation-ai-action" id="aiGenerateReviewBtn">
                                    <i class="bi bi-magic" aria-hidden="true"></i> AI Viết nhận xét
                                </button>
                            </div>
                            <textarea name="ReviewComment" id="editReviewComment" class="form-control evaluation-modal-control" rows="5" maxlength="2000" placeholder="AI sẽ tạo bản nháp, quản lý có thể chỉnh sửa trước khi lưu"></textarea>
                            <div id="aiReviewDraftPanel" class="border rounded-3 bg-light p-3 mt-3 d-none" role="status" aria-live="polite">
                                <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start mb-2">
                                    <div>
                                        <span class="badge text-bg-warning">Bản nháp AI · Chờ con người quyết định</span>
                                        <div class="small text-muted mt-1">AI không thay đổi điểm, hạng, trạng thái hay nhận xét chính thức.</div>
                                    </div>
                                </div>
                                <p id="aiReviewDraftText" class="mb-2" style="white-space: pre-wrap;"></p>
                                <div id="aiReviewDraftSourceWarning" class="alert alert-warning py-2 px-3 small d-none" role="alert">
                                    Nhân viên, kỳ hoặc tổng điểm đã thay đổi. Hãy lưu kết quả trước rồi tạo lại bản nháp AI.
                                </div>
                                <div class="small fw-semibold mb-1">Nguồn tham chiếu</div>
                                <ul id="aiReviewDraftCitations" class="small text-muted ps-3 mb-3"></ul>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="evaluation-primary-action" id="aiApplyReviewDraftBtn">Chèn vào ô nhận xét</button>
                                    <button type="button" class="evaluation-secondary-action" id="aiRejectReviewDraftBtn">Không sử dụng</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="evaluation-secondary-action" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="evaluation-primary-action">Cập nhật kết quả</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/evaluation-results.js" asp-append-version="true"></script>
}
