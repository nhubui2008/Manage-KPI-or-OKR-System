@model List<Manage_KPI_or_OKR_System.Models.EvaluationResult>
@{
    ViewData["Title"] = "Duyệt đánh giá & kết quả";
    var employees = ViewBag.Employees as Dictionary<int, string> ?? new Dictionary<int, string>();
    var periods = ViewBag.Periods as Dictionary<int, string> ?? new Dictionary<int, string>();
    var ranks = ViewBag.Ranks as Dictionary<int, string> ?? new Dictionary<int, string>();
    bool canDirectorReview = ViewBag.CanDirectorReview == true;
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
    var results = Model ?? new List<Manage_KPI_or_OKR_System.Models.EvaluationResult>();

    string StatusText(string? status) => status switch
    {
        "PendingDirectorReview" => "Chờ giám đốc review",
        "Approved" => "Đã duyệt",
        "Rejected" => "Từ chối",
        _ => "Bản nháp"
    };

    int totalPending = results.Count;
    int approved = results.Count(r => string.Equals(r.SubmissionStatus, "Approved", StringComparison.OrdinalIgnoreCase));
    int rejected = results.Count(r => string.Equals(r.SubmissionStatus, "Rejected", StringComparison.OrdinalIgnoreCase));
    bool hasResults = results.Count > 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-results.css" asp-append-version="true" />
}

<div class="evaluation-page evaluation-review-page">

    <!-- Page Header -->
    <header class="evaluation-page-header">
        <div>
            <h1>Duyệt đánh giá &amp; kết quả</h1>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Kết quả đánh giá</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Duyệt đánh giá</span>
            </nav>
        </div>
        <div class="evaluation-review-actions">
            <a asp-action="Index" class="evaluation-secondary-action">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>Quay lại</span>
            </a>
        </div>
    </header>

    <!-- Stat Cards Row -->
    <section class="evaluation-summary" aria-label="Tổng quan duyệt đánh giá">
        <article>
            <span>Đang chờ xử lý</span>
            <strong>@totalPending</strong>
            <small>Cần giám đốc review</small>
        </article>
        <article>
            <span>Đã duyệt</span>
            <strong>@approved</strong>
            <small>Kết quả đã xác nhận</small>
        </article>
        <article>
            <span>Từ chối</span>
            <strong>@rejected</strong>
            <small>Cần rà soát lại</small>
        </article>
    </section>

    <!-- Main Card -->
    <section class="evaluation-results evaluation-review-panel" aria-labelledby="reviewResultsHeading">
        <div class="evaluation-results-heading">
            <div>
                <p class="evaluation-eyebrow" id="reviewResultsHeading">Hồ sơ chờ duyệt</p>
                <strong>@totalPending hồ sơ cần xử lý</strong>
            </div>
            @if (totalPending > 0)
            {
                <span class="evaluation-status evaluation-status--ending">
                    <span aria-hidden="true"></span>
                    @totalPending hồ sơ chờ duyệt
                </span>
            }
        </div>

        <div class="evaluation-table-shell evaluation-review-table-shell">
                <table class="evaluation-table evaluation-review-table" aria-label="Danh sách hồ sơ chờ duyệt">
                    <thead>
                        <tr>
                            <th>Nhân viên</th>
                            <th>Kỳ đánh giá</th>
                            <th>Tổng điểm</th>
                            <th>Xếp hạng</th>
                            <th>Nhận xét trưởng phòng</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Review giám đốc</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (hasResults)
                        {
                            foreach (var result in results)
                            {
                                var empName = result.EmployeeId.HasValue && employees.ContainsKey(result.EmployeeId.Value) ? employees[result.EmployeeId.Value] : "N/A";
                                var periodName = result.PeriodId.HasValue && periods.ContainsKey(result.PeriodId.Value) ? periods[result.PeriodId.Value] : "N/A";
                                var rankCode = result.RankId.HasValue && ranks.ContainsKey(result.RankId.Value) ? ranks[result.RankId.Value] : "N/A";

                                string initials = string.Join("", empName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
                                if (initials.Length > 2) initials = initials.Substring(0, 2);

                                <tr>
                                    <!-- Nhân viên -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="evaluation-review-avatar" aria-hidden="true">@initials</div>
                                            <div>
                                                <div class="fw-semibold text-dark" style="font-size:.88rem;">@empName</div>
                                                <div class="text-muted" style="font-size:.75rem;">@result.Classification</div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Kỳ đánh giá -->
                                    <td>
                                        <div class="d-flex align-items-center gap-1 text-muted" style="font-size:.82rem; white-space:nowrap;">
                                            <i class="bi bi-calendar3 text-primary opacity-75" aria-hidden="true"></i>
                                            @periodName
                                        </div>
                                        @if (result.SubmittedAt.HasValue)
                                        {
                                            <div class="text-muted" style="font-size:.72rem; padding-left:1.2rem;">Gửi lúc @result.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                    </td>

                                    <!-- Tổng điểm -->
                                    <td>
                                        <span class="evaluation-review-score">@result.TotalScore?.ToString("0.##") điểm</span>
                                    </td>

                                    <!-- Xếp hạng -->
                                    <td>
                                        <span class="evaluation-review-rank">@rankCode</span>
                                    </td>

                                    <!-- Nhận xét -->
                                    <td style="max-width: 300px;">
                                        <div class="text-muted" style="font-size:.78rem; word-break:break-word;">
                                            @(string.IsNullOrWhiteSpace(result.ReviewComment) ? "Chưa có nhận xét" : result.ReviewComment)
                                        </div>
                                    </td>

                                    <!-- Trạng thái -->
                                    <td>
                                        <span class="evaluation-status evaluation-status--ending"><span aria-hidden="true"></span>@StatusText(result.SubmissionStatus)</span>
                                    </td>

                                    <!-- Review Form -->
                                    <td>
                                        @if (canDirectorReview)
                                        {
                                            <form asp-action="DirectorReview" method="post" class="evaluation-review-form">
                                                <input type="hidden" name="id" value="@result.Id" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <textarea name="directorReviewComment" class="form-control form-control-sm mb-2"
                                                          rows="2" placeholder="Nhận xét của giám đốc…"></textarea>
                                                <div class="evaluation-review-form__actions">
                                                    <button type="submit" name="decision" value="Approved" class="evaluation-review-approve">
                                                        <i class="bi bi-check2-circle" aria-hidden="true"></i>Duyệt
                                                    </button>
                                                    <button type="submit" name="decision" value="Rejected" class="evaluation-review-reject">
                                                        <i class="bi bi-x-circle" aria-hidden="true"></i>Từ chối
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size:.82rem;">Đang chờ giám đốc review</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="p-0">
                                    <div class="evaluation-empty" role="status">
                                        <span class="evaluation-empty-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span>
                                        <h2>Tất cả đã được xử lý!</h2>
                                        <p>Không có đánh giá nào đang chờ duyệt lúc này.</p>
                                        <a asp-action="Index" class="evaluation-secondary-action">
                                            <i class="bi bi-arrow-left" aria-hidden="true"></i>Quay lại danh sách
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="evaluation-review-mobile-list">
                @if (hasResults)
                {
                    foreach (var result in results)
                    {
                        var empName = result.EmployeeId.HasValue && employees.ContainsKey(result.EmployeeId.Value) ? employees[result.EmployeeId.Value] : "N/A";
                        var periodName = result.PeriodId.HasValue && periods.ContainsKey(result.PeriodId.Value) ? periods[result.PeriodId.Value] : "N/A";
                        var rankCode = result.RankId.HasValue && ranks.ContainsKey(result.RankId.Value) ? ranks[result.RankId.Value] : "N/A";

                        string initials = string.Join("", empName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
                        if (initials.Length > 2) initials = initials.Substring(0, 2);

                        <article class="evaluation-review-card">
                            <div class="evaluation-review-card__header">
                                <div class="d-flex align-items-center gap-2 min-w-0">
                                    <div class="evaluation-review-avatar" aria-hidden="true">@initials</div>
                                    <div class="min-w-0">
                                        <div class="fw-semibold text-dark">@empName</div>
                                        <div class="text-muted small">@periodName</div>
                                    </div>
                                </div>
                                <span class="evaluation-review-score">@result.TotalScore?.ToString("0.##") điểm</span>
                            </div>

                            <div class="evaluation-review-card__grid">
                                <div>
                                    <div class="evaluation-review-card__label">Xếp hạng</div>
                                    <span class="evaluation-review-rank">@rankCode</span>
                                </div>
                                <div>
                                    <div class="evaluation-review-card__label">Trạng thái</div>
                                    <span class="evaluation-status evaluation-status--ending"><span aria-hidden="true"></span>@StatusText(result.SubmissionStatus)</span>
                                </div>
                                @if (result.SubmittedAt.HasValue)
                                {
                                    <div>
                                        <div class="evaluation-review-card__label">Thời gian gửi</div>
                                        <div class="text-muted small">@result.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                }
                                <div>
                                    <div class="evaluation-review-card__label">Nhận xét trưởng phòng</div>
                                    <div class="text-muted small">@(string.IsNullOrWhiteSpace(result.ReviewComment) ? "Chưa có nhận xét" : result.ReviewComment)</div>
                                </div>
                                <div>
                                    <div class="evaluation-review-card__label">Review giám đốc</div>
                                    @if (canDirectorReview)
                                    {
                                        <form asp-action="DirectorReview" method="post" class="evaluation-review-form">
                                            <input type="hidden" name="id" value="@result.Id" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <textarea name="directorReviewComment" class="form-control form-control-sm mb-2" rows="3" placeholder="Nhận xét của giám đốc…"></textarea>
                                            <div class="evaluation-review-form__actions">
                                                <button type="submit" name="decision" value="Approved" class="evaluation-review-approve">
                                                    <i class="bi bi-check2-circle" aria-hidden="true"></i>Duyệt
                                                </button>
                                                <button type="submit" name="decision" value="Rejected" class="evaluation-review-reject">
                                                    <i class="bi bi-x-circle" aria-hidden="true"></i>Từ chối
                                                </button>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Đang chờ giám đốc review</span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div class="evaluation-empty" role="status">
                        <span class="evaluation-empty-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span>
                        <h2>Tất cả đã được xử lý!</h2>
                        <p>Không có đánh giá nào đang chờ duyệt lúc này.</p>
                        <a asp-action="Index" class="evaluation-secondary-action">
                            <i class="bi bi-arrow-left" aria-hidden="true"></i>Quay lại danh sách
                        </a>
                    </div>
                }
            </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/evaluation-results.js" asp-append-version="true"></script>
}
