@model List<Manage_KPI_or_OKR_System.Models.EvaluationResult>
@{
    ViewData["Title"] = "Duyệt đánh giá & kết quả";
    var employees = ViewBag.Employees as Dictionary<int, string> ?? new Dictionary<int, string>();
    var periods = ViewBag.Periods as Dictionary<int, string> ?? new Dictionary<int, string>();
    var ranks = ViewBag.Ranks as Dictionary<int, string> ?? new Dictionary<int, string>();
    bool canDirectorReview = ViewBag.CanDirectorReview == true;
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
    var results = Model ?? new List<Manage_KPI_or_OKR_System.Models.EvaluationResult>();

    string StatusText(string? status) => status switch
    {
        "PendingDirectorReview" => "Chờ giám đốc review",
        "Approved" => "Đã duyệt",
        "Rejected" => "Từ chối",
        _ => "Bản nháp"
    };

    int totalPending = results.Count;
    int approved = results.Count(r => string.Equals(r.SubmissionStatus, "Approved", StringComparison.OrdinalIgnoreCase));
    int rejected = results.Count(r => string.Equals(r.SubmissionStatus, "Rejected", StringComparison.OrdinalIgnoreCase));
    bool hasResults = results.Count > 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <style>
    .evaluation-review-page {
        --review-brand: #1a73e8;
        --review-brand-dark: #1557b0;
        --review-line: #dfe5ee;
        --review-muted: #64748b;
        --review-soft: #f7f9fc;
    }

    .evaluation-review-page .evaluation-page-header {
        align-items: center;
    }

    .evaluation-review-page .evaluation-review-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .evaluation-review-page .evaluation-summary {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .evaluation-review-page .evaluation-summary article:nth-child(1) strong {
        color: #b7791f;
    }

    .evaluation-review-page .evaluation-summary article:nth-child(2) strong {
        color: #15803d;
    }

    .evaluation-review-page .evaluation-summary article:nth-child(3) strong {
        color: #be123c;
    }

    .evaluation-review-page .evaluation-review-panel {
        padding-bottom: 0.75rem;
    }

    .evaluation-review-page .evaluation-review-table {
        min-width: 1100px;
    }

    .evaluation-review-page .evaluation-table th,
    .evaluation-review-page .evaluation-table td {
        vertical-align: middle;
    }

    .evaluation-review-page .evaluation-table th {
        white-space: nowrap;
    }

    .evaluation-review-page .evaluation-review-form {
        min-width: 260px;
    }

    .evaluation-review-page .evaluation-review-form textarea {
        width: 100%;
        min-height: 70px;
        resize: vertical;
        border: 1px solid var(--review-line);
        border-radius: 8px;
        padding: 0.65rem 0.75rem;
        color: #172033;
        outline: none;
    }

    .evaluation-review-page .evaluation-review-form textarea:focus {
        border-color: var(--review-brand);
        box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.14);
    }

    .evaluation-review-page .evaluation-review-form__actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.45rem;
        margin-top: 0.45rem;
    }

    .evaluation-review-page .evaluation-review-approve,
    .evaluation-review-page .evaluation-review-reject {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        min-height: 36px;
        border-radius: 8px;
        padding: 0.5rem 0.8rem;
        font-size: 0.78rem;
        font-weight: 750;
        transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }

    .evaluation-review-page .evaluation-review-approve {
        border: 1px solid #15803d;
        background: #15803d;
        color: #fff;
    }

    .evaluation-review-page .evaluation-review-approve:hover {
        border-color: #166534;
        background: #166534;
        color: #fff;
        transform: translateY(-1px);
    }

    .evaluation-review-page .evaluation-review-reject {
        border: 1px solid #f4c8c3;
        background: #fff;
        color: #b42318;
    }

    .evaluation-review-page .evaluation-review-reject:hover {
        border-color: #b42318;
        background: #fff0ee;
        color: #912018;
        transform: translateY(-1px);
    }

    .evaluation-review-page .evaluation-review-rank {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        border: 1px solid var(--review-brand);
        border-radius: 7px;
        padding: 0.3rem 0.55rem;
        background: var(--review-brand);
        color: #fff;
        font-size: 0.74rem;
        font-weight: 800;
    }

    .evaluation-review-page .evaluation-review-score {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        border: 1px solid #bfdbfe;
        border-radius: 999px;
        padding: 0.3rem 0.65rem;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 0.74rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .evaluation-review-page .evaluation-review-avatar {
        display: inline-grid;
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        place-items: center;
        border-radius: 8px;
        background: var(--review-brand);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 800;
    }

    .evaluation-review-page .evaluation-review-mobile-list {
        display: none;
    }

    .evaluation-review-page .evaluation-review-card {
        border: 1px solid var(--review-line);
        border-radius: 9px;
        padding: 0.9rem;
        background: #fff;
    }

    .evaluation-review-page .evaluation-review-card__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.85rem;
    }

    .evaluation-review-page .evaluation-review-card__grid {
        display: grid;
        gap: 0.8rem;
    }

    .evaluation-review-page .evaluation-review-card__label {
        margin-bottom: 0.15rem;
        color: var(--review-muted);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .evaluation-review-page .evaluation-review-card__comment {
        color: var(--review-muted);
        font-size: 0.8rem;
        line-height: 1.5;
    }

    .evaluation-review-page .evaluation-empty {
        padding: 3.5rem 1rem;
    }

    @@media (max-width: 900px) {
        .evaluation-review-page .evaluation-review-table-shell {
            display: none;
        }

        .evaluation-review-page .evaluation-review-mobile-list {
            display: grid;
            gap: 0.75rem;
            padding-top: 0.85rem;
        }

        .evaluation-review-page .evaluation-review-form {
            min-width: 0;
            margin-top: 0.35rem;
        }

        .evaluation-review-page .evaluation-review-form__actions {
            justify-content: stretch;
        }

        .evaluation-review-page .evaluation-review-form__actions > * {
            flex: 1 1 0;
        }
    }

    @@media (max-width: 575.98px) {
        .evaluation-review-page .evaluation-page-header {
            align-items: stretch;
        }

        .evaluation-review-page .evaluation-review-actions {
            width: 100%;
        }

        .evaluation-review-page .evaluation-review-actions .evaluation-secondary-action {
            width: 100%;
        }

        .evaluation-review-page .evaluation-summary {
            grid-template-columns: 1fr;
        }

        .evaluation-review-page .evaluation-summary article {
            border-right: 0;
            border-bottom: 1px solid var(--evaluation-line);
        }

        .evaluation-review-page .evaluation-summary article:last-child {
            border-bottom: 0;
        }

        .evaluation-review-page .evaluation-review-form__actions {
            flex-direction: column;
        }
    }
    </style>
}

<style>
    /* ===== REVIEW BOARD CUSTOM STYLES ===== */
    .rq-stat-card {
        background: #ffffff;
        border: 1px solid var(--card-border, #e1e8f0);
        border-radius: 14px;
        padding: 20px 24px;
        box-shadow: 0 1px 4px rgba(26, 115, 232, 0.06);
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    .rq-stat-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
    }
    .rq-stat-card.card-pending::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .rq-stat-card.card-good::before   { background: linear-gradient(90deg, #10b981, #34d399); }
    .rq-stat-card.card-risk::before   { background: linear-gradient(90deg, #ef4444, #f87171); }
    .rq-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(26, 115, 232, 0.10);
    }
    .rq-stat-icon {
        width: 44px; height: 44px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }
    .rq-stat-card.card-pending .rq-stat-icon { background: #fef3c7; color: #d97706; }
    .rq-stat-card.card-good   .rq-stat-icon { background: #d1fae5; color: #059669; }
    .rq-stat-card.card-risk   .rq-stat-icon { background: #fee2e2; color: #dc2626; }
    .rq-stat-value {
        font-size: 2rem; font-weight: 800;
        line-height: 1; color: #1a2940;
        margin-top: 14px;
    }
    .rq-stat-label {
        font-size: 0.8rem; color: #6b7c93;
        margin-top: 4px; font-weight: 500;
    }

    /* ===== TABLE ROWS ===== */
    .rq-table thead th {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7c93;
        background: #f8fafd;
        border-bottom: 1px solid #e1e8f0;
        padding: 12px 14px;
        white-space: nowrap;
    }
    .rq-table thead th:first-child { padding-left: 24px; border-radius: 0; }
    .rq-table thead th:last-child  { padding-right: 24px; }

    .rq-table tbody tr {
        border-bottom: 1px solid #f0f4f8;
        transition: background 0.15s ease;
    }
    .rq-table tbody tr:hover { background: #f5f9ff; }
    .rq-table tbody tr:last-child { border-bottom: none; }
    .rq-table tbody td {
        padding: 16px 14px;
        vertical-align: top;
    }
    .rq-table tbody td:first-child { padding-left: 24px; }
    .rq-table tbody td:last-child  { padding-right: 24px; }

    /* Avatar chip */
    .emp-avatar {
        width: 38px; height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, #1a73e8, #4285f4);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(26, 115, 232, 0.25);
    }

    /* Review form in table */
    .rq-review-form {
        min-width: 260px;
    }
    .rq-review-form .form-control-sm {
        border-color: #e1e8f0;
        border-radius: 8px;
        font-size: 0.8rem;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .rq-review-form .form-control-sm:focus {
        border-color: #1a73e8;
        box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.1);
    }
    .rq-btn-approve {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex; align-items: center; gap: 5px;
    }
    .rq-btn-approve:hover {
        background: linear-gradient(135deg, #059669, #047857);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        transform: translateY(-1px);
    }
    .rq-btn-reject {
        background: transparent;
        color: #dc2626;
        border: 1.5px solid #fca5a5;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex; align-items: center; gap: 5px;
    }
    .rq-btn-reject:hover {
        background: #fee2e2;
        border-color: #ef4444;
        transform: translateY(-1px);
    }

    /* Score badge */
    .score-badge {
        background: #eff6ff; color: #1d4ed8;
        border: 1px solid #bfdbfe;
        border-radius: 999px;
        padding: 3px 10px;
        font-size: 0.75rem; font-weight: 700;
    }

    /* Rank badge */
    .rank-badge {
        background: #1e293b; color: #fff;
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 0.72rem; font-weight: 700;
        letter-spacing: 0.04em;
    }

    /* Status badge */
    .status-badge {
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 0.72rem; font-weight: 700;
        letter-spacing: 0.03em;
        border: 1px solid transparent;
    }
    .status-pending { background: #fef3c7; color: #b45309; border-color: #fde68a; }

    /* Empty state */
    .rq-empty {
        padding: 72px 24px;
        text-align: center;
    }
    .rq-empty-icon {
        width: 80px; height: 80px;
        background: linear-gradient(135deg, #d1fae5, #a7f3d0);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 20px;
        font-size: 2.2rem; color: #059669;
        animation: rqPulse 2.5s ease-in-out infinite;
    }
    @@keyframes rqPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(16,185,129,0.25); }
        50%       { box-shadow: 0 0 0 14px rgba(16,185,129,0); }
    }
    .rq-empty-title { font-size: 1.15rem; font-weight: 700; color: #1a2940; margin-bottom: 6px; }
    .rq-empty-sub   { font-size: 0.88rem; color: #6b7c93; }

    /* Alert styles */
    .rq-alert {
        display: flex; align-items: flex-start; gap: 12px;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 20px;
        border: none;
        font-size: 0.875rem;
        font-weight: 500;
    }
    .rq-alert.success { background: #d1fae5; color: #065f46; }
    .rq-alert.danger  { background: #fee2e2; color: #7f1d1d; }
    .rq-alert-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }
    .rq-alert .btn-close { margin-left: auto; }

    .rq-mobile-list {
        display: none;
    }

    @@media (max-width: 767.98px) {
        .rq-table-wrapper {
            display: none;
        }

        .rq-mobile-list {
            display: grid;
            gap: 1rem;
            padding: 1rem;
        }

        .rq-mobile-card {
            border: 1px solid #e5edf5;
            border-radius: 18px;
            padding: 1rem;
            background: #fff;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
        }

        .rq-mobile-card__header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.75rem;
            margin-bottom: 0.875rem;
        }

        .rq-mobile-card__grid {
            display: grid;
            gap: 0.8rem;
        }

        .rq-mobile-card__label {
            font-size: 0.7rem;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 0.15rem;
        }

        .rq-mobile-card .rq-review-form {
            min-width: 0;
            margin-top: 0.5rem;
        }

        .rq-mobile-card .rq-review-form .d-flex {
            flex-direction: column;
        }

        .rq-mobile-card .rq-btn-approve,
        .rq-mobile-card .rq-btn-reject {
            justify-content: center;
            width: 100%;
        }
    }
</style>

<div class="evaluation-page evaluation-review-page">

    <!-- Page Header -->
    <header class="evaluation-page-header">
        <div>
            <h1>Duyệt đánh giá &amp; kết quả</h1>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Kết quả đánh giá</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Duyệt đánh giá</span>
            </nav>
        </div>
        <div class="evaluation-review-actions">
            <a asp-action="Index" class="evaluation-secondary-action">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>Quay lại</span>
            </a>
        </div>
    </header>

    <!-- Stat Cards Row -->
    <section class="evaluation-summary" aria-label="Tổng quan duyệt đánh giá">
        <article>
            <span>Đang chờ xử lý</span>
            <strong>@totalPending</strong>
            <small>Cần giám đốc review</small>
        </article>
        <article>
            <span>Đã duyệt</span>
            <strong>@approved</strong>
            <small>Kết quả đã xác nhận</small>
        </article>
        <article>
            <span>Từ chối</span>
            <strong>@rejected</strong>
            <small>Cần rà soát lại</small>
        </article>
    </section>

    <!-- Main Card -->
    <section class="evaluation-results evaluation-review-panel" aria-labelledby="reviewResultsHeading">
        <div class="evaluation-results-heading">
            <div>
                <p class="evaluation-eyebrow" id="reviewResultsHeading">Hồ sơ chờ duyệt</p>
                <strong>@totalPending hồ sơ cần xử lý</strong>
            </div>
            @if (totalPending > 0)
            {
                <span class="evaluation-status evaluation-status--ending">
                    <span aria-hidden="true"></span>
                    @totalPending hồ sơ chờ duyệt
                </span>
            }
        </div>

        <div class="evaluation-table-shell evaluation-review-table-shell">
                <table class="evaluation-table evaluation-review-table" aria-label="Danh sách hồ sơ chờ duyệt">
                    <thead>
                        <tr>
                            <th>Nhân viên</th>
                            <th>Kỳ đánh giá</th>
                            <th>Tổng điểm</th>
                            <th>Xếp hạng</th>
                            <th>Nhận xét trưởng phòng</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Review giám đốc</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (hasResults)
                        {
                            foreach (var result in results)
                            {
                                var empName = result.EmployeeId.HasValue && employees.ContainsKey(result.EmployeeId.Value) ? employees[result.EmployeeId.Value] : "N/A";
                                var periodName = result.PeriodId.HasValue && periods.ContainsKey(result.PeriodId.Value) ? periods[result.PeriodId.Value] : "N/A";
                                var rankCode = result.RankId.HasValue && ranks.ContainsKey(result.RankId.Value) ? ranks[result.RankId.Value] : "N/A";

                                string initials = string.Join("", empName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
                                if (initials.Length > 2) initials = initials.Substring(0, 2);

                                <tr>
                                    <!-- Nhân viên -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="evaluation-review-avatar" aria-hidden="true">@initials</div>
                                            <div>
                                                <div class="fw-semibold text-dark" style="font-size:.88rem;">@empName</div>
                                                <div class="text-muted" style="font-size:.75rem;">@result.Classification</div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Kỳ đánh giá -->
                                    <td>
                                        <div class="d-flex align-items-center gap-1 text-muted" style="font-size:.82rem; white-space:nowrap;">
                                            <i class="bi bi-calendar3 text-primary opacity-75" aria-hidden="true"></i>
                                            @periodName
                                        </div>
                                        @if (result.SubmittedAt.HasValue)
                                        {
                                            <div class="text-muted" style="font-size:.72rem; padding-left:1.2rem;">Gửi lúc @result.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                    </td>

                                    <!-- Tổng điểm -->
                                    <td>
                                        <span class="evaluation-review-score">@result.TotalScore?.ToString("0.##") điểm</span>
                                    </td>

                                    <!-- Xếp hạng -->
                                    <td>
                                        <span class="evaluation-review-rank">@rankCode</span>
                                    </td>

                                    <!-- Nhận xét -->
                                    <td style="max-width: 300px;">
                                        <div class="text-muted" style="font-size:.78rem; word-break:break-word;">
                                            @(string.IsNullOrWhiteSpace(result.ReviewComment) ? "Chưa có nhận xét" : result.ReviewComment)
                                        </div>
                                    </td>

                                    <!-- Trạng thái -->
                                    <td>
                                        <span class="evaluation-status evaluation-status--ending"><span aria-hidden="true"></span>@StatusText(result.SubmissionStatus)</span>
                                    </td>

                                    <!-- Review Form -->
                                    <td>
                                        @if (canDirectorReview)
                                        {
                                            <form asp-action="DirectorReview" method="post" class="evaluation-review-form">
                                                <input type="hidden" name="id" value="@result.Id" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <textarea name="directorReviewComment" class="form-control form-control-sm mb-2"
                                                          rows="2" placeholder="Nhận xét của giám đốc…"></textarea>
                                                <div class="evaluation-review-form__actions">
                                                    <button type="submit" name="decision" value="Approved" class="evaluation-review-approve">
                                                        <i class="bi bi-check2-circle" aria-hidden="true"></i>Duyệt
                                                    </button>
                                                    <button type="submit" name="decision" value="Rejected" class="evaluation-review-reject">
                                                        <i class="bi bi-x-circle" aria-hidden="true"></i>Từ chối
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size:.82rem;">Đang chờ giám đốc review</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="p-0">
                                    <div class="evaluation-empty" role="status">
                                        <span class="evaluation-empty-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span>
                                        <h2>Tất cả đã được xử lý!</h2>
                                        <p>Không có đánh giá nào đang chờ duyệt lúc này.</p>
                                        <a asp-action="Index" class="evaluation-secondary-action">
                                            <i class="bi bi-arrow-left" aria-hidden="true"></i>Quay lại danh sách
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="evaluation-review-mobile-list">
                @if (hasResults)
                {
                    foreach (var result in results)
                    {
                        var empName = result.EmployeeId.HasValue && employees.ContainsKey(result.EmployeeId.Value) ? employees[result.EmployeeId.Value] : "N/A";
                        var periodName = result.PeriodId.HasValue && periods.ContainsKey(result.PeriodId.Value) ? periods[result.PeriodId.Value] : "N/A";
                        var rankCode = result.RankId.HasValue && ranks.ContainsKey(result.RankId.Value) ? ranks[result.RankId.Value] : "N/A";

                        string initials = string.Join("", empName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
                        if (initials.Length > 2) initials = initials.Substring(0, 2);

                        <article class="evaluation-review-card">
                            <div class="evaluation-review-card__header">
                                <div class="d-flex align-items-center gap-2 min-w-0">
                                    <div class="evaluation-review-avatar" aria-hidden="true">@initials</div>
                                    <div class="min-w-0">
                                        <div class="fw-semibold text-dark">@empName</div>
                                        <div class="text-muted small">@periodName</div>
                                    </div>
                                </div>
                                <span class="evaluation-review-score">@result.TotalScore?.ToString("0.##") điểm</span>
                            </div>

                            <div class="evaluation-review-card__grid">
                                <div>
                                    <div class="evaluation-review-card__label">Xếp hạng</div>
                                    <span class="evaluation-review-rank">@rankCode</span>
                                </div>
                                <div>
                                    <div class="evaluation-review-card__label">Trạng thái</div>
                                    <span class="evaluation-status evaluation-status--ending"><span aria-hidden="true"></span>@StatusText(result.SubmissionStatus)</span>
                                </div>
                                @if (result.SubmittedAt.HasValue)
                                {
                                    <div>
                                        <div class="evaluation-review-card__label">Thời gian gửi</div>
                                        <div class="text-muted small">@result.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                }
                                <div>
                                    <div class="evaluation-review-card__label">Nhận xét trưởng phòng</div>
                                    <div class="text-muted small">@(string.IsNullOrWhiteSpace(result.ReviewComment) ? "Chưa có nhận xét" : result.ReviewComment)</div>
                                </div>
                                <div>
                                    <div class="evaluation-review-card__label">Review giám đốc</div>
                                    @if (canDirectorReview)
                                    {
                                        <form asp-action="DirectorReview" method="post" class="evaluation-review-form">
                                            <input type="hidden" name="id" value="@result.Id" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <textarea name="directorReviewComment" class="form-control form-control-sm mb-2" rows="3" placeholder="Nhận xét của giám đốc…"></textarea>
                                            <div class="evaluation-review-form__actions">
                                                <button type="submit" name="decision" value="Approved" class="evaluation-review-approve">
                                                    <i class="bi bi-check2-circle" aria-hidden="true"></i>Duyệt
                                                </button>
                                                <button type="submit" name="decision" value="Rejected" class="evaluation-review-reject">
                                                    <i class="bi bi-x-circle" aria-hidden="true"></i>Từ chối
                                                </button>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Đang chờ giám đốc review</span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div class="evaluation-empty" role="status">
                        <span class="evaluation-empty-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span>
                        <h2>Tất cả đã được xử lý!</h2>
                        <p>Không có đánh giá nào đang chờ duyệt lúc này.</p>
                        <a asp-action="Index" class="evaluation-secondary-action">
                            <i class="bi bi-arrow-left" aria-hidden="true"></i>Quay lại danh sách
                        </a>
                    </div>
                }
            </div>
    </section>
</div>
