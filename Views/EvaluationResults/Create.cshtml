@model Manage_KPI_or_OKR_System.Models.EvaluationResult
@{
    ViewData["Title"] = "Thêm kết quả đánh giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var allEmployees = ViewBag.AllEmployees as List<Manage_KPI_or_OKR_System.Models.Employee> ?? new List<Manage_KPI_or_OKR_System.Models.Employee>();
    var allPeriods = ViewBag.AllPeriods as List<Manage_KPI_or_OKR_System.Models.EvaluationPeriod> ?? new List<Manage_KPI_or_OKR_System.Models.EvaluationPeriod>();
    var allRanks = ViewBag.AllRanks as List<Manage_KPI_or_OKR_System.Models.GradingRank> ?? new List<Manage_KPI_or_OKR_System.Models.GradingRank>();
    var rankScaleJson = System.Text.Json.JsonSerializer.Serialize(allRanks
        .Where(r => r.MinScore.HasValue)
        .OrderByDescending(r => r.MinScore)
        .Select(r => new
        {
            id = r.Id,
            rankCode = r.RankCode ?? "N/A",
            description = r.Description ?? "Chưa phân loại",
            minScore = r.MinScore ?? 0
        }));
}

<div class="cf-page evaluation-result-create" data-create-form>
    <script id="evaluationRankScaleConfig" type="application/json">@Html.Raw(rankScaleJson)</script>

    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Thêm kết quả đánh giá</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Kết quả đánh giá</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Thêm mới</span>
            </nav>
            <p class="cf-header__description">Chọn đúng nhân viên và kỳ đánh giá, sau đó nhập tổng điểm để hệ thống tự xác định xếp hạng và phân loại.</p>
        </div>
        <a asp-action="Index" class="cf-back-action">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại</span>
        </a>
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="evaluationResultFormHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="evaluationResultFormHeading">Thông tin kết quả</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
            </div>

            <form asp-action="Create" method="post" class="cf-form" data-create-form-element>
                <div asp-validation-summary="All" class="cf-alert" role="alert" tabindex="-1" data-error-summary></div>

                <section class="cf-section" aria-labelledby="evaluationSubjectHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-person-check"></i></span>
                        <div>
                            <h3 id="evaluationSubjectHeading">Đối tượng đánh giá</h3>
                            <p>Liên kết kết quả với nhân viên và kỳ đánh giá tương ứng.</p>
                        </div>
                    </div>
                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label asp-for="EmployeeId">Nhân viên <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <select asp-for="EmployeeId" class="form-select cf-control" aria-describedby="employeeHint" aria-required="true" required>
                                <option value="">-- Chọn nhân viên --</option>
                                @foreach (var e in allEmployees)
                                {
                                    <option value="@e.Id">@e.FullName (@e.EmployeeCode)</option>
                                }
                            </select>
                            <span asp-validation-for="EmployeeId" class="cf-validation"></span>
                            <p id="employeeHint" class="cf-hint">Mỗi nhân viên chỉ có một kết quả trong cùng một kỳ.</p>
                        </div>
                        <div class="cf-field">
                            <label asp-for="PeriodId">Kỳ đánh giá <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <select asp-for="PeriodId" class="form-select cf-control" aria-describedby="periodHint" aria-required="true" required>
                                <option value="">-- Chọn kỳ đánh giá --</option>
                                @foreach (var p in allPeriods)
                                {
                                    <option value="@p.Id">@p.PeriodName</option>
                                }
                            </select>
                            <span asp-validation-for="PeriodId" class="cf-validation"></span>
                            <p id="periodHint" class="cf-hint">Chỉ chọn kỳ đang áp dụng cho việc ghi nhận kết quả.</p>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="evaluationScoreHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-bar-chart-line"></i></span>
                        <div>
                            <h3 id="evaluationScoreHeading">Kết quả đánh giá</h3>
                            <p>Nhập tổng điểm trên thang 100; xếp hạng và phân loại được tính tự động.</p>
                        </div>
                    </div>
                    <div class="cf-field-grid cf-field-grid--three">
                        <div class="cf-field">
                            <label asp-for="TotalScore">Tổng điểm <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="TotalScore" id="TotalScore" type="number" class="form-control cf-control js-score-input" step="0.01" min="0" max="100" inputmode="decimal" placeholder="0 - 100" aria-describedby="scoreHint" aria-required="true" required data-rank-output="rankDisplay" data-classification-output="classificationDisplay" />
                            <span asp-validation-for="TotalScore" class="cf-validation"></span>
                            <p id="scoreHint" class="cf-hint">Giá trị hợp lệ từ 0 đến 100.</p>
                        </div>
                        <div class="cf-field">
                            <label for="rankDisplay">Xếp hạng</label>
                            <input type="text" id="rankDisplay" class="form-control cf-control" value="Tự động theo tổng điểm" readonly aria-live="polite" />
                        </div>
                        <div class="cf-field">
                            <label for="classificationDisplay">Phân loại</label>
                            <input type="text" id="classificationDisplay" class="form-control cf-control" value="Tự động theo tổng điểm" readonly aria-live="polite" />
                        </div>
                        <div class="cf-field cf-field--full">
                            <label asp-for="ReviewComment">Nhận xét đánh giá</label>
                            <textarea asp-for="ReviewComment" class="form-control cf-control" rows="4" maxlength="2000" aria-describedby="reviewHint" placeholder="Nhập nhận xét đánh giá hoặc bổ sung sau"></textarea>
                            <span asp-validation-for="ReviewComment" class="cf-validation"></span>
                            <p id="reviewHint" class="cf-hint">Tối đa 2.000 ký tự, có thể bổ sung sau khi lưu.</p>
                        </div>
                    </div>
                </section>

                <div class="cf-actions">
                    <a asp-action="Index" class="cf-secondary-action">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                        <span>Hủy</span>
                    </a>
                    <button type="submit" class="cf-primary-action" data-submit-button data-default-label="Lưu kết quả" data-loading-label="Đang lưu...">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span data-submit-label aria-live="polite">Lưu kết quả</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide evaluation-result-preview" aria-labelledby="evaluationResultPreviewHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-award"></i></span>
                <div>
                    <span class="cf-guide__eyebrow">Xem trước</span>
                    <h2 id="evaluationResultPreviewHeading">Kết quả hiện tại</h2>
                </div>
            </div>
            <p id="previewStatus" role="status" aria-live="polite" aria-atomic="true">Nhập tổng điểm để xem xếp hạng dự kiến.</p>
            <dl class="cf-preview-list">
                <div>
                    <dt>Tổng điểm</dt>
                    <dd id="previewScore">--</dd>
                </div>
                <div>
                    <dt>Xếp hạng</dt>
                    <dd id="previewRank">--</dd>
                </div>
                <div>
                    <dt>Phân loại</dt>
                    <dd id="previewClass">--</dd>
                </div>
            </dl>
            <ul class="cf-guide__list">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Điểm được giới hạn trong thang 100.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Xếp hạng lấy theo ngưỡng điểm đã cấu hình.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Kết quả chỉ được ghi nhận sau khi lưu.</span></li>
            </ul>
            <div class="cf-guide__note">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>Xem trước giúp kiểm tra nhanh dữ liệu nhập; validation phía server vẫn là kết quả cuối cùng.</span>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-results.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
    <script src="~/js/evaluation-results.js" asp-append-version="true"></script>
    <script>
        (function() {
            const scoreInput = document.getElementById('TotalScore');
            const previewScore = document.getElementById('previewScore');
            const previewRank = document.getElementById('previewRank');
            const previewClass = document.getElementById('previewClass');
            const rankDisplay = document.getElementById('rankDisplay');
            const classificationDisplay = document.getElementById('classificationDisplay');

            function updateCreatePagePreview() {
                if (!scoreInput) return;
                const val = scoreInput.value;
                if (previewScore) previewScore.textContent = val ? val + ' điểm' : '--';
                if (previewRank && rankDisplay) previewRank.textContent = rankDisplay.value || '--';
                if (previewClass && classificationDisplay) previewClass.textContent = classificationDisplay.value || '--';
            }

            scoreInput?.addEventListener('input', updateCreatePagePreview);
            updateCreatePagePreview();
        })();
    </script>
}
