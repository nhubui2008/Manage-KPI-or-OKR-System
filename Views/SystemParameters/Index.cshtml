                                                            }
                                                            else if (isRetentionDays)
                                                            {
                                                                <div class="input-group input-group-sm">
                                                                    <input form="@formId" type="number" name="value" class="form-control" value="@item.Value" min="1" max="3650" step="1" required style="min-height: 38px;" />
                                                                    <span class="input-group-text">ngày</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <input form="@formId" type="text" name="value" class="form-control form-control-sm" value="@item.Value" maxlength="2000" required style="min-height: 38px;" />
                                                            }
                                                            <button type="submit" form="@formId" class="sys-op-save-btn" title="Lưu tham số @item.ParameterCode">
