@model Manage_KPI_or_OKR_System.Models.ViewModels.SystemSettingsViewModel
@using Manage_KPI_or_OKR_System.Services
@{
    ViewData["Title"] = "Cài đặt tham số hệ thống";
    var branding = Model.Branding;
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/system-parameters.css" asp-append-version="true" />
}

<div class="evaluation-page system-settings-page">
    <!-- PAGE HEADER -->
    <header class="evaluation-page-header">
        <div>
            <h1>Cài đặt hệ thống</h1>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-controller="Catalog" asp-action="Index">Cài đặt</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Tham số hệ thống</span>
            </nav>
            <div class="header-badge-wrapper">
                <span class="header-brand-badge">
                    <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
                    <span>@branding.ShortName</span>
                </span>
                <span class="text-muted" style="font-size: 0.76rem;">Quản trị nhận diện thương hiệu, giao diện và các tham số kỹ thuật</span>
            </div>
        </div>
        <div class="system-settings-header-actions">
            <form asp-action="ResetBranding" method="post"
                  data-app-confirm
                  data-confirm-title="Khôi phục nhận diện mặc định?"
                  data-confirm-message="Tên sản phẩm, logo, màu sắc và toàn bộ cấu hình thương hiệu sẽ trở về giá trị mặc định của hệ thống."
                  data-confirm-tone="warning"
                  data-confirm-label="Khôi phục mặc định">
                <button type="submit" class="evaluation-secondary-action" title="Khôi phục tất cả cài đặt thương hiệu về mặc định">
                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                    <span>Khôi phục mặc định</span>
                </button>
            </form>
            <a asp-controller="Catalog" asp-action="Index" class="evaluation-secondary-action" title="Quay lại danh mục hệ thống">
                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                <span>Danh mục hệ thống</span>
            </a>
        </div>
    </header>

    <!-- SUMMARY KPI BANNER -->
    <section class="sys-summary-grid" aria-label="Thống kê tham số hệ thống">
        <article class="sys-summary-card sys-summary-card--branding">
            <div class="sys-summary-content">
                <span class="sys-summary-label">Tham số thương hiệu</span>
                <strong class="sys-summary-value">@Model.BrandingParameters.Count</strong>
                <span class="sys-summary-meta">Tùy biến toàn bộ giao diện</span>
            </div>
            <div class="sys-summary-icon-box sys-summary-icon--branding">
                <i class="bi bi-palette2" aria-hidden="true"></i>
            </div>
        </article>

        <article class="sys-summary-card sys-summary-card--operational">
            <div class="sys-summary-content">
                <span class="sys-summary-label">Tham số vận hành</span>
                <strong class="sys-summary-value">@Model.OtherParameters.Count</strong>
                <span class="sys-summary-meta">Chính sách & tác vụ nền</span>
            </div>
            <div class="sys-summary-icon-box sys-summary-icon--operational">
                <i class="bi bi-sliders2" aria-hidden="true"></i>
            </div>
        </article>

        <article class="sys-summary-card sys-summary-card--ai">
            <div class="sys-summary-content">
                <span class="sys-summary-label">Trợ lý AI hệ thống</span>
                <strong class="sys-summary-value" id="summaryAiName" style="font-size: 1.05rem;" title="@branding.AiAssistantName">
                    @(string.IsNullOrWhiteSpace(branding.AiAssistantName) ? "Chưa kích hoạt" : branding.AiAssistantName)
                </strong>
                <span class="sys-summary-meta">Tích hợp AI Prompt & Copilot</span>
            </div>
            <div class="sys-summary-icon-box sys-summary-icon--ai">
                <i class="bi bi-robot" aria-hidden="true"></i>
            </div>
        </article>

        <article class="sys-summary-card sys-summary-card--palette">
            <div class="sys-summary-content">
                <span class="sys-summary-label">Màu sắc chủ đạo</span>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="sys-palette-preview-pill">
                        <span class="sys-palette-dot" id="summaryPrimaryDot" style="background-color: @branding.PrimaryColor;" title="Màu chủ đạo"></span>
                        <span class="sys-palette-dot" id="summaryDarkDot" style="background-color: @branding.PrimaryDarkColor;" title="Màu chủ đạo đậm"></span>
                        <span class="sys-palette-dot" id="summarySidebarDot" style="background-color: @branding.SidebarColor;" title="Màu sidebar"></span>
                    </span>
                    <strong class="sys-summary-value" id="summaryPrimaryHex" style="font-size: 0.95rem; font-family: monospace;">@branding.PrimaryColor</strong>
                </div>
                <span class="sys-summary-meta">Hệ thống CSS Variables</span>
            </div>
            <div class="sys-summary-icon-box sys-summary-icon--palette">
                <i class="bi bi-paint-bucket" aria-hidden="true"></i>
            </div>
        </article>
    </section>

    <!-- TAB NAVIGATION BAR -->
    <div class="sys-tabs-nav-wrapper">
        <ul class="sys-tabs-nav" id="sysSettingsTabs" role="tablist">
            <li role="presentation">
                <button type="button" class="sys-tab-link active" data-tab-target="tab-branding" role="tab" aria-selected="true">
                    <span class="sys-tab-icon"><i class="bi bi-briefcase-fill" aria-hidden="true"></i></span>
                    <span>1. Nhận diện doanh nghiệp</span>
                </button>
            </li>
            <li role="presentation">
                <button type="button" class="sys-tab-link" data-tab-target="tab-assets" role="tab" aria-selected="false">
                    <span class="sys-tab-icon"><i class="bi bi-images" aria-hidden="true"></i></span>
                    <span>2. Logo & Tài nguyên</span>
                </button>
            </li>
            <li role="presentation">
                <button type="button" class="sys-tab-link" data-tab-target="tab-colors" role="tab" aria-selected="false">
                    <span class="sys-tab-icon"><i class="bi bi-palette-fill" aria-hidden="true"></i></span>
                    <span>3. Màu sắc & Bảng màu</span>
                </button>
            </li>
            <li role="presentation">
                <button type="button" class="sys-tab-link" data-tab-target="tab-advanced" role="tab" aria-selected="false">
                    <span class="sys-tab-icon"><i class="bi bi-code-square" aria-hidden="true"></i></span>
                    <span>4. AI, SEO & Custom CSS</span>
                </button>
            </li>
            <li role="presentation">
                <button type="button" class="sys-tab-link" data-tab-target="tab-operational" role="tab" aria-selected="false">
                    <span class="sys-tab-icon"><i class="bi bi-gear-wide-connected" aria-hidden="true"></i></span>
                    <span>5. Tham số vận hành</span>
                    <span class="sys-tab-badge">@Model.OtherParameters.Count</span>
                </button>
            </li>
        </ul>
    </div>

    <!-- MAIN FORM & WORKSPACE -->
    <form asp-action="UpdateBranding" method="post" enctype="multipart/form-data" id="brandingSettingsForm">
        <div class="sys-workspace">
            <!-- FORM MAIN COLUMN -->
            <div class="sys-form-column">
                <div asp-validation-summary="All" class="alert alert-danger settings-validation mb-3" role="alert"></div>

                <!-- PANE 1: THƯƠNG HIỆU & DOANH NGHIỆP -->
                <div class="sys-tab-pane active" id="tab-branding" role="tabpanel">
                    <div class="sys-group-card">
                        <div class="sys-group-header">
                            <span class="sys-group-icon"><i class="bi bi-buildings" aria-hidden="true"></i></span>
                            <div>
                                <strong class="sys-group-title">Thông tin thương hiệu & Tổ chức</strong>
                                <span class="sys-group-desc">Tên sản phẩm, tên hiển thị trên thanh bên và tiêu đề giao diện người dùng.</span>
                            </div>
                        </div>

                        <div class="sys-grid-2">
                            <div class="sys-field">
                                <label asp-for="Branding.ProductName" class="sys-field-label">
                                    <span>Tên sản phẩm chính <span class="sys-required">*</span></span>
                                </label>
                                <div class="sys-input-wrapper">
                                    <i class="bi bi-app-indicator sys-input-icon"></i>
                                    <input asp-for="Branding.ProductName" class="form-control sys-input-has-icon" maxlength="200" required placeholder="NextGen KPI/OKR System" />
                                </div>
                                <span asp-validation-for="Branding.ProductName" class="text-danger small"></span>
                                <p class="sys-field-hint">Hiển thị trên thanh tiêu đề trình duyệt, email thông báo và metadata trang.</p>
                            </div>

                            <div class="sys-field">
                                <label asp-for="Branding.ShortName" class="sys-field-label">
                                    <span>Tên ngắn trên Sidebar <span class="sys-required">*</span></span>
                                </label>
                                <div class="sys-input-wrapper">
                                    <i class="bi bi-layout-sidebar-inset sys-input-icon"></i>
                                    <input asp-for="Branding.ShortName" class="form-control sys-input-has-icon" maxlength="80" required placeholder="NextGen System" />
                                </div>
                                <span asp-validation-for="Branding.ShortName" class="text-danger small"></span>
                                <p class="sys-field-hint">Tên hiển thị bên cạnh Logo trên thanh menu điều hướng.</p>
                            </div>

                            <div class="sys-field">
                                <label asp-for="Branding.CompanyName" class="sys-field-label">
                                    <span>Tên doanh nghiệp / Đơn vị sở hữu <span class="sys-required">*</span></span>
                                </label>
                                <div class="sys-input-wrapper">
                                    <i class="bi bi-building sys-input-icon"></i>
                                    <input asp-for="Branding.CompanyName" class="form-control sys-input-has-icon" maxlength="120" required placeholder="NextGen Corp" />
                                </div>
                                <span asp-validation-for="Branding.CompanyName" class="text-danger small"></span>
                            </div>

                            <div class="sys-field">
                                <label asp-for="Branding.Tagline" class="sys-field-label">
                                    <span>Khẩu hiệu / Slogan</span>
                                </label>
                                <div class="sys-input-wrapper">
                                    <i class="bi bi-chat-quote sys-input-icon"></i>
                                    <input asp-for="Branding.Tagline" class="form-control sys-input-has-icon" maxlength="160" placeholder="Quản trị hiệu suất toàn diện" />
                                </div>
                                <span asp-validation-for="Branding.Tagline" class="text-danger small"></span>
                                <p class="sys-field-hint">Dòng mô tả ngắn xuất hiện dưới Logo thương hiệu.</p>
                            </div>
                        </div>
                    </div>

                    <div class="sys-group-card">
                        <div class="sys-group-header">
                            <span class="sys-group-icon"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i></span>
                            <div>
                                <strong class="sys-group-title">Màn hình đăng nhập & Xác thực</strong>
                                <span class="sys-group-desc">Tiêu đề và lời chào mừng hiển thị tại trang đăng nhập của nhân viên.</span>
                            </div>
                        </div>

                        <div class="sys-grid-2">
                            <div class="sys-field">
                                <label asp-for="Branding.LoginTitle" class="sys-field-label">
                                    <span>Tiêu đề đăng nhập</span>
                                </label>
                                <div class="sys-input-wrapper">
                                    <i class="bi bi-shield-lock sys-input-icon"></i>
                                    <input asp-for="Branding.LoginTitle" class="form-control sys-input-has-icon" maxlength="120" placeholder="Đăng nhập hệ thống" />
                                </div>
                                <span asp-validation-for="Branding.LoginTitle" class="text-danger small"></span>
                            </div>

                            <div class="sys-field">
                                <label asp-for="Branding.LoginSubtitle" class="sys-field-label">
                                    <span>Mô tả đăng nhập</span>
                                </label>
                                <div class="sys-input-wrapper">
                                    <i class="bi bi-info-circle sys-input-icon"></i>
                                    <input asp-for="Branding.LoginSubtitle" class="form-control sys-input-has-icon" maxlength="180" placeholder="Hệ thống Quản lý KPI & OKR Doanh nghiệp" />
                                </div>
                                <span asp-validation-for="Branding.LoginSubtitle" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PANE 2: LOGO & TÀI NGUYÊN -->
                <div class="sys-tab-pane" id="tab-assets" role="tabpanel">
                    <div class="sys-group-card">
                        <div class="sys-group-header">
                            <span class="sys-group-icon"><i class="bi bi-image" aria-hidden="true"></i></span>
                            <div>
                                <strong class="sys-group-title">Logo & Favicon nhận diện</strong>
                                <span class="sys-group-desc">Tải ảnh trực tiếp lên máy chủ hoặc cấu hình đường dẫn URL tĩnh.</span>
                            </div>
                        </div>

                        <div class="sys-grid-2">
                            <!-- Logo Dropzone -->
                            <div class="sys-field">
                                <label class="sys-field-label">
                                    <span>Logo chính</span>
                                    <span class="badge bg-light text-secondary">Tối đa 2MB</span>
                                </label>
                                <div class="sys-dropzone-card" id="logoDropzone">
                                    <div class="sys-dropzone-preview" id="logoUploadPreview">
                                        @if (!string.IsNullOrWhiteSpace(branding.LogoUrl))
                                        {
                                            <img src="@branding.LogoUrl" alt="Logo hiện tại" id="logoCurrentImg" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                                        }
                                    </div>
                                    <div class="sys-dropzone-copy">
                                        <strong>Nhấn để chọn hoặc kéo thả logo</strong>
                                        <span>Định dạng PNG, JPG, WEBP hoặc ICO</span>
                                    </div>
                                    <input asp-for="Branding.LogoFile" class="sys-file-input" type="file" accept=".png,.jpg,.jpeg,.webp,.ico" id="Branding_LogoFile" />
                                </div>
                                <div class="mt-2">
                                    <label asp-for="Branding.LogoUrl" class="small text-muted mb-1">Hoặc nhập Logo URL</label>
                                    <input asp-for="Branding.LogoUrl" class="form-control form-control-sm font-monospace" placeholder="/uploads/branding/logo.png" />
                                    <span asp-validation-for="Branding.LogoUrl" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Favicon Dropzone -->
                            <div class="sys-field">
                                <label class="sys-field-label">
                                    <span>Favicon trình duyệt</span>
                                    <span class="badge bg-light text-secondary">Tỉ lệ 1:1</span>
                                </label>
                                <div class="sys-dropzone-card" id="faviconDropzone">
                                    <div class="sys-dropzone-preview" id="faviconUploadPreview">
                                        @if (!string.IsNullOrWhiteSpace(branding.FaviconUrl))
                                        {
                                            <img src="@branding.FaviconUrl" alt="Favicon hiện tại" id="faviconCurrentImg" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-browser-chrome" aria-hidden="true"></i>
                                        }
                                    </div>
                                    <div class="sys-dropzone-copy">
                                        <strong>Nhấn để chọn Favicon mới</strong>
                                        <span>Ưu tiên file .ICO hoặc PNG vuông (32x32px)</span>
                                    </div>
                                    <input asp-for="Branding.FaviconFile" class="sys-file-input" type="file" accept=".ico,.png,.jpg,.jpeg,.webp" id="Branding_FaviconFile" />
                                </div>
                                <div class="mt-2">
                                    <label asp-for="Branding.FaviconUrl" class="small text-muted mb-1">Hoặc nhập Favicon URL</label>
                                    <input asp-for="Branding.FaviconUrl" class="form-control form-control-sm font-monospace" placeholder="/favicon.ico" />
                                    <span asp-validation-for="Branding.FaviconUrl" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- SEO Banner & Public URL -->
                            <div class="sys-field">
                                <label asp-for="Branding.SeoImageUrl" class="sys-field-label">
                                    <span>Đường dẫn ảnh SEO / Open Graph Banner</span>
                                </label>
                                <div class="sys-input-wrapper">
                                    <i class="bi bi-card-image sys-input-icon"></i>
                                    <input asp-for="Branding.SeoImageUrl" class="form-control sys-input-has-icon font-monospace" placeholder="/images/seo-banner.png" />
                                </div>
                                <span asp-validation-for="Branding.SeoImageUrl" class="text-danger small"></span>
                                <p class="sys-field-hint">Ảnh đại diện xuất hiện khi chia sẻ liên kết trên Facebook, Zalo, LinkedIn.</p>
                            </div>

                            <div class="sys-field">
                                <label asp-for="Branding.PublicBaseUrl" class="sys-field-label">
                                    <span>Public Base URL hệ thống</span>
                                </label>
                                <div class="sys-input-wrapper">
                                    <i class="bi bi-globe sys-input-icon"></i>
                                    <input asp-for="Branding.PublicBaseUrl" class="form-control sys-input-has-icon font-monospace" placeholder="https://kpi.doanhnghiep.vn" inputmode="url" />
                                </div>
                                <span asp-validation-for="Branding.PublicBaseUrl" class="text-danger small"></span>
                                <p class="sys-field-hint">Địa chỉ domain gốc dùng để tạo Canonical URL và link kích hoạt tài khoản.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PANE 3: MÀU SẮC & BẢNG MÀU -->
                <div class="sys-tab-pane" id="tab-colors" role="tabpanel">
                    <!-- PRESET PALETTES -->
                    <div class="sys-presets-panel">
                        <div class="sys-presets-title">
                            <i class="bi bi-magic" aria-hidden="true"></i>
                            <span>Gợi ý phối màu 1-Click (Preset Color Palettes)</span>
                        </div>
                        <div class="sys-presets-grid">
                            <button type="button" class="sys-preset-btn" data-preset="nextgen">
                                <span class="sys-preset-dots">
                                    <span class="sys-preset-dot" style="background: #7b68ee;"></span>
                                    <span class="sys-preset-dot" style="background: #6647f0;"></span>
                                    <span class="sys-preset-dot" style="background: #ffffff;"></span>
                                    <span class="sys-preset-dot" style="background: #292d34;"></span>
                                </span>
                                <span>NextGen Violet</span>
                            </button>

                            <button type="button" class="sys-preset-btn" data-preset="indigo">
                                <span class="sys-preset-dots">
                                    <span class="sys-preset-dot" style="background: #556ee6;"></span>
                                    <span class="sys-preset-dot" style="background: #394da9;"></span>
                                    <span class="sys-preset-dot" style="background: #ffffff;"></span>
                                    <span class="sys-preset-dot" style="background: #495057;"></span>
                                </span>
                                <span>Velzon Indigo</span>
                            </button>

                            <button type="button" class="sys-preset-btn" data-preset="dark">
                                <span class="sys-preset-dots">
                                    <span class="sys-preset-dot" style="background: #6366f1;"></span>
                                    <span class="sys-preset-dot" style="background: #4f46e5;"></span>
                                    <span class="sys-preset-dot" style="background: #111827;"></span>
                                    <span class="sys-preset-dot" style="background: #f9fafb;"></span>
                                </span>
                                <span>Midnight Dark</span>
                            </button>

                            <button type="button" class="sys-preset-btn" data-preset="ocean">
                                <span class="sys-preset-dots">
                                    <span class="sys-preset-dot" style="background: #0284c7;"></span>
                                    <span class="sys-preset-dot" style="background: #0369a1;"></span>
                                    <span class="sys-preset-dot" style="background: #0f172a;"></span>
                                    <span class="sys-preset-dot" style="background: #f8fafc;"></span>
                                </span>
                                <span>Ocean Tech</span>
                            </button>

                            <button type="button" class="sys-preset-btn" data-preset="emerald">
                                <span class="sys-preset-dots">
                                    <span class="sys-preset-dot" style="background: #0ab39c;"></span>
                                    <span class="sys-preset-dot" style="background: #087d6d;"></span>
                                    <span class="sys-preset-dot" style="background: #ffffff;"></span>
                                    <span class="sys-preset-dot" style="background: #134e4a;"></span>
                                </span>
                                <span>Emerald Growth</span>
                            </button>

                            <button type="button" class="sys-preset-btn" data-preset="crimson">
                                <span class="sys-preset-dots">
                                    <span class="sys-preset-dot" style="background: #f06548;"></span>
                                    <span class="sys-preset-dot" style="background: #d04427;"></span>
                                    <span class="sys-preset-dot" style="background: #ffffff;"></span>
                                    <span class="sys-preset-dot" style="background: #431407;"></span>
                                </span>
                                <span>Sunset Coral</span>
                            </button>
                        </div>
                    </div>

                    <div class="sys-group-card">
                        <div class="sys-group-header">
                            <span class="sys-group-icon"><i class="bi bi-palette" aria-hidden="true"></i></span>
                            <div>
                                <strong class="sys-group-title">Tùy chỉnh màu sắc chi tiết</strong>
                                <span class="sys-group-desc">Nhập mã Hex hoặc chọn trực tiếp qua bảng màu. Tự động đồng bộ với CSS Variables hệ thống.</span>
                            </div>
                        </div>

                        <div class="sys-grid-3">
                            <!-- Primary Color -->
                            <div class="sys-color-card">
                                <div class="sys-color-card-top">
                                    <span class="sys-color-card-title">Màu chủ đạo (Primary)</span>
                                    <i class="bi bi-stars text-primary" title="Nút bấm, điểm nhấn chính"></i>
                                </div>
                                <div class="sys-color-picker-group">
                                    <button type="button" class="sys-color-swatch-btn" id="swatch_Branding_PrimaryColor" style="background-color: @branding.PrimaryColor;">
                                        <input asp-for="Branding.PrimaryColor" type="color" id="Branding_PrimaryColor" />
                                    </button>
                                    <input type="text" class="form-control sys-color-hex-input" id="hex_Branding_PrimaryColor" value="@branding.PrimaryColor" maxlength="7" />
                                </div>
                                <span asp-validation-for="Branding.PrimaryColor" class="text-danger small"></span>
                            </div>

                            <!-- Primary Dark Color -->
                            <div class="sys-color-card">
                                <div class="sys-color-card-top">
                                    <span class="sys-color-card-title">Màu chủ đạo đậm</span>
