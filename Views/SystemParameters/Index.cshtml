</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('brandingSettingsForm');
            const sandbox = document.getElementById('sandboxDevice');
            if (!form || !sandbox) return;

            // 1. TAB SWITCHING LOGIC
            const tabLinks = document.querySelectorAll('.sys-tab-link');
            const tabPanes = document.querySelectorAll('.sys-tab-pane');

            tabLinks.forEach(link => {
                link.addEventListener('click', () => {
                    const targetId = link.getAttribute('data-tab-target');
                    tabLinks.forEach(l => {
                        l.classList.remove('active');
                        l.setAttribute('aria-selected', 'false');
                    });
                    tabPanes.forEach(p => p.classList.remove('active'));

                    link.classList.add('active');
                    link.setAttribute('aria-selected', 'true');
                    const targetPane = document.getElementById(targetId);
                    if (targetPane) targetPane.classList.add('active');

                    // Save active tab in sessionStorage
                    sessionStorage.setItem('sysSettingsActiveTab', targetId);
                });
            });

            // Restore saved active tab if exists
            const savedTab = sessionStorage.getItem('sysSettingsActiveTab');
            if (savedTab) {
                const savedLink = document.querySelector(`.sys-tab-link[data-tab-target="${savedTab}"]`);
                if (savedLink) savedLink.click();
            }

            // 2. PREVIEW MODE SWITCHER (App / Login / AI)
            const modeBtns = document.querySelectorAll('.sys-preview-mode-btn');
            const modeApp = document.getElementById('previewModeApp');
            const modeLogin = document.getElementById('previewModeLogin');
            const modeAi = document.getElementById('previewModeAi');

            modeBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    modeBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    const mode = btn.getAttribute('data-preview-mode');

                    if (mode === 'app') {
                        modeApp.style.display = 'flex';
                        modeLogin.style.display = 'none';
                        modeAi.style.display = 'none';
                    } else if (mode === 'login') {
                        modeApp.style.display = 'none';
                        modeLogin.style.display = 'block';
                        modeAi.style.display = 'none';
                    } else if (mode === 'ai') {
                        modeApp.style.display = 'none';
                        modeLogin.style.display = 'none';
                        modeAi.style.display = 'block';
                    }
                });
            });

            // 3. COLOR TWO-WAY SYNC & SANDBOX CSS VARIABLES
            const colorMap = {
                Branding_PrimaryColor: '--preview-primary',
                Branding_PrimaryDarkColor: '--preview-primary-dark',
                Branding_SidebarColor: '--preview-sidebar',
                Branding_SidebarGradientEnd: '--preview-sidebar-end',
                Branding_SidebarTextColor: '--preview-sidebar-text',
                Branding_BodyBackgroundColor: '--preview-bg',
                Branding_CardBackgroundColor: '--preview-card'
            };

            const syncColorInputs = (fieldId, hexValue) => {
                if (!hexValue || !hexValue.startsWith('#')) return;
                const colorInput = document.getElementById(fieldId);
                const hexInput = document.getElementById(`hex_${fieldId}`);
                const swatchBtn = document.getElementById(`swatch_${fieldId}`);

                if (colorInput && colorInput.value !== hexValue) colorInput.value = hexValue;
                if (hexInput && hexInput.value !== hexValue) hexInput.value = hexValue.toUpperCase();
                if (swatchBtn) swatchBtn.style.backgroundColor = hexValue;

                // Sync with sandbox variable
                const cssVar = colorMap[fieldId];
                if (cssVar) sandbox.style.setProperty(cssVar, hexValue);

                // Update summary banner dots
                if (fieldId === 'Branding_PrimaryColor') {
                    const dot = document.getElementById('summaryPrimaryDot');
                    const hexDisplay = document.getElementById('summaryPrimaryHex');
                    if (dot) dot.style.backgroundColor = hexValue;
                    if (hexDisplay) hexDisplay.textContent = hexValue.toUpperCase();
                } else if (fieldId === 'Branding_PrimaryDarkColor') {
                    const dot = document.getElementById('summaryDarkDot');
                    if (dot) dot.style.backgroundColor = hexValue;
                } else if (fieldId === 'Branding_SidebarColor') {
                    const dot = document.getElementById('summarySidebarDot');
                    if (dot) dot.style.backgroundColor = hexValue;
                }
            };

            // Bind listeners for color pickers and hex inputs
            Object.keys(colorMap).forEach(fieldId => {
                const colorInput = document.getElementById(fieldId);
                const hexInput = document.getElementById(`hex_${fieldId}`);

                colorInput?.addEventListener('input', (e) => syncColorInputs(fieldId, e.target.value));
                hexInput?.addEventListener('input', (e) => {
                    let val = e.target.value.trim();
                    if (!val.startsWith('#') && val.length > 0) val = '#' + val;
                    if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                        syncColorInputs(fieldId, val);
                    }
                });
            });

            // 4. PRESET COLOR PALETTES
            const presets = {
                nextgen: {
                    Branding_PrimaryColor: '#7b68ee',
                    Branding_PrimaryDarkColor: '#6647f0',
                    Branding_SidebarColor: '#ffffff',
                    Branding_SidebarGradientEnd: '#f8f9fa',
                    Branding_SidebarTextColor: '#292d34',
                    Branding_BodyBackgroundColor: '#ffffff',
                    Branding_CardBackgroundColor: '#ffffff'
                },
                indigo: {
                    Branding_PrimaryColor: '#556ee6',
                    Branding_PrimaryDarkColor: '#394da9',
                    Branding_SidebarColor: '#ffffff',
                    Branding_SidebarGradientEnd: '#f8f9fa',
                    Branding_SidebarTextColor: '#495057',
                    Branding_BodyBackgroundColor: '#f8f9fa',
                    Branding_CardBackgroundColor: '#ffffff'
                },
                dark: {
                    Branding_PrimaryColor: '#6366f1',
                    Branding_PrimaryDarkColor: '#4f46e5',
                    Branding_SidebarColor: '#111827',
                    Branding_SidebarGradientEnd: '#1f2937',
                    Branding_SidebarTextColor: '#f9fafb',
                    Branding_BodyBackgroundColor: '#f3f4f6',
                    Branding_CardBackgroundColor: '#ffffff'
                },
                ocean: {
                    Branding_PrimaryColor: '#0284c7',
                    Branding_PrimaryDarkColor: '#0369a1',
                    Branding_SidebarColor: '#0f172a',
                    Branding_SidebarGradientEnd: '#1e293b',
                    Branding_SidebarTextColor: '#f8fafc',
                    Branding_BodyBackgroundColor: '#f8fafc',
                    Branding_CardBackgroundColor: '#ffffff'
                },
                emerald: {
                    Branding_PrimaryColor: '#0ab39c',
                    Branding_PrimaryDarkColor: '#087d6d',
                    Branding_SidebarColor: '#ffffff',
                    Branding_SidebarGradientEnd: '#f0fdfa',
                    Branding_SidebarTextColor: '#134e4a',
                    Branding_BodyBackgroundColor: '#f8fafc',
                    Branding_CardBackgroundColor: '#ffffff'
                },
                crimson: {
                    Branding_PrimaryColor: '#f06548',
                    Branding_PrimaryDarkColor: '#d04427',
                    Branding_SidebarColor: '#ffffff',
                    Branding_SidebarGradientEnd: '#fff1f2',
                    Branding_SidebarTextColor: '#431407',
                    Branding_BodyBackgroundColor: '#fafafa',
                    Branding_CardBackgroundColor: '#ffffff'
                }
            };

            document.querySelectorAll('.sys-preset-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const presetKey = btn.getAttribute('data-preset');
                    const palette = presets[presetKey];
                    if (!palette) return;

                    Object.entries(palette).forEach(([fieldId, hexVal]) => {
                        syncColorInputs(fieldId, hexVal);
                    });
                });
            });

            // 5. TEXT LIVE SYNC TO SANDBOX
            const syncPreviewTexts = () => {
                sandbox.querySelectorAll('[data-preview-text]').forEach(target => {
                    const inputId = target.getAttribute('data-preview-text');
                    const input = document.getElementById(inputId);
                    if (input) {
                        const val = input.value.trim();
                        target.textContent = val || target.getAttribute('data-fallback') || 'Chưa thiết lập';
                    }
                });

                // Update summary banner AI name
                const aiInput = document.getElementById('Branding_AiAssistantName');
                const summaryAi = document.getElementById('summaryAiName');
                if (aiInput && summaryAi) {
                    summaryAi.textContent = aiInput.value.trim() || 'Chưa kích hoạt';
                }
            };

            form.addEventListener('input', syncPreviewTexts);

            // Initial Sync
            Object.keys(colorMap).forEach(fieldId => {
                const colorInput = document.getElementById(fieldId);
                if (colorInput?.value) syncColorInputs(fieldId, colorInput.value);
            });
            syncPreviewTexts();

            // 6. LOGO & FAVICON LIVE PREVIEWS
            const handleImagePreview = (fileInputId, previewContainerIds) => {
                const fileInput = document.getElementById(fileInputId);
                let currentUrl = null;

                fileInput?.addEventListener('change', () => {
                    if (currentUrl) URL.revokeObjectURL(currentUrl);
                    const file = fileInput.files?.[0];
                    if (!file) return;

                    currentUrl = URL.createObjectURL(file);
                    previewContainerIds.forEach(id => {
                        const container = document.getElementById(id);
                        if (container) {
                            const img = document.createElement('img');
                            img.src = currentUrl;
                            img.alt = 'Ảnh xem trước';
                            container.replaceChildren(img);
                        }
                    });
                });
            };

            handleImagePreview('Branding_LogoFile', ['logoUploadPreview', 'sandboxLogoBox', 'sandboxLogoBoxLogin']);
            handleImagePreview('Branding_FaviconFile', ['faviconUploadPreview']);
        });
    </script>
}
