@model Manage_KPI_or_OKR_System.Models.Employee

@{
    ViewData["Title"] = "Xác nhận ngừng hoạt động nhân sự";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string empName = Model.FullName ?? "Unknown";
    string empInitial = empName.Length > 0 ? empName[0].ToString().ToUpper() : "?";
}

@section Styles {
    <link rel="stylesheet" href="~/css/employees.css" asp-append-version="true" />
}

<div class="employees-page" data-employees-page>
    <!-- Page Header -->
    <header class="employees-page-header">
        <div>
            <h1>Xác nhận ngừng hoạt động</h1>
            <nav class="employees-breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Nhân sự</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Xác nhận</span>
            </nav>
        </div>
        <div class="employees-page-actions">
            <a asp-action="Index" class="employees-btn employees-btn--secondary">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>Quay lại danh sách</span>
            </a>
        </div>
    </header>

    <div class="mt-3">
        <!-- Alert Warning -->
        <div class="employees-alert employees-alert--warning" role="alert">
            <i class="bi bi-exclamation-triangle fs-5 flex-shrink-0" aria-hidden="true"></i>
            <div>
                <strong>Cảnh báo ngừng hoạt động nhân sự!</strong> Hành động này sẽ vô hiệu hóa nhân sự trong hệ thống. Dữ liệu vẫn được lưu trữ và giữ lại toàn bộ lịch sử.
            </div>
        </div>

        <div class="employees-card p-4">
            <!-- Employee Summary -->
            <div class="employees-delete-profile">
                <div class="employee-avatar" aria-hidden="true" style="width: 48px; height: 48px; font-size: 1.1rem;">
                    @empInitial
                </div>
                <div>
                    <h2 class="h5 mb-1 fw-bold">@Model.FullName</h2>
                    <span class="text-muted small">Mã nhân sự: <strong>@Model.EmployeeCode</strong></span>
                </div>
            </div>

            <!-- Detail Grid -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="employees-info-row border rounded p-2">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-envelope"></i></div>
                        <div>
                            <div class="employees-info-label">Email</div>
                            <div class="employees-info-value">@(Model.Email ?? "Chưa cập nhật")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="employees-info-row border rounded p-2">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-telephone"></i></div>
                        <div>
                            <div class="employees-info-label">Số điện thoại</div>
                            <div class="employees-info-value">@(Model.Phone ?? "Chưa cập nhật")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="employees-info-row border rounded p-2">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-calendar-event"></i></div>
                        <div>
                            <div class="employees-info-label">Ngày vào làm</div>
                            <div class="employees-info-value">@(Model.JoinDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="employees-info-row border rounded p-2">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-activity"></i></div>
                        <div>
                            <div class="employees-info-label">Trạng thái hiện tại</div>
                            <div class="employees-info-value">
                                @if (Model.IsActive == true)
                                {
                                    <span class="employees-status employees-status--active">
                                        <span aria-hidden="true"></span> Đang làm việc
                                    </span>
                                }
                                else
                                {
                                    <span class="employees-status employees-status--inactive">
                                        <span aria-hidden="true"></span> Đã nghỉ việc
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Information Alert -->
            <div class="employees-alert employees-alert--info mb-4">
                <i class="bi bi-info-circle fs-5 flex-shrink-0" aria-hidden="true"></i>
                <div>
                    <strong class="d-block mb-1">Quy trình xử lý khi vô hiệu hóa:</strong>
                    <ul class="mb-0 ps-3 small">
                        <li>Ẩn nhân sự khỏi danh sách tìm kiếm và lựa chọn công việc mới</li>
                        <li>Bảo lưu dữ liệu lịch sử đánh giá KPI, OKR đã thực hiện</li>
                        <li>Có thể kích hoạt lại bất kỳ lúc nào nếu nhân sự quay lại làm việc</li>
                    </ul>
                </div>
            </div>

            <!-- Confirmation Form -->
            <form asp-action="Delete" method="post" class="employees-delete-actions">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="confirm" value="true" />

                <a asp-action="Index" class="employees-btn employees-btn--secondary">
                    <i class="bi bi-x-circle" aria-hidden="true"></i>
                    <span>Hủy bỏ</span>
                </a>
                <button type="submit" class="employees-btn employees-btn--danger">
                    <i class="bi bi-person-x" aria-hidden="true"></i>
                    <span>Xác nhận ngừng hoạt động</span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

