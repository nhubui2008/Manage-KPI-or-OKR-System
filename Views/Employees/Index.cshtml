@model Manage_KPI_or_OKR_System.Helpers.PaginatedList<Manage_KPI_or_OKR_System.Models.Employee>
@{
    ViewData["Title"] = "Quản lý Nhân sự";
    var assignments = ViewBag.Assignments as Dictionary<int, Manage_KPI_or_OKR_System.Models.EmployeeAssignment> ?? new Dictionary<int, Manage_KPI_or_OKR_System.Models.EmployeeAssignment>();
    var departments = ViewBag.Departments as Dictionary<int, string> ?? new Dictionary<int, string>();
    var positions = ViewBag.Positions as Dictionary<int, string> ?? new Dictionary<int, string>();
    var totalEmployees = Model?.Count() ?? 0;
    var activeEmployees = Model?.Count(e => e.IsActive == true) ?? 0;
    var inactiveEmployees = totalEmployees - activeEmployees;
    var assignedEmployees = assignments.Values.Count(a => a != null && (a.DepartmentId.HasValue || a.PositionId.HasValue));
    var currentStatus = ViewBag.CurrentStatus?.ToString();
    var statusSummary = currentStatus == "true"
        ? "Đang làm việc"
        : currentStatus == "false"
            ? "Đã nghỉ việc"
            : "Mọi trạng thái";
    var departmentSummary = "Tất cả phòng ban";
    string currentDeptStr = ViewBag.CurrentDepartment?.ToString() ?? "";
    if (int.TryParse(currentDeptStr, out int selectedDepartmentId) && departments.ContainsKey(selectedDepartmentId))
    {
        departmentSummary = departments[selectedDepartmentId];
    }
}

@section Styles {
    <style>
        .employees-page .employees-table td:nth-child(1) {
            min-width: 240px;
        }

        .employees-page .employees-table td:nth-child(4) {
            min-width: 230px;
        }

        .employees-mobile-list {
            display: none;
        }

        .employees-mobile-card {
            padding: 1rem;
            border-radius: 16px;
            display: grid;
            gap: 0.85rem;
        }

        .employees-mobile-card__header {
            display: flex;
            align-items: flex-start;
            gap: 0.85rem;
        }

        .employees-mobile-card__title {
            margin: 0 0 0.25rem;
            font-size: 1rem;
            font-weight: 800;
            color: #172033;
        }

        .employees-mobile-card__meta,
        .employees-mobile-card__chips,
        .employees-mobile-card__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .employees-mobile-card__label {
            font-size: 0.76rem;
            font-weight: 800;
            color: #64748b;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .employees-mobile-card__actions .btn,
        .employees-mobile-card__actions .action-btn {
            min-height: 42px;
            border-radius: 12px;
            font-weight: 700;
        }

        @@media (max-width: 767.98px) {
            .employees-page .table-responsive {
                display: none;
            }

            .employees-mobile-list {
                display: grid;
                gap: 0.9rem;
                margin-top: 0.5rem;
            }
        }
    </style>
}

<div class="container-fluid px-0 management-page employees-page">
    
    <div class="page-header">
        <div>
            <h1 class="h3 font-weight-bold mb-1">Quản lý Nhân sự</h1>
            <div class="page-breadcrumb">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right separator"></i>
                <span>Nhân sự</span>
            </div>
        </div>

        <div class="page-header-actions">
            @if (User.IsInRole("HR") || User.IsInRole("Admin") || User.IsInRole("Administrator"))
            {
                <a asp-action="ExportReport" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-isActive="@ViewBag.CurrentStatus" asp-route-departmentId="@ViewBag.CurrentDepartment" class="btn-outline-custom text-success border-success d-flex align-items-center" title="Xuất báo cáo nhân sự">
                    <i class="bi bi-file-earmark-arrow-down me-1"></i> Xuất báo cáo NS
                </a>
                <a asp-action="ImportExcel" class="btn-outline-custom d-flex align-items-center">
                    <i class="bi bi-file-earmark-excel me-1"></i> Nhập Excel
                </a>
                <a asp-action="Create" class="btn-primary-custom d-flex align-items-center">
                    <i class="bi bi-plus-lg me-1"></i> Thêm nhân viên mới
                </a>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="overview-card overview-card--primary">
                <div class="overview-card__top">
                    <div>
                        <div class="overview-card__label">Tổng hồ sơ</div>
                        <div class="overview-card__value">@totalEmployees</div>
                    </div>
                    <div class="overview-card__icon"><i class="bi bi-people-fill"></i></div>
                </div>
                <div class="overview-card__hint">Toàn bộ nhân sự đang hiển thị theo bộ lọc hiện tại.</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="overview-card overview-card--success">
                <div class="overview-card__top">
                    <div>
                        <div class="overview-card__label">Đang hoạt động</div>
                        <div class="overview-card__value">@activeEmployees</div>
                    </div>
                    <div class="overview-card__icon"><i class="bi bi-person-check-fill"></i></div>
                </div>
                <div class="overview-card__hint">Nhân sự còn hiệu lực và sẵn sàng tham gia đánh giá KPI/OKR.</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="overview-card overview-card--info">
                <div class="overview-card__top">
                    <div>
                        <div class="overview-card__label">Đã phân bổ</div>
                        <div class="overview-card__value">@assignedEmployees</div>
                    </div>
                    <div class="overview-card__icon"><i class="bi bi-diagram-3-fill"></i></div>
                </div>
                <div class="overview-card__hint">Đã có gán phòng ban hoặc chức vụ trong cơ cấu tổ chức.</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="overview-card overview-card--warning">
                <div class="overview-card__top">
                    <div>
                        <div class="overview-card__label">Ngừng hoạt động</div>
                        <div class="overview-card__value">@inactiveEmployees</div>
                    </div>
                    <div class="overview-card__icon"><i class="bi bi-person-dash-fill"></i></div>
                </div>
                <div class="overview-card__hint">Hồ sơ đã nghỉ việc hoặc tạm ngừng trong hệ thống.</div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center w-100 m-0">
        <div class="col-12 px-0">
            <div class="content-card w-100">
                <div class="card-body-custom">
                    <div class="page-toolbar-meta mb-3">
                        <div class="d-flex flex-wrap gap-2">
                            <span class="soft-chip tone-primary"><i class="bi bi-building"></i>@departmentSummary</span>
                            <span class="soft-chip tone-success"><i class="bi bi-person-badge"></i>@statusSummary</span>
                            @if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch as string))
                            {
                                <span class="soft-chip"><i class="bi bi-search"></i>@ViewBag.CurrentSearch</span>
                            }
                        </div>
                        <span class="small text-muted">Tra cứu nhanh theo hồ sơ, liên hệ, phòng ban và trạng thái công tác.</span>
                    </div>
                    
                    <form asp-action="Index" method="get" class="toolbar">
                        <div class="toolbar-left">
                            <div class="toolbar-search">
                                <i class="bi bi-search"></i>
                                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" placeholder="Tìm kiếm theo mã, tên, SĐT...">
                            </div>
                            
                            <select name="departmentId" class="filter-select">
                                <option value="">Tất cả phòng ban</option>
                                @foreach (var dept in departments)
                                {
                                    if (ViewBag.CurrentDepartment?.ToString() == dept.Key.ToString())
                                    {
                                        <option value="@dept.Key" selected>@dept.Value</option>
                                    }
                                    else
                                    {
                                        <option value="@dept.Key">@dept.Value</option>
                                    }
                                }
                            </select>
                            
                            <select name="isActive" class="filter-select">
                                @if (string.IsNullOrEmpty(ViewBag.CurrentStatus))
                                {
                                    <option value="" selected>Trạng thái</option>
                                }
                                else
                                {
                                    <option value="">Trạng thái</option>
                                }
                                
                                @if (ViewBag.CurrentStatus == "true")
                                {
                                    <option value="true" selected>Đang làm việc</option>
                                }
                                else
                                {
                                    <option value="true">Đang làm việc</option>
                                }
                                
                                @if (ViewBag.CurrentStatus == "false")
                                {
                                    <option value="false" selected>Đã nghỉ việc</option>
                                }
                                else
                                {
                                    <option value="false">Đã nghỉ việc</option>
                                }
                            </select>
                        </div>
                        <div class="toolbar-right">
                            <a asp-action="Index" class="btn btn-sm btn-light" title="Làm mới">
                                <i class="bi bi-arrow-clockwise"></i>
                            </a>
                            <button type="submit" class="btn btn-sm btn-primary" title="Lọc kết quả">
                                <i class="bi bi-funnel"></i> Lọc
                            </button>
                        </div>
                    </form>
                    
                    <div class="table-responsive w-100">
                        <table class="data-table w-100 employees-table">
                            <thead>
                                <tr>
                                    <th>Thông tin nhân viên</th>
                                    <th>Phòng ban</th>
                                    <th>Chức vụ</th>
                                    <th>Liên hệ</th>
                                    <th>Ngày vào làm</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var emp in Model)
                                    {
                                        var hasAssignment = assignments.TryGetValue(emp.Id, out var assign);
                                        var deptId = hasAssignment ? assign?.DepartmentId : null;
                                        var posId = hasAssignment ? assign?.PositionId : null;
                                        var deptName = deptId.HasValue && departments.ContainsKey(deptId.Value)
                                                       ? departments[deptId.Value] : "Chưa phân bổ";
                                        var posName = posId.HasValue && positions.ContainsKey(posId.Value)
                                                       ? positions[posId.Value] : "Chưa phân bổ";
                                        var statusClass = emp.IsActive == true ? "active" : "inactive";
                                        var statusDot = emp.IsActive == true ? "" : "text-danger bg-danger";
                                        var statusText = emp.IsActive == true ? "Đang làm việc" : "Đã nghỉ việc";
                                        var avatarLetter = !string.IsNullOrEmpty(emp.FullName) ? emp.FullName[0].ToString().ToUpper() : "U";

                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="record-avatar">
                                                        @avatarLetter
                                                    </div>
                                                    <div class="table-meta">
                                                        <div class="table-meta__title">@emp.FullName</div>
                                                        <div class="table-meta__sub">Mã nhân sự: @emp.EmployeeCode</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="soft-chip tone-info">@deptName</span>
                                            </td>
                                            <td>
                                                <span class="soft-chip">@posName</span>
                                            </td>
                                            <td>
                                                <div class="inline-icon-list">
                                                    <span><i class="bi bi-envelope text-muted"></i>@emp.Email</span>
                                                    <span><i class="bi bi-telephone text-muted"></i>@emp.Phone</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="table-meta">
                                                    <div class="table-meta__title">@(emp.JoinDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                                                    <div class="table-meta__sub">Ngày bắt đầu công tác</div>
                                                </div>
                                            </td>
                                            <td><span class="status-badge @statusClass"><span class="status-dot @statusDot"></span> @statusText</span></td>
                                            <td>
                                                <div class="action-btns justify-content-end">
                                                    <a asp-action="Details" asp-route-id="@emp.Id" class="action-btn" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                                    @if (User.IsInRole("HR") || User.IsInRole("Admin") || User.IsInRole("Administrator"))
                                                    {
                                                        <a asp-action="Edit" asp-route-id="@emp.Id" class="action-btn" title="Chỉnh sửa thông tin"><i class="bi bi-pencil"></i></a>
                                                        @if (emp.IsActive == true)
                                                        {
                                                            <a asp-action="Delete" asp-route-id="@emp.Id" class="action-btn danger" title="Nghỉ việc"><i class="bi bi-person-dash"></i></a>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="p-0">
                                            <div class="table-empty-state">
                                                <i class="bi bi-people"></i>
                                                <h5>Không tìm thấy nhân sự phù hợp</h5>
                                                <p>Hãy thử đổi từ khóa, phòng ban hoặc trạng thái để mở rộng kết quả tìm kiếm.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="employees-mobile-list">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var emp in Model)
                            {
                                var hasAssignment = assignments.TryGetValue(emp.Id, out var assign);
                                var deptId = hasAssignment ? assign?.DepartmentId : null;
                                var posId = hasAssignment ? assign?.PositionId : null;
                                var deptName = deptId.HasValue && departments.ContainsKey(deptId.Value)
                                               ? departments[deptId.Value] : "Chưa phân bổ";
                                var posName = posId.HasValue && positions.ContainsKey(posId.Value)
                                               ? positions[posId.Value] : "Chưa phân bổ";
                                var statusClass = emp.IsActive == true ? "active" : "inactive";
                                var statusDot = emp.IsActive == true ? "" : "text-danger bg-danger";
                                var statusText = emp.IsActive == true ? "Đang làm việc" : "Đã nghỉ việc";
                                var avatarLetter = !string.IsNullOrEmpty(emp.FullName) ? emp.FullName[0].ToString().ToUpper() : "U";

                                <article class="content-card employees-mobile-card">
                                    <div class="employees-mobile-card__header">
                                        <div class="record-avatar">@avatarLetter</div>
                                        <div class="flex-grow-1 min-w-0">
                                            <h3 class="employees-mobile-card__title">@emp.FullName</h3>
                                            <div class="small text-muted mb-2">Mã nhân sự: @emp.EmployeeCode</div>
                                            <div class="employees-mobile-card__chips">
                                                <span class="soft-chip tone-info">@deptName</span>
                                                <span class="soft-chip">@posName</span>
                                                <span class="status-badge @statusClass"><span class="status-dot @statusDot"></span> @statusText</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="employees-mobile-card__label">Liên hệ</div>
                                        <div class="inline-icon-list mt-1">
                                            <span><i class="bi bi-envelope text-muted"></i>@(string.IsNullOrWhiteSpace(emp.Email) ? "Chưa cập nhật" : emp.Email)</span>
                                            <span><i class="bi bi-telephone text-muted"></i>@(string.IsNullOrWhiteSpace(emp.Phone) ? "Chưa cập nhật" : emp.Phone)</span>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="employees-mobile-card__label">Ngày vào làm</div>
                                        <div class="small text-dark fw-semibold mt-1">@(emp.JoinDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                                    </div>

                                    <div class="employees-mobile-card__actions">
                                        <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </a>
                                        @if (User.IsInRole("HR") || User.IsInRole("Admin") || User.IsInRole("Administrator"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-outline-secondary">
                                                <i class="bi bi-pencil me-1"></i> Sửa
                                            </a>
                                            @if (emp.IsActive == true)
                                            {
                                                <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-outline-danger">
                                                    <i class="bi bi-person-dash me-1"></i> Nghỉ việc
                                                </a>
                                            }
                                        }
                                    </div>
                                </article>
                            }
                        }
                    </div>

                    @if (Model != null && Model.TotalPages > 1)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-4 px-2 flex-wrap gap-2">
                            <div class="text-muted small">
                                Hiển thị trang <strong>@Model.PageIndex</strong> trên tổng số <strong>@Model.TotalPages</strong>
                            </div>
                            <nav aria-label="Phân trang nhân sự">
                                <ul class="pagination pagination-sm mb-0 gap-1">
                                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                        @if (Model.HasPreviousPage && Model.PreviousPageNumber.HasValue)
                                        {
                                            <a class="page-link border-0 rounded-circle shadow-none text-dark" asp-action="Index"
                                               asp-route-pageNumber="@Model.PreviousPageNumber"
                                               asp-route-searchString="@ViewBag.CurrentSearch"
                                               asp-route-isActive="@ViewBag.CurrentStatus"
                                               asp-route-departmentId="@ViewBag.CurrentDepartment">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="page-link border-0 rounded-circle shadow-none text-dark"><i class="bi bi-chevron-left"></i></span>
                                        }
                                    </li>
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        if (i == 1 || i == Model.TotalPages || (i >= Model.PageIndex - 1 && i <= Model.PageIndex + 1))
                                        {
                                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                                <a class="page-link border-0 rounded-circle shadow-none @(i == Model.PageIndex ? "" : "text-dark")" asp-action="Index"
                                                   asp-route-pageNumber="@i"
                                                   asp-route-searchString="@ViewBag.CurrentSearch"
                                                   asp-route-isActive="@ViewBag.CurrentStatus"
                                                   asp-route-departmentId="@ViewBag.CurrentDepartment">@i</a>
                                            </li>
                                        }
                                        else if (i == Model.PageIndex - 2 || i == Model.PageIndex + 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link border-0">...</span></li>
                                        }
                                    }
                                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                        @if (Model.HasNextPage && Model.NextPageNumber.HasValue)
                                        {
                                            <a class="page-link border-0 rounded-circle shadow-none text-dark" asp-action="Index"
                                               asp-route-pageNumber="@Model.NextPageNumber"
                                               asp-route-searchString="@ViewBag.CurrentSearch"
                                               asp-route-isActive="@ViewBag.CurrentStatus"
                                               asp-route-departmentId="@ViewBag.CurrentDepartment">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="page-link border-0 rounded-circle shadow-none text-dark"><i class="bi bi-chevron-right"></i></span>
                                        }
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
