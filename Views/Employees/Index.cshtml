@model Manage_KPI_or_OKR_System.Helpers.PaginatedList<Manage_KPI_or_OKR_System.Models.Employee>
@{
    ViewData["Title"] = "Quản lý Nhân sự";
    var assignments = ViewBag.Assignments as Dictionary<int, Manage_KPI_or_OKR_System.Models.EmployeeAssignment> ?? new Dictionary<int, Manage_KPI_or_OKR_System.Models.EmployeeAssignment>();
    var departments = ViewBag.Departments as Dictionary<int, string> ?? new Dictionary<int, string>();
    var positions = ViewBag.Positions as Dictionary<int, string> ?? new Dictionary<int, string>();
    var pageEmployees = Model?.ToList() ?? new List<Manage_KPI_or_OKR_System.Models.Employee>();
    var currentPageIndex = Model?.PageIndex ?? 1;
    var totalPageCount = Math.Max(1, Model?.TotalPages ?? 0);
    var previousPageNumber = Model?.PreviousPageNumber;
    var nextPageNumber = Model?.NextPageNumber;
    var totalEmployees = pageEmployees.Count;
    var activeEmployees = pageEmployees.Count(e => e.IsActive == true);
    var inactiveEmployees = totalEmployees - activeEmployees;
    var assignedEmployees = pageEmployees.Count(employee =>
        assignments.TryGetValue(employee.Id, out var assignment) &&
        (assignment.DepartmentId.HasValue || assignment.PositionId.HasValue));
    var isEmployeeAdminRole = User.IsInRole("HR") || User.IsInRole("Admin") || User.IsInRole("Administrator");
    var canCreateEmployee = isEmployeeAdminRole || User.HasClaim("Permission", "EMPLOYEES_CREATE");
    var canEditEmployee = isEmployeeAdminRole || User.HasClaim("Permission", "EMPLOYEES_EDIT");
    var canDeleteEmployee = isEmployeeAdminRole || User.HasClaim("Permission", "EMPLOYEES_DELETE");
    var canManageEmployees = canCreateEmployee || canEditEmployee || canDeleteEmployee;
    var currentStatus = ViewBag.CurrentStatus?.ToString();
    var currentSearch = ViewBag.CurrentSearch?.ToString();
    var hasActiveFilters = !string.IsNullOrWhiteSpace(currentSearch) ||
                           !string.IsNullOrWhiteSpace(currentStatus) ||
                           ViewBag.CurrentDepartment != null;
    var statusSummary = currentStatus == "true"
        ? "Đang làm việc"
        : currentStatus == "false"
            ? "Đã nghỉ việc"
            : "Mọi trạng thái";
    var departmentSummary = "Tất cả phòng ban";
    string currentDeptStr = ViewBag.CurrentDepartment?.ToString() ?? "";
    if (int.TryParse(currentDeptStr, out int selectedDepartmentId) && departments.ContainsKey(selectedDepartmentId))
    {
        departmentSummary = departments[selectedDepartmentId];
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/employees.css" asp-append-version="true" />
}

<div class="employees-page" data-employees-page>
    <header class="employees-page-header">
        <div>
            <h1>Quản lý Nhân sự</h1>
            <nav class="employees-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Nhân sự</span>
            </nav>
        </div>

        @if (canManageEmployees)
        {
            <div class="employees-page-actions">
                <a asp-action="ExportReport" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-isActive="@ViewBag.CurrentStatus" asp-route-departmentId="@ViewBag.CurrentDepartment" class="employees-btn employees-btn--secondary" title="Xuất báo cáo nhân sự">
                    <i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i>
                    <span>Xuất báo cáo</span>
                </a>
                @if (canCreateEmployee)
                {
                    <a asp-action="ImportExcel" class="employees-btn employees-btn--secondary">
                        <i class="bi bi-file-earmark-excel" aria-hidden="true"></i>
                        <span>Nhập Excel</span>
                    </a>
                    <a asp-action="Create" class="employees-btn employees-btn--primary">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Thêm nhân viên</span>
                    </a>
                }
            </div>
        }
    </header>

    <section class="employees-summary" aria-label="Tổng quan nhân sự trong kết quả hiện tại">
        <article>
            <span>Trong kết quả hiện tại</span>
            <strong>@totalEmployees</strong>
            <small>Trang @currentPageIndex · @totalPageCount trang</small>
        </article>
        <article>
            <span>Đang làm việc</span>
            <strong>@activeEmployees</strong>
            <small>Hồ sơ còn hoạt động</small>
        </article>
        <article>
            <span>Đã phân công</span>
            <strong>@assignedEmployees</strong>
            <small>Có phòng ban hoặc chức vụ</small>
        </article>
        <article>
            <span>Ngừng hoạt động</span>
            <strong>@inactiveEmployees</strong>
            <small>Hồ sơ không còn hoạt động</small>
        </article>
    </section>

    <section class="employees-filter-panel" aria-labelledby="employeeFilterHeading">
        <div class="employees-filter-heading">
            <div>
                <p class="employees-eyebrow" id="employeeFilterHeading">Tìm và lọc</p>
                <span>Tra cứu theo mã, tên, phòng ban và trạng thái công tác.</span>
            </div>
            @if (hasActiveFilters)
            {
                <a asp-action="Index" class="employees-clear-link">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                    <span>Xóa lọc</span>
                </a>
            }
        </div>

        <form asp-action="Index" method="get" class="employees-filter-form">
            <label class="employees-search-field" for="employeeSearch">
                <span class="visually-hidden">Tìm nhân viên</span>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" id="employeeSearch" name="searchString" value="@ViewBag.CurrentSearch" placeholder="Mã hoặc tên nhân viên..." autocomplete="off" />
            </label>

            <label for="departmentFilter">
                <span>Phòng ban</span>
                <select id="departmentFilter" name="departmentId" class="no-select2">
                    <option value="">Tất cả phòng ban</option>
                    @foreach (var dept in departments)
                    {
                        <option value="@dept.Key" selected="@(ViewBag.CurrentDepartment?.ToString() == dept.Key.ToString() ? "selected" : null)">@dept.Value</option>
                    }
                </select>
            </label>

            <label for="statusFilter">
                <span>Trạng thái</span>
                <select id="statusFilter" name="isActive" class="no-select2">
                    <option value="" selected="@(string.IsNullOrEmpty(currentStatus) ? "selected" : null)">Tất cả</option>
                    <option value="true" selected="@(currentStatus == "true" ? "selected" : null)">Đang làm việc</option>
                    <option value="false" selected="@(currentStatus == "false" ? "selected" : null)">Ngừng hoạt động</option>
                </select>
            </label>

            <button type="submit" class="employees-btn employees-btn--filter">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <span>Lọc dữ liệu</span>
            </button>
        </form>
    </section>

    <section class="employees-results" aria-labelledby="employeeResultsHeading">
        <div class="employees-results-heading">
            <div>
                <p class="employees-eyebrow" id="employeeResultsHeading">Danh sách nhân sự</p>
                <strong>@totalEmployees hồ sơ trên trang hiện tại</strong>
            </div>
            <span>@departmentSummary · @statusSummary · Trang @currentPageIndex/@totalPageCount</span>
        </div>

        @if (pageEmployees.Count == 0)
        {
            <div class="employees-empty" role="status">
                <span class="employees-empty-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                <h2>Không tìm thấy nhân sự phù hợp</h2>
                <p>Hãy thử đổi từ khóa, phòng ban hoặc trạng thái để mở rộng kết quả tìm kiếm.</p>
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" class="employees-btn employees-btn--secondary">Xóa bộ lọc</a>
                }
                else if (canCreateEmployee)
                {
                    <a asp-action="Create" class="employees-btn employees-btn--primary">Thêm nhân viên</a>
                }
            </div>
        }
        else
        {
            <div class="employees-table-shell" aria-hidden="false">
                <table class="employees-table" aria-label="Danh sách nhân viên">
                    <thead>
                        <tr>
                            <th>Thông tin nhân viên</th>
                            <th>Phòng ban</th>
                            <th>Chức vụ</th>
                            <th>Liên hệ</th>
                            <th>Ngày vào làm</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in pageEmployees)
                        {
                            var hasAssignment = assignments.TryGetValue(emp.Id, out var assign);
                            var deptId = hasAssignment ? assign?.DepartmentId : null;
                            var posId = hasAssignment ? assign?.PositionId : null;
                            var deptName = deptId.HasValue && departments.ContainsKey(deptId.Value) ? departments[deptId.Value] : "Chưa phân bổ";
                            var posName = posId.HasValue && positions.ContainsKey(posId.Value) ? positions[posId.Value] : "Chưa phân bổ";
                            var statusClass = emp.IsActive == true ? "employees-status employees-status--active" : "employees-status employees-status--inactive";
                            var statusText = emp.IsActive == true ? "Đang làm việc" : "Ngừng hoạt động";
                            var avatarLetter = !string.IsNullOrWhiteSpace(emp.FullName) ? emp.FullName[0].ToString().ToUpperInvariant() : "NV";

                            <tr>
                                <td>
                                    <div class="employee-name-cell">
                                        <span class="employee-avatar" aria-hidden="true">@avatarLetter</span>
                                        <div>
                                            <strong>@emp.FullName</strong>
                                            <small>Mã: @emp.EmployeeCode</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="employee-assignment-chip employee-assignment-chip--department"><i class="bi bi-building" aria-hidden="true"></i>@deptName</span></td>
                                <td><span class="employee-assignment-chip"><i class="bi bi-briefcase" aria-hidden="true"></i>@posName</span></td>
                                <td>
                                    <div class="employee-contact">
                                        <span><i class="bi bi-envelope" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(emp.Email) ? "Chưa cập nhật" : emp.Email)</span>
                                        <span><i class="bi bi-telephone" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(emp.Phone) ? "Chưa cập nhật" : emp.Phone)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="employee-join-date">
                                        <strong>@(emp.JoinDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</strong>
                                        <small>Ngày bắt đầu công tác</small>
                                    </div>
                                </td>
                                <td><span class="@statusClass"><span aria-hidden="true"></span>@statusText</span></td>
                                <td>
                                    <div class="employees-actions">
                                        <a asp-action="Details" asp-route-id="@emp.Id" class="employees-icon-btn" title="Xem chi tiết" aria-label="Xem chi tiết @emp.FullName">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        @if (canEditEmployee)
                                        {
                                            <a asp-action="Edit" asp-route-id="@emp.Id" class="employees-icon-btn" title="Chỉnh sửa" aria-label="Chỉnh sửa @emp.FullName">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </a>
                                        }
                                        @if (canDeleteEmployee && emp.IsActive == true)
                                        {
                                            <a asp-action="Delete" asp-route-id="@emp.Id"
                                               class="employees-icon-btn employees-icon-btn--danger js-employee-deactivate"
                                               title="Ngừng hoạt động"
                                               aria-label="Ngừng hoạt động @emp.FullName"
                                               data-employee-id="@emp.Id"
                                               data-employee-name="@emp.FullName"
                                               data-employee-code="@emp.EmployeeCode">
                                                <i class="bi bi-person-dash" aria-hidden="true"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="employees-mobile-list" aria-hidden="false">
                @foreach (var emp in pageEmployees)
                {
                    var hasAssignment = assignments.TryGetValue(emp.Id, out var assign);
                    var deptId = hasAssignment ? assign?.DepartmentId : null;
                    var posId = hasAssignment ? assign?.PositionId : null;
                    var deptName = deptId.HasValue && departments.ContainsKey(deptId.Value) ? departments[deptId.Value] : "Chưa phân bổ";
                    var posName = posId.HasValue && positions.ContainsKey(posId.Value) ? positions[posId.Value] : "Chưa phân bổ";
                    var statusClass = emp.IsActive == true ? "employees-status employees-status--active" : "employees-status employees-status--inactive";
                    var statusText = emp.IsActive == true ? "Đang làm việc" : "Ngừng hoạt động";

                    <article class="employee-card">
                        <div class="employee-card-topline">
                            <span class="@statusClass"><span aria-hidden="true"></span>@statusText</span>
                            <span class="employee-card-code">@emp.EmployeeCode</span>
                        </div>
                        <h2>@emp.FullName</h2>
                        <p>@deptName · @posName</p>
                        <dl>
                            <div><dt>Ngày vào làm</dt><dd>@(emp.JoinDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd></div>
                            <div><dt>Điện thoại</dt><dd>@(string.IsNullOrWhiteSpace(emp.Phone) ? "Chưa cập nhật" : emp.Phone)</dd></div>
                        </dl>
                        <div class="employee-contact">
                            <span><i class="bi bi-envelope" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(emp.Email) ? "Chưa cập nhật email" : emp.Email)</span>
                        </div>
                        <div class="employee-card-footer">
                            <a asp-action="Details" asp-route-id="@emp.Id">Xem chi tiết</a>
                            <div class="employees-actions">
                                @if (canEditEmployee)
                                {
                                    <a asp-action="Edit" asp-route-id="@emp.Id" class="employees-icon-btn" title="Chỉnh sửa" aria-label="Chỉnh sửa @emp.FullName">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                }
                                @if (canDeleteEmployee && emp.IsActive == true)
                                {
                                    <a asp-action="Delete" asp-route-id="@emp.Id"
                                       class="employees-icon-btn employees-icon-btn--danger js-employee-deactivate"
                                       title="Ngừng hoạt động"
                                       aria-label="Ngừng hoạt động @emp.FullName"
                                       data-employee-id="@emp.Id"
                                       data-employee-name="@emp.FullName"
                                       data-employee-code="@emp.EmployeeCode">
                                        <i class="bi bi-person-dash" aria-hidden="true"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }

        @if ((Model?.TotalPages ?? 0) > 1)
        {
            <nav class="employees-pagination" aria-label="Phân trang nhân sự">
                @if (previousPageNumber.HasValue)
                {
                    <a asp-action="Index" asp-route-pageNumber="@previousPageNumber" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-isActive="@ViewBag.CurrentStatus" asp-route-departmentId="@ViewBag.CurrentDepartment" aria-label="Trang trước">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                }

                @for (int pageNumber = 1; pageNumber <= totalPageCount; pageNumber++)
                {
                    if (pageNumber == 1 || pageNumber == totalPageCount || (pageNumber >= currentPageIndex - 1 && pageNumber <= currentPageIndex + 1))
                    {
                        <a asp-action="Index" asp-route-pageNumber="@pageNumber" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-isActive="@ViewBag.CurrentStatus" asp-route-departmentId="@ViewBag.CurrentDepartment" class="@(pageNumber == currentPageIndex ? "is-current" : null)" aria-current="@(pageNumber == currentPageIndex ? "page" : null)">@pageNumber</a>
                    }
                    else if (pageNumber == currentPageIndex - 2 || pageNumber == currentPageIndex + 2)
                    {
                        <span class="is-disabled">…</span>
                    }
                }

                @if (nextPageNumber.HasValue)
                {
                    <a asp-action="Index" asp-route-pageNumber="@nextPageNumber" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-isActive="@ViewBag.CurrentStatus" asp-route-departmentId="@ViewBag.CurrentDepartment" aria-label="Trang sau">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                }
            </nav>
        }
    </section>
</div>

@if (canDeleteEmployee)
{
    <div class="modal fade employees-modal" id="employeeDeactivateModal" tabindex="-1" aria-labelledby="employeeDeactivateModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="employeeDeactivateModalTitle">Ngừng hoạt động nhân viên</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p>Bạn sắp ngừng hoạt động nhân viên <strong id="employeeDeactivateName"></strong> (<span id="employeeDeactivateCode"></span>).</p>
                    <p class="mb-0 text-muted small">Hồ sơ và dữ liệu lịch sử được giữ lại. Phân công hiện tại và tài khoản liên kết sẽ bị vô hiệu hóa.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="employees-btn employees-btn--secondary" data-bs-dismiss="modal">Hủy</button>
                    <form id="employeeDeactivateForm" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="employeeDeactivateId" value="" />
                        <input type="hidden" name="confirm" value="true" />
                        <button type="submit" class="employees-btn employees-btn--danger">
                            <i class="bi bi-person-dash" aria-hidden="true"></i>
                            <span>Xác nhận ngừng hoạt động</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/employees.js" asp-append-version="true"></script>
}
