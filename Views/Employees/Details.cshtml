@model Manage_KPI_or_OKR_System.Models.Employee

@{
    ViewData["Title"] = "Chi tiết nhân sự";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var assignment = ViewBag.Assignment as Manage_KPI_or_OKR_System.Models.EmployeeAssignment;
    var departments = ViewBag.Departments as Dictionary<int, string> ?? new Dictionary<int, string>();
    var positions = ViewBag.Positions as Dictionary<int, string> ?? new Dictionary<int, string>();

    var deptName = assignment?.DepartmentId.HasValue == true && departments.ContainsKey(assignment.DepartmentId.Value)
                   ? departments[assignment.DepartmentId.Value] : "Chưa phân bổ";
    var posName = assignment?.PositionId.HasValue == true && positions.ContainsKey(assignment.PositionId.Value)
                  ? positions[assignment.PositionId.Value] : "Chưa phân bổ";

    var strategicGoal = ViewBag.StrategicGoal as Manage_KPI_or_OKR_System.Models.MissionVision;
    var systemUser = ViewBag.SystemUser as Manage_KPI_or_OKR_System.Models.SystemUser;
    var assignedKPIs = ViewBag.AssignedKPIs as List<Manage_KPI_or_OKR_System.Models.KPI> ?? new List<Manage_KPI_or_OKR_System.Models.KPI>();
    var assignedOKRs = ViewBag.AssignedOKRs as List<Manage_KPI_or_OKR_System.Models.OKR> ?? new List<Manage_KPI_or_OKR_System.Models.OKR>();

    // Calculate Seniority
    string seniority = "—";
    if (Model.JoinDate.HasValue)
    {
        var diff = DateTime.Now - Model.JoinDate.Value;
        int years = (int)(diff.TotalDays / 365);
        int months = (int)((diff.TotalDays % 365) / 30);
        if (years > 0)
            seniority = $"{years} năm {months} tháng";
        else if (months > 0)
            seniority = $"{months} tháng";
        else
            seniority = "Mới gia nhập";
    }

    // Avatar Initial
    string empName = Model.FullName ?? "Unknown";
    string empInitial = empName.Length > 0 ? empName[0].ToString().ToUpper() : "?";

    // Status
    bool isActive = Model.IsActive == true;
    string statusText = isActive ? "Đang làm việc" : "Đã nghỉ việc";
    string statusClass = isActive ? "employees-status--active" : "employees-status--inactive";
}

@section Styles {
    <link rel="stylesheet" href="~/css/employees.css" asp-append-version="true" />
}

<div class="employees-page" data-employees-page>
    <!-- Page Header -->
    <header class="employees-page-header">
        <div>
            <h1>Hồ sơ nhân sự</h1>
            <nav class="employees-breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Nhân sự</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">@Model.FullName</span>
            </nav>
        </div>
        <div class="employees-page-actions">
            @if (User.IsInRole("Admin") || User.IsInRole("Administrator") || User.IsInRole("HR") || User.HasClaim("Permission", "EMPLOYEES_EDIT"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="employees-btn employees-btn--primary">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                    <span>Chỉnh sửa</span>
                </a>
            }
            <a asp-action="Index" class="employees-btn employees-btn--secondary">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>Quay lại</span>
            </a>
        </div>
    </header>

    <!-- Profile Header Card -->
    <section class="employees-profile-header mt-3" aria-label="Thông tin tổng quan nhân sự">
        <div class="employees-profile-identity">
            <div class="employees-profile-avatar" aria-hidden="true">
                @empInitial
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <h2 class="h4 mb-0 fw-bold">@Model.FullName</h2>
                    <span class="employees-status @statusClass">
                        <span aria-hidden="true"></span>
                        @statusText
                    </span>
                </div>
                <div class="employees-profile-meta">
                    <span><i class="bi bi-person-badge me-1" aria-hidden="true"></i> Mã NV: @Model.EmployeeCode</span>
                    <span><i class="bi bi-building me-1" aria-hidden="true"></i> @deptName</span>
                    <span><i class="bi bi-briefcase me-1" aria-hidden="true"></i> @posName</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Grid -->
    <section class="employees-stat-grid" aria-label="Thống kê nhân sự">
        <article class="employees-stat-card">
            <div class="employees-stat-icon" aria-hidden="true">
                <i class="bi bi-speedometer2"></i>
            </div>
            <div>
                <div class="employees-stat-label">KPIs được giao</div>
                <div class="employees-stat-value">@assignedKPIs.Count</div>
            </div>
        </article>
        <article class="employees-stat-card">
            <div class="employees-stat-icon" aria-hidden="true">
                <i class="bi bi-bullseye"></i>
            </div>
            <div>
                <div class="employees-stat-label">OKRs được giao</div>
                <div class="employees-stat-value">@assignedOKRs.Count</div>
            </div>
        </article>
        <article class="employees-stat-card">
            <div class="employees-stat-icon" aria-hidden="true">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <div class="employees-stat-label">Thâm niên</div>
                <div class="employees-stat-value">@seniority</div>
            </div>
        </article>
        <article class="employees-stat-card">
            <div class="employees-stat-icon" aria-hidden="true">
                <i class="bi bi-flag"></i>
            </div>
            <div>
                <div class="employees-stat-label">Mục tiêu chiến lược</div>
                <div class="employees-stat-value" style="font-size: 0.95rem;">
                    @(strategicGoal == null ? "—" : (strategicGoal.TargetYear.HasValue ? $"{strategicGoal.TypeDisplayName} {strategicGoal.TargetYear}" : strategicGoal.TypeDisplayName))
                </div>
            </div>
        </article>
    </section>

    <!-- Details Main Content Grid -->
    <div class="employees-detail-grid">
        <!-- Left Column: Personal & Job Information -->
        <div class="d-grid gap-3">
            <!-- Personal Info Card -->
            <article class="employees-card">
                <div class="employees-card-header">
                    <i class="bi bi-person me-2 text-primary" aria-hidden="true"></i>
                    Thông tin cá nhân
                </div>
                <div class="employees-info-list">
                    <div class="employees-info-row">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-envelope"></i></div>
                        <div>
                            <div class="employees-info-label">Email</div>
                            <div class="employees-info-value">
                                @if (!string.IsNullOrEmpty(Model.Email))
                                {
                                    <a href="mailto:@Model.Email">@Model.Email</a>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa cập nhật</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="employees-info-row">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-telephone"></i></div>
                        <div>
                            <div class="employees-info-label">Số điện thoại</div>
                            <div class="employees-info-value">
                                @if (!string.IsNullOrEmpty(Model.Phone))
                                {
                                    <a href="tel:@Model.Phone">@Model.Phone</a>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa cập nhật</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="employees-info-row">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-calendar-event"></i></div>
                        <div>
                            <div class="employees-info-label">Ngày sinh</div>
                            <div class="employees-info-value">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                        </div>
                    </div>
                    <div class="employees-info-row">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-shield-lock"></i></div>
                        <div>
                            <div class="employees-info-label">Mã số thuế</div>
                            <div class="employees-info-value">@(Model.TaxCode ?? "Chưa cập nhật")</div>
                        </div>
                    </div>
                    <div class="employees-info-row">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-person-workspace"></i></div>
                        <div>
                            <div class="employees-info-label">Tài khoản hệ thống</div>
                            <div class="employees-info-value">
                                @if (systemUser != null)
                                {
                                    <span class="badge bg-light text-dark border"><i class="bi bi-person me-1" aria-hidden="true"></i>@systemUser.Username</span>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa liên kết tài khoản</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </article>

            <!-- Job Info Card -->
            <article class="employees-card">
                <div class="employees-card-header">
                    <i class="bi bi-briefcase me-2 text-primary" aria-hidden="true"></i>
                    Thông tin công việc
                </div>
                <div class="employees-info-list">
                    <div class="employees-info-row">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-building"></i></div>
                        <div>
                            <div class="employees-info-label">Phòng ban</div>
                            <div class="employees-info-value fw-bold text-primary">@deptName</div>
                        </div>
                    </div>
                    <div class="employees-info-row">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></div>
                        <div>
                            <div class="employees-info-label">Chức vụ</div>
                            <div class="employees-info-value">@posName</div>
                        </div>
                    </div>
                    <div class="employees-info-row">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-calendar-check"></i></div>
                        <div>
                            <div class="employees-info-label">Ngày vào làm</div>
                            <div class="employees-info-value">@(Model.JoinDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                        </div>
                    </div>
                    <div class="employees-info-row">
                        <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-geo"></i></div>
                        <div>
                            <div class="employees-info-label">Chi tiết mục tiêu chiến lược</div>
                            <div class="employees-info-value">
                                @if (strategicGoal != null)
                                {
                                    <div class="small text-muted mb-1">@(strategicGoal.TargetYear.HasValue ? $"{strategicGoal.TypeDisplayName} {strategicGoal.TargetYear}" : strategicGoal.TypeDisplayName)</div>
                                    <div>@strategicGoal.Content</div>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa xác định</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </div>

        <!-- Right Column: Assigned KPIs & OKRs -->
        <div class="d-grid gap-3">
            <!-- KPI List Card -->
            <article class="employees-card">
                <div class="employees-card-header d-flex align-items-center justify-content-between">
                    <div>
                        <i class="bi bi-speedometer2 me-2 text-primary" aria-hidden="true"></i>
                        KPI được giao (@assignedKPIs.Count)
                    </div>
                </div>
                <div class="employees-card-body">
                    @if (assignedKPIs.Any())
                    {
                        <div class="d-grid gap-1">
                            @foreach (var kpi in assignedKPIs)
                            {
                                <div class="employees-related-item">
                                    <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-lightning-charge"></i></div>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-bold text-truncate">@kpi.KPIName</div>
                                    </div>
                                    <a asp-controller="KPIs" asp-action="Details" asp-route-id="@kpi.Id" class="employees-icon-btn" title="Xem chi tiết KPI" aria-label="Xem chi tiết KPI @kpi.KPIName">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="employees-related-empty">
                            <i class="bi bi-inbox d-block mb-1 fs-4 text-muted" aria-hidden="true"></i>
                            Chưa được giao chỉ tiêu KPI nào
                        </div>
                    }
                </div>
            </article>

            <!-- OKR List Card -->
            <article class="employees-card">
                <div class="employees-card-header d-flex align-items-center justify-content-between">
                    <div>
                        <i class="bi bi-bullseye me-2 text-primary" aria-hidden="true"></i>
                        OKR được giao (@assignedOKRs.Count)
                    </div>
                </div>
                <div class="employees-card-body">
                    @if (assignedOKRs.Any())
                    {
                        <div class="d-grid gap-1">
                            @foreach (var okr in assignedOKRs)
                            {
                                <div class="employees-related-item">
                                    <div class="employees-info-icon" aria-hidden="true"><i class="bi bi-trophy"></i></div>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-bold text-truncate">@okr.ObjectiveName</div>
                                        <div class="small text-muted">Chu kỳ: @okr.Cycle</div>
                                    </div>
                                    <a asp-controller="OKRs" asp-action="Details" asp-route-id="@okr.Id" class="employees-icon-btn" title="Xem chi tiết OKR" aria-label="Xem chi tiết OKR @okr.ObjectiveName">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="employees-related-empty">
                            <i class="bi bi-inbox d-block mb-1 fs-4 text-muted" aria-hidden="true"></i>
                            Chưa được giao mục tiêu OKR nào
                        </div>
                    }
                </div>
            </article>

            <!-- Deactivate link if active & permitted -->
            @if (Model.IsActive == true && (User.IsInRole("Admin") || User.IsInRole("Administrator") || User.IsInRole("HR") || User.HasClaim("Permission", "EMPLOYEES_DELETE")))
            {
                <div class="text-end pt-2">
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="employees-clear-link">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                        Ngừng hoạt động nhân sự này
                    </a>
                </div>
            }
        </div>
    </div>
</div>
