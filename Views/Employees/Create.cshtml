@model Manage_KPI_or_OKR_System.Models.Employee

@{
    ViewData["Title"] = "Thêm Nhân Viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cf-page employee-create-page" data-create-form>
    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Thêm nhân viên mới</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Nhân sự</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Thêm mới</span>
            </nav>
            <p class="cf-header__description">Tạo hồ sơ nhân sự, thiết lập vị trí công tác và liên kết tài khoản hoặc mục tiêu chiến lược khi cần.</p>
        </div>
        <a asp-action="Index" class="cf-back-action">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại</span>
        </a>
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="employeeCreateHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="employeeCreateHeading">Hồ sơ nhân sự</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
            </div>

            <form asp-action="Create" method="post" class="cf-form" id="createEmployeeForm" data-create-form-element>
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="cf-alert employee-server-alert" role="alert">
                        <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
                        <div>
                            <strong>Không thể tạo nhân viên.</strong>
                            <span>@ViewBag.ErrorMessage</span>
                        </div>
                    </div>
                }

                <div asp-validation-summary="All" class="cf-alert" role="alert" tabindex="-1" data-error-summary></div>

                <section class="cf-section" aria-labelledby="employeePersonalHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-person-vcard"></i></span>
                        <div>
                            <h3 id="employeePersonalHeading">Thông tin cá nhân &amp; liên hệ</h3>
                            <p>Nhập thông tin định danh và các kênh liên hệ chính của nhân viên.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label asp-for="EmployeeCode">Mã nhân viên</label>
                            <input asp-for="EmployeeCode"
                                   class="form-control cf-control"
                                   value="@(ViewData["NextEmployeeCode"] ?? "")"
                                   readonly
                                   aria-describedby="employeeCodeHint" />
                            <span asp-validation-for="EmployeeCode" class="cf-validation"></span>
                            <p id="employeeCodeHint" class="cf-hint">Hệ thống tự sinh mã duy nhất khi tạo hồ sơ.</p>
                        </div>

                        <div class="cf-field">
                            <label asp-for="FullName">Họ và tên <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="FullName"
                                   class="form-control cf-control"
                                   maxlength="100"
                                   autocomplete="name"
                                   placeholder="Ví dụ: Nguyễn Văn An"
                                   required />
                            <span asp-validation-for="FullName" class="cf-validation"></span>
                        </div>

                        <div class="cf-field">
                            <label asp-for="Phone">Số điện thoại <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="Phone"
                                   class="form-control cf-control"
                                   inputmode="tel"
                                   maxlength="15"
                                   autocomplete="tel"
                                   placeholder="Ví dụ: 0901234567"
                                   aria-describedby="employeePhoneHint"
                                   required />
                            <span asp-validation-for="Phone" class="cf-validation"></span>
                            <p id="employeePhoneHint" class="cf-hint">Chỉ nhập chữ số, tối đa 15 ký tự.</p>
                        </div>

                        <div class="cf-field">
                            <label asp-for="Email">Email công việc <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control cf-control"
                                   maxlength="255"
                                   autocomplete="email"
                                   placeholder="ten.nhanvien@company.com"
                                   required />
                            <span asp-validation-for="Email" class="cf-validation"></span>
                        </div>

                        <div class="cf-field">
                            <label asp-for="DateOfBirth">Ngày sinh</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control cf-control" lang="vi" />
                            <span asp-validation-for="DateOfBirth" class="cf-validation"></span>
                        </div>

                        <div class="cf-field">
                            <label asp-for="TaxCode">Mã số thuế</label>
                            <input asp-for="TaxCode"
                                   class="form-control cf-control"
                                   maxlength="50"
                                   autocomplete="off"
                                   placeholder="Nhập mã số thuế nếu có" />
                            <span asp-validation-for="TaxCode" class="cf-validation"></span>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="employeeWorkHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
                        <div>
                            <h3 id="employeeWorkHeading">Công việc &amp; tổ chức</h3>
                            <p>Thiết lập phòng ban, vị trí và tài khoản sử dụng trong hệ thống.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label for="DepartmentId">Phòng ban</label>
                            <select id="DepartmentId" name="departmentId" class="form-select cf-control" asp-items="ViewBag.DepartmentId">
                                <option value="">-- Chọn phòng ban --</option>
                            </select>
                            <p class="cf-hint">Có thể cập nhật phân bổ tổ chức sau khi tạo.</p>
                        </div>

                        <div class="cf-field">
                            <label for="PositionId">Vị trí công việc</label>
                            <select id="PositionId" name="positionId" class="form-select cf-control" asp-items="ViewBag.PositionId">
                                <option value="">-- Chọn vị trí --</option>
                            </select>
                        </div>

                        <div class="cf-field">
                            <label asp-for="JoinDate">Ngày vào làm</label>
                            <input asp-for="JoinDate" type="date" class="form-control cf-control" lang="vi" />
                            <span asp-validation-for="JoinDate" class="cf-validation"></span>
                        </div>

                        <div class="cf-field">
                            <label asp-for="SystemUserId">Tài khoản liên kết</label>
                            <select asp-for="SystemUserId" class="form-select cf-control" asp-items="ViewBag.SystemUserId" aria-describedby="systemUserHint">
                                <option value="">-- Không liên kết tài khoản --</option>
                            </select>
                            <span asp-validation-for="SystemUserId" class="cf-validation"></span>
                            <p id="systemUserHint" class="cf-hint">Mỗi tài khoản chỉ được liên kết với một nhân viên.</p>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="employeeAlignmentHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-flag"></i></span>
                        <div>
                            <h3 id="employeeAlignmentHeading">Định hướng &amp; trạng thái</h3>
                            <p>Gắn mục tiêu chiến lược theo năm và xác nhận trạng thái ban đầu của hồ sơ.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid cf-field-grid--wide-first">
                        <div class="cf-field">
                            <label asp-for="StrategicGoalId">Mục tiêu chiến lược theo năm</label>
                            <select asp-for="StrategicGoalId" class="form-select cf-control" asp-items="ViewBag.StrategicGoalId" aria-describedby="strategicGoalHint">
                                <option value="">-- Không gắn mục tiêu cụ thể --</option>
                            </select>
                            <span asp-validation-for="StrategicGoalId" class="cf-validation"></span>
                            <p id="strategicGoalHint" class="cf-hint">Chỉ hiển thị các mục tiêu theo năm đang hoạt động.</p>
                        </div>

                        <div class="cf-field">
                            <span class="employee-status-label">Trạng thái hồ sơ</span>
                            <label class="employee-status-option" for="isActiveSwitch">
                                <input type="checkbox" id="isActiveSwitch" name="IsActive" value="true" checked />
                                <span>
                                    <strong>Đang làm việc</strong>
                                    <small>Cho phép tham gia các quy trình KPI/OKR.</small>
                                </span>
                            </label>
                            <input type="hidden" name="IsActive" value="false" />
                        </div>
                    </div>
                </section>

                <div class="cf-actions">
                    <a asp-action="Index" class="cf-secondary-action">Hủy</a>
                    <button type="submit"
                            class="cf-primary-action"
                            data-submit-button
                            data-default-label="Lưu nhân viên"
                            data-loading-label="Đang lưu...">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span data-submit-label>Lưu nhân viên</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide employee-create-guide" aria-labelledby="employeeGuideHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-person-check"></i></span>
                <div>
                    <span class="cf-guide__eyebrow">Cẩm nang HR</span>
                    <h2 id="employeeGuideHeading">Trước khi lưu hồ sơ</h2>
                </div>
            </div>
            <p>Kiểm tra thông tin định danh và phân bổ ban đầu để nhân viên có thể tham gia đúng quy trình ngay sau khi được tạo.</p>

            <dl class="cf-preview-list">
                <div>
                    <dt>Thông tin bắt buộc</dt>
                    <dd>Họ tên, điện thoại và email</dd>
                </div>
                <div>
                    <dt>Mã nhân viên</dt>
                    <dd>Tự động sinh và kiểm tra trùng</dd>
                </div>
                <div>
                    <dt>Trạng thái mặc định</dt>
                    <dd>Đang làm việc</dd>
                </div>
            </dl>

            <ul class="cf-guide__list employee-create-guide__list">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Dùng email công việc hợp lệ có tên miền <strong>.com</strong>.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Tài khoản liên kết không được dùng bởi nhân viên khác.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Phòng ban, vị trí và mục tiêu chiến lược có thể cập nhật sau.</span></li>
            </ul>

            <div class="cf-guide__note">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>Server vẫn kiểm tra mã nhân viên, tài khoản liên kết và mục tiêu chiến lược trước khi lưu.</span>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <style>
        .employee-server-alert {
            display: flex;
            align-items: flex-start;
            gap: 0.65rem;
        }

        .employee-server-alert > i {
            flex: 0 0 auto;
            margin-top: 0.05rem;
        }

        .employee-server-alert strong,
        .employee-server-alert span {
            display: block;
        }

        .employee-status-label {
            display: block;
            margin-bottom: 0.45rem;
            color: var(--cf-text);
            font-size: 0.82rem;
            font-weight: 750;
        }

        .employee-status-option {
            display: flex;
            align-items: flex-start;
            gap: 0.65rem;
            min-height: 44px;
            margin: 0;
            border: 1px solid var(--cf-border-strong);
            border-radius: 8px;
            padding: 0.65rem 0.7rem;
            background: #fff;
            cursor: pointer;
        }

        .employee-status-option:has(input:checked) {
            border-color: #9bd2b3;
            background: #edf8f2;
        }

        .employee-status-option input {
            width: 1.05rem;
            height: 1.05rem;
            flex: 0 0 auto;
            margin: 0.15rem 0 0;
            accent-color: var(--cf-success);
        }

        .employee-status-option strong,
        .employee-status-option small {
            display: block;
        }

        .employee-status-option strong {
            color: var(--cf-text);
            font-size: 0.8rem;
        }

        .employee-status-option small {
            margin-top: 0.15rem;
            color: var(--cf-muted);
            font-size: 0.72rem;
            line-height: 1.4;
        }

        .employee-create-guide__list {
            margin-top: 1rem;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
}
