@model Manage_KPI_or_OKR_System.Models.Employee

@{
    ViewData["Title"] = "Chỉnh sửa Nhân Viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cf-page employee-edit-page employees-page employee-form-page" data-create-form>
    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Chỉnh sửa nhân viên</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Nhân sự</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">@Model.FullName</span>
            </nav>
            <p class="cf-header__description">Cập nhật thông tin hồ sơ, phân công và liên kết tài khoản của nhân viên.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="cf-back-action">
            <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
            <span>Xem chi tiết</span>
        </a>
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="employeeEditHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="employeeEditHeading">Hồ sơ nhân sự</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
            </div>

            <form asp-action="Edit" method="post" class="cf-form" id="editEmployeeForm" data-create-form-element>
                <input type="hidden" asp-for="Id" />

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="cf-alert employee-server-alert" role="alert">
                        <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
                        <div>
                            <strong>Không thể cập nhật nhân viên.</strong>
                            <span>@ViewBag.ErrorMessage</span>
                        </div>
                    </div>
                }

                <div asp-validation-summary="All" class="cf-alert" role="alert" tabindex="-1" data-error-summary></div>

                <section class="cf-section" aria-labelledby="employeePersonalHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-person-vcard"></i></span>
                        <div>
                            <h3 id="employeePersonalHeading">Thông tin cơ bản</h3>
                            <p>Thông tin định danh và liên hệ chính.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label asp-for="EmployeeCode">Mã nhân viên</label>
                            <input asp-for="EmployeeCode" class="form-control cf-control" readonly aria-describedby="employeeCodeHint" />
                            <span asp-validation-for="EmployeeCode" class="cf-validation"></span>
                            <p id="employeeCodeHint" class="cf-hint">Mã nhân viên không thể thay đổi.</p>
                        </div>

                        <div class="cf-field">
                            <label asp-for="FullName">Họ và tên <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="FullName" class="form-control cf-control" maxlength="100" autocomplete="name" required />
                            <span asp-validation-for="FullName" class="cf-validation"></span>
                        </div>

                        <div class="cf-field">
                            <label asp-for="DateOfBirth">Ngày sinh</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control cf-control" lang="vi" />
                            <span asp-validation-for="DateOfBirth" class="cf-validation"></span>
                        </div>

                        <div class="cf-field">
                            <label asp-for="TaxCode">Mã số thuế</label>
                            <input asp-for="TaxCode" class="form-control cf-control" maxlength="50" autocomplete="off" />
                            <span asp-validation-for="TaxCode" class="cf-validation"></span>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="employeeContactHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-envelope"></i></span>
                        <div>
                            <h3 id="employeeContactHeading">Thông tin liên hệ</h3>
                            <p>Điện thoại và email dùng cho liên lạc nội bộ.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label asp-for="Phone">Số điện thoại <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="Phone" class="form-control cf-control" inputmode="tel" maxlength="15" autocomplete="tel" required />
                            <span asp-validation-for="Phone" class="cf-validation"></span>
                        </div>

                        <div class="cf-field">
                            <label asp-for="Email">Email công việc <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="Email" type="email" class="form-control cf-control" maxlength="255" autocomplete="email" required />
                            <span asp-validation-for="Email" class="cf-validation"></span>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="employeeWorkHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
                        <div>
                            <h3 id="employeeWorkHeading">Công việc và phân công</h3>
                            <p>Phòng ban, vị trí và ngày bắt đầu công tác.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label for="DepartmentId">Phòng ban</label>
                            <select id="DepartmentId" name="departmentId" class="form-select cf-control" asp-items="ViewBag.DepartmentId">
                                <option value="">-- Chọn phòng ban --</option>
                            </select>
                        </div>

                        <div class="cf-field">
                            <label for="PositionId">Vị trí công việc</label>
                            <select id="PositionId" name="positionId" class="form-select cf-control" asp-items="ViewBag.PositionId">
                                <option value="">-- Chọn vị trí --</option>
                            </select>
                        </div>

                        <div class="cf-field">
                            <label asp-for="JoinDate">Ngày vào làm</label>
                            <input asp-for="JoinDate" type="date" class="form-control cf-control" lang="vi" />
                            <span asp-validation-for="JoinDate" class="cf-validation"></span>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="employeeAccountHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                        <div>
                            <h3 id="employeeAccountHeading">Tài khoản và trạng thái</h3>
                            <p>Liên kết tài khoản hệ thống, mục tiêu chiến lược và trạng thái làm việc.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid cf-field-grid--wide-first">
                        <div class="cf-field">
                            <label asp-for="SystemUserId">Tài khoản liên kết</label>
                            <select asp-for="SystemUserId" class="form-select cf-control" asp-items="ViewBag.SystemUserId" aria-describedby="systemUserHint">
                                <option value="">-- Không liên kết tài khoản --</option>
                            </select>
                            <span asp-validation-for="SystemUserId" class="cf-validation"></span>
                            <p id="systemUserHint" class="cf-hint">Mỗi tài khoản chỉ được liên kết với một nhân viên.</p>
                        </div>

                        <div class="cf-field">
                            <label asp-for="StrategicGoalId">Mục tiêu chiến lược theo năm</label>
                            <select asp-for="StrategicGoalId" class="form-select cf-control" asp-items="ViewBag.StrategicGoalId" aria-describedby="strategicGoalHint">
                                <option value="">-- Không gắn mục tiêu cụ thể --</option>
                            </select>
                            <span asp-validation-for="StrategicGoalId" class="cf-validation"></span>
                            <p id="strategicGoalHint" class="cf-hint">Chỉ hiển thị các mục tiêu theo năm đang hoạt động.</p>
                        </div>

                        <div class="cf-field">
                            <span class="employee-status-label">Trạng thái hồ sơ</span>
                            <label class="employee-status-option" for="isActiveSwitch">
                                <input type="checkbox" id="isActiveSwitch" name="IsActive" value="true" @(Model.IsActive == true ? "checked" : "") />
                                <span>
                                    <strong>Đang làm việc</strong>
                                    <small>Tắt để ngừng hoạt động và vô hiệu hóa phân công/tài khoản liên quan.</small>
                                </span>
                            </label>
                            <input type="hidden" name="IsActive" value="false" />
                        </div>
                    </div>
                </section>

                <div class="cf-actions">
                    <a asp-action="Index" class="cf-secondary-action">Hủy</a>
                    <button type="submit"
                            class="cf-primary-action"
                            data-submit-button
                            data-default-label="Lưu thay đổi"
                            data-loading-label="Đang lưu...">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span data-submit-label>Lưu thay đổi</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide employee-create-guide" aria-labelledby="employeeEditGuideHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-info-circle"></i></span>
                <div>
                    <span class="cf-guide__eyebrow">Lưu ý chỉnh sửa</span>
                    <h2 id="employeeEditGuideHeading">Trước khi lưu</h2>
                </div>
            </div>
            <p>Kiểm tra thông tin liên hệ và phân công trước khi xác nhận thay đổi.</p>

            @if (Model.CreatedAt.HasValue)
            {
                <dl class="cf-preview-list">
                    <div>
                        <dt>Ngày tạo hồ sơ</dt>
                        <dd>@Model.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                </dl>
            }

            <ul class="cf-guide__list employee-create-guide__list">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Tắt trạng thái làm việc sẽ vô hiệu hóa phân công và tài khoản liên kết.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Tài khoản liên kết không được dùng bởi nhân viên khác.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Mục tiêu chiến lược phải thuộc phạm vi tenant hiện tại.</span></li>
            </ul>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employees.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
}
