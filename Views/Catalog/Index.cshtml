@{
    ViewData["Title"] = "Quản lý Danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var requestedTab = ViewBag.ActiveTab as string ?? "kpitype";
    var availableTabs = new[] { "kpitype", "okrtype", "kpiproperty", "checkinstatus", "failreason", "gradingrank", "status" };
    var activeTab = availableTabs.Contains(requestedTab, StringComparer.OrdinalIgnoreCase)
        ? requestedTab.ToLowerInvariant()
        : "kpitype";

    var kpiTypes = ViewBag.KPITypes as List<Manage_KPI_or_OKR_System.Models.KPIType> ?? new List<Manage_KPI_or_OKR_System.Models.KPIType>();
    var okrTypes = ViewBag.OKRTypes as List<Manage_KPI_or_OKR_System.Models.OKRType> ?? new List<Manage_KPI_or_OKR_System.Models.OKRType>();
    var kpiProperties = ViewBag.KPIProperties as List<Manage_KPI_or_OKR_System.Models.KPIProperty> ?? new List<Manage_KPI_or_OKR_System.Models.KPIProperty>();
    var checkInStatuses = ViewBag.CheckInStatuses as List<Manage_KPI_or_OKR_System.Models.CheckInStatus> ?? new List<Manage_KPI_or_OKR_System.Models.CheckInStatus>();
    var failReasons = ViewBag.FailReasons as List<Manage_KPI_or_OKR_System.Models.FailReason> ?? new List<Manage_KPI_or_OKR_System.Models.FailReason>();
    var gradingRanks = ViewBag.GradingRanks as List<Manage_KPI_or_OKR_System.Models.GradingRank> ?? new List<Manage_KPI_or_OKR_System.Models.GradingRank>();
    var statuses = ViewBag.Statuses as List<Manage_KPI_or_OKR_System.Models.Status> ?? new List<Manage_KPI_or_OKR_System.Models.Status>();
    var totalCatalogEntries = kpiTypes.Count + okrTypes.Count + kpiProperties.Count + checkInStatuses.Count + failReasons.Count + gradingRanks.Count + statuses.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
}

<div class="evaluation-page catalog-page">
    <header class="evaluation-page-header">
        <div>
            <h1>Danh mục hệ thống</h1>
            <p class="catalog-header-copy">Quản lý dữ liệu nền được sử dụng xuyên suốt quy trình KPI, OKR, Check-in và đánh giá nhân viên.</p>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Cài đặt</span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Danh mục hệ thống</span>
            </nav>
        </div>
        <a asp-controller="SystemParameters" asp-action="Index" class="evaluation-secondary-action catalog-system-link">
            <i class="bi bi-sliders" aria-hidden="true"></i>
            <span>Tham số hệ thống</span>
        </a>
    </header>

    <section class="evaluation-summary catalog-summary" aria-label="Tổng quan danh mục">
        <article>
            <span>Nhóm danh mục</span>
            <strong>@availableTabs.Length</strong>
            <small>Nhóm dữ liệu nền đang quản lý</small>
        </article>
        <article>
            <span>Tổng dữ liệu</span>
            <strong>@totalCatalogEntries</strong>
            <small>Bản ghi cấu hình toàn hệ thống</small>
        </article>
        <article>
            <span>Trạng thái chung</span>
            <strong>@statuses.Count</strong>
            <small>Dùng cho các quy trình nghiệp vụ</small>
        </article>
        <article>
            <span>Bậc xếp hạng</span>
            <strong>@gradingRanks.Count</strong>
            <small>Mức đánh giá nhân viên</small>
        </article>
    </section>

    <section class="evaluation-results catalog-workspace" aria-label="Dữ liệu danh mục">
            <div class="catalog-tabs-wrapper">
                <ul class="nav nav-tabs catalog-tabs flex-nowrap" id="catalogTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link catalog-tab @(activeTab == "kpitype" ? "active" : "")" id="tab-kpitype" data-bs-toggle="tab" data-bs-target="#pane-kpitype" type="button" role="tab" aria-controls="pane-kpitype" aria-selected="@(activeTab == "kpitype" ? "true" : "false")">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i> Loại KPI
                            <span class="catalog-tab-count">@kpiTypes.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link catalog-tab @(activeTab == "okrtype" ? "active" : "")" id="tab-okrtype" data-bs-toggle="tab" data-bs-target="#pane-okrtype" type="button" role="tab" aria-controls="pane-okrtype" aria-selected="@(activeTab == "okrtype" ? "true" : "false")">
                            <i class="bi bi-bullseye" aria-hidden="true"></i> Loại OKR
                            <span class="catalog-tab-count">@okrTypes.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link catalog-tab @(activeTab == "kpiproperty" ? "active" : "")" id="tab-kpiproperty" data-bs-toggle="tab" data-bs-target="#pane-kpiproperty" type="button" role="tab" aria-controls="pane-kpiproperty" aria-selected="@(activeTab == "kpiproperty" ? "true" : "false")">
                            <i class="bi bi-sliders" aria-hidden="true"></i> Thuộc tính KPI
                            <span class="catalog-tab-count">@kpiProperties.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link catalog-tab @(activeTab == "checkinstatus" ? "active" : "")" id="tab-checkinstatus" data-bs-toggle="tab" data-bs-target="#pane-checkinstatus" type="button" role="tab" aria-controls="pane-checkinstatus" aria-selected="@(activeTab == "checkinstatus" ? "true" : "false")">
                            <i class="bi bi-check2-square" aria-hidden="true"></i> Trạng thái Check-in
                            <span class="catalog-tab-count">@checkInStatuses.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link catalog-tab @(activeTab == "failreason" ? "active" : "")" id="tab-failreason" data-bs-toggle="tab" data-bs-target="#pane-failreason" type="button" role="tab" aria-controls="pane-failreason" aria-selected="@(activeTab == "failreason" ? "true" : "false")">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Lý do thất bại
                            <span class="catalog-tab-count">@failReasons.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link catalog-tab @(activeTab == "gradingrank" ? "active" : "")" id="tab-gradingrank" data-bs-toggle="tab" data-bs-target="#pane-gradingrank" type="button" role="tab" aria-controls="pane-gradingrank" aria-selected="@(activeTab == "gradingrank" ? "true" : "false")">
                            <i class="bi bi-trophy" aria-hidden="true"></i> Bậc xếp hạng
                            <span class="catalog-tab-count">@gradingRanks.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link catalog-tab @(activeTab == "status" ? "active" : "")" id="tab-status" data-bs-toggle="tab" data-bs-target="#pane-status" type="button" role="tab" aria-controls="pane-status" aria-selected="@(activeTab == "status" ? "true" : "false")">
                            <i class="bi bi-toggle-on" aria-hidden="true"></i> Trạng thái chung
                            <span class="catalog-tab-count">@statuses.Count</span>
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <a class="nav-link catalog-tab" asp-controller="SystemParameters" asp-action="Index">
                            <i class="bi bi-gear" aria-hidden="true"></i> Tham số hệ thống
                        </a>
                    </li>
                </ul>
            </div>

            <div class="tab-content catalog-tab-content" id="catalogTabContent">

                <!-- TAB: KPI Type -->
                <div class="tab-pane fade @(activeTab == "kpitype" ? "show active" : "")" id="pane-kpitype" role="tabpanel" aria-labelledby="tab-kpitype">
                    <div class="catalog-pane-header">
                        <div class="catalog-pane-title">
                            <span class="catalog-pane-icon" aria-hidden="true"><i class="bi bi-speedometer2"></i></span>
                            <div>
                                <h2>Loại KPI</h2>
                                <p>Phân loại KPI theo mục đích đo lường, chẳng hạn kết quả, hành vi hoặc năng lực.</p>
                            </div>
                        </div>
                        <button type="button" class="evaluation-primary-action catalog-add-action" onclick="showAddSimpleModal('KPIType', 'Loại KPI', 'typeName', 'Tên loại KPI', 'Ví dụ: Kết quả, Hành vi')">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm loại KPI
                        </button>
                    </div>
                    <div class="catalog-table-shell">
                        <table class="evaluation-table catalog-table" id="tbl-kpitype" aria-label="Danh sách loại KPI">
                            <thead><tr><th class="catalog-id-column">ID</th><th>Tên loại KPI</th><th class="catalog-action-column text-end">Thao tác</th></tr></thead>
                            <tbody>
                                @foreach (var item in kpiTypes)
                                {
                                    <tr data-id="@item.Id">
                                        <td><span class="catalog-id">@item.Id</span></td>
                                        <td class="fw-medium text-dark">@item.TypeName</td>
                                        <td>
                                            <div class="evaluation-actions">
                                                <button type="button" class="evaluation-icon-button" title="Sửa" aria-label="Sửa loại KPI @item.TypeName" onclick="showEditSimpleModal('KPIType', 'Loại KPI', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.TypeName ?? ""))', 'typeName', 'Tên loại KPI')"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                                <button type="button" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa loại KPI @item.TypeName" onclick="deleteItem('KPIType', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.TypeName ?? ""))')"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!kpiTypes.Any())
                                {
                                    <tr class="catalog-empty-row"><td colspan="3" class="catalog-empty-cell"><i class="bi bi-inbox" aria-hidden="true"></i><span>Chưa có loại KPI nào.</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB: OKR Type -->
                <div class="tab-pane fade @(activeTab == "okrtype" ? "show active" : "")" id="pane-okrtype" role="tabpanel" aria-labelledby="tab-okrtype">
                    <div class="catalog-pane-header">
                        <div class="catalog-pane-title">
                            <span class="catalog-pane-icon" aria-hidden="true"><i class="bi bi-bullseye"></i></span>
                            <div>
                                <h2>Loại OKR</h2>
                                <p>Phân loại mục tiêu theo phạm vi áp dụng như công ty, phòng ban hoặc cá nhân.</p>
                            </div>
                        </div>
                        <button type="button" class="evaluation-primary-action catalog-add-action" onclick="showAddSimpleModal('OKRType', 'Loại OKR', 'typeName', 'Tên loại OKR', 'Ví dụ: Cấp công ty, Cấp phòng ban')">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm loại OKR
                        </button>
                    </div>
                    <div class="catalog-table-shell">
                        <table class="evaluation-table catalog-table" id="tbl-okrtype" aria-label="Danh sách loại OKR">
                            <thead><tr><th class="catalog-id-column">ID</th><th>Tên loại OKR</th><th class="catalog-action-column text-end">Thao tác</th></tr></thead>
                            <tbody>
                                @foreach (var item in okrTypes)
                                {
                                    <tr data-id="@item.Id">
                                        <td><span class="catalog-id">@item.Id</span></td>
                                        <td class="fw-medium text-dark">@item.TypeName</td>
                                        <td>
                                            <div class="evaluation-actions">
                                                <button type="button" class="evaluation-icon-button" title="Sửa" aria-label="Sửa loại OKR @item.TypeName" onclick="showEditSimpleModal('OKRType', 'Loại OKR', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.TypeName ?? ""))', 'typeName', 'Tên loại OKR')"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                                <button type="button" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa loại OKR @item.TypeName" onclick="deleteItem('OKRType', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.TypeName ?? ""))')"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!okrTypes.Any())
                                {
                                    <tr class="catalog-empty-row"><td colspan="3" class="catalog-empty-cell"><i class="bi bi-inbox" aria-hidden="true"></i><span>Chưa có loại OKR nào.</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB: KPI Property -->
                <div class="tab-pane fade @(activeTab == "kpiproperty" ? "show active" : "")" id="pane-kpiproperty" role="tabpanel" aria-labelledby="tab-kpiproperty">
                    <div class="catalog-pane-header">
                        <div class="catalog-pane-title">
                            <span class="catalog-pane-icon" aria-hidden="true"><i class="bi bi-sliders"></i></span>
                            <div>
                                <h2>Thuộc tính KPI</h2>
                                <p>Quản lý đặc điểm dùng để mô tả cách KPI được đo lường hoặc đánh giá.</p>
                            </div>
                        </div>
                        <button type="button" class="evaluation-primary-action catalog-add-action" onclick="showAddSimpleModal('KPIProperty', 'Thuộc tính KPI', 'propertyName', 'Tên thuộc tính', 'Ví dụ: Định lượng, Định tính')">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm thuộc tính
                        </button>
                    </div>
                    <div class="catalog-table-shell">
                        <table class="evaluation-table catalog-table" aria-label="Danh sách thuộc tính KPI">
                            <thead><tr><th class="catalog-id-column">ID</th><th>Tên thuộc tính</th><th class="catalog-action-column text-end">Thao tác</th></tr></thead>
                            <tbody>
                                @foreach (var item in kpiProperties)
                                {
                                    <tr>
                                        <td><span class="catalog-id">@item.Id</span></td>
                                        <td class="fw-medium text-dark">@item.PropertyName</td>
                                        <td>
                                            <div class="evaluation-actions">
                                                <button type="button" class="evaluation-icon-button" title="Sửa" aria-label="Sửa thuộc tính KPI @item.PropertyName" onclick="showEditSimpleModal('KPIProperty', 'Thuộc tính KPI', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.PropertyName ?? ""))', 'propertyName', 'Tên thuộc tính')"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                                <button type="button" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa thuộc tính KPI @item.PropertyName" onclick="deleteItem('KPIProperty', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.PropertyName ?? ""))')"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!kpiProperties.Any())
                                {
                                    <tr class="catalog-empty-row"><td colspan="3" class="catalog-empty-cell"><i class="bi bi-inbox" aria-hidden="true"></i><span>Chưa có thuộc tính KPI nào.</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB: Check-in Status -->
                <div class="tab-pane fade @(activeTab == "checkinstatus" ? "show active" : "")" id="pane-checkinstatus" role="tabpanel" aria-labelledby="tab-checkinstatus">
                    <div class="catalog-pane-header">
                        <div class="catalog-pane-title">
                            <span class="catalog-pane-icon" aria-hidden="true"><i class="bi bi-check2-square"></i></span>
                            <div>
                                <h2>Trạng thái Check-in</h2>
                                <p>Quản lý các trạng thái phản ánh tiến trình cập nhật và rà soát KPI.</p>
                            </div>
                        </div>
                        <button type="button" class="evaluation-primary-action catalog-add-action" onclick="showAddSimpleModal('CheckInStatus', 'Trạng thái Check-in', 'statusName', 'Tên trạng thái', 'Ví dụ: Đang thực hiện, Hoàn thành')">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm trạng thái
                        </button>
                    </div>
                    <div class="catalog-table-shell">
                        <table class="evaluation-table catalog-table" aria-label="Danh sách trạng thái Check-in">
                            <thead><tr><th class="catalog-id-column">ID</th><th>Tên trạng thái</th><th class="catalog-action-column text-end">Thao tác</th></tr></thead>
                            <tbody>
                                @foreach (var item in checkInStatuses)
                                {
                                    <tr>
                                        <td><span class="catalog-id">@item.Id</span></td>
                                        <td class="fw-medium text-dark">@item.StatusName</td>
                                        <td>
                                            <div class="evaluation-actions">
                                                <button type="button" class="evaluation-icon-button" title="Sửa" aria-label="Sửa trạng thái Check-in @item.StatusName" onclick="showEditSimpleModal('CheckInStatus', 'Trạng thái Check-in', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.StatusName ?? ""))', 'statusName', 'Tên trạng thái')"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                                <button type="button" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa trạng thái Check-in @item.StatusName" onclick="deleteItem('CheckInStatus', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.StatusName ?? ""))')"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!checkInStatuses.Any())
                                {
                                    <tr class="catalog-empty-row"><td colspan="3" class="catalog-empty-cell"><i class="bi bi-inbox" aria-hidden="true"></i><span>Chưa có trạng thái Check-in nào.</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB: Fail Reason -->
                <div class="tab-pane fade @(activeTab == "failreason" ? "show active" : "")" id="pane-failreason" role="tabpanel" aria-labelledby="tab-failreason">
                    <div class="catalog-pane-header">
                        <div class="catalog-pane-title">
                            <span class="catalog-pane-icon" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></span>
                            <div>
                                <h2>Lý do thất bại</h2>
                                <p>Chuẩn hóa nguyên nhân được sử dụng khi KPI không đạt mục tiêu hoặc bị gián đoạn.</p>
                            </div>
                        </div>
                        <button type="button" class="evaluation-primary-action catalog-add-action" onclick="showAddSimpleModal('FailReason', 'Lý do thất bại', 'reasonName', 'Tên lý do', 'Ví dụ: Thiếu nguồn lực, Chậm tiến độ')">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm lý do
                        </button>
                    </div>
                    <div class="catalog-table-shell">
                        <table class="evaluation-table catalog-table" aria-label="Danh sách lý do thất bại">
                            <thead><tr><th class="catalog-id-column">ID</th><th>Tên lý do</th><th class="catalog-action-column text-end">Thao tác</th></tr></thead>
                            <tbody>
                                @foreach (var item in failReasons)
                                {
                                    <tr>
                                        <td><span class="catalog-id">@item.Id</span></td>
                                        <td class="fw-medium text-dark">@item.ReasonName</td>
                                        <td>
                                            <div class="evaluation-actions">
                                                <button type="button" class="evaluation-icon-button" title="Sửa" aria-label="Sửa lý do thất bại @item.ReasonName" onclick="showEditSimpleModal('FailReason', 'Lý do thất bại', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.ReasonName ?? ""))', 'reasonName', 'Tên lý do')"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                                <button type="button" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa lý do thất bại @item.ReasonName" onclick="deleteItem('FailReason', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.ReasonName ?? ""))')"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!failReasons.Any())
                                {
                                    <tr class="catalog-empty-row"><td colspan="3" class="catalog-empty-cell"><i class="bi bi-inbox" aria-hidden="true"></i><span>Chưa có lý do thất bại nào.</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB: Grading Rank -->
                <div class="tab-pane fade @(activeTab == "gradingrank" ? "show active" : "")" id="pane-gradingrank" role="tabpanel" aria-labelledby="tab-gradingrank">
                    <div class="catalog-pane-header">
                        <div class="catalog-pane-title">
                            <span class="catalog-pane-icon" aria-hidden="true"><i class="bi bi-trophy"></i></span>
                            <div>
                                <h2>Bậc xếp hạng</h2>
                                <p>Thiết lập mã hạng, ngưỡng điểm tối thiểu và mô tả cho kết quả đánh giá nhân viên.</p>
                            </div>
                        </div>
                        <button type="button" class="evaluation-primary-action catalog-add-action" onclick="showAddGradingRankModal()">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm bậc xếp hạng
                        </button>
                    </div>
                    <div class="catalog-table-shell">
                        <table class="evaluation-table catalog-table" aria-label="Danh sách bậc xếp hạng">
                            <thead><tr><th class="catalog-id-column">ID</th><th>Mã hạng</th><th>Điểm tối thiểu</th><th>Mô tả</th><th class="catalog-action-column text-end">Thao tác</th></tr></thead>
                            <tbody>
                                @foreach (var item in gradingRanks)
                                {
                                    <tr>
                                        <td><span class="catalog-id">@item.Id</span></td>
                                        <td><span class="catalog-value-tag catalog-value-tag--rank">@item.RankCode</span></td>
                                        <td class="fw-medium text-dark">@(item.MinScore?.ToString("0.##") ?? "—")</td>
                                        <td class="catalog-muted-value">@(item.Description ?? "—")</td>
                                        <td>
                                            <div class="evaluation-actions">
                                                <button type="button" class="evaluation-icon-button" title="Sửa" aria-label="Sửa bậc xếp hạng @item.RankCode" onclick="showEditGradingRankModal(@item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.RankCode ?? ""))', @(item.MinScore?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null"), '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Description ?? ""))')"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                                <button type="button" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa bậc xếp hạng @item.RankCode" onclick="deleteItem('GradingRank', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.RankCode ?? ""))')"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!gradingRanks.Any())
                                {
                                    <tr class="catalog-empty-row"><td colspan="5" class="catalog-empty-cell"><i class="bi bi-inbox" aria-hidden="true"></i><span>Chưa có bậc xếp hạng nào.</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB: Status -->
                <div class="tab-pane fade @(activeTab == "status" ? "show active" : "")" id="pane-status" role="tabpanel" aria-labelledby="tab-status">
                    <div class="catalog-pane-header">
                        <div class="catalog-pane-title">
                            <span class="catalog-pane-icon" aria-hidden="true"><i class="bi bi-toggle-on"></i></span>
                            <div>
                                <h2>Trạng thái chung</h2>
                                <p>Quản lý trạng thái dùng chung cho các module KPI, OKR và kỳ đánh giá.</p>
                            </div>
                        </div>
                        <button type="button" class="evaluation-primary-action catalog-add-action" onclick="showAddStatusModal()">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm trạng thái
                        </button>
                    </div>
                    <div class="catalog-table-shell">
                        <table class="evaluation-table catalog-table" aria-label="Danh sách trạng thái chung">
                            <thead><tr><th class="catalog-id-column">ID</th><th>Loại trạng thái</th><th>Tên trạng thái</th><th class="catalog-action-column text-end">Thao tác</th></tr></thead>
                            <tbody>
                                @foreach (var item in statuses)
                                {
                                    <tr>
                                        <td><span class="catalog-id">@item.Id</span></td>
                                        <td><span class="catalog-value-tag">@(item.StatusType ?? "—")</span></td>
                                        <td class="fw-medium text-dark">@(item.StatusName ?? "—")</td>
                                        <td>
                                            <div class="evaluation-actions">
                                                <button type="button" class="evaluation-icon-button" title="Sửa" aria-label="Sửa trạng thái @item.StatusName" onclick="showEditStatusModal(@item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.StatusType ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.StatusName ?? ""))')"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                                <button type="button" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa trạng thái @item.StatusName" onclick="deleteItem('Status', @item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.StatusName ?? ""))')"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!statuses.Any())
                                {
                                    <tr class="catalog-empty-row"><td colspan="4" class="catalog-empty-cell"><i class="bi bi-inbox" aria-hidden="true"></i><span>Chưa có trạng thái chung nào.</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
    </section>
</div>

<!-- MODAL: Simple Add/Edit (1 field) -->
<div class="modal fade" id="simpleModal" tabindex="-1" aria-labelledby="simpleModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content evaluation-modal catalog-modal" id="simpleCatalogForm" onsubmit="submitSimpleModal(event)">
            <div class="modal-header">
                <h2 class="modal-title" id="simpleModalTitle"><i class="bi bi-plus-circle" aria-hidden="true"></i><span id="simpleModalTitleText">Thêm mới</span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="simpleModalEntityType" />
                <input type="hidden" id="simpleModalId" />
                <input type="hidden" id="simpleModalFieldName" />
                <div class="catalog-modal-field">
                    <label id="simpleModalFieldLabel" for="simpleModalFieldValue">Tên</label>
                    <input type="text" class="form-control" id="simpleModalFieldValue" placeholder="" autocomplete="off" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="evaluation-secondary-action" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="evaluation-primary-action" id="simpleModalSubmit">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> <span id="simpleModalBtnText">Lưu</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Grading Rank -->
<div class="modal fade" id="gradingRankModal" tabindex="-1" aria-labelledby="gradingRankModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content evaluation-modal catalog-modal" id="gradingRankForm" onsubmit="submitGradingRank(event)">
            <div class="modal-header">
                <h2 class="modal-title" id="gradingRankModalTitle"><i class="bi bi-trophy" aria-hidden="true"></i><span id="gradingRankModalTitleText">Bậc xếp hạng</span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="grankId" />
                <div class="row g-3">
                    <div class="col-md-6 catalog-modal-field">
                        <label for="grankCode">Mã hạng <span class="text-danger" aria-label="bắt buộc">*</span></label>
                        <input type="text" class="form-control" id="grankCode" placeholder="Ví dụ: A, B, C" autocomplete="off" required />
                    </div>
                    <div class="col-md-6 catalog-modal-field">
                        <label for="grankMinScore">Điểm tối thiểu</label>
                        <input type="number" step="0.01" class="form-control" id="grankMinScore" placeholder="Ví dụ: 90" inputmode="decimal" />
                    </div>
                    <div class="col-12 catalog-modal-field">
                        <label for="grankDescription">Mô tả</label>
                        <input type="text" class="form-control" id="grankDescription" placeholder="Ví dụ: Xuất sắc, Giỏi, Khá" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="evaluation-secondary-action" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="evaluation-primary-action" id="gradingRankSubmit">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> <span id="grankBtnText">Lưu</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Status -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content evaluation-modal catalog-modal" id="statusCatalogForm" onsubmit="submitStatus(event)">
            <div class="modal-header">
                <h2 class="modal-title" id="statusModalTitle"><i class="bi bi-toggle-on" aria-hidden="true"></i><span id="statusModalTitleText">Trạng thái</span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="statusId" />
                <div class="row g-3">
                    <div class="col-md-6 catalog-modal-field">
                        <label for="statusType">Loại trạng thái <span class="text-danger" aria-label="bắt buộc">*</span></label>
                        <input type="text" class="form-control" id="statusType" placeholder="Ví dụ: KPI, OKR, EvaluationPeriod" autocomplete="off" required />
                    </div>
                    <div class="col-md-6 catalog-modal-field">
                        <label for="statusName">Tên trạng thái <span class="text-danger" aria-label="bắt buộc">*</span></label>
                        <input type="text" class="form-control" id="statusName" placeholder="Ví dụ: Active, Completed" autocomplete="off" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="evaluation-secondary-action" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="evaluation-primary-action" id="statusModalSubmit">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> <span id="statusBtnText">Lưu</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function applyCatalogMobileLabels() {
        document.querySelectorAll('#catalogTabContent .catalog-table').forEach((table) => {
            const headers = Array.from(table.querySelectorAll('thead th')).map((th) => th.textContent.trim());
            table.querySelectorAll('tbody tr').forEach((row) => {
                row.querySelectorAll('td').forEach((cell, index) => {
                    cell.setAttribute('data-label', headers[index] || '');
                });
            });
        });
    }

    applyCatalogMobileLabels();

    document.querySelectorAll('#catalogTabs [data-bs-toggle="tab"]').forEach((tabButton) => {
        tabButton.addEventListener('shown.bs.tab', (event) => {
            const tab = event.target.id.replace('tab-', '');
            const url = new URL(window.location.href);
            url.searchParams.set('tab', tab);
            window.history.replaceState({}, '', url);
        });
    });

    function showCatalogModal(modalId, focusId) {
        const modalElement = document.getElementById(modalId);
        modalElement.addEventListener('shown.bs.modal', () => document.getElementById(focusId)?.focus(), { once: true });
        bootstrap.Modal.getOrCreateInstance(modalElement).show();
    }

    function resetCatalogSubmit(buttonId, labelId, readyLabel) {
        const button = document.getElementById(buttonId);
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.dataset.readyLabel = readyLabel;
        document.getElementById(labelId).textContent = readyLabel;
    }

    function setCatalogSubmitBusy(buttonId, labelId, isBusy) {
        const button = document.getElementById(buttonId);
        button.disabled = isBusy;
        button.toggleAttribute('aria-busy', isBusy);
        document.getElementById(labelId).textContent = isBusy ? 'Đang lưu...' : button.dataset.readyLabel;
    }

    async function sendCatalogRequest(url, formData) {
        const response = await fetch(url, { method: 'POST', body: formData });
        const data = await response.json();

        if (!response.ok) {
            return { success: false, message: data.message || 'Không thể xử lý yêu cầu.' };
        }

        return data;
    }

    // =========================================
    // SIMPLE MODAL (1 field: KPIType, OKRType, KPIProperty, CheckInStatus, FailReason)
    // =========================================
    function showAddSimpleModal(entityType, title, fieldName, fieldLabel, placeholder) {
        document.getElementById('simpleModalEntityType').value = entityType;
        document.getElementById('simpleModalId').value = '';
        document.getElementById('simpleModalFieldName').value = fieldName;
        document.getElementById('simpleModalTitleText').textContent = `Thêm ${title}`;
        document.getElementById('simpleModalFieldLabel').textContent = fieldLabel;
        document.getElementById('simpleModalFieldValue').value = '';
        document.getElementById('simpleModalFieldValue').placeholder = placeholder;
        resetCatalogSubmit('simpleModalSubmit', 'simpleModalBtnText', 'Thêm mới');
        showCatalogModal('simpleModal', 'simpleModalFieldValue');
    }

    function showEditSimpleModal(entityType, title, id, currentValue, fieldName, fieldLabel) {
        document.getElementById('simpleModalEntityType').value = entityType;
        document.getElementById('simpleModalId').value = id;
        document.getElementById('simpleModalFieldName').value = fieldName;
        document.getElementById('simpleModalTitleText').textContent = `Sửa ${title}`;
        document.getElementById('simpleModalFieldLabel').textContent = fieldLabel;
        document.getElementById('simpleModalFieldValue').value = currentValue;
        resetCatalogSubmit('simpleModalSubmit', 'simpleModalBtnText', 'Cập nhật');
        showCatalogModal('simpleModal', 'simpleModalFieldValue');
    }

    async function submitSimpleModal(event) {
        event?.preventDefault();
        const form = document.getElementById('simpleCatalogForm');
        if (!form.reportValidity()) return;

        const entityType = document.getElementById('simpleModalEntityType').value;
        const id = document.getElementById('simpleModalId').value;
        const fieldName = document.getElementById('simpleModalFieldName').value;
        const fieldValue = document.getElementById('simpleModalFieldValue').value.trim();
        if (!fieldValue) { window.AppFeedback.toast({ tone: 'warning', eyebrow: 'Quản lý danh mục', title: 'Thiếu dữ liệu', message: 'Vui lòng nhập giá trị.' }); return; }

        const isEdit = id !== '';
        const url = `/Catalog/${isEdit ? 'Edit' : 'Create'}${entityType}`;
        const formData = new FormData();
        if (isEdit) formData.append('id', id);
        formData.append(fieldName, fieldValue);
        window.appendAntiForgeryToken?.(formData);

        setCatalogSubmitBusy('simpleModalSubmit', 'simpleModalBtnText', true);
        try {
            const data = await sendCatalogRequest(url, formData);
            if (data.success) {
                window.AppFeedback.toast({ tone: 'success', eyebrow: 'Quản lý danh mục', title: 'Đã lưu', message: data.message });
                setTimeout(() => location.reload(), 900);
                return;
            }

            window.AppFeedback.toast({ tone: 'error', eyebrow: 'Quản lý danh mục', title: 'Không thể lưu', message: data.message });
        } catch {
            window.AppFeedback.toast({ tone: 'error', eyebrow: 'Kết nối', title: 'Lỗi kết nối', message: 'Đã xảy ra lỗi kết nối.' });
        }

        setCatalogSubmitBusy('simpleModalSubmit', 'simpleModalBtnText', false);
    }

    // =========================================
    // DELETE (Universal)
    // =========================================
    async function deleteItem(entityType, id, name) {
        const confirmed = await window.AppFeedback.confirm({
            title: 'Xóa mục khỏi danh mục?',
            message: `“${name}” sẽ bị xóa nếu không có dữ liệu đang liên kết. Thao tác này không thể hoàn tác.`,
            tone: 'danger',
            confirmText: 'Xóa mục',
            cancelText: 'Hủy'
        });
        if (!confirmed) return;

        const formData = new FormData();
        formData.append('id', id);
        window.appendAntiForgeryToken?.(formData);
        fetch(`/Catalog/Delete${entityType}`, { method: 'POST', body: formData })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    window.AppFeedback.toast({ tone: 'success', eyebrow: 'Quản lý danh mục', title: 'Đã xóa', message: data.message });
                    setTimeout(() => location.reload(), 1500);
                } else {
                    window.AppFeedback.toast({ tone: 'error', eyebrow: 'Quản lý danh mục', title: 'Không thể xóa', message: data.message });
                }
            })
            .catch(() => window.AppFeedback.toast({ tone: 'error', eyebrow: 'Kết nối', title: 'Lỗi kết nối', message: 'Đã xảy ra lỗi kết nối.' }));
    }

    // =========================================
    // GRADING RANK MODAL
    // =========================================
    function showAddGradingRankModal() {
        document.getElementById('grankId').value = '';
        document.getElementById('grankCode').value = '';
        document.getElementById('grankMinScore').value = '';
        document.getElementById('grankDescription').value = '';
        document.getElementById('gradingRankModalTitleText').textContent = 'Thêm bậc xếp hạng';
        resetCatalogSubmit('gradingRankSubmit', 'grankBtnText', 'Thêm mới');
        showCatalogModal('gradingRankModal', 'grankCode');
    }

    function showEditGradingRankModal(id, code, minScore, description) {
        document.getElementById('grankId').value = id;
        document.getElementById('grankCode').value = code;
        document.getElementById('grankMinScore').value = minScore !== null ? minScore : '';
        document.getElementById('grankDescription').value = description;
        document.getElementById('gradingRankModalTitleText').textContent = 'Sửa bậc xếp hạng';
        resetCatalogSubmit('gradingRankSubmit', 'grankBtnText', 'Cập nhật');
        showCatalogModal('gradingRankModal', 'grankCode');
    }

    async function submitGradingRank(event) {
        event?.preventDefault();
        const form = document.getElementById('gradingRankForm');
        if (!form.reportValidity()) return;

        const id = document.getElementById('grankId').value;
        const rankCode = document.getElementById('grankCode').value.trim();
        if (!rankCode) { window.AppFeedback.toast({ tone: 'warning', eyebrow: 'Bậc Xếp hạng', title: 'Thiếu dữ liệu', message: 'Mã hạng không được để trống.' }); return; }

        const isEdit = id !== '';
        const formData = new FormData();
        if (isEdit) formData.append('id', id);
        formData.append('rankCode', rankCode);
        formData.append('minScore', document.getElementById('grankMinScore').value);
        formData.append('description', document.getElementById('grankDescription').value.trim());
        window.appendAntiForgeryToken?.(formData);

        setCatalogSubmitBusy('gradingRankSubmit', 'grankBtnText', true);
        try {
            const data = await sendCatalogRequest(`/Catalog/${isEdit ? 'Edit' : 'Create'}GradingRank`, formData);
            if (data.success) {
                window.AppFeedback.toast({ tone: 'success', eyebrow: 'Bậc xếp hạng', title: 'Đã lưu', message: data.message });
                setTimeout(() => location.reload(), 900);
                return;
            }

            window.AppFeedback.toast({ tone: 'error', eyebrow: 'Bậc xếp hạng', title: 'Không thể lưu', message: data.message });
        } catch {
            window.AppFeedback.toast({ tone: 'error', eyebrow: 'Kết nối', title: 'Lỗi kết nối', message: 'Đã xảy ra lỗi kết nối.' });
        }

        setCatalogSubmitBusy('gradingRankSubmit', 'grankBtnText', false);
    }

    // =========================================
    // STATUS MODAL
    // =========================================
    function showAddStatusModal() {
        document.getElementById('statusId').value = '';
        document.getElementById('statusType').value = '';
        document.getElementById('statusName').value = '';
        document.getElementById('statusModalTitleText').textContent = 'Thêm trạng thái';
        resetCatalogSubmit('statusModalSubmit', 'statusBtnText', 'Thêm mới');
        showCatalogModal('statusModal', 'statusType');
    }

    function showEditStatusModal(id, type, name) {
        document.getElementById('statusId').value = id;
        document.getElementById('statusType').value = type;
        document.getElementById('statusName').value = name;
        document.getElementById('statusModalTitleText').textContent = 'Sửa trạng thái';
        resetCatalogSubmit('statusModalSubmit', 'statusBtnText', 'Cập nhật');
        showCatalogModal('statusModal', 'statusType');
    }

    async function submitStatus(event) {
        event?.preventDefault();
        const form = document.getElementById('statusCatalogForm');
        if (!form.reportValidity()) return;

        const id = document.getElementById('statusId').value;
        const statusType = document.getElementById('statusType').value.trim();
        const statusName = document.getElementById('statusName').value.trim();
        if (!statusType || !statusName) { window.AppFeedback.toast({ tone: 'warning', eyebrow: 'Trạng thái', title: 'Thiếu dữ liệu', message: 'Vui lòng điền đầy đủ thông tin.' }); return; }

        const isEdit = id !== '';
        const formData = new FormData();
        if (isEdit) formData.append('id', id);
        formData.append('statusType', statusType);
        formData.append('statusName', statusName);
        window.appendAntiForgeryToken?.(formData);

        setCatalogSubmitBusy('statusModalSubmit', 'statusBtnText', true);
        try {
            const data = await sendCatalogRequest(`/Catalog/${isEdit ? 'Edit' : 'Create'}Status`, formData);
            if (data.success) {
                window.AppFeedback.toast({ tone: 'success', eyebrow: 'Trạng thái', title: 'Đã lưu', message: data.message });
                setTimeout(() => location.reload(), 900);
                return;
            }

            window.AppFeedback.toast({ tone: 'error', eyebrow: 'Trạng thái', title: 'Không thể lưu', message: data.message });
        } catch {
            window.AppFeedback.toast({ tone: 'error', eyebrow: 'Kết nối', title: 'Lỗi kết nối', message: 'Đã xảy ra lỗi kết nối.' });
        }

        setCatalogSubmitBusy('statusModalSubmit', 'statusBtnText', false);
    }

</script>
}
