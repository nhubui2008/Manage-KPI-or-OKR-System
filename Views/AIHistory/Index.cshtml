<!-- TOAST FEEDBACK -->
<div class="ai-copy-toast" id="aiCopyToast">
    <i class="bi bi-check2-circle text-success me-1"></i>Đã sao chép vào bộ nhớ tạm
</div>

@functions {
    public static string FormatMarkdownText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;

        var lines = text.Replace("\r\n", "\n").Split('\n').Select(l => l.Trim()).ToArray();
        var chunks = new List<string>();
        string? currentListType = null;
        var listItems = new List<string>();

        string Escape(string v) => System.Net.WebUtility.HtmlEncode(v);
        string Inline(string v)
        {
            var esc = Escape(v);
            return System.Text.RegularExpressions.Regex.Replace(esc, @"\*\*(.*?)\*\*", "<strong>$1</strong>");
        }

        void FlushList()
        {
            if (listItems.Count > 0 && currentListType != null)
            {
                chunks.Add($"<{currentListType}>" + string.Join("", listItems.Select(li => $"<li>{Inline(li)}</li>")) + $"</{currentListType}>");
                currentListType = null;
                listItems.Clear();
            }
        }

        foreach (var line in lines)
        {
            if (string.IsNullOrEmpty(line))
            {
                FlushList();
                continue;
            }

            var unorderedMatch = System.Text.RegularExpressions.Regex.Match(line, @"^[-*•]\s+(.+)$");
            var orderedMatch = System.Text.RegularExpressions.Regex.Match(line, @"^\d+[.)]\s+(.+)$");

            if (unorderedMatch.Success || orderedMatch.Success)
            {
                var nextType = unorderedMatch.Success ? "ul" : "ol";
                if (currentListType != null && currentListType != nextType)
                {
                    FlushList();
                }
                currentListType = nextType;
                listItems.Add(unorderedMatch.Success ? unorderedMatch.Groups[1].Value : orderedMatch.Groups[1].Value);
                continue;
            }

            FlushList();
            chunks.Add($"<p>{Inline(line)}</p>");
        }

        FlushList();
        return string.Join("", chunks);
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Copy payload / text helper
            const toast = document.getElementById('aiCopyToast');
            function showToast(msg) {
                if (!toast) return;
                if (msg) toast.innerHTML = `<i class="bi bi-check2-circle text-success me-1"></i>${msg}`;
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 2000);
            }

            // Copy entry buttons
            document.querySelectorAll('.btn-copy-entry, .ai-history-json-copy-btn').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const payload = this.dataset.payload;
                    if (payload) {
                        navigator.clipboard.writeText(payload).then(() => {
                            showToast('Đã sao chép vào bộ nhớ tạm');
                        }).catch(() => {
                            showToast('Không thể sao chép');
                        });
                    }
                });
            });

            // Continue chat button integration
            const continueChatBtn = document.getElementById('btnContinueChat');
            if (continueChatBtn) {
                continueChatBtn.addEventListener('click', function () {
                    const sessionId = this.dataset.sessionId;
                    if (window.aiChatWidget && typeof window.aiChatWidget.loadConversation === 'function') {
                        window.aiChatWidget.loadConversation(sessionId);
                    } else {
                        // Fallback reload with query param
                        window.location.href = `?id=${encodeURIComponent(sessionId)}&aiChatSession=${encodeURIComponent(sessionId)}`;
                    }
                });
            }

            // New chat button integration
            document.querySelectorAll('[data-ai-new-chat]').forEach(btn => {
                btn.addEventListener('click', function () {
                    if (window.aiChatWidget && typeof window.aiChatWidget.resetConversation === 'function') {
                        window.aiChatWidget.resetConversation();
                    }
                });
            });
        });
    </script>
}
