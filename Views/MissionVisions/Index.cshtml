@model Manage_KPI_or_OKR_System.Models.ViewModels.MissionVisionIndexViewModel
@{
    ViewData["Title"] = "Sứ mệnh & Tầm nhìn";
    var currentYear = DateTime.Now.Year;
    var visionStatement = Model.LongTermStatements.FirstOrDefault(item => item.MissionVisionType == MissionVision.TypeVision);
    var missionStatement = Model.LongTermStatements.FirstOrDefault(item => item.MissionVisionType == MissionVision.TypeMission);
    var foundationCount = (visionStatement != null ? 1 : 0) + (missionStatement != null ? 1 : 0);
    var hasFinancialTargets = Model.YearlyGoals.Any(goal => goal.FinancialTarget.HasValue);
    var financialTargetTotal = Model.YearlyGoals.Sum(goal => goal.FinancialTarget ?? 0);
    var viewedYearLabel = Model.ShowAllYears ? "Tất cả" : Model.SelectedYear?.ToString() ?? "Chưa có";
    var canManageMission = Model.CanEditMission || Model.CanDeleteMission;
}

@section Styles {
    <link rel="stylesheet" href="~/css/mission-visions.css" asp-append-version="true" />
}

<div class="mission-vision-page">
    <header class="mv-page-header">
        <div>
            <h1 class="mv-page-header-title">Định hướng chiến lược</h1>
            <nav class="mv-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Sứ mệnh &amp; Tầm nhìn</span>
            </nav>
        </div>
        @if (Model.CanCreateMission)
        {
            <a asp-action="Create" asp-route-type="@MissionVision.TypeYearlyGoal" class="btn btn-primary mv-primary-action page-create-action">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Tạo mục tiêu</span>
            </a>
        }
    </header>

    <section class="mv-summary-grid" aria-label="Tổng quan định hướng chiến lược">
        <div class="mv-summary-card">
            <div class="mv-summary-card__info">
                <span class="mv-summary-card__label">Nền tảng dài hạn</span>
                <span class="mv-summary-card__value">@foundationCount/2</span>
            </div>
            <div class="mv-summary-card__icon" aria-hidden="true">
                <i class="bi bi-compass"></i>
            </div>
        </div>
        <div class="mv-summary-card">
            <div class="mv-summary-card__info">
                <span class="mv-summary-card__label">Mục tiêu đang xem</span>
                <span class="mv-summary-card__value">@Model.YearlyGoals.Count</span>
            </div>
            <div class="mv-summary-card__icon" aria-hidden="true">
                <i class="bi bi-flag"></i>
            </div>
        </div>
        <div class="mv-summary-card">
            <div class="mv-summary-card__info">
                <span class="mv-summary-card__label">Mục tiêu tài chính</span>
                <span class="mv-summary-card__value">
                    @(hasFinancialTargets ? String.Format("{0:N0} đ", financialTargetTotal) : "Chưa đặt")
                </span>
            </div>
            <div class="mv-summary-card__icon" aria-hidden="true">
                <i class="bi bi-cash-coin"></i>
            </div>
        </div>
        <div class="mv-summary-card">
            <div class="mv-summary-card__info">
                <span class="mv-summary-card__label">Năm đang xem</span>
                <span class="mv-summary-card__value">@viewedYearLabel</span>
            </div>
            <div class="mv-summary-card__icon" aria-hidden="true">
                <i class="bi bi-calendar3"></i>
            </div>
        </div>
    </section>

    <section class="mv-section" aria-labelledby="mv-foundation-heading">
        <div class="mv-section-header">
            <div>
                <span class="mv-section-kicker">Định hướng dài hạn</span>
                <h2 id="mv-foundation-heading" class="mv-section-title">Tầm nhìn và Sứ mệnh</h2>
            </div>
            <span class="mv-section-count">@foundationCount/2 đã thiết lập</span>
        </div>

        <div class="mv-foundation-grid">
            @if (visionStatement != null)
            {
                <article class="mv-foundation-card">
                    <div class="mv-foundation-card__header">
                        <div class="mv-foundation-card__identity">
                            <div class="mv-foundation-card__icon" aria-hidden="true"><i class="bi bi-compass"></i></div>
                            <div>
                                <span class="mv-foundation-card__type">Tầm nhìn</span>
                                <span class="mv-foundation-card__meta">Đích đến dài hạn</span>
                            </div>
                        </div>
                        @if (canManageMission)
                        {
                            <div class="dropdown">
                                <button class="btn mv-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tùy chọn Tầm nhìn" title="Tùy chọn Tầm nhìn">
                                    <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (Model.CanEditMission)
                                    {
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@visionStatement.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Chỉnh sửa</a></li>
                                    }
                                    @if (Model.CanDeleteMission)
                                    {
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@visionStatement.Id" method="post"
                                                  data-app-confirm
                                                  data-confirm-title="Vô hiệu hóa Tầm nhìn?"
                                                  data-confirm-message="Tầm nhìn sẽ được ẩn khỏi dữ liệu đang hoạt động nhưng lịch sử vẫn được giữ lại."
                                                  data-confirm-tone="warning"
                                                  data-confirm-label="Vô hiệu hóa">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-archive me-2" aria-hidden="true"></i>Vô hiệu hóa</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    <h3>@visionStatement.Content</h3>
                    <div class="mv-foundation-card__footer">
                        <span>Mục tiêu tài chính dài hạn</span>
                        <strong>@(visionStatement.FinancialTarget.HasValue ? String.Format("{0:N0} đ", visionStatement.FinancialTarget.Value) : "Chưa đặt")</strong>
                    </div>
                </article>
            }
            else
            {
                <article class="mv-foundation-card mv-foundation-card--empty">
                    <div>
                        <div class="mv-foundation-card__header">
                            <div class="mv-foundation-card__identity">
                                <div class="mv-foundation-card__icon" aria-hidden="true"><i class="bi bi-compass"></i></div>
                                <div>
                                    <span class="mv-foundation-card__type">Tầm nhìn</span>
                                    <span class="mv-foundation-card__meta">Chưa thiết lập</span>
                                </div>
                            </div>
                        </div>
                        <h3>Doanh nghiệp muốn trở thành ai trong tương lai?</h3>
                        <p>Mô tả đích đến dài hạn mà toàn tổ chức cùng hướng tới.</p>
                    </div>
                    @if (Model.CanCreateMission)
                    {
                        <div>
                            <a asp-action="Create" asp-route-type="@MissionVision.TypeVision" class="btn btn-outline-primary mv-setup-action page-create-action">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                <span>Thiết lập Tầm nhìn</span>
                            </a>
                        </div>
                    }
                </article>
            }

            @if (missionStatement != null)
            {
                <article class="mv-foundation-card">
                    <div class="mv-foundation-card__header">
                        <div class="mv-foundation-card__identity">
                            <div class="mv-foundation-card__icon" aria-hidden="true"><i class="bi bi-bullseye"></i></div>
                            <div>
                                <span class="mv-foundation-card__type">Sứ mệnh</span>
                                <span class="mv-foundation-card__meta">Giá trị cốt lõi</span>
                            </div>
                        </div>
                        @if (canManageMission)
                        {
                            <div class="dropdown">
                                <button class="btn mv-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tùy chọn Sứ mệnh" title="Tùy chọn Sứ mệnh">
                                    <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (Model.CanEditMission)
                                    {
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@missionStatement.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Chỉnh sửa</a></li>
                                    }
                                    @if (Model.CanDeleteMission)
                                    {
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@missionStatement.Id" method="post"
                                                  data-app-confirm
                                                  data-confirm-title="Vô hiệu hóa Sứ mệnh?"
                                                  data-confirm-message="Sứ mệnh sẽ được ẩn khỏi dữ liệu đang hoạt động nhưng lịch sử vẫn được giữ lại."
                                                  data-confirm-tone="warning"
                                                  data-confirm-label="Vô hiệu hóa">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-archive me-2" aria-hidden="true"></i>Vô hiệu hóa</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    <h3>@missionStatement.Content</h3>
                    <div class="mv-foundation-card__footer">
                        <span>Mục tiêu tài chính hỗ trợ</span>
                        <strong>@(missionStatement.FinancialTarget.HasValue ? String.Format("{0:N0} đ", missionStatement.FinancialTarget.Value) : "Chưa đặt")</strong>
                    </div>
                </article>
            }
            else
            {
                <article class="mv-foundation-card mv-foundation-card--empty">
                    <div>
                        <div class="mv-foundation-card__header">
                            <div class="mv-foundation-card__identity">
                                <div class="mv-foundation-card__icon" aria-hidden="true"><i class="bi bi-bullseye"></i></div>
                                <div>
                                    <span class="mv-foundation-card__type">Sứ mệnh</span>
                                    <span class="mv-foundation-card__meta">Chưa thiết lập</span>
                                </div>
                            </div>
                        </div>
                        <h3>Doanh nghiệp tồn tại để tạo ra giá trị gì?</h3>
                        <p>Nêu đối tượng phục vụ, giá trị mang lại và lý do tồn tại.</p>
                    </div>
                    @if (Model.CanCreateMission)
                    {
                        <div>
                            <a asp-action="Create" asp-route-type="@MissionVision.TypeMission" class="btn btn-outline-primary mv-setup-action page-create-action">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                <span>Thiết lập Sứ mệnh</span>
                            </a>
                        </div>
                    }
                </article>
            }
        </div>
    </section>

    <section class="mv-section" aria-labelledby="mv-yearly-heading">
        <div class="mv-yearly-toolbar">
            <div>
                <span class="mv-section-kicker">Kế hoạch chiến lược</span>
                <h2 id="mv-yearly-heading" class="mv-section-title">Mục tiêu theo năm</h2>
            </div>
            @if (Model.AvailableYears.Any())
            {
                <nav class="mv-year-filter" aria-label="Lọc mục tiêu theo năm">
                    <a asp-action="Index" asp-route-allYears="true" class="@(Model.ShowAllYears ? "active" : null)" aria-current="@(Model.ShowAllYears ? "page" : null)">Tất cả</a>
                    @foreach (var year in Model.AvailableYears)
                    {
                        var isSelectedYear = !Model.ShowAllYears && Model.SelectedYear == year;
                        <a asp-action="Index" asp-route-year="@year" class="@(isSelectedYear ? "active" : null)" aria-current="@(isSelectedYear ? "page" : null)">@year</a>
                    }
                </nav>
            }
        </div>

        @if (Model.YearlyGoals.Any())
        {
            <div class="mv-goal-grid">
                @foreach (var goal in Model.YearlyGoals)
                {
                    var goalYear = goal.TargetYear ?? currentYear;
                    var linkedEmployeeCount = Model.ActiveEmployeeCounts.GetValueOrDefault(goal.Id);
                    var yearStatusClass = goalYear == currentYear ? "current" : goalYear > currentYear ? "upcoming" : "past";
                    var yearStatusLabel = goalYear == currentYear ? "Năm hiện tại" : goalYear > currentYear ? "Sắp tới" : "Đã qua";
                    var yearStatusIcon = goalYear == currentYear ? "bi-calendar-check" : goalYear > currentYear ? "bi-hourglass-split" : "bi-archive";

                    <article class="mv-goal-card">
                        <div>
                            <div class="mv-goal-card__header">
                                <span class="mv-year-chip"><i class="bi bi-calendar3" aria-hidden="true"></i>Năm @goalYear</span>
                                @if (canManageMission)
                                {
                                    <div class="dropdown">
                                        <button class="btn mv-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tùy chọn mục tiêu năm @goalYear, mã @goal.Id" title="Tùy chọn mục tiêu">
                                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            @if (Model.CanEditMission)
                                            {
                                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@goal.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Chỉnh sửa</a></li>
                                            }
                                            @if (Model.CanDeleteMission)
                                            {
                                                <li>
                                                    @if (linkedEmployeeCount > 0)
                                                    {
                                                        <span class="dropdown-item-text mv-disabled-action" title="Hãy chuyển nhân viên sang mục tiêu khác trước">
                                                            <i class="bi bi-lock me-2" aria-hidden="true"></i>Đang được sử dụng
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="Delete" asp-route-id="@goal.Id" method="post"
                                                              data-app-confirm
                                                              data-confirm-title="Vô hiệu hóa mục tiêu chiến lược?"
                                                              data-confirm-message="Mục tiêu năm @goalYear sẽ ngừng hoạt động. Hệ thống vẫn giữ dữ liệu lịch sử để đối chiếu."
                                                              data-confirm-tone="warning"
                                                              data-confirm-label="Vô hiệu hóa">
                                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-archive me-2" aria-hidden="true"></i>Vô hiệu hóa</button>
                                                        </form>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                            <h3>@goal.Content</h3>
                            @if (linkedEmployeeCount > 0)
                            {
                                <span class="mv-linked-employees" title="Mục tiêu này chưa thể vô hiệu hóa">
                                    <i class="bi bi-people" aria-hidden="true"></i>
                                    @linkedEmployeeCount nhân viên đang theo mục tiêu
                                </span>
                            }
                        </div>
                        <div class="mv-goal-card__footer">
                            <div class="mv-goal-finance">
                                <span>Mục tiêu tài chính</span>
                                <strong>@(goal.FinancialTarget.HasValue ? String.Format("{0:N0} đ", goal.FinancialTarget.Value) : "Chưa đặt")</strong>
                            </div>
                            <span class="mv-year-status mv-year-status--@yearStatusClass">
                                <i class="bi @yearStatusIcon" aria-hidden="true"></i>
                                @yearStatusLabel
                            </span>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="mv-empty-state">
                <div class="mv-empty-state__icon" aria-hidden="true"><i class="bi bi-flag"></i></div>
                <h3>@(Model.SelectedYear.HasValue ? $"Chưa có mục tiêu năm {Model.SelectedYear}" : "Chưa có mục tiêu chiến lược theo năm")</h3>
                <p>Thiết lập mục tiêu cụ thể để chuyển định hướng dài hạn thành kế hoạch hành động.</p>
                @if (Model.CanCreateMission)
                {
                    <a asp-action="Create" asp-route-type="@MissionVision.TypeYearlyGoal" class="btn btn-outline-primary mv-setup-action page-create-action">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Tạo mục tiêu</span>
                    </a>
                }
            </div>
        }
    </section>
</div>
