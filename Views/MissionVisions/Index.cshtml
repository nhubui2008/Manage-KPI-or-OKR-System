@model Manage_KPI_or_OKR_System.Models.ViewModels.MissionVisionIndexViewModel
@{
    ViewData["Title"] = "Sứ mệnh & Tầm nhìn";
    var currentYear = DateTime.Now.Year;
    var visionStatement = Model.LongTermStatements.FirstOrDefault(item => item.MissionVisionType == MissionVision.TypeVision);
    var missionStatement = Model.LongTermStatements.FirstOrDefault(item => item.MissionVisionType == MissionVision.TypeMission);
    var foundationCount = (visionStatement != null ? 1 : 0) + (missionStatement != null ? 1 : 0);
    var hasFinancialTargets = Model.YearlyGoals.Any(goal => goal.FinancialTarget.HasValue);
    var financialTargetTotal = Model.YearlyGoals.Sum(goal => goal.FinancialTarget ?? 0);
    var viewedYearLabel = Model.ShowAllYears ? "Tất cả" : Model.SelectedYear?.ToString() ?? "Chưa có";
    var canManageMission = Model.CanEditMission || Model.CanDeleteMission;
}

<div class="mission-vision-index">
    <header class="mv-page-header">
        <div>
            <h1>Định hướng chiến lược</h1>
            <nav class="mv-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Sứ mệnh &amp; Tầm nhìn</span>
            </nav>
        </div>
        @if (Model.CanCreateMission)
        {
            <a asp-action="Create" asp-route-type="@MissionVision.TypeYearlyGoal" class="btn btn-primary mv-primary-action">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Thêm mục tiêu</span>
            </a>
        }
    </header>

    <section class="mv-summary" aria-label="Tổng quan định hướng chiến lược">
        <div class="mv-summary__item">
            <span class="mv-summary__label">Nền tảng dài hạn</span>
            <strong class="mv-summary__value">@foundationCount/2</strong>
        </div>
        <div class="mv-summary__item">
            <span class="mv-summary__label">Mục tiêu đang xem</span>
            <strong class="mv-summary__value">@Model.YearlyGoals.Count</strong>
        </div>
        <div class="mv-summary__item">
            <span class="mv-summary__label">Mục tiêu tài chính</span>
            <strong class="mv-summary__value mv-summary__value--money">
                @(hasFinancialTargets ? String.Format("{0:N0} đ", financialTargetTotal) : "Chưa đặt")
            </strong>
        </div>
        <div class="mv-summary__item">
            <span class="mv-summary__label">Năm đang xem</span>
            <strong class="mv-summary__value">@viewedYearLabel</strong>
        </div>
    </section>

    <section class="mv-section" aria-labelledby="mv-foundation-heading">
        <div class="mv-section-header">
            <div>
                <span class="mv-section-kicker">Định hướng dài hạn</span>
                <h2 id="mv-foundation-heading">Tầm nhìn và Sứ mệnh</h2>
            </div>
            <span class="mv-section-count">@foundationCount/2 đã thiết lập</span>
        </div>

        <div class="mv-foundation-grid">
            @if (visionStatement != null)
            {
                <article class="mv-foundation-card mv-foundation-card--vision">
                    <div class="mv-foundation-card__header">
                        <div class="mv-foundation-card__identity">
                            <span class="mv-foundation-card__icon" aria-hidden="true"><i class="bi bi-compass"></i></span>
                            <div>
                                <span class="mv-foundation-card__type">Tầm nhìn</span>
                                <span class="mv-foundation-card__meta">Đích đến dài hạn</span>
                            </div>
                        </div>
                        @if (canManageMission)
                        {
                            <div class="dropdown">
                                <button class="btn mv-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tùy chọn Tầm nhìn" title="Tùy chọn Tầm nhìn">
                                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (Model.CanEditMission)
                                    {
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@visionStatement.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Chỉnh sửa</a></li>
                                    }
                                    @if (Model.CanDeleteMission)
                                    {
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@visionStatement.Id" method="post" onsubmit="return confirm('Vô hiệu hóa Tầm nhìn này?');">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-archive me-2" aria-hidden="true"></i>Vô hiệu hóa</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    <h3>@visionStatement.Content</h3>
                    <div class="mv-foundation-card__footer">
                        <span>Mục tiêu tài chính dài hạn</span>
                        <strong>@(visionStatement.FinancialTarget.HasValue ? String.Format("{0:N0} đ", visionStatement.FinancialTarget.Value) : "Chưa đặt")</strong>
                    </div>
                </article>
            }
            else
            {
                <article class="mv-foundation-card mv-foundation-card--empty mv-foundation-card--vision">
                    <div class="mv-foundation-card__identity">
                        <span class="mv-foundation-card__icon" aria-hidden="true"><i class="bi bi-compass"></i></span>
                        <div>
                            <span class="mv-foundation-card__type">Tầm nhìn</span>
                            <span class="mv-foundation-card__meta">Chưa thiết lập</span>
                        </div>
                    </div>
                    <h3>Doanh nghiệp muốn trở thành ai trong tương lai?</h3>
                    <p>Mô tả đích đến dài hạn mà toàn tổ chức cùng hướng tới.</p>
                    @if (Model.CanCreateMission)
                    {
                        <a asp-action="Create" asp-route-type="@MissionVision.TypeVision" class="btn btn-outline-primary mv-setup-action">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Thiết lập Tầm nhìn
                        </a>
                    }
                </article>
            }

            @if (missionStatement != null)
            {
                <article class="mv-foundation-card mv-foundation-card--mission">
                    <div class="mv-foundation-card__header">
                        <div class="mv-foundation-card__identity">
                            <span class="mv-foundation-card__icon" aria-hidden="true"><i class="bi bi-bullseye"></i></span>
                            <div>
                                <span class="mv-foundation-card__type">Sứ mệnh</span>
                                <span class="mv-foundation-card__meta">Giá trị cốt lõi</span>
                            </div>
                        </div>
                        @if (canManageMission)
                        {
                            <div class="dropdown">
                                <button class="btn mv-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tùy chọn Sứ mệnh" title="Tùy chọn Sứ mệnh">
                                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (Model.CanEditMission)
                                    {
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@missionStatement.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Chỉnh sửa</a></li>
                                    }
                                    @if (Model.CanDeleteMission)
                                    {
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@missionStatement.Id" method="post" onsubmit="return confirm('Vô hiệu hóa Sứ mệnh này?');">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-archive me-2" aria-hidden="true"></i>Vô hiệu hóa</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    <h3>@missionStatement.Content</h3>
                    <div class="mv-foundation-card__footer">
                        <span>Mục tiêu tài chính hỗ trợ</span>
                        <strong>@(missionStatement.FinancialTarget.HasValue ? String.Format("{0:N0} đ", missionStatement.FinancialTarget.Value) : "Chưa đặt")</strong>
                    </div>
                </article>
            }
            else
            {
                <article class="mv-foundation-card mv-foundation-card--empty mv-foundation-card--mission">
                    <div class="mv-foundation-card__identity">
                        <span class="mv-foundation-card__icon" aria-hidden="true"><i class="bi bi-bullseye"></i></span>
                        <div>
                            <span class="mv-foundation-card__type">Sứ mệnh</span>
                            <span class="mv-foundation-card__meta">Chưa thiết lập</span>
                        </div>
                    </div>
                    <h3>Doanh nghiệp tồn tại để tạo ra giá trị gì?</h3>
                    <p>Nêu đối tượng phục vụ, giá trị mang lại và lý do tồn tại.</p>
                    @if (Model.CanCreateMission)
                    {
                        <a asp-action="Create" asp-route-type="@MissionVision.TypeMission" class="btn btn-outline-primary mv-setup-action">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Thiết lập Sứ mệnh
                        </a>
                    }
                </article>
            }
        </div>
    </section>

    <section class="mv-section" aria-labelledby="mv-yearly-heading">
        <div class="mv-yearly-toolbar">
            <div>
                <span class="mv-section-kicker">Kế hoạch chiến lược</span>
                <h2 id="mv-yearly-heading">Mục tiêu theo năm</h2>
            </div>
            @if (Model.AvailableYears.Any())
            {
                <nav class="mv-year-filter" aria-label="Lọc mục tiêu theo năm">
                    <a asp-action="Index" asp-route-allYears="true" class="@(Model.ShowAllYears ? "active" : null)" aria-current="@(Model.ShowAllYears ? "page" : null)">Tất cả</a>
                    @foreach (var year in Model.AvailableYears)
                    {
                        var isSelectedYear = !Model.ShowAllYears && Model.SelectedYear == year;
                        <a asp-action="Index" asp-route-year="@year" class="@(isSelectedYear ? "active" : null)" aria-current="@(isSelectedYear ? "page" : null)">@year</a>
                    }
                </nav>
            }
        </div>

        @if (Model.YearlyGoals.Any())
        {
            <div class="mv-goal-grid">
                @foreach (var goal in Model.YearlyGoals)
                {
                    var goalYear = goal.TargetYear ?? currentYear;
                    var yearStatusClass = goalYear == currentYear ? "current" : goalYear > currentYear ? "upcoming" : "past";
                    var yearStatusLabel = goalYear == currentYear ? "Năm hiện tại" : goalYear > currentYear ? "Sắp tới" : "Đã qua";
                    var yearStatusIcon = goalYear == currentYear ? "bi-calendar-check" : goalYear > currentYear ? "bi-hourglass-split" : "bi-archive";

                    <article class="mv-goal-card">
                        <div class="mv-goal-card__header">
                            <span class="mv-year-chip"><i class="bi bi-calendar3" aria-hidden="true"></i>Năm @goalYear</span>
                            @if (canManageMission)
                            {
                                <div class="dropdown">
                                    <button class="btn mv-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tùy chọn mục tiêu năm @goalYear" title="Tùy chọn mục tiêu">
                                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        @if (Model.CanEditMission)
                                        {
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@goal.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Chỉnh sửa</a></li>
                                        }
                                        @if (Model.CanDeleteMission)
                                        {
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@goal.Id" method="post" onsubmit="return confirm('Vô hiệu hóa mục tiêu chiến lược năm @goalYear?');">
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-archive me-2" aria-hidden="true"></i>Vô hiệu hóa</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                        <h3>@goal.Content</h3>
                        <div class="mv-goal-card__footer">
                            <div class="mv-goal-finance">
                                <span>Mục tiêu tài chính</span>
                                <strong>@(goal.FinancialTarget.HasValue ? String.Format("{0:N0} đ", goal.FinancialTarget.Value) : "Chưa đặt")</strong>
                            </div>
                            <span class="mv-year-status mv-year-status--@yearStatusClass">
                                <i class="bi @yearStatusIcon" aria-hidden="true"></i>
                                @yearStatusLabel
                            </span>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="mv-empty-state">
                <span class="mv-empty-state__icon" aria-hidden="true"><i class="bi bi-flag"></i></span>
                <div>
                    <h3>@(Model.SelectedYear.HasValue ? $"Chưa có mục tiêu năm {Model.SelectedYear}" : "Chưa có mục tiêu chiến lược theo năm")</h3>
                    <p>Thiết lập mục tiêu cụ thể để chuyển định hướng dài hạn thành kế hoạch hành động.</p>
                </div>
                @if (Model.CanCreateMission)
                {
                    <a asp-action="Create" asp-route-type="@MissionVision.TypeYearlyGoal" class="btn btn-outline-primary mv-setup-action">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        Thêm mục tiêu
                    </a>
                }
            </div>
        }
    </section>
</div>

<style>
    .mission-vision-index {
        --mv-border: #dde3ec;
        --mv-text: #172033;
        --mv-muted: #64748b;
        --mv-surface: #ffffff;
        --mv-soft: #f7f9fc;
        color: var(--mv-text);
        letter-spacing: 0;
    }

    .mv-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 4px 0 20px;
        margin-bottom: 20px;
        border-bottom: 1px solid var(--mv-border);
    }

    .mv-page-header h1 {
        margin: 0 0 6px;
        color: var(--mv-text);
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .mv-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--mv-muted);
        font-size: 0.86rem;
    }

    .mv-breadcrumb a {
        color: var(--mv-muted);
        text-decoration: none;
    }

    .mv-breadcrumb i {
        font-size: 0.68rem;
    }

    .mv-primary-action,
    .mv-setup-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 8px;
        font-weight: 700;
        white-space: nowrap;
    }

    .mv-primary-action {
        min-height: 42px;
        padding: 9px 16px;
        box-shadow: none;
    }

    .mv-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-bottom: 28px;
        overflow: hidden;
        border: 1px solid var(--mv-border);
        border-radius: 8px;
        background: var(--mv-surface);
    }

    .mv-summary__item {
        min-width: 0;
        padding: 15px 18px;
        border-right: 1px solid var(--mv-border);
    }

    .mv-summary__item:last-child {
        border-right: 0;
    }

    .mv-summary__label,
    .mv-summary__value {
        display: block;
    }

    .mv-summary__label {
        margin-bottom: 5px;
        color: var(--mv-muted);
        font-size: 0.76rem;
        font-weight: 700;
    }

    .mv-summary__value {
        overflow-wrap: anywhere;
        color: var(--mv-text);
        font-size: 1.12rem;
        font-weight: 800;
        line-height: 1.25;
    }

    .mv-summary__value--money {
        font-size: 1rem;
    }

    .mv-section {
        margin-bottom: 32px;
    }

    .mv-section-header,
    .mv-yearly-toolbar {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 14px;
    }

    .mv-section-kicker {
        display: block;
        margin-bottom: 3px;
        color: var(--mv-muted);
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .mv-section h2 {
        margin: 0;
        color: var(--mv-text);
        font-size: 1.28rem;
        font-weight: 800;
        line-height: 1.25;
    }

    .mv-section-count {
        color: var(--mv-muted);
        font-size: 0.82rem;
        font-weight: 700;
    }

    .mv-foundation-grid,
    .mv-goal-grid {
        display: grid;
        gap: 16px;
    }

    .mv-foundation-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mv-foundation-card,
    .mv-goal-card {
        min-width: 0;
        border: 1px solid var(--mv-border);
        border-radius: 8px;
        background: var(--mv-surface);
    }

    .mv-foundation-card {
        min-height: 220px;
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 20px;
        border-top-width: 3px;
    }

    .mv-foundation-card--vision {
        border-top-color: #2563eb;
    }

    .mv-foundation-card--mission {
        border-top-color: #0f766e;
    }

    .mv-foundation-card__header,
    .mv-goal-card__header,
    .mv-foundation-card__identity {
        display: flex;
        align-items: center;
    }

    .mv-foundation-card__header,
    .mv-goal-card__header {
        justify-content: space-between;
        gap: 12px;
    }

    .mv-foundation-card__identity {
        min-width: 0;
        gap: 12px;
    }

    .mv-foundation-card__icon,
    .mv-empty-state__icon {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 8px;
        font-size: 1.05rem;
    }

    .mv-foundation-card--vision .mv-foundation-card__icon {
        background: #eaf2ff;
        color: #1d4ed8;
    }

    .mv-foundation-card--mission .mv-foundation-card__icon {
        background: #e6f5f2;
        color: #0f766e;
    }

    .mv-foundation-card__type,
    .mv-foundation-card__meta {
        display: block;
    }

    .mv-foundation-card__type {
        color: var(--mv-text);
        font-size: 0.95rem;
        font-weight: 800;
    }

    .mv-foundation-card__meta {
        margin-top: 1px;
        color: var(--mv-muted);
        font-size: 0.75rem;
        font-weight: 650;
    }

    .mv-foundation-card h3,
    .mv-goal-card h3,
    .mv-empty-state h3 {
        overflow-wrap: anywhere;
        color: var(--mv-text);
        font-weight: 780;
    }

    .mv-foundation-card h3 {
        margin: 0;
        font-size: 1.15rem;
        line-height: 1.42;
    }

    .mv-foundation-card__footer {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 14px;
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid var(--mv-border);
    }

    .mv-foundation-card__footer span {
        color: var(--mv-muted);
        font-size: 0.75rem;
        font-weight: 700;
    }

    .mv-foundation-card__footer strong {
        color: var(--mv-text);
        font-size: 0.9rem;
        white-space: nowrap;
    }

    .mv-foundation-card--empty {
        justify-content: flex-start;
        border-style: dashed;
        background: var(--mv-soft);
    }

    .mv-foundation-card--empty h3 {
        margin-bottom: -8px;
    }

    .mv-foundation-card--empty p {
        margin: 0;
        color: var(--mv-muted);
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .mv-foundation-card--empty .mv-setup-action {
        align-self: flex-start;
        margin-top: auto;
    }

    .mv-icon-button {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--mv-muted);
    }

    .mv-icon-button:hover,
    .mv-icon-button:focus-visible {
        border-color: var(--mv-border);
        background: var(--mv-soft);
        color: var(--mv-text);
    }

    .mission-vision-index .dropdown-menu {
        border: 1px solid var(--mv-border);
        border-radius: 8px;
    }

    .mission-vision-index .dropdown-item {
        font-size: 0.86rem;
    }

    .mv-year-filter {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px;
        border: 1px solid var(--mv-border);
        border-radius: 8px;
        background: var(--mv-surface);
    }

    .mv-year-filter a {
        min-width: 48px;
        padding: 7px 10px;
        border-radius: 6px;
        color: var(--mv-muted);
        font-size: 0.8rem;
        font-weight: 750;
        text-align: center;
        text-decoration: none;
    }

    .mv-year-filter a:hover {
        background: var(--mv-soft);
        color: var(--mv-text);
    }

    .mv-year-filter a.active {
        background: #5b47d6;
        color: #ffffff;
    }

    .mv-goal-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mv-goal-card {
        min-height: 220px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 18px;
        transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .mv-goal-card:hover {
        border-color: #b9c3d3;
        box-shadow: 0 8px 22px rgba(23, 32, 51, 0.07);
    }

    .mv-year-chip,
    .mv-year-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 6px;
        font-size: 0.76rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .mv-year-chip {
        padding: 6px 9px;
        background: #eef2ff;
        color: #4338ca;
    }

    .mv-goal-card h3 {
        margin: 0;
        font-size: 1.03rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .mv-goal-card__footer {
        display: flex;
