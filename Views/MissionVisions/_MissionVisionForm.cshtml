@model Manage_KPI_or_OKR_System.Models.MissionVision

@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var formAction = isEdit ? "Edit" : "Create";
    int? formId = isEdit ? Model.Id : null;
    var isYearlyGoal = Model.MissionVisionType == MissionVision.TypeYearlyGoal;
    var returnYear = isYearlyGoal ? Model.TargetYear : null;
    var currentYear = DateTime.Now.Year;
    var pageTitle = isEdit ? "Chỉnh sửa định hướng" : "Thiết lập định hướng mới";
    var pageDescription = isEdit
        ? "Cập nhật nội dung đang áp dụng mà không làm gián đoạn liên kết chiến lược."
        : "Chọn đúng loại, nhập nội dung và lưu trong một luồng ngắn gọn.";
    var submitLabel = isEdit ? "Cập nhật" : "Lưu mục tiêu";
    var financialPreview = Model.FinancialTarget.HasValue
        ? String.Format("{0:N0} đ", Model.FinancialTarget.Value)
        : "Chưa đặt mục tiêu tài chính";
}

<div class="mv-form-page">
    <header class="mv-form-header">
        <div>
            <h1>@pageTitle</h1>
            <nav class="mv-form-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Sứ mệnh &amp; Tầm nhìn</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>@(isEdit ? "Chỉnh sửa" : "Thêm mới")</span>
            </nav>
            <p>@pageDescription</p>
        </div>
        <a asp-action="Index" asp-route-year="@returnYear" class="btn btn-outline-secondary mv-back-action">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại</span>
        </a>
    </header>

    <div class="mv-form-layout">
        <section class="mv-form-panel" aria-labelledby="mv-form-heading">
            <div class="mv-form-panel__heading">
                <div>
                    <h2 id="mv-form-heading">Thông tin chiến lược</h2>
                    <p>Các trường có dấu <span aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
                @if (isEdit)
                {
                    <span class="mv-record-id">Mã #@Model.Id</span>
                }
            </div>

            <form asp-action="@formAction" asp-route-id="@formId" method="post" id="missionVisionForm">
                @if (isEdit)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div asp-validation-summary="ModelOnly" class="mv-form-alert" role="alert"></div>

                <fieldset class="mv-form-section">
                    <legend>Loại thiết lập <span class="mv-required" aria-label="bắt buộc">*</span></legend>
                    <p class="mv-section-description">Loại mục tiêu quyết định cách hệ thống xử lý năm áp dụng và liên kết vận hành.</p>

                    <div class="mv-type-options">
                        <div class="mv-type-option">
                            <input asp-for="MissionVisionType" class="mv-type-input" type="radio" id="typeYearlyGoal" value="@MissionVision.TypeYearlyGoal" />
                            <label for="typeYearlyGoal">
                                <span class="mv-type-option__icon mv-type-option__icon--year"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
                                <span>
                                    <strong>Mục tiêu theo năm</strong>
                                    <small>Cụ thể hóa chiến lược cho một năm.</small>
                                </span>
                            </label>
                        </div>
                        <div class="mv-type-option">
                            <input asp-for="MissionVisionType" class="mv-type-input" type="radio" id="typeVision" value="@MissionVision.TypeVision" />
                            <label for="typeVision">
                                <span class="mv-type-option__icon mv-type-option__icon--vision"><i class="bi bi-compass" aria-hidden="true"></i></span>
                                <span>
                                    <strong>Tầm nhìn</strong>
                                    <small>Mô tả đích đến dài hạn.</small>
                                </span>
                            </label>
                        </div>
                        <div class="mv-type-option">
                            <input asp-for="MissionVisionType" class="mv-type-input" type="radio" id="typeMission" value="@MissionVision.TypeMission" />
                            <label for="typeMission">
                                <span class="mv-type-option__icon mv-type-option__icon--mission"><i class="bi bi-bullseye" aria-hidden="true"></i></span>
                                <span>
                                    <strong>Sứ mệnh</strong>
                                    <small>Nêu lý do tồn tại và giá trị tạo ra.</small>
                                </span>
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="MissionVisionType" class="mv-validation-message"></span>
                    <p id="inputModeHint" class="mv-field-hint"></p>
                </fieldset>

                <section class="mv-form-section" aria-labelledby="contentLabel">
                    <div class="mv-field-label-row">
                        <label asp-for="Content" id="contentLabel">
                            <span id="contentLabelText">Nội dung chiến lược</span>
                            <span class="mv-required" aria-label="bắt buộc">*</span>
                        </label>
                        <output id="contentCounter" for="missionContent">@((Model.Content ?? String.Empty).Length)/1000</output>
                    </div>
                    <textarea asp-for="Content"
                              id="missionContent"
                              class="form-control mv-textarea"
                              rows="6"
                              maxlength="1000"
                              aria-describedby="contentHint contentCounter"
                              required></textarea>
                    <span asp-validation-for="Content" class="mv-validation-message"></span>
                    <p id="contentHint" class="mv-field-hint"></p>
                </section>

                <section class="mv-form-section mv-form-section--compact" aria-label="Thông tin đo lường">
                    <div class="mv-field-grid">
                        <div class="mv-field">
                            <label asp-for="FinancialTarget" id="financialTargetLabel">Mục tiêu tài chính (VNĐ)</label>
                            <div class="mv-input-with-icon">
                                <i class="bi bi-cash-coin" aria-hidden="true"></i>
                                <input asp-for="FinancialTarget"
                                       type="number"
                                       step="1"
                                       min="0"
                                       max="9999999999999999"
                                       inputmode="numeric"
                                       id="financialTargetInput"
                                       class="form-control"
                                       placeholder="Ví dụ: 50000000000"
                                       aria-describedby="financialPreview" />
                            </div>
                            <span asp-validation-for="FinancialTarget" class="mv-validation-message"></span>
                            <p id="financialPreview" class="mv-money-preview" aria-live="polite">@financialPreview</p>
                        </div>

                        <div class="mv-field @(isYearlyGoal ? String.Empty : "is-hidden")" id="targetYearWrapper" aria-hidden="@(!isYearlyGoal)">
                            <label asp-for="TargetYear">Năm áp dụng <span class="mv-required" aria-label="bắt buộc">*</span></label>
                            <div class="mv-input-with-icon">
                                <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                <input asp-for="TargetYear"
                                       type="number"
                                       step="1"
                                       min="2000"
                                       max="2100"
                                       inputmode="numeric"
                                       id="targetYearInput"
                                       class="form-control"
                                       aria-describedby="targetYearHint" />
                            </div>
                            <span asp-validation-for="TargetYear" class="mv-validation-message"></span>
                            <p id="targetYearHint" class="mv-field-hint">Chỉ áp dụng cho mục tiêu chiến lược theo năm.</p>
                        </div>
                    </div>
                </section>

                <div class="mv-form-actions">
                    <a asp-action="Index" asp-route-year="@returnYear" class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary" id="submitMissionVision">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span id="submitMissionVisionText">@submitLabel</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="mv-form-guide" aria-labelledby="guideTitle">
            <div class="mv-form-guide__identity">
                <span class="mv-form-guide__icon" aria-hidden="true"><i id="guideIcon" class="bi bi-calendar-check"></i></span>
                <div>
                    <span id="guideBadge" class="mv-form-guide__badge">Mục tiêu theo năm</span>
                    <h2 id="guideTitle">Kết quả cần đạt</h2>
                </div>
            </div>
            <p id="guideDescription">Viết một kết quả cụ thể mà tổ chức cần đạt trong năm đã chọn.</p>

            <ul class="mv-form-guide__checks">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span id="guideCheckOne">Nội dung đủ rõ để liên kết với OKR.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span id="guideCheckTwo">Năm áp dụng nằm trong khoảng 2000-2100.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Mục tiêu tài chính có thể để trống.</span></li>
            </ul>

            <div class="mv-form-guide__note">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <p id="guideRule">Mục tiêu theo năm có thể tạo nhiều bản ghi cho cùng một năm.</p>
            </div>
        </aside>
    </div>
</div>

<style>
    .mv-form-page {
        --mv-form-border: #e2e5ea;
        --mv-form-muted: #596273;
        --mv-form-soft: #f7f8fa;
        --mv-form-text: #151923;
        padding: 30px 32px 44px;
        color: var(--mv-form-text);
    }

    .mv-form-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        max-width: 1180px;
        margin: 0 auto 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--mv-form-border);
    }

    .mv-form-header h1 {
        margin: 0;
        font-size: 1.7rem;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: 0;
        text-wrap: balance;
    }

    .mv-form-header > div > p {
        max-width: 68ch;
        margin: 8px 0 0;
        color: var(--mv-form-muted);
        font-size: 0.88rem;
    }

    .mv-form-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 5px;
        color: var(--mv-form-muted);
        font-size: 0.8rem;
    }

    .mv-form-breadcrumb a {
        color: var(--mv-form-muted);
        text-decoration: none;
    }

    .mv-form-breadcrumb a:hover {
        color: var(--primary-dark);
    }

    .mv-back-action {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 8px;
        white-space: nowrap;
    }

    .mv-form-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        align-items: start;
        gap: 20px;
        max-width: 1180px;
        margin: 0 auto;
    }

    .mv-form-panel,
    .mv-form-guide {
        border: 1px solid var(--mv-form-border);
        border-radius: 8px;
        background: #ffffff;
    }

    .mv-form-panel__heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 20px 22px;
        border-bottom: 1px solid var(--mv-form-border);
    }

    .mv-form-panel__heading h2,
    .mv-form-guide h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: 0;
    }

    .mv-form-panel__heading p {
        margin: 3px 0 0;
        color: var(--mv-form-muted);
        font-size: 0.78rem;
    }

    .mv-record-id {
        flex: 0 0 auto;
        padding: 5px 8px;
        border-radius: 6px;
        background: var(--mv-form-soft);
        color: var(--mv-form-muted);
        font-size: 0.75rem;
        font-weight: 700;
    }

    #missionVisionForm {
        padding: 0 22px;
    }

    .mv-form-alert {
        margin: 18px 0 0;
        padding: 11px 13px;
        border: 1px solid var(--context-danger-border);
        border-radius: 8px;
        background: var(--context-danger-bg);
        color: var(--context-danger-text);
        font-size: 0.82rem;
    }

    .mv-form-alert:empty,
    .mv-form-alert.validation-summary-valid {
        display: none;
    }

    .mv-form-alert ul {
        margin: 0;
        padding-left: 18px;
    }

    .mv-form-section {
        margin: 0;
        padding: 22px 0;
        border: 0;
        border-bottom: 1px solid var(--mv-form-border);
    }

    .mv-form-section legend,
    .mv-field label,
    .mv-field-label-row label {
        margin: 0;
        color: var(--mv-form-text);
        font-size: 0.84rem;
        font-weight: 800;
    }

    .mv-form-section legend {
        float: none;
        width: auto;
    }

    .mv-required {
        color: var(--danger);
    }

    .mv-section-description,
    .mv-field-hint,
    .mv-money-preview {
        color: var(--mv-form-muted);
        font-size: 0.78rem;
    }

    .mv-section-description {
        margin: 4px 0 14px;
    }

    .mv-field-hint,
    .mv-money-preview {
        margin: 7px 0 0;
    }

    .mv-money-preview {
        color: #137a3d;
        font-weight: 700;
    }

    .mv-type-options {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    .mv-type-option {
        position: relative;
        min-width: 0;
    }

    .mv-type-input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .mv-type-option label {
        min-height: 92px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px;
        border: 1px solid var(--mv-form-border);
        border-radius: 8px;
        background: #ffffff;
        cursor: pointer;
        transition: border-color 0.18s ease, background-color 0.18s ease;
    }

    .mv-type-option label:hover {
        border-color: #b9b0f4;
        background: #fbfaff;
    }

    .mv-type-input:checked + label {
        border-color: var(--primary);
        background: var(--primary-light);
    }

    .mv-type-input:focus-visible + label {
        outline: 3px solid rgba(123, 104, 238, 0.22);
        outline-offset: 2px;
    }

    .mv-type-option__icon,
    .mv-form-guide__icon {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
    }

    .mv-type-option__icon--year {
        background: #eef2ff;
        color: #4338ca;
    }

    .mv-type-option__icon--vision {
        background: #edf6fd;
        color: #006cae;
    }

    .mv-type-option__icon--mission {
        background: #e8f7f3;
        color: #167568;
    }

    .mv-type-option strong,
    .mv-type-option small {
        display: block;
    }

    .mv-type-option strong {
        color: var(--mv-form-text);
        font-size: 0.82rem;
        line-height: 1.35;
    }

    .mv-type-option small {
        margin-top: 4px;
        color: var(--mv-form-muted);
        font-size: 0.72rem;
        line-height: 1.45;
    }

    .mv-field-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 8px;
    }

    .mv-field-label-row output {
        color: var(--mv-form-muted);
        font-size: 0.74rem;
        font-weight: 700;
    }

    .mv-textarea,
    .mv-input-with-icon .form-control {
        border: 1px solid #cfd5dd;
        border-radius: 8px;
        color: var(--mv-form-text);
        font-size: 0.88rem;
    }

    .mv-textarea {
        min-height: 142px;
        padding: 12px 13px;
        line-height: 1.55;
        resize: vertical;
    }

    .mv-textarea::placeholder,
    .mv-input-with-icon .form-control::placeholder {
        color: #697386;
        opacity: 1;
    }

    .mv-textarea:focus,
    .mv-input-with-icon .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(123, 104, 238, 0.16);
    }

    .mv-validation-message {
        display: block;
        margin-top: 6px;
        color: var(--danger);
        font-size: 0.76rem;
        font-weight: 650;
    }

    .mv-validation-message:empty {
        display: none;
    }

    .mv-field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .mv-field {
        min-width: 0;
    }

    .mv-field label {
        display: block;
        margin-bottom: 8px;
    }

    .mv-field.is-hidden {
        display: none;
    }

    .mv-input-with-icon {
        position: relative;
    }

    .mv-input-with-icon > i {
        position: absolute;
        top: 50%;
        left: 13px;
        z-index: 1;
        color: #697386;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .mv-input-with-icon .form-control {
        min-height: 44px;
        padding-left: 39px;
    }

    .mv-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 18px 0 22px;
    }

    .mv-form-actions .btn {
        min-width: 112px;
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 8px;
        font-size: 0.84rem;
        font-weight: 750;
    }

    .mv-form-actions .btn-primary:disabled {
        cursor: wait;
        opacity: 0.72;
    }

    .mv-form-guide {
        position: sticky;
        top: 88px;
        padding: 18px;
        background: var(--mv-form-soft);
    }

    .mv-form-guide__identity {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .mv-form-guide__icon {
        background: var(--primary-light);
        color: #5b42d6;
    }

    .mv-form-guide__badge {
        display: block;
        margin-bottom: 2px;
        color: #5b42d6;
        font-size: 0.72rem;
        font-weight: 800;
    }

    .mv-form-guide > p {
        margin: 15px 0;
        color: var(--mv-form-muted);
        font-size: 0.82rem;
        line-height: 1.55;
    }

    .mv-form-guide__checks {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .mv-form-guide__checks li {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        color: #3f4858;
        font-size: 0.78rem;
        line-height: 1.5;
    }

    .mv-form-guide__checks i {
        flex: 0 0 auto;
        margin-top: 1px;
        color: #137a3d;
        font-size: 1rem;
    }

    .mv-form-guide__note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 16px;
        padding: 11px;
        border: 1px solid #d8dce3;
        border-radius: 8px;
        background: #ffffff;
        color: #4f5868;
    }

    .mv-form-guide__note i {
        flex: 0 0 auto;
        color: #006cae;
    }

    .mv-form-guide__note p {
        margin: 0;
        font-size: 0.75rem;
        line-height: 1.5;
    }

    @@media (max-width: 991.98px) {
        .mv-form-layout {
            grid-template-columns: minmax(0, 1fr);
        }

        .mv-form-guide {
            position: static;
        }

        .mv-form-guide__checks {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .mv-form-page {
            padding: 22px 14px 32px;
        }

        .mv-form-header {
            align-items: stretch;
            flex-direction: column;
            gap: 14px;
        }

        .mv-form-header h1 {
            font-size: 1.45rem;
        }

        .mv-back-action {
            align-self: flex-start;
        }

        .mv-type-options,
        .mv-field-grid,
        .mv-form-guide__checks {
            grid-template-columns: minmax(0, 1fr);
        }

        .mv-type-option label {
            min-height: 0;
        }

        .mv-field-label-row {
            align-items: flex-start;
        }

        .mv-field-label-row output {
            margin-right: 48px;
        }

        .mv-form-panel__heading,
        #missionVisionForm {
            padding-left: 12px;
            padding-right: 12px;
        }

        .mv-form-actions {
            align-items: stretch;
            flex-direction: column-reverse;
        }

        .mv-form-actions .btn {
            width: 100%;
        }

        .ai-chat-toggle {
            width: 44px !important;
            height: 44px !important;
            right: 8px !important;
            bottom: 8px !important;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .mv-type-option label {
            transition: none;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('missionVisionForm');
        if (!form) return;

        const currentYear = '@currentYear';
        const typeInputs = Array.from(form.querySelectorAll('input[name="MissionVisionType"]'));
        const contentLabelText = document.getElementById('contentLabelText');
        const contentInput = document.getElementById('missionContent');
        const contentHint = document.getElementById('contentHint');
        const contentCounter = document.getElementById('contentCounter');
        const inputModeHint = document.getElementById('inputModeHint');
        const financialTargetLabel = document.getElementById('financialTargetLabel');
        const financialTargetInput = document.getElementById('financialTargetInput');
        const financialPreview = document.getElementById('financialPreview');
        const targetYearWrapper = document.getElementById('targetYearWrapper');
        const targetYearInput = document.getElementById('targetYearInput');
        const guideIcon = document.getElementById('guideIcon');
        const guideBadge = document.getElementById('guideBadge');
        const guideTitle = document.getElementById('guideTitle');
        const guideDescription = document.getElementById('guideDescription');
        const guideCheckOne = document.getElementById('guideCheckOne');
        const guideCheckTwo = document.getElementById('guideCheckTwo');
        const guideRule = document.getElementById('guideRule');
        const submitButton = document.getElementById('submitMissionVision');
        const submitText = document.getElementById('submitMissionVisionText');
        let rememberedYear = targetYearInput.value || currentYear;

        const configs = {
            '@MissionVision.TypeYearlyGoal': {
                label: 'Nội dung mục tiêu chiến lược',
                placeholder: 'Ví dụ: Chuẩn hóa chất lượng và giao hàng đúng hạn trên toàn chuỗi cung ứng...',
                hint: 'Nêu kết quả cụ thể, có thể theo dõi và liên kết với OKR trong năm.',
                modeHint: 'Cần chọn năm áp dụng; mục tiêu tài chính là tùy chọn.',
                financialLabel: 'Mục tiêu tài chính năm (VNĐ)',
                showYear: true,
                icon: 'bi-calendar-check',
                badge: 'Mục tiêu theo năm',
                title: 'Kết quả cần đạt',
                description: 'Viết một kết quả cụ thể mà tổ chức cần đạt trong năm đã chọn.',
                checkOne: 'Nội dung đủ rõ để liên kết với OKR.',
                checkTwo: 'Năm áp dụng nằm trong khoảng 2000-2100.',
                rule: 'Có thể tạo nhiều mục tiêu chiến lược cho cùng một năm.'
            },
            '@MissionVision.TypeVision': {
                label: 'Nội dung tầm nhìn',
                placeholder: 'Ví dụ: Trở thành thương hiệu thực phẩm được tin chọn tại các kênh bán lẻ trọng điểm...',
                hint: 'Mô tả trạng thái tương lai dài hạn mà toàn tổ chức cùng hướng tới.',
                modeHint: 'Không cần năm áp dụng; hệ thống chỉ cho phép một Tầm nhìn đang hoạt động.',
                financialLabel: 'Mục tiêu tài chính dài hạn (VNĐ)',
                showYear: false,
                icon: 'bi-compass',
                badge: 'Tầm nhìn',
                title: 'Đích đến dài hạn',
                description: 'Diễn đạt doanh nghiệp muốn trở thành ai trong tương lai, ngắn gọn và dễ nhớ.',
                checkOne: 'Tập trung vào trạng thái tương lai mong muốn.',
                checkTwo: 'Không gắn với một năm vận hành cụ thể.',
                rule: 'Hệ thống chỉ duy trì một Tầm nhìn đang hoạt động.'
            },
            '@MissionVision.TypeMission': {
                label: 'Nội dung sứ mệnh',
                placeholder: 'Ví dụ: Tạo ra sản phẩm an toàn, minh bạch và thuận tiện cho người tiêu dùng...',
                hint: 'Nêu đối tượng phục vụ, giá trị mang lại và lý do doanh nghiệp tồn tại.',
                modeHint: 'Không cần năm áp dụng; hệ thống chỉ cho phép một Sứ mệnh đang hoạt động.',
                financialLabel: 'Mục tiêu tài chính hỗ trợ (VNĐ)',
                showYear: false,
                icon: 'bi-bullseye',
                badge: 'Sứ mệnh',
                title: 'Giá trị cốt lõi',
                description: 'Làm rõ doanh nghiệp phục vụ ai, tạo ra giá trị gì và vì sao điều đó quan trọng.',
                checkOne: 'Nêu rõ đối tượng hoặc nhu cầu được phục vụ.',
                checkTwo: 'Thể hiện giá trị bền vững của tổ chức.',
                rule: 'Hệ thống chỉ duy trì một Sứ mệnh đang hoạt động.'
            }
        };

        function selectedType() {
            const selected = typeInputs.find(function (input) { return input.checked; });
            return selected ? selected.value : '@MissionVision.TypeYearlyGoal';
        }

        function applyTypeConfig() {
            const config = configs[selectedType()] || configs['@MissionVision.TypeYearlyGoal'];

            contentLabelText.textContent = config.label;
            contentInput.placeholder = config.placeholder;
            contentHint.textContent = config.hint;
            inputModeHint.textContent = config.modeHint;
            financialTargetLabel.textContent = config.financialLabel;
            guideIcon.className = 'bi ' + config.icon;
            guideBadge.textContent = config.badge;
            guideTitle.textContent = config.title;
            guideDescription.textContent = config.description;
            guideCheckOne.textContent = config.checkOne;
            guideCheckTwo.textContent = config.checkTwo;
            guideRule.textContent = config.rule;

            if (config.showYear) {
                targetYearWrapper.classList.remove('is-hidden');
                targetYearWrapper.setAttribute('aria-hidden', 'false');
                targetYearInput.disabled = false;
                targetYearInput.required = true;
                targetYearInput.value = targetYearInput.value || rememberedYear || currentYear;
            } else {
                if (targetYearInput.value) rememberedYear = targetYearInput.value;
                targetYearWrapper.classList.add('is-hidden');
                targetYearWrapper.setAttribute('aria-hidden', 'true');
                targetYearInput.required = false;
                targetYearInput.disabled = true;
                targetYearInput.value = '';
            }
        }

        function updateContentCounter() {
            const length = contentInput.value.length;
            contentCounter.textContent = length + '/1000';
            contentCounter.classList.toggle('text-danger', length >= 950);
        }

        function updateFinancialPreview() {
            const rawValue = financialTargetInput.value.trim();
            if (!rawValue) {
                financialPreview.textContent = 'Chưa đặt mục tiêu tài chính';
                return;
            }

            const isNegative = rawValue.startsWith('-');
            const digits = rawValue.replace(/\D/g, '');
            const formatted = digits.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            financialPreview.textContent = (isNegative ? '-' : '') + formatted + ' đ';
        }

        typeInputs.forEach(function (input) {
            input.addEventListener('change', applyTypeConfig);
        });
        contentInput.addEventListener('input', updateContentCounter);
        financialTargetInput.addEventListener('input', updateFinancialPreview);

        form.addEventListener('submit', function () {
            const passesNativeValidation = form.checkValidity();
            const passesUnobtrusiveValidation = !window.jQuery || !window.jQuery.validator || window.jQuery(form).valid();
            if (!passesNativeValidation || !passesUnobtrusiveValidation) return;

            submitButton.disabled = true;
            submitButton.setAttribute('aria-busy', 'true');
            submitText.textContent = '@(isEdit ? "Đang cập nhật..." : "Đang lưu...")';
        });

        applyTypeConfig();
        updateContentCounter();
        updateFinancialPreview();
    });
</script>
