@model Manage_KPI_or_OKR_System.Models.WorkProject
@{
    ViewData["Title"] = "Tạo dự án cộng tác";
    var employees = (ViewBag.Employees as IEnumerable<Employee> ?? Enumerable.Empty<Employee>()).ToList();
    var departments = (ViewBag.Departments as IEnumerable<Department> ?? Enumerable.Empty<Department>()).ToList();
    var okrs = (ViewBag.OKRs as IEnumerable<OKR> ?? Enumerable.Empty<OKR>()).ToList();
    var kpis = (ViewBag.KPIs as IEnumerable<KPI> ?? Enumerable.Empty<KPI>()).ToList();
    var priorities = ViewBag.PriorityOptions as IEnumerable<string> ?? Enumerable.Empty<string>();
    var selectedDepartmentIds = (ViewBag.SelectedDepartmentIds as IEnumerable<int> ?? Enumerable.Empty<int>()).ToHashSet();
}

<div class="container-fluid p-0" data-create-form data-workproject-create>
    <div class="create-page-header">
        <div>
            <nav class="create-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Dự án cộng tác</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Tạo mới</span>
            </nav>
            <h1>Tạo dự án cộng tác</h1>
            <p class="text-muted mb-0">Thiết lập phạm vi, người phụ trách và liên kết mục tiêu để nhóm có thể bắt đầu vận hành trên Kanban.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Quay lại danh sách
        </a>
    </div>

    <form asp-action="Create" method="post" data-create-form-element>
        <div asp-validation-summary="All" role="alert" tabindex="-1" data-error-summary></div>

        <!-- Bố cục 8/4 Velzon -->
        <div class="row">
            <!-- Cột chính 8/12 -->
            <div class="col-lg-8">
                <!-- Card 1: Thông tin dự án -->
                <div class="vz-card">
                    <div class="vz-card-header">
                        <h2 class="vz-card-title">
                            <i class="bi bi-folder2-open text-primary" aria-hidden="true"></i> Thông tin cơ bản & Phạm vi
                        </h2>
                    </div>
                    <div class="vz-card-body">
                        <div class="mb-3">
                            <label asp-for="ProjectName" class="form-label">Tên dự án <span class="text-danger" aria-label="bắt buộc">*</span></label>
                            <input asp-for="ProjectName"
                                   class="form-control"
                                   maxlength="200"
                                   autocomplete="off"
                                   placeholder="Ví dụ: Chuẩn hóa quy trình giao hàng quý 3"
                                   aria-describedby="projectNameHint"
                                   required />
                            <span asp-validation-for="ProjectName" class="text-danger fs-7"></span>
                            <p id="projectNameHint" class="form-hint">Tối đa 200 ký tự; mã dự án sẽ được hệ thống tự sinh sau khi lưu.</p>
                        </div>

                        <div class="mb-0">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Description" class="form-label mb-0">Mô tả phạm vi</label>
                                <output id="workProjectDescriptionCounter" class="form-hint fw-bold" for="Description" data-character-counter>0/1000</output>
                            </div>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Mục tiêu vận hành, đầu ra chính và lưu ý phối hợp..."
                                      aria-describedby="descriptionHint workProjectDescriptionCounter"></textarea>
                            <span asp-validation-for="Description" class="text-danger fs-7"></span>
                            <p id="descriptionHint" class="form-hint mb-0">Mô tả này cung cấp bối cảnh khi chia nhỏ công việc trên Kanban.</p>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Phân công & Thời gian -->
                <div class="vz-card">
                    <div class="vz-card-header">
                        <h2 class="vz-card-title">
                            <i class="bi bi-calendar-range text-primary" aria-hidden="true"></i> Trách nhiệm & Kế hoạch thực hiện
                        </h2>
                    </div>
                    <div class="vz-card-body">
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="OwnerId" class="form-label">Người phụ trách</label>
                                <select asp-for="OwnerId"
                                        class="form-select"
                                        data-placeholder="Chọn người phụ trách"
                                        disabled="@(!employees.Any())"
                                        aria-describedby="ownerHint">
                                    <option value="">Chưa gán người phụ trách</option>
                                    @foreach (var employee in employees)
                                    {
                                        <option value="@employee.Id">@employee.FullName</option>
                                    }
                                </select>
                                <p id="ownerHint" class="form-hint">Nếu để trống, dùng tài khoản tạo khi có thể.</p>
                                @if (!employees.Any())
                                {
                                    <div class="text-warning fs-7 mt-1" role="status">
                                        <i class="bi bi-person-x" aria-hidden="true"></i> Chưa có nhân viên đang hoạt động.
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Priority" class="form-label">Mức ưu tiên</label>
                                <select asp-for="Priority" class="form-select no-select2" aria-describedby="priorityHint">
                                    @foreach (var item in priorities)
                                    {
                                        <option value="@item">@PriorityLabel(item)</option>
                                    }
                                </select>
                                <p id="priorityHint" class="form-hint">Dùng để sắp xếp và ưu tiên xử lý.</p>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
                                <input asp-for="StartDate"
                                       asp-format="{0:yyyy-MM-dd}"
                                       class="form-control"
                                       type="date"
                                       lang="vi"
                                       aria-describedby="startDateHint" />
                                <p id="startDateHint" class="form-hint">Mặc định là ngày hiện tại.</p>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DueDate" class="form-label">Ngày kết thúc</label>
                                <input asp-for="DueDate"
                                       asp-format="{0:yyyy-MM-dd}"
                                       class="form-control"
                                       type="date"
                                       lang="vi"
                                       aria-describedby="dueDateHint" />
                                <span asp-validation-for="DueDate" class="text-danger fs-7"></span>
                                <p id="dueDateHint" class="form-hint">Không được trước ngày bắt đầu.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phụ 4/12 -->
            <div class="col-lg-4">
                <!-- Card 3: Mục tiêu & Phòng ban cộng tác -->
                <div class="vz-card">
                    <div class="vz-card-header">
                        <h2 class="vz-card-title">
                            <i class="bi bi-diagram-3 text-primary" aria-hidden="true"></i> Liên kết mục tiêu
                        </h2>
                    </div>
                    <div class="vz-card-body">
                        <div class="mb-3">
                            <label asp-for="SourceOKRId" class="form-label">OKR nguồn</label>
                            <select asp-for="SourceOKRId"
                                    class="form-select"
                                    data-placeholder="Không liên kết OKR"
                                    disabled="@(!okrs.Any())"
                                    aria-describedby="sourceOkrHint">
                                <option value="">Không liên kết OKR</option>
                                @foreach (var okr in okrs)
                                {
                                    <option value="@okr.Id">@OkrOptionLabel(okr)</option>
                                }
                            </select>
                            <span asp-validation-for="SourceOKRId" class="text-danger fs-7"></span>
                            <p id="sourceOkrHint" class="form-hint">Liên kết Objective hoặc Key Result nguồn.</p>
                        </div>

                        <div class="mb-0">
                            <label asp-for="SourceKPIId" class="form-label">KPI nguồn</label>
                            <select asp-for="SourceKPIId"
                                    class="form-select"
                                    data-placeholder="Không liên kết KPI"
                                    disabled="@(!kpis.Any())"
                                    aria-describedby="sourceKpiHint sourceRelationshipHint">
                                <option value="">Không liên kết KPI</option>
                                @foreach (var kpi in kpis)
                                {
                                    var linkedOkr = kpi.OKRId.HasValue ? okrs.FirstOrDefault(okr => okr.Id == kpi.OKRId.Value) : null;
                                    <option value="@kpi.Id"
                                            data-okr-id="@kpi.OKRId"
                                            data-okr-label="@(linkedOkr == null ? null : OkrOptionLabel(linkedOkr))">@KpiOptionLabel(kpi)</option>
                                }
                            </select>
                            <span asp-validation-for="SourceKPIId" class="text-danger fs-7"></span>
                            <p id="sourceKpiHint" class="form-hint">Nếu chọn KPI thuộc OKR, server sẽ tự nhận OKR đó.</p>
                            <p id="sourceRelationshipHint" class="form-hint fw-semibold text-success mt-1" aria-live="polite" data-source-relationship></p>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Phòng ban tham gia -->
                <div class="vz-card">
                    <div class="vz-card-header">
                        <h2 class="vz-card-title">
                            <i class="bi bi-building text-primary" aria-hidden="true"></i> Phòng ban cộng tác
                        </h2>
                        <output class="badge bg-light text-dark border" data-selection-count="departmentIds">0 đã chọn</output>
                    </div>
                    <div class="vz-card-body">
                        <p id="departmentHint" class="form-hint mb-2">Chọn các phòng ban được quyền truy cập và cộng tác trong dự án này.</p>
                        @if (departments.Any())
                        {
                            <div class="department-scroll-list">
                                @foreach (var department in departments)
                                {
                                    var checkboxId = $"department-{department.Id}";
                                    <div class="department-item">
                                        <input id="@checkboxId"
                                               type="checkbox"
                                               name="departmentIds"
                                               value="@department.Id"
                                               checked="@(selectedDepartmentIds.Contains(department.Id) ? "checked" : null)" />
                                        <label for="@checkboxId">@department.DepartmentName</label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted fs-7 py-2" role="status">
                                <i class="bi bi-building-x" aria-hidden="true"></i> Chưa có phòng ban đang hoạt động.
                            </div>
                        }
                        <span class="text-danger fs-7" data-valmsg-for="departmentIds" data-valmsg-replace="true"></span>
                    </div>
                </div>

                <!-- Card 5: Hướng dẫn sau khi lưu -->
                <div class="vz-info-callout mb-3">
                    <h6><i class="bi bi-info-circle me-1" aria-hidden="true"></i> Sau khi lưu dự án</h6>
                    <ul class="list-unstyled mb-0 fs-7 text-muted">
                        <li class="mb-1"><i class="bi bi-check2 text-success me-1" aria-hidden="true"></i> Trạng thái ban đầu: <strong>Đang chạy</strong> (Progress 0%).</li>
                        <li class="mb-1"><i class="bi bi-check2 text-success me-1" aria-hidden="true"></i> Mã dự án do server tự sinh.</li>
                        <li><i class="bi bi-check2 text-success me-1" aria-hidden="true"></i> Mở không gian Kanban ngay sau khi tạo thành công.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Action Area nằm ở cuối form -->
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-light">Hủy</a>
            <button type="submit"
                    class="btn btn-primary"
                    data-submit-button
                    data-default-label="Tạo dự án"
                    data-loading-label="Đang tạo...">
                <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                <span data-submit-label>Tạo dự án</span>
            </button>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workproject-create.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
    <script src="~/js/workproject-create.js" asp-append-version="true"></script>
}

@functions {
    private static string PriorityLabel(string? value) => value switch
    {
        "Low" => "Thấp",
        "High" => "Cao",
        "Urgent" => "Khẩn cấp",
        _ => "Bình thường"
    };

    private static string OkrOptionLabel(OKR okr)
    {
        var name = !string.IsNullOrWhiteSpace(okr.ObjectiveName) ? okr.ObjectiveName : $"OKR #{okr.Id}";
        return $"{name} (#{okr.Id})";
    }

    private static string KpiOptionLabel(KPI kpi)
    {
        var name = !string.IsNullOrWhiteSpace(kpi.KPIName) ? kpi.KPIName : $"KPI #{kpi.Id}";
        return $"{name} (#{kpi.Id})";
    }
}
