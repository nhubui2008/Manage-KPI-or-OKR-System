@model IEnumerable<Manage_KPI_or_OKR_System.Models.ViewModels.WorkProjectIndexItemViewModel>
@{
    ViewData["Title"] = "Dự án cộng tác";
    var projects = Model?.ToList() ?? new List<Manage_KPI_or_OKR_System.Models.ViewModels.WorkProjectIndexItemViewModel>();
    var today = DateTime.Today;
    var currentStatus = ViewData["StatusFilter"] as string;
    var currentPriority = ViewData["PriorityFilter"] as string;
    var currentSearch = ViewData["CurrentFilter"] as string;
    var currentQuickFilter = ViewData["QuickFilter"] as string ?? "";
    var currentSortBy = ViewData["SortBy"] as string ?? "risk";
    var statusOptions = ViewBag.StatusOptions as IEnumerable<string> ?? Enumerable.Empty<string>();
    var priorityOptions = ViewBag.PriorityOptions as IEnumerable<string> ?? Enumerable.Empty<string>();
    var hasActiveFilters = !string.IsNullOrWhiteSpace(currentSearch)
        || !string.IsNullOrWhiteSpace(currentStatus)
        || !string.IsNullOrWhiteSpace(currentPriority)
        || !string.IsNullOrWhiteSpace(currentQuickFilter)
        || !string.Equals(currentSortBy, "risk", StringComparison.OrdinalIgnoreCase);
    var totalProjects = projects.Count;
    var activeProjects = projects.Count(item => string.Equals(item.Project.Status ?? "Active", "Active", StringComparison.OrdinalIgnoreCase));
    var urgentProjects = projects.Count(item =>
        string.Equals(item.Project.Priority, "Urgent", StringComparison.OrdinalIgnoreCase)
        || string.Equals(item.Project.Priority, "High", StringComparison.OrdinalIgnoreCase));
    var blockedProjects = projects.Count(item => item.BlockedTasks > 0);
    var overdueProjects = projects.Count(item => item.OverdueTasks > 0 || IsProjectDateOverdue(item.Project.DueDate, item.Project.Status, today));
    var attentionProjects = projects.Count(item =>
        item.BlockedTasks > 0
        || item.OverdueTasks > 0
        || IsProjectDateOverdue(item.Project.DueDate, item.Project.Status, today));
}

<div class="container-fluid p-0 workprojects-page">
    <div class="workprojects-header">
        <div>
            <nav class="workprojects-breadcrumb" aria-label="Điều hướng">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Dự án cộng tác</span>
            </nav>
            <h1><i class="bi bi-kanban text-primary me-2" aria-hidden="true"></i>Dự án cộng tác</h1>
            <p class="text-muted mb-0">Quản lý dự án Agile/Kanban, giao việc theo phòng ban và theo dõi tiến độ tập trung.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary workprojects-create page-create-action">
            <i class="bi bi-plus-lg" aria-hidden="true"></i><span>Tạo dự án</span>
        </a>
    </div>

    <!-- Summary Cards theo phạm vi lọc hiện tại -->
    <section class="ops-summary" aria-label="Tóm tắt kết quả theo bộ lọc hiện tại">
        <div class="ops-summary__item ops-summary__item--primary">
            <div class="summary-head">
                <span>Tổng dự án trong lọc</span>
                <i class="bi bi-folder2 text-primary fs-5" aria-hidden="true"></i>
            </div>
            <strong>@totalProjects</strong>
            <small>Kết quả phù hợp hiện tại</small>
        </div>
        <div class="ops-summary__item">
            <div class="summary-head">
                <span>Đang hoạt động</span>
                <i class="bi bi-activity text-success fs-5" aria-hidden="true"></i>
            </div>
            <strong>@activeProjects</strong>
            <small>Đang triển khai trong lọc</small>
        </div>
        <div class="ops-summary__item ops-summary__item--warning">
            <div class="summary-head">
                <span>Cần chú ý</span>
                <i class="bi bi-exclamation-triangle text-warning fs-5" aria-hidden="true"></i>
            </div>
            <strong>@attentionProjects</strong>
            <small>@blockedProjects vướng · @overdueProjects trễ</small>
        </div>
        <div class="ops-summary__item ops-summary__item--danger">
            <div class="summary-head">
                <span>Quá hạn</span>
                <i class="bi bi-calendar-x text-danger fs-5" aria-hidden="true"></i>
            </div>
            <strong>@overdueProjects</strong>
            <small>Trễ hạn công việc/dự án</small>
        </div>
    </section>

    <!-- Filter Toolbar -->
    <form asp-action="Index" method="get" class="workprojects-filter">
        @if (!string.IsNullOrWhiteSpace(currentQuickFilter))
        {
            <input type="hidden" name="quickFilter" value="@currentQuickFilter" />
        }
        <div class="filter-grid">
            <div class="filter-field filter-field--search">
                <label for="workproject-search" class="form-label">Tìm nhanh</label>
                <div class="input-with-icon">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="workproject-search" type="text" name="searchString" value="@currentSearch" class="form-control" placeholder="Tìm theo tên, mã, người phụ trách, phòng ban..." />
                </div>
            </div>
            <div class="filter-field">
                <label for="workproject-status" class="form-label">Trạng thái</label>
                <select id="workproject-status" name="status" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var item in statusOptions)
                    {
                        <option value="@item" selected="@(item == currentStatus ? "selected" : null)">@ProjectStatusLabel(item)</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="workproject-priority" class="form-label">Ưu tiên</label>
                <select id="workproject-priority" name="priority" class="form-select">
                    <option value="">Tất cả mức ưu tiên</option>
                    @foreach (var item in priorityOptions)
                    {
                        <option value="@item" selected="@(item == currentPriority ? "selected" : null)">@PriorityLabel(item)</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="workproject-sort" class="form-label">Sắp xếp</label>
                <select id="workproject-sort" name="sortBy" class="form-select" data-allow-clear="false">
                    <option value="risk" selected="@(currentSortBy == "risk" ? "selected" : null)">Rủi ro trước</option>
                    <option value="updated" selected="@(currentSortBy == "updated" ? "selected" : null)">Mới cập nhật</option>
                    <option value="deadline" selected="@(currentSortBy == "deadline" ? "selected" : null)">Deadline gần</option>
                    <option value="low-progress" selected="@(currentSortBy == "low-progress" ? "selected" : null)">Tiến độ thấp</option>
                </select>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1" aria-hidden="true"></i> Lọc</button>
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" class="btn btn-light">Xóa lọc</a>
                }
            </div>
        </div>
        <div class="quick-filter-row" aria-label="Lọc nhanh dự án">
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" class="@(QuickFilterClass("", currentQuickFilter))"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Tất cả</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="mine" class="@(QuickFilterClass("mine", currentQuickFilter))"><i class="bi bi-person-check" aria-hidden="true"></i> Của tôi</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="overdue" class="@(QuickFilterClass("overdue", currentQuickFilter))"><i class="bi bi-calendar-x" aria-hidden="true"></i> Có việc trễ</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="blocked" class="@(QuickFilterClass("blocked", currentQuickFilter))"><i class="bi bi-slash-circle" aria-hidden="true"></i> Có việc vướng</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="urgent" class="@(QuickFilterClass("urgent", currentQuickFilter))"><i class="bi bi-exclamation-diamond" aria-hidden="true"></i> Khẩn cấp</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="unassigned-department" class="@(QuickFilterClass("unassigned-department", currentQuickFilter))"><i class="bi bi-diagram-3" aria-hidden="true"></i> Chưa gán phòng ban</a>
        </div>
    </form>

    <!-- Result Toolbar -->
    <div class="workprojects-result-bar">
        <div>
            <strong>@totalProjects</strong> dự án phù hợp kết quả lọc
            @if (hasActiveFilters)
            {
                <span class="text-muted">· đang áp dụng bộ lọc</span>
            }
        </div>
        <span class="result-hint">Sắp xếp: @SortLabel(currentSortBy)</span>
    </div>

    <!-- Grid 3/2/1 Project Cards -->
    <div class="workproject-grid">
        @foreach (var item in projects)
        {
            var progress = item.Project.ProgressPercentage ?? 0;
            var status = item.Project.Status ?? "Active";
            var priority = item.Project.Priority ?? "Normal";
            var isClosed = IsProjectClosed(status);
            var isArchived = string.Equals(status, "Archived", StringComparison.OrdinalIgnoreCase);
            var projectDateOverdue = IsProjectDateOverdue(item.Project.DueDate, status, today);
            var dueSoon = IsProjectDueSoon(item.Project.DueDate, status, today);
            var riskTone = ProjectRiskTone(item.BlockedTasks, item.OverdueTasks, projectDateOverdue, dueSoon, priority);
            var riskLabel = ProjectRiskLabel(item.BlockedTasks, item.OverdueTasks, projectDateOverdue, dueSoon, priority);
            var dueDateClass = projectDateOverdue ? "text-danger" : dueSoon ? "text-warning" : "";
            var description = !string.IsNullOrWhiteSpace(item.Project.Description) ? item.Project.Description : "Chưa có mô tả dự án.";
            var progressText = progress.ToString("0.##");
            var progressWidth = progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

            <article class="project-card project-card--@riskTone">
                <div class="project-card__top">
                    <div class="project-identity">
                        <div class="project-code-row">
                            <span class="project-code">@item.Project.ProjectCode</span>
                            <span class="status-pill status-@(status.ToLowerInvariant())">@ProjectStatusLabel(status)</span>
                        </div>
                        <h2 class="project-title" title="@item.Project.ProjectName">@item.Project.ProjectName</h2>
                    </div>
                    <div class="project-badges">
                        <span class="priority-badge priority-@(priority.ToLowerInvariant())">@PriorityLabel(priority)</span>
                        <span class="risk-pill risk-pill--@riskTone">@riskLabel</span>
                    </div>
                </div>

                <p class="project-desc" title="@description">@description</p>

                <div class="project-meta-grid">
                    <div class="meta-item">
                        <span><i class="bi bi-person-badge" aria-hidden="true"></i> Phụ trách</span>
                        <strong title="@item.OwnerName">@item.OwnerName</strong>
                    </div>
                    <div class="meta-item">
                        <span><i class="bi bi-diagram-3" aria-hidden="true"></i> Phòng ban</span>
                        <strong title="@item.DepartmentNames">@item.DepartmentNames</strong>
                    </div>
                    <div class="meta-item meta-item--due">
                        <span><i class="bi bi-calendar-event" aria-hidden="true"></i> Hạn</span>
                        <strong class="@dueDateClass">@(item.Project.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có hạn")</strong>
                    </div>
                </div>

                <div class="progress-block">
                    <div class="progress-head">
                        <span>Tiến độ</span>
                        <strong>@progressText%</strong>
                    </div>
                    <div class="progress" role="progressbar" aria-valuenow="@progressWidth" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ @progressText%">
                        <div class="progress-bar" style="width: @progressWidth%"></div>
                    </div>
                </div>

                <div class="project-stats" aria-label="Thống kê công việc">
                    <span><strong>@item.TotalTasks</strong> việc</span>
                    <span class="stat-done"><strong>@item.DoneTasks</strong> xong</span>
                    <span class="@(item.BlockedTasks > 0 ? "stat-danger" : "")"><strong>@item.BlockedTasks</strong> vướng</span>
                    <span class="@(item.OverdueTasks > 0 ? "stat-warning" : "")"><strong>@item.OverdueTasks</strong> trễ</span>
                </div>

                <div class="project-card__footer">
                    <span class="project-footnote">
                        @if (isClosed)
                        {
                            <i class="bi bi-check-circle" aria-hidden="true"></i>
                            <span>Đã đóng luồng vận hành</span>
                        }
                        else if (item.TotalTasks == 0)
                        {
                            <i class="bi bi-inbox" aria-hidden="true"></i>
                            <span>Chưa có task</span>
                        }
                        else
                        {
                            <i class="bi bi-activity" aria-hidden="true"></i>
                            <span>@(item.TotalTasks - item.DoneTasks) việc đang mở</span>
                        }
                    </span>
                    @if (isArchived)
                    {
                        <span class="btn btn-sm btn-outline-secondary project-card__archived-action" role="status">
                            <i class="bi bi-archive me-1" aria-hidden="true"></i> Đã lưu trữ
                        </span>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@item.Project.Id" class="btn btn-sm btn-primary">
                            Mở Kanban <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </article>
        }

        @if (!projects.Any())
        {
            <div class="empty-state">
                <i class="bi bi-kanban" aria-hidden="true"></i>
                <h5>Chưa có dự án phù hợp</h5>
                @if (hasActiveFilters)
                {
                    <p>Không tìm thấy dự án theo bộ lọc hiện tại. Hãy xóa lọc hoặc thử từ khóa khác.</p>
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm">Xóa lọc</a>
                }
                else
                {
                    <p>Tạo dự án đầu tiên để bắt đầu giao việc và cộng tác giữa các phòng ban.</p>
                    <a asp-action="Create" class="btn btn-primary btn-sm page-create-action"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Tạo dự án</span></a>
                }
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/workprojects.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/workprojects-index.js" asp-append-version="true"></script>
}

@functions {
    private static string PriorityLabel(string? value) => value switch
    {
        "Low" => "Thấp",
        "High" => "Cao",
        "Urgent" => "Khẩn cấp",
        _ => "Bình thường"
    };

    private static string ProjectStatusLabel(string? value) => value switch
    {
        "Planning" => "Lên kế hoạch",
        "OnHold" => "Tạm dừng",
        "Completed" => "Hoàn thành",
        "Archived" => "Lưu trữ",
        _ => "Đang chạy"
    };

    private static string SortLabel(string? value) => value switch
    {
        "updated" => "Mới cập nhật",
        "deadline" => "Deadline gần",
        "low-progress" => "Tiến độ thấp",
        _ => "Rủi ro trước"
    };

    private static string QuickFilterClass(string value, string? currentValue)
    {
        return string.Equals(value, currentValue ?? "", StringComparison.OrdinalIgnoreCase)
            ? "is-active"
            : "";
    }

    private static bool IsProjectClosed(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Archived", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsProjectDateOverdue(DateTime? dueDate, string? status, DateTime today)
    {
        return dueDate.HasValue && dueDate.Value.Date < today && !IsProjectClosed(status);
    }

    private static bool IsProjectDueSoon(DateTime? dueDate, string? status, DateTime today)
    {
        return dueDate.HasValue
            && dueDate.Value.Date >= today
            && dueDate.Value.Date <= today.AddDays(7)
            && !IsProjectClosed(status);
    }

    private static string ProjectRiskTone(int blockedTasks, int overdueTasks, bool dateOverdue, bool dueSoon, string? priority)
    {
        if (blockedTasks > 0 || overdueTasks > 0 || dateOverdue)
        {
            return "danger";
        }

        if (dueSoon)
        {
            return "warning";
        }

        if (string.Equals(priority, "Urgent", StringComparison.OrdinalIgnoreCase)
            || string.Equals(priority, "High", StringComparison.OrdinalIgnoreCase))
        {
            return "priority";
        }

        return "normal";
    }

    private static string ProjectRiskLabel(int blockedTasks, int overdueTasks, bool dateOverdue, bool dueSoon, string? priority)
    {
        if (blockedTasks > 0)
        {
            return "Đang vướng";
        }

        if (overdueTasks > 0 || dateOverdue)
        {
            return "Có việc trễ";
        }

        if (dueSoon)
        {
            return "Gần hạn";
        }

        if (string.Equals(priority, "Urgent", StringComparison.OrdinalIgnoreCase)
            || string.Equals(priority, "High", StringComparison.OrdinalIgnoreCase))
        {
            return "Ưu tiên";
        }

        return "Ổn định";
    }
}
