@model IEnumerable<Manage_KPI_or_OKR_System.Models.ViewModels.WorkProjectIndexItemViewModel>
@{
    ViewData["Title"] = "Công việc & Dự án";
    var currentStatus = ViewData["StatusFilter"] as string;
    var currentPriority = ViewData["PriorityFilter"] as string;
    var statusOptions = ViewBag.StatusOptions as IEnumerable<string> ?? Enumerable.Empty<string>();
    var priorityOptions = ViewBag.PriorityOptions as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h3 class="mb-1 fw-bold text-dark"><i class="bi bi-kanban-fill text-primary me-2"></i>Công việc & Dự án</h3>
            <p class="text-muted mb-0">Quản lý dự án Agile/Kanban, giao việc theo phòng ban và giữ trao đổi tập trung trong từng task.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Tạo dự án
        </a>
    </div>

    <form asp-action="Index" method="get" class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-lg-5">
                    <label class="form-label fw-semibold">Tìm kiếm</label>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tên, mã dự án hoặc mô tả..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">Tất cả</option>
                        @foreach (var item in statusOptions)
                        {
                            <option value="@item" selected="@(item == currentStatus ? "selected" : null)">@ProjectStatusLabel(item)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Ưu tiên</label>
                    <select name="priority" class="form-select">
                        <option value="">Tất cả</option>
                        @foreach (var item in priorityOptions)
                        {
                            <option value="@item" selected="@(item == currentPriority ? "selected" : null)">@PriorityLabel(item)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search me-1"></i> Lọc</button>
                </div>
            </div>
        </div>
    </form>

    <div class="row g-3">
        @foreach (var item in Model)
        {
            var progress = item.Project.ProgressPercentage ?? 0;
            <div class="col-xl-4 col-lg-6">
                <div class="project-card h-100">
                    <div class="project-card__top">
                        <div>
                            <span class="project-code">@item.Project.ProjectCode</span>
                            <h5 class="project-title">@item.Project.ProjectName</h5>
                        </div>
                        <span class="priority-badge priority-@((item.Project.Priority ?? "Normal").ToLowerInvariant())">@PriorityLabel(item.Project.Priority)</span>
                    </div>

                    <p class="project-desc">@(!string.IsNullOrWhiteSpace(item.Project.Description) ? item.Project.Description : "Chưa có mô tả dự án.")</p>

                    <div class="project-meta">
                        <span><i class="bi bi-person-badge"></i> @item.OwnerName</span>
                        <span><i class="bi bi-diagram-3"></i> @item.DepartmentNames</span>
                        <span><i class="bi bi-calendar-event"></i> @(item.Project.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có hạn")</span>
                    </div>

                    <div class="progress-block">
                        <div class="d-flex justify-content-between small fw-semibold mb-1">
                            <span>Tiến độ</span>
                            <span>@progress.ToString("0.##")%</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar" style="width: @progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>

                    <div class="project-stats">
                        <span><strong>@item.TotalTasks</strong> việc</span>
                        <span><strong>@item.DoneTasks</strong> xong</span>
                        <span class="@(item.BlockedTasks > 0 ? "text-danger" : "")"><strong>@item.BlockedTasks</strong> vướng</span>
                        <span class="@(item.OverdueTasks > 0 ? "text-warning" : "")"><strong>@item.OverdueTasks</strong> trễ</span>
                    </div>

                    <div class="project-card__footer">
                        <span class="status-pill status-@((item.Project.Status ?? "Active").ToLowerInvariant())">@ProjectStatusLabel(item.Project.Status)</span>
                        <a asp-action="Details" asp-route-id="@item.Project.Id" class="btn btn-sm btn-primary">
                            Mở Kanban <i class="bi bi-arrow-right-short"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-kanban"></i>
            <h5>Chưa có dự án phù hợp</h5>
            <p>Tạo dự án đầu tiên để bắt đầu giao việc và cộng tác giữa các phòng ban.</p>
        </div>
    }
</div>

<style>
    .project-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .project-card__top,
    .project-card__footer,
    .project-stats {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .project-code {
        color: var(--text-muted);
        font-size: 0.78rem;
        font-weight: 800;
    }

    .project-title {
        margin: 2px 0 0;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .project-desc {
        color: var(--text-secondary);
        min-height: 44px;
        margin: 0;
        line-height: 1.45;
    }

    .project-meta {
        display: grid;
        gap: 7px;
        color: var(--text-muted);
        font-size: 0.86rem;
    }

    .project-meta span {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .project-stats {
        flex-wrap: wrap;
        justify-content: flex-start;
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .project-stats span {
        background: var(--primary-light);
        border-radius: 8px;
        padding: 6px 9px;
    }

    .priority-badge,
    .status-pill {
        border-radius: 8px;
        padding: 5px 9px;
        font-size: 0.76rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .priority-low { background: #eef7ee; color: #2e7d32; }
    .priority-normal { background: #eef4ff; color: var(--primary-dark); }
    .priority-high { background: #fff4e5; color: #b76a00; }
    .priority-urgent { background: #fdecec; color: #c62828; }
    .status-planning { background: #eef4ff; color: var(--primary-dark); }
    .status-active { background: #e8f5e9; color: #2e7d32; }
    .status-onhold { background: #fff8e1; color: #9a6b00; }
    .status-completed { background: #e7f6ef; color: #0f7a4d; }
    .status-archived { background: #f1f3f4; color: #5f6368; }

    .empty-state {
        margin-top: 24px;
        padding: 48px 20px;
        text-align: center;
        background: var(--card-bg);
        border: 1px dashed var(--border-color);
        border-radius: 12px;
        color: var(--text-muted);
    }

    .empty-state i {
        font-size: 2.3rem;
        color: var(--primary);
    }
</style>

@functions {
    private static string PriorityLabel(string? value) => value switch
    {
        "Low" => "Thấp",
        "High" => "Cao",
        "Urgent" => "Khẩn cấp",
        _ => "Bình thường"
    };

    private static string ProjectStatusLabel(string? value) => value switch
    {
        "Planning" => "Lên kế hoạch",
        "OnHold" => "Tạm dừng",
        "Completed" => "Hoàn thành",
        "Archived" => "Lưu trữ",
        _ => "Đang chạy"
    };
}
