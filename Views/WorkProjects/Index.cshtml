@functions {
    private static string PriorityLabel(string? value) => value switch
    {
        "Low" => "Thấp",
        "High" => "Cao",
        "Urgent" => "Khẩn cấp",
        _ => "Bình thường"
    };

    private static string ProjectStatusLabel(string? value) => value switch
    {
        "Planning" => "Lên kế hoạch",
        "OnHold" => "Tạm dừng",
        "Completed" => "Hoàn thành",
        "Archived" => "Lưu trữ",
        _ => "Đang chạy"
    };

    private static string SortLabel(string? value) => value switch
    {
        "updated" => "Mới cập nhật",
        "deadline" => "Deadline gần",
        "low-progress" => "Tiến độ thấp",
        _ => "Rủi ro trước"
    };

    private static string QuickFilterClass(string value, string? currentValue)
    {
        return string.Equals(value, currentValue ?? "", StringComparison.OrdinalIgnoreCase)
            ? "is-active"
            : "";
    }

    private static bool IsProjectClosed(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Archived", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsProjectDateOverdue(DateTime? dueDate, string? status, DateTime today)
    {
        return dueDate.HasValue && dueDate.Value.Date < today && !IsProjectClosed(status);
    }

    private static bool IsProjectDueSoon(DateTime? dueDate, string? status, DateTime today)
    {
        return dueDate.HasValue
            && dueDate.Value.Date >= today
            && dueDate.Value.Date <= today.AddDays(7)
            && !IsProjectClosed(status);
    }

    private static string ProjectRiskTone(int blockedTasks, int overdueTasks, bool dateOverdue, bool dueSoon, string? priority)
    {
        if (blockedTasks > 0 || overdueTasks > 0 || dateOverdue)
        {
            return "danger";
        }

        if (dueSoon)
        {
            return "warning";
        }

        if (string.Equals(priority, "Urgent", StringComparison.OrdinalIgnoreCase)
            || string.Equals(priority, "High", StringComparison.OrdinalIgnoreCase))
        {
            return "priority";
        }

        return "normal";
    }

    private static string ProjectRiskLabel(int blockedTasks, int overdueTasks, bool dateOverdue, bool dueSoon, string? priority)
    {
        if (blockedTasks > 0)
        {
            return "Đang vướng";
        }

        if (overdueTasks > 0 || dateOverdue)
        {
            return "Có việc trễ";
        }

        if (dueSoon)
        {
            return "Gần hạn";
        }

        if (string.Equals(priority, "Urgent", StringComparison.OrdinalIgnoreCase)
            || string.Equals(priority, "High", StringComparison.OrdinalIgnoreCase))
        {
            return "Ưu tiên";
        }

        return "Ổn định";
    }
}
