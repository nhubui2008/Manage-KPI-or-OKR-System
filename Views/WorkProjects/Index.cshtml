@model IEnumerable<Manage_KPI_or_OKR_System.Models.ViewModels.WorkProjectIndexItemViewModel>
@{
    ViewData["Title"] = "Công việc & Dự án";
    var projects = Model?.ToList() ?? new List<Manage_KPI_or_OKR_System.Models.ViewModels.WorkProjectIndexItemViewModel>();
    var today = DateTime.Today;
    var currentStatus = ViewData["StatusFilter"] as string;
    var currentPriority = ViewData["PriorityFilter"] as string;
    var currentSearch = ViewData["CurrentFilter"] as string;
    var currentQuickFilter = ViewData["QuickFilter"] as string ?? "";
    var currentSortBy = ViewData["SortBy"] as string ?? "risk";
    var statusOptions = ViewBag.StatusOptions as IEnumerable<string> ?? Enumerable.Empty<string>();
    var priorityOptions = ViewBag.PriorityOptions as IEnumerable<string> ?? Enumerable.Empty<string>();
    var hasActiveFilters = !string.IsNullOrWhiteSpace(currentSearch)
        || !string.IsNullOrWhiteSpace(currentStatus)
        || !string.IsNullOrWhiteSpace(currentPriority)
        || !string.IsNullOrWhiteSpace(currentQuickFilter)
        || !string.Equals(currentSortBy, "risk", StringComparison.OrdinalIgnoreCase);
    var totalProjects = projects.Count;
    var activeProjects = projects.Count(item => string.Equals(item.Project.Status ?? "Active", "Active", StringComparison.OrdinalIgnoreCase));
    var urgentProjects = projects.Count(item =>
        string.Equals(item.Project.Priority, "Urgent", StringComparison.OrdinalIgnoreCase)
        || string.Equals(item.Project.Priority, "High", StringComparison.OrdinalIgnoreCase));
    var blockedProjects = projects.Count(item => item.BlockedTasks > 0);
    var overdueProjects = projects.Count(item => item.OverdueTasks > 0 || IsProjectDateOverdue(item.Project.DueDate, item.Project.Status, today));
    var attentionProjects = projects.Count(item =>
        item.BlockedTasks > 0
        || item.OverdueTasks > 0
        || IsProjectDateOverdue(item.Project.DueDate, item.Project.Status, today));
    var dueSoonProjects = projects.Count(item => IsProjectDueSoon(item.Project.DueDate, item.Project.Status, today));
}

<div class="container-fluid p-0 workprojects-page">
    <div class="workprojects-header">
        <div>
            <h3 class="mb-1 fw-bold text-dark"><i class="bi bi-kanban-fill text-primary me-2"></i>Công việc & Dự án</h3>
            <p class="text-muted mb-0">Quản lý dự án Agile/Kanban, giao việc theo phòng ban và giữ trao đổi tập trung trong từng task.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary workprojects-create">
            <i class="bi bi-plus-lg me-1"></i> Tạo dự án
        </a>
    </div>

    <section class="ops-summary" aria-label="Tổng quan vận hành dự án">
        <div class="ops-summary__item">
            <span>Tổng dự án</span>
            <strong>@totalProjects</strong>
            <small>@activeProjects đang chạy</small>
        </div>
        <div class="ops-summary__item ops-summary__item--danger">
            <span>Cần xử lý</span>
            <strong>@attentionProjects</strong>
            <small>@blockedProjects vướng · @overdueProjects trễ</small>
        </div>
        <div class="ops-summary__item ops-summary__item--warning">
            <span>Sắp tới hạn</span>
            <strong>@dueSoonProjects</strong>
            <small>Trong 7 ngày tới</small>
        </div>
        <div class="ops-summary__item ops-summary__item--priority">
            <span>Ưu tiên cao</span>
            <strong>@urgentProjects</strong>
            <small>Cao hoặc khẩn cấp</small>
        </div>
    </section>

    <form asp-action="Index" method="get" class="workprojects-filter">
        @if (!string.IsNullOrWhiteSpace(currentQuickFilter))
        {
            <input type="hidden" name="quickFilter" value="@currentQuickFilter" />
        }
        <div class="filter-grid">
            <div class="filter-field filter-field--search">
                <label for="workproject-search" class="form-label">Tìm nhanh</label>
                <div class="input-with-icon">
                    <i class="bi bi-search"></i>
                    <input id="workproject-search" type="text" name="searchString" value="@currentSearch" class="form-control" placeholder="Tên, mã, mô tả, phụ trách, phòng ban..." />
                </div>
            </div>
            <div class="filter-field">
                <label for="workproject-status" class="form-label">Trạng thái</label>
                <select id="workproject-status" name="status" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var item in statusOptions)
                    {
                        <option value="@item" selected="@(item == currentStatus ? "selected" : null)">@ProjectStatusLabel(item)</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="workproject-priority" class="form-label">Ưu tiên</label>
                <select id="workproject-priority" name="priority" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var item in priorityOptions)
                    {
                        <option value="@item" selected="@(item == currentPriority ? "selected" : null)">@PriorityLabel(item)</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="workproject-sort" class="form-label">Sắp xếp</label>
                <select id="workproject-sort" name="sortBy" class="form-select">
                    <option value="risk" selected="@(currentSortBy == "risk" ? "selected" : null)">Rủi ro trước</option>
                    <option value="updated" selected="@(currentSortBy == "updated" ? "selected" : null)">Mới cập nhật</option>
                    <option value="deadline" selected="@(currentSortBy == "deadline" ? "selected" : null)">Deadline gần</option>
                    <option value="low-progress" selected="@(currentSortBy == "low-progress" ? "selected" : null)">Tiến độ thấp</option>
                </select>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i> Lọc</button>
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" class="btn btn-light">Xóa lọc</a>
                }
            </div>
        </div>
        <div class="quick-filter-row" aria-label="Lọc nhanh dự án">
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" class="@(QuickFilterClass("", currentQuickFilter))">Tất cả</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="mine" class="@(QuickFilterClass("mine", currentQuickFilter))">Của tôi</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="overdue" class="@(QuickFilterClass("overdue", currentQuickFilter))">Có việc trễ</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="blocked" class="@(QuickFilterClass("blocked", currentQuickFilter))">Có việc vướng</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="urgent" class="@(QuickFilterClass("urgent", currentQuickFilter))">Khẩn cấp</a>
            <a asp-action="Index" asp-route-searchString="@currentSearch" asp-route-status="@currentStatus" asp-route-priority="@currentPriority" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="unassigned-department" class="@(QuickFilterClass("unassigned-department", currentQuickFilter))">Chưa gán phòng ban</a>
        </div>
    </form>

    <div class="workprojects-result-bar">
        <div>
            <strong>@totalProjects</strong> dự án phù hợp
            @if (hasActiveFilters)
            {
                <span class="text-muted">· đang áp dụng bộ lọc</span>
            }
        </div>
        <span class="result-hint">Sắp xếp: @SortLabel(currentSortBy)</span>
    </div>

    <div class="workproject-grid">
        @foreach (var item in projects)
        {
            var progress = item.Project.ProgressPercentage ?? 0;
            var status = item.Project.Status ?? "Active";
            var priority = item.Project.Priority ?? "Normal";
            var isClosed = IsProjectClosed(status);
            var projectDateOverdue = IsProjectDateOverdue(item.Project.DueDate, status, today);
            var dueSoon = IsProjectDueSoon(item.Project.DueDate, status, today);
            var riskTone = ProjectRiskTone(item.BlockedTasks, item.OverdueTasks, projectDateOverdue, dueSoon, priority);
            var riskLabel = ProjectRiskLabel(item.BlockedTasks, item.OverdueTasks, projectDateOverdue, dueSoon, priority);
            var dueDateClass = projectDateOverdue ? "text-danger" : dueSoon ? "text-warning" : "";
            var description = !string.IsNullOrWhiteSpace(item.Project.Description) ? item.Project.Description : "Chưa có mô tả dự án.";
            var progressText = progress.ToString("0.##");
            var progressWidth = progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

            <article class="project-card project-card--@riskTone">
                <div class="project-card__top">
                    <div class="project-identity">
                        <div class="project-code-row">
                            <span class="project-code">@item.Project.ProjectCode</span>
                            <span class="status-pill status-@(status.ToLowerInvariant())">@ProjectStatusLabel(status)</span>
                        </div>
                        <h5 class="project-title" title="@item.Project.ProjectName">@item.Project.ProjectName</h5>
                    </div>
                    <div class="project-badges">
                        <span class="priority-badge priority-@(priority.ToLowerInvariant())">@PriorityLabel(priority)</span>
                        <span class="risk-pill risk-pill--@riskTone">@riskLabel</span>
                    </div>
                </div>

                <p class="project-desc" title="@description">@description</p>

                <div class="project-meta-grid">
                    <div class="meta-item">
                        <span><i class="bi bi-person-badge"></i> Phụ trách</span>
                        <strong title="@item.OwnerName">@item.OwnerName</strong>
                    </div>
                    <div class="meta-item">
                        <span><i class="bi bi-diagram-3"></i> Phòng ban</span>
                        <strong title="@item.DepartmentNames">@item.DepartmentNames</strong>
                    </div>
                    <div class="meta-item meta-item--due">
                        <span><i class="bi bi-calendar-event"></i> Hạn</span>
                        <strong class="@dueDateClass">@(item.Project.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có hạn")</strong>
                    </div>
                </div>

                <div class="progress-block">
                    <div class="progress-head">
                        <span>Tiến độ</span>
                        <strong>@progressText%</strong>
                    </div>
                    <div class="progress" aria-label="Tiến độ @progressText%">
                        <div class="progress-bar" style="width: @progressWidth%"></div>
                    </div>
                </div>

                <div class="project-stats" aria-label="Thống kê công việc">
                    <span><strong>@item.TotalTasks</strong> việc</span>
                    <span class="stat-done"><strong>@item.DoneTasks</strong> xong</span>
                    <span class="@(item.BlockedTasks > 0 ? "stat-danger" : "")"><strong>@item.BlockedTasks</strong> vướng</span>
                    <span class="@(item.OverdueTasks > 0 ? "stat-warning" : "")"><strong>@item.OverdueTasks</strong> trễ</span>
                </div>

                <div class="project-card__footer">
                    <span class="project-footnote">
                        @if (isClosed)
                        {
                            <i class="bi bi-check-circle"></i>
                            <span>Đã đóng luồng vận hành</span>
                        }
                        else if (item.TotalTasks == 0)
                        {
                            <i class="bi bi-inbox"></i>
                            <span>Chưa có task</span>
                        }
                        else
                        {
                            <i class="bi bi-activity"></i>
                            <span>@(item.TotalTasks - item.DoneTasks) việc đang mở</span>
                        }
                    </span>
                    <a asp-action="Details" asp-route-id="@item.Project.Id" class="btn btn-sm btn-primary">
                        Mở Kanban <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </article>
        }
    </div>

    @if (!projects.Any())
    {
        <div class="empty-state">
            <i class="bi bi-kanban"></i>
            <h5>Chưa có dự án phù hợp</h5>
            @if (hasActiveFilters)
            {
                <p>Không tìm thấy dự án theo bộ lọc hiện tại. Hãy xóa lọc hoặc thử từ khóa khác.</p>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm">Xóa lọc</a>
            }
            else
            {
                <p>Tạo dự án đầu tiên để bắt đầu giao việc và cộng tác giữa các phòng ban.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> Tạo dự án</a>
            }
        </div>
    }
</div>

<style>
    .workprojects-page {
        overflow-x: hidden;
    }

    .workprojects-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 14px;
    }

    .workprojects-header h3 {
        text-wrap: balance;
    }

    .workprojects-create {
        flex-shrink: 0;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .ops-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .ops-summary__item {
        min-height: 76px;
        padding: 12px 14px;
        border: 1px solid var(--card-border, #e5e7eb);
        border-radius: 8px;
        background: var(--card-bg, #fff);
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        display: grid;
        gap: 3px;
    }

    .ops-summary__item span {
        color: var(--text-muted, #64748b);
        font-size: 0.78rem;
        font-weight: 700;
    }

    .ops-summary__item strong {
        color: var(--text-primary, #0f172a);
        font-size: 1.35rem;
        line-height: 1;
    }

    .ops-summary__item small {
        color: var(--text-secondary, #475569);
        font-weight: 600;
    }

    .ops-summary__item--danger {
        border-color: #fecaca;
        background: #fff7f7;
    }

    .ops-summary__item--warning {
        border-color: #fed7aa;
        background: #fff8ed;
    }

    .ops-summary__item--priority {
        border-color: #c7d2fe;
        background: #f5f6ff;
    }

    .workprojects-filter {
        border: 1px solid var(--card-border, #e5e7eb);
        border-radius: 8px;
        background: var(--card-bg, #fff);
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        padding: 14px;
        margin-bottom: 12px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) minmax(140px, 170px) minmax(130px, 160px) minmax(150px, 180px) auto;
        gap: 12px;
        align-items: end;
    }

    .filter-field .form-label {
        margin-bottom: 6px;
        color: var(--text-primary, #0f172a);
        font-size: 0.85rem;
        font-weight: 700;
    }

    .input-with-icon {
        position: relative;
    }

    .input-with-icon i {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted, #64748b);
        pointer-events: none;
    }

    .input-with-icon .form-control {
        padding-left: 38px;
    }

    .filter-actions {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: flex-end;
    }

    .filter-actions .btn {
        min-width: 92px;
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .quick-filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
    }

    .quick-filter-row a {
        border: 1px solid var(--border-color, #d7dce2);
        border-radius: 999px;
        color: var(--text-secondary, #475569);
        font-size: 0.82rem;
        font-weight: 700;
        line-height: 1;
        padding: 8px 11px;
        text-decoration: none;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .quick-filter-row a:hover,
    .quick-filter-row a.is-active {
        background: var(--primary-light, #f0edff);
        border-color: var(--primary, #5b3fd6);
        color: var(--primary-dark, #4f46e5);
    }

    .workprojects-result-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        color: var(--text-secondary, #475569);
        font-size: 0.9rem;
        margin: 4px 0 12px;
    }

    .result-hint {
        color: var(--text-muted, #64748b);
        text-align: right;
    }

    .workproject-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
        gap: 14px;
        align-items: stretch;
    }

    .project-card {
        background: var(--card-bg, #fff);
        border: 1px solid var(--card-border, #e5e7eb);
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-width: 0;
    }

    .project-card--danger {
        border-color: #fecaca;
        background: #fffafa;
    }

    .project-card--warning {
        border-color: #fed7aa;
        background: #fffdf8;
    }

    .project-card--priority {
        border-color: #c7d2fe;
        background: #fbfbff;
    }

    .project-card__top,
    .project-card__footer,
    .project-stats {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }

    .project-identity {
        min-width: 0;
        flex: 1;
    }

    .project-code-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
    }

    .project-code {
        color: var(--text-muted, #64748b);
        font-size: 0.76rem;
        font-weight: 800;
    }

    .project-title {
        margin: 0;
        font-weight: 800;
        font-size: 1rem;
        line-height: 1.28;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-wrap: pretty;
    }

    .project-badges {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        flex-shrink: 0;
    }

    .project-desc {
        color: var(--text-secondary, #475569);
        min-height: 42px;
        margin: 0;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-wrap: pretty;
    }

    .project-meta-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr) 108px;
        gap: 8px;
    }

    .meta-item {
        min-width: 0;
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 8px;
        background: #f8fafc;
        padding: 8px 9px;
    }

    .meta-item span {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--text-muted, #64748b);
        font-size: 0.74rem;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .meta-item strong {
        display: block;
        color: var(--text-primary, #0f172a);
        font-size: 0.84rem;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .meta-item--due strong {
        text-overflow: clip;
    }

    .progress-block {
        display: grid;
        gap: 6px;
    }

    .progress-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        color: var(--text-primary, #0f172a);
        font-size: 0.84rem;
        font-weight: 700;
    }

    .progress {
        height: 7px;
        border-radius: 999px;
        background: #e8ebf0;
    }

    .progress-bar {
        border-radius: inherit;
    }

    .project-stats {
        flex-wrap: wrap;
        justify-content: flex-start;
        color: var(--text-muted, #64748b);
        font-size: 0.83rem;
    }

    .project-stats span {
        background: var(--primary-light, #f0edff);
        border-radius: 8px;
        padding: 5px 8px;
        font-weight: 600;
    }

    .project-stats strong {
        color: var(--text-primary, #0f172a);
    }

    .project-stats .stat-done strong {
        color: #16803a;
    }

    .project-stats .stat-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .project-stats .stat-warning {
        background: #fff0d6;
        color: #9a5b00;
    }

    .priority-badge,
    .status-pill,
    .risk-pill {
        border-radius: 999px;
        padding: 5px 9px;
        font-size: 0.74rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .priority-low { background: #eef7ee; color: #2e7d32; }
    .priority-normal { background: #eef4ff; color: var(--primary-dark, #4f46e5); }
    .priority-high { background: #fff4e5; color: #9a5b00; }
    .priority-urgent { background: #fee2e2; color: #b91c1c; }
    .status-planning { background: #eef4ff; color: var(--primary-dark, #4f46e5); }
    .status-active { background: #e8f5e9; color: #2e7d32; }
    .status-onhold { background: #fff8e1; color: #8a5d00; }
    .status-completed { background: #e7f6ef; color: #0f7a4d; }
    .status-archived { background: #f1f3f4; color: #5f6368; }

    .risk-pill--danger { background: #fee2e2; color: #991b1b; }
    .risk-pill--warning { background: #fff0d6; color: #8a5d00; }
    .risk-pill--priority { background: #eef2ff; color: #4338ca; }
    .risk-pill--normal { background: #edf7ee; color: #276738; }

    .project-card__footer {
        align-items: center;
        margin-top: auto;
    }

    .project-footnote {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--text-muted, #64748b);
        font-size: 0.83rem;
        min-width: 0;
    }

    .project-card__footer .btn {
        min-width: 116px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 2px;
    }

    .empty-state {
        margin-top: 18px;
        padding: 38px 20px;
        text-align: center;
        background: var(--card-bg, #fff);
        border: 1px dashed var(--border-color, #d7dce2);
        border-radius: 8px;
        color: var(--text-muted, #64748b);
    }

    .empty-state i {
        font-size: 2.1rem;
        color: var(--primary, #5b3fd6);
    }

