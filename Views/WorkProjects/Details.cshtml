</style>

@await Html.PartialAsync("_AITaskDecomposeModal")

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- DRAG AND DROP HANDLERS ---
            let draggedTaskId = null;
            let isDragging = false;

            const cards = document.querySelectorAll('.task-card');
            const columns = document.querySelectorAll('.kanban-column__body');
            const kanbanBoard = document.querySelector('.kanban-board');
            const kanbanFeedback = document.getElementById('kanbanFeedback');
            const pendingStatusUpdates = new Map();
            const searchInput = document.getElementById('kanbanTaskSearch');
            const sortSelect = document.getElementById('kanbanTaskSort');
            const filterButtons = document.querySelectorAll('.kanban-filter-btn');
            const resetFilterButton = document.getElementById('kanbanFilterReset');
            const filterSummary = document.getElementById('kanbanFilterSummary');
            const focusToggleButton = document.getElementById('kanbanFocusToggle');
            const filterCountBadges = document.querySelectorAll('[data-filter-count]');
            const currentEmployeeId = '@(currentEmployeeId?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")';
            const projectId = @project.Id;
            let activeKanbanFilter = 'all';
            let isKanbanFocusMode = false;
            let activeKanbanSort = sortSelect?.value || 'risk';
            let latestActivityCommentId = getLatestRenderedCommentId();
            let activityPollInFlight = false;
            const filterLabels = {
                all: 'Tất cả',
                mine: 'Của tôi',
                blocked: 'Bị chặn',
                important: 'Ưu tiên',
                overdue: 'Quá hạn',
                ai: 'AI'
            };
            const statusLabels = Array.from(columns).reduce((labels, column) => {
                const status = column.dataset.status;
                const labelNode = column.closest('.kanban-column')?.querySelector('.kanban-column__header .fw-bold');
                const label = Array.from(labelNode?.childNodes ?? [])
                    .filter(node => node.nodeType === Node.TEXT_NODE)
                    .map(node => node.textContent.trim())
                    .filter(Boolean)
                    .join(' ');

                if (status) {
                    labels[status] = label || status;
                }

                return labels;
            }, {});

            cards.forEach((card, index) => {
                card.dataset.taskOrder = String(index);

                card.addEventListener('dragstart', function(e) {
                    if (pendingStatusUpdates.has(this.dataset.taskId)) {
                        e.preventDefault();
                        return;
                    }

                    isDragging = true;
                    draggedTaskId = this.dataset.taskId;
                    this.classList.add('dragging');
                    revealFocusHiddenColumns();
                    kanbanBoard?.classList.add('kanban-board--dragging');
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', draggedTaskId);
                });

                card.addEventListener('dragend', function() {
                    this.classList.remove('dragging');
                    clearKanbanDragState();
                    setTimeout(() => {
                        isDragging = false;
                        applyKanbanFilters();
                    }, 100);
                });

                // Open modal on click (but prevent if dragging or clicking interactive controls)
                card.addEventListener('click', function(e) {
                    if (isDragging) return;
                    
                    if (e.target.closest('.task-drag-grip') || e.target.closest('button') || e.target.closest('a') || e.target.closest('form')) {
                        return;
                    }

                    const taskId = this.dataset.taskId;
                    const modalElement = document.getElementById(`taskModal-${taskId}`);
                    if (modalElement) {
                        const modalInstance = new bootstrap.Modal(modalElement);
                        modalInstance.show();
                    }
                });

                card.addEventListener('keydown', function(e) {
                    if ((e.key === 'Enter' || e.key === ' ') && e.target === this) {
                        e.preventDefault();
                        const modalElement = document.getElementById(`taskModal-${this.dataset.taskId}`);
                        if (modalElement) {
                            const modalInstance = new bootstrap.Modal(modalElement);
                            modalInstance.show();
                        }
                    }
                });
            });

            searchInput?.addEventListener('input', applyKanbanFilters);
            sortSelect?.addEventListener('change', function() {
                activeKanbanSort = this.value || 'risk';
                applyKanbanFilters();
            });

            focusToggleButton?.addEventListener('click', function() {
                isKanbanFocusMode = !isKanbanFocusMode;
                this.classList.toggle('active', isKanbanFocusMode);
                this.classList.toggle('btn-primary', isKanbanFocusMode);
                this.classList.toggle('btn-outline-secondary', !isKanbanFocusMode);
                this.setAttribute('aria-pressed', String(isKanbanFocusMode));
                applyKanbanFilters();
            });

            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    activeKanbanFilter = this.dataset.filter || 'all';
                    updateFilterButtonState();
                    applyKanbanFilters();
                });
            });

            resetFilterButton?.addEventListener('click', function() {
                if (searchInput) {
                    searchInput.value = '';
                }

                activeKanbanFilter = 'all';
                updateFilterButtonState();
                applyKanbanFilters();
                searchInput?.focus();
            });

            document.querySelectorAll('.comment-form').forEach(form => {
                form.addEventListener('submit', submitCommentFormAjax);
            });

            columns.forEach(column => {
                column.addEventListener('dragover', function(e) {
                    e.preventDefault(); // Required to allow drop
                    this.classList.add('dragover-highlight');
                });

                column.addEventListener('dragleave', function(e) {
                    if (e.relatedTarget && this.contains(e.relatedTarget)) {
                        return;
                    }

                    this.classList.remove('dragover-highlight');
                });

                column.addEventListener('drop', function(e) {
                    e.preventDefault();
                    clearKanbanDragState();
                    
                    const taskId = e.dataTransfer.getData('text/plain') || draggedTaskId;
                    const newStatus = this.dataset.status;
                    
                    if (!taskId || !newStatus) return;
                    if (pendingStatusUpdates.has(taskId)) return;
                    
                    const cardElement = document.querySelector(`.task-card[data-task-id="${taskId}"]`);
                    const sourceColumn = cardElement?.closest('.kanban-column__body');
                    const originalStatus = sourceColumn?.dataset.status;
                    
                    if (!cardElement || !sourceColumn || newStatus === originalStatus) return;

                    const sourceNextSibling = cardElement.nextElementSibling;
                    const originalProgress = getDisplayedProgress(cardElement);
                    const nextProgress = newStatus === 'Done' ? 100 : originalProgress;

                    insertTaskCard(cardElement, this);
                    syncColumnState(sourceColumn);
                    syncColumnState(this);
                    syncTaskStatusDisplay(taskId, newStatus);
                    cardElement.dataset.taskStatus = newStatus;
                    cardElement.dataset.taskOverdue = String(isTaskOverdueForStatus(cardElement, newStatus));

                    if (nextProgress !== null) {
                        updateTaskProgressDisplay(cardElement, nextProgress);
                    }

                    applyKanbanFilters();

                    cardElement.classList.add('task-card--syncing');
                    cardElement.setAttribute('aria-busy', 'true');
                    pendingStatusUpdates.set(taskId, true);

                    persistTaskStatus(taskId, newStatus)
                        .then(result => {
                            if (result?.progress !== undefined) {
                                const savedProgress = Number(result.progress);
                                if (Number.isFinite(savedProgress)) {
                                    updateTaskProgressDisplay(cardElement, savedProgress);
                                }
                            }

                            mergeActivityComment(result?.comment);
                            updateTaskCommentCount(taskId, result?.commentCount);
                            markTaskSaved(cardElement);
                            showKanbanFeedback(`Đã chuyển sang ${statusLabels[result?.status || newStatus] || statusLabels[newStatus] || 'trạng thái mới'}`);
                        })
                        .catch(error => {
                            console.error(error);
                            const currentColumn = cardElement.closest('.kanban-column__body');

                            insertTaskCard(cardElement, sourceColumn, sourceNextSibling);
                            if (currentColumn && currentColumn !== sourceColumn) {
                                syncColumnState(currentColumn);
                            }

                            syncColumnState(sourceColumn);
                            syncTaskStatusDisplay(taskId, originalStatus);
                            cardElement.dataset.taskStatus = originalStatus;
                            cardElement.dataset.taskOverdue = String(isTaskOverdueForStatus(cardElement, originalStatus));

                            if (originalProgress !== null) {
                                updateTaskProgressDisplay(cardElement, originalProgress);
                            }

                            applyKanbanFilters();
                            showKanbanFeedback('Chưa lưu được thay đổi trạng thái', 'warning');

                            Swal.fire({
                                title: 'Không thể chuyển trạng thái',
                                text: 'Dữ liệu đã được đưa về vị trí cũ. Vui lòng thử lại sau.',
                                icon: 'warning',
                                confirmButtonText: 'Đồng ý'
                            });
                        })
                        .finally(() => {
                            pendingStatusUpdates.delete(taskId);
                            cardElement.classList.remove('task-card--syncing');
                            cardElement.removeAttribute('aria-busy');
                        });
                });
            });

            function clearKanbanDragState() {
                kanbanBoard?.classList.remove('kanban-board--dragging');
                columns.forEach(column => {
                    column.classList.remove('dragover-highlight');
                });
            }

            function markTaskSaved(card) {
                card.classList.remove('task-card--saved');
                void card.offsetWidth;
                card.classList.add('task-card--saved');
                window.setTimeout(() => card.classList.remove('task-card--saved'), 1000);
            }

            let kanbanFeedbackTimer = null;
            function showKanbanFeedback(message, type = 'success') {
                if (!kanbanFeedback) return;

                window.clearTimeout(kanbanFeedbackTimer);
                kanbanFeedback.textContent = message;
                kanbanFeedback.classList.toggle('is-warning', type === 'warning');
                kanbanFeedback.classList.add('is-visible');
                kanbanFeedbackTimer = window.setTimeout(() => {
                    kanbanFeedback.classList.remove('is-visible', 'is-warning');
                }, 1800);
            }

            function persistTaskStatus(taskId, targetStatus) {
                const antiForgeryToken = document.querySelector('#globalAntiForgeryForm input[name="__RequestVerificationToken"]')?.value;
                if (!antiForgeryToken) {
                    return Promise.reject(new Error('Anti-forgery token not found.'));
                }

                const formData = new FormData();
                formData.append('id', taskId);
                formData.append('kanbanStatus', targetStatus);
                formData.append('__RequestVerificationToken', antiForgeryToken);

                return fetch('/WorkProjects/UpdateTaskStatus', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`UpdateTaskStatus failed with HTTP ${response.status}`);
                    }

                    const contentType = response.headers.get('content-type') || '';
                    return contentType.includes('application/json') ? response.json() : {};
                });
            }

            function insertTaskCard(card, column, beforeElement = null) {
                removeEmptyState(column);

                if (beforeElement && beforeElement.parentElement === column) {
                    column.insertBefore(card, beforeElement);
                    return;
                }

                column.appendChild(card);
            }

            function syncColumnState(column) {
                const cardCount = column.querySelectorAll('.task-card').length;
                setColumnCountBadge(column, cardCount);

                if (cardCount > 0) {
                    removeEmptyState(column);
                    return;
                }

                if (!column.querySelector('.kanban-empty')) {
                    const emptyState = document.createElement('div');
                    emptyState.className = 'kanban-empty text-center py-4 rounded-3 text-muted border border-dashed';
                    emptyState.textContent = 'Chưa có công việc';
                    column.appendChild(emptyState);
                }
            }

            function removeEmptyState(column) {
                column.querySelectorAll('.kanban-empty').forEach(emptyState => emptyState.remove());
            }

            function applyKanbanFilters() {
                const query = normalizeForSearch(searchInput?.value ?? '');
                const allCards = Array.from(cards);
                let visibleCount = 0;

                refreshFilterCounts(allCards);

                allCards.forEach(card => {
                    const isVisible = matchesSearch(card, query) && matchesActiveFilter(card);
                    card.classList.toggle('d-none', !isVisible);

                    if (isVisible) {
                        visibleCount++;
                    }
                });

                sortKanbanColumns();
                columns.forEach(column => syncColumnFilterState(column, visibleCount));
                updateKanbanFocusLayout(visibleCount);
                updateFilterSummary(visibleCount, allCards.length);
            }

            function sortKanbanColumns() {
                if (isDragging) return;

                columns.forEach(column => {
                    const cardsInColumn = Array.from(column.querySelectorAll('.task-card'));
                    if (cardsInColumn.length < 2) return;

                    cardsInColumn
                        .sort(compareTaskCards)
                        .forEach(card => {
                            const marker = column.querySelector('.kanban-empty, .kanban-filter-empty');
                            if (marker && marker.parentElement === column) {
                                column.insertBefore(card, marker);
                                return;
                            }

                            column.appendChild(card);
                        });
                });
            }

            function compareTaskCards(a, b) {
                if (activeKanbanSort === 'default') {
                    return getOriginalTaskOrder(a) - getOriginalTaskOrder(b);
                }

                if (activeKanbanSort === 'due') {
                    return compareDueTime(a, b)
                        || getPriorityScore(b) - getPriorityScore(a)
                        || getOriginalTaskOrder(a) - getOriginalTaskOrder(b);
                }

                return getRiskScore(b) - getRiskScore(a)
                    || compareDueTime(a, b)
                    || getOriginalTaskOrder(a) - getOriginalTaskOrder(b);
            }

            function getRiskScore(card) {
                const dueTime = getDueTime(card);
                const hasDueDate = Number.isFinite(dueTime);
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const daysUntilDue = hasDueDate
                    ? Math.ceil((dueTime - today.getTime()) / 86400000)
                    : Number.POSITIVE_INFINITY;

                let score = getPriorityScore(card);
                if (card.dataset.taskOverdue === 'true') {
                    score += 500;
                } else if (daysUntilDue <= 1) {
                    score += 160;
                } else if (daysUntilDue <= 3) {
                    score += 120;
                } else if (daysUntilDue <= 7) {
                    score += 80;
                } else if (daysUntilDue <= 14) {
                    score += 40;
                }

                return score;
            }

            function getPriorityScore(card) {
                switch (card.dataset.taskPriority || 'Normal') {
                    case 'Urgent':
                        return 300;
                    case 'High':
                        return 200;
                    case 'Low':
                        return 20;
                    default:
                        return 100;
                }
            }

            function getDueTime(card) {
                const value = card.dataset.taskDueDate;
                if (!value) return Number.POSITIVE_INFINITY;

                const time = new Date(`${value}T00:00:00`).getTime();
                return Number.isFinite(time) ? time : Number.POSITIVE_INFINITY;
            }

            function compareDueTime(a, b) {
                const aTime = getDueTime(a);
                const bTime = getDueTime(b);

                if (!Number.isFinite(aTime) && !Number.isFinite(bTime)) return 0;
                if (!Number.isFinite(aTime)) return 1;
                if (!Number.isFinite(bTime)) return -1;

                return aTime - bTime;
            }

            function getOriginalTaskOrder(card) {
                const order = Number(card.dataset.taskOrder);
                return Number.isFinite(order) ? order : Number.MAX_SAFE_INTEGER;
            }

            function normalizeForSearch(value) {
                return (value || '')
                    .toString()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase()
                    .trim();
            }

            function matchesSearch(card, query) {
                if (!query) return true;

                const searchText = card.dataset.taskSearch || card.textContent || '';
                return normalizeForSearch(searchText).includes(query);
            }

            function matchesActiveFilter(card) {
                const priority = card.dataset.taskPriority || 'Normal';

                switch (activeKanbanFilter) {
                    case 'mine':
                        return Boolean(currentEmployeeId) && card.dataset.taskAssigneeId === currentEmployeeId;
                    case 'blocked':
                        return card.dataset.taskStatus === 'Blocked';
                    case 'important':
                        return priority === 'Urgent' || priority === 'High';
                    case 'overdue':
                        return card.dataset.taskOverdue === 'true';
                    case 'ai':
                        return card.dataset.taskAi === 'true';
                    default:
                        return true;
                }
            }

            function updateFilterButtonState() {
                filterButtons.forEach(button => {
                    const isActive = button.dataset.filter === activeKanbanFilter;
                    button.classList.toggle('active', isActive);
                    button.classList.toggle('btn-primary', isActive);
                    button.classList.toggle('btn-outline-secondary', !isActive);
                });
            }

            function updateFilterSummary(visibleCount, totalCount) {
                if (!filterSummary) return;

                const hasQuery = Boolean(searchInput?.value.trim());
                const hasNamedFilter = activeKanbanFilter !== 'all';

                if (!hasQuery && !hasNamedFilter) {
                    filterSummary.textContent = '';
                    return;
                }

                const filterLabel = filterLabels[activeKanbanFilter] || 'Bộ lọc';
                if (hasQuery && hasNamedFilter) {
                    filterSummary.textContent = `${filterLabel}: ${visibleCount}/${totalCount} task khớp tìm kiếm`;
                    return;
                }

                filterSummary.textContent = hasNamedFilter
                    ? `${filterLabel}: ${visibleCount}/${totalCount} task`
                    : `Tìm thấy ${visibleCount}/${totalCount} task`;
            }

            function syncColumnFilterState(column, totalVisibleCount) {
                const cardsInColumn = Array.from(column.querySelectorAll('.task-card'));
                const visibleCards = cardsInColumn.filter(card => !card.classList.contains('d-none'));
                const existingEmpty = column.querySelector('.kanban-filter-empty');
                const hasFilter = isKanbanFilterActive();
                const badgeValue = hasFilter && cardsInColumn.length > 0
                    ? `${visibleCards.length}/${cardsInColumn.length}`
                    : cardsInColumn.length;
                const shouldHideColumn = isKanbanFocusMode
                    && hasFilter
                    && !isDragging
                    && totalVisibleCount > 0
                    && visibleCards.length === 0;

                setColumnCountBadge(column, badgeValue);
                column.closest('.kanban-column')?.classList.toggle('is-focus-hidden', shouldHideColumn);

                if (!hasFilter) {
                    existingEmpty?.remove();
                    return;
                }

                if (cardsInColumn.length === 0 || visibleCards.length > 0) {
                    existingEmpty?.remove();
                    return;
                }

                if (!existingEmpty) {
                    const emptyState = document.createElement('div');
                    emptyState.className = 'kanban-filter-empty text-center py-4 rounded-3 text-muted border border-dashed';
                    emptyState.textContent = 'Không có task phù hợp';
                    column.appendChild(emptyState);
                }
            }

            function updateKanbanFocusLayout(totalVisibleCount = 0) {
                if (!kanbanBoard) return;

                const canFocus = isKanbanFocusMode && isKanbanFilterActive() && !isDragging && totalVisibleCount > 0;
                const visibleColumnCount = canFocus
                    ? Array.from(columns).filter(column => !column.closest('.kanban-column')?.classList.contains('is-focus-hidden')).length
                    : columns.length;

                kanbanBoard.classList.toggle('kanban-board--focused', canFocus);
                kanbanBoard.style.setProperty('--kanban-visible-columns', Math.max(1, visibleColumnCount));
            }

            function revealFocusHiddenColumns() {
                columns.forEach(column => {
                    column.closest('.kanban-column')?.classList.remove('is-focus-hidden');
                });
                kanbanBoard?.classList.remove('kanban-board--focused');
                kanbanBoard?.style.setProperty('--kanban-visible-columns', columns.length);
            }

            function refreshFilterCounts(allCards = Array.from(cards)) {
                const counts = allCards.reduce((result, card) => {
                    const priority = card.dataset.taskPriority || 'Normal';

                    result.all += 1;
                    result.mine += Boolean(currentEmployeeId) && card.dataset.taskAssigneeId === currentEmployeeId ? 1 : 0;
                    result.blocked += card.dataset.taskStatus === 'Blocked' ? 1 : 0;
                    result.important += priority === 'Urgent' || priority === 'High' ? 1 : 0;
                    result.overdue += card.dataset.taskOverdue === 'true' ? 1 : 0;
                    result.ai += card.dataset.taskAi === 'true' ? 1 : 0;

                    return result;
                }, {
                    all: 0,
                    mine: 0,
                    blocked: 0,
                    important: 0,
                    overdue: 0,
                    ai: 0
                });

                filterCountBadges.forEach(badge => {
                    const key = badge.dataset.filterCount || '';
                    const count = counts[key] ?? 0;
                    badge.textContent = count;
                    badge.classList.toggle('is-zero', key !== 'all' && count === 0);
                });
            }

            function setColumnCountBadge(column, value) {
                const countBadge = column.closest('.kanban-column')?.querySelector('.kanban-column__header .badge');
                if (countBadge) {
                    countBadge.textContent = value;
                }
            }

            function isKanbanFilterActive() {
                return activeKanbanFilter !== 'all' || Boolean(searchInput?.value.trim());
            }

            function isTaskOverdueForStatus(card, status) {
                const dueDateValue = card.dataset.taskDueDate;
                if (!dueDateValue || status === 'Done') return false;

                const dueDate = new Date(`${dueDateValue}T00:00:00`);
                const today = new Date();
                today.setHours(0, 0, 0, 0);

                return Number.isFinite(dueDate.getTime()) && dueDate < today;
            }

            function getLatestRenderedCommentId() {
                return Array.from(document.querySelectorAll('[data-comment-id]'))
                    .reduce((latest, element) => Math.max(latest, Number(element.dataset.commentId) || 0), 0);
            }

            function normalizeActivityComment(comment) {
                if (!comment) return null;

                return {
                    id: Number(comment.id ?? comment.Id ?? 0),
                    taskId: Number(comment.taskId ?? comment.TaskId ?? 0),
                    commenter: comment.commenter ?? comment.Commenter ?? 'Hệ thống',
                    text: comment.text ?? comment.Text ?? '',
                    createdAt: comment.createdAt ?? comment.CreatedAt ?? '',
                    isSystem: Boolean(comment.isSystem ?? comment.IsSystem)
                };
            }

            function mergeActivityComment(rawComment) {
                const comment = normalizeActivityComment(rawComment);
                if (!comment?.id || !comment.taskId) return false;

                latestActivityCommentId = Math.max(latestActivityCommentId, comment.id);

                if (document.querySelector(`[data-comment-id="${comment.id}"]`)) {
                    return false;
                }

                const stream = document.querySelector(`[data-task-comment-stream="${comment.taskId}"]`);
                if (!stream) return false;

                stream.querySelector(`[data-task-empty-comment="${comment.taskId}"]`)?.remove();
                stream.appendChild(createActivityCommentElement(comment));
                stream.scrollTop = stream.scrollHeight;

                return true;
            }

            function createActivityCommentElement(comment) {
                const item = document.createElement('div');
                item.className = `comment task-comment-item ${comment.isSystem ? 'comment--system' : 'comment--user'}`;
                item.dataset.commentId = comment.id;
                item.dataset.taskId = comment.taskId;

                const avatar = document.createElement('div');
                avatar.className = 'task-comment-avatar';
                const icon = document.createElement('i');
                icon.className = `bi ${comment.isSystem ? 'bi-arrow-left-right' : 'bi-person-fill'}`;
                avatar.appendChild(icon);

                const bubble = document.createElement('div');
                bubble.className = 'task-comment-bubble';

                const meta = document.createElement('div');
                meta.className = 'comment-meta';

                const name = document.createElement('strong');
                name.textContent = comment.commenter || 'Hệ thống';

                const time = document.createElement('span');
                const timeIcon = document.createElement('i');
                timeIcon.className = 'bi bi-clock me-1';
                time.appendChild(timeIcon);
                time.append(comment.createdAt || '');

                const text = document.createElement('div');
                text.className = 'comment-text';
                text.textContent = comment.text || '';

                meta.append(name, time);
                bubble.append(meta, text);
                item.append(avatar, bubble);

                return item;
            }

            function updateTaskCommentCount(taskId, count) {
                const numericCount = Number(count);
                if (!Number.isFinite(numericCount)) return;

                document.querySelectorAll(`[data-task-id="${taskId}"] [data-comment-count-value], [data-task-id="${taskId}"][data-comment-count-value]`)
                    .forEach(element => {
                        element.textContent = numericCount;
                    });
            }

            async function submitCommentFormAjax(e) {
                e.preventDefault();

                const form = e.currentTarget;
                const input = form.querySelector('[name="commentText"]');
                const submitButton = form.querySelector('button[type="submit"]');

                if (!input?.value.trim()) return;

                submitButton?.setAttribute('disabled', 'disabled');

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`AddComment failed with HTTP ${response.status}`);
                    }

                    const result = await response.json();
                    mergeActivityComment(result.comment);
                    updateTaskCommentCount(form.dataset.taskId, result.commentCount);
                    form.reset();
                } catch (error) {
                    console.error(error);
                    Swal.fire({
                        title: 'Không thể gửi trao đổi',
                        text: 'Vui lòng thử lại sau.',
                        icon: 'warning',
                        confirmButtonText: 'Đồng ý'
                    });
                } finally {
                    submitButton?.removeAttribute('disabled');
                }
            }

            function applyRemoteTaskState(taskState) {
                const taskId = String(taskState.id ?? taskState.Id ?? '');
                if (!taskId || pendingStatusUpdates.has(taskId)) return;

                const card = document.querySelector(`.task-card[data-task-id="${taskId}"]`);
                const nextStatus = taskState.status ?? taskState.Status;
                if (!card || !nextStatus) {
                    updateTaskCommentCount(taskId, taskState.commentCount ?? taskState.CommentCount);
                    return;
                }

                const currentColumn = card.closest('.kanban-column__body');
                const currentStatus = currentColumn?.dataset.status;
                const targetColumn = document.querySelector(`.kanban-column__body[data-status="${nextStatus}"]`);

                if (targetColumn && currentColumn && currentStatus !== nextStatus) {
                    insertTaskCard(card, targetColumn);
                    syncColumnState(currentColumn);
                    syncColumnState(targetColumn);
                    syncTaskStatusDisplay(taskId, nextStatus);
                    card.dataset.taskStatus = nextStatus;
                    card.dataset.taskOverdue = String(isTaskOverdueForStatus(card, nextStatus));
                }

                const progress = Number(taskState.progress ?? taskState.Progress);
                if (Number.isFinite(progress)) {
                    updateTaskProgressDisplay(card, progress);
                }

                updateTaskCommentCount(taskId, taskState.commentCount ?? taskState.CommentCount);
                applyKanbanFilters();
            }

            async function pollProjectActivity() {
                if (activityPollInFlight || document.hidden) return;

                activityPollInFlight = true;

                try {
                    const response = await fetch(`/WorkProjects/GetProjectActivity?projectId=${projectId}&afterCommentId=${latestActivityCommentId}`, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) return;

                    const activity = await response.json();
                    (activity.tasks ?? []).forEach(applyRemoteTaskState);
                    (activity.comments ?? []).forEach(comment => {
                        mergeActivityComment(comment);
                        const normalized = normalizeActivityComment(comment);
                        if (normalized) {
                            const taskState = (activity.tasks ?? []).find(task => String(task.id ?? task.Id) === String(normalized.taskId));
                            updateTaskCommentCount(normalized.taskId, taskState?.commentCount ?? taskState?.CommentCount);
                        }
                    });

                    const serverLatest = Number(activity.latestCommentId ?? activity.LatestCommentId);
                    if (Number.isFinite(serverLatest)) {
                        latestActivityCommentId = Math.max(latestActivityCommentId, serverLatest);
                    }
                } catch (error) {
                    console.error(error);
                } finally {
                    activityPollInFlight = false;
                }
            }

            function syncTaskStatusDisplay(taskId, status) {
                const label = statusLabels[status] || status;
                const modalElement = document.getElementById(`taskModal-${taskId}`);

                if (!modalElement) return;

                modalElement.querySelectorAll('[name="kanbanStatus"]').forEach(input => {
                    input.value = status;
                });

                modalElement.querySelectorAll('.task-status-label, .task-status-summary').forEach(element => {
                    element.textContent = label;
                });
            }

            function getDisplayedProgress(card) {
                const value = card.querySelector('.progress-value')?.textContent?.replace('%', '').replace(',', '.').trim();
                const progress = Number.parseFloat(value ?? '');

                return Number.isFinite(progress) ? progress : null;
            }

            function updateTaskProgressDisplay(card, progress) {
                const safeProgress = Math.max(0, Math.min(100, progress));
                const formatted = safeProgress.toLocaleString('vi-VN', { maximumFractionDigits: 2 });
                const progressWrapper = card.querySelector('.task-card__progress');
                const progressBar = card.querySelector('.progress-bar');
                const progressValue = card.querySelector('.progress-value');
                const modalElement = document.getElementById(`taskModal-${card.dataset.taskId}`);

                if (progressWrapper) {
                    progressWrapper.title = `Tiến độ: ${formatted}%`;
                }

                if (progressBar) {
                    progressBar.style.width = `${safeProgress}%`;
                }

                if (progressValue) {
                    progressValue.textContent = `${formatted}%`;
                }

                modalElement?.querySelectorAll('[name="progressPercentage"]').forEach(input => {
                    input.value = safeProgress;
                });

                modalElement?.querySelectorAll('.task-modal-quickmeta .quick-chip').forEach(chip => {
                    if (chip.textContent.includes('%')) {
                        chip.innerHTML = `<i class="bi bi-graph-up"></i> ${formatted}%`;
                    }
                });
            }

            // --- AUTO SCROLL COMMENTS TO BOTTOM WHEN MODAL IS SHOWN ---
            const modals = document.querySelectorAll('.task-detail-modal');
            modals.forEach(modal => {
                modal.addEventListener('shown.bs.modal', function () {
                    const commentBox = this.querySelector('.comment-stream-box');
                    if (commentBox) {
                        commentBox.scrollTop = commentBox.scrollHeight;
                    }
                });
            });

            applyKanbanFilters();

            setInterval(pollProjectActivity, 12000);
            document.addEventListener('visibilitychange', function() {
                if (!document.hidden) {
                    pollProjectActivity();
                }
            });
        });
    </script>
}

@functions {
    private static string StatusLabel(string? value) => value switch
    {
        "Backlog" => "Chờ sắp xếp",
        "Todo" => "Cần làm",
        "InProgress" => "Đang làm",
        "Review" => "Chờ duyệt",
        "Done" => "Hoàn thành",
        "Blocked" => "Bị chặn",
        _ => "Cần làm"
    };

    private static string StatusShortLabel(string? value) => value switch
    {
        "Backlog" => "Chờ xếp",
        "Todo" => "Cần làm",
        "InProgress" => "Đang làm",
        "Review" => "Chờ duyệt",
        "Done" => "Xong",
        "Blocked" => "Bị chặn",
        _ => "Cần làm"
    };

    private static string PriorityLabel(string? value) => value switch
    {
        "Low" => "Thấp",
        "High" => "Cao",
        "Urgent" => "Khẩn cấp",
        _ => "Bình thường"
    };

    private static string ProjectStatusLabel(string? value) => value switch
    {
        "Planning" => "Lên kế hoạch",
        "OnHold" => "Tạm dừng",
        "Completed" => "Hoàn thành",
        "Archived" => "Lưu trữ",
        _ => "Đang chạy"
    };

    private static string KpiOptionLabel(KPI kpi)
    {
        var name = !string.IsNullOrWhiteSpace(kpi.KPIName) ? kpi.KPIName : $"KPI #{kpi.Id}";
        var truncated = name.Length > 25 ? name.Substring(0, 25) + "…" : name;
        return $"{truncated} (#{kpi.Id})";
    }

    private static string KeyResultOptionLabel(OKRKeyResult keyResult)
    {
        var name = !string.IsNullOrWhiteSpace(keyResult.KeyResultName) ? keyResult.KeyResultName : $"KR #{keyResult.Id}";
        var truncated = name.Length > 25 ? name.Substring(0, 25) + "…" : name;
        return $"{truncated} (#{keyResult.Unit ?? "%"})";
    }
}
