@model Manage_KPI_or_OKR_System.Models.ViewModels.WorkProjectBoardViewModel
@{
    ViewData["Title"] = "Kanban dự án";
    var project = Model.Project;
    var selectedDepartmentIds = ViewBag.SelectedDepartmentIds as IEnumerable<int> ?? Enumerable.Empty<int>();
    var selectedDepartments = Model.Departments
        .Where(d => selectedDepartmentIds.Contains(d.Id))
        .Select(d => d.DepartmentName)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .ToList();
    var sourceOKRName = ViewBag.SourceOKRName as string;
    var sourceKPIName = ViewBag.SourceKPIName as string;
    var currentEmployeeId = ViewBag.CurrentEmployeeId is int employeeId ? employeeId : (int?)null;
    var progress = project.ProgressPercentage ?? 0;
}

<div class="container-fluid p-0 position-relative">
    
    <!-- Project Hero Section -->
    <div class="project-hero mb-3 border-0 shadow-sm">
        <div class="project-hero__main d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div class="project-hero__info">
                <div class="project-code mb-1">@project.ProjectCode</div>
                <h3 class="project-title mb-1 fw-bold text-primary">@project.ProjectName</h3>
                <p class="project-summary text-secondary mb-2">@(!string.IsNullOrWhiteSpace(project.Description) ? project.Description : "Chưa có mô tả dự án.")</p>
                <div class="project-meta-row d-flex flex-wrap gap-1">
                    <span class="meta-chip"><i class="bi bi-flag-fill text-danger"></i> @PriorityLabel(project.Priority)</span>
                    <span class="meta-chip"><i class="bi bi-activity text-primary"></i> @ProjectStatusLabel(project.Status)</span>
                    <span class="meta-chip"><i class="bi bi-calendar-event text-success"></i> @(project.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có deadline")</span>
                    <span class="meta-chip" title="@(selectedDepartments.Any() ? string.Join(", ", selectedDepartments) : "Chưa gán phòng ban")">
                        <i class="bi bi-diagram-3 text-info"></i> @(selectedDepartments.Any() ? string.Join(", ", selectedDepartments) : "Chưa gán phòng ban")
                    </span>
                    @if (!string.IsNullOrWhiteSpace(sourceOKRName))
                    {
                        <span class="meta-chip" title="@sourceOKRName"><i class="bi bi-crosshair text-primary"></i> OKR liên kết</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(sourceKPIName))
                    {
                        <span class="meta-chip" title="@sourceKPIName"><i class="bi bi-bullseye text-success"></i> KPI liên kết</span>
                    }
                </div>
            </div>
            <div class="project-hero__side">
                <div class="project-actions d-flex gap-2 flex-wrap justify-content-end">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"><i class="bi bi-arrow-left"></i> Danh sách</a>
                    @if (Model.CanCreateTask)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" onclick="openAiTaskDecomposeModal('PROJECT', @project.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(project.ProjectName ?? ""))', '@project.Id')">
                            <i class="bi bi-stars"></i> AI Gợi ý task
                        </button>
                    }
                    @if (Model.CanManageProject)
                    {
                        <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-primary d-flex align-items-center gap-1"><i class="bi bi-pencil-square"></i> Sửa dự án</a>
                    }
                </div>
                <div class="project-progress-mini">
                    <div class="d-flex justify-content-between small fw-semibold mb-1">
                        <span class="text-secondary">Tiến độ task</span>
                        <span class="text-primary">@progress.ToString("0.##")%</span>
                    </div>
                    <div class="progress rounded-pill">
                        <div class="progress-bar progress-bar-striped progress-bar-animated rounded-pill" style="width: @progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Collapsible Add Task Form -->
    @if (Model.CanCreateTask)
    {
        <div class="card add-task-card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body p-2">
                <div class="d-flex justify-content-between align-items-center cursor-pointer" data-bs-toggle="collapse" data-bs-target="#addTaskCollapse" aria-expanded="false" aria-controls="addTaskCollapse" style="cursor: pointer;" id="addTaskHeader">
                    <div class="d-flex align-items-center gap-2">
                        <span class="section-icon"><i class="bi bi-plus-lg"></i></span>
                        <div>
                            <h5 class="mb-0 fw-bold fs-6">Thêm công việc mới</h5>
                            <p class="text-muted small mb-0 d-none d-md-block">Giao việc cho nhân sự/phòng ban và phân loại mức độ ưu tiên ngay trên Kanban.</p>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary collapse-indicator-btn d-flex align-items-center gap-1">
                        <span>Mở rộng</span> <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                
                <div class="collapse" id="addTaskCollapse">
                    <hr class="my-3 text-muted opacity-25">
                    <form asp-action="CreateTask" method="post" class="row g-3">
                        <input type="hidden" name="projectId" value="@project.Id" />
                        <div class="col-lg-8">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Tên công việc</label>
                            <input type="text" name="title" class="form-control form-control-sm" placeholder="Nhập tên công việc..." maxlength="220" required />
                        </div>
                        <div class="col-lg-4 col-md-12">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Người phụ trách</label>
                            <select name="assigneeId" class="form-select form-select-sm">
                                <option value="">Chưa gán</option>
                                @foreach (var employee in Model.Employees)
                                {
                                    <option value="@employee.Id">@employee.FullName</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-lg-4 col-md-12">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Phòng ban</label>
                            <select name="departmentId" class="form-select form-select-sm" style="width: 100%;">
                                <option value="">Chưa gán</option>
                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department.Id">@department.DepartmentName</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Liên kết KPI</label>
                            <select name="kpiId" class="form-select form-select-sm" style="text-overflow: ellipsis; overflow: hidden; max-width: 100%;" title="">
                                <option value="">Không liên kết</option>
                                @foreach (var kpi in Model.KPIs)
                                {
                                    var label = KpiOptionLabel(kpi);
                                    <option value="@kpi.Id" title="@label">@label</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Liên kết Key Result</label>
                            <select name="okrKeyResultId" class="form-select form-select-sm" style="text-overflow: ellipsis; overflow: hidden; max-width: 100%;" title="">
                                <option value="">Tự lấy theo KPI</option>
                                @foreach (var keyResult in Model.KeyResults)
                                {
                                    var krLabel = KeyResultOptionLabel(keyResult);
                                    <option value="@keyResult.Id" title="@krLabel">@krLabel</option>
                                }
                            </select>
                        </div>

                        <div class="col-lg-3 col-md-3">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Trọng số KPI</label>
                            <input type="number" name="kpiImpactWeight" class="form-control form-control-sm" min="0.1" max="100" step="0.1" value="1" />
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Ưu tiên</label>
                            <select name="priority" class="form-select form-select-sm">
                                @foreach (var item in Model.PriorityOptions)
                                {
                                    <option value="@item" selected="@(item == "Normal" ? "selected" : null)">@PriorityLabel(item)</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Trạng thái</label>
                            <select name="kanbanStatus" class="form-select form-select-sm">
                                @foreach (var item in Model.StatusOptions)
                                {
                                    <option value="@item" selected="@(item == "Todo" ? "selected" : null)">@StatusLabel(item)</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Deadline</label>
                            <input type="date" name="dueDate" class="form-control form-control-sm" />
                        </div>

                        <div class="col-lg-10">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Mô tả công việc</label>
                            <input type="text" name="description" class="form-control form-control-sm" maxlength="2000" placeholder="Kết quả mong muốn, tài liệu liên quan, lưu ý phối hợp..." />
                        </div>
                        <div class="col-lg-2 d-grid align-self-end">
                            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm task</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="kanban-quick-tools d-flex align-items-center justify-content-between gap-2 flex-wrap mb-2">
        <div class="kanban-search input-group input-group-sm">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input id="kanbanTaskSearch" type="search" class="form-control" placeholder="Tìm task, người phụ trách, phòng ban..." autocomplete="off" />
        </div>
        <div class="kanban-sort input-group input-group-sm" title="Sắp xếp task trong từng cột">
            <span class="input-group-text bg-white"><i class="bi bi-sort-down"></i></span>
            <select id="kanbanTaskSort" class="form-select">
                <option value="risk" selected>Rủi ro trước</option>
                <option value="due">Deadline gần</option>
                <option value="default">Mặc định</option>
            </select>
        </div>
        <div class="kanban-filter-group d-flex align-items-center gap-1 flex-wrap">
            <button type="button" class="btn btn-sm btn-primary kanban-filter-btn active" data-filter="all">
                <i class="bi bi-grid-3x3-gap"></i>
                <span>Tất cả</span>
                <span class="kanban-filter-count" data-filter-count="all">0</span>
            </button>
            @if (currentEmployeeId.HasValue)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary kanban-filter-btn" data-filter="mine">
                    <i class="bi bi-person-check"></i>
                    <span>Của tôi</span>
                    <span class="kanban-filter-count" data-filter-count="mine">0</span>
                </button>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary kanban-filter-btn" data-filter="blocked">
                <i class="bi bi-slash-circle"></i>
                <span>Bị chặn</span>
                <span class="kanban-filter-count" data-filter-count="blocked">0</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary kanban-filter-btn" data-filter="important">
                <i class="bi bi-exclamation-diamond"></i>
                <span>Ưu tiên</span>
                <span class="kanban-filter-count" data-filter-count="important">0</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary kanban-filter-btn" data-filter="overdue">
                <i class="bi bi-calendar-x"></i>
                <span>Quá hạn</span>
                <span class="kanban-filter-count" data-filter-count="overdue">0</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary kanban-filter-btn" data-filter="ai">
                <i class="bi bi-stars"></i>
                <span>AI</span>
                <span class="kanban-filter-count" data-filter-count="ai">0</span>
            </button>
            <button type="button" id="kanbanFilterReset" class="btn btn-sm btn-outline-secondary" title="Xóa tìm kiếm và bộ lọc Kanban" aria-label="Xóa tìm kiếm và bộ lọc Kanban">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
            <button type="button" id="kanbanFocusToggle" class="btn btn-sm btn-outline-secondary kanban-focus-toggle" aria-pressed="false" title="Ẩn các cột không có task khớp bộ lọc">
                <i class="bi bi-arrows-collapse"></i>
                <span>Gọn cột</span>
            </button>
        </div>
        <div id="kanbanFilterSummary" class="kanban-filter-summary small text-muted ms-auto"></div>
    </div>

    <!-- Kanban Board Grid -->
    <div class="kanban-board">
        @foreach (var status in Model.StatusOptions)
        {
            var tasks = Model.Tasks.Where(t => t.KanbanStatus == status).ToList();
            <section class="kanban-column kanban-column--@status.ToLowerInvariant() d-flex flex-column rounded-4">
                <div class="kanban-column__header d-flex align-items-center justify-content-between p-3 border-bottom">
                    <span class="fw-bold d-flex align-items-center gap-2">
                        <span class="column-dot"></span>
                        @StatusLabel(status)
                    </span>
                    <strong class="badge rounded-pill bg-white border text-dark">@tasks.Count</strong>
                </div>

                <div class="kanban-column__body p-3 flex-grow-1 d-flex flex-column gap-3" data-status="@status" data-drop-label="@StatusLabel(status)">
                    @foreach (var task in tasks)
                    {
                        var assigneeName = task.AssigneeId.HasValue && Model.EmployeeNames.TryGetValue(task.AssigneeId.Value, out var name)
                            ? name
                            : "Chưa gán";
                        var departmentName = task.DepartmentId.HasValue && Model.DepartmentNames.TryGetValue(task.DepartmentId.Value, out var deptName)
                            ? deptName
                            : "Chưa gán";
                        var taskProgress = task.ProgressPercentage ?? 0;
                        var comments = Model.CommentsByTask.TryGetValue(task.Id, out var list) ? list : new List<WorkItemComment>();
                        var isAiGenerated = task.Description?.Contains("[AI Generated]", StringComparison.OrdinalIgnoreCase) == true;
                        var cardDescription = (task.Description ?? string.Empty)
                            .Replace("[AI Generated]", string.Empty, StringComparison.OrdinalIgnoreCase)
                            .Trim();
                        var isOverdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today && task.KanbanStatus != "Done";
                        var deadlineClass = isOverdue ? "text-danger fw-bold" : "text-secondary";
                        
                        <article class="task-card task-card--@((task.Priority ?? "Normal").ToLowerInvariant()) border-0 rounded-3 p-2 shadow-sm bg-white" 
                                 draggable="true"
                                 tabindex="0"
                                 role="button"
                                 aria-label="Mở chi tiết task #@task.Id: @task.Title"
                                 data-task-id="@task.Id"
                                 data-task-status="@task.KanbanStatus"
                                 data-task-priority="@(task.Priority ?? "Normal")"
                                 data-task-assignee-id="@(task.AssigneeId?.ToString() ?? "")"
                                 data-task-due-date="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                                 data-task-overdue="@isOverdue.ToString().ToLowerInvariant()"
                                 data-task-ai="@isAiGenerated.ToString().ToLowerInvariant()"
                                 data-task-created-at="@(task.CreatedAt?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")"
                                 data-task-search="@($"{task.Title} {cardDescription} {assigneeName} {departmentName}")">
                            
                            <div class="task-card__header d-flex justify-content-between align-items-center gap-2 mb-1">
                                <span class="task-id text-muted small">#@task.Id</span>
                                <div class="d-flex align-items-center gap-1">
                                    @if (isAiGenerated)
                                    {
                                        <span class="ai-generated-badge small px-2 py-1 rounded"><i class="bi bi-stars"></i> AI</span>
                                    }
                                    <span class="priority-badge priority-@((task.Priority ?? "Normal").ToLowerInvariant()) small px-2 py-1 rounded">@PriorityLabel(task.Priority)</span>
                                </div>
                            </div>
                            
                            <h6 class="task-title fw-bold mb-2">@task.Title</h6>
                            
                            @if (!string.IsNullOrWhiteSpace(cardDescription))
                            {
                                <p class="task-desc mb-2 text-secondary small line-clamp-1">@cardDescription</p>
                            }
                            
                            <div class="task-meta mb-2 d-flex flex-wrap gap-1 text-muted small">
                                @if (task.AssigneeId.HasValue)
                                {
                                    <div class="meta-item d-flex align-items-center gap-1" title="Người phụ trách: @assigneeName">
                                        <div class="avatar-circle-sm">
                                            <span>@(assigneeName.Length > 0 ? assigneeName[0].ToString().ToUpper() : "U")</span>
                                        </div>
                                        <span class="meta-text text-truncate text-secondary">@assigneeName</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="meta-item d-flex align-items-center gap-1 text-muted" title="Chưa gán">
                                        <i class="bi bi-person-dash text-secondary"></i>
                                        <span class="meta-text">Chưa gán</span>
                                    </div>
                                }
                                
                                <div class="meta-item d-flex align-items-center gap-1" title="Phòng ban: @departmentName">
                                    <i class="bi bi-diagram-3 text-secondary"></i>
                                    <span class="meta-text text-truncate">@departmentName</span>
                                </div>
                                
                                <div class="meta-item d-flex align-items-center gap-1 @deadlineClass" title="Hạn chót">
                                    <i class="bi bi-calendar2-week"></i>
                                    <span class="meta-text">@(task.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có hạn")</span>
                                </div>
                                @if (task.KPIId.HasValue || task.OKRKeyResultId.HasValue)
                                {
                                    <div class="goal-link-list d-flex flex-wrap gap-1 mt-1">
                                        @if (task.KPIId.HasValue && Model.KpiNames.TryGetValue(task.KPIId.Value, out var linkedKpiName))
                                        {
                                            <span class="goal-chip goal-chip--kpi" title="@linkedKpiName"><i class="bi bi-bullseye"></i> KPI</span>
                                        }
                                        @if (task.OKRKeyResultId.HasValue && Model.KeyResultNames.TryGetValue(task.OKRKeyResultId.Value, out var linkedKrName))
                                        {
                                            <span class="goal-chip goal-chip--kr" title="@linkedKrName"><i class="bi bi-crosshair"></i> KR</span>
                                        }
                                    </div>
                                }
                            </div>
                            
                            <div class="task-card__progress mb-2 d-flex align-items-center gap-2" title="Tiến độ: @taskProgress.ToString("0.##")%">
                                <div class="progress flex-grow-1">
                                    <div class="progress-bar rounded" style="width: @taskProgress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <span class="progress-value small fw-semibold text-muted">@taskProgress.ToString("0.##")%</span>
                            </div>
                            
                            <div class="task-card__footer d-flex justify-content-between align-items-center pt-2 border-top border-dashed">
                                <div class="d-flex gap-2 text-muted" style="font-size: 0.8rem;">
                                    <span class="task-comment-count" data-task-id="@task.Id" title="Trao đổi/Bình luận"><i class="bi bi-chat-dots me-1"></i><span data-comment-count-value>@comments.Count</span></span>
                                </div>
                                <span class="task-drag-grip" title="Nắm card để kéo sang cột khác" aria-label="Kéo task sang cột khác">
                                    <i class="bi bi-grip-horizontal" aria-hidden="true"></i>
                                </span>
                            </div>
                        </article>
                    }

                    @if (!tasks.Any())
                    {
                        <div class="kanban-empty text-center py-4 rounded-3 text-muted border border-dashed">Chưa có công việc</div>
                    }
                </div>
            </section>
        }
    </div>

    <div id="kanbanFeedback" class="kanban-feedback-toast" role="status" aria-live="polite" aria-atomic="true"></div>
</div>

<!-- Modal chi tiết công việc cho từng task -->
@foreach (var task in Model.Tasks)
{
    var assigneeName = task.AssigneeId.HasValue && Model.EmployeeNames.TryGetValue(task.AssigneeId.Value, out var name)
        ? name
        : "Chưa gán";
    var departmentName = task.DepartmentId.HasValue && Model.DepartmentNames.TryGetValue(task.DepartmentId.Value, out var deptName)
        ? deptName
        : "Chưa gán";
    var taskProgress = task.ProgressPercentage ?? 0;
    var comments = Model.CommentsByTask.TryGetValue(task.Id, out var list) ? list : new List<WorkItemComment>();
    
    <div class="modal fade task-detail-modal" id="taskModal-@task.Id" tabindex="-1" aria-labelledby="taskModalLabel-@task.Id" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable task-modal-dialog">
            <div class="modal-content task-modal-content border-0 shadow-lg">
                <div class="modal-header task-modal-header border-0">
                    <div class="task-modal-titlebar">
                        <span class="task-modal-id">#@task.Id</span>
                        <div class="task-modal-titlecopy">
                            <h5 class="modal-title task-modal-title fw-bold mb-1 text-truncate" id="taskModalLabel-@task.Id">@task.Title</h5>
                            <div class="task-modal-quickmeta">
                                <span class="quick-chip priority-@((task.Priority ?? "Normal").ToLowerInvariant())">@PriorityLabel(task.Priority)</span>
                                <span class="quick-chip task-status-label">@StatusLabel(task.KanbanStatus)</span>
                                <span class="quick-chip"><i class="bi bi-calendar2-week"></i> @(task.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có hạn")</span>
                                <span class="quick-chip"><i class="bi bi-graph-up"></i> @taskProgress.ToString("0.##")%</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body task-modal-body">
                    <div class="task-modal-layout">
                        <!-- Cột Trái (70%): Form chỉnh sửa chi tiết và comments -->
                        <div class="task-modal-main">
                            <form asp-action="UpdateTask" method="post" id="editForm-@task.Id" class="task-edit-form">
                                <input type="hidden" name="id" value="@task.Id" />
                                
                                <section class="task-edit-section task-edit-section--content">
                                    <div class="task-section-title">Nội dung</div>
                                    <div class="task-content-grid">
                                        <div class="task-content-field">
                                            <label class="form-label fw-bold text-secondary small d-block mb-1">Tên công việc</label>
                                            <input type="text" name="title" value="@task.Title" class="form-control task-title-input" maxlength="220" required />
                                        </div>
                                        <div class="task-content-field">
                                            <label class="form-label fw-bold text-secondary small d-block mb-1">Mô tả công việc</label>
                                            <textarea name="description" class="form-control task-description-input" rows="4" placeholder="Nhập mô tả kết quả mong muốn, tài liệu liên quan..." maxlength="2000">@task.Description</textarea>
                                        </div>
                                    </div>
                                </section>

                                <section class="task-edit-section">
                                    <div class="task-section-title">Phân công</div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Người phụ trách</label>
                                        <select name="assigneeId" class="form-select">
                                            <option value="">Chưa gán</option>
                                            @foreach (var employee in Model.Employees)
                                            {
                                                <option value="@employee.Id" selected="@(employee.Id == task.AssigneeId ? "selected" : null)">@employee.FullName</option>
                                            }
                                        </select>
                                        </div>
                                        <div class="col-md-6">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Phòng ban</label>
                                        <select name="departmentId" class="form-select">
                                            <option value="">Chưa gán phòng ban</option>
                                            @foreach (var department in Model.Departments)
                                            {
                                                <option value="@department.Id" selected="@(department.Id == task.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                                            }
                                        </select>
                                        </div>
                                    </div>
                                </section>

                                <section class="task-edit-section">
                                    <div class="task-section-title">Liên kết mục tiêu</div>
                                    <div class="row g-2">
                                        <div class="col-md-5">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Liên kết KPI</label>
                                        <select name="kpiId" class="form-select">
                                            <option value="">Không liên kết KPI</option>
                                            @foreach (var kpi in Model.KPIs)
                                            {
                                                <option value="@kpi.Id" selected="@(kpi.Id == task.KPIId ? "selected" : null)">@KpiOptionLabel(kpi)</option>
                                            }
                                        </select>
                                        </div>
                                        <div class="col-md-5">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Liên kết Key Result</label>
                                        <select name="okrKeyResultId" class="form-select">
                                            <option value="">Tự lấy từ KPI / Không liên kết</option>
                                            @foreach (var keyResult in Model.KeyResults)
                                            {
                                                <option value="@keyResult.Id" selected="@(keyResult.Id == task.OKRKeyResultId ? "selected" : null)">@KeyResultOptionLabel(keyResult)</option>
                                            }
                                        </select>
                                        </div>
                                        <div class="col-md-2">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Trọng số</label>
                                        <input type="number" name="kpiImpactWeight" class="form-control" min="0.1" max="100" step="0.1" value="@((task.KpiImpactWeight ?? 1).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                                        </div>
                                    </div>
                                </section>
                                
                                <section class="task-edit-section task-edit-section--status">
                                    <div class="task-section-title">Trạng thái</div>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-xl-2 col-md-6">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Độ ưu tiên</label>
                                        <select name="priority" class="form-select">
                                            @foreach (var item in Model.PriorityOptions)
                                            {
                                                <option value="@item" selected="@(item == task.Priority ? "selected" : null)">@PriorityLabel(item)</option>
                                            }
                                        </select>
                                        </div>
                                        <div class="col-xl-2 col-md-6">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Trạng thái</label>
                                        <select name="kanbanStatus" class="form-select">
                                            @foreach (var item in Model.StatusOptions)
                                            {
                                                <option value="@item" selected="@(item == task.KanbanStatus ? "selected" : null)">@StatusLabel(item)</option>
                                            }
                                        </select>
                                        </div>
                                        <div class="col-xl-3 col-md-6">
                                            <label class="form-label fw-bold text-secondary small d-block mb-1">Hạn chót</label>
                                            <input type="date" name="dueDate" class="form-control" value="@(task.DueDate?.ToString("yyyy-MM-dd"))" />
                                        </div>
                                        <div class="col-xl-3 col-md-6">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Tiến độ (@taskProgress.ToString("0.##")%)</label>
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="range" name="progressPercentage" class="form-range flex-grow-1" min="0" max="100" step="5" value="@taskProgress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" oninput="this.nextElementSibling.value = this.value + '%'" />
                                            <output class="fw-semibold text-primary small" style="min-width: 35px;">@taskProgress.ToString("0.##")%</output>
                                        </div>
                                        </div>
                                        <div class="col-xl-2 col-md-12 d-grid">
                                            <button type="submit" class="btn btn-primary task-save-btn"><i class="bi bi-save me-1"></i> Lưu</button>
                                        </div>
                                    </div>
                                </section>
                            </form>
                            
                            <div class="comments task-comments">
                                <div class="task-comments__header">
                                    <h6 class="fw-bold mb-0 text-secondary d-flex align-items-center gap-2">
                                        <i class="bi bi-chat-dots-fill text-primary"></i>
                                        <span>Trao đổi</span>
                                        <span class="task-comment-count-badge" data-task-id="@task.Id" data-comment-count-value>@comments.Count</span>
                                    </h6>
                                </div>
                                
                                <div class="comment-stream-box task-comment-box mb-2" data-task-comment-stream="@task.Id">
                                    @if (!comments.Any())
                                    {
                                        <div class="task-empty-comment text-center text-muted small" data-task-empty-comment="@task.Id">
                                            <i class="bi bi-chat-left-text d-block fs-4 mb-1 opacity-50"></i>
                                            Chưa có thảo luận nào. Nhập tin nhắn bên dưới để trao đổi.
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var comment in comments)
                                        {
                                            var commenter = comment.CommenterId.HasValue && Model.EmployeeNames.TryGetValue(comment.CommenterId.Value, out var commenterName)
                                                ? commenterName
                                                : "Hệ thống";
                                            var isSystem = comment.IsSystem == true;
                                            
                                            <div class="comment task-comment-item @(isSystem ? "comment--system" : "comment--user")" data-comment-id="@comment.Id" data-task-id="@task.Id">
                                                <div class="task-comment-avatar">
                                                    <i class="bi @(isSystem ? "bi-arrow-left-right" : "bi-person-fill")"></i>
                                                </div>
                                                <div class="task-comment-bubble">
                                                    <div class="comment-meta">
                                                        <strong>@commenter</strong>
                                                        <span><i class="bi bi-clock me-1"></i>@(comment.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "")</span>
                                                    </div>
                                                    <div class="comment-text">@comment.CommentText</div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                
                                <form asp-action="AddComment" method="post" class="comment-form" data-task-id="@task.Id">
                                    <input type="hidden" name="taskId" value="@task.Id" />
                                    <div class="input-group">
                                        <input type="text" name="commentText" class="form-control" placeholder="Viết phản hồi, báo cáo vướng mắc hoặc chia sẻ tài liệu..." maxlength="2000" required />
                                        <button type="submit" class="btn btn-primary d-flex align-items-center"><i class="bi bi-send-fill"></i></button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        
                        <aside class="task-modal-aside">
                            <div class="task-summary-panel">
                                <h6 class="fw-bold mb-2 text-secondary"><i class="bi bi-info-circle-fill text-primary"></i> Tổng quan</h6>
                                <div class="task-summary-list">
                                    <div class="summary-row">
                                        <span class="summary-label">Phụ trách</span>
                                        <span class="summary-value"><i class="bi bi-person-fill"></i> @assigneeName</span>
                                    </div>
                                    <div class="summary-row">
                                        <span class="summary-label">Phòng ban</span>
                                        <span class="summary-value"><i class="bi bi-diagram-3-fill"></i> @departmentName</span>
                                    </div>
                                    <div class="summary-row">
                                        <span class="summary-label">Ưu tiên</span>
                                        <span class="summary-value"><span class="priority-badge priority-@((task.Priority ?? "Normal").ToLowerInvariant())">@PriorityLabel(task.Priority)</span></span>
                                    </div>
                                    <div class="summary-row">
                                        <span class="summary-label">Trạng thái</span>
                                        <span class="summary-value"><span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fw-bold px-2 py-1 task-status-summary">@StatusLabel(task.KanbanStatus)</span></span>
                                    </div>
                                    <div class="summary-row">
                                        <span class="summary-label">Hạn chót</span>
                                        <span class="summary-value"><i class="bi bi-calendar-check-fill"></i> @(task.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có hạn")</span>
                                    </div>
                                    <div class="summary-row summary-row--stack">
                                        <span class="summary-label">Mục tiêu</span>
                                        <span class="summary-value summary-value--wrap">
                                            <span><i class="bi bi-bullseye"></i> @(task.KPIId.HasValue && Model.KpiNames.TryGetValue(task.KPIId.Value, out var summaryKpiName) ? summaryKpiName : "Chưa liên kết KPI")</span>
                                            <span><i class="bi bi-crosshair"></i> @(task.OKRKeyResultId.HasValue && Model.KeyResultNames.TryGetValue(task.OKRKeyResultId.Value, out var summaryKrName) ? summaryKrName : "Chưa liên kết KR")</span>
                                            <span class="text-muted">Trọng số: @((task.KpiImpactWeight ?? 1).ToString("0.##"))</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="task-summary-panel task-summary-panel--timeline">
                                <h6 class="fw-bold mb-2 text-secondary small"><i class="bi bi-clock-history text-primary"></i> Dòng thời gian</h6>
                                <div class="task-timeline small text-muted">
                                    <div><i class="bi bi-plus-circle me-2"></i>Tạo: @task.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div><i class="bi bi-arrow-repeat me-2"></i>Cập nhật: @task.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                    @if (task.CompletedAt.HasValue)
                                    {
                                        <div class="text-success"><i class="bi bi-check-circle-fill me-2"></i>Hoàn tất: @task.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    }
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    /* Project Hero & Styles */
    .project-hero {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--card-shadow);
        padding: 14px 16px;
        transition: all var(--transition-base);
    }

    .project-hero__main {
        row-gap: 12px;
    }

    .project-hero__info {
        min-width: 260px;
        flex: 1 1 560px;
    }

    .project-title {
        font-size: 1.2rem;
        line-height: 1.25;
    }

    .project-summary {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 0.86rem;
        line-height: 1.35;
        max-width: 980px;
    }

    .project-hero__side {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-end;
        flex: 0 1 380px;
        min-width: 280px;
    }

    .project-progress-mini {
        width: min(100%, 320px);
    }

    .project-progress-mini .progress {
        height: 6px;
        background-color: var(--border-color);
    }

    .project-code,
    .task-id {
        color: var(--text-muted);
        font-family: var(--font-family);
        font-size: var(--font-size-xs);
        font-weight: 800;
        letter-spacing: 0.05em;
    }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: var(--primary-light);
        color: var(--primary-dark);
        border-radius: 7px;
        padding: 4px 8px;
        font-size: var(--font-size-xs);
        font-weight: 700;
        border: 1px solid rgba(26, 115, 232, 0.08);
        max-width: 240px;
        min-height: 28px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .add-task-card {
        border: 1px solid var(--card-border);
    }

    .add-task-card .card-body {
        min-height: 44px;
    }

    .section-icon {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-md);
        background: var(--primary-light);
        color: var(--primary);
        font-size: 1rem;
        flex: 0 0 auto;
    }

    /* Collapse Icon Indicator Animation */
    .collapse-indicator-btn i {
        transition: transform var(--transition-base);
    }
    #addTaskHeader[aria-expanded="true"] .collapse-indicator-btn i {
        transform: rotate(180deg);
    }

    .kanban-quick-tools {
        min-height: 40px;
    }

    .kanban-search {
        width: min(100%, 420px);
    }

    .kanban-sort {
        width: 190px;
    }

    .kanban-search .input-group-text,
    .kanban-search .form-control,
    .kanban-sort .input-group-text,
    .kanban-sort .form-select,
    .kanban-filter-group .btn {
        border-radius: 8px;
        min-height: 34px;
        font-size: 0.82rem;
    }

    .kanban-search .input-group-text {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .kanban-sort .input-group-text {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .kanban-search .form-control {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .kanban-sort .form-select {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        font-weight: 700;
        color: var(--text-secondary);
    }

    .kanban-filter-group .btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .kanban-filter-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        border-radius: 999px;
        padding: 0 6px;
        background: rgba(15, 23, 42, 0.06);
        color: var(--text-secondary);
        font-size: 0.72rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }

    .kanban-filter-btn.active .kanban-filter-count {
        background: rgba(255, 255, 255, 0.24);
        color: #ffffff;
    }

    .kanban-filter-count.is-zero {
        opacity: 0.48;
    }

    .kanban-focus-toggle.active {
        color: #ffffff;
        background-color: var(--primary);
        border-color: var(--primary);
    }

    .kanban-filter-summary {
        min-width: 108px;
        text-align: right;
    }

    /* Kanban Board Layout */
    .kanban-board {
        display: grid;
        grid-template-columns: repeat(6, 250px);
        gap: 10px;
        overflow-x: auto;
        padding-bottom: 10px;
        align-items: start;
        scrollbar-width: thin;
    }

    .kanban-board.kanban-board--focused {
        grid-template-columns: repeat(var(--kanban-visible-columns, 1), minmax(250px, 320px));
        overflow-x: auto;
    }

    .kanban-column.is-focus-hidden {
        display: none !important;
    }
	
    @@media (min-width: 1200px) {
        .kanban-board {
            grid-template-columns: repeat(6, 1fr);
            overflow-x: visible;
        }

        .kanban-board.kanban-board--focused {
            overflow-x: visible;
        }
    }

    .kanban-column {
        background: #f8fafc;
        border: 1px solid var(--card-border);
        height: clamp(520px, calc(100dvh - 310px), 700px);
        min-height: 0;
        overflow: hidden;
        transition: all var(--transition-base);
        box-shadow: var(--card-shadow);
    }

    /* Column specific top borders to represent state */
    .kanban-column--backlog { border-top: 4px solid var(--text-muted); }
    .kanban-column--todo { border-top: 4px solid var(--info); }
    .kanban-column--inprogress { border-top: 4px solid var(--primary); }
    .kanban-column--review { border-top: 4px solid var(--warning); }
    .kanban-column--done { border-top: 4px solid var(--success); }
    .kanban-column--blocked { border-top: 4px solid var(--danger); }

    .kanban-column__header {
        background: rgba(255, 255, 255, 0.5);
        padding: 10px 12px !important;
        min-height: 44px;
    }

    .kanban-column__header .badge {
        min-width: 28px;
        font-variant-numeric: tabular-nums;
    }

    /* Column dot matches status */
    .column-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }
    .kanban-column--backlog .column-dot { background-color: var(--text-muted); }
    .kanban-column--todo .column-dot { background-color: var(--info); }
    .kanban-column--inprogress .column-dot { background-color: var(--primary); }
    .kanban-column--review .column-dot { background-color: var(--warning); }
    .kanban-column--done .column-dot { background-color: var(--success); }
    .kanban-column--blocked .column-dot { background-color: var(--danger); }

    .kanban-column__body {
        min-height: 0;
        overflow-y: auto;
        padding: 10px !important;
        gap: 10px !important;
        position: relative;
        border: 1px solid transparent;
        transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
        scrollbar-width: thin;
    }

    /* Drag and drop highlight styling */
    .kanban-board--dragging .kanban-column__body {
        background-color: rgba(88, 72, 214, 0.025);
        border-color: rgba(88, 72, 214, 0.14);
    }

    .kanban-column__body.dragover-highlight {
        background-color: rgba(88, 72, 214, 0.07);
        border: 1px dashed rgba(88, 72, 214, 0.58) !important;
        border-radius: var(--radius-md);
        box-shadow: inset 0 0 0 1px rgba(88, 72, 214, 0.12);
    }

    .kanban-column__body.dragover-highlight::before {
        content: "Thả vào " attr(data-drop-label);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        border: 1px dashed rgba(88, 72, 214, 0.34);
        border-radius: 8px;
        background: #ffffff;
        color: var(--primary-dark);
        font-size: 0.78rem;
        font-weight: 800;
        order: -1;
    }

    .kanban-board--dragging .kanban-empty {
        border-color: rgba(88, 72, 214, 0.24) !important;
        background: rgba(255, 255, 255, 0.76);
        color: var(--primary-dark) !important;
    }

    /* Task Cards */
    .task-card {
        cursor: grab;
        border: 1px solid var(--card-border) !important;
        transition: transform var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast);
        user-select: none;
        padding: 10px !important;
    }

    .task-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08) !important;
    }

    .task-card:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }

    .task-card:active {
        cursor: grabbing;
    }

    .task-card.dragging {
        opacity: 0.45;
        transform: scale(0.96);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
    }

    .task-card--syncing {
        opacity: 0.82;
        cursor: progress;
    }

    .task-card--saved {
        animation: taskSavedFlash 900ms ease-out;
    }

    @@keyframes taskSavedFlash {
        0% {
            box-shadow: 0 0 0 0 rgba(15, 122, 77, 0.28);
        }
        35% {
            box-shadow: 0 0 0 3px rgba(15, 122, 77, 0.24);
        }
        100% {
            box-shadow: var(--card-shadow);
        }
    }

    .task-card--urgent { border-color: color-mix(in srgb, var(--danger) 45%, var(--card-border)) !important; }
    .task-card--high { border-color: color-mix(in srgb, var(--warning) 45%, var(--card-border)) !important; }
    .task-card--low { border-color: color-mix(in srgb, var(--success) 45%, var(--card-border)) !important; }
    .task-card--normal { border-color: color-mix(in srgb, var(--info) 45%, var(--card-border)) !important; }

    .task-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 0.86rem;
        line-height: 1.28;
        color: var(--text-primary);
    }

    .task-desc {
        color: var(--text-secondary);
        font-size: 0.76rem;
        line-height: 1.34;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }

    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .avatar-circle-sm {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background-color: var(--primary-light);
        color: var(--primary-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.68rem;
        font-weight: 800;
        flex-shrink: 0;
        border: 1px solid rgba(26, 115, 232, 0.15);
    }

    .task-meta {
        line-height: 1.2;
    }

    .task-meta .meta-item {
        max-width: 100%;
        min-width: 0;
        min-height: 22px;
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 999px;
        background: #ffffff;
        padding: 1px 6px;
    }

    .task-meta .meta-text {
        min-width: 0;
        max-width: 112px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .task-card__progress .progress {
        height: 5px !important;
        background-color: var(--border-color);
    }

    .progress-value {
        font-size: 0.68rem !important;
        min-width: 34px;
        text-align: right;
    }

    .task-card__footer {
        min-height: 24px;
        padding-top: 6px !important;
    }

    .task-drag-grip {
        width: 26px;
        height: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        color: var(--text-muted);
        cursor: grab;
        transition: color var(--transition-fast), background-color var(--transition-fast);
    }

    .task-card:hover .task-drag-grip {
        color: var(--primary);
        background-color: var(--primary-light);
    }

    .priority-badge {
        font-size: 0.65rem;
        font-weight: 800;
