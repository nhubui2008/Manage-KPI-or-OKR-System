@model Manage_KPI_or_OKR_System.Models.ViewModels.WorkProjectBoardViewModel
@{
    ViewData["Title"] = "Kanban dự án";
    var project = Model.Project;
    var selectedDepartmentIds = ViewBag.SelectedDepartmentIds as IEnumerable<int> ?? Enumerable.Empty<int>();
    var selectedDepartments = Model.Departments
        .Where(d => selectedDepartmentIds.Contains(d.Id))
        .Select(d => d.DepartmentName)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .ToList();
    var progress = project.ProgressPercentage ?? 0;
}

<div class="container-fluid p-0 position-relative">
    
    <!-- Loading Overlay -->
    <div id="kanban-loader" class="kanban-loader-overlay d-none">
        <div class="text-center">
            <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-3 text-white fw-bold fs-5">Đang cập nhật trạng thái...</div>
        </div>
    </div>

    <!-- Project Hero Section -->
    <div class="project-hero mb-4 border-0 shadow-sm">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="project-code mb-1">@project.ProjectCode</div>
                <h3 class="mb-2 fw-bold text-primary">@project.ProjectName</h3>
                <p class="text-secondary mb-3">@(!string.IsNullOrWhiteSpace(project.Description) ? project.Description : "Chưa có mô tả dự án.")</p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="meta-chip"><i class="bi bi-flag-fill text-danger"></i> @PriorityLabel(project.Priority)</span>
                    <span class="meta-chip"><i class="bi bi-activity text-primary"></i> @ProjectStatusLabel(project.Status)</span>
                    <span class="meta-chip"><i class="bi bi-calendar-event text-success"></i> @(project.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có deadline")</span>
                    <span class="meta-chip" title="@(selectedDepartments.Any() ? string.Join(", ", selectedDepartments) : "Chưa gán phòng ban")">
                        <i class="bi bi-diagram-3 text-info"></i> @(selectedDepartments.Any() ? string.Join(", ", selectedDepartments) : "Chưa gán phòng ban")
                    </span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"><i class="bi bi-arrow-left"></i> Danh sách</a>
                @if (Model.CanManageProject)
                {
                    <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-primary d-flex align-items-center gap-1"><i class="bi bi-pencil-square"></i> Sửa dự án</a>
                }
            </div>
        </div>

        <div class="mt-4">
            <div class="d-flex justify-content-between small fw-semibold mb-2">
                <span class="text-secondary">Tiến độ tổng hợp từ task</span>
                <span class="text-primary">@progress.ToString("0.##")%</span>
            </div>
            <div class="progress rounded-pill" style="height: 10px; background-color: var(--border-color);">
                <div class="progress-bar progress-bar-striped progress-bar-animated rounded-pill" style="width: @progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
    </div>

    <!-- Collapsible Add Task Form -->
    @if (Model.CanCreateTask)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center cursor-pointer" data-bs-toggle="collapse" data-bs-target="#addTaskCollapse" aria-expanded="false" aria-controls="addTaskCollapse" style="cursor: pointer;" id="addTaskHeader">
                    <div class="d-flex align-items-center gap-2">
                        <span class="section-icon"><i class="bi bi-plus-lg"></i></span>
                        <div>
                            <h5 class="mb-0 fw-bold fs-6">Thêm công việc mới</h5>
                            <p class="text-muted small mb-0 d-none d-md-block">Giao việc cho nhân sự/phòng ban và phân loại mức độ ưu tiên ngay trên Kanban.</p>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary collapse-indicator-btn d-flex align-items-center gap-1">
                        <span>Mở rộng</span> <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                
                <div class="collapse" id="addTaskCollapse">
                    <hr class="my-3 text-muted opacity-25">
                    <form asp-action="CreateTask" method="post" class="row g-3">
                        <input type="hidden" name="projectId" value="@project.Id" />
                        <div class="col-lg-8">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Tên công việc</label>
                            <input type="text" name="title" class="form-control form-control-sm" placeholder="Nhập tên công việc..." maxlength="220" required />
                        </div>
                        <div class="col-lg-4 col-md-12">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Người phụ trách</label>
                            <select name="assigneeId" class="form-select form-select-sm">
                                <option value="">Chưa gán</option>
                                @foreach (var employee in Model.Employees)
                                {
                                    <option value="@employee.Id">@employee.FullName</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-lg-4 col-md-12">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Phòng ban</label>
                            <select name="departmentId" class="form-select form-select-sm" style="width: 100%;">
                                <option value="">Chưa gán</option>
                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department.Id">@department.DepartmentName</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Liên kết KPI</label>
                            <select name="kpiId" class="form-select form-select-sm" style="text-overflow: ellipsis; overflow: hidden; max-width: 100%;" title="">
                                <option value="">Không liên kết</option>
                                @foreach (var kpi in Model.KPIs)
                                {
                                    var label = KpiOptionLabel(kpi);
                                    <option value="@kpi.Id" title="@label">@label</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Liên kết Key Result</label>
                            <select name="okrKeyResultId" class="form-select form-select-sm" style="text-overflow: ellipsis; overflow: hidden; max-width: 100%;" title="">
                                <option value="">Tự lấy theo KPI</option>
                                @foreach (var keyResult in Model.KeyResults)
                                {
                                    var krLabel = KeyResultOptionLabel(keyResult);
                                    <option value="@keyResult.Id" title="@krLabel">@krLabel</option>
                                }
                            </select>
                        </div>

                        <div class="col-lg-3 col-md-3">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Trọng số KPI</label>
                            <input type="number" name="kpiImpactWeight" class="form-control form-control-sm" min="0.1" max="100" step="0.1" value="1" />
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Ưu tiên</label>
                            <select name="priority" class="form-select form-select-sm">
                                @foreach (var item in Model.PriorityOptions)
                                {
                                    <option value="@item" selected="@(item == "Normal" ? "selected" : null)">@PriorityLabel(item)</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Trạng thái</label>
                            <select name="kanbanStatus" class="form-select form-select-sm">
                                @foreach (var item in Model.StatusOptions)
                                {
                                    <option value="@item" selected="@(item == "Todo" ? "selected" : null)">@StatusLabel(item)</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Deadline</label>
                            <input type="date" name="dueDate" class="form-control form-control-sm" />
                        </div>

                        <div class="col-lg-10">
                            <label class="form-label fw-semibold small text-secondary d-block mb-1">Mô tả công việc</label>
                            <input type="text" name="description" class="form-control form-control-sm" maxlength="2000" placeholder="Kết quả mong muốn, tài liệu liên quan, lưu ý phối hợp..." />
                        </div>
                        <div class="col-lg-2 d-grid align-self-end">
                            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm task</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Kanban Board Grid -->
    <div class="kanban-board">
        @foreach (var status in Model.StatusOptions)
        {
            var tasks = Model.Tasks.Where(t => t.KanbanStatus == status).ToList();
            <section class="kanban-column kanban-column--@status.ToLowerInvariant() d-flex flex-column rounded-4">
                <div class="kanban-column__header d-flex align-items-center justify-content-between p-3 border-bottom">
                    <span class="fw-bold d-flex align-items-center gap-2">
                        <span class="column-dot"></span>
                        @StatusLabel(status)
                    </span>
                    <strong class="badge rounded-pill bg-white border text-dark">@tasks.Count</strong>
                </div>

                <div class="kanban-column__body p-3 flex-grow-1 d-flex flex-column gap-3" data-status="@status">
                    @foreach (var task in tasks)
                    {
                        var assigneeName = task.AssigneeId.HasValue && Model.EmployeeNames.TryGetValue(task.AssigneeId.Value, out var name)
                            ? name
                            : "Chưa gán";
                        var departmentName = task.DepartmentId.HasValue && Model.DepartmentNames.TryGetValue(task.DepartmentId.Value, out var deptName)
                            ? deptName
                            : "Chưa gán";
                        var taskProgress = task.ProgressPercentage ?? 0;
                        var comments = Model.CommentsByTask.TryGetValue(task.Id, out var list) ? list : new List<WorkItemComment>();
                        
                        <article class="task-card task-card--@((task.Priority ?? "Normal").ToLowerInvariant()) border-0 rounded-3 p-3 shadow-sm bg-white" 
                                 draggable="true" 
                                 data-task-id="@task.Id">
                            
                            <div class="task-card__header d-flex justify-content-between align-items-center gap-2 mb-2">
                                <span class="task-id text-muted small">#@task.Id</span>
                                <span class="priority-badge priority-@((task.Priority ?? "Normal").ToLowerInvariant()) small px-2 py-1 rounded">@PriorityLabel(task.Priority)</span>
                            </div>
                            
                            <h6 class="task-title fw-bold mb-2">@task.Title</h6>
                            
                            @if (!string.IsNullOrWhiteSpace(task.Description))
                            {
                                <p class="task-desc mb-3 text-secondary small line-clamp-2">@task.Description</p>
                            }
                            
                            <div class="task-meta mb-3 d-flex flex-column gap-1 text-muted small">
                                @if (task.AssigneeId.HasValue)
                                {
                                    <div class="meta-item d-flex align-items-center gap-2" title="Người phụ trách: @assigneeName">
                                        <div class="avatar-circle-sm">
                                            <span>@(assigneeName.Length > 0 ? assigneeName[0].ToString().ToUpper() : "U")</span>
                                        </div>
                                        <span class="meta-text text-truncate text-secondary">@assigneeName</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="meta-item d-flex align-items-center gap-2 text-muted" title="Chưa gán">
                                        <i class="bi bi-person-dash text-secondary"></i>
                                        <span class="meta-text">Chưa gán</span>
                                    </div>
                                }
                                
                                <div class="meta-item d-flex align-items-center gap-2" title="Phòng ban: @departmentName">
                                    <i class="bi bi-diagram-3 text-secondary"></i>
                                    <span class="meta-text text-truncate">@departmentName</span>
                                </div>
                                
                                @{
                                    var isOverdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today && task.KanbanStatus != "Done";
                                    var deadlineClass = isOverdue ? "text-danger fw-bold" : "text-secondary";
                                }
                                <div class="meta-item d-flex align-items-center gap-2 @deadlineClass" title="Hạn chót">
                                    <i class="bi bi-calendar2-week"></i>
                                    <span class="meta-text">@(task.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có hạn")</span>
                                </div>
                                @if (task.KPIId.HasValue || task.OKRKeyResultId.HasValue)
                                {
                                    <div class="goal-link-list d-flex flex-wrap gap-1 mt-1">
                                        @if (task.KPIId.HasValue && Model.KpiNames.TryGetValue(task.KPIId.Value, out var linkedKpiName))
                                        {
                                            <span class="goal-chip goal-chip--kpi" title="@linkedKpiName"><i class="bi bi-bullseye"></i> KPI</span>
                                        }
                                        @if (task.OKRKeyResultId.HasValue && Model.KeyResultNames.TryGetValue(task.OKRKeyResultId.Value, out var linkedKrName))
                                        {
                                            <span class="goal-chip goal-chip--kr" title="@linkedKrName"><i class="bi bi-crosshair"></i> KR</span>
                                        }
                                    </div>
                                }
                            </div>
                            
                            <div class="task-card__progress mb-3">
                                <div class="d-flex justify-content-between small fw-semibold mb-1 text-muted" style="font-size: 0.75rem;">
                                    <span>Tiến độ</span>
                                    <span>@taskProgress.ToString("0.##")%</span>
                                </div>
                                <div class="progress" style="height: 6px; background-color: var(--border-color);">
                                    <div class="progress-bar rounded" style="width: @taskProgress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                            </div>
                            
                            <div class="task-card__footer d-flex justify-content-between align-items-center pt-2 border-top border-dashed">
                                <div class="d-flex gap-2 text-muted" style="font-size: 0.8rem;">
                                    <span title="Trao đổi/Bình luận"><i class="bi bi-chat-dots me-1"></i> @comments.Count</span>
                                </div>
                                
                                <div class="dropdown">
                                    <button class="btn btn-xs btn-outline-secondary dropdown-toggle py-0 px-2 btn-column-change" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.75rem; border-radius: 6px;">
                                        Chuyển cột
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 140px; font-size: 0.8rem; border-radius: 8px;">
                                        @foreach (var nextStatus in Model.StatusOptions.Where(s => s != status))
                                        {
                                            <li>
                                                <form asp-action="UpdateTaskStatus" method="post">
                                                    <input type="hidden" name="id" value="@task.Id" />
                                                    <input type="hidden" name="kanbanStatus" value="@nextStatus" />
                                                    <button type="submit" class="dropdown-item py-1">
                                                        Chuyển sang <strong>@StatusLabel(nextStatus)</strong>
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </article>
                    }

                    @if (!tasks.Any())
                    {
                        <div class="kanban-empty text-center py-4 rounded-3 text-muted border border-dashed">Chưa có công việc</div>
                    }
                </div>
            </section>
        }
    </div>
</div>

<!-- Modal chi tiết công việc cho từng task -->
@foreach (var task in Model.Tasks)
{
    var assigneeName = task.AssigneeId.HasValue && Model.EmployeeNames.TryGetValue(task.AssigneeId.Value, out var name)
        ? name
        : "Chưa gán";
    var departmentName = task.DepartmentId.HasValue && Model.DepartmentNames.TryGetValue(task.DepartmentId.Value, out var deptName)
        ? deptName
        : "Chưa gán";
    var taskProgress = task.ProgressPercentage ?? 0;
    var comments = Model.CommentsByTask.TryGetValue(task.Id, out var list) ? list : new List<WorkItemComment>();
    
    <div class="modal fade task-detail-modal" id="taskModal-@task.Id" tabindex="-1" aria-labelledby="taskModalLabel-@task.Id" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 90% !important;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header bg-light border-0 py-3 px-4" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary text-white fw-bold">#@task.Id</span>
                        <h5 class="modal-title fw-bold mb-0 text-truncate text-primary" id="taskModalLabel-@task.Id" style="max-width: 500px;">@task.Title</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <!-- Cột Trái (70%): Form chỉnh sửa chi tiết và comments -->
                        <div class="col-lg-8 border-end border-light-subtle pe-lg-4">
                            <form asp-action="UpdateTask" method="post" id="editForm-@task.Id" class="mb-4">
                                <input type="hidden" name="id" value="@task.Id" />
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-secondary small d-block mb-1">Tên công việc</label>
                                    <input type="text" name="title" value="@task.Title" class="form-control" maxlength="220" required />
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-secondary small d-block mb-1">Mô tả công việc</label>
                                    <textarea name="description" class="form-control" rows="3" placeholder="Nhập mô tả kết quả mong muốn, tài liệu liên quan..." maxlength="2000">@task.Description</textarea>
                                </div>
                                
                                <div class="row g-3 mb-3">
                                    <div class="col-sm-4">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Người phụ trách</label>
                                        <select name="assigneeId" class="form-select">
                                            <option value="">Chưa gán</option>
                                            @foreach (var employee in Model.Employees)
                                            {
                                                <option value="@employee.Id" selected="@(employee.Id == task.AssigneeId ? "selected" : null)">@employee.FullName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-8">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Phòng ban</label>
                                        <select name="departmentId" class="form-select">
                                            <option value="">Chưa gán phòng ban</option>
                                            @foreach (var department in Model.Departments)
                                            {
                                                <option value="@department.Id" selected="@(department.Id == task.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-5">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Liên kết KPI</label>
                                        <select name="kpiId" class="form-select">
                                            <option value="">Không liên kết KPI</option>
                                            @foreach (var kpi in Model.KPIs)
                                            {
                                                <option value="@kpi.Id" selected="@(kpi.Id == task.KPIId ? "selected" : null)">@KpiOptionLabel(kpi)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Liên kết Key Result</label>
                                        <select name="okrKeyResultId" class="form-select">
                                            <option value="">Tự lấy từ KPI / Không liên kết</option>
                                            @foreach (var keyResult in Model.KeyResults)
                                            {
                                                <option value="@keyResult.Id" selected="@(keyResult.Id == task.OKRKeyResultId ? "selected" : null)">@KeyResultOptionLabel(keyResult)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Trọng số</label>
                                        <input type="number" name="kpiImpactWeight" class="form-control" min="0.1" max="100" step="0.1" value="@((task.KpiImpactWeight ?? 1).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                                    </div>
                                </div>
                                
                                <div class="row g-3 mb-4">
                                    <div class="col-6 col-sm-4">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Độ ưu tiên</label>
                                        <select name="priority" class="form-select">
                                            @foreach (var item in Model.PriorityOptions)
                                            {
                                                <option value="@item" selected="@(item == task.Priority ? "selected" : null)">@PriorityLabel(item)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Trạng thái</label>
                                        <select name="kanbanStatus" class="form-select">
                                            @foreach (var item in Model.StatusOptions)
                                            {
                                                <option value="@item" selected="@(item == task.KanbanStatus ? "selected" : null)">@StatusLabel(item)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-4">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Tiến độ (@taskProgress.ToString("0.##")%)</label>
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="range" name="progressPercentage" class="form-range flex-grow-1" min="0" max="100" step="5" value="@taskProgress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" oninput="this.nextElementSibling.value = this.value + '%'" />
                                            <output class="fw-semibold text-primary small" style="min-width: 35px;">@taskProgress.ToString("0.##")%</output>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label fw-bold text-secondary small d-block mb-1">Hạn chót</label>
                                        <input type="date" name="dueDate" class="form-control" value="@(task.DueDate?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                    <div class="col-md-4 d-grid align-self-end">
                                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Lưu thay đổi</button>
                                    </div>
                                </div>
                            </form>
                            
                            <!-- Thảo luận trao đổi (Comments) -->
                            <hr class="my-4 text-muted opacity-25">
                            <div class="comments">
                                <h6 class="fw-bold mb-3 text-secondary d-flex align-items-center gap-2">
                                    <i class="bi bi-chat-dots-fill text-primary"></i> Trao đổi & Thảo luận (@comments.Count)
                                </h6>
                                
                                <div class="comment-stream-box mb-3 pe-2 border rounded-3 p-3 bg-light" style="max-height: 250px; overflow-y: auto; scrollbar-width: thin;">
                                    @if (!comments.Any())
                                    {
                                        <div class="text-center text-muted py-4 small">
                                            <i class="bi bi-chat-left-text d-block fs-3 mb-2 opacity-50"></i>
                                            Chưa có thảo luận nào. Nhập tin nhắn bên dưới để trao đổi.
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var comment in comments)
                                        {
                                            var commenter = comment.CommenterId.HasValue && Model.EmployeeNames.TryGetValue(comment.CommenterId.Value, out var commenterName)
                                                ? commenterName
                                                : "Hệ thống";
                                            var isSystem = comment.IsSystem == true;
                                            
                                            <div class="comment mb-2 p-2 rounded-3 @(isSystem ? "comment--system bg-primary-subtle text-primary-emphasis" : "comment--user bg-white border shadow-sm")">
                                                <div class="comment-meta d-flex justify-content-between align-items-center mb-1" style="font-size: 0.72rem;">
                                                    <strong class="text-secondary"><i class="bi @(isSystem ? "bi-cpu-fill" : "bi-person-fill") me-1"></i>@commenter</strong>
                                                    <span class="text-muted"><i class="bi bi-clock me-1"></i>@(comment.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "")</span>
                                                </div>
                                                <div class="comment-text small" style="white-space: pre-wrap;">@comment.CommentText</div>
                                            </div>
                                        }
                                    }
                                </div>
                                
                                <form asp-action="AddComment" method="post" class="comment-form">
                                    <input type="hidden" name="taskId" value="@task.Id" />
                                    <div class="input-group">
                                        <input type="text" name="commentText" class="form-control" placeholder="Viết phản hồi, báo cáo vướng mắc hoặc chia sẻ tài liệu..." maxlength="2000" required />
                                        <button type="submit" class="btn btn-primary d-flex align-items-center"><i class="bi bi-send-fill"></i></button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        
                        <!-- Cột Phải (30%): Tóm tắt trạng thái và timeline -->
                        <div class="col-lg-4 ps-lg-3">
                            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-info-circle-fill text-primary"></i> Tổng quan nhanh</h6>
                            
                            <div class="card bg-light border-0 mb-4" style="border-radius: 12px;">
                                <div class="card-body p-3 small d-flex flex-column gap-3">
                                    <div>
                                        <span class="text-muted d-block font-monospace mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Người phụ trách</span>
                                        <span class="fw-semibold text-secondary d-flex align-items-center gap-1">
                                            <i class="bi bi-person-fill"></i> @assigneeName
                                        </span>
                                    </div>
                                    <div>
                                        <span class="text-muted d-block font-monospace mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Phòng ban phụ trách</span>
                                        <span class="fw-semibold text-secondary d-flex align-items-center gap-1">
                                            <i class="bi bi-diagram-3-fill"></i> @departmentName
                                        </span>
                                    </div>
                                    <div>
                                        <span class="text-muted d-block font-monospace mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Mức độ ưu tiên</span>
                                        <span class="priority-badge priority-@((task.Priority ?? "Normal").ToLowerInvariant())">@PriorityLabel(task.Priority)</span>
                                    </div>
                                    <div>
                                        <span class="text-muted d-block font-monospace mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Trạng thái hiện tại</span>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fw-bold px-2 py-1">@StatusLabel(task.KanbanStatus)</span>
                                    </div>
                                    <div>
                                        <span class="text-muted d-block font-monospace mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Thời hạn hoàn thành</span>
                                        <span class="fw-semibold text-secondary d-flex align-items-center gap-1">
                                            <i class="bi bi-calendar-check-fill"></i> @(task.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có hạn")
                                        </span>
                                    </div>
                                    <div>
                                        <span class="text-muted d-block font-monospace mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Đồng bộ mục tiêu</span>
                                        <div class="d-flex flex-column gap-1">
                                            <span class="fw-semibold text-secondary d-flex align-items-center gap-1">
                                                <i class="bi bi-bullseye"></i>
                                                @(task.KPIId.HasValue && Model.KpiNames.TryGetValue(task.KPIId.Value, out var summaryKpiName) ? summaryKpiName : "Chưa liên kết KPI")
                                            </span>
                                            <span class="fw-semibold text-secondary d-flex align-items-center gap-1">
                                                <i class="bi bi-crosshair"></i>
                                                @(task.OKRKeyResultId.HasValue && Model.KeyResultNames.TryGetValue(task.OKRKeyResultId.Value, out var summaryKrName) ? summaryKrName : "Chưa liên kết KR")
                                            </span>
                                            <span class="text-muted small">Trọng số: @((task.KpiImpactWeight ?? 1).ToString("0.##"))</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <h6 class="fw-bold mb-2 text-secondary small"><i class="bi bi-clock-history text-primary"></i> Dòng thời gian</h6>
                            <div class="ps-2 small text-muted font-monospace" style="font-size: 0.75rem; line-height: 1.8;">
                                <div><i class="bi bi-plus-circle me-2"></i>Tạo lúc: @task.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                <div><i class="bi bi-arrow-repeat me-2"></i>Cập nhật: @task.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                @if (task.CompletedAt.HasValue)
                                {
                                    <div class="text-success"><i class="bi bi-check-circle-fill me-2"></i>Hoàn tất: @task.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    /* Project Hero & Styles */
    .project-hero {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--card-shadow);
        padding: 24px;
        transition: all var(--transition-base);
    }

    .project-code,
    .task-id {
        color: var(--text-muted);
        font-family: var(--font-family);
        font-size: var(--font-size-xs);
        font-weight: 800;
        letter-spacing: 0.05em;
    }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--primary-light);
        color: var(--primary-dark);
        border-radius: 8px;
        padding: 6px 12px;
        font-size: var(--font-size-xs);
        font-weight: 700;
        border: 1px solid rgba(26, 115, 232, 0.08);
    }

    .section-icon {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-md);
        background: var(--primary-light);
        color: var(--primary);
        font-size: 1rem;
        flex: 0 0 auto;
    }

    /* Collapse Icon Indicator Animation */
    .collapse-indicator-btn i {
        transition: transform var(--transition-base);
    }
    #addTaskHeader[aria-expanded="true"] .collapse-indicator-btn i {
        transform: rotate(180deg);
    }

    /* Kanban Board Layout */
    .kanban-board {
        display: grid;
        grid-template-columns: repeat(6, 250px);
        gap: 12px;
        overflow-x: auto;
        padding-bottom: 16px;
        align-items: start;
        scrollbar-width: thin;
    }

    @@media (min-width: 1200px) {
        .kanban-board {
            grid-template-columns: repeat(6, 1fr);
            overflow-x: visible;
        }
    }

    .kanban-column {
        background: #f8fafc;
        border: 1px solid var(--card-border);
        min-height: 550px;
        transition: all var(--transition-base);
        box-shadow: var(--card-shadow);
    }

    /* Column specific top borders to represent state */
    .kanban-column--backlog { border-top: 4px solid var(--text-muted); }
    .kanban-column--todo { border-top: 4px solid var(--info); }
    .kanban-column--inprogress { border-top: 4px solid var(--primary); }
    .kanban-column--review { border-top: 4px solid var(--warning); }
    .kanban-column--done { border-top: 4px solid var(--success); }
    .kanban-column--blocked { border-top: 4px solid var(--danger); }

    .kanban-column__header {
        background: rgba(255, 255, 255, 0.5);
    }

    /* Column dot matches status */
    .column-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }
    .kanban-column--backlog .column-dot { background-color: var(--text-muted); }
    .kanban-column--todo .column-dot { background-color: var(--info); }
    .kanban-column--inprogress .column-dot { background-color: var(--primary); }
    .kanban-column--review .column-dot { background-color: var(--warning); }
    .kanban-column--done .column-dot { background-color: var(--success); }
    .kanban-column--blocked .column-dot { background-color: var(--danger); }

    .kanban-column__body {
        min-height: 480px;
        transition: background-color var(--transition-fast), border var(--transition-fast);
    }

    /* Drag and drop highlight styling */
    .kanban-column__body.dragover-highlight {
        background-color: rgba(26, 115, 232, 0.05);
        border: 2px dashed var(--primary) !important;
        border-radius: var(--radius-md);
    }

    /* Task Cards */
    .task-card {
        cursor: grab;
        border-left: 4px solid var(--primary) !important;
        transition: transform var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast);
        user-select: none;
    }

    .task-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08) !important;
    }

    .task-card:active {
        cursor: grabbing;
    }

    .task-card.dragging {
        opacity: 0.45;
        transform: scale(0.96);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
    }

    .task-card--urgent { border-left-color: var(--danger) !important; }
    .task-card--high { border-left-color: var(--warning) !important; }
    .task-card--low { border-left-color: var(--success) !important; }
    .task-card--normal { border-left-color: var(--info) !important; }

    .task-title {
        font-size: 0.92rem;
        line-height: 1.4;
        color: var(--text-primary);
    }

    .task-desc {
        color: var(--text-secondary);
        font-size: 0.8rem;
        line-height: 1.45;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }

    .avatar-circle-sm {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background-color: var(--primary-light);
        color: var(--primary-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.68rem;
        font-weight: 800;
        flex-shrink: 0;
        border: 1px solid rgba(26, 115, 232, 0.15);
    }

    .priority-badge {
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .priority-low { background: #eef7ee; color: var(--success); }
    .priority-normal { background: #eef4ff; color: var(--info); }
    .priority-high { background: #fff4e5; color: var(--warning); }
    .priority-urgent { background: #fdecec; color: var(--danger); }

    .goal-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border-radius: 6px;
        padding: 3px 6px;
        font-size: 0.65rem;
        font-weight: 800;
        border: 1px solid transparent;
    }

    .goal-chip--kpi {
        background: #eef4ff;
        border-color: rgba(26, 115, 232, 0.16);
        color: var(--primary-dark);
    }

    .goal-chip--kr {
        background: #e7f6ef;
        border-color: rgba(15, 122, 77, 0.16);
        color: #0f7a4d;
    }

    .btn-xs {
        padding: 2px 6px;
        font-size: 0.72rem;
    }

    .border-dashed {
        border-top-style: dashed !important;
    }

    /* Comment Section Styles */
    .comment {
        border-left: 3px solid transparent;
        transition: background-color var(--transition-fast);
    }
    .comment--system {
        border-left-color: var(--primary);
    }
    .comment--user {
        border-left-color: var(--card-border);
    }

    .kanban-empty {
        background: transparent;
        font-size: 0.8rem;
    }

    /* Global Loader overlay during Drag & Drop status updates */
    .kanban-loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(13, 33, 55, 0.65);
        z-index: 1060;
        display: flex;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(4px);
        transition: opacity var(--transition-base);
    }

    /* Modal Layout improvements */
    .task-detail-modal .modal-body {
        background-color: #ffffff;
    }

    .task-detail-modal select, 
    .task-detail-modal input[type="text"], 
    .task-detail-modal input[type="date"],
    .task-detail-modal textarea {
        font-size: 0.875rem;
        border-radius: 8px;
    }

    /* Removed max-width media query to prevent horizontal scroll override on desktop */
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Loader overlay controller
            const loader = document.getElementById('kanban-loader');
            function showLoader(show) {
                if (show) {
                    loader.classList.remove('d-none');
                } else {
                    loader.classList.add('d-none');
                }
            }

            // --- DRAG AND DROP HANDLERS ---
            let draggedTaskId = null;
            let isDragging = false;

            const cards = document.querySelectorAll('.task-card');
            const columns = document.querySelectorAll('.kanban-column__body');

            cards.forEach(card => {
                card.addEventListener('dragstart', function(e) {
                    isDragging = true;
                    draggedTaskId = this.dataset.taskId;
                    this.classList.add('dragging');
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', draggedTaskId);
                });

                card.addEventListener('dragend', function() {
                    this.classList.remove('dragging');
                    columns.forEach(col => {
                        col.classList.remove('dragover-highlight');
                    });
                    setTimeout(() => {
                        isDragging = false;
                    }, 100);
                });

                // Open modal on click (but prevent if dragging or clicking buttons/dropdown)
                card.addEventListener('click', function(e) {
                    if (isDragging) return;
                    
                    // Avoid opening modal if clicking dropdown button or its menu item
                    if (e.target.closest('.dropdown') || e.target.closest('button') || e.target.closest('a') || e.target.closest('form')) {
                        return;
                    }

                    const taskId = this.dataset.taskId;
                    const modalElement = document.getElementById(`taskModal-${taskId}`);
                    if (modalElement) {
                        const modalInstance = new bootstrap.Modal(modalElement);
                        modalInstance.show();
                    }
                });
            });

            columns.forEach(column => {
                column.addEventListener('dragover', function(e) {
                    e.preventDefault(); // Required to allow drop
                    this.classList.add('dragover-highlight');
                });

                column.addEventListener('dragleave', function() {
                    this.classList.remove('dragover-highlight');
                });

                column.addEventListener('drop', function(e) {
                    e.preventDefault();
                    this.classList.remove('dragover-highlight');
                    
                    const taskId = e.dataTransfer.getData('text/plain') || draggedTaskId;
                    const newStatus = this.dataset.status;
                    
                    if (!taskId || !newStatus) return;
                    
                    // Retrieve origin column to prevent unnecessary server updates
                    const cardElement = document.querySelector(`.task-card[data-task-id="${taskId}"]`);
                    const originalStatus = cardElement ? cardElement.closest('.kanban-column__body').dataset.status : null;
                    
                    if (newStatus === originalStatus) return;

                    // Send AJAX post update status
                    updateTaskStatusAjax(taskId, newStatus);
                });
            });

            function updateTaskStatusAjax(taskId, targetStatus) {
                const antiForgeryToken = document.querySelector('#globalAntiForgeryForm input[name="__RequestVerificationToken"]')?.value;
                if (!antiForgeryToken) {
                    console.error('Anti-forgery token not found.');
                    return;
                }

                const formData = new FormData();
                formData.append('id', taskId);
                formData.append('kanbanStatus', targetStatus);
                formData.append('__RequestVerificationToken', antiForgeryToken);

                showLoader(true);

                fetch('/WorkProjects/UpdateTaskStatus', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (response.ok) {
                        // Success toast and page reload
                        if (window.showAppToast) {
                            window.showAppToast({
                                message: 'Đã cập nhật trạng thái công việc thành công.',
                                tone: 'success',
                                eyebrow: 'Hoàn tất',
                                title: 'Thành công'
                            });
                        }
                        window.location.reload();
                    } else {
                        showLoader(false);
                        Swal.fire({
                            title: 'Cảnh báo!',
                            text: 'Không thể cập nhật trạng thái công việc. Vui lòng kiểm tra quyền hạn của bạn.',
                            icon: 'warning',
                            confirmButtonText: 'Đồng ý'
                        });
                    }
                })
                .catch(error => {
                    console.error(error);
                    showLoader(false);
                    Swal.fire({
                        title: 'Lỗi hệ thống!',
                        text: 'Có lỗi xảy ra trong quá trình gửi yêu cầu cập nhật.',
                        icon: 'error',
                        confirmButtonText: 'Đồng ý'
                    });
                });
            }

            // --- AUTO SCROLL COMMENTS TO BOTTOM WHEN MODAL IS SHOWN ---
            const modals = document.querySelectorAll('.task-detail-modal');
            modals.forEach(modal => {
                modal.addEventListener('shown.bs.modal', function () {
                    const commentBox = this.querySelector('.comment-stream-box');
                    if (commentBox) {
                        commentBox.scrollTop = commentBox.scrollHeight;
                    }
                });
            });
        });
    </script>
}

@functions {
    private static string StatusLabel(string? value) => value switch
    {
        "Backlog" => "Backlog",
        "Todo" => "Cần làm",
        "InProgress" => "Đang làm",
        "Review" => "Chờ review",
        "Done" => "Hoàn thành",
        "Blocked" => "Đang vướng",
        _ => "Cần làm"
    };

    private static string StatusShortLabel(string? value) => value switch
    {
        "Backlog" => "Backlog",
        "Todo" => "Todo",
        "InProgress" => "Doing",
        "Review" => "Review",
        "Done" => "Done",
        "Blocked" => "Block",
        _ => "Todo"
    };

    private static string PriorityLabel(string? value) => value switch
    {
        "Low" => "Thấp",
        "High" => "Cao",
        "Urgent" => "Khẩn cấp",
        _ => "Bình thường"
    };

    private static string ProjectStatusLabel(string? value) => value switch
    {
        "Planning" => "Lên kế hoạch",
        "OnHold" => "Tạm dừng",
        "Completed" => "Hoàn thành",
        "Archived" => "Lưu trữ",
        _ => "Đang chạy"
    };

    private static string KpiOptionLabel(KPI kpi)
    {
        var name = !string.IsNullOrWhiteSpace(kpi.KPIName) ? kpi.KPIName : $"KPI #{kpi.Id}";
        var truncated = name.Length > 25 ? name.Substring(0, 25) + "…" : name;
        return $"{truncated} (#{kpi.Id})";
    }

    private static string KeyResultOptionLabel(OKRKeyResult keyResult)
    {
        var name = !string.IsNullOrWhiteSpace(keyResult.KeyResultName) ? keyResult.KeyResultName : $"KR #{keyResult.Id}";
        var truncated = name.Length > 25 ? name.Substring(0, 25) + "…" : name;
        return $"{truncated} (#{keyResult.Unit ?? "%"})";
    }
}
