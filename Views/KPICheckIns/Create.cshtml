@model Manage_KPI_or_OKR_System.Models.KPICheckIn
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var employees = ViewBag.AllEmployees as List<Manage_KPI_or_OKR_System.Models.Employee> ?? new();
    var kpis = ViewBag.AllKPIs as List<Manage_KPI_or_OKR_System.Models.KPI> ?? new();
    var failReasons = ViewBag.FailReasons as List<Manage_KPI_or_OKR_System.Models.FailReason> ?? new();
    var kpiData = ViewBag.KPIData as Dictionary<int, Manage_KPI_or_OKR_System.Models.KPIDetail> ?? new();
    var kpiPeriods = ViewBag.KPIPeriods as Dictionary<int, Manage_KPI_or_OKR_System.Models.EvaluationPeriod> ?? new();
    var assignmentWeights = ViewBag.AssignmentWeights as Dictionary<int, Dictionary<int, decimal>> ?? new();
    var employeeKpiIds = ViewBag.EmployeeKPIIds as Dictionary<int, List<int>> ?? new();
    var kpisById = kpis.ToDictionary(kpi => kpi.Id);

    var kpiDataJson = JsonSerializer.Serialize(kpiData.ToDictionary(item => item.Key, item => new
    {
        target = item.Value.TargetValue,
        unit = item.Value.MeasurementUnit,
        isInverse = item.Value.IsInverse,
        frequencyDays = item.Value.CheckInFrequencyDays ?? 1,
        deadlineDate = item.Value.DeadlineDate,
        deadlineTime = (item.Value.CheckInDeadlineTime ?? new TimeSpan(10, 0, 0)).ToString(@"hh\:mm"),
        reminderBeforeHours = item.Value.ReminderBeforeHours ?? 24,
        periodStart = kpisById.ContainsKey(item.Key) && kpisById[item.Key].PeriodId.HasValue && kpiPeriods.ContainsKey(kpisById[item.Key].PeriodId!.Value)
            ? kpiPeriods[kpisById[item.Key].PeriodId!.Value].StartDate
            : null,
        periodEnd = kpisById.ContainsKey(item.Key) && kpisById[item.Key].PeriodId.HasValue && kpiPeriods.ContainsKey(kpisById[item.Key].PeriodId!.Value)
            ? kpiPeriods[kpisById[item.Key].PeriodId!.Value].EndDate
            : null
    }));
    var assignmentWeightsJson = JsonSerializer.Serialize(assignmentWeights);
    var employeeKpiIdsJson = JsonSerializer.Serialize(employeeKpiIds);
    var kpiOptionsJson = JsonSerializer.Serialize(kpis.Select(kpi => new
    {
        id = kpi.Id,
        name = kpi.KPIName ?? $"KPI #{kpi.Id}"
    }));
    var progressSnapshotsJson = ViewBag.ProgressSnapshotsJson as string ?? "{}";
    string progressPageTitle = "Cập nhật tiến độ KPI";
    string progressActionLabel = "Gửi check-in chờ duyệt";
    string? requestedReturnUrl = ViewBag.ReturnUrl as string;
    string safeReturnUrl = !string.IsNullOrWhiteSpace(requestedReturnUrl) && Url.IsLocalUrl(requestedReturnUrl)
        ? requestedReturnUrl
        : Url.Action("Index") ?? "/KPICheckIns";
    ViewData["Title"] = progressPageTitle;
}

<link rel="stylesheet" href="~/css/velzon-kpi.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/velzon-kpi-checkins.css" asp-append-version="true" />

<div class="cf-page checkin-create-page kpi-checkins-wrapper" data-create-form>
    <!-- PAGE TITLE HEADER -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between mb-3 evaluation-page-header">
                <div>
                    <h4 class="mb-sm-0 fw-bold">@progressPageTitle</h4>
                    <ol class="breadcrumb m-0 me-3 evaluation-breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Check-in KPI</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Cập nhật mới</li>
                    </ol>
                </div>
                <div class="page-title-right">
                    <a href="@safeReturnUrl" class="btn btn-soft-secondary btn-sm rounded-pill px-3 d-flex align-items-center gap-1">
                        <i class="bi bi-arrow-left"></i>
                        <span>Quay lại</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="checkInFormHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="checkInFormHeading">Thông tin check-in</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
                <span class="ci-form-status"><i class="bi bi-calculator" aria-hidden="true"></i> Tính tự động</span>
            </div>

            <form id="checkinForm" asp-action="Create" method="post" class="cf-form" data-create-form-element>
                @Html.AntiForgeryToken()
                <input type="hidden" name="SubmissionId" value="@Guid.NewGuid()" />
                <input type="hidden" name="returnUrl" value="@safeReturnUrl" />
                <div asp-validation-summary="All" class="cf-alert" role="alert" tabindex="-1" data-error-summary></div>

                <section class="cf-section" aria-labelledby="checkInScopeHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-person-check"></i></span>
                        <div>
                            <h3 id="checkInScopeHeading">Phạm vi báo cáo</h3>
                            <p>Chọn đúng người thực hiện; danh sách KPI sẽ tự lọc theo phân bổ hiện hành.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label for="employeeSelect">Nhân viên <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <select asp-for="EmployeeId" id="employeeSelect" class="form-select cf-control no-select2" required aria-describedby="employeeHint">
                                @if (employees.Count != 1)
                                {
                                    <option value="">Chọn nhân viên</option>
                                }
                                @foreach (var employee in employees)
                                {
                                    <option value="@employee.Id" selected="@((Model.EmployeeId == employee.Id || employees.Count == 1) ? "selected" : null)">@employee.FullName (@employee.EmployeeCode)</option>
                                }
                            </select>
                            <span asp-validation-for="EmployeeId" class="cf-validation"></span>
                            <p id="employeeHint" class="cf-hint">Bạn chỉ có thể ghi nhận cho nhân viên thuộc phạm vi được phép quản lý.</p>
                            @if (!employees.Any())
                            {
                                <div class="cf-empty-state" role="alert"><i class="bi bi-person-x" aria-hidden="true"></i><span>Không có nhân viên phù hợp trong phạm vi hiện tại.</span></div>
                            }
                        </div>

                        <div class="cf-field">
                            <label for="kpiSelect">KPI cần cập nhật <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <select asp-for="KPIId" id="kpiSelect" class="form-select cf-control no-select2" required aria-describedby="kpiHint">
                                @if (kpis.Count != 1)
                                {
                                    <option value="">Chọn nhân viên trước</option>
                                }
                                @foreach (var kpi in kpis)
                                {
                                    <option value="@kpi.Id" selected="@((Model.KPIId == kpi.Id || kpis.Count == 1) ? "selected" : null)">@kpi.KPIName</option>
                                }
                            </select>
                            <span asp-validation-for="KPIId" class="cf-validation"></span>
                            <p id="kpiHint" class="cf-hint">Chỉ KPI đang thực hiện và đã phân bổ cho nhân viên mới xuất hiện.</p>
                            @if (!kpis.Any())
                            {
                                <div class="cf-empty-state" role="alert"><i class="bi bi-speedometer" aria-hidden="true"></i><span>Không có KPI đang thực hiện để check-in.</span></div>
                            }
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="checkInResultHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-graph-up-arrow"></i></span>
                        <div>
                            <h3 id="checkInResultHeading">Kết quả thực hiện</h3>
                            <p>Nhập số liệu đã đạt tới thời điểm hiện tại; hệ thống tự tính trạng thái và tiến độ.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid ci-result-grid">
                        <div class="cf-field">
                            <label for="achievedInput">Kết quả lũy kế <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <div class="input-group ci-measurement-input">
                                <input type="number" step="0.01" min="0" name="AchievedValue" id="achievedInput"
                                       class="form-control cf-control measurement-value-input" data-measurement-role="achieved"
                                       data-measurement-suffix-target="achievedUnitSuffix" placeholder="Ví dụ: 82"
                                       aria-describedby="achievedHint" required data-val="true"
                                       data-val-required="Vui lòng nhập kết quả đạt được."
                                       data-val-number="Kết quả đạt được phải là số hợp lệ."
                                       data-msg-required="Vui lòng nhập kết quả đạt được."
                                       data-msg-min="Kết quả đạt được không thể là số âm."
                                       value="@ViewBag.AchievedValue" />
                                <span class="input-group-text measurement-unit-suffix" id="achievedUnitSuffix">đơn vị</span>
                            </div>
                            @Html.ValidationMessage("AchievedValue", null, new { @class = "cf-validation" })
                            <p id="achievedHint" class="cf-hint">Nhập tổng giá trị hiện tại của KPI, không phải riêng phần tăng thêm từ lần trước.</p>
                        </div>

                        <div class="cf-inline-note ci-status-note" role="status">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <div>
                                <strong>Trạng thái do hệ thống xác định</strong>
                                <span>Dựa trên kết quả lũy kế, deadline, chiều đánh giá và lý do chưa đạt.</span>
                            </div>
                        </div>
                    </div>

                    <div class="cf-field">
                        <div class="cf-label-row">
                            <label for="checkInNote">Chi tiết và trở ngại</label>
                            <span class="cf-selection-count">Tùy chọn</span>
                        </div>
                        <textarea id="checkInNote" name="Note" class="form-control cf-control" rows="4" maxlength="2000"
                                  placeholder="Mô tả kết quả, nguồn số liệu, khó khăn hoặc hỗ trợ đang cần...">@ViewBag.Note</textarea>
                        @Html.ValidationMessage("Note", null, new { @class = "cf-validation" })
                        <p class="cf-hint">Ghi rõ nguyên nhân và hành động tiếp theo khi tiến độ thấp hơn kế hoạch.</p>
                    </div>

                    <div class="cf-field">
                        <label asp-for="FailReasonId">Lý do chính nếu chưa đạt</label>
                        <select asp-for="FailReasonId" class="form-select cf-control no-select2" aria-describedby="failReasonHint">
                            <option value="">Không có / Đang đúng kế hoạch</option>
                            @foreach (var reason in failReasons)
                            {
                                <option value="@reason.Id">@reason.ReasonName</option>
                            }
                        </select>
                        <span asp-validation-for="FailReasonId" class="cf-validation"></span>
                        <p id="failReasonHint" class="cf-hint">Chọn một lý do chuẩn để báo cáo rủi ro được tổng hợp chính xác.</p>
                    </div>
                </section>

                <div class="cf-actions">
                    <a href="@safeReturnUrl" class="cf-secondary-action">Hủy</a>
                    <button type="submit" class="cf-primary-action" data-submit-button data-default-label="@progressActionLabel" data-loading-label="Đang lưu...">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span>@progressActionLabel</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide ci-progress-guide" aria-labelledby="checkInPreviewHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-activity"></i></span>
                <div>
                    <span class="cf-guide__eyebrow">Xem trước tiến độ</span>
                    <h2 id="checkInPreviewHeading">Kết quả sau check-in</h2>
                </div>
            </div>
            <p>Thông tin dưới đây thay đổi theo nhân viên, KPI và giá trị lũy kế bạn nhập.</p>

            <dl class="ci-preview-metrics">
                <div>
                    <dt>Tổng chỉ tiêu</dt>
                    <dd id="targetDisplay">--</dd>
                </div>
                <div id="individualTargetContainer">
                    <dt>Chỉ tiêu cá nhân · <span id="weightLabel">100%</span></dt>
                    <dd id="individualTargetDisplay">--</dd>
                </div>
            </dl>

            <section class="ci-preview-section" id="completedProgressContext" aria-labelledby="completedProgressHeading">
                <div class="ci-preview-section__heading">
                    <span id="completedProgressHeading">Đã ghi nhận trước đó</span>
                    <strong id="previousEmployeeAchieved">--</strong>
                </div>
                <div class="ci-preview-detail">
                    <span id="departmentProgressLabel">Phòng ban</span>
                    <strong id="departmentAchievedDisplay">--</strong>
                </div>
                <div class="ci-preview-progress" aria-hidden="true">
                    <span id="previousProgressBar" class="progress-bar bg-info transition-all" style="width: 0%"></span>
                </div>
                <p id="previousProgressCaption">Chưa có check-in đã xác nhận.</p>
            </section>

            <section class="ci-preview-section" aria-labelledby="deadlineHeading">
                <div class="ci-preview-section__heading">
                    <span id="deadlineHeading">Deadline kỳ này</span>
                    <strong id="deadlineDisplay">--</strong>
                </div>
                <div class="ci-preview-detail ci-preview-detail--stacked">
                    <span>Mục tiêu tới hạn</span>
                    <strong id="deadlineTargetDisplay">--</strong>
                </div>
                <div class="ci-preview-detail">
                    <span>Nhắc trước</span>
                    <strong id="reminderDisplay">--</strong>
                </div>
            </section>

            <section class="ci-live-progress" aria-labelledby="progressScopeLabel">
                <div>
                    <span id="progressScopeLabel">Tiến độ ước tính</span>
                    <strong id="progressPercentage">0%</strong>
                </div>
                <div class="ci-live-progress__track" aria-hidden="true">
                    <span id="liveProgressBar" class="progress-bar bg-primary transition-all" style="width: 0%"></span>
                </div>
            </section>

            <dl class="cf-preview-list ci-preview-attributes">
                <div>
                    <dt>Đơn vị</dt>
                    <dd id="unitDisplay">--</dd>
                </div>
                <div>
                    <dt>Chiều đánh giá</dt>
                    <dd id="modeDisplay">--</dd>
                </div>
            </dl>

            <div class="cf-guide__note">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>Giá trị chỉ được tính chính thức ngay khi người có quyền ghi nhận, hoặc sau khi quản lý xác nhận.</span>
            </div>
            <ul class="cf-guide__list ci-guide-rules">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Đối chiếu số liệu với nguồn báo cáo thực tế.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Nêu rõ trở ngại nếu thấp hơn kế hoạch.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Kiểm tra đúng nhân viên và KPI trước khi gửi.</span></li>
            </ul>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kpi-checkins.css" asp-append-version="true" />
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script id="checkInKpiData" type="application/json">@Html.Raw(kpiDataJson)</script>
    <script id="checkInAssignmentWeights" type="application/json">@Html.Raw(assignmentWeightsJson)</script>
    <script id="checkInEmployeeKpiIds" type="application/json">@Html.Raw(employeeKpiIdsJson)</script>
    <script id="checkInKpiOptions" type="application/json">@Html.Raw(kpiOptionsJson)</script>
    <script id="checkInProgressSnapshots" type="application/json">@Html.Raw(progressSnapshotsJson)</script>
    <script src="~/js/create-form.js" asp-append-version="true"></script>
    <script src="~/js/kpi-checkin-create.js" asp-append-version="true"></script>
}
