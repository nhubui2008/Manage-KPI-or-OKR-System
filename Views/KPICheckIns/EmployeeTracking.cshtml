@model Manage_KPI_or_OKR_System.Models.ViewModels.EmployeeTrackingViewModel
@using System.Globalization
@using System.Linq

@functions {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "NV";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.TakeLast(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    private static string Metric(decimal? value)
        => value.HasValue ? value.Value.ToString("N2") : "Chưa có";

    private static string Percent(decimal? value)
        => value.HasValue ? $"{value.Value:0.#}%" : "Chưa có";

    private static decimal ProgressValue(decimal? value)
        => Math.Clamp(value ?? 0m, 0m, 100m);

    private static string ReviewLabel(string? statusCode)
        => statusCode?.Trim().ToLowerInvariant() switch
        {
            "pending" => "Chờ xác nhận",
            "approved" => "Đã xác nhận",
            "rejected" => "Bị từ chối",
            _ => "Chưa gửi check-in"
        };

    private static string ReviewStateClass(string? statusCode)
        => statusCode?.Trim().ToLowerInvariant() switch
        {
            "pending" => "ci-state ci-state--warning",
            "approved" => "ci-state ci-state--success",
            "rejected" => "ci-state ci-state--danger",
            _ => "ci-state ci-state--neutral"
        };

    private static string ReviewIcon(string? statusCode)
        => statusCode?.Trim().ToLowerInvariant() switch
        {
            "pending" => "bi-hourglass-split",
            "approved" => "bi-check-circle",
            "rejected" => "bi-x-circle",
            _ => "bi-dash-circle"
        };
}

@{
    ViewData["Title"] = "Theo dõi thực hiện KPI";
    var isPendingTab = Model.CanReviewCheckIns &&
        string.Equals(Model.ActiveTab, "pending", StringComparison.OrdinalIgnoreCase);
    var selectedEmployee = Model.SelectedEmployee;
    var trackingPageStart = Math.Max(1, Model.Items.PageIndex - 2);
    var trackingPageEnd = Math.Min(Model.Items.TotalPages, Model.Items.PageIndex + 2);
    var reviewPageStart = Math.Max(1, Model.PendingReviews.PageIndex - 2);
    var reviewPageEnd = Math.Min(Model.PendingReviews.TotalPages, Model.PendingReviews.PageIndex + 2);
}

<div class="evaluation-page checkins-page employee-tracking-page" data-employee-tracking-page>
    <header class="evaluation-page-header et-page-header">
        <div>
            <h1>Theo dõi thực hiện KPI</h1>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                @if (Model.CanViewTracking)
                {
                    <a asp-action="Index">Check-in KPI</a>
                }
                else
                {
                    <span>Check-in KPI</span>
                }
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Theo dõi thực hiện</span>
            </nav>
        </div>
        @if (Model.CanViewTracking)
        {
            <a asp-action="Index" class="evaluation-secondary-action et-history-link">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
                <span>Lịch sử check-in</span>
            </a>
        }
    </header>

    @if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="et-alert et-alert--success" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@successMessage</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="et-alert et-alert--danger" role="alert">
            <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
            <span>@errorMessage</span>
        </div>
    }

    <section class="evaluation-summary et-summary" aria-label="Tổng quan theo dõi KPI">
        <article class="et-summary__urgent">
            <span>Chờ xác nhận</span>
            <strong>@Model.Summary.PendingReviewCount</strong>
            <small>Cần quản lý xử lý</small>
        </article>
        <article class="et-summary__danger">
            <span>Trễ hạn</span>
            <strong>@Model.Summary.LateCount</strong>
            <small>Check-in chính thức bị trễ</small>
        </article>
        <article class="et-summary__warning">
            <span>Có rủi ro</span>
            <strong>@Model.Summary.RiskCount</strong>
            <small>Check-in chính thức cần chú ý</small>
        </article>
        <article>
            <span>KPI trong phạm vi</span>
            <strong>@Model.Summary.TotalKpiCount</strong>
            <small>Chỉ tiêu đang theo dõi</small>
        </article>
        <article>
            <span>Nhân sự</span>
            <strong>@Model.Summary.EmployeeCount</strong>
            <small>Có quyền truy cập</small>
        </article>
    </section>

    <nav class="et-tabs" aria-label="Không gian làm việc check-in">
        @if (Model.CanViewTracking)
        {
            <a asp-action="EmployeeTracking"
               asp-route-tab="tracking"
               asp-route-employeeId="@Model.SelectedEmployeeId"
               asp-route-pageNumber="@Model.Items.PageIndex"
               asp-route-reviewPage="@Model.PendingReviews.PageIndex"
               class="et-tab @(!isPendingTab ? "is-active" : null)"
               aria-current="@(!isPendingTab ? "page" : null)">
                <i class="bi bi-activity" aria-hidden="true"></i>
                Theo dõi &amp; ghi nhận tiến độ
            </a>
        }
        @if (Model.CanReviewCheckIns)
        {
            <a asp-action="EmployeeTracking"
               asp-route-tab="pending"
               asp-route-employeeId="@Model.SelectedEmployeeId"
               asp-route-pageNumber="@Model.Items.PageIndex"
               asp-route-reviewPage="@Model.PendingReviews.PageIndex"
               class="et-tab @(isPendingTab ? "is-active" : null)"
               aria-current="@(isPendingTab ? "page" : null)">
                <i class="bi bi-check2-square" aria-hidden="true"></i>
                Xác nhận check-in
                @if (Model.Summary.PendingReviewCount > 0)
                {
                    <span class="et-tab__count">@Model.Summary.PendingReviewCount</span>
                }
            </a>
        }
    </nav>

    <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-employee-tracking-live></div>

    @if (!isPendingTab)
    {
        <section class="et-tab-panel" aria-label="Theo dõi và ghi nhận tiến độ KPI">
            @if (!Model.Employees.Any())
            {
                <div class="et-empty et-empty--standalone">
                    <span class="et-empty__icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                    <h2>Chưa có nhân sự trong phạm vi theo dõi</h2>
                    <p>Tài khoản hiện tại chưa được phân quyền xem KPI của nhân sự nào. Hãy kiểm tra vai trò hoặc phạm vi phòng ban.</p>
                    <a asp-action="Index" class="evaluation-secondary-action">Xem lịch sử của tôi</a>
                </div>
            }
            else
            {
                <form asp-action="EmployeeTracking" method="get" class="et-mobile-employee-picker" data-mobile-employee-form>
                    <input type="hidden" name="tab" value="tracking" />
                    <input type="hidden" name="reviewPage" value="@Model.PendingReviews.PageIndex" />
                    <label for="mobileEmployeeSelect">Nhân viên cần theo dõi</label>
                    <div>
                        <select id="mobileEmployeeSelect" name="employeeId" class="form-select no-select2" data-mobile-employee-select>
                            <option value="" selected="@(!Model.SelectedEmployeeId.HasValue ? "selected" : null)">Tất cả nhân sự</option>
                            @foreach (var employee in Model.Employees)
                            {
                                <option value="@employee.EmployeeId" selected="@(Model.SelectedEmployeeId == employee.EmployeeId ? "selected" : null)">
                                    @employee.EmployeeName (@employee.EmployeeCode)
                                </option>
                            }
                        </select>
                        <button type="submit" class="evaluation-filter-button">Xem</button>
                    </div>
                </form>

                <div class="et-tracking-workspace">
                    <aside class="et-employee-rail" aria-label="Danh sách nhân sự có thể theo dõi">
                        <div class="et-rail__heading">
                            <div>
                                <strong>Nhân sự</strong>
                                <span>@Model.Employees.Count trong phạm vi</span>
                            </div>
                            <i class="bi bi-people" aria-hidden="true"></i>
                        </div>
                        <label class="et-employee-search" for="employeeRailSearch">
                            <span class="visually-hidden">Tìm nhân viên</span>
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input id="employeeRailSearch" type="search" autocomplete="off" spellcheck="false"
                                   placeholder="Tìm tên, mã, phòng ban..." aria-controls="employeeRailList"
                                   data-employee-search />
                        </label>
                        <div id="employeeRailList" class="et-employee-list" data-employee-list>
                            <a asp-action="EmployeeTracking"
                               asp-route-tab="tracking"
                               asp-route-pageNumber="1"
                               asp-route-reviewPage="@Model.PendingReviews.PageIndex"
                               class="et-employee-item @(!Model.SelectedEmployeeId.HasValue ? "is-active" : null)"
                               aria-current="@(!Model.SelectedEmployeeId.HasValue ? "page" : null)"
                               data-employee-item data-search-value="Tất cả nhân sự">
                                <span class="et-employee-item__avatar"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                                <span class="et-employee-item__body">
                                    <strong>Tất cả nhân sự</strong>
                                    <small>@Model.TotalTrackingRows KPI liên quan</small>
                                </span>
                            </a>
                            @foreach (var employee in Model.Employees)
                            {
                                var employeeIsActive = Model.SelectedEmployeeId == employee.EmployeeId;
                                <a asp-action="EmployeeTracking"
                                   asp-route-tab="tracking"
                                   asp-route-employeeId="@employee.EmployeeId"
                                   asp-route-pageNumber="1"
                                   asp-route-reviewPage="@Model.PendingReviews.PageIndex"
                                   class="et-employee-item @(employeeIsActive ? "is-active" : null)"
                                   aria-current="@(employeeIsActive ? "page" : null)"
                                   data-employee-item
                                   data-search-value="@employee.EmployeeName @employee.EmployeeCode @employee.DepartmentNames">
                                    <span class="et-employee-item__avatar">@Initials(employee.EmployeeName)</span>
                                    <span class="et-employee-item__body">
                                        <strong>@employee.EmployeeName</strong>
                                        <small>@employee.EmployeeCode · @employee.DepartmentNames</small>
                                        @if (employee.IsDepartmentManager)
                                        {
                                            <em>Trưởng phòng</em>
                                        }
                                    </span>
                                </a>
                            }
                            <div class="et-employee-search-empty" hidden data-employee-search-empty>
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <span>Không tìm thấy nhân viên phù hợp.</span>
                            </div>
                        </div>
                    </aside>

                    <div class="et-tracking-content">
                        <div class="et-content-heading">
                            <div>
                                <span>Đang theo dõi</span>
                                @if (selectedEmployee != null)
                                {
                                    <h2>@selectedEmployee.EmployeeName</h2>
                                    <p>@selectedEmployee.EmployeeCode · @selectedEmployee.DepartmentNames</p>
                                }
                                else
                                {
                                    <h2>Tất cả nhân sự</h2>
                                    <p>Tổng hợp KPI trong phạm vi bạn được phép xem.</p>
                                }
                            </div>
                            <div class="et-content-heading__count" aria-label="@Model.TotalTrackingRows KPI">
                                <strong>@Model.TotalTrackingRows</strong>
                                <span>KPI</span>
                            </div>
                        </div>

                        @if (Model.IsOverviewLimited)
                        {
                            <div class="et-notice" role="note">
                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                                <span>Chế độ tổng quan đang giới hạn @Model.OverviewLimit KPI trong tổng số @Model.TotalTrackingRows. Chọn một nhân viên để xem đầy đủ.</span>
                            </div>
                        }

                        @if (!Model.Items.Any())
                        {
                            <div class="et-empty">
                                <span class="et-empty__icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                                <h2>Chưa có KPI để theo dõi</h2>
                                @if (selectedEmployee != null)
                                {
                                    <p>@selectedEmployee.EmployeeName chưa được phân bổ KPI đang hoạt động trong kỳ hiện tại.</p>
                                }
                                else
                                {
                                    <p>Chưa có KPI đang hoạt động trong phạm vi nhân sự bạn có thể xem.</p>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="ci-entry-list et-kpi-list">
                                @foreach (var row in Model.Items)
                                {
                                    var progress = ProgressValue(row.LatestProgress);
                                    var operationalStateClass = row.IsLate
                                        ? "ci-state ci-state--danger"
                                        : row.IsRisk
                                            ? "ci-state ci-state--warning"
                                            : "ci-state ci-state--neutral";
                                    var operationalIcon = row.IsLate
                                        ? "bi-calendar-x"
                                        : row.IsRisk
                                            ? "bi-exclamation-triangle"
                                            : "bi-activity";
                                    var checkInInputId = $"achieved-{row.EmployeeId}-{row.KpiId}";
                                    var failReasonInputId = $"reason-{row.EmployeeId}-{row.KpiId}";
                                    var noteInputId = $"note-{row.EmployeeId}-{row.KpiId}";
                                    var latestSubmissionIsPending = string.Equals(
                                        row.LatestReviewStatusCode,
                                        "Pending",
                                        StringComparison.OrdinalIgnoreCase);
                                    var latestSubmissionIsRejected = string.Equals(
                                        row.LatestReviewStatusCode,
                                        "Rejected",
                                        StringComparison.OrdinalIgnoreCase);
                                    var showSeparateSubmission = row.LatestSubmissionId.HasValue &&
                                        row.LatestSubmissionId != row.LatestCheckInId &&
                                        (latestSubmissionIsPending || latestSubmissionIsRejected);

                                    <article class="ci-entry et-kpi-entry">
                                        <div class="ci-entry__header et-kpi-entry__header">
                                            <div class="ci-entry__identity et-kpi-identity">
                                                <span class="ci-avatar">@Initials(row.EmployeeName)</span>
                                                <div>
                                                    <h2>@row.KpiName</h2>
                                                    <p>
                                                        <i class="bi bi-person" aria-hidden="true"></i>
                                                        @row.EmployeeName · @row.EmployeeCode · @row.DepartmentNames
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="ci-entry__meta">
                                                <div class="ci-state-group">
                                                    <span class="@operationalStateClass">
                                                        <i class="bi @operationalIcon" aria-hidden="true"></i>
                                                        @row.CheckInStatus
                                                    </span>
                                                    <span class="@ReviewStateClass(row.LatestReviewStatusCode)">
                                                        <i class="bi @ReviewIcon(row.LatestReviewStatusCode)" aria-hidden="true"></i>
                                                        @ReviewLabel(row.LatestReviewStatusCode)
                                                    </span>
                                                </div>
                                                @if (row.LatestSubmissionDate.HasValue)
                                                {
                                                    <time datetime="@row.LatestSubmissionDate.Value.ToString("yyyy-MM-ddTHH:mm:ss")">
                                                        Gửi gần nhất @row.LatestSubmissionDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                    </time>
                                                }
                                            </div>
                                        </div>

                                        <div class="ci-entry__body">
                                            <dl class="ci-metrics et-kpi-metrics">
                                                <div>
                                                    <dt>Kết quả chính thức</dt>
                                                    <dd>@Metric(row.LatestAchievedValue) <small>@row.Unit</small></dd>
                                                </div>
                                                <div>
                                                    <dt>Chỉ tiêu</dt>
                                                    <dd>@Metric(row.TargetValue) <small>@row.Unit</small></dd>
                                                </div>
                                                <div>
                                                    <dt>Tiến độ chính thức</dt>
                                                    <dd>@Percent(row.LatestProgress)</dd>
                                                </div>
                                                <div>
                                                    <dt>Tiến độ kế hoạch</dt>
                                                    <dd>@Percent(row.ScheduleProgressPercentage)</dd>
                                                </div>
                                                 <div>
                                                     <dt>Hạn cập nhật tiếp theo</dt>
                                                    <dd class="ci-metric-text">
                                                        @(row.LatestDeadlineAt.HasValue ? row.LatestDeadlineAt.Value.ToString("dd/MM/yyyy") : "Chưa đặt")
                                                    </dd>
                                                </div>
                                            </dl>
                                             <div class="ci-progress et-progress-comparison">
                                                <div>
                                                    <span>Tiến độ chính thức</span>
                                                    <strong>@Percent(row.LatestProgress)</strong>
                                                </div>
                                                 <progress max="100" value="@progress.ToString(CultureInfo.InvariantCulture)">@Percent(row.LatestProgress)</progress>
                                             </div>
                                             @if (showSeparateSubmission)
                                             {
                                                 <div class="et-submission-context @(latestSubmissionIsRejected ? "et-submission-context--rejected" : null)" role="note">
                                                     <i class="bi @(latestSubmissionIsRejected ? "bi-x-circle" : "bi-hourglass-split")" aria-hidden="true"></i>
                                                     <div>
                                                         <strong>@(latestSubmissionIsRejected ? "Lần gửi gần nhất không được tính chính thức" : "Tiến độ đề nghị gần nhất · đang chờ xác nhận")</strong>
                                                         <p>
                                                             @Metric(row.LatestSubmissionAchievedValue)
                                                             @if (!string.IsNullOrWhiteSpace(row.Unit))
                                                             {
                                                                 <span>@row.Unit</span>
                                                             }
                                                             · @Percent(row.LatestSubmissionProgress)
                                                         </p>
                                                     </div>
                                                 </div>
                                             }
                                             @if (!string.IsNullOrWhiteSpace(row.Note))
                                            {
                                                <div class="et-kpi-note">
                                                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                                                    <p><strong>Ghi chú gần nhất:</strong> @row.Note</p>
                                                </div>
                                            }
                                        </div>

                                        @if (Model.CanCreateCheckIn && row.CanCheckIn)
                                        {
                                            <details class="et-checkin-details">
                                                <summary>
                                                    <span><i class="bi bi-plus-circle" aria-hidden="true"></i> Ghi nhận tiến độ mới</span>
                                                    <small>Nhập kết quả lũy kế hiện tại</small>
                                                </summary>
                                                <form asp-action="Create" method="post" class="et-checkin-form" data-local-submit data-busy-label="Đang lưu tiến độ...">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="EmployeeId" value="@row.EmployeeId" />
                                                    <input type="hidden" name="KPIId" value="@row.KpiId" />
                                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                                                    <label for="@checkInInputId">
                                                        <span>Kết quả lũy kế <b aria-label="bắt buộc">*</b></span>
                                                        <span class="et-input-with-unit">
                                                            <input id="@checkInInputId" name="AchievedValue" type="number" min="0" step="0.01"
                                                                   inputmode="decimal" required autocomplete="off" placeholder="Ví dụ: 82" />
                                                            @if (!string.IsNullOrWhiteSpace(row.Unit))
                                                            {
                                                                <em>@row.Unit</em>
                                                            }
                                                        </span>
                                                    </label>
                                                    <label for="@failReasonInputId">
                                                        <span>Lý do nếu chưa đạt</span>
                                                        <select id="@failReasonInputId" name="FailReasonId" class="no-select2">
                                                            <option value="">Không có / Đang đúng kế hoạch</option>
                                                            @foreach (var reason in Model.FailReasons)
                                                            {
                                                                <option value="@reason.Id">@reason.ReasonName</option>
                                                            }
                                                        </select>
                                                    </label>
                                                    <label class="et-checkin-form__note" for="@noteInputId">
                                                        <span>Ghi chú</span>
                                                        <textarea id="@noteInputId" name="Note" rows="2" maxlength="1000"
                                                                  placeholder="Nêu kết quả, trở ngại hoặc bước tiếp theo..."></textarea>
                                                    </label>
                                                    <div class="et-checkin-form__footer">
                                                        <p><i class="bi bi-info-circle" aria-hidden="true"></i> Kết quả cần quản lý xác nhận trước khi trở thành số liệu chính thức.</p>
                                                        <button type="submit" class="evaluation-primary-action">
                                                            <i class="bi bi-send-check" aria-hidden="true"></i>
                                                            <span>Gửi check-in</span>
                                                        </button>
                                                    </div>
                                                </form>
                                            </details>
                                        }
                                        else
                                        {
                                            <div class="et-checkin-unavailable" role="note">
                                                <i class="bi bi-lock" aria-hidden="true"></i>
                                                <span>@(string.IsNullOrWhiteSpace(row.CheckInDisabledReason) ? "Bạn chưa thể ghi nhận tiến độ cho KPI này." : row.CheckInDisabledReason)</span>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>

                            @if (Model.Items.TotalPages > 1)
                            {
                                <nav class="evaluation-pagination et-pagination" aria-label="Phân trang KPI theo dõi">
                                    @if (Model.Items.PreviousPageNumber.HasValue)
                                    {
                                        <a asp-action="EmployeeTracking" asp-route-tab="tracking" asp-route-employeeId="@Model.SelectedEmployeeId"
                                           asp-route-pageNumber="@Model.Items.PreviousPageNumber" asp-route-reviewPage="@Model.PendingReviews.PageIndex"
                                           aria-label="Trang KPI trước"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                                    }
                                    else
                                    {
                                        <span class="is-disabled" aria-disabled="true"><i class="bi bi-chevron-left" aria-hidden="true"></i></span>
                                    }

                                    @if (trackingPageStart > 1)
                                    {
                                        <a asp-action="EmployeeTracking" asp-route-tab="tracking" asp-route-employeeId="@Model.SelectedEmployeeId"
                                           asp-route-pageNumber="1" asp-route-reviewPage="@Model.PendingReviews.PageIndex">1</a>
                                        @if (trackingPageStart > 2)
                                        {
                                            <span class="et-pagination__ellipsis" aria-hidden="true">…</span>
                                        }
                                    }
                                    @for (var pageIndex = trackingPageStart; pageIndex <= trackingPageEnd; pageIndex++)
                                    {
                                        <a asp-action="EmployeeTracking" asp-route-tab="tracking" asp-route-employeeId="@Model.SelectedEmployeeId"
                                           asp-route-pageNumber="@pageIndex" asp-route-reviewPage="@Model.PendingReviews.PageIndex"
                                           class="@(pageIndex == Model.Items.PageIndex ? "is-current" : null)"
                                           aria-current="@(pageIndex == Model.Items.PageIndex ? "page" : null)">@pageIndex</a>
                                    }
                                    @if (trackingPageEnd < Model.Items.TotalPages)
                                    {
                                        @if (trackingPageEnd < Model.Items.TotalPages - 1)
                                        {
                                            <span class="et-pagination__ellipsis" aria-hidden="true">…</span>
                                        }
                                        <a asp-action="EmployeeTracking" asp-route-tab="tracking" asp-route-employeeId="@Model.SelectedEmployeeId"
                                           asp-route-pageNumber="@Model.Items.TotalPages" asp-route-reviewPage="@Model.PendingReviews.PageIndex">@Model.Items.TotalPages</a>
                                    }

                                    @if (Model.Items.NextPageNumber.HasValue)
                                    {
                                        <a asp-action="EmployeeTracking" asp-route-tab="tracking" asp-route-employeeId="@Model.SelectedEmployeeId"
                                           asp-route-pageNumber="@Model.Items.NextPageNumber" asp-route-reviewPage="@Model.PendingReviews.PageIndex"
                                           aria-label="Trang KPI sau"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                                    }
                                    else
                                    {
                                        <span class="is-disabled" aria-disabled="true"><i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                                    }
                                </nav>
                            }
                        }
                    </div>
                </div>
            }
        </section>
    }
    else
    {
        <section class="et-tab-panel et-review-workspace" aria-label="Xác nhận check-in đang chờ">
            <div class="et-review-heading">
                <div>
                    <span>Hàng chờ xác nhận</span>
                    <h2>Kiểm tra trước khi ghi nhận chính thức</h2>
                    <p>Đối chiếu kết quả, tiến độ kế hoạch và ghi chú của nhân viên trước khi xác nhận hoặc từ chối.</p>
                </div>
                <div class="et-review-heading__count">
                    <strong>@Model.Summary.PendingReviewCount</strong>
                    <span>đang chờ</span>
                </div>
            </div>

            @if (!Model.PendingReviews.Any())
            {
                <div class="et-empty et-empty--standalone">
                    <span class="et-empty__icon et-empty__icon--success"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
                    <h2>Không còn check-in chờ xác nhận</h2>
                    <p>Các check-in trong phạm vi của bạn đã được xử lý. Danh sách sẽ tự cập nhật khi có bản ghi mới.</p>
                    @if (Model.CanViewTracking)
                    {
                        <a asp-action="EmployeeTracking" asp-route-tab="tracking" asp-route-employeeId="@Model.SelectedEmployeeId"
                           asp-route-pageNumber="@Model.Items.PageIndex" class="evaluation-secondary-action">Quay lại theo dõi KPI</a>
                    }
                </div>
            }
            else
            {
                <div class="et-review-list">
                    @foreach (var item in Model.PendingReviews)
                    {
                        var reviewScoreId = $"review-score-{item.CheckInId}";
                        var reviewCommentId = $"review-comment-{item.CheckInId}";

                        <article class="et-review-item">
                            <header class="et-review-item__header">
                                <div class="et-review-person">
                                    <span class="ci-avatar">@Initials(item.EmployeeName)</span>
                                    <div>
                                        <h2>@item.EmployeeName</h2>
                                        <p>@item.EmployeeCode · Check-in #@item.CheckInId</p>
                                    </div>
                                </div>
                                <div class="ci-state-group">
                                    <span class="ci-state ci-state--warning">
                                        <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                                        @item.ReviewStatus
                                    </span>
                                    <span class="ci-state ci-state--neutral">
                                        <i class="bi bi-activity" aria-hidden="true"></i>
                                        @item.CheckInStatus
                                    </span>
                                </div>
                            </header>

                            <div class="et-review-item__body">
                                <div class="et-review-kpi">
                                    <span>KPI đề nghị cập nhật</span>
                                    <h3>@item.KpiName</h3>
                                    @if (item.CheckInDate.HasValue)
                                    {
                                        <time datetime="@item.CheckInDate.Value.ToString("yyyy-MM-ddTHH:mm:ss")">
                                            Gửi lúc @item.CheckInDate.Value.ToString("dd/MM/yyyy HH:mm")
                                        </time>
                                    }
                                </div>
                                <dl class="et-review-metrics">
                                    <div>
                                        <dt>Kết quả đề nghị</dt>
                                        <dd>@Metric(item.AchievedValue)</dd>
                                    </div>
                                    <div>
                                        <dt>Tiến độ đề nghị</dt>
                                        <dd>@Percent(item.ProgressPercentage)</dd>
                                    </div>
                                    <div>
                                        <dt>Tiến độ kế hoạch</dt>
                                        <dd>@Percent(item.ScheduleProgressPercentage)</dd>
                                    </div>
                                </dl>
                                @if (!string.IsNullOrWhiteSpace(item.FailReasonName) || !string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <div class="et-review-context">
                                        @if (!string.IsNullOrWhiteSpace(item.FailReasonName))
                                        {
                                            <p><strong>Lý do chưa đạt:</strong> @item.FailReasonName</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Note))
                                        {
                                            <p><strong>Ghi chú nhân viên:</strong> @item.Note</p>
                                        }
                                    </div>
                                }
                            </div>

                            <form asp-action="Review" method="post" class="et-inline-review-form" data-local-submit data-busy-label="Đang xử lý xác nhận...">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.CheckInId" />
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <label for="@reviewScoreId">
                                    <span>Điểm đánh giá <small>(không bắt buộc)</small></span>
                                    <input id="@reviewScoreId" name="reviewScore" type="number" min="0" max="100" step="0.01"
                                           inputmode="decimal" autocomplete="off" placeholder="0–100" />
                                </label>
                                <label class="et-inline-review-form__comment" for="@reviewCommentId">
                                    <span>Nhận xét của quản lý</span>
                                    <textarea id="@reviewCommentId" name="reviewComment" rows="2" maxlength="1000"
                                              placeholder="Nêu lý do, phản hồi hoặc điều chỉnh cần thiết..."></textarea>
                                </label>
                                <div class="et-inline-review-form__actions">
                                    <button type="submit" name="decision" value="Approved" class="ci-review-button ci-review-button--approve">
                                        <i class="bi bi-check-circle" aria-hidden="true"></i>
                                        <span>Xác nhận</span>
                                    </button>
                                    <button type="submit" name="decision" value="Rejected" class="ci-review-button ci-review-button--reject">
                                        <i class="bi bi-x-circle" aria-hidden="true"></i>
                                        <span>Từ chối</span>
                                    </button>
                                </div>
                            </form>
                        </article>
                    }
                </div>

                @if (Model.PendingReviews.TotalPages > 1)
                {
                    <nav class="evaluation-pagination et-pagination" aria-label="Phân trang check-in chờ xác nhận">
                        @if (Model.PendingReviews.PreviousPageNumber.HasValue)
                        {
                            <a asp-action="EmployeeTracking" asp-route-tab="pending" asp-route-employeeId="@Model.SelectedEmployeeId"
                               asp-route-pageNumber="@Model.Items.PageIndex" asp-route-reviewPage="@Model.PendingReviews.PreviousPageNumber"
                               aria-label="Trang xác nhận trước"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <span class="is-disabled" aria-disabled="true"><i class="bi bi-chevron-left" aria-hidden="true"></i></span>
                        }

                        @if (reviewPageStart > 1)
                        {
                            <a asp-action="EmployeeTracking" asp-route-tab="pending" asp-route-employeeId="@Model.SelectedEmployeeId"
                               asp-route-pageNumber="@Model.Items.PageIndex" asp-route-reviewPage="1">1</a>
                            @if (reviewPageStart > 2)
                            {
                                <span class="et-pagination__ellipsis" aria-hidden="true">…</span>
                            }
                        }
                        @for (var pageIndex = reviewPageStart; pageIndex <= reviewPageEnd; pageIndex++)
                        {
                            <a asp-action="EmployeeTracking" asp-route-tab="pending" asp-route-employeeId="@Model.SelectedEmployeeId"
                               asp-route-pageNumber="@Model.Items.PageIndex" asp-route-reviewPage="@pageIndex"
                               class="@(pageIndex == Model.PendingReviews.PageIndex ? "is-current" : null)"
                               aria-current="@(pageIndex == Model.PendingReviews.PageIndex ? "page" : null)">@pageIndex</a>
                        }
                        @if (reviewPageEnd < Model.PendingReviews.TotalPages)
                        {
                            @if (reviewPageEnd < Model.PendingReviews.TotalPages - 1)
                            {
                                <span class="et-pagination__ellipsis" aria-hidden="true">…</span>
                            }
                            <a asp-action="EmployeeTracking" asp-route-tab="pending" asp-route-employeeId="@Model.SelectedEmployeeId"
                               asp-route-pageNumber="@Model.Items.PageIndex" asp-route-reviewPage="@Model.PendingReviews.TotalPages">@Model.PendingReviews.TotalPages</a>
                        }

                        @if (Model.PendingReviews.NextPageNumber.HasValue)
                        {
                            <a asp-action="EmployeeTracking" asp-route-tab="pending" asp-route-employeeId="@Model.SelectedEmployeeId"
                               asp-route-pageNumber="@Model.Items.PageIndex" asp-route-reviewPage="@Model.PendingReviews.NextPageNumber"
                               aria-label="Trang xác nhận sau"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <span class="is-disabled" aria-disabled="true"><i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                        }
                    </nav>
                }
            }
        </section>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kpi-checkins.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kpi-employee-tracking.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/kpi-employee-tracking.js" asp-append-version="true"></script>
}
