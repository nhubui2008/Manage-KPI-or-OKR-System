@model IEnumerable<Manage_KPI_or_OKR_System.Models.KPICheckIn>
@using Manage_KPI_or_OKR_System.Helpers
@using System.Globalization

@{
    var checkIns = Model?.ToList() ?? new List<Manage_KPI_or_OKR_System.Models.KPICheckIn>();
    var detailsDict = ViewBag.Details as Dictionary<int, Manage_KPI_or_OKR_System.Models.CheckInDetail> ?? new();
    var employeesDict = ViewBag.Employees as Dictionary<int, Manage_KPI_or_OKR_System.Models.Employee> ?? new();
    var kpisDict = ViewBag.KPIs as Dictionary<int, Manage_KPI_or_OKR_System.Models.KPI> ?? new();
    var kpiData = ViewBag.KPIData as Dictionary<int, Manage_KPI_or_OKR_System.Models.KPIDetail> ?? new();
    var statusesDict = ViewBag.CheckInStatuses as Dictionary<int, string> ?? new();
    var commentsByCheckIn = ViewBag.CheckInComments as Dictionary<int, List<Manage_KPI_or_OKR_System.Models.GoalComment>> ?? new();
    var failReasonsDict = (ViewBag.FailReasons as List<Manage_KPI_or_OKR_System.Models.FailReason> ?? new())
        .ToDictionary(reason => reason.Id, reason => reason.ReasonName ?? "Chưa rõ");
    var allStatuses = ViewBag.AllStatuses as List<Manage_KPI_or_OKR_System.Models.CheckInStatus> ?? new();

    bool canReviewCheckIns = ViewBag.CanReviewCheckIns == true;
    string progressPageTitle = canReviewCheckIns ? "Ghi nhận tiến độ KPI" : "Cập nhật tiến độ KPI";
    string progressActionLabel = canReviewCheckIns ? "Ghi nhận tiến độ" : "Cập nhật tiến độ";
    string returnUrl = ViewBag.ReturnUrl as string ?? "/KPICheckIns";
    var selectedStatusId = ViewBag.StatusId is int statusValue ? (int?)statusValue : null;
    var selectedReviewStatus = ViewBag.ReviewStatus as string;
    var selectedQuickFilter = ViewBag.QuickFilter as string;
    var searchString = ViewBag.SearchString as string;
    bool hasActiveFilters = !string.IsNullOrWhiteSpace(searchString)
        || selectedStatusId.HasValue
        || !string.IsNullOrWhiteSpace(selectedReviewStatus)
        || !string.IsNullOrWhiteSpace(selectedQuickFilter);

    string StatusName(Manage_KPI_or_OKR_System.Models.KPICheckIn checkIn) =>
        checkIn.StatusId.HasValue && statusesDict.TryGetValue(checkIn.StatusId.Value, out var statusName)
            ? statusName
            : "Chờ cập nhật";

    int totalCount = ViewBag.TotalCount is int totalValue ? totalValue : checkIns.Count;
    int onTrackCount = ViewBag.OnTrackCount is int onTrackValue ? onTrackValue : 0;
    int riskCount = ViewBag.RiskCount is int riskValue ? riskValue : 0;
    int lateCount = ViewBag.LateCount is int lateValue ? lateValue : 0;
    int pendingCount = ViewBag.PendingCount is int pendingValue ? pendingValue : 0;
    int currentPage = ViewBag.Page is int pageValue ? pageValue : 1;
    int totalPages = ViewBag.TotalPages is int totalPageValue ? totalPageValue : 1;

    ViewData["Title"] = progressPageTitle;
}

@functions {
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "NV";
        var initials = string.Concat(parts.Select(part => part[0]));
        return initials.Length > 2 ? initials[^2..].ToUpperInvariant() : initials.ToUpperInvariant();
    }

    private static string Metric(decimal? value)
    {
        if (!value.HasValue) return "--";
        var format = decimal.Truncate(value.Value) == value.Value ? "N0" : "N2";
        return value.Value.ToString(format, CultureInfo.GetCultureInfo("vi-VN"));
    }

    private static string ProgressStatusClass(string statusName) => statusName switch
    {
        "Đúng tiến độ" or "Vượt tiến độ" or "Hoàn thành" => "ci-state ci-state--success",
        "Gặp trở ngại" => "ci-state ci-state--warning",
        "Chậm tiến độ" => "ci-state ci-state--danger",
        _ => "ci-state ci-state--neutral"
    };

    private static string ProgressStatusIcon(string statusName) => statusName switch
    {
        "Đúng tiến độ" => "bi-check-circle",
        "Vượt tiến độ" => "bi-graph-up-arrow",
        "Hoàn thành" => "bi-patch-check",
        "Gặp trở ngại" => "bi-exclamation-triangle",
        "Chậm tiến độ" => "bi-clock-history",
        _ => "bi-hourglass-split"
    };

    private static string ReviewText(string? status) => status switch
    {
        "Pending" => "Chờ xác nhận",
        "Rejected" => "Đã từ chối",
        _ => "Đã xác nhận"
    };

    private static string ReviewClass(string? status) => status switch
    {
        "Pending" => "ci-state ci-state--warning",
        "Rejected" => "ci-state ci-state--danger",
        _ => "ci-state ci-state--success"
    };

    private static string QuickFilterClass(string? selected, string value) =>
        string.Equals(selected ?? string.Empty, value, StringComparison.OrdinalIgnoreCase)
            ? "evaluation-chip is-active"
            : "evaluation-chip";
}

<link rel="stylesheet" href="~/css/velzon-kpi.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/velzon-kpi-checkins.css" asp-append-version="true" />

<div class="evaluation-page checkins-page kpi-checkins-wrapper">
    <!-- PAGE TITLE HEADER -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between mb-3 evaluation-page-header">
                <div>
                    <h4 class="mb-sm-0 fw-bold">@progressPageTitle</h4>
                    <ol class="breadcrumb m-0 me-3 evaluation-breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-controller="KPIs" asp-action="Index">Quản lý KPI</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Check-in KPI</li>
                    </ol>
                </div>
                <div class="page-title-right d-flex align-items-center gap-2">
                    <a asp-action="Create" class="btn btn-primary btn-sm d-flex align-items-center gap-1 page-create-action">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>@progressActionLabel</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- SUMMARY STATS WIDGETS -->
    <div class="row g-3 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Check-in hiển thị</p>
                            <h4 class="fs-18 fw-bold mb-0 text-primary">@totalCount</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-primary-subtle text-primary rounded-2">
                                <i class="bi bi-file-earmark-check"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-primary-subtle text-primary"><i class="bi bi-funnel"></i> Tất cả</span> Trong phạm vi hiện tại</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Đúng tiến độ</p>
                            <h4 class="fs-18 fw-bold mb-0 text-success">@onTrackCount</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-success-subtle text-success rounded-2">
                                <i class="bi bi-graph-up-arrow"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i> Tốt</span> Đúng hạn, vượt/hoàn thành</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Có rủi ro / Chậm</p>
                            <h4 class="fs-18 fw-bold mb-0 text-warning">@(riskCount + lateCount)</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-warning-subtle text-warning rounded-2">
                                <i class="bi bi-exclamation-triangle"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-warning-subtle text-warning"><i class="bi bi-clock-history me-1"></i> Chú ý</span> Cần hỗ trợ & tháo gỡ</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Chờ xác nhận</p>
                            <h4 class="fs-18 fw-bold mb-0 text-info">@pendingCount</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-info-subtle text-info rounded-2">
                                <i class="bi bi-hourglass-split"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-info-subtle text-info"><i class="bi bi-person-check me-1"></i> Quản lý</span> Cần duyệt kết quả</p>
                </div>
            </div>
        </div>
    </div>

    <section class="evaluation-filter-panel" aria-labelledby="checkInFiltersHeading">
        <div class="evaluation-filter-heading">
            <div>
                <p class="evaluation-eyebrow" id="checkInFiltersHeading">Tìm và lọc</p>
                <span>Thu hẹp lịch sử theo người thực hiện, KPI, tiến độ và trạng thái xác nhận.</span>
            </div>
            @if (hasActiveFilters)
            {
                <a asp-action="Index" class="kpi-clear-filter-btn" title="Xóa tất cả bộ lọc đang áp dụng">
                    <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
                    <span>Xóa lọc</span>
                </a>
            }
        </div>

        <form method="get" asp-action="Index" class="evaluation-filter-form ci-filter-form">
            <label class="evaluation-search-field">
                <span>Tìm kiếm</span>
                <div class="ci-search-input-wrap">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" name="searchString" value="@searchString"
                           placeholder="Tên, mã nhân viên hoặc tên KPI..." autocomplete="off" />
                </div>
            </label>
            <label>
                <span>Trạng thái tiến độ</span>
                <select name="statusId" class="no-select2">
                    <option value="">Tất cả</option>
                    @foreach (var status in allStatuses)
                    {
                        <option value="@status.Id" selected="@(selectedStatusId == status.Id ? "selected" : null)">@status.StatusName</option>
                    }
                </select>
            </label>
            <label>
                <span>Trạng thái xác nhận</span>
                <select name="reviewStatus" class="no-select2">
                    <option value="">Tất cả</option>
                    <option value="Pending" selected="@(selectedReviewStatus == "Pending" ? "selected" : null)">Chờ xác nhận</option>
                    <option value="Approved" selected="@(selectedReviewStatus == "Approved" ? "selected" : null)">Đã xác nhận</option>
                    <option value="Rejected" selected="@(selectedReviewStatus == "Rejected" ? "selected" : null)">Đã từ chối</option>
                </select>
            </label>
            <button type="submit" class="evaluation-filter-button">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <span>Lọc</span>
            </button>
        </form>

        <nav class="evaluation-quick-filters" aria-label="Lọc nhanh check-in">
            <a asp-action="Index" asp-route-searchString="@searchString" asp-route-statusId="@selectedStatusId" asp-route-reviewStatus="@selectedReviewStatus" class="@QuickFilterClass(selectedQuickFilter, "")">
                <i class="bi bi-grid" aria-hidden="true"></i> Tất cả
            </a>
            <a asp-action="Index" asp-route-searchString="@searchString" asp-route-statusId="@selectedStatusId" asp-route-reviewStatus="@selectedReviewStatus" asp-route-quickFilter="pending" class="@QuickFilterClass(selectedQuickFilter, "pending")">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i> Chờ xác nhận
            </a>
            <a asp-action="Index" asp-route-searchString="@searchString" asp-route-statusId="@selectedStatusId" asp-route-reviewStatus="@selectedReviewStatus" asp-route-quickFilter="approved" class="@QuickFilterClass(selectedQuickFilter, "approved")">
                <i class="bi bi-check-circle" aria-hidden="true"></i> Đã xác nhận
            </a>
            <a asp-action="Index" asp-route-searchString="@searchString" asp-route-statusId="@selectedStatusId" asp-route-reviewStatus="@selectedReviewStatus" asp-route-quickFilter="rejected" class="@QuickFilterClass(selectedQuickFilter, "rejected")">
                <i class="bi bi-x-circle" aria-hidden="true"></i> Đã từ chối
            </a>
            <a asp-action="Index" asp-route-searchString="@searchString" asp-route-statusId="@selectedStatusId" asp-route-reviewStatus="@selectedReviewStatus" asp-route-quickFilter="risk" class="@QuickFilterClass(selectedQuickFilter, "risk")">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Có rủi ro
            </a>
        </nav>
    </section>

    <section class="evaluation-results ci-results" aria-labelledby="checkInResultsHeading">
        <div class="evaluation-results-heading">
            <div>
                <p class="evaluation-eyebrow" id="checkInResultsHeading">Lịch sử check-in</p>
                <strong>@totalCount bản ghi phù hợp</strong>
            </div>
            <span>Trang @currentPage / @totalPages</span>
        </div>

        @if (!checkIns.Any())
        {
            <div class="evaluation-empty">
                <span class="evaluation-empty-icon"><i class="bi bi-journal-check" aria-hidden="true"></i></span>
                <h2>@(hasActiveFilters ? "Không có check-in phù hợp" : "Chưa có bản ghi check-in")</h2>
                <p>@(hasActiveFilters ? "Thử thay đổi bộ lọc hoặc xóa lọc để xem lại lịch sử." : "Bắt đầu ghi nhận số liệu thực tế để theo dõi tiến độ KPI.")</p>
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" class="evaluation-secondary-action">Xóa bộ lọc</a>
                }
                else
                {
                    <a asp-action="Create" class="evaluation-primary-action page-create-action"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>@progressActionLabel</span></a>
                }
            </div>
        }
        else
        {
            <div class="ci-entry-list">
                @foreach (var checkIn in checkIns)
                {
                    var detail = detailsDict.TryGetValue(checkIn.Id, out var savedDetail) ? savedDetail : new Manage_KPI_or_OKR_System.Models.CheckInDetail();
                    var employee = checkIn.EmployeeId.HasValue && employeesDict.TryGetValue(checkIn.EmployeeId.Value, out var savedEmployee) ? savedEmployee : null;
                    var kpi = checkIn.KPIId.HasValue && kpisDict.TryGetValue(checkIn.KPIId.Value, out var savedKpi) ? savedKpi : null;
                    var kpiDetail = checkIn.KPIId.HasValue && kpiData.TryGetValue(checkIn.KPIId.Value, out var savedKpiDetail) ? savedKpiDetail : null;
                    string employeeName = employee?.FullName ?? "Chưa gán nhân viên";
                    string kpiName = kpi?.KPIName ?? "KPI không còn khả dụng";
                    string measurementUnit = kpiDetail?.MeasurementUnit ?? "đơn vị";
                    string progressStatus = StatusName(checkIn);
                    string reviewStatus = string.IsNullOrWhiteSpace(checkIn.ReviewStatus) ? "Approved" : checkIn.ReviewStatus;
                    decimal progress = detail.ProgressPercentage ?? 0;
                    decimal progressWidth = Math.Clamp(progress, 0, 100);
                    var reviewer = checkIn.ReviewedById.HasValue && employeesDict.TryGetValue(checkIn.ReviewedById.Value, out var savedReviewer) ? savedReviewer : null;
                    var comments = commentsByCheckIn.TryGetValue(checkIn.Id, out var savedComments) ? savedComments : new List<Manage_KPI_or_OKR_System.Models.GoalComment>();

                    <article class="ci-entry">
                        <header class="ci-entry__header">
                            <div class="ci-entry__identity">
                                <span class="ci-avatar" aria-hidden="true">@Initials(employeeName)</span>
                                <div>
                                    <h2>@employeeName</h2>
                                    <p><i class="bi bi-bullseye" aria-hidden="true"></i> @kpiName</p>
                                </div>
                            </div>
                            <div class="ci-entry__meta">
                                <time datetime="@checkIn.CheckInDate?.ToString("O")">
                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                    @(checkIn.CheckInDate?.ToString("dd/MM/yyyy · HH:mm") ?? "Chưa có thời gian")
                                </time>
                                <div class="ci-state-group">
                                    <span class="@ProgressStatusClass(progressStatus)">
                                        <i class="bi @ProgressStatusIcon(progressStatus)" aria-hidden="true"></i>@progressStatus
                                    </span>
                                    <span class="@ReviewClass(reviewStatus)">@ReviewText(reviewStatus)</span>
                                </div>
                            </div>
                        </header>

                        <div class="ci-entry__body">
                            <dl class="ci-metrics">
                                <div>
                                    <dt>Kết quả lũy kế</dt>
                                    <dd>@Metric(detail.AchievedValue) <small>@measurementUnit</small></dd>
                                </div>
                                <div>
                                    <dt>Tiến độ</dt>
                                    <dd>@Metric(progress)%</dd>
                                </div>
                                <div>
                                    <dt>Lý do chưa đạt</dt>
                                    <dd class="ci-metric-text">
                                        @(checkIn.FailReasonId.HasValue && failReasonsDict.TryGetValue(checkIn.FailReasonId.Value, out var failReason) ? failReason : "Không ghi nhận")
                                    </dd>
                                </div>
                                <div>
                                    <dt>Người xác nhận</dt>
                                    <dd class="ci-metric-text">@(reviewer?.FullName ?? "Chưa xác nhận")</dd>
                                </div>
                                <div>
                                    <dt>Điểm quản lý</dt>
                                    <dd>@(checkIn.ReviewScore.HasValue ? $"{checkIn.ReviewScore.Value:0.##}/100" : "--")</dd>
                                </div>
                            </dl>

                            <div class="ci-progress" aria-label="Tiến độ @Metric(progress) phần trăm">
                                <div class="ci-progress__track">
                                    <span style="width: @progressWidth%"></span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(detail.Note) || !string.IsNullOrWhiteSpace(checkIn.ReviewComment))
                            {
                                <div class="ci-notes">
                                    @if (!string.IsNullOrWhiteSpace(detail.Note))
                                    {
                                        <p><strong>Ghi chú:</strong> @detail.Note</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(checkIn.ReviewComment))
                                    {
                                        <p><strong>Nhận xét quản lý:</strong> @checkIn.ReviewComment</p>
                                    }
                                </div>
                            }
                        </div>

                        @if (canReviewCheckIns && reviewStatus == "Pending")
                        {
                            <div class="ci-review-panel">
                                <div class="ci-review-panel__heading">
                                    <div>
                                        <strong>Xác nhận kết quả check-in</strong>
                                        <span>Điểm và nhận xét sẽ được lưu vào lịch sử trao đổi.</span>
                                    </div>
                                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                                </div>
                                <form asp-action="Review" method="post" class="ci-review-form">
                                    <input type="hidden" name="id" value="@checkIn.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <label>
                                        <span>Điểm (0-100)</span>
                                        <input type="number" name="reviewScore" min="0" max="100" step="0.01" placeholder="Tùy chọn" />
                                    </label>
                                    <label class="ci-review-form__comment">
                                        <span>Nhận xét</span>
                                        <textarea name="reviewComment" rows="2" maxlength="2000" placeholder="Nêu lý do xác nhận hoặc từ chối..."></textarea>
                                    </label>
                                    <div class="ci-review-form__actions">
                                        <button type="submit" name="decision" value="Rejected" class="ci-review-button ci-review-button--reject">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i> Từ chối
                                        </button>
                                        <button type="submit" name="decision" value="Approved" class="ci-review-button ci-review-button--approve">
                                            <i class="bi bi-check-lg" aria-hidden="true"></i> Xác nhận
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }

                        <footer class="ci-discussion">
                            <button class="ci-discussion__toggle" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#comments-@checkIn.Id" aria-expanded="false" aria-controls="comments-@checkIn.Id">
                                <span><i class="bi bi-chat-left-text" aria-hidden="true"></i> Trao đổi &amp; đánh giá bổ sung</span>
                                <span>@comments.Count bình luận <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
                            </button>
                            <div class="collapse ci-discussion__body" id="comments-@checkIn.Id">
                                @if (comments.Any())
                                {
                                    <div class="ci-comment-list">
                                        @foreach (var comment in comments)
                                        {
                                            var commenter = comment.CommenterId.HasValue && employeesDict.TryGetValue(comment.CommenterId.Value, out var savedCommenter)
                                                ? savedCommenter.FullName
                                                : "Hệ thống";
                                            <div class="ci-comment">
                                                <div>
                                                    <strong>@commenter</strong>
                                                    <time>@comment.CommentTime?.ToString("dd/MM/yyyy HH:mm")</time>
                                                </div>
                                                @if (comment.Rating.HasValue)
                                                {
                                                    <span class="ci-comment__rating">@comment.Rating.Value.ToString("0.##")/100</span>
                                                }
                                                <p>@comment.Content</p>
                                            </div>
                                        }
                                    </div>
                                }
                                <form asp-action="AddComment" method="post" class="ci-comment-form">
                                    <input type="hidden" name="checkInId" value="@checkIn.Id" />
                                    <input type="hidden" name="kpiId" value="@checkIn.KPIId" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <label class="ci-comment-form__content">
                                        <span class="visually-hidden">Nội dung bình luận</span>
                                        <textarea name="content" rows="2" maxlength="2000" placeholder="Thêm bình luận về lần check-in này..." required></textarea>
                                    </label>
                                    <label>
                                        <span class="visually-hidden">Điểm đánh giá</span>
                                        <input type="number" min="0" max="100" step="0.01" name="rating" placeholder="Điểm" />
                                    </label>
                                    <button type="submit" class="evaluation-secondary-action">
                                        <i class="bi bi-send" aria-hidden="true"></i> Gửi
                                    </button>
                                </form>
                            </div>
                        </footer>
                    </article>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="evaluation-pagination" aria-label="Phân trang check-in">
                    @if (currentPage > 1)
                    {
                        <a asp-action="Index" asp-route-searchString="@searchString" asp-route-statusId="@selectedStatusId" asp-route-reviewStatus="@selectedReviewStatus" asp-route-quickFilter="@selectedQuickFilter" asp-route-page="@(currentPage - 1)" aria-label="Trang trước">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <span class="is-disabled"><i class="bi bi-chevron-left" aria-hidden="true"></i></span>
                    }

                    @for (var pageNumber = Math.Max(1, currentPage - 2); pageNumber <= Math.Min(totalPages, currentPage + 2); pageNumber++)
                    {
                        if (pageNumber == currentPage)
                        {
                            <span class="is-current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-searchString="@searchString" asp-route-statusId="@selectedStatusId" asp-route-reviewStatus="@selectedReviewStatus" asp-route-quickFilter="@selectedQuickFilter" asp-route-page="@pageNumber">@pageNumber</a>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <a asp-action="Index" asp-route-searchString="@searchString" asp-route-statusId="@selectedStatusId" asp-route-reviewStatus="@selectedReviewStatus" asp-route-quickFilter="@selectedQuickFilter" asp-route-page="@(currentPage + 1)" aria-label="Trang sau">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <span class="is-disabled"><i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                    }
                </nav>
            }
        }
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kpi-checkins.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.querySelectorAll('.ci-filter-form select').forEach(function(select) {
            function updateState() {
                if (select.value && select.value !== '') {
                    select.classList.add('is-selected');
                } else {
                    select.classList.remove('is-selected');
                }
            }
            select.addEventListener('change', updateState);
            updateState();
        });
    </script>
}
