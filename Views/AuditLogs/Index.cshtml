@model Manage_KPI_or_OKR_System.Helpers.PaginatedList<Manage_KPI_or_OKR_System.Models.AuditLog>
@{
    ViewData["Title"] = "Nhật ký Hệ thống";

    var logs = Model?.ToList() ?? new List<Manage_KPI_or_OKR_System.Models.AuditLog>();
    var users = ViewBag.Users as Dictionary<int, string> ?? new Dictionary<int, string>();
    var userRoleIds = ViewBag.UserRoleIds as Dictionary<int, int?> ?? new Dictionary<int, int?>();
    var roles = ViewBag.Roles as Dictionary<int, string> ?? new Dictionary<int, string>();
    var currentFilter = ViewData["CurrentFilter"] as string;
    int? currentRoleId = ViewData["CurrentRoleId"] is int selectedRoleId ? selectedRoleId : null;
    var startDate = ViewData["StartDate"] as string;
    var endDate = ViewData["EndDate"] as string;
    var hasFilters = !string.IsNullOrWhiteSpace(currentFilter) || currentRoleId.HasValue || !string.IsNullOrWhiteSpace(startDate) || !string.IsNullOrWhiteSpace(endDate);
    var currentPage = Model?.PageIndex ?? 1;
    var totalPages = Model?.TotalPages ?? 0;
    var totalCount = Model?.TotalCount ?? logs.Count;

    var createCount = logs.Count(l => l.ActionType != null && (l.ActionType.Contains("CREATE") || l.ActionType.Contains("APPROVE")));
    var updateCount = logs.Count(l => l.ActionType != null && (l.ActionType.Contains("UPDATE") || l.ActionType.Contains("EDIT") || l.ActionType.Contains("PROPOSAL") || l.ActionType.Contains("COMMENT")));
    var deleteCount = logs.Count(l => l.ActionType != null && (l.ActionType.Contains("DELETE") || l.ActionType.Contains("REJECT")));

    string GetActionClass(string? action)
    {
        return action switch
        {
            "CREATE" or "CREATE_APPROVED" or "APPROVE" or "DIRECTOR_APPROVE" => "audit-action--success",
            "UPDATE" => "audit-action--warning",
            "DELETE" or "REJECT" or "DIRECTOR_REJECT" => "audit-action--danger",
            "COMMENT" => "audit-action--info",
            "SUBMIT_REVIEW" => "audit-action--primary",
            _ => "audit-action--neutral"
        };
    }

    string GetActionIcon(string? action)
    {
        return action switch
        {
            "CREATE" or "CREATE_APPROVED" => "plus-circle-fill",
            "APPROVE" or "DIRECTOR_APPROVE" => "check-circle-fill",
            "UPDATE" => "pencil-square",
            "DELETE" or "REJECT" or "DIRECTOR_REJECT" => "x-circle-fill",
            "COMMENT" => "chat-left-text-fill",
            "SUBMIT_REVIEW" => "send-fill",
            _ => "activity"
        };
    }

    string GetActionText(string? action)
    {
        return action switch
        {
            "CREATE" => "Tạo mới",
            "CREATE_APPROVED" => "Tạo & duyệt",
            "UPDATE" => "Cập nhật",
            "DELETE" => "Xóa",
            "APPROVE" => "Duyệt",
            "REJECT" => "Từ chối",
            "COMMENT" => "Bình luận",
            "SUBMIT_REVIEW" => "Gửi duyệt",
            "DIRECTOR_APPROVE" => "GĐ duyệt",
            "DIRECTOR_REJECT" => "GĐ từ chối",
            "AUTO_SYNC_PROPOSAL" => "Đề xuất đồng bộ",
            _ => string.IsNullOrWhiteSpace(action) ? "Không xác định" : action
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <style>
        .auditlog-page .auditlog-header-copy {
            max-width: 720px;
            margin: 0;
            color: var(--evaluation-muted);
            font-size: 0.88rem;
        }

        /* 4 TOP STAT CARDS */
        .auditlog-page .auditlog-stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.25rem;
            margin-bottom: 1.25rem;
        }

        .auditlog-page .auditlog-stat-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 18px;
            border-radius: 12px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }

        .auditlog-page .auditlog-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
        }

        .auditlog-page .auditlog-stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .auditlog-page .auditlog-stat-icon.icon-primary { background: rgba(79, 70, 229, 0.08); color: #4f46e5; }
        .auditlog-page .auditlog-stat-icon.icon-success { background: rgba(16, 185, 129, 0.08); color: #10b981; }
        .auditlog-page .auditlog-stat-icon.icon-warning { background: rgba(245, 158, 11, 0.08); color: #f59e0b; }
        .auditlog-page .auditlog-stat-icon.icon-danger  { background: rgba(239, 68, 68, 0.08); color: #ef4444; }

        .auditlog-page .auditlog-stat-value {
            font-size: 1.35rem;
            font-weight: 850;
            color: #0f172a;
            line-height: 1.1;
        }

        .auditlog-page .auditlog-stat-label {
            color: #64748b;
            font-size: 0.76rem;
            font-weight: 600;
            margin-top: 2px;
        }

        /* FILTER FORM */
        .auditlog-page .auditlog-filter-form {
            display: flex !important;
            flex-wrap: wrap !important;
            align-items: center !important;
            gap: 0.65rem !important;
            width: 100% !important;
            margin-top: 0.75rem !important;
        }

        .auditlog-page .auditlog-filter-form label {
            margin: 0 !important;
            display: flex !important;
            align-items: center !important;
            flex-direction: row !important;
            justify-content: flex-start !important;
        }

        .auditlog-page .auditlog-filter-form label > span {
            display: none !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-search-field {
            flex: 2 1 240px !important;
            min-width: 200px !important;
            margin: 0 !important;
        }

        .auditlog-page .auditlog-filter-form label:not(.evaluation-search-field) {
            flex: 1 1 150px !important;
            min-width: 135px !important;
            margin: 0 !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-search-input-wrap {
            position: relative !important;
            display: flex !important;
            align-items: center !important;
            width: 100% !important;
            height: 38px !important;
            margin: 0 !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-search-input-wrap i {
            position: absolute !important;
            left: 11px !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            color: #878a99 !important;
            font-size: 0.88rem !important;
            pointer-events: none !important;
            z-index: 2 !important;
            margin: 0 !important;
            line-height: 1 !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-search-input-wrap input,
        .auditlog-page .auditlog-filter-form select,
        .auditlog-page .auditlog-filter-form input[type="date"],
        .auditlog-page .auditlog-filter-form .evaluation-secondary-action,
        .auditlog-page .auditlog-filter-form .evaluation-filter-button {
            height: 38px !important;
            min-height: 38px !important;
            max-height: 38px !important;
            border-radius: 8px !important;
            box-sizing: border-box !important;
            font-size: 0.83rem !important;
            margin: 0 !important;
            vertical-align: middle !important;
            align-self: center !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-search-input-wrap input {
            padding: 0 12px 0 34px !important;
            width: 100% !important;
            border: 1px solid #d1d5db !important;
            background: #ffffff !important;
            color: #212529 !important;
            line-height: 36px !important;
        }

        .auditlog-page .auditlog-filter-form select,
        .auditlog-page .auditlog-filter-form input[type="date"] {
            width: 100% !important;
            border: 1px solid #d1d5db !important;
            padding: 0 28px 0 12px !important;
            line-height: 36px !important;
            background-color: #ffffff !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-secondary-action,
        .auditlog-page .auditlog-filter-form .evaluation-filter-button {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.45rem !important;
            padding: 0 1.1rem !important;
            white-space: nowrap !important;
            line-height: 36px !important;
            font-weight: 600 !important;
            cursor: pointer !important;
            flex-shrink: 0 !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-secondary-action {
            border: 1px solid #d1d5db !important;
            background: #ffffff !important;
            color: #374151 !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-secondary-action:hover {
            background: #f3f4f6 !important;
            border-color: #9ca3af !important;
            color: #111827 !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-filter-button {
            background: #4f46e5 !important;
            border: 1px solid #4f46e5 !important;
            color: #ffffff !important;
        }

        .auditlog-page .auditlog-filter-form .evaluation-filter-button:hover {
            background: #4338ca !important;
            border-color: #4338ca !important;
        }

        /* TABLE STYLING */
        .auditlog-page .auditlog-table {
            min-width: 1100px;
        }

        .auditlog-page .auditlog-user {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            min-width: 145px;
        }

        .auditlog-page .auditlog-avatar {
            display: inline-grid;
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            place-items: center;
            border-radius: 8px;
            background: rgba(79, 70, 229, 0.08);
            color: #4f46e5;
            font-size: 0.75rem;
            font-weight: 800;
        }

        .auditlog-page .auditlog-user strong,
        .auditlog-page .auditlog-user small,
        .auditlog-page .auditlog-time strong,
        .auditlog-page .auditlog-time small {
            display: block;
        }

        .auditlog-page .auditlog-user strong,
        .auditlog-page .auditlog-time strong {
            color: #1e293b;
            font-size: 0.8rem;
        }

        .auditlog-page .auditlog-user small,
        .auditlog-page .auditlog-time small {
            margin-top: 0.12rem;
            color: #64748b;
            font-size: 0.72rem;
        }

        .auditlog-page .auditlog-role {
            display: inline-flex;
            align-items: center;
            min-height: 26px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 0.25rem 0.55rem;
            background: #f8fafc;
            color: #475467;
            font-size: 0.72rem;
            font-weight: 650;
            white-space: nowrap;
        }

        .auditlog-page .audit-action {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            min-height: 26px;
            border: 1px solid transparent;
            border-radius: 6px;
            padding: 0.25rem 0.6rem;
            font-size: 0.72rem;
            font-weight: 750;
            white-space: nowrap;
        }

        .auditlog-page .audit-action--success { border-color: rgba(16, 185, 129, 0.2); background: rgba(16, 185, 129, 0.08); color: #059669; }
        .auditlog-page .audit-action--warning { border-color: rgba(245, 158, 11, 0.2); background: rgba(245, 158, 11, 0.08); color: #d97706; }
        .auditlog-page .audit-action--danger  { border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.08); color: #dc2626; }
        .auditlog-page .audit-action--info    { border-color: rgba(6, 182, 212, 0.2); background: rgba(6, 182, 212, 0.08); color: #0891b2; }
        .auditlog-page .audit-action--primary { border-color: rgba(79, 70, 229, 0.2); background: rgba(79, 70, 229, 0.08); color: #4f46e5; }
        .auditlog-page .audit-action--neutral { border-color: #e2e8f0; background: #f8fafc; color: #64748b; }

        .auditlog-page .auditlog-table-name {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 7px;
            border-radius: 4px;
            background: #f1f5f9;
            color: #475569;
            font-size: 0.75rem;
            font-weight: 700;
            font-family: Consolas, "Courier New", monospace;
        }

        .auditlog-page .auditlog-summary {
            max-width: 330px;
            overflow: hidden;
            color: #64748b;
            font-size: 0.75rem;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .auditlog-page .auditlog-detail-button {
            height: 32px;
            padding: 0 0.75rem;
            font-size: 0.75rem;
            border-radius: 6px;
            font-weight: 600;
        }

        .auditlog-page .auditlog-pagination-meta {
            margin: 0;
            color: #64748b;
            font-size: 0.78rem;
        }

        .auditlog-page .auditlog-pagination-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            border-top: 1px solid #e2e8f0;
            margin-top: 0.9rem;
            padding-top: 0.9rem;
        }

        .auditlog-page .auditlog-pagination-row .evaluation-pagination {
            padding-top: 0;
        }

        /* ============================================================ */
        /* MODAL REDESIGN: ULTRA-MODERN DIFF COMPARISON DIALOG          */
        /* ============================================================ */
        .auditlog-modal {
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 16px;
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
            overflow: hidden;
        }

        .auditlog-modal .modal-header {
            padding: 16px 22px;
            background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
            border-bottom: 1px solid #e2e8f0;
        }

        .auditlog-modal .modal-title-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .auditlog-modal .modal-title-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #4f46e5, #6366f1);
            color: #ffffff;
            font-size: 1.15rem;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
            flex-shrink: 0;
        }

        .auditlog-modal .modal-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .auditlog-modal .modal-subtitle {
            color: #64748b;
            font-size: 0.78rem;
            margin-bottom: 0;
        }

        .auditlog-modal .modal-body {
            padding: 20px 22px;
            background: #ffffff;
        }

        /* 4 FACT CHIPS */
        .auditlog-modal .auditlog-modal-facts {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 18px;
        }

        .auditlog-modal .auditlog-modal-fact {
            min-width: 0;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 12px;
            background: #f8fafc;
            transition: all 0.15s ease;
        }

        .auditlog-modal .auditlog-modal-fact:hover {
            border-color: #cbd5e1;
            background: #f1f5f9;
        }

        .auditlog-modal .auditlog-modal-fact-label {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 4px;
            color: #64748b;
            font-size: 0.68rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .auditlog-modal .auditlog-modal-fact-value {
            font-size: 0.84rem;
            font-weight: 700;
            color: #1e293b;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.3;
        }

        /* DATA DIFF SECTION */
        .auditlog-modal .auditlog-data-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 10px;
        }

        .auditlog-modal .auditlog-data-title {
            font-size: 0.86rem;
            font-weight: 800;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .auditlog-modal .auditlog-data-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .auditlog-modal .auditlog-data-grid.is-single {
            grid-template-columns: 1fr;
        }

        .auditlog-modal .auditlog-data-panel {
            display: flex;
            flex-direction: column;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            background: #0f172a;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
        }

        .auditlog-modal .auditlog-data-panel.panel-old {
            border-top: 3px solid #ef4444;
        }

        .auditlog-modal .auditlog-data-panel.panel-new {
            border-top: 3px solid #10b981;
        }

        .auditlog-modal .auditlog-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            color: #94a3b8;
            font-size: 0.72rem;
            font-weight: 750;
        }

        .auditlog-modal .panel-old .auditlog-panel-header { color: #fca5a5; }
        .auditlog-modal .panel-new .auditlog-panel-header { color: #6ee7b7; }

        .auditlog-modal pre {
            max-height: 280px;
            margin: 0;
            overflow: auto;
            padding: 12px 14px;
            background: transparent;
            color: #f1f5f9;
            font-family: Consolas, "JetBrains Mono", Monaco, "Courier New", monospace;
            font-size: 0.76rem;
            line-height: 1.55;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .auditlog-modal pre.empty-state {
            color: #64748b;
            font-style: italic;
        }

        .auditlog-modal .modal-footer {
            padding: 12px 22px;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
        }

        @@media (max-width: 1200px) {
            .auditlog-page .auditlog-stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .auditlog-page .auditlog-stats-grid {
                grid-template-columns: 1fr;
                gap: 0.75rem;
            }

            .auditlog-modal .auditlog-modal-facts {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .auditlog-modal .auditlog-data-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="evaluation-page auditlog-page">
    <!-- PAGE HEADER -->
    <header class="evaluation-page-header mb-3.5">
        <div>
            <h1 class="h4 font-weight-bold mb-1">Nhật ký Hệ thống</h1>
            <p class="auditlog-header-copy">Theo dõi người thực hiện, hành động và dữ liệu thay đổi trong các luồng nghiệp vụ quan trọng.</p>
            <nav class="evaluation-breadcrumb mt-1" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right separator" aria-hidden="true"></i>
                <span>Hệ thống</span>
                <i class="bi bi-chevron-right separator" aria-hidden="true"></i>
                <span>Nhật ký</span>
            </nav>
        </div>
    </header>

    <!-- 4 STAT CARDS -->
    <section class="auditlog-stats-grid" aria-label="Thống kê nhật ký">
        <div class="auditlog-stat-card">
            <div class="auditlog-stat-icon icon-primary">
                <i class="bi bi-journal-text"></i>
            </div>
            <div>
                <div class="auditlog-stat-value">@totalCount</div>
                <div class="auditlog-stat-label">Tổng bản ghi nhật ký</div>
            </div>
        </div>
        <div class="auditlog-stat-card">
            <div class="auditlog-stat-icon icon-success">
                <i class="bi bi-plus-circle"></i>
            </div>
            <div>
                <div class="auditlog-stat-value text-success">@createCount</div>
                <div class="auditlog-stat-label">Tạo mới & Duyệt (trang này)</div>
            </div>
        </div>
        <div class="auditlog-stat-card">
            <div class="auditlog-stat-icon icon-warning">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div>
                <div class="auditlog-stat-value text-warning">@updateCount</div>
                <div class="auditlog-stat-label">Cập nhật & Đề xuất</div>
            </div>
        </div>
        <div class="auditlog-stat-card">
            <div class="auditlog-stat-icon icon-danger">
                <i class="bi bi-trash3"></i>
            </div>
            <div>
                <div class="auditlog-stat-value text-danger">@deleteCount</div>
                <div class="auditlog-stat-label">Xóa & Từ chối</div>
            </div>
        </div>
    </section>

    <!-- FILTER PANEL -->
    <section class="evaluation-filter-panel mb-3.5" aria-labelledby="auditLogFilterHeading">
        <div class="evaluation-filter-heading">
            <div>
                <strong id="auditLogFilterHeading">Tra cứu nhật ký</strong>
                <span>Lọc theo nội dung, vai trò hoặc khoảng thời gian cần kiểm tra.</span>
            </div>
            @if (hasFilters)
            {
                <a asp-action="Index" class="evaluation-clear-link">
                    <i class="bi bi-x-circle" aria-hidden="true"></i>Xóa bộ lọc
                </a>
            }
        </div>
        <form asp-action="Index" method="get" class="evaluation-filter-form auditlog-filter-form">
            <label class="evaluation-search-field">
                <span class="visually-hidden">Tìm kiếm</span>
                <div class="evaluation-search-input-wrap">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" name="searchString" value="@currentFilter" placeholder="Tài khoản, bảng hoặc hành động..." autocomplete="off" />
                </div>
            </label>
            <label>
                <span class="visually-hidden">Vai trò thao tác</span>
                <select name="roleId" class="no-select2">
                    <option value="">Tất cả vai trò</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role.Key" selected="@(currentRoleId == role.Key ? "selected" : null)">@role.Value</option>
                    }
                </select>
            </label>
            <label>
                <span class="visually-hidden">Từ ngày</span>
                <input type="date" name="startDate" value="@startDate" />
            </label>
            <label>
                <span class="visually-hidden">Đến ngày</span>
                <input type="date" name="endDate" value="@endDate" />
            </label>
            <a asp-action="Index" class="evaluation-secondary-action" aria-label="Đặt lại bộ lọc">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                <span>Đặt lại</span>
            </a>
            <button type="submit" class="evaluation-filter-button">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <span>Lọc</span>
            </button>
        </form>
    </section>

    <!-- RESULTS SECTION -->
    <section class="evaluation-results" aria-labelledby="auditLogResultsHeading">
        <div class="evaluation-results-heading">
            <strong id="auditLogResultsHeading">Lịch sử thay đổi</strong>
            <span>@logs.Count bản ghi trên trang @currentPage@(totalPages > 0 ? $"/{totalPages}" : string.Empty)</span>
        </div>

        @if (!logs.Any())
        {
            <div class="evaluation-empty" role="status">
                <span class="evaluation-empty-icon"><i class="bi bi-journal-x" aria-hidden="true"></i></span>
                <h2>@(hasFilters ? "Không tìm thấy nhật ký phù hợp" : "Chưa có nhật ký hệ thống")</h2>
                <p>@(hasFilters ? "Hãy điều chỉnh từ khóa hoặc khoảng thời gian để xem thêm kết quả." : "Các thay đổi quan trọng sẽ xuất hiện tại đây khi hệ thống ghi nhận hoạt động.")</p>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="evaluation-secondary-action">Xóa bộ lọc</a>
                }
            </div>
        }
        else
        {
            <div class="evaluation-table-shell">
                <table class="evaluation-table auditlog-table" aria-label="Danh sách nhật ký hệ thống">
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>Tài khoản</th>
                            <th>Vai trò</th>
                            <th>Hành động</th>
                            <th>Bảng tác động</th>
                            <th>Tóm tắt thay đổi</th>
                            <th class="text-end">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in logs)
                        {
                            var userName = log.SystemUserId.HasValue && users.TryGetValue(log.SystemUserId.Value, out var mappedUserName) ? mappedUserName : "Hệ thống";
                            var roleName = "Hệ thống";
                            if (log.SystemUserId.HasValue && userRoleIds.TryGetValue(log.SystemUserId.Value, out var logRoleId) && logRoleId.HasValue && roles.TryGetValue(logRoleId.Value, out var mappedRoleName))
                            {
                                roleName = mappedRoleName;
                            }
                            var initial = userName.Length > 0 ? userName[0].ToString().ToUpperInvariant() : "?";
                            var changeSummary = string.IsNullOrEmpty(log.NewData) ? (string.IsNullOrEmpty(log.OldData) ? "Không có dữ liệu chi tiết" : log.OldData) : log.NewData;
                            var formattedTime = log.LogTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "Chưa xác định";

                            <tr>
                                <td>
                                    <div class="auditlog-time">
                                        <strong>@(log.LogTime?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</strong>
                                        <small>@(log.LogTime?.ToString("HH:mm:ss") ?? string.Empty)</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="auditlog-user">
                                        <span class="auditlog-avatar" aria-hidden="true">@initial</span>
                                        <div><strong>@userName</strong><small>ID nhật ký #@log.Id</small></div>
                                    </div>
                                </td>
                                <td><span class="auditlog-role">@roleName</span></td>
                                <td>
                                    <span class="audit-action @GetActionClass(log.ActionType)">
                                        <i class="bi bi-@GetActionIcon(log.ActionType)"></i>
                                        @GetActionText(log.ActionType)
                                    </span>
                                </td>
                                <td>
                                    <span class="auditlog-table-name">
                                        <i class="bi bi-database"></i>
                                        @(log.ImpactedTable ?? "Không xác định")
                                    </span>
                                </td>
                                <td><div class="auditlog-summary" title="@changeSummary">@changeSummary</div></td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 auditlog-detail-btn"
                                            data-id="@log.Id"
                                            data-action="@log.ActionType"
                                            data-table="@log.ImpactedTable"
                                            data-user="@userName"
                                            data-role="@roleName"
                                            data-time="@formattedTime"
                                            data-old="@log.OldData"
                                            data-new="@log.NewData"
                                            aria-label="Xem chi tiết nhật ký #@log.Id">
                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="evaluation-mobile-list">
                @foreach (var log in logs)
                {
                    var userName = log.SystemUserId.HasValue && users.TryGetValue(log.SystemUserId.Value, out var mappedUserName) ? mappedUserName : "Hệ thống";
                    var roleName = "Hệ thống";
                    if (log.SystemUserId.HasValue && userRoleIds.TryGetValue(log.SystemUserId.Value, out var logRoleId) && logRoleId.HasValue && roles.TryGetValue(logRoleId.Value, out var mappedRoleName))
                    {
                        roleName = mappedRoleName;
                    }
                    var changeSummary = string.IsNullOrEmpty(log.NewData) ? (string.IsNullOrEmpty(log.OldData) ? "Không có dữ liệu chi tiết" : log.OldData) : log.NewData;
                    var formattedTime = log.LogTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "Chưa xác định";

                    <article class="evaluation-period-card auditlog-card">
                        <div class="evaluation-card-topline">
                            <span class="audit-action @GetActionClass(log.ActionType)">@GetActionText(log.ActionType)</span>
                            <span class="auditlog-role">@roleName</span>
                        </div>
                        <h2>@userName</h2>
                        <p>@formattedTime</p>
                        <dl>
                            <div><dt>Bảng tác động</dt><dd>@(log.ImpactedTable ?? "Không xác định")</dd></div>
                            <div><dt>Mã nhật ký</dt><dd>#@log.Id</dd></div>
                        </dl>
                        <p class="auditlog-card-summary">@changeSummary</p>
                        <div class="evaluation-card-footer">
                            <span class="evaluation-no-action">Dữ liệu chỉ đọc</span>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 auditlog-detail-btn"
                                    data-id="@log.Id"
                                    data-action="@log.ActionType"
                                    data-table="@log.ImpactedTable"
                                    data-user="@userName"
                                    data-role="@roleName"
                                    data-time="@formattedTime"
                                    data-old="@log.OldData"
                                    data-new="@log.NewData"
                                    aria-label="Xem chi tiết nhật ký #@log.Id">
                                <i class="bi bi-eye me-1" aria-hidden="true"></i>Chi tiết
                            </button>
                        </div>
                    </article>
                }
            </div>
        }

        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="auditlog-pagination-row">
                <p class="auditlog-pagination-meta">Trang <strong>@Model.PageIndex</strong> trên <strong>@Model.TotalPages</strong></p>
                <nav class="evaluation-pagination" aria-label="Phân trang nhật ký hệ thống">
                    @if (Model.PreviousPageNumber.HasValue)
                    {
                        <a asp-action="Index" asp-route-pageNumber="@Model.PreviousPageNumber" asp-route-searchString="@currentFilter" asp-route-roleId="@currentRoleId" asp-route-startDate="@startDate" asp-route-endDate="@endDate" aria-label="Trang trước"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                    }

                    @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
                    {
                        if (pageIndex == 1 || pageIndex == Model.TotalPages || (pageIndex >= Model.PageIndex - 2 && pageIndex <= Model.PageIndex + 2))
                        {
                            <a asp-action="Index" asp-route-pageNumber="@pageIndex" asp-route-searchString="@currentFilter" asp-route-roleId="@currentRoleId" asp-route-startDate="@startDate" asp-route-endDate="@endDate" class="@(pageIndex == Model.PageIndex ? "is-current" : string.Empty)" aria-current="@(pageIndex == Model.PageIndex ? "page" : null)">@pageIndex</a>
                        }
                        else if (pageIndex == Model.PageIndex - 3 || pageIndex == Model.PageIndex + 3)
                        {
                            <span class="is-disabled" aria-hidden="true">…</span>
                        }
                    }

                    @if (Model.NextPageNumber.HasValue)
                    {
                        <a asp-action="Index" asp-route-pageNumber="@Model.NextPageNumber" asp-route-searchString="@currentFilter" asp-route-roleId="@currentRoleId" asp-route-startDate="@startDate" asp-route-endDate="@endDate" aria-label="Trang sau"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                    }
                </nav>
            </div>
        }
    </section>
</div>

<!-- ========================================================================= -->
<!-- ULTRA-MODERN DIFF COMPARISON MODAL DIALOG                                -->
<!-- ========================================================================= -->
<div class="modal fade" id="logDetailsModal" tabindex="-1" aria-labelledby="logDetailsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content auditlog-modal">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div class="modal-title-icon">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div>
                        <h2 class="modal-title" id="logDetailsModalTitle">Chi tiết Nhật ký Hệ thống</h2>
                        <p class="modal-subtitle">Đối chiếu dữ liệu trước và sau thao tác được ghi nhận.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng cửa sổ chi tiết"></button>
            </div>
            <div class="modal-body">
                <!-- 4 FACT CHIPS -->
                <div class="auditlog-modal-facts">
                    <div class="auditlog-modal-fact">
                        <span class="auditlog-modal-fact-label">
                            <i class="bi bi-person-fill"></i> Người thực hiện
                        </span>
                        <div class="auditlog-modal-fact-value" id="modalUser">admin</div>
                    </div>
                    <div class="auditlog-modal-fact">
                        <span class="auditlog-modal-fact-label">
                            <i class="bi bi-activity"></i> Hành động
                        </span>
                        <div class="auditlog-modal-fact-value">
                            <span id="modalAction" class="audit-action audit-action--neutral"></span>
                        </div>
                    </div>
                    <div class="auditlog-modal-fact">
                        <span class="auditlog-modal-fact-label">
                            <i class="bi bi-database"></i> Bảng dữ liệu
                        </span>
                        <div class="auditlog-modal-fact-value">
                            <code id="modalTable" class="auditlog-table-name">Không xác định</code>
                        </div>
                    </div>
                    <div class="auditlog-modal-fact">
                        <span class="auditlog-modal-fact-label">
                            <i class="bi bi-clock-history"></i> Thời gian
                        </span>
                        <div class="auditlog-modal-fact-value" id="modalTime">--</div>
                    </div>
                </div>

                <!-- DATA DIFF SECTION -->
                <div>
                    <div class="auditlog-data-heading">
                        <span class="auditlog-data-title">
                            <i class="bi bi-file-earmark-diff text-primary"></i> Dữ liệu thay đổi
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="copyLogDataButton">
                            <i class="bi bi-clipboard me-1" aria-hidden="true"></i>Sao chép
                        </button>
                    </div>
                    <div class="auditlog-data-grid" id="auditlogDataGrid">
                        <div class="auditlog-data-panel panel-old" id="oldDataContainer">
                            <div class="auditlog-panel-header">
                                <span><i class="bi bi-dash-circle me-1"></i> Dữ liệu trước thay đổi</span>
                                <span class="badge bg-danger bg-opacity-25 text-danger px-2 py-0.5 rounded">Ban đầu</span>
                            </div>
                            <pre id="modalOldData"></pre>
                        </div>
                        <div class="auditlog-data-panel panel-new" id="newDataContainer">
                            <div class="auditlog-panel-header">
                                <span><i class="bi bi-check2-circle me-1"></i> Dữ liệu sau thay đổi</span>
                                <span class="badge bg-success bg-opacity-25 text-success px-2 py-0.5 rounded">Cập nhật</span>
                            </div>
                            <pre id="modalNewData"></pre>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modalElement = document.getElementById('logDetailsModal');
            const actionElement = document.getElementById('modalAction');
            const tableElement = document.getElementById('modalTable');
            const userElement = document.getElementById('modalUser');
            const timeElement = document.getElementById('modalTime');
            const oldDataElement = document.getElementById('modalOldData');
            const newDataElement = document.getElementById('modalNewData');
            const oldDataContainer = document.getElementById('oldDataContainer');
            const newDataContainer = document.getElementById('newDataContainer');
            const dataGrid = document.getElementById('auditlogDataGrid');

            if (!modalElement || !actionElement || !tableElement || !oldDataElement || !newDataElement || !oldDataContainer || !newDataContainer || !dataGrid) {
                return;
            }

            document.querySelectorAll('.auditlog-detail-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    showLogDetails(
                        button.dataset.id || '',
                        button.dataset.action || '',
                        button.dataset.table || '',
                        button.dataset.user || '',
                        button.dataset.role || '',
                        button.dataset.time || '',
                        button.dataset.old || '',
                        button.dataset.new || ''
                    );
                });
            });

            document.getElementById('copyLogDataButton')?.addEventListener('click', copyLogData);

            function showLogDetails(id, action, table, user, role, time, oldData, newData) {
                actionElement.textContent = translateAction(action);
                actionElement.className = 'audit-action ' + getActionBadgeClass(action);
                tableElement.textContent = table || 'Không xác định';
                userElement.textContent = user ? `${user} (${role || 'User'})` : 'Hệ thống';
                timeElement.textContent = time || 'Chưa xác định';

                const formattedOld = formatLogData(oldData);
                const formattedNew = formatLogData(newData);

                oldDataElement.textContent = formattedOld;
                oldDataElement.classList.toggle('empty-state', !oldData);

                newDataElement.textContent = formattedNew;
                newDataElement.classList.toggle('empty-state', !newData);

                oldDataContainer.hidden = false;
                newDataContainer.hidden = false;
                dataGrid.classList.remove('is-single');

                if (action === 'CREATE' || action === 'CREATE_APPROVED') {
                    oldDataContainer.hidden = true;
                    dataGrid.classList.add('is-single');
                } else if (action === 'DELETE') {
                    newDataContainer.hidden = true;
                    dataGrid.classList.add('is-single');
                }

                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            }

            function formatLogData(value) {
                if (!value) return '[ Không có dữ liệu ]';
                try {
                    return JSON.stringify(JSON.parse(value), null, 2);
                } catch (_) {
                    return value;
                }
            }

            function translateAction(action) {
                switch (action) {
                    case 'CREATE': return 'Tạo mới';
                    case 'CREATE_APPROVED': return 'Tạo & duyệt';
                    case 'UPDATE': return 'Cập nhật';
                    case 'DELETE': return 'Xóa';
                    case 'APPROVE': return 'Duyệt';
                    case 'REJECT': return 'Từ chối';
                    case 'COMMENT': return 'Bình luận';
                    case 'SUBMIT_REVIEW': return 'Gửi duyệt';
                    case 'DIRECTOR_APPROVE': return 'GĐ duyệt';
                    case 'DIRECTOR_REJECT': return 'GĐ từ chối';
                    case 'AUTO_SYNC_PROPOSAL': return 'Đề xuất đồng bộ';
                    default: return action || 'Không xác định';
                }
            }

            function getActionBadgeClass(action) {
                switch (action) {
                    case 'CREATE':
                    case 'CREATE_APPROVED':
                    case 'APPROVE':
                    case 'DIRECTOR_APPROVE': return 'audit-action--success';
                    case 'UPDATE': return 'audit-action--warning';
                    case 'DELETE':
                    case 'REJECT':
                    case 'DIRECTOR_REJECT': return 'audit-action--danger';
                    case 'COMMENT': return 'audit-action--info';
                    case 'SUBMIT_REVIEW': return 'audit-action--primary';
                    default: return 'audit-action--neutral';
                }
            }

            function copyLogData() {
                const text = `Dữ liệu cũ:\n${oldDataElement.textContent}\n\nDữ liệu mới:\n${newDataElement.textContent}`;
                navigator.clipboard.writeText(text)
                    .then(function () {
                        if (window.AppFeedback?.toast) {
                            window.AppFeedback.toast({ tone: 'success', title: 'Đã sao chép', message: 'Nội dung đã được lưu vào bộ nhớ tạm.' });
                        } else {
                            alert('Đã sao chép nội dung vào bộ nhớ tạm.');
                        }
                    })
                    .catch(function () {
                        if (window.AppFeedback?.toast) {
                            window.AppFeedback.toast({ tone: 'error', title: 'Không thể sao chép', message: 'Trình duyệt chưa cấp quyền truy cập bộ nhớ tạm.' });
                        }
                    });
            }
        })();
    </script>
}
