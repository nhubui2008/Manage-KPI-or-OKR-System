@model Manage_KPI_or_OKR_System.Helpers.PaginatedList<Manage_KPI_or_OKR_System.Models.AuditLog>
@{
    ViewData["Title"] = "Nhật ký Hệ thống";

    var logs = Model?.ToList() ?? new List<Manage_KPI_or_OKR_System.Models.AuditLog>();
    var users = ViewBag.Users as Dictionary<int, string> ?? new Dictionary<int, string>();
    var userRoleIds = ViewBag.UserRoleIds as Dictionary<int, int?> ?? new Dictionary<int, int?>();
    var roles = ViewBag.Roles as Dictionary<int, string> ?? new Dictionary<int, string>();
    var currentFilter = ViewData["CurrentFilter"] as string;
    int? currentRoleId = ViewData["CurrentRoleId"] is int selectedRoleId ? selectedRoleId : null;
    var startDate = ViewData["StartDate"] as string;
    var endDate = ViewData["EndDate"] as string;
    var hasFilters = !string.IsNullOrWhiteSpace(currentFilter) || currentRoleId.HasValue || !string.IsNullOrWhiteSpace(startDate) || !string.IsNullOrWhiteSpace(endDate);
    var currentPage = Model?.PageIndex ?? 1;
    var totalPages = Model?.TotalPages ?? 0;

    string GetActionClass(string? action)
    {
        return action switch
        {
            "CREATE" or "CREATE_APPROVED" or "APPROVE" or "DIRECTOR_APPROVE" => "audit-action--success",
            "UPDATE" => "audit-action--warning",
            "DELETE" or "REJECT" or "DIRECTOR_REJECT" => "audit-action--danger",
            "COMMENT" => "audit-action--info",
            "SUBMIT_REVIEW" => "audit-action--primary",
            _ => "audit-action--neutral"
        };
    }

    string GetActionText(string? action)
    {
        return action switch
        {
            "CREATE" => "Tạo mới",
            "CREATE_APPROVED" => "Tạo & duyệt",
            "UPDATE" => "Cập nhật",
            "DELETE" => "Xóa",
            "APPROVE" => "Duyệt",
            "REJECT" => "Từ chối",
            "COMMENT" => "Bình luận",
            "SUBMIT_REVIEW" => "Gửi duyệt",
            "DIRECTOR_APPROVE" => "GĐ duyệt",
            "DIRECTOR_REJECT" => "GĐ từ chối",
            _ => string.IsNullOrWhiteSpace(action) ? "Không xác định" : action
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <style>
        .auditlog-page .auditlog-header-copy {
            max-width: 720px;
            margin: 0;
            color: var(--evaluation-muted);
            font-size: 0.88rem;
        }

        .auditlog-page .auditlog-filter-form {
            grid-template-columns: minmax(240px, 1.4fr) minmax(170px, 0.8fr) minmax(150px, 0.7fr) minmax(150px, 0.7fr) auto auto;
        }

        .auditlog-page .auditlog-table {
            min-width: 1100px;
        }

        .auditlog-page .auditlog-user {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            min-width: 145px;
        }

        .auditlog-page .auditlog-avatar {
            display: inline-grid;
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            place-items: center;
            border-radius: 8px;
            background: var(--evaluation-brand-soft);
            color: var(--evaluation-brand);
            font-size: 0.75rem;
            font-weight: 800;
        }

        .auditlog-page .auditlog-user strong,
        .auditlog-page .auditlog-user small,
        .auditlog-page .auditlog-time strong,
        .auditlog-page .auditlog-time small {
            display: block;
        }

        .auditlog-page .auditlog-user strong,
        .auditlog-page .auditlog-time strong {
            color: var(--evaluation-ink);
            font-size: 0.8rem;
        }

        .auditlog-page .auditlog-user small,
        .auditlog-page .auditlog-time small {
            margin-top: 0.12rem;
            color: var(--evaluation-muted);
            font-size: 0.72rem;
        }

        .auditlog-page .auditlog-role {
            display: inline-flex;
            align-items: center;
            min-height: 28px;
            border: 1px solid var(--evaluation-line);
            border-radius: 7px;
            padding: 0.3rem 0.55rem;
            background: var(--evaluation-soft);
            color: #475467;
            font-size: 0.72rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .auditlog-page .audit-action {
            display: inline-flex;
            align-items: center;
            min-height: 28px;
            border: 1px solid transparent;
            border-radius: 7px;
            padding: 0.3rem 0.55rem;
            font-size: 0.72rem;
            font-weight: 750;
            white-space: nowrap;
        }

        .auditlog-page .audit-action--success { border-color: #b8dfcc; background: #edf8f2; color: #126b38; }
        .auditlog-page .audit-action--warning { border-color: #f5dfaa; background: #fff6df; color: #98620e; }
        .auditlog-page .audit-action--danger { border-color: #f4c8c3; background: #fff0ee; color: #b42318; }
        .auditlog-page .audit-action--info { border-color: #c9e0f4; background: #eef6fd; color: #245f92; }
        .auditlog-page .audit-action--primary { border-color: var(--evaluation-brand-border); background: var(--evaluation-brand-soft); color: var(--evaluation-brand); }
        .auditlog-page .audit-action--neutral { border-color: var(--evaluation-line); background: var(--evaluation-soft); color: #596273; }

        .auditlog-page .auditlog-table-name {
            color: var(--evaluation-brand);
            font-size: 0.76rem;
            font-weight: 750;
        }

        .auditlog-page .auditlog-summary {
            max-width: 330px;
            overflow: hidden;
            color: var(--evaluation-muted);
            font-size: 0.75rem;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .auditlog-page .auditlog-detail-button {
            min-height: 36px;
            padding: 0.5rem 0.7rem;
            font-size: 0.75rem;
        }

        .auditlog-page .auditlog-card > p {
            font-variant-numeric: tabular-nums;
        }

        .auditlog-page .auditlog-card-summary {
            margin: 0 0 0.85rem;
            color: var(--evaluation-muted);
            font-size: 0.76rem;
            line-height: 1.55;
            overflow-wrap: anywhere;
        }

        .auditlog-page .auditlog-pagination-meta {
            margin: 0;
            color: var(--evaluation-muted);
            font-size: 0.78rem;
        }

        .auditlog-page .auditlog-pagination-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            border-top: 1px solid var(--evaluation-line);
            margin-top: 0.9rem;
            padding-top: 0.9rem;
        }

        .auditlog-page .auditlog-pagination-row .evaluation-pagination {
            padding-top: 0;
        }

        .auditlog-modal .auditlog-modal-facts {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.75rem;
        }

        .auditlog-modal .auditlog-modal-fact {
            min-width: 0;
            border: 1px solid var(--evaluation-line);
            border-radius: 8px;
            padding: 0.8rem;
            background: var(--evaluation-soft);
        }

        .auditlog-modal .auditlog-modal-fact > span:first-child,
        .auditlog-modal .auditlog-data-heading span {
            display: block;
            margin-bottom: 0.35rem;
            color: var(--evaluation-muted);
            font-size: 0.7rem;
            font-weight: 750;
        }

        .auditlog-modal .auditlog-data-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
        }

        .auditlog-modal .auditlog-data-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.75rem;
        }

        .auditlog-modal .auditlog-data-grid.is-single {
            grid-template-columns: 1fr;
        }

        .auditlog-modal .auditlog-data-panel > span {
            display: block;
            margin-bottom: 0.35rem;
            color: var(--evaluation-muted);
            font-size: 0.68rem;
            font-weight: 750;
        }

        .auditlog-modal pre {
            max-height: 320px;
            margin: 0;
            overflow: auto;
            border-radius: 8px;
            padding: 0.85rem;
            background: #172033;
            color: #f8fafc;
            font-size: 0.74rem;
            line-height: 1.55;
            white-space: pre-wrap;
            word-break: break-word;
        }

        @@media (max-width: 1100px) {
            .auditlog-page .auditlog-filter-form {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .auditlog-page .auditlog-filter-form .evaluation-search-field {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 700px) {
            .auditlog-page .auditlog-filter-form {
                grid-template-columns: 1fr;
            }

            .auditlog-page .auditlog-filter-form .evaluation-search-field {
                grid-column: auto;
            }

            .auditlog-page .auditlog-filter-form .evaluation-secondary-action,
            .auditlog-page .auditlog-filter-form .evaluation-filter-button {
                width: 100%;
            }

            .auditlog-page .auditlog-pagination-row {
                align-items: stretch;
                flex-direction: column;
            }

            .auditlog-page .auditlog-pagination-row .evaluation-pagination {
                justify-content: center;
            }

            .auditlog-modal .auditlog-modal-facts,
            .auditlog-modal .auditlog-data-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="evaluation-page auditlog-page">
    <header class="evaluation-page-header">
        <div>
            <h1>Nhật ký Hệ thống</h1>
            <p class="auditlog-header-copy">Theo dõi người thực hiện, hành động và dữ liệu thay đổi trong các luồng nghiệp vụ quan trọng.</p>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Hệ thống</span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Nhật ký</span>
            </nav>
        </div>
    </header>

    <section class="evaluation-filter-panel" aria-labelledby="auditLogFilterHeading">
        <div class="evaluation-filter-heading">
            <div>
                <strong id="auditLogFilterHeading">Tra cứu nhật ký</strong>
                <span>Lọc theo nội dung, vai trò hoặc khoảng thời gian cần kiểm tra.</span>
            </div>
            @if (hasFilters)
            {
                <a asp-action="Index" class="evaluation-clear-link">
                    <i class="bi bi-x-circle" aria-hidden="true"></i>Xóa bộ lọc
                </a>
            }
        </div>
        <form asp-action="Index" method="get" class="evaluation-filter-form auditlog-filter-form">
            <label class="evaluation-search-field">
                <span>Từ khóa</span>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="searchString" value="@currentFilter" placeholder="Tài khoản, bảng hoặc hành động" />
            </label>
            <label>
                <span>Vai trò thao tác</span>
                <select name="roleId" class="no-select2">
                    <option value="">Tất cả vai trò</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role.Key" selected="@(currentRoleId == role.Key ? "selected" : null)">@role.Value</option>
                    }
                </select>
            </label>
            <label>
                <span>Từ ngày</span>
                <input type="date" name="startDate" value="@startDate" />
            </label>
            <label>
                <span>Đến ngày</span>
                <input type="date" name="endDate" value="@endDate" />
            </label>
            <a asp-action="Index" class="evaluation-secondary-action" aria-label="Đặt lại bộ lọc">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Đặt lại
            </a>
            <button type="submit" class="evaluation-filter-button">
                <i class="bi bi-funnel" aria-hidden="true"></i>Lọc
            </button>
        </form>
    </section>

    <section class="evaluation-results" aria-labelledby="auditLogResultsHeading">
        <div class="evaluation-results-heading">
            <strong id="auditLogResultsHeading">Lịch sử thay đổi</strong>
            <span>@logs.Count bản ghi trên trang @currentPage@(totalPages > 0 ? $"/{totalPages}" : string.Empty)</span>
        </div>

        @if (!logs.Any())
        {
            <div class="evaluation-empty" role="status">
                <span class="evaluation-empty-icon"><i class="bi bi-journal-x" aria-hidden="true"></i></span>
                <h2>@(hasFilters ? "Không tìm thấy nhật ký phù hợp" : "Chưa có nhật ký hệ thống")</h2>
                <p>@(hasFilters ? "Hãy điều chỉnh từ khóa hoặc khoảng thời gian để xem thêm kết quả." : "Các thay đổi quan trọng sẽ xuất hiện tại đây khi hệ thống ghi nhận hoạt động.")</p>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="evaluation-secondary-action">Xóa bộ lọc</a>
                }
            </div>
        }
        else
        {
            <div class="evaluation-table-shell">
                <table class="evaluation-table auditlog-table" aria-label="Danh sách nhật ký hệ thống">
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>Tài khoản</th>
                            <th>Vai trò</th>
                            <th>Hành động</th>
                            <th>Bảng tác động</th>
                            <th>Tóm tắt thay đổi</th>
                            <th class="text-end">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in logs)
                        {
                            var userName = log.SystemUserId.HasValue && users.TryGetValue(log.SystemUserId.Value, out var mappedUserName) ? mappedUserName : "Hệ thống";
                            var roleName = "Hệ thống";
                            if (log.SystemUserId.HasValue && userRoleIds.TryGetValue(log.SystemUserId.Value, out var logRoleId) && logRoleId.HasValue && roles.TryGetValue(logRoleId.Value, out var mappedRoleName))
                            {
                                roleName = mappedRoleName;
                            }
                            var initial = userName.Length > 0 ? userName[0].ToString().ToUpperInvariant() : "?";
                            var changeSummary = string.IsNullOrEmpty(log.NewData) ? (string.IsNullOrEmpty(log.OldData) ? "Không có dữ liệu chi tiết" : log.OldData) : log.NewData;
                            <tr>
                                <td>
                                    <div class="auditlog-time">
                                        <strong>@(log.LogTime?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</strong>
                                        <small>@(log.LogTime?.ToString("HH:mm:ss") ?? string.Empty)</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="auditlog-user">
                                        <span class="auditlog-avatar" aria-hidden="true">@initial</span>
                                        <div><strong>@userName</strong><small>ID nhật ký #@log.Id</small></div>
                                    </div>
                                </td>
                                <td><span class="auditlog-role">@roleName</span></td>
                                <td><span class="audit-action @GetActionClass(log.ActionType)">@GetActionText(log.ActionType)</span></td>
                                <td><code class="auditlog-table-name">@(log.ImpactedTable ?? "Không xác định")</code></td>
                                <td><div class="auditlog-summary" title="@changeSummary">@changeSummary</div></td>
                                <td class="text-end">
                                    <button type="button" class="evaluation-secondary-action auditlog-detail-button auditlog-detail-btn"
                                            data-id="@log.Id"
                                            data-action="@log.ActionType"
                                            data-table="@log.ImpactedTable"
                                            data-old="@log.OldData"
                                            data-new="@log.NewData"
                                            aria-label="Xem chi tiết nhật ký #@log.Id">
                                        <i class="bi bi-eye" aria-hidden="true"></i>Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="evaluation-mobile-list">
                @foreach (var log in logs)
                {
                    var userName = log.SystemUserId.HasValue && users.TryGetValue(log.SystemUserId.Value, out var mappedUserName) ? mappedUserName : "Hệ thống";
                    var roleName = "Hệ thống";
                    if (log.SystemUserId.HasValue && userRoleIds.TryGetValue(log.SystemUserId.Value, out var logRoleId) && logRoleId.HasValue && roles.TryGetValue(logRoleId.Value, out var mappedRoleName))
                    {
                        roleName = mappedRoleName;
                    }
                    var changeSummary = string.IsNullOrEmpty(log.NewData) ? (string.IsNullOrEmpty(log.OldData) ? "Không có dữ liệu chi tiết" : log.OldData) : log.NewData;
                    <article class="evaluation-period-card auditlog-card">
                        <div class="evaluation-card-topline">
                            <span class="audit-action @GetActionClass(log.ActionType)">@GetActionText(log.ActionType)</span>
                            <span class="auditlog-role">@roleName</span>
                        </div>
                        <h2>@userName</h2>
                        <p>@(log.LogTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "Chưa xác định")</p>
                        <dl>
                            <div><dt>Bảng tác động</dt><dd>@(log.ImpactedTable ?? "Không xác định")</dd></div>
                            <div><dt>Mã nhật ký</dt><dd>#@log.Id</dd></div>
                        </dl>
                        <p class="auditlog-card-summary">@changeSummary</p>
                        <div class="evaluation-card-footer">
                            <span class="evaluation-no-action">Dữ liệu chỉ đọc</span>
                            <button type="button" class="evaluation-secondary-action auditlog-detail-button auditlog-detail-btn"
                                    data-id="@log.Id"
                                    data-action="@log.ActionType"
                                    data-table="@log.ImpactedTable"
                                    data-old="@log.OldData"
                                    data-new="@log.NewData"
                                    aria-label="Xem chi tiết nhật ký #@log.Id trên thẻ di động">
                                <i class="bi bi-eye" aria-hidden="true"></i>Chi tiết
                            </button>
                        </div>
                    </article>
                }
            </div>
        }

        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="auditlog-pagination-row">
                <p class="auditlog-pagination-meta">Trang <strong>@Model.PageIndex</strong> trên <strong>@Model.TotalPages</strong></p>
                <nav class="evaluation-pagination" aria-label="Phân trang nhật ký hệ thống">
                    @if (Model.PreviousPageNumber.HasValue)
                    {
                        <a asp-action="Index" asp-route-pageNumber="@Model.PreviousPageNumber" asp-route-searchString="@currentFilter" asp-route-roleId="@currentRoleId" asp-route-startDate="@startDate" asp-route-endDate="@endDate" aria-label="Trang trước"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                    }

                    @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
                    {
                        if (pageIndex == 1 || pageIndex == Model.TotalPages || (pageIndex >= Model.PageIndex - 2 && pageIndex <= Model.PageIndex + 2))
                        {
                            <a asp-action="Index" asp-route-pageNumber="@pageIndex" asp-route-searchString="@currentFilter" asp-route-roleId="@currentRoleId" asp-route-startDate="@startDate" asp-route-endDate="@endDate" class="@(pageIndex == Model.PageIndex ? "is-current" : string.Empty)" aria-current="@(pageIndex == Model.PageIndex ? "page" : null)">@pageIndex</a>
                        }
                        else if (pageIndex == Model.PageIndex - 3 || pageIndex == Model.PageIndex + 3)
                        {
                            <span class="is-disabled" aria-hidden="true">…</span>
                        }
                    }

                    @if (Model.NextPageNumber.HasValue)
                    {
                        <a asp-action="Index" asp-route-pageNumber="@Model.NextPageNumber" asp-route-searchString="@currentFilter" asp-route-roleId="@currentRoleId" asp-route-startDate="@startDate" asp-route-endDate="@endDate" aria-label="Trang sau"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                    }
                </nav>
            </div>
        }
    </section>
</div>

<div class="modal fade" id="logDetailsModal" tabindex="-1" aria-labelledby="logDetailsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content evaluation-modal auditlog-modal">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title" id="logDetailsModalTitle">Chi tiết Nhật ký Hệ thống</h2>
                    <p class="evaluation-form-hint">Đối chiếu dữ liệu trước và sau thao tác được ghi nhận.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng cửa sổ chi tiết"></button>
            </div>
            <div class="modal-body">
                <div class="auditlog-modal-facts">
                    <div class="auditlog-modal-fact">
                        <span>Hành động</span>
                        <span id="modalAction" class="audit-action audit-action--neutral"></span>
                    </div>
                    <div class="auditlog-modal-fact">
                        <span>Bảng dữ liệu</span>
                        <strong id="modalTable">Không xác định</strong>
                    </div>
                </div>
                <div>
                    <div class="auditlog-data-heading">
                        <span>Dữ liệu thay đổi</span>
                        <button type="button" class="evaluation-secondary-action auditlog-detail-button" id="copyLogDataButton">
                            <i class="bi bi-clipboard" aria-hidden="true"></i>Sao chép
                        </button>
                    </div>
                    <div class="auditlog-data-grid" id="auditlogDataGrid">
                        <div class="auditlog-data-panel" id="oldDataContainer">
                            <span>Dữ liệu cũ</span>
                            <pre id="modalOldData"></pre>
                        </div>
                        <div class="auditlog-data-panel" id="newDataContainer">
                            <span>Dữ liệu mới</span>
                            <pre id="modalNewData"></pre>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="evaluation-secondary-action" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modalElement = document.getElementById('logDetailsModal');
            const actionElement = document.getElementById('modalAction');
            const tableElement = document.getElementById('modalTable');
            const oldDataElement = document.getElementById('modalOldData');
            const newDataElement = document.getElementById('modalNewData');
            const oldDataContainer = document.getElementById('oldDataContainer');
            const newDataContainer = document.getElementById('newDataContainer');
            const dataGrid = document.getElementById('auditlogDataGrid');

            if (!modalElement || !actionElement || !tableElement || !oldDataElement || !newDataElement || !oldDataContainer || !newDataContainer || !dataGrid) {
                return;
            }

            document.querySelectorAll('.auditlog-detail-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    showLogDetails(button.dataset.action || '', button.dataset.table || '', button.dataset.old || '', button.dataset.new || '');
                });
            });

            document.getElementById('copyLogDataButton')?.addEventListener('click', copyLogData);

            function showLogDetails(action, table, oldData, newData) {
                actionElement.textContent = translateAction(action);
                actionElement.className = 'audit-action ' + getActionBadgeClass(action);
                tableElement.textContent = table || 'Không xác định';

                oldDataElement.textContent = formatLogData(oldData);
                newDataElement.textContent = formatLogData(newData);

                // Reset the modal every time before applying the action-specific layout.
                oldDataContainer.hidden = false;
                newDataContainer.hidden = false;
                dataGrid.classList.remove('is-single');

                if (action === 'CREATE' || action === 'CREATE_APPROVED') {
                    oldDataContainer.hidden = true;
                    dataGrid.classList.add('is-single');
                } else if (action === 'DELETE') {
                    newDataContainer.hidden = true;
                    dataGrid.classList.add('is-single');
                }

                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            }

            function formatLogData(value) {
                if (!value) return 'Không có dữ liệu';
                try {
                    return JSON.stringify(JSON.parse(value), null, 2);
                } catch (_) {
                    return value;
                }
            }

            function translateAction(action) {
                switch (action) {
                    case 'CREATE': return 'Tạo mới';
                    case 'CREATE_APPROVED': return 'Tạo & duyệt';
                    case 'UPDATE': return 'Cập nhật';
                    case 'DELETE': return 'Xóa';
                    case 'APPROVE': return 'Duyệt';
                    case 'REJECT': return 'Từ chối';
                    case 'COMMENT': return 'Bình luận';
                    case 'SUBMIT_REVIEW': return 'Gửi duyệt';
                    case 'DIRECTOR_APPROVE': return 'GĐ duyệt';
                    case 'DIRECTOR_REJECT': return 'GĐ từ chối';
                    default: return action || 'Không xác định';
                }
            }

            function getActionBadgeClass(action) {
                switch (action) {
                    case 'CREATE':
                    case 'CREATE_APPROVED':
                    case 'APPROVE':
                    case 'DIRECTOR_APPROVE': return 'audit-action--success';
                    case 'UPDATE': return 'audit-action--warning';
                    case 'DELETE':
                    case 'REJECT':
                    case 'DIRECTOR_REJECT': return 'audit-action--danger';
                    case 'COMMENT': return 'audit-action--info';
                    case 'SUBMIT_REVIEW': return 'audit-action--primary';
                    default: return 'audit-action--neutral';
                }
            }

            function copyLogData() {
                const text = `Dữ liệu cũ:\n${oldDataElement.textContent}\n\nDữ liệu mới:\n${newDataElement.textContent}`;
                navigator.clipboard.writeText(text)
                    .then(function () {
                        window.AppFeedback?.toast({ tone: 'success', title: 'Đã sao chép', message: 'Nội dung đã được lưu vào bộ nhớ tạm.' });
                    })
                    .catch(function () {
                        window.AppFeedback?.toast({ tone: 'error', title: 'Không thể sao chép', message: 'Trình duyệt chưa cấp quyền truy cập bộ nhớ tạm.' });
                    });
            }
        })();
    </script>
}
