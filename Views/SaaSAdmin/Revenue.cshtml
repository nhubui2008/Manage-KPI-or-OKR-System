@model List<Manage_KPI_or_OKR_System.Models.PaymentTransaction>
@{
    ViewData["Title"] = "Báo cáo Doanh thu (SaaS)";
    Layout = "_SaaSAdminLayout";

    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    decimal mrr = ViewBag.MRR ?? 0;
    decimal arpu = ViewBag.ARPU ?? 0;

    var topCustomers = Model.Where(t => t.Status == "Thành công" && t.Registration != null)
                            .GroupBy(t => t.Registration.Email)
                            .Select(g => new { 
                                Email = g.Key, 
                                CompanyName = g.Key,
                                TotalAmount = g.Sum(x => x.Amount),
                                PackageName = g.OrderByDescending(x => x.TransactionDate).First().Package?.PackageName ?? "Unknown"
                            })
                            .OrderByDescending(g => g.TotalAmount)
                            .Take(5)
                            .ToList();
}

<div class="dashboard-page">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 font-weight-bold mb-1 text-primary">Báo cáo Doanh thu</h1>
            <div class="page-breadcrumb text-muted" style="font-size: 0.85rem;">
                <a href="/SaaSAdmin" class="text-decoration-none text-primary fw-medium">Admin</a>
                <i class="bi bi-chevron-right separator mx-1"></i>
                <span>Doanh thu</span>
            </div>
        </div>
        <div>
            <button type="button" class="btn btn-outline-secondary shadow-sm bg-white" onclick="window.AppFeedback.comingSoon('Chọn tháng')">
                <i class="bi bi-calendar-range me-1"></i> Tất cả thời gian
            </button>
            <button type="button" class="btn btn-primary shadow-sm ms-2" onclick="window.AppFeedback.comingSoon('Xuất Excel')">
                <i class="bi bi-download me-1"></i> Xuất Excel
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-3">
        <div class="col-xl-4 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Tổng doanh thu</p>
                            <h4 class="fs-18 fw-bold mb-0 text-success">@totalRevenue.ToString("N0") ₫</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-success-subtle text-success rounded-2">
                                <i class="bi bi-cash-stack"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-success-subtle text-success"><i class="bi bi-database-check me-1"></i> Thực tế</span> Dữ liệu từ Database</p>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Doanh thu MRR (Tháng này)</p>
                            <h4 class="fs-18 fw-bold mb-0 text-primary">@mrr.ToString("N0") ₫</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-primary-subtle text-primary rounded-2">
                                <i class="bi bi-graph-up-arrow"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-primary-subtle text-primary"><i class="bi bi-arrow-repeat me-1"></i> Định kỳ</span> Doanh thu định kỳ hàng tháng</p>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">ARPU (Doanh thu / Khách)</p>
                            <h4 class="fs-18 fw-bold mb-0 text-warning">@arpu.ToString("N0") ₫</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-warning-subtle text-warning rounded-2">
                                <i class="bi bi-person-check"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-warning-subtle text-warning"><i class="bi bi-calculator me-1"></i> Trung bình</span> Trên 1 khách hàng active</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Biểu đồ -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-bar-chart-line-fill text-primary"></i> Biểu đồ doanh thu thực tế</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.Any())
                    {
                        <canvas id="revenueChart" style="height: 300px; width: 100%;"></canvas>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                            <p>Chưa có dữ liệu giao dịch để vẽ biểu đồ.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Top khách hàng -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-trophy-fill text-warning"></i> Top Khách hàng đem lại Doanh thu</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var c in topCustomers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 40px; height: 40px;">
                                        @(c.CompanyName.Length > 1 ? c.CompanyName.Substring(0, 2).ToUpper() : "KH")
                                    </div>
                                    <div>
                                        <div class="fw-bold">@c.CompanyName</div>
                                        <div class="text-muted small">Gói @c.PackageName</div>
                                    </div>
                                </div>
                                <div class="fw-bold text-success">@c.TotalAmount.ToString("N0") ₫</div>
                            </li>
                        }
                        @if (!topCustomers.Any())
                        {
                            <li class="list-group-item p-4 text-center text-muted">
                                Chưa có dữ liệu giao dịch thành công.
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const hasData = @(Model.Any() ? "true" : "false");
        if (hasData) {
            const ctxRev = document.getElementById('revenueChart').getContext('2d');
            
            // For now just put a simple chart since grouping dynamic C# data for chart.js requires passing serialized JSON.
            // We'll show a flat chart for demonstration of the real backend connection.
            new Chart(ctxRev, {
                type: 'bar',
                data: {
                    labels: ['Tháng hiện tại'],
                    datasets: [{
                        label: 'Doanh thu (Triệu VNĐ)',
                        data: [@(mrr / 1000000)],
                        backgroundColor: 'rgba(123, 104, 238, 0.86)',
                        borderRadius: 4
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }
    </script>
}
