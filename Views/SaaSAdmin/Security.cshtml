@{
    ViewData["Title"] = "Bảo mật & Phân quyền";
    Layout = "_SaaSAdminLayout";
    
    var admins = ViewBag.Admins as List<Manage_KPI_or_OKR_System.Models.SystemUser> ?? new List<Manage_KPI_or_OKR_System.Models.SystemUser>();
    var logs = ViewBag.AuditLogs as List<Manage_KPI_or_OKR_System.Models.AuditLog> ?? new List<Manage_KPI_or_OKR_System.Models.AuditLog>();
}

<div class="dashboard-page">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 font-weight-bold mb-1 text-primary">Bảo mật & Phân quyền Admin</h1>
            <div class="page-breadcrumb text-muted" style="font-size: 0.85rem;">
                <a href="/SaaSAdmin" class="text-decoration-none text-primary fw-medium">Admin</a>
                <i class="bi bi-chevron-right separator mx-1"></i>
                <span>Bảo mật</span>
            </div>
        </div>
        <div>
            <button type="button" class="btn btn-outline-primary shadow-sm bg-white rounded-pill px-4" onclick="window.AppFeedback.comingSoon('Mời Quản trị viên')">
                <i class="bi bi-person-plus-fill me-1"></i> Mời Quản trị viên
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-shield-check text-success"></i> Danh sách Quản trị viên hệ thống</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted" style="font-size: 0.85rem;">
                            <tr>
                                <th class="ps-4 py-3">TÀI KHOẢN</th>
                                <th>TRẠNG THÁI</th>
                                <th class="text-end pe-4">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var admin in admins)
                            {
                                var username = admin.Username ?? string.Empty;
                                var initials = username.Length >= 2
                                    ? username[..2].ToUpperInvariant()
                                    : username.ToUpperInvariant();
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 36px; height: 36px;">
                                                @initials
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@username</div>
                                                <div class="text-muted small">@admin.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (admin.IsActive == true)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Locked</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa quyền truy cập"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                            @if (!admins.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">Chưa có dữ liệu Quản trị viên</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-list-check text-primary"></i> Nhật ký Truy cập (Audit Log)</h5>
                </div>
                <div class="card-body p-3 custom-scrollbar" style="max-height: 400px; overflow-y: auto; overflow-x: hidden;">
                    <div class="timeline-widget pe-2">
                        @foreach (var log in logs)
                        {
                            <div class="d-flex mb-3">
                                <div class="flex-shrink-0 text-center me-3">
                                    <div class="bg-success rounded-circle d-inline-block" style="width: 12px; height: 12px; margin-top: 4px;"></div>
                                    <div class="border-start border-2 ms-1 mt-1" style="height: 35px; border-color: #e9ecef !important;"></div>
                                </div>
                                <div>
                                    <p class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">@(log.SystemUser?.Username ?? "System") - @log.ActionType</p>
                                    <p class="text-muted small mb-0">@(log.LogTime?.ToString("dd/MM/yyyy HH:mm")) - Chi tiết: @log.NewData</p>
                                </div>
                            </div>
                        }
                        @if (!logs.Any())
                        {
                            <div class="text-center py-4 text-muted">Chưa có lịch sử thao tác nào.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom Scrollbar for Audit Log */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f8f9fa;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #ced4da;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #adb5bd;
    }
</style>
