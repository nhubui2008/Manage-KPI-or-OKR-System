@using Manage_KPI_or_OKR_System.Models
@{
    ViewData["Title"] = "Tổng quan Admin";
    Layout = "_SaaSAdminLayout";

    var recentRegistrations = ViewBag.RecentRegistrations as List<PurchaseRegistration> ?? new List<PurchaseRegistration>();
}

<div class="dashboard-page">
    <div class="page-header dashboard-header mb-4 align-items-end">
        <div>
            <h1 class="h3 font-weight-bold mb-1 text-primary">Dashboard Admin</h1>
            <div class="page-breadcrumb text-muted" style="font-size: 0.85rem;">
                <a href="/SaaSAdmin" class="text-decoration-none text-primary fw-medium">Admin</a>
                <i class="bi bi-chevron-right separator mx-1"></i>
                <span>Tổng quan</span>
            </div>
        </div>
        <div class="ms-auto d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary shadow-sm" onclick="location.reload();">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới dữ liệu
            </button>
            <a href="/SaaSAdmin/Registrations" class="btn btn-sm btn-primary shadow-sm">
                <i class="bi bi-people-fill me-1"></i> Quản lý Khách hàng
            </a>
        </div>
    </div>

    @* ============ STAT CARDS ============ *@
    <div class="row g-3 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Tổng đăng ký</p>
                            <h4 class="fs-18 fw-bold mb-0 text-primary">@ViewBag.TotalRegistrations</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-primary-subtle text-primary rounded-2">
                                <i class="bi bi-file-earmark-text"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-primary-subtle text-primary"><i class="bi bi-arrow-up-right me-1"></i> Tăng trưởng</span> Toàn hệ thống</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Chờ xử lý</p>
                            <h4 class="fs-18 fw-bold mb-0 text-warning">@ViewBag.PendingRegistrations</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-warning-subtle text-warning rounded-2">
                                <i class="bi bi-hourglass-split"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1">
                        @if (ViewBag.PendingRegistrations > 0)
                        {
                            <span class="badge bg-danger-subtle text-danger"><i class="bi bi-exclamation-circle-fill me-1"></i> Cần duyệt</span> <span class="text-muted">Cần phê duyệt</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted border"><i class="bi bi-check-circle me-1"></i> OK</span> <span class="text-muted">Không có yêu cầu mới</span>
                        }
                    </p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Đang dùng thử</p>
                            <h4 class="fs-18 fw-bold mb-0 text-success">@ViewBag.TrialUsers</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-success-subtle text-success rounded-2">
                                <i class="bi bi-clock-history"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-success-subtle text-success"><i class="bi bi-play-circle me-1"></i> Trial</span> Gói 30 phút / 24H</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-animate summary-stat-card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 min-w-0">
                            <p class="text-uppercase fw-semibold text-muted text-truncate fs-11 mb-0">Khách hàng Active</p>
                            <h4 class="fs-18 fw-bold mb-0 text-info">@ViewBag.ActiveUsers</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0 ms-2">
                            <span class="avatar-title bg-info-subtle text-info rounded-2">
                                <i class="bi bi-people-fill"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-11 mb-0 mt-1"><span class="badge bg-info-subtle text-info"><i class="bi bi-check2-circle me-1"></i> Hoạt động</span> Đang trả phí & hoạt động</p>
                </div>
            </div>
        </div>
    </div>

    @* ============ CHARTS & RECENT ============ *@
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-bar-chart-line-fill text-primary"></i> Xu hướng tăng trưởng khách hàng (Demo)</h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center p-4">
                    <div class="w-100" style="position: relative; height: 350px;">
                        <canvas id="growthChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-activity text-danger"></i> Đăng ký gần đây</h5>
                </div>
                <div class="card-body pt-3" style="max-height: 400px; overflow-y: auto;">
                    @if (recentRegistrations.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var reg in recentRegistrations)
                            {
                                var firstLetter = string.IsNullOrEmpty(reg.Email) ? "U" : reg.Email[0].ToString().ToUpper();
                                var statusColor = reg.Status == "Chờ xử lý" ? "warning" : reg.Status == "Đã kích hoạt" ? "success" : "secondary";
                                
                                <li class="list-group-item px-0 border-bottom">
                                    <div class="d-flex w-100 justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 36px; height: 36px;">
                                                @firstLetter
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.9rem;">@reg.Email</div>
                                                <small class="text-muted">Gói: <span class="badge bg-@statusColor bg-opacity-10 text-@statusColor border border-@statusColor rounded-pill">@reg.SelectedPlan</span></small>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted d-block">@reg.CreatedAt.ToString("dd/MM HH:mm")</small>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox opacity-50" style="font-size: 3rem;"></i>
                            <p class="mt-2 mb-0">Chưa có đăng ký nào mới</p>
                        </div>
                    }
                    <div class="text-center mt-3">
                        <a href="/SaaSAdmin/Registrations" class="btn btn-sm btn-light border w-100 fw-medium">Xem tất cả</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    @* ============ AI & INSIGHTS ============ *@
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-pie-chart-fill text-success"></i> Phân bổ gói dịch vụ (Demo)</h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center p-4">
                    <div class="w-100" style="position: relative; height: 320px;">
                        <canvas id="planDistributionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100" style="background: linear-gradient(135deg, #1e293b, #0f172a); color: white;">
                <div class="card-body p-5 d-flex flex-column justify-content-center align-items-center text-center">
                    <img src="https://cdn-icons-png.flaticon.com/512/4762/4762311.png" alt="Biểu đồ tự động hóa doanh thu SaaS" style="width: 100px; opacity: 0.9; margin-bottom: 20px; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));" />
                    <h4 class="fw-bold mb-3">Tự động hóa doanh thu SaaS</h4>
                    <p class="text-light opacity-75 mb-4 mx-auto" style="max-width: 400px; font-size: 0.95rem; line-height: 1.6;">
                        Hệ thống đã sẵn sàng hỗ trợ bạn theo dõi tỉ lệ chuyển đổi từ dùng thử (Trial) sang trả phí (Active), tối ưu doanh thu và quản lý khách hàng chỉ với vài click.
                    </p>
                    <a href="/SaaSAdmin/Registrations" class="btn btn-primary px-4 py-2" style="border-radius: 8px; font-weight: 600;">
                        Bắt đầu Quản lý <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // MOCK DATA FOR DEMO CHARTS
        const growthLabels = ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6'];
        const growthData = [12, 19, 25, 32, 45, 60];
        
        const planLabels = ['Free Trial', 'Starter', 'Professional', 'Enterprise'];
        const planData = [45, 25, 20, 10];

        // 1. BIỂU ĐỒ XU HƯỚNG TĂNG TRƯỞNG
        const ctxGrowth = document.getElementById('growthChart').getContext('2d');
        new Chart(ctxGrowth, {
            type: 'bar',
            data: {
                labels: growthLabels,
                datasets: [{
                    label: 'Khách hàng mới',
                    data: growthData,
                    backgroundColor: '#7b68ee',
                    borderRadius: 6,
                    barThickness: 30
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true }
                }
            }
        });

        // 2. BIỂU ĐỒ PHÂN BỔ GÓI DỊCH VỤ
        const ctxPlan = document.getElementById('planDistributionChart').getContext('2d');
        new Chart(ctxPlan, {
            type: 'doughnut',
            data: {
                labels: planLabels,
                datasets: [{
                    data: planData,
                    backgroundColor: ['#94a3b8', '#0f9d58', '#7b68ee', '#514b81'],
                    borderWidth: 0,
                    hoverOffset: 15
                }]
            },
            options: {
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20, font: { size: 12 } } }
                }
            }
        });
    </script>
}
