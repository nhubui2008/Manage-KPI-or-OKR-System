@model Manage_KPI_or_OKR_System.Models.ViewModels.DirectorDashboardViewModel

@{
    string GetKpiStatusBadge(double rate)
    {
        if (rate >= 80) return "badge-soft-success";
        if (rate >= 50) return "badge-soft-warning";
        return "badge-soft-danger";
    }

    string GetKpiStatusText(double rate)
    {
        if (rate >= 80) return "Hiệu suất Tốt";
        if (rate >= 50) return "Trung bình";
        if (rate > 0) return "Cần cải thiện";
        return "Chưa có dữ liệu";
    }

    string GetOkrStatusBadge(double rate)
    {
        if (rate >= 70) return "badge-soft-success";
        if (rate >= 40) return "badge-soft-warning";
        return "badge-soft-danger";
    }

    string GetOkrStatusText(double rate)
    {
        if (rate >= 70) return "Đúng tiến độ";
        if (rate >= 40) return "Đang bám sát";
        if (rate > 0) return "Chậm tiến độ";
        return "Chưa có dữ liệu";
    }

    // Xác định trạng thái sức khỏe vận hành toàn diện cho Ban Giám Đốc
    string healthStatusText;
    string healthBadgeClass;
    string healthPulseClass;
    string healthIcon;
    string healthDescription;

    var riskGoalCount = Model.AtRiskGoals.Count;
    var kpiRate = Model.CompanyKpiAchievementRate;
    var okrRate = Model.CompanyOkrProgressRate;

    if (riskGoalCount == 0 && (kpiRate >= 70 || okrRate >= 70))
    {
        healthStatusText = "Vận Hành Xuất Sắc";
        healthBadgeClass = "badge-soft-success text-success";
        healthPulseClass = "pulse-success";
        healthIcon = "bi-shield-check text-success";
        healthDescription = "Hầu hết các mục tiêu chiến lược và chỉ số KPI toàn công ty đang hoàn thành vượt kế hoạch, không ghi nhận mục tiêu chậm tiến độ nghiêm trọng.";
    }
    else if (riskGoalCount <= 2 && (kpiRate >= 45 || okrRate >= 40))
    {
        healthStatusText = "Vận Hành Ổn Định";
        healthBadgeClass = "badge-soft-primary text-primary";
        healthPulseClass = "pulse-success";
        healthIcon = "bi-activity text-primary";
        healthDescription = "Tiến độ toàn diện bám sát chu kỳ, hệ thống đang duy trì hiệu suất ổn định. Tiếp tục đôn đốc các bộ phận duy trì nhịp độ check-in.";
    }
    else
    {
        healthStatusText = "Cần Chú Ý Tiến Độ";
        healthBadgeClass = "badge-soft-warning text-warning";
        healthPulseClass = "pulse-warning";
        healthIcon = "bi-exclamation-triangle text-warning";
        healthDescription = "Ghi nhận chỉ số hoặc mục tiêu có tiến độ dưới 50%. Ban Giám đốc nên xem xét tổ chức phiên rà soát chiến lược và phân bổ nguồn lực hỗ trợ.";
    }
}

<!-- BAN GIÁM ĐỐC / EXECUTIVE DASHBOARD -->
<div class="dashboard-role-view dashboard-director-view">

    <!-- 1. Executive Briefing & Strategic Quick Actions -->
    <section class="card dashboard-card director-briefing-card mb-3" aria-label="Tóm tắt sức khỏe chiến lược doanh nghiệp">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="director-health-pulse @healthPulseClass" aria-hidden="true">
                        <i class="bi @healthIcon fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h2 class="h5 mb-0 fw-bold text-dark">Báo Cáo Chiến Lược Ban Giám Đốc</h2>
                            <span class="badge @healthBadgeClass fs-7">
                                <i class="bi bi-circle-fill fs-8 me-1"></i>@healthStatusText
                            </span>
                        </div>
                        <p class="text-muted small mb-0 mt-1">
                            @healthDescription
                        </p>
                    </div>
                </div>

                <!-- Strategic Quick Action Buttons -->
                <nav class="d-flex flex-wrap align-items-center gap-2" aria-label="Thao tác nhanh cho Giám đốc">
                    <a href="/OKRs" class="btn btn-sm btn-outline-primary shadow-xs">
                        <i class="bi bi-bullseye me-1"></i>Chiến Lược OKR
                    </a>
                    <a href="/KPIs" class="btn btn-sm btn-outline-primary shadow-xs">
                        <i class="bi bi-speedometer2 me-1"></i>Chỉ Số KPI
                    </a>
                    <a href="/Departments" class="btn btn-sm btn-outline-secondary shadow-xs">
                        <i class="bi bi-diagram-3 me-1"></i>Cơ Cấu Phòng Ban
                    </a>
                    <a href="/EvaluationResults" class="btn btn-sm btn-outline-secondary shadow-xs">
                        <i class="bi bi-award me-1"></i>Kết Quả Đánh Giá
                    </a>
                    <button type="button" class="btn btn-sm btn-primary shadow-xs" onclick="window.print()" title="In hoặc xuất báo cáo PDF">
                        <i class="bi bi-printer me-1"></i>Xuất Báo Cáo
                    </button>
                </nav>
            </div>

            <!-- Mini Summary Metrics Bar -->
            <div class="director-briefing-metrics mt-3 pt-3 border-top">
                <div class="briefing-metric-item">
                    <span class="text-muted small">Phòng ban đạt chuẩn (≥50%):</span>
                    <strong class="text-success ms-1">@(Model.ExcellentDeptCount + Model.OnTrackDeptCount)/@Model.TotalDepartments đơn vị</strong>
                </div>
                <div class="briefing-metric-item">
                    <span class="text-muted small">Đơn vị dẫn đầu:</span>
                    <strong class="text-primary ms-1">@Model.TopPerformingDeptName (@Model.TopPerformingDeptRate%)</strong>
                </div>
                <div class="briefing-metric-item">
                    <span class="text-muted small">Mục tiêu trễ hạn / rủi ro:</span>
                    <strong class="@(Model.AtRiskGoals.Count > 0 ? "text-danger" : "text-success") ms-1">@Model.AtRiskGoals.Count mục tiêu</strong>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Stat Cards Section -->
    <section class="row g-3 dashboard-section" aria-label="Chỉ số chiến lược toàn công ty">
        <div class="col-12 col-sm-6 col-xl-3">
            <article class="card dashboard-card dashboard-stat-card stat-card--primary h-100">
                <div class="card-body">
                    <div class="dashboard-stat-content">
                        <div class="min-w-0">
                            <p class="dashboard-stat-label">KPI Toàn Công Ty</p>
                            <p class="dashboard-stat-value">@Model.CompanyKpiAchievementRate%</p>
                            <div class="dashboard-stat-meta">
                                <span class="badge @GetKpiStatusBadge(Model.CompanyKpiAchievementRate)">
                                    @GetKpiStatusText(Model.CompanyKpiAchievementRate)
                                </span>
                                <span>@Model.TotalCompanyKPIs chỉ số</span>
                            </div>
                        </div>
                        <span class="dashboard-stat-icon bg-primary-subtle text-primary" aria-hidden="true">
                            <i class="bi bi-speedometer2"></i>
                        </span>
                    </div>
                    <div class="dashboard-stat-progress" aria-hidden="true">
                        <div class="dashboard-stat-progress-bar bg-primary" style="width: @Math.Min(100, Math.Max(0, Model.CompanyKpiAchievementRate))%;"></div>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <article class="card dashboard-card dashboard-stat-card stat-card--success h-100">
                <div class="card-body">
                    <div class="dashboard-stat-content">
                        <div class="min-w-0">
                            <p class="dashboard-stat-label">Tiến Độ OKR Chiến Lược</p>
                            <p class="dashboard-stat-value">@Model.CompanyOkrProgressRate%</p>
                            <div class="dashboard-stat-meta">
                                <span class="badge @GetOkrStatusBadge(Model.CompanyOkrProgressRate)">
                                    @GetOkrStatusText(Model.CompanyOkrProgressRate)
                                </span>
                                <span>@Model.TotalCompanyOKRs mục tiêu</span>
                            </div>
                        </div>
                        <span class="dashboard-stat-icon bg-success-subtle text-success" aria-hidden="true">
                            <i class="bi bi-bullseye"></i>
                        </span>
                    </div>
                    <div class="dashboard-stat-progress" aria-hidden="true">
                        <div class="dashboard-stat-progress-bar bg-success" style="width: @Math.Min(100, Math.Max(0, Model.CompanyOkrProgressRate))%;"></div>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <article class="card dashboard-card dashboard-stat-card stat-card--info h-100">
                <div class="card-body">
                    <div class="dashboard-stat-content">
                        <div class="min-w-0">
                            <p class="dashboard-stat-label">Phòng Ban & Nhân Sự</p>
                            <p class="dashboard-stat-value">
                                @Model.TotalDepartments <span class="fs-6 text-muted fw-normal">phòng</span>
                            </p>
                            <div class="dashboard-stat-meta">
                                <span class="badge badge-soft-info">
                                    <i class="bi bi-people me-1"></i>@Model.TotalActiveEmployees nhân sự
                                </span>
                                <span>Đang hoạt động</span>
                            </div>
                        </div>
                        <span class="dashboard-stat-icon bg-info-subtle text-info" aria-hidden="true">
                            <i class="bi bi-diagram-3"></i>
                        </span>
                    </div>
                    <div class="dashboard-stat-progress" aria-hidden="true">
                        <div class="dashboard-stat-progress-bar bg-info" style="width: 100%;"></div>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <article class="card dashboard-card dashboard-stat-card stat-card--warning h-100">
                <div class="card-body">
                    <div class="dashboard-stat-content">
                        <div class="min-w-0">
                            <p class="dashboard-stat-label">Mục Tiêu Cần Can Thiệp</p>
                            <p class="dashboard-stat-value @(Model.AtRiskGoals.Count > 0 ? "text-danger" : "text-success")">
                                @Model.AtRiskGoals.Count <span class="fs-6 text-muted fw-normal">mục tiêu</span>
                            </p>
                            <div class="dashboard-stat-meta">
                                <span class="badge @(Model.AtRiskGoals.Count > 0 ? "badge-soft-danger" : "badge-soft-success")">
                                    @(Model.AtRiskGoals.Count > 0 ? "Cần can thiệp ngay" : "Tiến độ an toàn")
                                </span>
                                <span>Tiến độ &lt; 50%</span>
                            </div>
                        </div>
                        <span class="dashboard-stat-icon @(Model.AtRiskGoals.Count > 0 ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")" aria-hidden="true">
                            <i class="bi @(Model.AtRiskGoals.Count > 0 ? "bi-exclamation-triangle" : "bi-shield-check")"></i>
                        </span>
                    </div>
                    <div class="dashboard-stat-progress" aria-hidden="true">
                        <div class="dashboard-stat-progress-bar @(Model.AtRiskGoals.Count > 0 ? "bg-danger" : "bg-success")" style="width: @(Model.AtRiskGoals.Count > 0 ? Math.Min(100, Model.AtRiskGoals.Count * 25) : 0)%;"></div>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <!-- 3. Main Strategic Charts Section -->
    <section class="row g-3 dashboard-section" aria-label="Biểu đồ hiệu suất phòng ban và phân bổ mục tiêu">
        <div class="col-12 col-lg-8">
            <article class="card dashboard-card h-100">
                <header class="card-header dashboard-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="card-title mb-0">So Sánh Hiệu Suất Giữa Các Phòng Ban</h2>
                        <small class="text-muted">Tiến độ hoàn thành KPI bình quân theo từng đơn vị trong kỳ</small>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.TopPerformingDeptName) && Model.TopPerformingDeptName != "Chưa có")
                    {
                        <span class="badge badge-soft-success d-none d-sm-inline-flex align-items-center">
                            <i class="bi bi-trophy me-1 text-warning"></i>Dẫn đầu: @Model.TopPerformingDeptName (@Model.TopPerformingDeptRate%)
                        </span>
                    }
                </header>
                <div class="card-body">
                    <div class="dashboard-chart-container" style="position: relative; height: 320px;">
                        <canvas id="directorDeptChart" aria-label="Biểu đồ so sánh hiệu suất phòng ban" role="img"></canvas>
                        <div id="directorDeptChartState" class="dashboard-chart-empty" hidden>
                            <i class="bi bi-bar-chart fs-1 text-muted" aria-hidden="true"></i>
                            <span class="mt-2 text-muted">Chưa có dữ liệu check-in trong kỳ này</span>
                        </div>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-lg-4">
            <article class="card dashboard-card h-100">
                <header class="card-header dashboard-card-header">
                    <div>
                        <h2 class="card-title mb-0">Phân Bổ Trạng Thái OKR</h2>
                        <small class="text-muted">Tỷ trọng các mục tiêu theo tình trạng thực thi</small>
                    </div>
                </header>
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="dashboard-chart-container" style="position: relative; height: 250px;">
                        <canvas id="directorOkrStatusChart" aria-label="Biểu đồ phân bổ trạng thái OKR" role="img"></canvas>
                        <div id="directorOkrStatusChartState" class="dashboard-chart-empty" hidden>
                            <i class="bi bi-pie-chart fs-1 text-muted" aria-hidden="true"></i>
                            <span class="mt-2 text-muted">Chưa có dữ liệu OKR trong kỳ</span>
                        </div>
                    </div>
                    <div class="director-donut-legend" id="directorOkrLegend" aria-hidden="true">
                        <!-- Dynamic status distribution legend is rendered by dashboard.js -->
                    </div>
                </div>
            </article>
        </div>
    </section>

    <!-- 4. Trend Chart & Risk Alerts Section -->
    <section class="row g-3 dashboard-section" aria-label="Xu hướng vận hành và cảnh báo rủi ro">
        <div class="col-12 col-lg-7">
            <article class="card dashboard-card h-100">
                <header class="card-header dashboard-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="card-title mb-0">Xu Hướng Hoàn Thành Mục Tiêu 6 Tháng</h2>
                        <small class="text-muted">Chỉ số tiến độ trung bình toàn doanh nghiệp qua từng tháng</small>
                    </div>
                    <span class="badge badge-soft-primary">
                        <i class="bi bi-graph-up me-1"></i>Lịch sử 6 tháng
                    </span>
                </header>
                <div class="card-body">
                    <div class="dashboard-chart-container" style="position: relative; height: 280px;">
                        <canvas id="directorTrendChart" aria-label="Biểu đồ xu hướng tiến độ 6 tháng qua" role="img"></canvas>
                        <div id="directorTrendChartState" class="dashboard-chart-empty" hidden>
                            <i class="bi bi-graph-up fs-1 text-muted" aria-hidden="true"></i>
                            <span class="mt-2 text-muted">Chưa có dữ liệu lịch sử</span>
                        </div>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-lg-5">
            <article class="card dashboard-card h-100">
                <header class="card-header dashboard-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="card-title mb-0">Mục Tiêu Trọng Điểm Cần Chú Ý</h2>
                        <small class="text-muted">Chỉ số trễ hạn hoặc tiến độ dưới 50%</small>
                    </div>
                    <span class="badge @(Model.AtRiskGoals.Count > 0 ? "badge-soft-danger" : "badge-soft-success")">
                        <i class="bi @(Model.AtRiskGoals.Count > 0 ? "bi-bell-fill" : "bi-check-circle-fill") me-1"></i>
                        @Model.AtRiskGoals.Count cảnh báo
                    </span>
                </header>
                <div class="card-body p-0">
                    @if (Model.AtRiskGoals.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-nowrap align-middle mb-0" aria-label="Danh sách mục tiêu cần can thiệp">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Loại</th>
                                        <th scope="col">Mục tiêu & Đơn vị</th>
                                        <th scope="col">Tiến độ</th>
                                        <th scope="col">Hạn chót</th>
                                        <th scope="col" class="text-end pe-3">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.AtRiskGoals)
                                    {
                                        var detailUrl = item.Type == "KPI" && item.Id.HasValue
                                            ? $"/KPIs/Details/{item.Id.Value}"
                                            : (item.Id.HasValue ? $"/OKRs" : "#");

                                        <tr>
                                            <td>
                                                <span class="badge @(item.Type == "KPI" ? "badge-soft-primary" : "badge-soft-success")">
                                                    @item.Type
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-truncate" style="max-width: 170px;" title="@item.Title">
                                                    @item.Title
                                                </div>
                                                <small class="text-muted">
                                                    <i class="bi bi-building me-1"></i>@item.OwnerOrDept
                                                </small>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 6px; width: 55px;">
                                                        <div class="progress-bar bg-danger" role="progressbar" style="width: @item.ProgressPercentage%" aria-valuenow="@item.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <span class="small fw-bold text-danger">@item.ProgressPercentage%</span>
                                                </div>
                                            </td>
                                            <td>
                                                @if (item.DueDate.HasValue)
                                                {
                                                    <small class="@(item.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                                                        @item.DueDate.Value.ToString("dd/MM/yyyy")
                                                        @if (item.IsOverdue)
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger ms-1">Quá hạn</span>
                                                        }
                                                    </small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Chưa đặt hạn</small>
                                                }
                                            </td>
                                            <td class="text-end pe-3">
                                                <a href="@detailUrl" class="btn btn-sm btn-ghost-primary" title="Xem chi tiết mục tiêu">
                                                    <i class="bi bi-arrow-right-short fs-5"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-shield-check fs-1 text-success d-block mb-2"></i>
                            <strong class="text-dark d-block">Tất cả mục tiêu đang bám sát tiến độ</strong>
                            <span class="small">Không có chỉ số chiến lược hoặc mục tiêu nào bị trễ hạn dưới ngưỡng 50%.</span>
                        </div>
                    }
                </div>
            </article>
        </div>
    </section>

    <!-- 5. Department Performance Matrix Table Section -->
    <section class="row g-3 dashboard-section" aria-label="Ma trận hiệu suất phòng ban">
        <div class="col-12">
            <article class="card dashboard-card">
                <header class="card-header dashboard-card-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                    <div>
                        <h2 class="card-title mb-0">Ma Trận Hiệu Suất Phòng Ban</h2>
                        <small class="text-muted">Chi tiết phân bổ KPI, nhân sự và tiến độ thực tế theo từng đơn vị</small>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- Client-side Interactive Filter Tabs -->
                        <div class="director-matrix-tabs" role="tablist" aria-label="Bộ lọc phân loại phòng ban">
                            <button type="button" class="director-matrix-tab-btn active" data-filter="all">
                                Tất cả (@Model.DeptSummaries.Count)
                            </button>
                            <button type="button" class="director-matrix-tab-btn" data-filter="excellent">
                                Xuất sắc (@Model.ExcellentDeptCount)
                            </button>
                            <button type="button" class="director-matrix-tab-btn" data-filter="ontrack">
                                Đạt chuẩn (@Model.OnTrackDeptCount)
                            </button>
                            <button type="button" class="director-matrix-tab-btn" data-filter="atrisk">
                                Cần hỗ trợ (@Model.AtRiskDeptCount)
                            </button>
                        </div>

                        <a href="/Departments" class="btn btn-sm btn-outline-primary ms-md-2">
                            <i class="bi bi-diagram-3 me-1"></i>Xem sơ đồ tổ chức
                        </a>
                    </div>
                </header>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-nowrap align-middle mb-0" id="directorDeptMatrixTable" aria-label="Bảng ma trận hiệu suất chi tiết các phòng ban">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 45px;" class="text-center">#</th>
                                    <th scope="col">Phòng ban</th>
                                    <th scope="col">Lãnh đạo phụ trách</th>
                                    <th scope="col" class="text-center">Nhân sự</th>
                                    <th scope="col" class="text-center">KPI đang chạy</th>
                                    <th scope="col" style="min-width: 190px;">Tiến độ trung bình</th>
                                    <th scope="col">Đánh giá xếp loại</th>
                                    <th scope="col" class="text-end pe-3">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DeptSummaries.Any())
                                {
                                    int rank = 1;
                                    @foreach (var dept in Model.DeptSummaries)
                                    {
                                        var category = dept.AvgProgress >= 80 ? "excellent" : dept.AvgProgress >= 50 ? "ontrack" : "atrisk";
                                        var badgeCls = dept.AvgProgress >= 80 ? "badge-soft-success" : dept.AvgProgress >= 50 ? "badge-soft-warning" : "badge-soft-danger";
                                        var rankText = dept.AvgProgress >= 80 ? "Xuất sắc" : dept.AvgProgress >= 50 ? "Đạt yêu cầu" : "Cần hỗ trợ";
                                        var barCls = dept.AvgProgress >= 80 ? "bg-success" : dept.AvgProgress >= 50 ? "bg-warning" : "bg-danger";
                                        var rankBadgeClass = rank == 1 ? "rank-1" : rank == 2 ? "rank-2" : rank == 3 ? "rank-3" : "";

                                        <tr class="director-dept-row" data-category="@category">
                                            <td class="text-center">
                                                <span class="director-rank-badge @rankBadgeClass">@rank</span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark">
                                                    <i class="bi bi-building text-primary me-2"></i>@dept.DepartmentName
                                                </div>
                                                <small class="text-muted">Mã ĐV: #@dept.DepartmentId</small>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="avatar-xs rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary fw-bold small">
                                                        @(string.IsNullOrEmpty(dept.ManagerName) || dept.ManagerName == "Chưa chỉ định" ? "?" : dept.ManagerName.Substring(0, 1))
                                                    </div>
                                                    <span>@dept.ManagerName</span>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">
                                                    <i class="bi bi-people me-1 text-muted"></i>@dept.EmployeeCount
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">
                                                    <i class="bi bi-speedometer2 me-1 text-muted"></i>@dept.ActiveKpiCount
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 8px;">
                                                        <div class="progress-bar @barCls" role="progressbar" style="width: @dept.AvgProgress%" aria-valuenow="@dept.AvgProgress" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <span class="small fw-bold">@dept.AvgProgress%</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @badgeCls">@rankText</span>
                                            </td>
                                            <td class="text-end pe-3">
                                                <a href="/Departments/Details/@dept.DepartmentId" class="btn btn-sm btn-outline-secondary" title="Xem chi tiết phòng ban">
                                                    Chi tiết <i class="bi bi-chevron-right ms-1"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        rank++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">Chưa có thông tin dữ liệu phòng ban</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>

