@using Manage_KPI_or_OKR_System.Models.ViewModels
@model DashboardContainerViewModel

@{
    var common = Model.Common;
    var activeMode = Model.ActiveViewMode;
    var allPeriods = common.AllPeriods;
    var selectedPeriod = common.SelectedPeriod;

    string pageTitle;
    string pageSubtitle;
    switch (activeMode)
    {
        case DashboardViewModes.Director:
            pageTitle = "Tổng Quan Ban Giám Đốc";
            pageSubtitle = "Báo cáo chiến lược, mục tiêu OKR và hiệu suất toàn công ty";
            break;
        case DashboardViewModes.Manager:
            pageTitle = "Quản Lý Đội Ngũ & Phòng Ban";
            pageSubtitle = $"Theo dõi tiến độ {common.CurrentDepartmentName ?? "phòng ban"}, phê duyệt check-in và năng suất thành viên";
            break;
        case DashboardViewModes.Employee:
            pageTitle = "Không Gian Hiệu Suất Cá Nhân";
            pageSubtitle = $"Theo dõi KPI cá nhân, hạn check-in và tiến độ nhiệm vụ được giao ({common.UserFullName})";
            break;
        case DashboardViewModes.Overview:
        default:
            pageTitle = "Tổng Quan Vận Hành Hệ Thống";
            pageSubtitle = "Giám sát tổng thể hoạt động OKR, KPI và nhân sự toàn doanh nghiệp";
            break;
    }

    ViewData["Title"] = pageTitle;
}

<div class="dashboard-page" data-active-mode="@activeMode">
    <header class="dashboard-page-header">
        <div class="dashboard-page-heading">
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 mb-0">@pageTitle</h1>
                @if (common.IsAdmin && common.AllowedViewModes.Count > 1)
                {
                    <span class="badge badge-soft-primary fs-7">
                        <i class="bi bi-shield-check me-1"></i>Đa góc nhìn
                    </span>
                }
            </div>
            <p class="text-muted small mb-0 mt-1">@pageSubtitle</p>
            <ol class="breadcrumb mb-0 mt-2" aria-label="Breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">@activeMode</li>
            </ol>
        </div>

        <div class="dashboard-header-toolbar d-flex flex-wrap align-items-center gap-2">
            <!-- Form Lọc Kỳ Báo Cáo & Chuyển Đổi Góc Nhìn -->
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2">
                <!-- Dropdown Chuyển Đổi Góc Nhìn (Chỉ hiển thị khi là Quản trị viên - Admin) -->
                @if (common.IsAdmin && common.AllowedViewModes.Count > 1)
                {
                    <div class="dashboard-filter-item">
                        <label for="dashboardViewMode" class="dashboard-filter-label text-muted small fw-medium mb-0 me-1">
                            <i class="bi bi-person-badge me-1"></i>Góc nhìn:
                        </label>
                        <select id="dashboardViewMode" name="viewMode" class="form-select form-select-sm dashboard-view-select no-select2" onchange="this.form.submit()" aria-label="Chọn góc nhìn dashboard">
                            @foreach (var mode in common.AllowedViewModes)
                            {
                                string label = mode switch
                                {
                                    DashboardViewModes.Director => "Ban Giám đốc (Executive)",
                                    DashboardViewModes.Manager => "Trưởng phòng (Manager)",
                                    DashboardViewModes.Employee => "Nhân viên (Cá nhân)",
                                    DashboardViewModes.Overview => "Toàn hệ thống (Admin/HR)",
                                    _ => mode
                                };
                                <option value="@mode" selected="@(mode.Equals(activeMode, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                    @label
                                </option>
                            }
                        </select>
                    </div>
                }

                <!-- Chọn Kỳ Báo Cáo -->
                <div class="dashboard-filter-item">
                    <label for="dashboardPeriod" class="dashboard-filter-label text-muted small fw-medium mb-0 me-1">
                        <i class="bi bi-calendar3 me-1"></i>Kỳ báo cáo:
                    </label>
                    <select id="dashboardPeriod" name="periodId" class="form-select form-select-sm dashboard-period-select no-select2" onchange="this.form.submit()" aria-label="Chọn kỳ báo cáo">
                        <option value="" selected="@(selectedPeriod == null ? "selected" : null)">Tất cả các kỳ</option>
                        @foreach (var period in allPeriods)
                        {
                            var isSelected = selectedPeriod?.Id == period.Id;
                            <option value="@period.Id" selected="@(isSelected ? "selected" : null)">
                                @period.PeriodName
                                @if (period.StartDate.HasValue && period.EndDate.HasValue)
                                {
                                    <text> (@period.StartDate.Value.ToString("dd/MM/yy") - @period.EndDate.Value.ToString("dd/MM/yy"))</text>
                                }
                            </option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </header>

    <!-- CONTENT THEO VAI TRÒ CHUYÊN BIỆT -->
    <main class="dashboard-main-content mt-3">
        @switch (activeMode)
        {
            case DashboardViewModes.Director:
                if (Model.Director != null)
                {
                    @await Html.PartialAsync("_DashboardDirector", Model.Director)
                }
                break;

            case DashboardViewModes.Manager:
                if (Model.Manager != null)
                {
                    @await Html.PartialAsync("_DashboardManager", Model.Manager)
                }
                break;

            case DashboardViewModes.Employee:
                if (Model.Employee != null)
                {
                    @await Html.PartialAsync("_DashboardEmployee", Model.Employee)
                }
                break;

            case DashboardViewModes.Overview:
            default:
                if (Model.Overview != null)
                {
                    @await Html.PartialAsync("_DashboardOverview", Model.Overview)
                }
                break;
        }
    </main>

    <!-- METADATA VÀ DỮ LIỆU JSON BIỂU ĐỒ CHO CLIENT JAVASCRIPT -->
    <script type="application/json" id="dashboardData">
        {
            "activeMode": "@activeMode",
            @if (activeMode == DashboardViewModes.Director && Model.Director != null)
            {
                <text>
                "directorDeptLabels": @Html.Raw(Model.Director.DeptPerformanceLabelsJson),
                "directorDeptData": @Html.Raw(Model.Director.DeptPerformanceDataJson),
                "directorTrendLabels": @Html.Raw(Model.Director.Trend6MonthsLabelsJson),
                "directorTrendData": @Html.Raw(Model.Director.Trend6MonthsDataJson),
                "directorOkrLabels": @Html.Raw(Model.Director.OkrStatusLabelsJson),
                "directorOkrData": @Html.Raw(Model.Director.OkrStatusDataJson),
                "directorTotalOkrs": @Model.Director.TotalCompanyOKRs
                </text>
            }
            else if (activeMode == DashboardViewModes.Manager && Model.Manager != null)
            {
                <text>
                "managerTeamLabels": @Html.Raw(Model.Manager.TeamDistributionLabelsJson),
                "managerTeamData": @Html.Raw(Model.Manager.TeamDistributionDataJson),
                "managerKpiLabels": @Html.Raw(Model.Manager.DeptKpiProgressLabelsJson),
                "managerKpiData": @Html.Raw(Model.Manager.DeptKpiProgressDataJson)
                </text>
            }
            else if (activeMode == DashboardViewModes.Employee && Model.Employee != null)
            {
                <text>
                "employeeTrendLabels": @Html.Raw(Model.Employee.PersonalTrendLabelsJson),
                "employeeTrendData": @Html.Raw(Model.Employee.PersonalTrendDataJson)
                </text>
            }
            else if (Model.Overview != null)
            {
                <text>
                "okrLabels": @Html.Raw(Model.Overview.OKRStatusLabelsJson),
                "okrData": @Html.Raw(Model.Overview.OKRStatusDataJson),
                "departmentLabels": @Html.Raw(Model.Overview.DeptLabelsJson),
                "departmentProgress": @Html.Raw(Model.Overview.DeptProgressJson),
                "trendLabels": @Html.Raw(Model.Overview.MainChartLabelsJson),
                "trendData": @Html.Raw(Model.Overview.MainChartDataJson),
                "kpiLabels": @Html.Raw(Model.Overview.KPIStatusLabelsJson),
                "kpiData": @Html.Raw(Model.Overview.KPIStatusDataJson),
                "totalOkrs": @Model.Overview.TotalOKRs,
                "totalCheckIns": @Model.Overview.TotalCheckIns
                </text>
            }
        }
    </script>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
