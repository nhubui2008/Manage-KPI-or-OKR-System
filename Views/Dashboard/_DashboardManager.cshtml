@model Manage_KPI_or_OKR_System.Models.ViewModels.ManagerDashboardViewModel

@{
    string GetProgressBadge(double rate)
    {
        if (rate >= 80) return "badge-soft-success";
        if (rate >= 50) return "badge-soft-warning";
        return "badge-soft-danger";
    }

    string GetProgressText(double rate)
    {
        if (rate >= 80) return "Tốt";
        if (rate >= 50) return "Trung bình";
        if (rate > 0) return "Cần đôn đốc";
        return "Chưa có dữ liệu";
    }
}

<!-- TRƯỞNG PHÒNG / MANAGER DASHBOARD -->
<div class="dashboard-role-view dashboard-manager-view">
    <!-- Stat Cards -->
    <section class="row g-3 dashboard-section" aria-label="Chỉ số phòng ban">
        <div class="col-12 col-sm-6 col-xl-3">
            <article class="card dashboard-card dashboard-stat-card stat-card--primary h-100">
                <div class="card-body">
                    <div class="dashboard-stat-header">
                        <span class="dashboard-stat-label">Nhân Sự Quản Lý</span>
                        <span class="dashboard-stat-icon" aria-hidden="true">
                            <i class="bi bi-people-fill"></i>
                        </span>
                    </div>
                    <div class="dashboard-stat-value">@Model.TotalMembers <span class="fs-6 text-muted font-normal">thành viên</span></div>
                    <div class="dashboard-stat-footer">
                        <span class="badge badge-soft-primary">
                            <i class="bi bi-building me-1"></i>@Model.DepartmentName
                        </span>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <article class="card dashboard-card dashboard-stat-card stat-card--warning h-100">
                <div class="card-body">
                    <div class="dashboard-stat-header">
                        <span class="dashboard-stat-label">Check-in Chờ Duyệt</span>
                        <span class="dashboard-stat-icon" aria-hidden="true">
                            <i class="bi bi-hourglass-split"></i>
                        </span>
                    </div>
                    <div class="dashboard-stat-value @(Model.PendingCheckInsCount > 0 ? "text-danger" : "text-success")">
                        @Model.PendingCheckInsCount
                    </div>
                    <div class="dashboard-stat-footer">
                        <span class="badge @(Model.PendingCheckInsCount > 0 ? "badge-soft-danger" : "badge-soft-success")">
                            @(Model.PendingCheckInsCount > 0 ? "Cần xử lý ngay" : "Đã duyệt hết")
                        </span>
                        <span class="text-muted ms-2">Báo cáo mới</span>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <article class="card dashboard-card dashboard-stat-card stat-card--success h-100">
                <div class="card-body">
                    <div class="dashboard-stat-header">
                        <span class="dashboard-stat-label">KPI Đạt Phòng Ban</span>
                        <span class="dashboard-stat-icon" aria-hidden="true">
                            <i class="bi bi-speedometer2"></i>
                        </span>
                    </div>
                    <div class="dashboard-stat-value">@Model.DeptKpiAchievementRate%</div>
                    <div class="dashboard-stat-footer">
                        <span class="badge @GetProgressBadge(Model.DeptKpiAchievementRate)">
                            @GetProgressText(Model.DeptKpiAchievementRate)
                        </span>
                        <span class="text-muted ms-2">@Model.TotalDeptKpis chỉ số</span>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <article class="card dashboard-card dashboard-stat-card stat-card--info h-100">
                <div class="card-body">
                    <div class="dashboard-stat-header">
                        <span class="dashboard-stat-label">Mục Tiêu OKR Nhóm</span>
                        <span class="dashboard-stat-icon" aria-hidden="true">
                            <i class="bi bi-bullseye"></i>
                        </span>
                    </div>
                    <div class="dashboard-stat-value">@Model.TotalDeptOkrs <span class="fs-6 text-muted font-normal">mục tiêu</span></div>
                    <div class="dashboard-stat-footer">
                        <span class="badge badge-soft-info">
                            <i class="bi bi-calendar3 me-1"></i>Kỳ hiện tại
                        </span>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <!-- Pending Check-ins Queue (Hàng đợi phê duyệt) -->
    <section class="row g-3 dashboard-section" aria-label="Hàng đợi duyệt báo cáo check-in">
        <div class="col-12">
            <article class="card dashboard-card border-warning-subtle">
                <header class="card-header dashboard-card-header d-flex justify-content-between align-items-center bg-warning-subtle bg-opacity-10">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar-xs d-inline-flex align-items-center justify-content-center bg-warning text-white rounded">
                            <i class="bi bi-inbox-fill"></i>
                        </span>
                        <div>
                            <h2 class="card-title mb-0">Hàng Đợi Duyệt Check-in Cần Xử Lý</h2>
                            <small class="text-muted">Nhân viên đã gửi cập nhật tiến độ và đang chờ bạn xem xét</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge badge-soft-warning fs-6">@Model.PendingCheckInsCount đang chờ</span>
                        <a href="/KPICheckIns/EmployeeTracking" class="btn btn-sm btn-primary">
                            <i class="bi bi-check2-all me-1"></i>Trang theo dõi & duyệt
                        </a>
                    </div>
                </header>
                <div class="card-body p-0">
                    @if (Model.PendingCheckIns.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-nowrap align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Nhân viên</th>
                                        <th scope="col">KPI Báo cáo</th>
                                        <th scope="col">Kết quả đạt được</th>
                                        <th scope="col">Tiến độ %</th>
                                        <th scope="col">Thời điểm gửi</th>
                                        <th scope="col">Ghi chú</th>
                                        <th scope="col" class="text-end">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PendingCheckIns)
                                    {
                                        var progressColor = item.ProgressPercentage >= 100 ? "text-success" : item.ProgressPercentage >= 50 ? "text-primary" : "text-danger";
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="avatar-xs bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                        @(string.IsNullOrWhiteSpace(item.EmployeeName) ? "NV" : item.EmployeeName.Substring(0, 1).ToUpper())
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold">@item.EmployeeName</div>
                                                        <small class="text-muted">@item.PositionName</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fw-medium text-truncate" style="max-width: 220px;" title="@item.KpiName">@item.KpiName</div>
                                            </td>
                                            <td>
                                                <span class="fw-semibold">@(item.Value.HasValue ? item.Value.Value.ToString("N0") : "0")</span>
                                                @if (item.TargetValue.HasValue)
                                                {
                                                    <span class="text-muted small"> / @item.TargetValue.Value.ToString("N0")</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="fw-bold @progressColor">@item.ProgressPercentage.ToString("0.#")%</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@(item.CheckInDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</small>
                                            </td>
                                            <td>
                                                <small class="text-muted text-truncate d-inline-block" style="max-width: 160px;" title="@item.Note">
                                                    @(string.IsNullOrWhiteSpace(item.Note) ? "—" : item.Note)
                                                </small>
                                            </td>
                                            <td class="text-end">
                                                <a href="/KPICheckIns?searchString=@item.EmployeeName" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye me-1"></i>Xem & Duyệt
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-check-circle-fill fs-2 text-success d-block mb-2"></i>
                            Tất cả báo cáo check-in của nhân viên đã được duyệt hoàn tất!
                        </div>
                    }
                </div>
            </article>
        </div>
    </section>

    <!-- Team Member Progress Matrix & Charts -->
    <section class="row g-3 dashboard-section" aria-label="Tiến độ nhân viên nhóm">
        <div class="col-12 col-lg-8">
            <article class="card dashboard-card h-100">
                <header class="card-header dashboard-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="card-title mb-0">Theo Dõi Tiến Độ Thành Viên Trong Phòng</h2>
                        <small class="text-muted">Mức độ hoàn thành nhiệm vụ và trạng thái check-in của từng nhân viên</small>
                    </div>
                    <span class="badge badge-soft-info">@Model.TeamMembers.Count nhân sự</span>
                </header>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-nowrap align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Nhân viên</th>
                                    <th scope="col" class="text-center">Số KPI</th>
                                    <th scope="col" style="min-width: 160px;">Tiến độ đạt được</th>
                                    <th scope="col">Check-in gần nhất</th>
                                    <th scope="col">Tình trạng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TeamMembers.Any())
                                {
                                    @foreach (var member in Model.TeamMembers)
                                    {
                                        var barCls = member.AvgProgressPercentage >= 80 ? "bg-success" : member.AvgProgressPercentage >= 50 ? "bg-warning" : "bg-danger";
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@member.FullName</div>
                                                <small class="text-muted">@member.PositionName</small>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark">@member.AssignedKpisCount</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 8px;">
                                                        <div class="progress-bar @barCls" role="progressbar" style="width: @member.AvgProgressPercentage%" aria-valuenow="@member.AvgProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <span class="small fw-bold">@member.AvgProgressPercentage%</span>
                                                </div>
                                            </td>
                                            <td>
                                                <small class="text-muted">@(member.LastCheckInDate?.ToString("dd/MM/yyyy") ?? "Chưa có")</small>
                                            </td>
                                            <td>
                                                <span class="badge @member.StatusBadgeClass">@member.StatusLabel</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">Chưa có thành viên nào trong phòng ban</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-lg-4">
            <div class="d-flex flex-column gap-3 h-100">
                <!-- Team Distribution Chart -->
                <article class="card dashboard-card flex-grow-1">
                    <header class="card-header dashboard-card-header">
                        <h2 class="card-title mb-0">Phân Bổ Hiệu Suất Nhóm</h2>
                        <small class="text-muted">Tỷ lệ theo xếp loại năng lực</small>
                    </header>
                    <div class="card-body d-flex flex-column justify-content-center">
                        <div class="dashboard-chart-container" style="position: relative; height: 200px;">
                            <canvas id="managerTeamDistChart" aria-label="Biểu đồ phân bổ nhóm" role="img"></canvas>
                            <div id="managerTeamDistChartState" class="dashboard-chart-empty" hidden>
                                <i class="bi bi-pie-chart fs-1 text-muted" aria-hidden="true"></i>
                                <span class="mt-2 text-muted">Chưa có dữ liệu phân bổ</span>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Top Dept KPIs Chart -->
                <article class="card dashboard-card flex-grow-1">
                    <header class="card-header dashboard-card-header">
                        <h2 class="card-title mb-0">Tiến Độ Các KPI Phòng Ban</h2>
                        <small class="text-muted">Chỉ số trọng điểm của phòng</small>
                    </header>
                    <div class="card-body">
                        <div class="dashboard-chart-container" style="position: relative; height: 180px;">
                            <canvas id="managerKpiBarChart" aria-label="Biểu đồ KPI phòng ban" role="img"></canvas>
                            <div id="managerKpiBarChartState" class="dashboard-chart-empty" hidden>
                                <i class="bi bi-bar-chart fs-1 text-muted" aria-hidden="true"></i>
                                <span class="mt-2 text-muted">Chưa có KPI phòng</span>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>
</div>
