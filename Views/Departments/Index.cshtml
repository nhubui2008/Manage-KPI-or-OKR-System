@section Scripts {
<script>
    const canEditDepartmentFromPage = @(canEditDepartment.ToString().ToLowerInvariant());

    // Avatar color palette
    const avatarColors = [
        '#1a73e8', '#ea4335', '#34a853', '#f9ab00', '#8e24aa',
        '#00897b', '#e65100', '#1565c0', '#c62828', '#2e7d32'
    ];

    function getAvatarColor(name) {
        let hash = 0;
        for (let i = 0; i < (name || '').length; i++) {
            hash = name.charCodeAt(i) + ((hash << 5) - hash);
        }
        return avatarColors[Math.abs(hash) % avatarColors.length];
    }

    function escapeDepartmentHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, character => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;'
        })[character]);
    }

    function setActiveTreeItem(element) {
        document.querySelectorAll('.org-tree-item').forEach(el => el.classList.remove('active'));
        if (element) element.classList.add('active');
    }

    function setDetailView(view) {
        const loading = document.getElementById('detail-loading');
        const content = document.getElementById('detail-content');
        const table = document.getElementById('dept-table-view');

        if (!loading || !content || !table) return;

        loading.hidden = view !== 'loading';
        content.hidden = view !== 'content';
        table.hidden = view !== 'table';
    }

    function showLoading() {
        setDetailView('loading');
    }

    function showContent() {
        setDetailView('content');
    }

    function showTable() {
        setDetailView('table');
    }

    function showTableView() {
        const companyItem = document.querySelector('.org-tree-company');
        setActiveTreeItem(companyItem);
        showTable();
    }

    // ==========================================
    // Load Company Overview
    // ==========================================
    function loadCompanyOverview() {
        const companyItem = document.querySelector('.org-tree-company');
        setActiveTreeItem(companyItem);
        showLoading();

        fetch('/Departments/GetCompanyOverview')
            .then(res => res.json())
            .then(data => {
                renderCompanyOverview(data);
                showContent();
            })
            .catch(err => {
                console.error(err);
                document.getElementById('detail-content').innerHTML = 
                    '<div class="text-center text-danger py-5"><i class="bi bi-exclamation-triangle fs-1"></i><div class="mt-2">Không thể tải dữ liệu</div></div>';
                showContent();
            });
    }

    function renderCompanyOverview(data) {
        const container = document.getElementById('detail-content');
        
        // Build department list HTML
        let deptListHtml = '';
        const rootDepts = data.departments.filter(d => !d.parentDepartmentId);
        
        rootDepts.forEach(dept => {
            const departmentId = Number(dept.id);
            if (!Number.isInteger(departmentId)) return;

            const childDepts = data.departments.filter(d => d.parentDepartmentId === dept.id);
            const childCount = childDepts.length;
            const departmentName = escapeDepartmentHtml(dept.departmentName || '—');
            const departmentCode = escapeDepartmentHtml(dept.departmentCode || '—');
            const managerName = escapeDepartmentHtml(dept.managerName || 'Chưa phân công');
            const employeeCount = escapeDepartmentHtml(dept.employeeCount ?? 0);
            
            deptListHtml += `
                <div class="dept-overview-row" onclick="loadDepartmentDetail(${departmentId})">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, #f9ab00, #fbbc04); 
                                display: flex; align-items: center; justify-content: center; color: #fff; flex-shrink: 0;">
                        <i class="bi bi-folder-fill"></i>
                    </div>
                    <div style="flex: 1; min-width: 0;">
                        <div style="font-weight: 600; font-size: 0.85rem; color: var(--text-primary, #1a1a2e);">
                            ${departmentName}
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-secondary, #5f6368);">
                            ${departmentCode} · Quản lý: ${managerName}
                            ${childCount > 0 ? ' · ' + childCount + ' đơn vị trực thuộc' : ''}
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-secondary rounded-pill">${employeeCount} NV</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </div>
            `;
        });

        container.innerHTML = `
            <div class="detail-animate">
                <div class="detail-header">
                    <div class="detail-icon company">
                        <i class="bi bi-building"></i>
                    </div>
                    <div>
                        <div class="detail-title">Tổ Chức / Công Ty</div>
                        <div class="detail-subtitle">Tổng quan cơ cấu tổ chức doanh nghiệp</div>
                    </div>
                </div>

                <div class="detail-stats">
                    <div class="stat-card">
                        <div class="stat-value" style="color: #1a73e8;">${escapeDepartmentHtml(data.totalDepartments ?? 0)}</div>
                        <div class="stat-label">Tổng phòng ban</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color: #34a853;">${escapeDepartmentHtml(data.totalEmployees ?? 0)}</div>
                        <div class="stat-label">Tổng nhân viên</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color: #f9ab00;">${escapeDepartmentHtml(data.rootDepartments ?? 0)}</div>
                        <div class="stat-label">Phòng ban gốc</div>
                    </div>
                </div>

                <div class="detail-section">
                    <div class="detail-section-title">
                        <i class="bi bi-diagram-3"></i> Danh sách phòng ban chính
                    </div>
                    ${deptListHtml || '<div class="text-muted fst-italic py-2">Chưa có phòng ban nào</div>'}
                </div>
            </div>
        `;
    }

    // ==========================================
    // Load Department Detail
    // ==========================================
    function loadDepartmentDetail(deptId) {
        const treeItem = document.querySelector(`.org-tree-item[data-dept-id="${deptId}"]`);
        setActiveTreeItem(treeItem);
        showLoading();

        fetch('/Departments/GetDepartmentDetail?id=' + deptId)
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    document.getElementById('detail-content').innerHTML = 
                        '<div class="text-center text-danger py-5"><i class="bi bi-exclamation-triangle fs-1"></i><div class="mt-2">' + escapeDepartmentHtml(data.error) + '</div></div>';
                } else {
                    renderDepartmentDetail(data);
                }
                showContent();
            })
            .catch(err => {
                console.error(err);
                document.getElementById('detail-content').innerHTML = 
                    '<div class="text-center text-danger py-5"><i class="bi bi-exclamation-triangle fs-1"></i><div class="mt-2">Không thể tải dữ liệu</div></div>';
                showContent();
            });
    }

    function renderDepartmentDetail(data) {
        const container = document.getElementById('detail-content');
        
        // Build employee list
        let empListHtml = '';
        if (data.employees && data.employees.length > 0) {
            data.employees.forEach(emp => {
                const employeeId = Number(emp.id);
                if (!Number.isInteger(employeeId)) return;

                const fullName = escapeDepartmentHtml(emp.fullName || '—');
                const initial = escapeDepartmentHtml((emp.fullName || '?')[0].toUpperCase());
                const color = getAvatarColor(emp.fullName);
                const positionName = escapeDepartmentHtml(emp.positionName || 'Chưa xác định chức vụ');
                const email = emp.email ? escapeDepartmentHtml(emp.email) : '';
                const phone = emp.phone ? escapeDepartmentHtml(emp.phone) : '';
                empListHtml += `
                    <div class="emp-list-item">
                        <div class="emp-avatar" style="background: ${color};">${initial}</div>
                        <div class="emp-info">
                            <div class="emp-name"><a href="/Employees/Details/${employeeId}" class="text-decoration-none text-primary-hover fw-bold">${fullName}</a></div>
                            <div class="emp-position">${positionName}</div>
                        </div>
                        <div class="emp-contact text-end">
                            ${email ? '<div><i class="bi bi-envelope me-1"></i>' + email + '</div>' : ''}
                            ${phone ? '<div><i class="bi bi-telephone me-1"></i>' + phone + '</div>' : ''}
                        </div>
                    </div>
                `;
            });
        } else {
            empListHtml = `
                <div class="empty-employees">
                    <i class="bi bi-people"></i>
                    <div class="fw-medium">Chưa có nhân viên</div>
                    <div class="small">Phòng ban này hiện chưa có nhân viên nào được phân công</div>
                </div>
            `;
        }

        // Build child departments
        let childDeptHtml = '';
        if (data.childDepartments && data.childDepartments.length > 0) {
            data.childDepartments.forEach(child => {
                const childDepartmentId = Number(child.id);
                if (!Number.isInteger(childDepartmentId)) return;

                childDeptHtml += `
                    <span class="child-dept-chip" onclick="loadDepartmentDetail(${childDepartmentId})">
                        <i class="bi bi-folder text-warning"></i> ${escapeDepartmentHtml(child.departmentName || '—')}
                    </span>
                `;
            });
        }

        // Format date
        let createdDate = '—';
        if (data.createdAt) {
            const d = new Date(data.createdAt);
            createdDate = Number.isNaN(d.getTime()) ? '—' : d.toLocaleDateString('vi-VN');
        }

        const departmentId = Number(data.id);
        const managerId = Number(data.managerId);
        const departmentName = escapeDepartmentHtml(data.departmentName || '—');
        const departmentCode = escapeDepartmentHtml(data.departmentCode || '—');
        const employeeCount = escapeDepartmentHtml(data.employeeCount ?? 0);
        const managerName = data.managerName ? escapeDepartmentHtml(data.managerName) : '';
        const parentName = data.parentName ? escapeDepartmentHtml(data.parentName) : '';
        const childDepartmentCount = data.childDepartments ? data.childDepartments.length : 0;
        const editActionHtml = canEditDepartmentFromPage && Number.isInteger(departmentId)
            ? `<a href="/Departments/Edit/${departmentId}" class="detail-btn-outline"><i class="bi bi-pencil"></i> Chỉnh sửa</a>`
            : '';

        container.innerHTML = `
            <div class="detail-animate">
                <div class="detail-header">
                    <div class="detail-icon dept">
                        <i class="bi bi-folder-fill"></i>
                    </div>
                    <div style="flex: 1;">
                        <div class="detail-title">${departmentName}</div>
                        <div class="detail-subtitle">${departmentCode} · ${employeeCount} nhân viên</div>
                    </div>
                </div>

                <div class="detail-stats">
                    <div class="stat-card">
                        <div class="stat-value" style="color: #1a73e8;">${employeeCount}</div>
                        <div class="stat-label">Nhân viên</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color: #f9ab00;">${childDepartmentCount}</div>
                        <div class="stat-label">Đơn vị trực thuộc</div>
                    </div>
                </div>

                <div class="detail-section" style="border-top: 1px solid var(--border-color, #e8eaed);">
                    <div class="detail-section-title">
                        <i class="bi bi-info-circle"></i> Thông tin chung
                    </div>
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Mã phòng ban</div>
                            <div class="info-value">${departmentCode}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Trưởng phòng</div>
                            <div class="info-value">${managerName && Number.isInteger(managerId) ? `<a href="/Employees/Details/${managerId}" class="text-decoration-none text-primary-hover fw-bold">${managerName}</a>` : '<span class="text-muted fst-italic">Chưa phân công</span>'}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Trực thuộc</div>
                            <div class="info-value">${parentName || '<span class="text-muted fst-italic">Cấp cao nhất</span>'}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Ngày tạo</div>
                            <div class="info-value">${createdDate}</div>
                        </div>
                    </div>
                </div>

                ${childDeptHtml ? `
                <div class="detail-section" style="border-top: 1px solid var(--border-color, #e8eaed);">
                    <div class="detail-section-title">
                        <i class="bi bi-diagram-2"></i> Đơn vị trực thuộc
                    </div>
                    <div>${childDeptHtml}</div>
                </div>` : ''}

                <div class="detail-section" style="border-top: 1px solid var(--border-color, #e8eaed);">
                    <div class="detail-section-title">
                        <i class="bi bi-people"></i> Danh sách nhân viên (${employeeCount})
                    </div>
                    ${empListHtml}
                </div>

                <div class="detail-action-btns">
                    <a href="/Departments/Details/${departmentId}" class="detail-btn-primary">
                        <i class="bi bi-eye"></i> Xem đầy đủ
                    </a>
                    ${editActionHtml}
                </div>
            </div>
        `;
    }

</script>
}
