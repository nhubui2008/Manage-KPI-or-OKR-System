@model IEnumerable<Manage_KPI_or_OKR_System.Models.Department>
@{
    ViewData["Title"] = "Quản lý Phòng ban";
    var employees = ViewBag.Employees as Dictionary<int, string> ?? new Dictionary<int, string>();
    var employeeCounts = ViewBag.EmployeeCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var departmentItems = Model?.ToList() ?? new List<Manage_KPI_or_OKR_System.Models.Department>();
    var currentSearch = ViewData["CurrentFilter"]?.ToString();
    var currentStatus = ViewBag.CurrentStatus?.ToString();
    var hasActiveFilters = !string.IsNullOrWhiteSpace(currentSearch) || !string.IsNullOrWhiteSpace(currentStatus);
    var activeDepartmentCount = departmentItems.Count(department => department.IsActive == true);
    var inactiveDepartmentCount = departmentItems.Count - activeDepartmentCount;
    var rootDepartmentCount = departmentItems.Count(department => !department.ParentDepartmentId.HasValue);
    var visibleEmployeeCount = departmentItems.Sum(department => employeeCounts.TryGetValue(department.Id, out var count) ? count : 0);
    var isDepartmentAdminRole = User.IsInRole("Admin") || User.IsInRole("Administrator");
    var canCreateDepartment = isDepartmentAdminRole || User.HasClaim("Permission", "DEPARTMENTS_CREATE");
    var canEditDepartment = isDepartmentAdminRole || User.HasClaim("Permission", "DEPARTMENTS_EDIT");
    var canDeleteDepartment = isDepartmentAdminRole || User.HasClaim("Permission", "DEPARTMENTS_DELETE");

    void RenderDeptTree(IEnumerable<Manage_KPI_or_OKR_System.Models.Department> allDepts, int? parentId, int depth, Dictionary<int, int> counts)
    {
        var children = allDepts.Where(d => d.ParentDepartmentId == parentId).ToList();
        if (!children.Any()) return;

        <div class="department-tree-children @(depth > 0 ? "department-tree-children--nested" : "")">
            @foreach (var child in children)
            {
                var count = counts.ContainsKey(child.Id) ? counts[child.Id] : 0;
                <button type="button"
                        class="org-tree-item department-tree-item @(child.IsActive == true ? "" : "department-tree-item--inactive")"
                        data-dept-id="@child.Id"
                        onclick="@(child.IsActive == true ? $"loadDepartmentDetail({child.Id})" : null)"
                        disabled="@(child.IsActive == true ? null : "disabled")"
                        aria-label="@(child.IsActive == true ? $"Xem phòng ban {child.DepartmentName}" : $"Phòng ban {child.DepartmentName} đã ngừng hoạt động")">
                    <span class="department-tree-item__icon" aria-hidden="true"><i class="bi bi-folder"></i></span>
                    <span class="department-tree-item__content">
                        <strong>@child.DepartmentName</strong>
                        <small>@child.DepartmentCode</small>
                    </span>
                    <span class="department-tree-item__count">@count NV</span>
                </button>

                RenderDeptTree(allDepts, child.Id, depth + 1, counts);
            }
        </div>
    }
}

<div class="evaluation-page departments-page">
    <header class="evaluation-page-header">
        <div>
            <h1>Cơ cấu tổ chức</h1>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Phòng ban</span>
            </nav>
        </div>
        @if (canCreateDepartment)
        {
            <a class="evaluation-primary-action page-create-action" asp-action="Create" asp-controller="Departments">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Tạo phòng ban</span>
            </a>
        }
    </header>

    <section class="evaluation-summary departments-summary" aria-label="Tổng quan phòng ban">
        <article>
            <div class="evaluation-summary__icon evaluation-summary__icon--primary">
                <i class="bi bi-building"></i>
            </div>
            <div class="evaluation-summary__content">
                <span>Phòng ban phù hợp</span>
                <strong>@departmentItems.Count</strong>
            </div>
        </article>
        <article>
            <div class="evaluation-summary__icon evaluation-summary__icon--success">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="evaluation-summary__content">
                <span>Đang hoạt động</span>
                <strong>@activeDepartmentCount</strong>
            </div>
        </article>
        <article>
            <div class="evaluation-summary__icon evaluation-summary__icon--info">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div class="evaluation-summary__content">
                <span>Phòng ban cấp cao</span>
                <strong>@rootDepartmentCount</strong>
            </div>
        </article>
        <article>
            <div class="evaluation-summary__icon evaluation-summary__icon--warning">
                <i class="bi bi-people"></i>
            </div>
            <div class="evaluation-summary__content">
                <span>Nhân sự phân bổ</span>
                <strong>@visibleEmployeeCount</strong>
            </div>
        </article>
    </section>

    <div class="departments-workspace">
        <aside class="department-tree-panel" aria-labelledby="departmentTreeHeading">
            <div class="department-tree-panel__header">
                <div>
                    <p class="evaluation-eyebrow">Cấu trúc phân cấp</p>
                    <h2 id="departmentTreeHeading">Cây tổ chức</h2>
                </div>
            </div>
            <div class="department-tree-panel__body">
                <button type="button" class="org-tree-item org-tree-company department-tree-item active" onclick="showTableView()" aria-label="Xem toàn bộ cơ cấu tổ chức">
                    <span class="department-tree-item__icon department-tree-item__icon--company" aria-hidden="true"><i class="bi bi-building"></i></span>
                    <span class="department-tree-item__content">
                        <strong>Tổ chức / Công ty</strong>
                        <small>@departmentItems.Count phòng ban</small>
                    </span>
                </button>

                @if (departmentItems.Count > 0)
                {
                    RenderDeptTree(departmentItems, null, 0, employeeCounts);
                    foreach (var missingParentId in departmentItems
                        .Where(item => item.ParentDepartmentId.HasValue && departmentItems.All(parent => parent.Id != item.ParentDepartmentId.Value))
                        .Select(item => item.ParentDepartmentId)
                        .Distinct())
                    {
                        RenderDeptTree(departmentItems, missingParentId, 0, employeeCounts);
                    }
                }
                else
                {
                    <div class="department-tree-empty">Chưa có phòng ban phù hợp.</div>
                }
            </div>
        </aside>

        <section class="evaluation-results department-main-panel" id="detail-panel" aria-live="polite">
            <div id="detail-loading" class="department-detail-loading" hidden>
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Đang tải dữ liệu...</span>
            </div>

            <div id="detail-content" hidden></div>

            <div id="dept-table-view">
                <div class="evaluation-results-heading">
                    <div>
                        <p class="evaluation-eyebrow" id="departmentListHeading">Danh sách phòng ban</p>
                        <strong>@departmentItems.Count đơn vị phù hợp</strong>
                    </div>
                    <span>Chọn một mục trong cây để xem chi tiết</span>
                </div>

                <div class="evaluation-filter-panel department-filter-panel">
                    <div class="evaluation-filter-heading">
                        <div><span>Tìm theo mã, tên và trạng thái hoạt động.</span></div>
                        @if (hasActiveFilters)
                        {
                            <a asp-action="Index" class="evaluation-clear-link"><i class="bi bi-x-lg" aria-hidden="true"></i>Xóa lọc</a>
                        }
                    </div>
                    <form asp-action="Index" method="get" class="evaluation-filter-form departments-filter-form">
                        <label class="evaluation-search-field">
                            <span>Tìm kiếm</span>
                            <div class="evaluation-search-input-wrap">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" name="searchString" value="@currentSearch" placeholder="Mã hoặc tên phòng ban..." autocomplete="off" />
                            </div>
                        </label>
                        <label>
                            <span>Trạng thái</span>
                            <select name="isActive" class="no-select2">
                                <option value="" selected="@(string.IsNullOrEmpty(currentStatus) ? "selected" : null)">Tất cả trạng thái</option>
                                <option value="true" selected="@(currentStatus == "true" ? "selected" : null)">Hoạt động</option>
                                <option value="false" selected="@(currentStatus == "false" ? "selected" : null)">Ngừng hoạt động</option>
                            </select>
                        </label>
                        <button type="submit" class="evaluation-filter-button">
                            <i class="bi bi-funnel" aria-hidden="true"></i>
                            <span>Lọc dữ liệu</span>
                        </button>
                    </form>
                </div>

                @if (departmentItems.Count == 0)
                {
                    <div class="evaluation-empty" role="status">
                        <span class="evaluation-empty-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                        <h2>@(hasActiveFilters ? "Không có phòng ban phù hợp" : "Chưa có phòng ban trong hệ thống")</h2>
                        <p>@(hasActiveFilters ? "Thử đổi từ khóa hoặc trạng thái để mở rộng kết quả." : "Tạo phòng ban đầu tiên để bắt đầu xây dựng cơ cấu tổ chức.")</p>
                        @if (hasActiveFilters)
                        {
                            <a asp-action="Index" class="evaluation-secondary-action">Xóa bộ lọc</a>
                        }
                        else if (canCreateDepartment)
                        {
                            <a asp-action="Create" class="evaluation-primary-action page-create-action"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Tạo phòng ban</span></a>
                        }
                    </div>
                }
                else
                {
                    <div class="evaluation-table-shell">
                        <table class="evaluation-table departments-table" aria-labelledby="departmentListHeading">
                            <thead>
                                <tr>
                                    <th>Phòng ban</th>
                                    <th>Trực thuộc</th>
                                    <th>Quản lý</th>
                                    <th>Nhân sự</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in departmentItems)
                                {
                                    var managerName = dept.ManagerId.HasValue && employees.ContainsKey(dept.ManagerId.Value) ? employees[dept.ManagerId.Value] : "Chưa phân công";
                                    var parentName = dept.ParentDepartmentId.HasValue
                                        ? departmentItems.FirstOrDefault(item => item.Id == dept.ParentDepartmentId.Value)?.DepartmentName ?? "Phòng ban khác"
                                        : "Cấp cao nhất";
                                    var count = employeeCounts.ContainsKey(dept.Id) ? employeeCounts[dept.Id] : 0;
                                    var statusClass = dept.IsActive == true ? "evaluation-status evaluation-status--running" : "evaluation-status evaluation-status--closed";
                                    var statusText = dept.IsActive == true ? "Hoạt động" : "Ngừng hoạt động";

                                    <tr>
                                        <td>
                                            <div class="department-name-cell">
                                                <span class="department-mark" aria-hidden="true"><i class="bi bi-folder"></i></span>
                                                <div>
                                                    <strong>@dept.DepartmentName</strong>
                                                    <small>@dept.DepartmentCode</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="department-parent-chip"><i class="bi bi-diagram-2" aria-hidden="true"></i>@parentName</span></td>
                                        <td><span class="department-manager"><i class="bi bi-person" aria-hidden="true"></i>@managerName</span></td>
                                        <td><span class="department-count"><i class="bi bi-people" aria-hidden="true"></i>@count</span></td>
                                        <td><span class="@statusClass"><span aria-hidden="true"></span>@statusText</span></td>
                                        <td>
                                            <div class="evaluation-actions">
                                                <a asp-action="Details" asp-route-id="@dept.Id" class="evaluation-icon-button" title="Xem chi tiết" aria-label="Xem chi tiết @dept.DepartmentName"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                                @if (canEditDepartment && dept.IsActive == true)
                                                {
                                                    <a asp-action="Edit" asp-route-id="@dept.Id" class="evaluation-icon-button" title="Chỉnh sửa" aria-label="Chỉnh sửa @dept.DepartmentName"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                                }
                                                @if (canDeleteDepartment && dept.IsActive == true)
                                                {
                                                    <form asp-action="Delete" asp-route-id="@dept.Id" method="post" class="m-0"
                                                          data-app-confirm
                                                          data-confirm-title="Ngưng hoạt động phòng ban?"
                                                          data-confirm-message="Phòng ban “@dept.DepartmentName” sẽ ngừng xuất hiện trong các luồng hoạt động và có thể được khôi phục sau."
                                                          data-confirm-tone="warning"
                                                          data-confirm-label="Ngưng hoạt động">
                                                        <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" title="Ngưng hoạt động" aria-label="Ngưng hoạt động @dept.DepartmentName"><i class="bi bi-power" aria-hidden="true"></i></button>
                                                    </form>
                                                }
                                                else if (canDeleteDepartment && dept.IsActive != true)
                                                {
                                                    <form asp-action="Restore" asp-route-id="@dept.Id" method="post" class="m-0">
                                                        <button type="submit" class="evaluation-icon-button department-restore-button" title="Kích hoạt lại" aria-label="Kích hoạt lại @dept.DepartmentName"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="evaluation-mobile-list departments-mobile-list">
                        @foreach (var dept in departmentItems)
                        {
                            var managerName = dept.ManagerId.HasValue && employees.ContainsKey(dept.ManagerId.Value) ? employees[dept.ManagerId.Value] : "Chưa phân công";
                            var parentName = dept.ParentDepartmentId.HasValue
                                ? departmentItems.FirstOrDefault(item => item.Id == dept.ParentDepartmentId.Value)?.DepartmentName ?? "Phòng ban khác"
                                : "Cấp cao nhất";
                            var count = employeeCounts.ContainsKey(dept.Id) ? employeeCounts[dept.Id] : 0;
                            var statusClass = dept.IsActive == true ? "evaluation-status evaluation-status--running" : "evaluation-status evaluation-status--closed";
                            var statusText = dept.IsActive == true ? "Hoạt động" : "Ngừng hoạt động";

                            <article class="evaluation-period-card department-card">
                                <div class="evaluation-card-topline">
                                    <span class="@statusClass"><span aria-hidden="true"></span>@statusText</span>
                                    <span class="evaluation-config-status">@dept.DepartmentCode</span>
                                </div>
                                <h2>@dept.DepartmentName</h2>
                                <p>Trực thuộc: @parentName</p>
                                <dl>
                                    <div><dt>Quản lý</dt><dd>@managerName</dd></div>
                                    <div><dt>Nhân sự</dt><dd>@count người</dd></div>
                                </dl>
                                <div class="evaluation-card-footer">
                                    <a asp-action="Details" asp-route-id="@dept.Id">Xem chi tiết</a>
                                    <div class="evaluation-actions">
                                        @if (canEditDepartment && dept.IsActive == true)
                                        {
                                            <a asp-action="Edit" asp-route-id="@dept.Id" class="evaluation-icon-button" title="Chỉnh sửa" aria-label="Chỉnh sửa @dept.DepartmentName"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                        }
                                        @if (canDeleteDepartment && dept.IsActive == true)
                                        {
                                            <form asp-action="Delete" asp-route-id="@dept.Id" method="post" class="m-0"
                                                  data-app-confirm
                                                  data-confirm-title="Ngưng hoạt động phòng ban?"
                                                  data-confirm-message="Phòng ban “@dept.DepartmentName” sẽ ngừng xuất hiện trong các luồng hoạt động và có thể được khôi phục sau."
                                                  data-confirm-tone="warning"
                                                  data-confirm-label="Ngưng hoạt động">
                                                <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" title="Ngưng hoạt động" aria-label="Ngưng hoạt động @dept.DepartmentName"><i class="bi bi-power" aria-hidden="true"></i></button>
                                            </form>
                                        }
                                        else if (canDeleteDepartment && dept.IsActive != true)
                                        {
                                            <form asp-action="Restore" asp-route-id="@dept.Id" method="post" class="m-0">
                                                <button type="submit" class="evaluation-icon-button department-restore-button" title="Kích hoạt lại" aria-label="Kích hoạt lại @dept.DepartmentName"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
<style>
    /* Hierarchy Tree & Org Items */
    .org-tree-item,
    .departments-page .department-tree-item {
        display: grid !important;
        grid-template-columns: auto minmax(0, 1fr) auto !important;
        align-items: center !important;
        gap: 0.65rem !important;
        width: 100% !important;
        margin: 0 !important;
        border: 1px solid #e9ebec !important;
        border-radius: 10px !important;
        padding: 0.6rem 0.75rem !important;
        background: #ffffff !important;
        color: #212529 !important;
        text-align: left !important;
        cursor: pointer !important;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03) !important;
        transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.22s ease, background 0.22s ease, color 0.22s ease !important;
    }

    .org-tree-item:hover:not(:disabled),
    .departments-page .department-tree-item:hover:not(:disabled) {
        transform: translateY(-3px) translateX(3px) !important;
        border-color: #405189 !important;
        background: #ffffff !important;
        color: #405189 !important;
        box-shadow: 0 8px 20px -2px rgba(64, 81, 137, 0.18), 0 3px 8px rgba(15, 23, 42, 0.05) !important;
    }

    .org-tree-item:hover:not(:disabled) .department-tree-item__icon,
    .departments-page .department-tree-item:hover:not(:disabled) .department-tree-item__icon {
        transform: scale(1.15) !important;
        background: rgba(64, 81, 137, 0.12) !important;
        color: #405189 !important;
    }

    .org-tree-item:hover:not(:disabled) .department-tree-item__count,
    .departments-page .department-tree-item:hover:not(:disabled) .department-tree-item__count {
        background: #405189 !important;
        color: #ffffff !important;
        box-shadow: 0 2px 6px rgba(64, 81, 137, 0.25) !important;
    }

    .org-tree-item.active,
    .departments-page .department-tree-item.active {
        background: linear-gradient(135deg, rgba(64, 81, 137, 0.08), rgba(85, 110, 230, 0.12)) !important;
        border-color: #405189 !important;
        color: #405189 !important;
        box-shadow: 0 4px 14px rgba(64, 81, 137, 0.16) !important;
        transform: translateY(-1px) !important;
    }

    .org-tree-item.active .department-tree-item__icon,
    .departments-page .department-tree-item.active .department-tree-item__icon {
        background: #405189 !important;
        color: #ffffff !important;
    }

    .org-tree-item.active .department-tree-item__count,
    .departments-page .department-tree-item.active .department-tree-item__count {
        background: #405189 !important;
        color: #ffffff !important;
    }

    .departments-page .org-tree-company {
        border: 1px solid #d1d5db !important;
        background: #f8fafc !important;
        margin-bottom: 8px !important;
    }

    .departments-page .org-tree-company:hover {
        transform: translateY(-4px) !important;
        border-color: #405189 !important;
        background: #ffffff !important;
        box-shadow: 0 12px 26px -3px rgba(64, 81, 137, 0.22), 0 4px 10px rgba(15, 23, 42, 0.06) !important;
    }

    /* Detail Panel Styles */
    .detail-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border-color, #e8eaed);
        background: linear-gradient(135deg, rgba(26, 115, 232, 0.03), rgba(66, 133, 244, 0.06));
    }
    .detail-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }
    .detail-icon.company {
        background: linear-gradient(135deg, #1a73e8, #4285f4);
        color: #fff;
        box-shadow: 0 4px 12px rgba(26, 115, 232, 0.3);
    }
    .detail-icon.dept {
        background: linear-gradient(135deg, #f9ab00, #fbbc04);
        color: #fff;
        box-shadow: 0 4px 12px rgba(249, 171, 0, 0.3);
    }
    .detail-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text-primary, #1a1a2e);
        margin-bottom: 2px;
    }
    .detail-subtitle {
        font-size: 0.8rem;
        color: var(--text-secondary, #5f6368);
    }

    .detail-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 12px;
        padding: 20px 24px;
    }
    .stat-card {
        background: #ffffff !important;
        border-radius: 12px;
        padding: 16px;
        text-align: center;
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.22s ease !important;
    }
    .stat-card:hover {
        transform: translateY(-4px) !important;
        border-color: #cbd5e1 !important;
        box-shadow: 0 12px 24px -3px rgba(15, 23, 42, 0.12), 0 4px 8px rgba(15, 23, 42, 0.04) !important;
    }
    .stat-value {
        font-size: 1.6rem;
        font-weight: 800;
        line-height: 1.2;
    }
    .stat-label {
        font-size: 0.75rem;
        color: var(--text-secondary, #5f6368);
        font-weight: 500;
        margin-top: 4px;
    }

    .detail-section {
        padding: 16px 24px;
    }
    .detail-section-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-primary, #1a1a2e);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .detail-section-title i {
        color: var(--primary, #1a73e8);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }
    .info-item {
        background: var(--bg-secondary, #f8f9fa);
        border-radius: 10px;
        padding: 12px 16px;
        border: 1px solid var(--border-color, #e8eaed);
    }
    .info-label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--text-secondary, #5f6368);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }
    .info-value {
        font-size: 0.875rem;
