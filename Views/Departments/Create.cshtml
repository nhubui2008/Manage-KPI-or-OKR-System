@model Manage_KPI_or_OKR_System.Models.Department

@{
    ViewData["Title"] = "Thêm Phòng Ban";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var employees = ViewBag.Employees as Dictionary<int, string> ?? new Dictionary<int, string>();
    var departments = ViewBag.Departments as List<Manage_KPI_or_OKR_System.Models.Department> ?? new List<Manage_KPI_or_OKR_System.Models.Department>();
}

<div class="cf-page department-create-page" data-create-form>
    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Thêm phòng ban mới</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Phòng ban</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Thêm mới</span>
            </nav>
            <p class="cf-header__description">Thiết lập thông tin định danh, vị trí trong cơ cấu tổ chức và người phụ trách phòng ban.</p>
        </div>
        <a asp-action="Index" class="cf-back-action">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại</span>
        </a>
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="departmentCreateHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="departmentCreateHeading">Thông tin phòng ban</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
            </div>

            <form id="departmentForm"
                  asp-action="Create"
                  method="post"
                  class="cf-form"
                  data-create-form-element>
                <div asp-validation-summary="All" class="cf-alert" role="alert" tabindex="-1" data-error-summary></div>

                <section class="cf-section" aria-labelledby="departmentIdentityHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-building"></i></span>
                        <div>
                            <h3 id="departmentIdentityHeading">Thông tin định danh</h3>
                            <p>Nhập mã ngắn gọn và tên đầy đủ để nhận diện phòng ban trong toàn hệ thống.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <div class="cf-label-row">
                                <label asp-for="DepartmentCode">Mã phòng ban <span class="cf-required" aria-label="bắt buộc">*</span></label>
                                <span class="cf-counter" for="DepartmentCode" data-character-counter></span>
                            </div>
                            <input asp-for="DepartmentCode"
                                   class="form-control cf-control department-code-input"
                                   maxlength="20"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="Ví dụ: PKD, PNS, PKT"
                                   aria-describedby="departmentCodeHint"
                                   required />
                            <span asp-validation-for="DepartmentCode" class="cf-validation"></span>
                            <p id="departmentCodeHint" class="cf-hint">Tối đa 20 ký tự; nên viết hoa và không dùng khoảng trắng.</p>
                        </div>

                        <div class="cf-field">
                            <div class="cf-label-row">
                                <label asp-for="DepartmentName">Tên phòng ban <span class="cf-required" aria-label="bắt buộc">*</span></label>
                                <span class="cf-counter" for="DepartmentName" data-character-counter></span>
                            </div>
                            <input asp-for="DepartmentName"
                                   class="form-control cf-control"
                                   maxlength="100"
                                   autocomplete="organization-title"
                                   placeholder="Ví dụ: Phòng Kinh doanh"
                                   required />
                            <span asp-validation-for="DepartmentName" class="cf-validation"></span>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="departmentStructureHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
                        <div>
                            <h3 id="departmentStructureHeading">Cấu trúc tổ chức</h3>
                            <p>Xác định đơn vị cấp trên và người chịu trách nhiệm quản lý phòng ban.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label asp-for="ParentDepartmentId">Phòng ban cấp trên</label>
                            <select asp-for="ParentDepartmentId" class="form-select cf-control" aria-describedby="parentDepartmentHint">
                                <option value="">-- Là phòng ban cấp cao nhất --</option>
                                @foreach (var department in departments.OrderBy(item => item.DepartmentName))
                                {
                                    <option value="@department.Id">@department.DepartmentName (@department.DepartmentCode)</option>
                                }
                            </select>
                            <span asp-validation-for="ParentDepartmentId" class="cf-validation"></span>
                            <p id="parentDepartmentHint" class="cf-hint">Để trống nếu đây là đơn vị cấp cao nhất trong cơ cấu.</p>
                        </div>

                        <div class="cf-field">
                            <label asp-for="ManagerId">Người quản lý</label>
                            <select asp-for="ManagerId" class="form-select cf-control" aria-describedby="departmentManagerHint">
                                <option value="">-- Chưa chỉ định --</option>
                                @foreach (var employee in employees.OrderBy(item => item.Value))
                                {
                                    <option value="@employee.Key">@employee.Value</option>
                                }
                            </select>
                            <span asp-validation-for="ManagerId" class="cf-validation"></span>
                            <p id="departmentManagerHint" class="cf-hint">Có thể để trống và phân công trưởng bộ phận sau.</p>
                        </div>
                    </div>

                    <div class="cf-inline-note">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <span>Phòng ban mới sẽ được kích hoạt ngay và có thể nhận phân bổ nhân sự, KPI hoặc OKR sau khi lưu.</span>
                    </div>
                </section>

                <div class="cf-actions">
                    <a asp-action="Index" class="cf-secondary-action">Hủy</a>
                    <button type="submit"
                            class="cf-primary-action"
                            data-submit-button
                            data-default-label="Lưu phòng ban"
                            data-loading-label="Đang lưu...">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span data-submit-label>Lưu phòng ban</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide department-create-guide" aria-labelledby="departmentPreviewHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-building-check"></i></span>
                <div>
                    <span class="cf-guide__eyebrow">Xem trước</span>
                    <h2 id="departmentPreviewHeading">Phòng ban sắp tạo</h2>
                </div>
            </div>
            <p>Thông tin được cập nhật theo dữ liệu đang nhập để bạn kiểm tra nhanh trước khi lưu.</p>

            <dl class="cf-preview-list department-preview-list">
                <div>
                    <dt>Mã phòng ban</dt>
                    <dd id="previewCode">Chưa nhập</dd>
                </div>
                <div>
                    <dt>Tên phòng ban</dt>
                    <dd id="previewName">Chưa nhập</dd>
                </div>
                <div>
                    <dt>Trực thuộc</dt>
                    <dd id="previewParent">Cấp cao nhất</dd>
                </div>
                <div>
                    <dt>Người quản lý</dt>
                    <dd id="previewManager">Chưa chỉ định</dd>
                </div>
            </dl>

            <ul class="cf-guide__list department-create-guide__list">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Dùng mã ngắn, dễ tìm kiếm và thống nhất với quy ước nội bộ.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Chọn đúng phòng ban cấp trên để cây tổ chức hiển thị chính xác.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Người quản lý và cơ cấu trực thuộc vẫn có thể cập nhật sau.</span></li>
            </ul>

            <div class="cf-guide__note">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>Hệ thống sẽ kiểm tra mã phòng ban trùng trước khi tạo dữ liệu mới.</span>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <style>
        .department-create-page {
            --cf-accent: #2563eb;
            --cf-accent-dark: #1d4ed8;
            --cf-soft-accent: #eff6ff;
        }

        .department-code-input {
            font-weight: 750;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .department-preview-list dd {
            min-height: 1.15rem;
        }

        .department-create-guide__list {
            margin-top: 1rem;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
    <script>
        (function () {
            "use strict";

            const codeInput = document.getElementById("DepartmentCode");
            const nameInput = document.getElementById("DepartmentName");
            const parentSelect = document.getElementById("ParentDepartmentId");
            const managerSelect = document.getElementById("ManagerId");
            const previewCode = document.getElementById("previewCode");
            const previewName = document.getElementById("previewName");
            const previewParent = document.getElementById("previewParent");
            const previewManager = document.getElementById("previewManager");

            function selectedLabel(select, fallback) {
                if (!select) return fallback;

                const option = select.options[select.selectedIndex];
                return option && option.value ? option.text.trim() : fallback;
            }

            function updatePreview() {
                if (previewCode && codeInput) {
                    previewCode.textContent = codeInput.value.trim().toUpperCase() || "Chưa nhập";
                }

                if (previewName && nameInput) {
                    previewName.textContent = nameInput.value.trim() || "Chưa nhập";
                }

                if (previewParent) {
                    previewParent.textContent = selectedLabel(parentSelect, "Cấp cao nhất");
                }

                if (previewManager) {
                    previewManager.textContent = selectedLabel(managerSelect, "Chưa chỉ định");
                }
            }

            [codeInput, nameInput].forEach(input => input?.addEventListener("input", updatePreview));
            [parentSelect, managerSelect].forEach(select => select?.addEventListener("change", updatePreview));
            updatePreview();
        })();
    </script>
}
