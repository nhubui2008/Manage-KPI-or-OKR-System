@model Manage_KPI_or_OKR_System.Models.Position
@{
    ViewData["Title"] = "Thêm Chức vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cf-page position-create-page" data-create-form>
    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Thêm chức vụ mới</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Chức vụ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Thêm mới</span>
            </nav>
            <p class="cf-header__description">Tạo chức vụ mới và xác định thứ tự cấp bậc để sử dụng khi phân bổ nhân sự trong tổ chức.</p>
        </div>
        <a asp-action="Index" class="cf-back-action">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại</span>
        </a>
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="positionCreateHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="positionCreateHeading">Thông tin chức vụ</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
            </div>

            <form asp-action="Create"
                  method="post"
                  class="cf-form"
                  id="positionForm"
                  data-create-form-element>
                <div asp-validation-summary="All" class="cf-alert" role="alert" tabindex="-1" data-error-summary></div>

                <section class="cf-section" aria-labelledby="positionIdentityHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
                        <div>
                            <h3 id="positionIdentityHeading">Thông tin định danh</h3>
                            <p>Nhập mã ngắn và tên đầy đủ để nhận diện chức vụ trong toàn hệ thống.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <div class="cf-label-row">
                                <label asp-for="PositionCode">Mã chức vụ <span class="cf-required" aria-label="bắt buộc">*</span></label>
                                <span class="cf-counter" for="PositionCode" data-character-counter></span>
                            </div>
                            <input asp-for="PositionCode"
                                   class="form-control cf-control position-code-input"
                                   maxlength="20"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="Ví dụ: MGR, LEAD, CV01"
                                   aria-describedby="positionCodeHint"
                                   required />
                            <span asp-validation-for="PositionCode" class="cf-validation"></span>
                            <p id="positionCodeHint" class="cf-hint">Tối đa 20 ký tự; nên viết hoa và không dùng khoảng trắng.</p>
                        </div>

                        <div class="cf-field">
                            <div class="cf-label-row">
                                <label asp-for="PositionName">Tên chức vụ <span class="cf-required" aria-label="bắt buộc">*</span></label>
                                <span class="cf-counter" for="PositionName" data-character-counter></span>
                            </div>
                            <input asp-for="PositionName"
                                   class="form-control cf-control"
                                   maxlength="100"
                                   autocomplete="organization-title"
                                   placeholder="Ví dụ: Trưởng phòng Kinh doanh"
                                   required />
                            <span asp-validation-for="PositionName" class="cf-validation"></span>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="positionRankHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-bar-chart-steps"></i></span>
                        <div>
                            <h3 id="positionRankHeading">Thứ tự cấp bậc</h3>
                            <p>Thiết lập mức rank để danh mục được sắp xếp đúng theo cơ cấu tổ chức.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid position-rank-grid">
                        <div class="cf-field">
                            <label asp-for="RankLevel">Cấp bậc</label>
                            <input asp-for="RankLevel"
                                   type="number"
                                   class="form-control cf-control"
                                   min="1"
                                   max="100"
                                   step="1"
                                   inputmode="numeric"
                                   placeholder="Ví dụ: 1"
                                   aria-describedby="positionRankHint" />
                            <span asp-validation-for="RankLevel" class="cf-validation"></span>
                            <p id="positionRankHint" class="cf-hint">Nhập số từ 1 đến 100; số càng nhỏ thể hiện cấp càng cao.</p>
                        </div>

                        <div class="position-rank-rule" aria-label="Quy tắc cấp bậc">
                            <span class="position-rank-rule__icon" aria-hidden="true"><i class="bi bi-sort-numeric-up"></i></span>
                            <div>
                                <strong>Quy tắc sắp xếp</strong>
                                <p>Cấp 1 được hiển thị trước cấp 2, cấp 2 trước cấp 3 và tiếp tục tương tự.</p>
                            </div>
                        </div>
                    </div>

                    <div class="cf-inline-note">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <span>Chức vụ mới sẽ được kích hoạt ngay và có thể sử dụng khi phân công vị trí cho nhân viên.</span>
                    </div>
                </section>

                <div class="cf-actions">
                    <a asp-action="Index" class="cf-secondary-action">Hủy</a>
                    <button type="submit"
                            class="cf-primary-action"
                            data-submit-button
                            data-default-label="Lưu chức vụ"
                            data-loading-label="Đang lưu...">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span data-submit-label>Lưu chức vụ</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide position-create-guide" aria-labelledby="positionPreviewHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-person-check"></i></span>
                <div>
                    <span class="cf-guide__eyebrow">Xem trước</span>
                    <h2 id="positionPreviewHeading">Chức vụ sắp tạo</h2>
                </div>
            </div>
            <p>Thông tin được cập nhật theo dữ liệu đang nhập để bạn kiểm tra trước khi lưu.</p>

            <dl class="cf-preview-list position-preview-list">
                <div>
                    <dt>Mã chức vụ</dt>
                    <dd id="previewCode">Chưa nhập</dd>
                </div>
                <div>
                    <dt>Tên chức vụ</dt>
                    <dd id="previewName">Chưa nhập</dd>
                </div>
                <div>
                    <dt>Cấp bậc</dt>
                    <dd id="previewRank">Chưa thiết lập</dd>
                </div>
                <div>
                    <dt>Trạng thái ban đầu</dt>
                    <dd>Đang sử dụng</dd>
                </div>
            </dl>

            <ul class="cf-guide__list position-create-guide__list">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Dùng mã ngắn, dễ tìm kiếm và thống nhất với quy ước nội bộ.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Cấp bậc 1 là mức cao nhất trong danh mục chức vụ.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Tên và cấp bậc vẫn có thể cập nhật sau khi tạo.</span></li>
            </ul>

            <div class="cf-guide__note">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>Hệ thống sẽ kiểm tra mã chức vụ trùng và giới hạn cấp bậc trước khi lưu.</span>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <style>
        .position-create-page {
            --cf-accent: #2563eb;
            --cf-accent-dark: #1d4ed8;
            --cf-soft-accent: #eff6ff;
        }

        .position-code-input {
            font-weight: 750;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .position-rank-grid {
            align-items: stretch;
        }

        .position-rank-rule {
            display: flex;
            align-items: flex-start;
            gap: 0.65rem;
            min-height: 44px;
            border: 1px solid var(--cf-border);
            border-radius: 8px;
            padding: 0.75rem;
            background: var(--cf-soft);
        }

        .position-rank-rule__icon {
            display: inline-grid;
            width: 2rem;
            height: 2rem;
            flex: 0 0 2rem;
            place-items: center;
            border-radius: 7px;
            background: var(--cf-soft-accent);
            color: var(--cf-accent-dark);
        }

        .position-rank-rule strong {
            display: block;
            color: var(--cf-text);
            font-size: 0.8rem;
        }

        .position-rank-rule p {
            margin: 0.2rem 0 0;
            color: var(--cf-muted);
            font-size: 0.74rem;
            line-height: 1.5;
        }

        .position-preview-list dd {
            min-height: 1.15rem;
        }

        .position-create-guide__list {
            margin-top: 1rem;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
    <script>
        (function () {
            "use strict";

            const codeInput = document.getElementById("PositionCode");
            const nameInput = document.getElementById("PositionName");
            const rankInput = document.getElementById("RankLevel");
            const previewCode = document.getElementById("previewCode");
            const previewName = document.getElementById("previewName");
            const previewRank = document.getElementById("previewRank");

            function updatePreview() {
                if (previewCode && codeInput) {
                    previewCode.textContent = codeInput.value.trim().toUpperCase() || "Chưa nhập";
                }

                if (previewName && nameInput) {
                    previewName.textContent = nameInput.value.trim() || "Chưa nhập";
                }

                if (previewRank && rankInput) {
                    previewRank.textContent = rankInput.value ? `Cấp ${rankInput.value}` : "Chưa thiết lập";
                }
            }

            [codeInput, nameInput, rankInput].forEach(input => input?.addEventListener("input", updatePreview));
            updatePreview();
        })();
    </script>
}
