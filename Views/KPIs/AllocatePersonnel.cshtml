@model Manage_KPI_or_OKR_System.Models.KPI
@{
    ViewData["Title"] = "Phân bổ KPI";
    var detail = ViewBag.KPIDetail as Manage_KPI_or_OKR_System.Models.KPIDetail;
    var currentAssignments = ViewBag.Assignments as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var currentDepartmentAssignments = ViewBag.DepartmentAssignments as HashSet<int> ?? new HashSet<int>();
    var departments = ViewBag.Departments as List<Manage_KPI_or_OKR_System.Models.Department> ?? new List<Manage_KPI_or_OKR_System.Models.Department>();
    var groupedEmployees = ViewBag.GroupedEmployees as Dictionary<string, List<Manage_KPI_or_OKR_System.Models.Employee>> ?? new Dictionary<string, List<Manage_KPI_or_OKR_System.Models.Employee>>();

    var targetValue = (decimal?)detail?.TargetValue ?? 0m;
    var unit = detail?.MeasurementUnit ?? "";
}

<div class="container-fluid px-0 kpi-allocation-page">
    <!-- PAGE TITLE HEADER ENTERPRISE -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between mb-3 kpi-allocation-header">
                <div>
                    <h4 class="mb-sm-0 fw-bold">Phân bổ KPI: @Model.KPIName</h4>
                    <ol class="breadcrumb m-0 me-3 page-breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Danh sách KPI</a></li>
                        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">Chi tiết</a></li>
                        <li class="breadcrumb-item active">Phân bổ phòng ban/nhân sự</li>
                    </ol>
                </div>
        <div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <!-- Thông tin KPI -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary bg-opacity-10">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="fw-bold text-primary mb-1">@Model.KPIName</h5>
                    <p class="text-muted mb-0">
                        <i class="bi bi-calendar-event me-1"></i> Chu kỳ: <span class="fw-semibold">@ViewBag.PeriodName</span> |
                        <i class="bi bi-bullseye me-1"></i> Tổng chỉ tiêu: <span class="fw-bold text-success">@String.Format("{0:N0}", targetValue) @unit</span>
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div id="summaryCard" class="bg-white p-3 rounded-4 shadow-sm border border-primary border-opacity-25 d-inline-block text-start kpi-allocation-summary">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Tổng phân bổ</div>
                        <div class="d-flex align-items-center gap-2">
                            <span id="totalPercentageDisplay" class="fs-3 fw-bold text-primary">0%</span>
                            <i id="validationIcon" class="bi bi-exclamation-circle text-warning fs-4"></i>
                        </div>
                        <div class="small text-muted mt-1">
                            Phòng ban: <span id="departmentCountDisplay" class="fw-bold text-info">0</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="AssignPersonnel" method="post" id="allocationForm">
        <input type="hidden" name="kpiId" value="@Model.Id" />
        <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />

        <div class="row g-4">
            <!-- Cột Trái: Danh sách nhân viên -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-diagram-3 text-info me-2"></i>Chọn phòng ban và nhân viên</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <h6 class="text-uppercase fw-bold text-primary smaller mb-0">
                                    <i class="bi bi-building me-1"></i> Phòng ban
                                </h6>
                            </div>

                            @if (departments.Any())
                            {
                                <div class="department-selector-list d-flex flex-column gap-2">
                                    @foreach (var dept in departments)
                                    {
                                        var isDepartmentAssigned = currentDepartmentAssignments.Contains(dept.Id);
                                        <label class="department-select-item p-2 rounded-3 transition-hover border @(isDepartmentAssigned ? "border-info bg-info bg-opacity-10" : "border-transparent bg-light")"
                                               for="dept-cb-@dept.Id">
                                            <div class="form-check m-0 d-flex align-items-center">
                                                <input class="form-check-input ms-0 me-3 department-cb" type="checkbox" name="departmentIds" value="@dept.Id" id="dept-cb-@dept.Id" @(isDepartmentAssigned ? "checked" : "")>
                                                <div class="flex-grow-1 cursor-pointer">
                                                    <div class="fw-bold text-dark">@dept.DepartmentName</div>
                                                    <div class="text-muted smaller">@dept.DepartmentCode</div>
                                                </div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small text-center py-3 bg-light rounded-3">Chưa có phòng ban hoạt động.</div>
                            }
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <h6 class="text-uppercase fw-bold text-primary smaller mb-0">
                                <i class="bi bi-people me-1"></i> Nhân viên
                            </h6>
                        </div>

                        <div class="input-group mb-3 position-relative">
                            <span class="input-group-text bg-light border-0 ps-3 rounded-pill-start">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="employeeSearch" class="form-control bg-light border-0 py-2 rounded-pill-end" placeholder="Tìm tên hoặc mã nhân viên...">
                        </div>

                        <div class="employee-selector-list">
                            @foreach (var group in groupedEmployees)
                            {
                                <div class="department-group mb-4" data-dept="@group.Key">
                                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                        <h6 class="text-uppercase fw-bold text-primary smaller mb-0">
                                            <i class="bi bi-building me-1"></i> @group.Key
                                        </h6>
                                        <div class="form-check form-switch m-0" style="min-height: auto;">
                                            <input class="form-check-input dept-toggle" type="checkbox" role="switch" id="toggle-@group.Key.Replace(" ", "-")" data-dept-name="@group.Key">
                                            <label class="form-check-label smaller text-muted cursor-pointer" for="toggle-@group.Key.Replace(" ", "-")">Tất cả</label>
                                        </div>
                                    </div>

                                    @foreach (var emp in group.Value)
                                    {
                                        var isAssigned = currentAssignments.ContainsKey(emp.Id);
                                        <label class="employee-select-item p-2 mb-2 rounded-3 transition-hover border @(isAssigned ? "border-primary bg-primary bg-opacity-5" : "border-transparent bg-light")"
                                               for="cb-@emp.Id"
                                              data-search="@emp.FullName?.ToLower() @emp.EmployeeCode?.ToLower()"
                                              data-dept="@group.Key">
                                            <div class="form-check m-0 d-flex align-items-center">
                                                <input class="form-check-input ms-0 me-3 employee-cb" type="checkbox" name="employeeSelectorIds" value="@emp.Id" id="cb-@emp.Id" @(isAssigned ? "checked" : "") data-dept="@group.Key">
                                                <div class="flex-grow-1 cursor-pointer">
                                                    <div class="fw-bold text-dark">@emp.FullName</div>
                                                    <div class="text-muted smaller">@emp.EmployeeCode</div>
                                                </div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột Phải: Phân bổ chi tiết -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-sliders text-primary me-2"></i>Thiết lập tỷ lệ</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" id="equalizeWeightsButton">
                            <i class="bi bi-distribute-vertical me-1"></i> Chia đều
                        </button>
                    </div>
                    <div class="card-body p-4 bg-light bg-opacity-30">
                        <div id="allocationList" class="d-flex flex-column gap-3">
                            <!-- Cards will be injected here by JS -->
                            <div id="emptyState" class="text-center py-5 text-muted @(currentAssignments.Any() ? "d-none" : "")">
                                <i class="bi bi-person-plus fs-1 opacity-25"></i>
                                <p class="mt-2 text-uppercase fw-bold small">Chọn nhân viên từ cột bên trái để bắt đầu phân bổ</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 p-4">
                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" id="saveBtn">
                            <i class="bi bi-check2-circle me-2"></i> Lưu phân bổ KPI
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<template id="allocationCardTemplate">
    <div class="allocation-card card border-0 shadow-sm rounded-4 animate__animated animate__fadeInUp animate__faster" id="card-{id}">
        <!-- Keep the posted employee ID adjacent to its weight.  The selector
             list and allocation cards can be in different orders when users
             select employees interactively. -->
        <input type="hidden" name="employeeIds" value="{id}" />
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark name-label"></div>
                        <div class="text-muted smaller code-label"></div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-remove-employee="{id}" aria-label="Xóa nhân viên khỏi phân bổ"></button>
            </div>

            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <input type="range" class="form-range weight-slider" min="0" max="100" step="1" data-employee-id="{id}" aria-label="Tỷ trọng phân bổ">
                </div>
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <input type="number" name="weights" class="form-control fw-bold text-center weight-input"
                               min="0" max="100" step="0.1" value="{weight}" id="input-{id}"
                               data-employee-id="{id}" aria-label="Tỷ trọng phân bổ theo phần trăm">
                        <span class="input-group-text bg-light border-start-0">%</span>
                    </div>
                </div>
            </div>
            <hr class="my-2 opacity-5">
            <div class="d-flex justify-content-between align-items-center text-muted smaller">
                <span>Chỉ tiêu tính toán:</span>
                <span class="fw-bold text-primary target-calc">0 @unit</span>
            </div>
        </div>
    </div>
</template>

<script type="application/json" id="kpiAllocationConfig">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        totalKpiTarget = targetValue,
        initialAssignments = currentAssignments,
        employeesData = groupedEmployees.SelectMany(group => group.Value).ToDictionary(employee => employee.Id, employee => new
        {
            name = employee.FullName,
            code = employee.EmployeeCode
        }),
        unit
    }))
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/kpi-create.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/kpi-allocation.js" asp-append-version="true"></script>
}
