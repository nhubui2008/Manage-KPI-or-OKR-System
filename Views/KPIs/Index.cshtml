@model Manage_KPI_or_OKR_System.Models.ViewModels.KpiIndexViewModel
@using Manage_KPI_or_OKR_System.Helpers
@using System.Globalization
@{
    ViewData["Title"] = "Giao & xem KPI cá nhân";
    var pageItems = Model.Items;
}

@functions {
    private string QuickFilterClass(string value) =>
        string.Equals(Model.QuickFilter ?? string.Empty, value, StringComparison.OrdinalIgnoreCase)
            ? "evaluation-chip is-active"
            : "evaluation-chip";

    private static string StatusClass(string statusName) => statusName switch
    {
        WorkflowStatusHelper.KpiPendingApproval => "kpi-status kpi-status--pending",
        WorkflowStatusHelper.KpiInProgress => "kpi-status kpi-status--active",
        WorkflowStatusHelper.KpiNearTarget => "kpi-status kpi-status--near",
        WorkflowStatusHelper.KpiCompleted => "kpi-status kpi-status--completed",
        WorkflowStatusHelper.KpiMissed => "kpi-status kpi-status--missed",
        WorkflowStatusHelper.KpiRejected => "kpi-status kpi-status--rejected",
        WorkflowStatusHelper.KpiCanceled => "kpi-status kpi-status--canceled",
        WorkflowStatusHelper.KpiDraft => "kpi-status kpi-status--draft",
        _ => "kpi-status kpi-status--draft"
    };

    private static string StatusIcon(string statusName) => statusName switch
    {
        WorkflowStatusHelper.KpiPendingApproval => "bi-clock",
        WorkflowStatusHelper.KpiInProgress => "bi-play-circle",
        WorkflowStatusHelper.KpiNearTarget => "bi-graph-up-arrow",
        WorkflowStatusHelper.KpiCompleted => "bi-check-circle",
        WorkflowStatusHelper.KpiMissed => "bi-exclamation-triangle",
        WorkflowStatusHelper.KpiRejected => "bi-x-circle",
        WorkflowStatusHelper.KpiCanceled => "bi-slash-circle",
        _ => "bi-file-earmark-text"
    };

    private static string Initials(string name)
    {
        var initials = string.Concat(name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part[0]));
        return string.IsNullOrWhiteSpace(initials)
            ? "NV"
            : initials.Length > 2 ? initials[^2..].ToUpperInvariant() : initials.ToUpperInvariant();
    }

    private static string Metric(decimal? value)
    {
        if (!value.HasValue) return "Chưa đặt";
        var format = decimal.Truncate(value.Value) == value.Value ? "N0" : "N2";
        return value.Value.ToString(format, CultureInfo.GetCultureInfo("vi-VN"));
    }

    private static bool IsPending(string statusName) =>
        statusName == WorkflowStatusHelper.KpiPendingApproval;
}

<div class="evaluation-page kpi-page">
    <header class="evaluation-page-header">
        <div>
            <h1>Giao & xem KPI cá nhân</h1>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Quản lý KPI</span>
            </nav>
        </div>
        @if (Model.CanCreateKpi)
        {
            <div class="kpi-page-actions">
                <a asp-action="Create" asp-route-ai="true" class="evaluation-secondary-action">
                    <i class="bi bi-stars" aria-hidden="true"></i>
                    <span>Gợi ý bằng AI</span>
                </a>
                <a asp-action="Create" class="evaluation-primary-action">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>Tạo KPI</span>
                </a>
            </div>
        }
    </header>

    <section class="evaluation-summary kpi-summary" aria-label="Tổng quan KPI">
        <article>
            <span>KPI phù hợp</span>
            <strong>@Model.Summary.TotalCount</strong>
            <small>Trong phạm vi đang xem</small>
        </article>
        <article>
            <span>KPI của tôi</span>
            <strong>@Model.Summary.MineCount</strong>
            <small>Giao trực tiếp hoặc qua phòng ban</small>
        </article>
        <article>
            <span>Đã phân bổ</span>
            <strong>@Model.Summary.AllocatedCount</strong>
            <small>Có người hoặc đơn vị phụ trách</small>
        </article>
        <article>
            <span>Đang thực hiện</span>
            <strong>@Model.Summary.InProgressCount</strong>
            <small>Có thể cập nhật check-in</small>
        </article>
        <article>
            <span>Chờ duyệt</span>
            <strong>@Model.Summary.PendingCount</strong>
            <small>Cần xác nhận trước khi thực thi</small>
        </article>
    </section>

    <section class="evaluation-filter-panel" aria-labelledby="kpi-filter-title">
        <div class="evaluation-filter-heading">
            <div>
                <p class="evaluation-eyebrow" id="kpi-filter-title">Tìm và lọc</p>
                <span>Thu hẹp danh sách theo kỳ, trạng thái và phạm vi trách nhiệm.</span>
            </div>
            @if (Model.HasActiveFilters)
            {
                <a asp-action="Index" class="evaluation-clear-link">
                    <i class="bi bi-x-lg" aria-hidden="true"></i> Xóa lọc
                </a>
            }
        </div>

        <form asp-action="Index" method="get" class="evaluation-filter-form kpi-filter-form">
            <label class="evaluation-search-field">
                <span class="visually-hidden">Tìm KPI</span>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="searchString" value="@Model.SearchString"
                       placeholder="Tên hoặc mô tả KPI..." autocomplete="off" />
            </label>

            <label>
                <span>Kỳ đánh giá</span>
                <select name="periodId" class="no-select2">
                    <option value="">Tất cả</option>
                    @foreach (var option in Model.PeriodOptions)
                    {
                        <option value="@option.Id" selected="@(Model.PeriodId == option.Id ? "selected" : null)">@option.Name</option>
                    }
                </select>
            </label>

            <label>
                <span>Trạng thái</span>
                <select name="statusId" class="no-select2">
                    <option value="">Tất cả</option>
                    @foreach (var option in Model.StatusOptions)
                    {
                        <option value="@option.Id" selected="@(Model.StatusId == option.Id ? "selected" : null)">@option.Name</option>
                    }
                </select>
            </label>

            <label>
                <span>Sắp xếp</span>
                <select name="sortBy" class="no-select2">
                    <option value="recent" selected="@(Model.SortBy == "recent" ? "selected" : null)">Mới tạo trước</option>
                    <option value="oldest" selected="@(Model.SortBy == "oldest" ? "selected" : null)">Cũ nhất trước</option>
                    <option value="name" selected="@(Model.SortBy == "name" ? "selected" : null)">Tên A-Z</option>
                </select>
            </label>

            <input type="hidden" name="quickFilter" value="@Model.QuickFilter" />
            <button type="submit" class="evaluation-filter-button">
                <i class="bi bi-funnel" aria-hidden="true"></i> Lọc
            </button>
        </form>

        <nav class="evaluation-quick-filters" aria-label="Lọc nhanh KPI">
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-periodId="@Model.PeriodId" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" class="@QuickFilterClass("")">
                <i class="bi bi-grid" aria-hidden="true"></i> Tất cả
            </a>
            @if (Model.HasCurrentEmployee)
            {
                <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-periodId="@Model.PeriodId" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="mine" class="@QuickFilterClass("mine")">
                    <i class="bi bi-person-check" aria-hidden="true"></i> KPI của tôi
                </a>
                <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-periodId="@Model.PeriodId" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="assigned" class="@QuickFilterClass("assigned")">
                    <i class="bi bi-send" aria-hidden="true"></i> Tôi đã giao
                </a>
            }
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-periodId="@Model.PeriodId" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="active" class="@QuickFilterClass("active")">
                <i class="bi bi-play-circle" aria-hidden="true"></i> Đang thực hiện
            </a>
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-periodId="@Model.PeriodId" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="pending" class="@QuickFilterClass("pending")">
                <i class="bi bi-clock" aria-hidden="true"></i> Chờ duyệt
            </a>
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-periodId="@Model.PeriodId" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="unallocated" class="@QuickFilterClass("unallocated")">
                <i class="bi bi-person-dash" aria-hidden="true"></i> Chưa phân bổ
            </a>
        </nav>
    </section>

    <section class="evaluation-results kpi-results" aria-labelledby="kpi-results-title">
        <div class="evaluation-results-heading">
            <div>
                <p class="evaluation-eyebrow" id="kpi-results-title">Danh sách KPI</p>
                <strong>@Model.Summary.TotalCount KPI phù hợp</strong>
            </div>
            <span>Trang @pageItems.PageIndex / @Math.Max(1, pageItems.TotalPages)</span>
        </div>

        @if (pageItems.Count == 0)
        {
            <div class="evaluation-empty">
                <span class="evaluation-empty-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                <h2>@(Model.IsFilteredEmpty ? "Không có KPI phù hợp" : "Chưa có KPI trong phạm vi của bạn")</h2>
                <p>
                    @(Model.IsFilteredEmpty
                        ? "Thử thay đổi bộ lọc hoặc xóa lọc để xem lại danh sách KPI."
                        : Model.CanCreateKpi
                            ? "Tạo KPI đầu tiên, đặt chỉ tiêu và phân bổ người hoặc phòng ban chịu trách nhiệm."
                            : "KPI được giao trực tiếp hoặc qua phòng ban sẽ xuất hiện tại đây.")
                </p>
                @if (Model.IsFilteredEmpty)
                {
                    <a asp-action="Index" class="evaluation-secondary-action">Xóa bộ lọc</a>
                }
                else if (Model.CanCreateKpi)
                {
                    <a asp-action="Create" class="evaluation-primary-action">Tạo KPI</a>
                }
            </div>
        }
        else
        {
            <div class="evaluation-table-shell">
                <table class="evaluation-table kpi-table">
                    <thead>
                        <tr>
                            <th>KPI</th>
                            <th>Chỉ tiêu</th>
                            <th>Phân bổ</th>
                            <th>Kỳ & trạng thái</th>
                            <th>Tiến độ</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pageItems)
                        {
                            <tr>
                                <td>
                                    <div class="evaluation-period-name kpi-name-cell">
                                        <span class="evaluation-calendar-mark"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="kpi-name-link">@item.Name</a>
                                            <span>@item.TypeName</span>
                                            <div class="kpi-alignment">
                                                @if (!string.IsNullOrWhiteSpace(item.OkrName))
                                                {
                                                    <span title="@item.OkrName"><i class="bi bi-bullseye" aria-hidden="true"></i>@item.OkrName</span>
                                                }
                                                else
                                                {
                                                    <span><i class="bi bi-unlink" aria-hidden="true"></i>KPI độc lập</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="kpi-target">
                                        <strong>@Metric(item.TargetValue) @item.MeasurementUnit</strong>
                                        @if (item.PassThreshold.HasValue)
                                        {
                                            <span>Ngưỡng đạt: @Metric(item.PassThreshold)</span>
                                        }
                                        <small>
                                            <i class="bi @(item.IsInverse ? "bi-arrow-down" : "bi-arrow-up")" aria-hidden="true"></i>
                                            @(item.IsInverse ? "Càng thấp càng tốt" : "Càng cao càng tốt")
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    @if (item.HasAssignments)
                                    {
                                        <div class="kpi-assignees">
                                            @if (item.DepartmentNames.Count > 0)
                                            {
                                                <div class="kpi-departments">
                                                    @foreach (var department in item.DepartmentNames.Take(2))
                                                    {
                                                        <span><i class="bi bi-building" aria-hidden="true"></i>@department</span>
                                                    }
                                                    @if (item.DepartmentNames.Count > 2)
                                                    {
                                                        <span>+@(item.DepartmentNames.Count - 2) phòng</span>
                                                    }
                                                </div>
                                            }
                                            @if (item.EmployeeAssignments.Count > 0)
                                            {
                                                <div class="kpi-avatar-stack" aria-label="@item.EmployeeAssignments.Count nhân viên phụ trách">
                                                    @foreach (var assignment in item.EmployeeAssignments.Take(3))
                                                    {
                                                        var assignmentTitle = $"{assignment.EmployeeName} · {assignment.WeightPercent:0.##}%";
                                                        <span title="@assignmentTitle">@Initials(assignment.EmployeeName)</span>
                                                    }
                                                    @if (item.EmployeeAssignments.Count > 3)
                                                    {
                                                        <span>+@(item.EmployeeAssignments.Count - 3)</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="kpi-unallocated"><i class="bi bi-person-dash" aria-hidden="true"></i>Chưa phân bổ</span>
                                    }
                                </td>
                                <td>
                                    <div class="kpi-period-status">
                                        <strong><i class="bi bi-calendar3" aria-hidden="true"></i>@item.PeriodName</strong>
                                        <span class="@StatusClass(item.StatusName)">
                                            <i class="bi @StatusIcon(item.StatusName)" aria-hidden="true"></i>@item.StatusName
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="kpi-progress" aria-label="Tiến độ KPI @item.Name">
                                        <div>
                                            <span>Tiến độ</span>
                                            <strong>@(item.Progress.HasValue ? $"{item.Progress.Value:0.#}%" : "Chưa check-in")</strong>
                                        </div>
                                        <progress max="100" value="@(Math.Clamp(item.Progress ?? 0, 0, 100))">@(item.Progress ?? 0)%</progress>
                                    </div>
                                </td>
                                <td>
                                    <div class="evaluation-actions">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="evaluation-icon-button" aria-label="Xem chi tiết @item.Name" title="Chi tiết">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        @if (item.CanCheckIn)
                                        {
                                            <a asp-controller="KPICheckIns" asp-action="Create" asp-route-kpiId="@item.Id" class="evaluation-icon-button kpi-icon-button--success" aria-label="Check-in @item.Name" title="Check-in">
                                                <i class="bi bi-check2-square" aria-hidden="true"></i>
                                            </a>
                                        }
                                        @if (Model.CanCreateKpi || (Model.CanApproveKpi && IsPending(item.StatusName)) || Model.CanDeleteKpi)
                                        {
                                            <div class="dropdown">
                                                <button type="button" class="evaluation-icon-button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" aria-label="Thao tác khác cho @item.Name">
                                                    <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                    @if (Model.CanCreateKpi)
                                                    {
                                                        <li>
                                                            <a class="dropdown-item" asp-action="AllocatePersonnel" asp-route-id="@item.Id">
                                                                <i class="bi bi-people me-2" aria-hidden="true"></i>Phân bổ trách nhiệm
                                                            </a>
                                                        </li>
                                                    }
                                                    @if (Model.CanApproveKpi && IsPending(item.StatusName))
                                                    {
                                                        <li><hr class="dropdown-divider" /></li>
                                                        <li>
                                                            <form asp-action="Approve" method="post">
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-2" aria-hidden="true"></i>Duyệt KPI</button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form asp-action="Reject" method="post" data-app-confirm
                                                                  data-confirm-title="Từ chối KPI?"
                                                                  data-confirm-message="KPI sẽ chuyển sang trạng thái từ chối và không thể check-in."
                                                                  data-confirm-tone="warning"
                                                                  data-confirm-label="Từ chối">
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-x-circle me-2" aria-hidden="true"></i>Từ chối</button>
                                                            </form>
                                                        </li>
                                                    }
                                                    @if (Model.CanDeleteKpi)
                                                    {
                                                        <li><hr class="dropdown-divider" /></li>
                                                        <li>
                                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                                                  data-app-confirm
                                                                  data-confirm-title="Vô hiệu hóa KPI?"
                                                                  data-confirm-message="KPI sẽ ngừng hoạt động nhưng dữ liệu lịch sử vẫn được giữ lại."
                                                                  data-confirm-tone="warning"
                                                                  data-confirm-label="Vô hiệu hóa">
                                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash3 me-2" aria-hidden="true"></i>Vô hiệu hóa</button>
                                                            </form>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="evaluation-mobile-list kpi-mobile-list">
                @foreach (var item in pageItems)
                {
                    <article class="evaluation-period-card kpi-card">
                        <div class="evaluation-card-topline">
                            <span class="@StatusClass(item.StatusName)"><i class="bi @StatusIcon(item.StatusName)" aria-hidden="true"></i>@item.StatusName</span>
                            <span class="evaluation-config-status">@item.PeriodName</span>
                        </div>
                        <h2><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></h2>
                        <p>@item.TypeName · @(!string.IsNullOrWhiteSpace(item.OkrName) ? "Có liên kết OKR" : "KPI độc lập")</p>
                        <dl>
                            <div><dt>Chỉ tiêu</dt><dd>@Metric(item.TargetValue) @item.MeasurementUnit</dd></div>
                            <div><dt>Tiến độ</dt><dd>@(item.Progress.HasValue ? $"{item.Progress.Value:0.#}%" : "Chưa có")</dd></div>
                            <div><dt>Nhân viên</dt><dd>@item.EmployeeAssignments.Count</dd></div>
                            <div><dt>Phòng ban</dt><dd>@item.DepartmentNames.Count</dd></div>
                        </dl>
                        <div class="evaluation-card-footer">
                            <a asp-action="Details" asp-route-id="@item.Id">Xem chi tiết</a>
                            <div class="evaluation-actions">
                                @if (item.CanCheckIn)
                                {
                                    <a asp-controller="KPICheckIns" asp-action="Create" asp-route-kpiId="@item.Id" class="evaluation-icon-button" aria-label="Check-in @item.Name"><i class="bi bi-check2-square" aria-hidden="true"></i></a>
                                }
                                @if (Model.CanCreateKpi)
                                {
                                    <a asp-action="AllocatePersonnel" asp-route-id="@item.Id" class="evaluation-icon-button" aria-label="Phân bổ @item.Name"><i class="bi bi-people" aria-hidden="true"></i></a>
                                }
                                @if ((Model.CanApproveKpi && IsPending(item.StatusName)) || Model.CanDeleteKpi)
                                {
                                    <div class="dropdown">
                                        <button type="button" class="evaluation-icon-button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" aria-label="Thao tác khác cho @item.Name">
                                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            @if (Model.CanApproveKpi && IsPending(item.StatusName))
                                            {
                                                <li>
                                                    <form asp-action="Approve" method="post">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-2" aria-hidden="true"></i>Duyệt KPI</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="Reject" method="post" data-app-confirm
                                                          data-confirm-title="Từ chối KPI?"
                                                          data-confirm-message="KPI sẽ chuyển sang trạng thái từ chối và không thể check-in."
                                                          data-confirm-tone="warning"
                                                          data-confirm-label="Từ chối">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-x-circle me-2" aria-hidden="true"></i>Từ chối</button>
                                                    </form>
                                                </li>
                                            }
                                            @if (Model.CanDeleteKpi)
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" data-app-confirm
                                                          data-confirm-title="Vô hiệu hóa KPI?"
                                                          data-confirm-message="KPI sẽ ngừng hoạt động nhưng dữ liệu lịch sử vẫn được giữ lại."
                                                          data-confirm-tone="warning"
                                                          data-confirm-label="Vô hiệu hóa">
                                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash3 me-2" aria-hidden="true"></i>Vô hiệu hóa</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }

        @if (pageItems.TotalPages > 1)
        {
            <nav class="evaluation-pagination" aria-label="Phân trang KPI">
                @if (pageItems.PreviousPageNumber.HasValue)
                {
                    <a asp-action="Index" asp-route-pageNumber="@pageItems.PreviousPageNumber" asp-route-searchString="@Model.SearchString" asp-route-periodId="@Model.PeriodId" asp-route-statusId="@Model.StatusId" asp-route-quickFilter="@Model.QuickFilter" asp-route-sortBy="@Model.SortBy" aria-label="Trang trước"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                }

                @for (var pageIndex = 1; pageIndex <= pageItems.TotalPages; pageIndex++)
                {
                    <a asp-action="Index" asp-route-pageNumber="@pageIndex" asp-route-searchString="@Model.SearchString" asp-route-periodId="@Model.PeriodId" asp-route-statusId="@Model.StatusId" asp-route-quickFilter="@Model.QuickFilter" asp-route-sortBy="@Model.SortBy" class="@(pageIndex == pageItems.PageIndex ? "is-current" : null)" aria-current="@(pageIndex == pageItems.PageIndex ? "page" : null)">@pageIndex</a>
                }

                @if (pageItems.NextPageNumber.HasValue)
                {
                    <a asp-action="Index" asp-route-pageNumber="@pageItems.NextPageNumber" asp-route-searchString="@Model.SearchString" asp-route-periodId="@Model.PeriodId" asp-route-statusId="@Model.StatusId" asp-route-quickFilter="@Model.QuickFilter" asp-route-sortBy="@Model.SortBy" aria-label="Trang sau"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                }
            </nav>
        }
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kpis-index.css" asp-append-version="true" />
}
