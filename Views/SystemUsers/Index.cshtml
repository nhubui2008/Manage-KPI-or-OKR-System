@using Manage_KPI_or_OKR_System.Models
@model IEnumerable<SystemUser>
@{
    ViewData["Title"] = "Tài khoản Hệ thống";

    var users = Model?.ToList() ?? new List<SystemUser>();
    var roles = ViewBag.Roles as Dictionary<int, string> ?? new Dictionary<int, string>();
    var isAdminRole = User.IsInRole("Admin") || User.IsInRole("Administrator");
    var canCreateUser = isAdminRole || User.HasClaim("Permission", "SYSUSERS_CREATE");
    var canEditUser = isAdminRole || User.HasClaim("Permission", "SYSUSERS_EDIT");
    var canDeleteUser = isAdminRole || User.HasClaim("Permission", "SYSUSERS_DELETE");

    var totalAllUsers = (int)(ViewBag.TotalAllUsers ?? users.Count);
    var activeUserCount = (int)(ViewBag.ActiveUserCount ?? users.Count(u => u.IsActive == true));
    var lockedUserCount = (int)(ViewBag.LockedUserCount ?? (totalAllUsers - activeUserCount));
    var unassignedRoleCount = (int)(ViewBag.UnassignedRoleCount ?? users.Count(u => !u.RoleId.HasValue));

    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? users.Count);
    var pageSize = (int)(ViewBag.PageSize ?? 12);

    var currentSearch = ViewBag.SearchString as string;
    var currentRoleId = ViewBag.RoleId as int?;
    var currentStatus = ViewBag.Status as string;
    var hasFilters = !string.IsNullOrWhiteSpace(currentSearch) || currentRoleId.HasValue || !string.IsNullOrWhiteSpace(currentStatus);
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <style>
        .system-users-page .system-users-header-copy {
            max-width: 680px;
            margin: 0;
            color: var(--evaluation-muted);
            font-size: 0.88rem;
        }

        .system-users-page .system-users-summary {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .system-users-page .system-users-summary article:nth-child(1) strong { color: #4f46e5; }
        .system-users-page .system-users-summary article:nth-child(2) strong { color: #0ab39c; }
        .system-users-page .system-users-summary article:nth-child(3) strong { color: #d97706; }
        .system-users-page .system-users-summary article:nth-child(4) strong { color: #3577f1; }

        /* Filter Toolbar - Single-line perfect horizontal alignment */
        .system-users-page .system-users-filter-form {
            display: flex !important;
            flex-wrap: wrap !important;
            align-items: center !important;
            gap: 0.65rem !important;
            width: 100% !important;
            margin-top: 0.75rem !important;
        }

        .system-users-page .system-users-filter-form label {
            margin: 0 !important;
            display: flex !important;
            align-items: center !important;
            flex-direction: row !important;
            justify-content: flex-start !important;
        }

        .system-users-page .system-users-filter-form label > span {
            display: none !important;
        }

        .system-users-page .system-users-filter-form .evaluation-search-field {
            flex: 2 1 260px !important;
            min-width: 200px !important;
            margin: 0 !important;
        }

        .system-users-page .system-users-filter-form label:not(.evaluation-search-field) {
            flex: 1 1 170px !important;
            min-width: 150px !important;
            margin: 0 !important;
        }

        .system-users-page .system-users-filter-form .evaluation-search-input-wrap {
            position: relative !important;
            display: flex !important;
            align-items: center !important;
            width: 100% !important;
            height: 38px !important;
            margin: 0 !important;
        }

        .system-users-page .system-users-filter-form .evaluation-search-input-wrap i {
            position: absolute !important;
            left: 11px !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            color: #878a99 !important;
            font-size: 0.88rem !important;
            pointer-events: none !important;
            z-index: 2 !important;
            margin: 0 !important;
            line-height: 1 !important;
        }

        .system-users-page .system-users-filter-form .evaluation-search-input-wrap input,
        .system-users-page .system-users-filter-form select,
        .system-users-page .system-users-filter-form .evaluation-secondary-action,
        .system-users-page .system-users-filter-form .evaluation-filter-button {
            height: 38px !important;
            min-height: 38px !important;
            max-height: 38px !important;
            border-radius: 8px !important;
            box-sizing: border-box !important;
            font-size: 0.83rem !important;
            margin: 0 !important;
            vertical-align: middle !important;
            align-self: center !important;
        }

        .system-users-page .system-users-filter-form .evaluation-search-input-wrap input {
            padding: 0 12px 0 34px !important;
            width: 100% !important;
            border: 1px solid #d1d5db !important;
            background: #ffffff !important;
            color: #212529 !important;
            line-height: 36px !important;
        }

        .system-users-page .system-users-filter-form select {
            width: 100% !important;
            border: 1px solid #d1d5db !important;
            padding: 0 28px 0 12px !important;
            line-height: 36px !important;
            background-color: #ffffff !important;
        }

        .system-users-page .system-users-filter-form .evaluation-secondary-action,
        .system-users-page .system-users-filter-form .evaluation-filter-button {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.45rem !important;
            padding: 0 1.1rem !important;
            white-space: nowrap !important;
            line-height: 36px !important;
            font-weight: 600 !important;
            cursor: pointer !important;
            flex-shrink: 0 !important;
        }

        .system-users-page .system-users-filter-form .evaluation-secondary-action {
            border: 1px solid #d1d5db !important;
            background: #ffffff !important;
            color: #374151 !important;
        }

        .system-users-page .system-users-filter-form .evaluation-secondary-action:hover {
            background: #f3f4f6 !important;
            border-color: #9ca3af !important;
            color: #111827 !important;
        }

        .system-users-page .system-users-filter-form .evaluation-filter-button {
            background: var(--evaluation-brand, #556ee6) !important;
            border: 1px solid var(--evaluation-brand, #556ee6) !important;
            color: #ffffff !important;
        }

        .system-users-page .system-users-filter-form .evaluation-filter-button:hover {
            background: var(--evaluation-brand-dark, #394da9) !important;
            border-color: var(--evaluation-brand-dark, #394da9) !important;
        }

        /* 1 CARD LỚN CHỨA 12 CARD NHỎ (1 TRANG) */
        .system-users-page .system-users-cards-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.15rem;
            padding: 1.25rem;
        }

        .system-users-page .system-user-grid-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 1.15rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 0.85rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 4px 12px -2px rgba(15, 23, 42, 0.03);
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
            position: relative;
        }

        .system-users-page .system-user-grid-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px -4px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(15, 23, 42, 0.04);
            border-color: #cbd5e1;
        }

        .system-users-page .user-card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.65rem;
        }

        .system-users-page .user-card-profile {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
        }

        .system-users-page .user-card-avatar {
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            border-radius: 10px;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            font-weight: 800;
            box-shadow: 0 2px 6px rgba(99, 102, 241, 0.3);
        }

        .system-users-page .user-card-avatar--admin {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            box-shadow: 0 2px 6px rgba(239, 68, 68, 0.3);
        }

        .system-users-page .user-card-avatar--director {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            box-shadow: 0 2px 6px rgba(139, 92, 246, 0.3);
        }

        .system-users-page .user-card-avatar--manager {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            box-shadow: 0 2px 6px rgba(59, 130, 246, 0.3);
        }

        .system-users-page .user-card-avatar--hr {
            background: linear-gradient(135deg, #0ab39c, #087d6d);
            box-shadow: 0 2px 6px rgba(10, 179, 156, 0.3);
        }

        .system-users-page .user-card-info {
            min-width: 0;
        }

        .system-users-page .user-card-name {
            display: block;
            font-size: 0.92rem;
            font-weight: 800;
            color: #1e293b;
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .system-users-page .user-card-name a {
            color: inherit;
            text-decoration: none;
        }

        .system-users-page .user-card-name a:hover {
            color: var(--evaluation-brand, #556ee6);
        }

        .system-users-page .user-card-id {
            display: inline-block;
            font-size: 0.7rem;
            color: #64748b;
            font-weight: 600;
            margin-top: 0.15rem;
        }

        .system-users-page .user-card-role-badge {
            font-size: 0.7rem;
            font-weight: 750;
            padding: 0.25rem 0.55rem;
            border-radius: 6px;
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .system-users-page .user-card-role-badge--admin {
            background: #fff0ee;
            color: #b42318;
            border-color: #f4c8c3;
        }

        .system-users-page .user-card-body {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0.75rem 0;
            border-top: 1px solid #f1f5f9;
            border-bottom: 1px solid #f1f5f9;
        }

        .system-users-page .user-card-meta-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.76rem;
            color: #475569;
            min-width: 0;
        }

        .system-users-page .user-card-meta-row i {
            color: #94a3b8;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .system-users-page .user-card-meta-row span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .system-users-page .user-card-status-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 0.2rem;
        }

        .system-users-page .user-card-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.35rem;
        }

        .system-users-page .user-card-footer .evaluation-icon-button {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            font-size: 0.82rem;
        }

        .system-users-page .system-users-pagination-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.25rem;
            border-top: 1px solid #e2e8f0;
            background: #f8fafc;
            border-radius: 0 0 12px 12px;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        @@media (max-width: 1350px) {
            .system-users-page .system-users-cards-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 950px) {
            .system-users-page .system-users-cards-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
            .system-users-page .system-users-summary {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 600px) {
            .system-users-page .system-users-cards-grid {
                grid-template-columns: 1fr;
                padding: 0.85rem;
                gap: 0.85rem;
            }

            .system-users-page .system-users-summary {
                grid-template-columns: 1fr;
            }

            .system-users-page .system-users-pagination-row {
                flex-direction: column;
                align-items: stretch;
            }

            .system-users-page .system-users-pagination-row .evaluation-pagination {
                justify-content: center;
            }
        }
    </style>
}

<div class="evaluation-page system-users-page">
    <header class="evaluation-page-header">
        <div>
            <h1>Tài khoản Hệ thống</h1>
            <p class="system-users-header-copy">Quản lý tài khoản đăng nhập, vai trò và trạng thái truy cập của người dùng.</p>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Hệ thống</span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Tài khoản</span>
            </nav>
        </div>
        @if (canCreateUser)
        {
            <a asp-action="Create" class="evaluation-primary-action page-create-action">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Tạo tài khoản</span>
            </a>
        }
    </header>

    <!-- SUMMARY CARDS -->
    <section class="evaluation-summary system-users-summary" aria-label="Tổng quan tài khoản">
        <article>
            <div class="evaluation-summary__icon evaluation-summary__icon--primary">
                <i class="bi bi-people"></i>
            </div>
            <div class="evaluation-summary__content">
                <span>Tổng tài khoản</span>
                <strong>@totalAllUsers</strong>
            </div>
        </article>
        <article>
            <div class="evaluation-summary__icon evaluation-summary__icon--success">
                <i class="bi bi-person-check"></i>
            </div>
            <div class="evaluation-summary__content">
                <span>Đang hoạt động</span>
                <strong>@activeUserCount</strong>
            </div>
        </article>
        <article>
            <div class="evaluation-summary__icon evaluation-summary__icon--warning">
                <i class="bi bi-person-slash"></i>
            </div>
            <div class="evaluation-summary__content">
                <span>Đang bị khóa</span>
                <strong>@lockedUserCount</strong>
            </div>
        </article>
        <article>
            <div class="evaluation-summary__icon evaluation-summary__icon--info">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <div class="evaluation-summary__content">
                <span>Chưa gán vai trò</span>
                <strong>@unassignedRoleCount</strong>
            </div>
        </article>
    </section>

    <!-- FILTER TOOLBAR -->
    <section class="evaluation-filter-panel" aria-labelledby="systemUserFilterHeading">
        <div class="evaluation-filter-heading">
            <div>
                <strong id="systemUserFilterHeading">Tìm kiếm và lọc</strong>
                <span>Thu hẹp danh sách theo tài khoản, vai trò hoặc trạng thái.</span>
            </div>
            @if (hasFilters)
            {
                <a asp-action="Index" class="evaluation-clear-link">
                    <i class="bi bi-x-circle" aria-hidden="true"></i>Xóa bộ lọc
                </a>
            }
        </div>
        <form asp-action="Index" method="get" class="evaluation-filter-form system-users-filter-form">
            <label class="evaluation-search-field">
                <span class="visually-hidden">Tìm kiếm</span>
                <div class="evaluation-search-input-wrap">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" name="searchString" value="@currentSearch" placeholder="Nhập tên đăng nhập hoặc email..." autocomplete="off" />
                </div>
            </label>
            <label>
                <span class="visually-hidden">Vai trò</span>
                <select name="roleId">
                    <option value="">Tất cả vai trò</option>
                    @foreach (var role in roles.OrderBy(role => role.Value))
                    {
                        <option value="@role.Key" selected="@(currentRoleId.HasValue && currentRoleId.Value == role.Key ? "selected" : null)">@role.Value</option>
                    }
                </select>
            </label>
            <label>
                <span class="visually-hidden">Trạng thái</span>
                <select name="status">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active" selected="@(string.Equals(currentStatus, "active", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Đang hoạt động</option>
                    <option value="locked" selected="@(string.Equals(currentStatus, "locked", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Bị khóa</option>
                </select>
            </label>
            <a asp-action="Index" class="evaluation-secondary-action" aria-label="Đặt lại bộ lọc">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                <span>Đặt lại</span>
            </a>
            <button type="submit" class="evaluation-filter-button">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <span>Lọc</span>
            </button>
        </form>
    </section>

    <!-- 1 CARD LỚN CHỨA 12 CARD NHỎ & PHÂN TRANG -->
    <section class="evaluation-results" aria-labelledby="systemUserResultsHeading">
        <div class="evaluation-results-heading">
            <div>
                <strong id="systemUserResultsHeading">Danh sách tài khoản</strong>
                <span class="text-muted small">12 thẻ tài khoản trên mỗi trang</span>
            </div>
            <span>Hiển thị <strong>@users.Count</strong> / <strong>@totalCount</strong> tài khoản (Trang @currentPage/@totalPages)</span>
        </div>

        @if (!users.Any())
        {
            <div class="evaluation-empty" role="status">
                <span class="evaluation-empty-icon"><i class="bi bi-person-x" aria-hidden="true"></i></span>
                <h2>@(hasFilters ? "Không tìm thấy tài khoản phù hợp" : "Chưa có tài khoản hệ thống")</h2>
                <p>@(hasFilters ? "Hãy điều chỉnh từ khóa hoặc bộ lọc để xem thêm kết quả." : "Tạo tài khoản đầu tiên để bắt đầu phân quyền truy cập hệ thống.")</p>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="evaluation-secondary-action">Xóa bộ lọc</a>
                }
                else if (canCreateUser)
                {
                    <a asp-action="Create" class="evaluation-primary-action page-create-action"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Tạo tài khoản</span></a>
                }
            </div>
        }
        else
        {
            <!-- GRID 12 CARD NHỎ TRONG 1 CARD LỚN -->
            <div class="system-users-cards-grid">
                @foreach (var user in users)
                {
                    var roleName = user.RoleId.HasValue && roles.TryGetValue(user.RoleId.Value, out var assignedRoleName) ? assignedRoleName : "Chưa phân quyền";
                    var isAdminUser = string.Equals(roleName, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(roleName, "Administrator", StringComparison.OrdinalIgnoreCase);
                    var isDirector = string.Equals(roleName, "Director", StringComparison.OrdinalIgnoreCase) || string.Equals(roleName, "Giám đốc", StringComparison.OrdinalIgnoreCase);
                    var isManager = string.Equals(roleName, "Manager", StringComparison.OrdinalIgnoreCase) || string.Equals(roleName, "Quản lý", StringComparison.OrdinalIgnoreCase) || string.Equals(roleName, "Trưởng phòng", StringComparison.OrdinalIgnoreCase);
                    var isHR = string.Equals(roleName, "HR", StringComparison.OrdinalIgnoreCase) || string.Equals(roleName, "Nhân sự", StringComparison.OrdinalIgnoreCase);
                    var avatarClass = isAdminUser ? "user-card-avatar--admin" : isDirector ? "user-card-avatar--director" : isManager ? "user-card-avatar--manager" : isHR ? "user-card-avatar--hr" : string.Empty;
                    var isActive = user.IsActive == true;
                    var displayName = string.IsNullOrWhiteSpace(user.Username) ? $"Tài khoản #{user.Id}" : user.Username;
                    var initial = !string.IsNullOrWhiteSpace(user.Username) ? user.Username[0].ToString().ToUpperInvariant() : "U";

                    <article class="system-user-grid-card">
                        <div class="user-card-header">
                            <div class="user-card-profile">
                                <div class="user-card-avatar @avatarClass" aria-hidden="true">@initial</div>
                                <div class="user-card-info">
                                    <strong class="user-card-name" title="@displayName">
                                        <a asp-action="Details" asp-route-id="@user.Id">@displayName</a>
                                    </strong>
                                    <span class="user-card-id">ID: @user.Id</span>
                                </div>
                            </div>
                            <span class="user-card-role-badge @(isAdminUser ? "user-card-role-badge--admin" : "")">@roleName</span>
                        </div>

                        <div class="user-card-body">
                            <div class="user-card-meta-row" title="@user.Email">
                                <i class="bi bi-envelope" aria-hidden="true"></i>
                                <span>@(string.IsNullOrWhiteSpace(user.Email) ? "Chưa có email" : user.Email)</span>
                            </div>
                            <div class="user-card-meta-row">
                                <i class="bi bi-calendar3" aria-hidden="true"></i>
                                <span>@(user.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xác định")</span>
                            </div>
                            <div class="user-card-status-row">
                                <span class="evaluation-status @(isActive ? "evaluation-status--running" : "evaluation-status--closed")">
                                    <span aria-hidden="true"></span>@(isActive ? "Đang hoạt động" : "Bị khóa")
                                </span>
                            </div>
                        </div>

                        <div class="user-card-footer">
                            <a asp-action="Details" asp-route-id="@user.Id" class="evaluation-icon-button" title="Xem chi tiết" aria-label="Xem chi tiết tài khoản @displayName">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            @if (canEditUser && (isAdminRole || !isAdminUser))
                            {
                                <a asp-action="Edit" asp-route-id="@user.Id" class="evaluation-icon-button" title="Chỉnh sửa" aria-label="Chỉnh sửa tài khoản @displayName">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </a>
                                <form asp-action="ToggleLock" method="post" data-app-confirm
                                      data-confirm-title="@(isActive ? "Khóa tài khoản?" : "Mở khóa tài khoản?")"
                                      data-confirm-message="@(isActive ? $"Tài khoản “{displayName}” sẽ không thể đăng nhập cho đến khi được mở khóa." : $"Tài khoản “{displayName}” sẽ được phép đăng nhập trở lại.")"
                                      data-confirm-tone="@(isActive ? "warning" : "info")"
                                      data-confirm-label="@(isActive ? "Khóa tài khoản" : "Mở khóa")">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="evaluation-icon-button @(isActive ? "evaluation-icon-button--danger" : string.Empty)" title="@(isActive ? "Khóa tài khoản" : "Mở khóa tài khoản")" aria-label="@(isActive ? $"Khóa tài khoản {displayName}" : $"Mở khóa tài khoản {displayName}")">
                                        <i class="bi @(isActive ? "bi-lock" : "bi-unlock")" aria-hidden="true"></i>
                                    </button>
                                </form>
                                <a asp-action="ResetPassword" asp-route-id="@user.Id" class="evaluation-icon-button" title="Đặt lại mật khẩu" aria-label="Đặt lại mật khẩu cho @displayName">
                                    <i class="bi bi-key" aria-hidden="true"></i>
                                </a>
                            }
                            @if (canDeleteUser && (isAdminRole || !isAdminUser))
                            {
                                <a asp-action="Delete" asp-route-id="@user.Id" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa tài khoản" aria-label="Xóa tài khoản @displayName">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>

            <!-- PHÂN TRANG -->
            @if (totalPages > 1)
            {
                <div class="system-users-pagination-row">
                    <p class="mb-0 text-muted small">
                        Hiển thị <strong>@(((currentPage - 1) * pageSize) + 1)</strong> - <strong>@(Math.Min(currentPage * pageSize, totalCount))</strong> trên tổng số <strong>@totalCount</strong> tài khoản
                    </p>
                    <nav class="evaluation-pagination" aria-label="Phân trang danh sách tài khoản">
                        @if (currentPage > 1)
                        {
                            <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentSearch" asp-route-roleId="@currentRoleId" asp-route-status="@currentStatus" aria-label="Trang trước"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                        }

                        @for (var p = 1; p <= totalPages; p++)
                        {
                            if (p == 1 || p == totalPages || (p >= currentPage - 2 && p <= currentPage + 2))
                            {
                                <a asp-action="Index" asp-route-page="@p" asp-route-searchString="@currentSearch" asp-route-roleId="@currentRoleId" asp-route-status="@currentStatus" class="@(p == currentPage ? "is-current" : string.Empty)" aria-current="@(p == currentPage ? "page" : null)">@p</a>
                            }
                            else if (p == currentPage - 3 || p == currentPage + 3)
                            {
                                <span class="is-disabled" aria-hidden="true">…</span>
                            }
                        }

                        @if (currentPage < totalPages)
                        {
                            <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentSearch" asp-route-roleId="@currentRoleId" asp-route-status="@currentStatus" aria-label="Trang sau"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                        }
                    </nav>
                </div>
            }
        }
    </section>
</div>
