@using Manage_KPI_or_OKR_System.Models
@model IEnumerable<SystemUser>
@{
    ViewData["Title"] = "Tài khoản Hệ thống";
    var roles = ViewBag.Roles as Dictionary<int, string> ?? new Dictionary<int, string>();
}

@section Styles {
    <style>
        .systemusers-mobile-list {
            display: none;
        }

        .systemusers-mobile-card {
            padding: 1rem;
            border-radius: 16px;
            display: grid;
            gap: 0.8rem;
        }

        .systemusers-mobile-card__title {
            margin: 0;
            font-size: 1rem;
            font-weight: 800;
            color: #172033;
        }

        .systemusers-mobile-card__actions {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.55rem;
        }

        .systemusers-mobile-card__actions .btn {
            min-height: 42px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.88rem;
            padding-inline: 0.45rem;
        }

        @@media (max-width: 767.98px) {
            .systemusers-page .table-responsive {
                display: none;
            }

            .systemusers-mobile-list {
                display: grid;
                gap: 0.9rem;
                margin-top: 0.75rem;
            }
        }
    </style>
}

<div class="container-fluid px-0 systemusers-page">
    
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 font-weight-bold mb-1">Tài khoản Hệ thống</h1>
        <div class="page-breadcrumb">
            <a href="/" class="text-dark text-decoration-none opacity-75">Trang chủ</a>
            <i class="bi bi-chevron-right separator"></i>
            <span class="text-dark opacity-75">Hệ thống</span>
            <i class="bi bi-chevron-right separator"></i>
            <span class="text-dark fw-bold">Tài khoản users</span>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Create" class="btn-primary-custom text-decoration-none">
            <i class="bi bi-person-plus-fill me-1"></i> Tạo tài khoản mới
        </a>
    </div>
</div>

<div class="row justify-content-center w-100 m-0">
        <div class="col-12 px-0">
            <div class="content-card w-100">
    <div class="card-body-custom">
        <form asp-action="Index" method="get" class="toolbar">
            <div class="toolbar-left">
                <div class="toolbar-search" style="max-width: 300px;">
                    <i class="bi bi-search"></i>
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm tên đăng nhập, email..." />
                </div>
            </div>
            <div class="toolbar-right d-flex align-items-center gap-2">
                <select name="roleId" class="filter-select">
                    <option value="">Phân quyền (Role)</option>
                    @foreach (var role in roles)
                    {
                        if (ViewBag.RoleId != null && ViewBag.RoleId == role.Key)
                        {
                            <option value="@role.Key" selected>@role.Value</option>
                        }
                        else
                        {
                            <option value="@role.Key">@role.Value</option>
                        }
                    }
                </select>
                <select name="status" class="filter-select">
                    <option value="">Trạng thái tài khoản</option>
                    @if(ViewBag.Status == "active") { <option value="active" selected>Đang hoạt động</option> } else { <option value="active">Đang hoạt động</option> }
                    @if(ViewBag.Status == "locked") { <option value="locked" selected>Bị khóa</option> } else { <option value="locked">Bị khóa</option> }
                </select>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary border-0 text-muted" title="Làm mới">
                    <i class="bi bi-arrow-clockwise fs-5"></i>
                </a>
                <button type="submit" class="btn-primary-custom d-flex align-items-center gap-2" style="padding: 8px;">
                    <i class="bi bi-funnel"></i> <span>Lọc</span>
                </button>
            </div>
        </form>

        <div class="table-responsive w-100">
            <table class="data-table w-100">
                <thead>
                    <tr>
                        <th>Tài khoản</th>
                        <th>Thông tin Email</th>
                        <th>Phân quyền</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            var roleName = user.RoleId.HasValue && roles.ContainsKey(user.RoleId.Value) ? roles[user.RoleId.Value] : "N/A";
                            var statusClass = user.IsActive == true ? "active" : "pending";
                            var statusDot = user.IsActive == true ? "" : "text-danger bg-danger";
                            var statusText = user.IsActive == true ? "Kích hoạt" : "Bị khóa";
                            
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@user.Username</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">ID: @user.Id</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="user-avatar" style="width: 28px; height: 28px; font-size: 0.7rem;">
                                            @(user.Username?[0].ToString().ToUpper() ?? "U")
                                        </div>
                                        <div>
                                            <div class="text-muted" style="font-size: 0.85rem;">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var badgeClass = roleName.ToLower() == "admin" ? "bg-danger text-white" : "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25";
                                    }
                                    <span class="badge @badgeClass rounded-pill px-3">@roleName</span>
                                </td>
                                <td class="text-muted" style="font-size: 0.85rem;">@(user.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))</td>
                                <td>
                                    <span class="status-badge @statusClass">
                                        <span class="status-dot @statusDot"></span> @statusText
                                    </span>
                                </td>
                                <td>
                                    <div class="action-btns justify-content-end">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="action-btn" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="action-btn" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                                        
                                        <form asp-action="ToggleLock" method="post" class="d-inline m-0">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.IsActive == false)
                                            {
                                                <button type="submit" class="action-btn" title="Mở khóa tài khoản"><i class="bi bi-unlock-fill"></i></button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="action-btn danger" title="Khóa tài khoản"><i class="bi bi-lock-fill"></i></button>
                                            }
                                        </form>

                                        <a asp-action="ResetPassword" asp-route-id="@user.Id" class="action-btn" title="Đổi mật khẩu"><i class="bi bi-key"></i></a>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="action-btn danger" title="Xóa tài khoản"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>


                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Không có dữ liệu tài khoản nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="systemusers-mobile-list">
            @if (Model != null && Model.Any())
            {
                foreach (var user in Model)
                {
                    var roleName = user.RoleId.HasValue && roles.ContainsKey(user.RoleId.Value) ? roles[user.RoleId.Value] : "N/A";
                    var statusClass = user.IsActive == true ? "active" : "pending";
                    var statusDot = user.IsActive == true ? "" : "text-danger bg-danger";
                    var statusText = user.IsActive == true ? "Kích hoạt" : "Bị khóa";
                    var badgeClass = roleName.ToLower() == "admin" ? "bg-danger text-white" : "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25";

                    <article class="content-card systemusers-mobile-card">
                        <div class="d-flex align-items-start gap-3">
                            <div class="user-avatar" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                @(user.Username?[0].ToString().ToUpper() ?? "U")
                            </div>
                            <div class="min-w-0 flex-grow-1">
                                <h3 class="systemusers-mobile-card__title">@user.Username</h3>
                                <div class="small text-muted">ID: @user.Id</div>
                                <div class="small text-muted mt-1">@(string.IsNullOrWhiteSpace(user.Email) ? "Chưa có email" : user.Email)</div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="badge @badgeClass rounded-pill px-3">@roleName</span>
                            <span class="status-badge @statusClass"><span class="status-dot @statusDot"></span> @statusText</span>
                        </div>

                        <div class="small text-muted">Tạo lúc: @(user.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))</div>

                        <div class="systemusers-mobile-card__actions">
                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-outline-primary">
                                <i class="bi bi-eye me-1"></i> Xem
                            </a>
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i> Sửa
                            </a>
                            <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-warning">
                                <i class="bi bi-key me-1"></i> Mật khẩu
                            </a>
                        </div>

                        <div class="systemusers-mobile-card__actions">
                            <form asp-action="ToggleLock" method="post" class="m-0">
                                <input type="hidden" name="userId" value="@user.Id" />
                                @if (user.IsActive == false)
                                {
                                    <button type="submit" class="btn btn-outline-success w-100"><i class="bi bi-unlock-fill me-1"></i> Mở khóa</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-lock-fill me-1"></i> Khóa</button>
                                }
                            </form>
                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash me-1"></i> Xóa
                            </a>
                            <span></span>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</div>

        </div>
    </div>
</div>
