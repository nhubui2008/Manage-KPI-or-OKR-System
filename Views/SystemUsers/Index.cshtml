@using Manage_KPI_or_OKR_System.Models
@model IEnumerable<SystemUser>
@{
    ViewData["Title"] = "Tài khoản Hệ thống";

    var users = Model?.ToList() ?? new List<SystemUser>();
    var roles = ViewBag.Roles as Dictionary<int, string> ?? new Dictionary<int, string>();
    var isAdminRole = User.IsInRole("Admin") || User.IsInRole("Administrator");
    var canCreateUser = isAdminRole || User.HasClaim("Permission", "SYSUSERS_CREATE");
    var canEditUser = isAdminRole || User.HasClaim("Permission", "SYSUSERS_EDIT");
    var canDeleteUser = isAdminRole || User.HasClaim("Permission", "SYSUSERS_DELETE");
    var activeUserCount = users.Count(user => user.IsActive == true);
    var lockedUserCount = users.Count - activeUserCount;
    var unassignedRoleCount = users.Count(user => !user.RoleId.HasValue || !roles.ContainsKey(user.RoleId.Value));
    var hasFilters = !string.IsNullOrWhiteSpace(ViewBag.SearchString as string) || ViewBag.RoleId != null || !string.IsNullOrWhiteSpace(ViewBag.Status as string);
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
    <style>
        .system-users-page .system-users-header-copy {
            max-width: 680px;
            margin: 0;
            color: var(--evaluation-muted);
            font-size: 0.88rem;
        }

        .system-users-page .system-users-summary {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .system-users-page .system-users-summary article:nth-child(1) strong { color: #1d4ed8; }
        .system-users-page .system-users-summary article:nth-child(2) strong { color: #087466; }
        .system-users-page .system-users-summary article:nth-child(3) strong { color: #b42318; }
        .system-users-page .system-users-summary article:nth-child(4) strong { color: #6b6478; }

        .system-users-page .system-users-filter-form {
            grid-template-columns: minmax(240px, 1.6fr) minmax(180px, 0.8fr) minmax(180px, 0.8fr) auto auto;
        }

        .system-users-page .system-users-table {
            min-width: 930px;
        }

        .system-users-page .system-user-identity {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            min-width: 180px;
        }

        .system-users-page .system-user-avatar {
            display: inline-grid;
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
            place-items: center;
            border-radius: 8px;
            background: var(--evaluation-brand-soft);
            color: var(--evaluation-brand);
            font-size: 0.8rem;
            font-weight: 800;
        }

        .system-users-page .system-user-identity strong,
        .system-users-page .system-user-identity small {
            display: block;
        }

        .system-users-page .system-user-identity strong {
            font-size: 0.9rem;
        }

        .system-users-page .system-user-identity small,
        .system-users-page .system-user-email,
        .system-users-page .system-user-created {
            color: var(--evaluation-muted);
            font-size: 0.78rem;
        }

        .system-users-page .system-user-email {
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .system-users-page .system-user-role {
            display: inline-flex;
            align-items: center;
            min-height: 28px;
            border: 1px solid var(--evaluation-line);
            border-radius: 7px;
            padding: 0.3rem 0.55rem;
            background: var(--evaluation-soft);
            color: #475467;
            font-size: 0.72rem;
            font-weight: 750;
            white-space: nowrap;
        }

        .system-users-page .system-user-role--admin {
            border-color: #f4c8c3;
            background: #fff0ee;
            color: #b42318;
        }

        .system-users-page .system-user-card .evaluation-actions {
            flex-wrap: wrap;
        }

        .system-users-page .system-user-card .evaluation-card-footer {
            align-items: flex-end;
        }

        .system-users-page .system-user-card .evaluation-card-footer > a {
            white-space: nowrap;
        }

        @@media (max-width: 1100px) {
            .system-users-page .system-users-filter-form {
                grid-template-columns: 1fr 1fr;
            }

            .system-users-page .system-users-filter-form .evaluation-search-field {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 900px) {
            .system-users-page .system-users-summary {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .system-users-page .system-users-summary article:last-child {
                grid-column: auto;
            }
        }

        @@media (max-width: 575.98px) {
            .system-users-page .system-users-filter-form {
                grid-template-columns: 1fr;
            }

            .system-users-page .system-users-filter-form .evaluation-search-field {
                grid-column: auto;
            }

            .system-users-page .system-users-filter-form .evaluation-secondary-action,
            .system-users-page .system-users-filter-form .evaluation-filter-button {
                width: 100%;
            }

            .system-users-page .system-user-card .evaluation-card-footer {
                display: grid;
            }

            .system-users-page .system-user-card .evaluation-card-footer > a {
                justify-self: start;
            }
        }
    </style>
}

<div class="evaluation-page system-users-page">
    <header class="evaluation-page-header">
        <div>
            <h1>Tài khoản Hệ thống</h1>
            <p class="system-users-header-copy">Quản lý tài khoản đăng nhập, vai trò và trạng thái truy cập của người dùng.</p>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Hệ thống</span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span>Tài khoản</span>
            </nav>
        </div>
        @if (canCreateUser)
        {
            <a asp-action="Create" class="evaluation-primary-action">
                <i class="bi bi-person-plus" aria-hidden="true"></i>
                <span>Tạo tài khoản</span>
            </a>
        }
    </header>

    <section class="evaluation-summary system-users-summary" aria-label="Tổng quan tài khoản">
        <article>
            <span>Tổng tài khoản</span>
            <strong>@users.Count</strong>
            <small>Theo bộ lọc hiện tại</small>
        </article>
        <article>
            <span>Đang hoạt động</span>
            <strong>@activeUserCount</strong>
            <small>Có thể đăng nhập</small>
        </article>
        <article>
            <span>Đang bị khóa</span>
            <strong>@lockedUserCount</strong>
            <small>Tạm ngừng truy cập</small>
        </article>
        <article>
            <span>Chưa gán vai trò</span>
            <strong>@unassignedRoleCount</strong>
            <small>Cần kiểm tra quyền hạn</small>
        </article>
    </section>

    <section class="evaluation-filter-panel" aria-labelledby="systemUserFilterHeading">
        <div class="evaluation-filter-heading">
            <div>
                <strong id="systemUserFilterHeading">Tìm kiếm và lọc</strong>
                <span>Thu hẹp danh sách theo tài khoản, vai trò hoặc trạng thái.</span>
            </div>
            @if (hasFilters)
            {
                <a asp-action="Index" class="evaluation-clear-link">
                    <i class="bi bi-x-circle" aria-hidden="true"></i>Xóa bộ lọc
                </a>
            }
        </div>
        <form asp-action="Index" method="get" class="evaluation-filter-form system-users-filter-form">
            <label class="evaluation-search-field">
                <span>Tài khoản hoặc email</span>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="searchString" value="@ViewBag.SearchString" placeholder="Nhập tên đăng nhập hoặc email" />
            </label>
            <label>
                <span>Vai trò</span>
                <select name="roleId">
                    <option value="">Tất cả vai trò</option>
                    @foreach (var role in roles.OrderBy(role => role.Value))
                    {
                        <option value="@role.Key" selected="@(ViewBag.RoleId != null && ViewBag.RoleId == role.Key ? "selected" : null)">@role.Value</option>
                    }
                </select>
            </label>
            <label>
                <span>Trạng thái</span>
                <select name="status">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active" selected="@(ViewBag.Status == "active" ? "selected" : null)">Đang hoạt động</option>
                    <option value="locked" selected="@(ViewBag.Status == "locked" ? "selected" : null)">Bị khóa</option>
                </select>
            </label>
            <a asp-action="Index" class="evaluation-secondary-action" aria-label="Đặt lại bộ lọc">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Đặt lại
            </a>
            <button type="submit" class="evaluation-filter-button">
                <i class="bi bi-funnel" aria-hidden="true"></i>Lọc
            </button>
        </form>
    </section>

    <section class="evaluation-results" aria-labelledby="systemUserResultsHeading">
        <div class="evaluation-results-heading">
            <strong id="systemUserResultsHeading">Danh sách tài khoản</strong>
            <span>@users.Count tài khoản được hiển thị</span>
        </div>

        @if (!users.Any())
        {
            <div class="evaluation-empty" role="status">
                <span class="evaluation-empty-icon"><i class="bi bi-person-x" aria-hidden="true"></i></span>
                <h2>@(hasFilters ? "Không tìm thấy tài khoản phù hợp" : "Chưa có tài khoản hệ thống")</h2>
                <p>@(hasFilters ? "Hãy điều chỉnh từ khóa hoặc bộ lọc để xem thêm kết quả." : "Tạo tài khoản đầu tiên để bắt đầu phân quyền truy cập hệ thống.")</p>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="evaluation-secondary-action">Xóa bộ lọc</a>
                }
                else if (canCreateUser)
                {
                    <a asp-action="Create" class="evaluation-primary-action">Tạo tài khoản</a>
                }
            </div>
        }
        else
        {
            <div class="evaluation-table-shell">
                <table class="evaluation-table system-users-table" aria-label="Danh sách tài khoản hệ thống">
                    <thead>
                        <tr>
                            <th>Tài khoản</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            var roleName = user.RoleId.HasValue && roles.TryGetValue(user.RoleId.Value, out var assignedRoleName) ? assignedRoleName : "Chưa phân quyền";
                            var isAdminUser = string.Equals(roleName, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(roleName, "Administrator", StringComparison.OrdinalIgnoreCase);
                            var isActive = user.IsActive == true;
                            var displayName = string.IsNullOrWhiteSpace(user.Username) ? $"Tài khoản #{user.Id}" : user.Username;
                            var initial = !string.IsNullOrWhiteSpace(user.Username) ? user.Username[0].ToString().ToUpperInvariant() : "U";
                            <tr>
                                <td>
                                    <div class="system-user-identity">
                                        <span class="system-user-avatar" aria-hidden="true">@initial</span>
                                        <div>
                                            <strong>@displayName</strong>
                                            <small>ID: @user.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td><div class="system-user-email" title="@user.Email">@(string.IsNullOrWhiteSpace(user.Email) ? "Chưa có email" : user.Email)</div></td>
                                <td><span class="system-user-role @(isAdminUser ? "system-user-role--admin" : string.Empty)">@roleName</span></td>
                                <td><span class="system-user-created">@(user.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xác định")</span></td>
                                <td>
                                    <span class="evaluation-status @(isActive ? "evaluation-status--running" : "evaluation-status--closed")">
                                        <span aria-hidden="true"></span>@(isActive ? "Đang hoạt động" : "Bị khóa")
                                    </span>
                                </td>
                                <td>
                                    <div class="evaluation-actions">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="evaluation-icon-button" title="Xem chi tiết" aria-label="Xem chi tiết tài khoản @displayName">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        @if (canEditUser && (isAdminRole || !isAdminUser))
                                        {
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="evaluation-icon-button" title="Chỉnh sửa" aria-label="Chỉnh sửa tài khoản @displayName">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                            </a>
                                            <form asp-action="ToggleLock" method="post" data-app-confirm
                                                  data-confirm-title="@(isActive ? "Khóa tài khoản?" : "Mở khóa tài khoản?")"
                                                  data-confirm-message="@(isActive ? $"Tài khoản “{displayName}” sẽ không thể đăng nhập cho đến khi được mở khóa." : $"Tài khoản “{displayName}” sẽ được phép đăng nhập trở lại.")"
                                                  data-confirm-tone="@(isActive ? "warning" : "info")"
                                                  data-confirm-label="@(isActive ? "Khóa tài khoản" : "Mở khóa")">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="evaluation-icon-button @(isActive ? "evaluation-icon-button--danger" : string.Empty)" title="@(isActive ? "Khóa tài khoản" : "Mở khóa tài khoản")" aria-label="@(isActive ? $"Khóa tài khoản {displayName}" : $"Mở khóa tài khoản {displayName}")">
                                                    <i class="bi @(isActive ? "bi-lock" : "bi-unlock")" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                            <a asp-action="ResetPassword" asp-route-id="@user.Id" class="evaluation-icon-button" title="Đặt lại mật khẩu" aria-label="Đặt lại mật khẩu cho @displayName">
                                                <i class="bi bi-key" aria-hidden="true"></i>
                                            </a>
                                        }
                                        @if (canDeleteUser && (isAdminRole || !isAdminUser))
                                        {
                                            <a asp-action="Delete" asp-route-id="@user.Id" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa tài khoản" aria-label="Xóa tài khoản @displayName">
                                                <i class="bi bi-trash3" aria-hidden="true"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="evaluation-mobile-list">
                @foreach (var user in users)
                {
                    var roleName = user.RoleId.HasValue && roles.TryGetValue(user.RoleId.Value, out var assignedRoleName) ? assignedRoleName : "Chưa phân quyền";
                    var isAdminUser = string.Equals(roleName, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(roleName, "Administrator", StringComparison.OrdinalIgnoreCase);
                    var isActive = user.IsActive == true;
                    var displayName = string.IsNullOrWhiteSpace(user.Username) ? $"Tài khoản #{user.Id}" : user.Username;
                    <article class="evaluation-period-card system-user-card">
                        <div class="evaluation-card-topline">
                            <span class="evaluation-status @(isActive ? "evaluation-status--running" : "evaluation-status--closed")"><span aria-hidden="true"></span>@(isActive ? "Đang hoạt động" : "Bị khóa")</span>
                            <span class="system-user-role">@roleName</span>
                        </div>
                        <h2>@displayName</h2>
                        <p>@(string.IsNullOrWhiteSpace(user.Email) ? "Chưa có email" : user.Email)</p>
                        <dl>
                            <div><dt>Mã tài khoản</dt><dd>#@user.Id</dd></div>
                            <div><dt>Ngày tạo</dt><dd>@(user.CreatedAt?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</dd></div>
                        </dl>
                        <div class="evaluation-card-footer">
                            <a asp-action="Details" asp-route-id="@user.Id">Xem chi tiết</a>
                            <div class="evaluation-actions">
                                @if (canEditUser && (isAdminRole || !isAdminUser))
                                {
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="evaluation-icon-button" aria-label="Chỉnh sửa tài khoản @displayName trên thẻ di động"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                                    <form asp-action="ToggleLock" method="post" data-app-confirm
                                          data-confirm-title="@(isActive ? "Khóa tài khoản?" : "Mở khóa tài khoản?")"
                                          data-confirm-message="@(isActive ? $"Tài khoản “{displayName}” sẽ không thể đăng nhập cho đến khi được mở khóa." : $"Tài khoản “{displayName}” sẽ được phép đăng nhập trở lại.")"
                                          data-confirm-tone="@(isActive ? "warning" : "info")"
                                          data-confirm-label="@(isActive ? "Khóa tài khoản" : "Mở khóa")">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="evaluation-icon-button @(isActive ? "evaluation-icon-button--danger" : string.Empty)" aria-label="@(isActive ? $"Khóa tài khoản {displayName}" : $"Mở khóa tài khoản {displayName}") trên thẻ di động">
                                            <i class="bi @(isActive ? "bi-lock" : "bi-unlock")" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="evaluation-icon-button" aria-label="Đặt lại mật khẩu cho @displayName trên thẻ di động"><i class="bi bi-key" aria-hidden="true"></i></a>
                                }
                                @if (canDeleteUser && (isAdminRole || !isAdminUser))
                                {
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="evaluation-icon-button evaluation-icon-button--danger" aria-label="Xóa tài khoản @displayName trên thẻ di động"><i class="bi bi-trash3" aria-hidden="true"></i></a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
