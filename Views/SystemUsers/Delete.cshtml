@model Manage_KPI_or_OKR_System.Models.SystemUser

@{
    ViewData["Title"] = "Gỡ quyền truy cập";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roles = ViewBag.Roles as Dictionary<int, string> ?? new Dictionary<int, string>();
    var roleName = Model.RoleId.HasValue && roles.ContainsKey(Model.RoleId.Value) ? roles[Model.RoleId.Value] : "N/A";
}

<div class="container-fluid px-3 px-md-4 py-4 system-user-delete-page">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden mt-md-4">
                <div class="card-header bg-warning text-dark py-4 d-flex flex-column align-items-center text-center">
                    <div class="bg-white text-danger rounded-circle d-flex justify-content-center align-items-center mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    </div>
                    <h1 class="h3 fw-bold mb-0">Gỡ quyền truy cập tenant?</h1>
                    <p class="mb-0 mt-1">Tài khoản và dữ liệu lịch sử vẫn được giữ lại.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <div class="alert alert-warning border-warning border-opacity-50 text-dark mb-4 p-3 rounded-3" role="alert">
                        <i class="bi bi-info-circle-fill me-2 text-warning"></i>
                        <strong>Lưu ý:</strong> Người dùng sẽ mất quyền truy cập tenant hiện tại.
                        Thao tác này không xóa global identity và không ảnh hưởng membership ở tenant khác.
                    </div>

                    <div class="border rounded-3 p-3 mb-4 bg-light text-center">
                        <h5 class="fw-bold mb-1">@Model.Username</h5>
                        <div class="text-muted small mb-2">@Model.Email</div>
                        <span class="badge bg-secondary rounded-pill px-3">Role: @roleName</span>
                    </div>

                    <form asp-action="Delete" method="post" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex flex-column gap-3">
                            <button type="submit" class="btn btn-warning btn-lg rounded-pill fw-bold w-100 shadow-sm hover-elevate">
                                <i class="bi bi-person-dash me-2"></i> Xác nhận gỡ quyền tenant
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold w-100">
                                Quay lại Danh sách an toàn
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media (max-width: 575.98px) {
        .system-user-delete-page .card-header { padding: 1.5rem 1rem !important; }
        .system-user-delete-page .card-body { padding: 1.25rem !important; }
        .system-user-delete-page .btn { min-height: 48px; white-space: normal; }
    }
</style>
