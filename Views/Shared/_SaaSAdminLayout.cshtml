@inject Manage_KPI_or_OKR_System.Services.ISystemSettingsService SystemSettingsService
@{
    var appBranding = await SystemSettingsService.GetBrandingAsync();
    var canonicalUrl = Manage_KPI_or_OKR_System.Helpers.SeoHelper.GetCanonicalUrl(ViewContext, appBranding.PublicBaseUrl);
    var seoImageUrl = appBranding.SeoImageUrl;
    if (!string.IsNullOrWhiteSpace(seoImageUrl) && !seoImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
    {
        seoImageUrl = $"{appBranding.PublicBaseUrl}{(seoImageUrl.StartsWith("/") ? seoImageUrl : "/" + seoImageUrl)}";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | @appBranding.ProductName</title>
    <link rel="icon" href="@appBranding.FaviconUrl" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Manage-KPI-or-OKR-System.styles.css" asp-append-version="true" />
    
    <style id="brand-theme">
        :root {
            --color-brand-violet: #7b68ee;
            --color-signal-blue: #0091ff;
            --color-ultra-violet: #6647f0;
            --color-muted-violet: #514b81;
            --color-midnight-ink: #090c1d;
            --color-charcoal: #292d34;
            --color-carbon: #202023;
            --color-slate: #646464;
            --color-steel: #7c828d;
            --color-mist: #d9d9d9;
            --color-cloud: #e8e8e8;
            --color-paper: #f8f9fa;
            --color-frost: #edf6fd;
            --font-plus-jakarta-sans: 'Plus Jakarta Sans', 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --font-inter: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --primary: @appBranding.PrimaryColor;
            --primary-dark: @appBranding.PrimaryDarkColor;
            --primary-darker: @appBranding.PrimaryDarkColor;
            --primary-light: color-mix(in srgb, @appBranding.PrimaryColor 12%, #ffffff);
            --primary-bg: color-mix(in srgb, @appBranding.PrimaryColor 8%, transparent);
            --info: @appBranding.PrimaryColor;
            --info-bg: color-mix(in srgb, @appBranding.PrimaryColor 12%, #ffffff);
            --sidebar-bg: #ffffff;
            --sidebar-bg-solid: #ffffff;
            --sidebar-text: #292d34;
            --sidebar-text-active: #090c1d;
            --body-bg: @appBranding.BodyBackgroundColor;
            --card-bg: @appBranding.CardBackgroundColor;
        }
    </style>

    <script>
        (function() {
            const sidebarState = localStorage.getItem('sidebarState');
            const desktopDefault = window.matchMedia('(min-width: 992px)').matches;
            if (sidebarState === 'expanded' || (sidebarState === null && desktopDefault)) {
                document.documentElement.classList.add('sidebar-expanded');
            } else {
                document.documentElement.classList.remove('sidebar-expanded');
            }
        })();
    </script>
</head>
<body>
    <div class="app-blob-container">
        <div class="app-blob app-blob-1"></div>
        <div class="app-blob app-blob-2"></div>
        <div class="app-blob app-blob-3"></div>
    </div>
    
    <form id="globalAntiForgeryForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>
    
    <div class="app-wrapper">
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-hexagon-fill text-primary"></i>
                </div>
                <div class="brand-info">
                    <div class="brand-text">Admin</div>
                    <div class="brand-sub">Quản trị hệ thống</div>
                </div>
            </div>

            <div class="sidebar-nav">
                <div class="sidebar-group">
                    <div class="sidebar-group-label">Overview</div>
                    <a href="/Dashboard/Index" class="sidebar-link">
                        <i class="bi bi-layout-sidebar-inset"></i> <span>Hệ thống vận hành</span>
                    </a>
                    <a href="/SaaSAdmin" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i> <span>Dashboard</span>
                    </a>
                </div>

                <div class="sidebar-group">
                    <div class="sidebar-group-label">Quản lý Khách Hàng</div>
                    <a href="/SaaSAdmin/Registrations" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Registrations" ? "active" : "")">
                        <i class="bi bi-people-fill"></i> <span>Khách hàng & Đăng ký</span>
                    </a>
                    <a href="/SaaSAdmin/Packages" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Packages" ? "active" : "")">
                        <i class="bi bi-boxes"></i> <span>Quản lý Gói Dịch Vụ</span>
                    </a>
                </div>

                <div class="sidebar-group">
                    <div class="sidebar-group-label">Báo cáo & Tài chính</div>
                    <a href="/SaaSAdmin/Revenue" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Revenue" ? "active" : "")">
                        <i class="bi bi-graph-up-arrow"></i> <span>Báo cáo doanh thu</span>
                    </a>
                    <a href="/SaaSAdmin/PaymentHistory" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "PaymentHistory" ? "active" : "")">
                        <i class="bi bi-receipt"></i> <span>Lịch sử thanh toán</span>
                    </a>
                </div>

            </div>

            <div class="sidebar-footer dropup">
                <button type="button" class="sidebar-settings-trigger" data-settings-panel-trigger aria-controls="settingsPanel" aria-expanded="false">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span>Cài đặt</span>
                </button>
                <div class="sidebar-user" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                    <div class="user-avatar" style="background: var(--primary);">
                        <span>AD</span>
                    </div>
                    <div class="user-info">
                        <div class="user-name">Admin</div>
                        <div class="user-role">Admin</div>
                    </div>
                    <i class="bi bi-three-dots-vertical ms-auto user-dots" style="color: rgba(255,255,255,0.4);"></i>
                </div>
                
                <ul class="dropdown-menu shadow-sm border-0 mb-2" style="min-width: 220px; border-radius: 12px; background: #fff;">
                    <li><a class="dropdown-item py-2 fw-medium" href="/Auth/ChangePassword"><i class="bi bi-shield-lock me-2 text-muted"></i> Đổi mật khẩu</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger fw-medium" href="/Auth/Logout"><i class="bi bi-box-arrow-right me-2 text-danger"></i> Đăng xuất</a></li>
                </ul>
            </div>
        </nav>

        <aside id="settingsPanel" class="settings-panel" data-settings-panel role="dialog" aria-modal="false" aria-hidden="true" aria-labelledby="settingsPanelTitle">
            <div class="settings-panel__header">
                <div>
                    <div class="settings-panel__eyebrow">Bảng điều khiển</div>
                    <h2 id="settingsPanelTitle">Cài đặt</h2>
                </div>
                <button type="button" class="settings-panel__close" data-settings-panel-close aria-label="Đóng bảng cài đặt">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="settings-panel__section">
                <div class="settings-panel__label">Tài khoản</div>
                <a href="/Auth/ChangePassword" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-shield-lock"></i></span>
                    <span>
                        <strong>Đổi mật khẩu</strong>
                        <small>Bảo vệ tài khoản quản trị</small>
                    </span>
                </a>
            </div>

            <div class="settings-panel__section">
                <div class="settings-panel__label">SaaS admin</div>
                <a href="/SaaSAdmin/Settings" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-sliders"></i></span>
                    <span>
                        <strong>Cài đặt hệ thống SaaS</strong>
                        <small>Thương hiệu, email, đăng ký và vận hành nền</small>
                    </span>
                </a>
                <a href="/SaaSAdmin/Security" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-shield-lock-fill"></i></span>
                    <span>
                        <strong>Bảo mật & Phân quyền</strong>
                        <small>Chính sách truy cập của khu vực quản trị</small>
                    </span>
                </a>
            </div>

            <div class="settings-panel__section">
                <div class="settings-panel__label">Điều hướng nhanh</div>
                <a href="/SaaSAdmin/Registrations" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-people-fill"></i></span>
                    <span>
                        <strong>Khách hàng & đăng ký</strong>
                        <small>Theo dõi tenant và yêu cầu mới</small>
                    </span>
                </a>
                <a href="/SaaSAdmin/Revenue" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-graph-up-arrow"></i></span>
                    <span>
                        <strong>Báo cáo doanh thu</strong>
                        <small>Gói dịch vụ, thanh toán và tăng trưởng</small>
                    </span>
                </a>
                <a href="/Dashboard/Index" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-layout-sidebar-inset"></i></span>
                    <span>
                        <strong>Hệ thống vận hành</strong>
                        <small>Quay lại không gian KPI/OKR chính</small>
                    </span>
                </a>
            </div>
        </aside>
        <div class="settings-panel-backdrop" data-settings-panel-close></div>

        <div id="sidebarOverlay" class="sidebar-overlay"></div>

        <div class="main-content">
            <header class="top-header">
                <div class="header-left">
                    <button id="sidebarToggle" class="sidebar-toggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="header-search">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Tìm kiếm nhanh khách hàng...">
                    </div>
                </div>

                <div class="header-right">
                    <div class="ms-2">
                        <a href="/" target="_blank" class="btn shadow-sm text-decoration-none bg-white text-dark border" style="border-radius: 12px; padding: 8px 16px; font-size: 0.875rem; font-weight: 600;">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Xem Landing Page
                        </a>
                    </div>
                </div>
            </header>

            <main class="page-content" role="main">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm rounded-3 py-2 px-3 mb-4 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm rounded-3 py-2 px-3 mb-4 d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="app-footer">
                <div>&copy; 2026 Admin - VIETMACH</div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
