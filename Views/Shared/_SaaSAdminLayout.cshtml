@inject Manage_KPI_or_OKR_System.Services.ISystemSettingsService SystemSettingsService
@{
    var appBranding = await SystemSettingsService.GetBrandingAsync();
    var canonicalUrl = Manage_KPI_or_OKR_System.Helpers.SeoHelper.GetCanonicalUrl(ViewContext, appBranding.PublicBaseUrl);
    var seoImageUrl = appBranding.SeoImageUrl;
    var currentAction = Convert.ToString(ViewContext.RouteData.Values["Action"]) ?? string.Empty;
    if (!string.IsNullOrWhiteSpace(seoImageUrl) && !seoImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
    {
        seoImageUrl = $"{appBranding.PublicBaseUrl}{(seoImageUrl.StartsWith("/") ? seoImageUrl : "/" + seoImageUrl)}";
    }
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light" data-layout="vertical" data-layout-width="fluid" data-layout-position="fixed" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | @appBranding.ProductName</title>
    <link rel="icon" href="@appBranding.FaviconUrl" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendor/velzon/css/app.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style id="brand-theme">
        :root {
            --vm-font-sans: 'Inter', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --color-brand-violet: #7b68ee;
            --color-signal-blue: #0091ff;
            --color-ultra-violet: #6647f0;
            --color-muted-violet: #514b81;
            --color-midnight-ink: #090c1d;
            --color-charcoal: #292d34;
            --color-carbon: #202023;
            --color-slate: #646464;
            --color-steel: #7c828d;
            --color-mist: #d9d9d9;
            --color-cloud: #e8e8e8;
            --color-paper: #f8f9fa;
            --color-frost: #edf6fd;
            --font-plus-jakarta-sans: 'Plus Jakarta Sans', 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --font-inter: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --primary: @appBranding.PrimaryColor;
            --primary-dark: @appBranding.PrimaryDarkColor;
            --primary-darker: @appBranding.PrimaryDarkColor;
            --primary-light: color-mix(in srgb, @appBranding.PrimaryColor 12%, #ffffff);
            --primary-bg: color-mix(in srgb, @appBranding.PrimaryColor 8%, transparent);
            --info: @appBranding.PrimaryColor;
            --info-bg: color-mix(in srgb, @appBranding.PrimaryColor 12%, #ffffff);
            --sidebar-bg: #405189;
            --sidebar-bg-solid: #405189;
            --sidebar-text: #cbd3df;
            --sidebar-text-active: #ffffff;
            --body-bg: @appBranding.BodyBackgroundColor;
            --card-bg: @appBranding.CardBackgroundColor;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/velzon-kpi.css" asp-append-version="true" />

    <script>
        (function() {
            const sidebarState = localStorage.getItem('sidebarState');
            const desktopDefault = window.matchMedia('(min-width: 992px)').matches;
            if (sidebarState === 'expanded' || (sidebarState === null && desktopDefault)) {
                document.documentElement.classList.add('sidebar-expanded');
            } else {
                document.documentElement.classList.remove('sidebar-expanded');
            }
        })();
    </script>
</head>
<body class="nextgen-shell nextgen-shell--saas-admin">
    <!--
    THESIS: SaaS administration reads as one compact operational control surface, refusing decorative dashboard chrome.
    OWN-WORLD: Enterprise Default authority; #405189 indigo navigation, light sticky command bar, #f3f3f9 canvas, white compact cards, Poppins and HK Grotesk.
    STORY: Administrators orient by domain, scan customer and revenue state, then move directly into a protected management workflow.
    FIRST VIEWPORT: A fixed 250px navigation rail frames a 70px command bar and dense content grid; dynamic-brand primary actions remain nearest each task.
    FORM: Established Enterprise operations shell, position 1, key ENTERPRISE-OPERATIONS-SHELL-2026.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="app-skip-link" href="#mainContent">Chuyển đến nội dung chính</a>
    <form id="globalAntiForgeryForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>
    
    <div id="layout-wrapper" class="app-wrapper nextgen-layout-wrapper">
        <nav id="sidebar" class="sidebar app-menu navbar-menu" aria-label="Điều hướng quản trị SaaS">
            <div class="sidebar-brand navbar-brand-box">
                <div class="brand-icon">
                    <i class="bi bi-hexagon-fill text-primary"></i>
                </div>
                <div class="brand-info">
                    <div class="brand-text">Admin</div>
                    <div class="brand-sub">Quản trị hệ thống</div>
                </div>
            </div>

            <div class="sidebar-nav">
                <div class="sidebar-group">
                    <div class="sidebar-group-label">Overview</div>
                    <a href="/Dashboard" class="sidebar-link">
                        <i class="bi bi-layout-sidebar-inset"></i> <span>Hệ thống vận hành</span>
                    </a>
                    <a href="/SaaSAdmin" class="sidebar-link @(currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i> <span>Dashboard</span>
                    </a>
                </div>

                <div class="sidebar-group">
                    <div class="sidebar-group-label">Quản lý Khách Hàng</div>
                    <a href="/SaaSAdmin/Registrations" class="sidebar-link @(currentAction == "Registrations" ? "active" : "")">
                        <i class="bi bi-people-fill"></i> <span>Khách hàng & Đăng ký</span>
                    </a>
                    <a href="/SaaSAdmin/Packages" class="sidebar-link @(currentAction == "Packages" ? "active" : "")">
                        <i class="bi bi-boxes"></i> <span>Quản lý Gói Dịch Vụ</span>
                    </a>
                </div>

                <div class="sidebar-group">
                    <div class="sidebar-group-label">Báo cáo & Tài chính</div>
                    <a href="/SaaSAdmin/Revenue" class="sidebar-link @(currentAction == "Revenue" ? "active" : "")">
                        <i class="bi bi-graph-up-arrow"></i> <span>Báo cáo doanh thu</span>
                    </a>
                    <a href="/SaaSAdmin/PaymentHistory" class="sidebar-link @(currentAction == "PaymentHistory" ? "active" : "")">
                        <i class="bi bi-receipt"></i> <span>Lịch sử thanh toán</span>
                    </a>
                </div>

            </div>

            <div class="sidebar-footer dropup">
                <button type="button" class="sidebar-settings-trigger" data-settings-panel-trigger aria-label="Mở cài đặt" aria-controls="settingsPanel" aria-expanded="false">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span>Cài đặt</span>
                </button>
                <div class="sidebar-user" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">
                        <span>AD</span>
                    </div>
                    <div class="user-info">
                        <div class="user-name">Admin</div>
                        <div class="user-role">Admin</div>
                    </div>
                    <i class="bi bi-three-dots-vertical ms-auto user-dots"></i>
                </div>
                
                <ul class="dropdown-menu sidebar-user-menu shadow-sm border-0 mb-2">
                    <li><a class="dropdown-item py-2 fw-medium" href="/Auth/ChangePassword"><i class="bi bi-shield-lock me-2 text-muted"></i> Đổi mật khẩu</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger fw-medium" href="/Auth/Logout"><i class="bi bi-box-arrow-right me-2 text-danger"></i> Đăng xuất</a></li>
                </ul>
            </div>
        </nav>

        <aside id="settingsPanel" class="settings-panel" data-settings-panel role="dialog" aria-modal="false" aria-hidden="true" aria-labelledby="settingsPanelTitle">
            <div class="settings-panel__header">
                <div>
                    <div class="settings-panel__eyebrow">Bảng điều khiển</div>
                    <h2 id="settingsPanelTitle">Cài đặt</h2>
                </div>
                <button type="button" class="settings-panel__close" data-settings-panel-close aria-label="Đóng bảng cài đặt">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="settings-panel__section">
                <div class="settings-panel__label">Tài khoản</div>
                <a href="/Auth/ChangePassword" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-shield-lock"></i></span>
                    <span>
                        <strong>Đổi mật khẩu</strong>
                        <small>Bảo vệ tài khoản quản trị</small>
                    </span>
                </a>
            </div>

            <div class="settings-panel__section">
                <div class="settings-panel__label">SaaS admin</div>
                <a href="/SaaSAdmin/Settings" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-sliders"></i></span>
                    <span>
                        <strong>Cài đặt hệ thống SaaS</strong>
                        <small>Thương hiệu, email, đăng ký và vận hành nền</small>
                    </span>
                </a>
                <a href="/SaaSAdmin/Security" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-shield-lock-fill"></i></span>
                    <span>
                        <strong>Bảo mật & Phân quyền</strong>
                        <small>Chính sách truy cập của khu vực quản trị</small>
                    </span>
                </a>
            </div>

            <div class="settings-panel__section">
                <div class="settings-panel__label">Điều hướng nhanh</div>
                <a href="/SaaSAdmin/Registrations" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-people-fill"></i></span>
                    <span>
                        <strong>Khách hàng & đăng ký</strong>
                        <small>Theo dõi tenant và yêu cầu mới</small>
                    </span>
                </a>
                <a href="/SaaSAdmin/Revenue" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-graph-up-arrow"></i></span>
                    <span>
                        <strong>Báo cáo doanh thu</strong>
                        <small>Gói dịch vụ, thanh toán và tăng trưởng</small>
                    </span>
                </a>
                <a href="/Dashboard" class="settings-panel__item">
                    <span class="settings-panel__icon"><i class="bi bi-layout-sidebar-inset"></i></span>
                    <span>
                        <strong>Hệ thống vận hành</strong>
                        <small>Quay lại không gian KPI/OKR chính</small>
                    </span>
                </a>
            </div>
        </aside>
        <div class="settings-panel-backdrop" data-settings-panel-close></div>

        <button type="button" id="sidebarOverlay" class="sidebar-overlay" aria-label="Đóng thanh điều hướng" tabindex="-1"></button>

        <div class="main-content">
            <header id="page-topbar" class="top-header layout-width navbar-header">
                <div class="header-left">
                    <button type="button" id="sidebarToggle" class="sidebar-toggle" aria-label="Thu gọn hoặc mở rộng thanh điều hướng" aria-expanded="false" aria-controls="sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="header-search">
                        <i class="bi bi-search"></i>
                        <input type="search" aria-label="Tìm kiếm nhanh khách hàng" placeholder="Tìm kiếm nhanh khách hàng..." autocomplete="off">
                    </div>
                </div>

                <div class="header-right">
                    <div class="ms-2">
                        <a href="/" target="_blank" class="btn btn-outline-secondary text-decoration-none">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Xem Landing Page
                        </a>
                    </div>
                </div>
            </header>

            <main id="mainContent" class="page-content container-fluid" role="main" tabindex="-1">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <div>&copy; 2026 Admin - NextGen</div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/management-ui.js" asp-append-version="true"></script>

    @if (TempData["ToastErrorMessage"] != null || TempData["ToastSuccessMessage"] != null || TempData["ToastWarningMessage"] != null || TempData["ToastInfoMessage"] != null || TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                [
                    { message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastErrorMessage"] ?? TempData["ErrorMessage"])), tone: 'error', title: 'Không thể thực hiện' },
                    { message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastSuccessMessage"] ?? TempData["SuccessMessage"])), tone: 'success', title: 'Đã hoàn tất' },
                    { message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastWarningMessage"])), tone: 'warning', title: 'Cần chú ý' },
                    { message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastInfoMessage"])), tone: 'info', title: 'Thông báo' }
                ].filter(item => item.message).forEach(item => window.AppFeedback.toast(item));
            });
        </script>
    }
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
