@inject Manage_KPI_or_OKR_System.Services.ISystemSettingsService SystemSettingsService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@{
    var appBranding = await SystemSettingsService.GetBrandingAsync();
    var currentController = Convert.ToString(ViewContext.RouteData.Values["Controller"]) ?? string.Empty;
    var currentAction = Convert.ToString(ViewContext.RouteData.Values["Action"]) ?? string.Empty;
    var publicAuthActions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Login", "Register", "ForgotPassword", "ResetPassword", "SelectTenant", "AccessDenied", "PendingActivation"
    };
    var isLoginPage = ViewData["IsLoginPage"] is true ||
        (currentController.Equals("Auth", StringComparison.OrdinalIgnoreCase) && publicAuthActions.Contains(currentAction));
    var isLandingPage = ViewData["IsLandingPage"] is true ||
        (currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) &&
         (currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase) ||
          currentAction.Equals("Privacy", StringComparison.OrdinalIgnoreCase) ||
          currentAction.Equals("PurchaseHistory", StringComparison.OrdinalIgnoreCase)));
    var isInternalPage = !isLoginPage && !isLandingPage;
    var bodyVariant = isLoginPage ? "vietmach-auth" : isLandingPage ? "vietmach-public" : "vietmach-shell";
    var canonicalUrl = SeoHelper.GetCanonicalUrl(ViewContext, appBranding.PublicBaseUrl);
    var seoImageUrl = appBranding.SeoImageUrl;
    if (!string.IsNullOrWhiteSpace(seoImageUrl) && !seoImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
    {
        seoImageUrl = $"{appBranding.PublicBaseUrl}{(seoImageUrl.StartsWith("/") ? seoImageUrl : "/" + seoImageUrl)}";
    }
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light" data-layout="vertical" data-layout-width="fluid" data-layout-position="fixed" data-topbar="light" data-sidebar="light" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@SeoHelper.GetTitle(ViewContext, appBranding.ProductName)</title>
    <link rel="icon" href="@appBranding.FaviconUrl" />
    
    <!-- Primary Meta Tags -->
    <meta name="title" content="@SeoHelper.GetTitle(ViewContext, appBranding.ProductName)" />
    <meta name="description" content="@SeoHelper.GetDescription(ViewContext, appBranding.SeoDescription)" />
    <meta name="keywords" content="@SeoHelper.GetKeywords(ViewContext, appBranding.SeoKeywords)" />
    <meta name="author" content="@appBranding.Author" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph / Facebook / Zalo -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="@SeoHelper.GetTitle(ViewContext, appBranding.ProductName)" />
    <meta property="og:description" content="@SeoHelper.GetDescription(ViewContext, appBranding.SeoDescription)" />
    <meta property="og:image" content="@seoImageUrl" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="@canonicalUrl" />
    <meta property="twitter:title" content="@SeoHelper.GetTitle(ViewContext, appBranding.ProductName)" />
    <meta property="twitter:description" content="@SeoHelper.GetDescription(ViewContext, appBranding.SeoDescription)" />
    <meta property="twitter:image" content="@seoImageUrl" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "SoftwareApplication",
      "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(appBranding.ProductName)),
      "operatingSystem": "Web-based",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "VND"
      },
      "description": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(appBranding.SeoDescription))
    }
    </script>

    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendor/velzon/css/app.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style id="brand-theme">
        :root {
            --vm-font-sans: 'Inter', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --color-brand-violet: #7b68ee;
            --color-signal-blue: #0091ff;
            --color-ultra-violet: #6647f0;
            --color-muted-violet: #514b81;
            --color-midnight-ink: #090c1d;
            --color-charcoal: #292d34;
            --color-carbon: #202023;
            --color-slate: #646464;
            --color-steel: #7c828d;
            --color-mist: #d9d9d9;
            --color-cloud: #e8e8e8;
            --color-paper: #f8f9fa;
            --color-frost: #edf6fd;
            --font-plus-jakarta-sans: 'Plus Jakarta Sans', 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --font-inter: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --primary: @appBranding.PrimaryColor;
            --primary-dark: @appBranding.PrimaryDarkColor;
            --primary-darker: @appBranding.PrimaryDarkColor;
            --primary-light: color-mix(in srgb, @appBranding.PrimaryColor 12%, #ffffff);
            --primary-bg: color-mix(in srgb, @appBranding.PrimaryColor 8%, transparent);
            --info: @appBranding.PrimaryColor;
            --info-bg: color-mix(in srgb, @appBranding.PrimaryColor 12%, #ffffff);
            --sidebar-bg: @appBranding.SidebarColor;
            --sidebar-bg-solid: @appBranding.SidebarColor;
            --sidebar-text: @appBranding.SidebarTextColor;
            --sidebar-text-active: @appBranding.SidebarTextColor;
            --body-bg: @appBranding.BodyBackgroundColor;
            --card-bg: @appBranding.CardBackgroundColor;
        }
        @Html.Raw(Manage_KPI_or_OKR_System.Services.SystemSettingsService.EncodeCustomCssForStyleBlock(appBranding.CustomCss))
    </style>
    
    <!-- Restore sidebar state immediately to prevent layout shift -->
    <script>
        (function() {
            const sidebarState = localStorage.getItem('sidebarState');
            const desktopDefault = window.matchMedia('(min-width: 992px)').matches;
            if (desktopDefault && (sidebarState === 'expanded' || sidebarState === null)) {
                document.documentElement.classList.add('sidebar-expanded');
            } else {
                document.documentElement.classList.remove('sidebar-expanded');
            }
        })();
    </script>
    <link rel="stylesheet" href="~/css/velzon-kpi.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@bodyVariant vietmach-shell">
    <!--
    THESIS: KPI/OKR work reads as a compact enterprise operations console, refusing decorative dashboard chrome.
    OWN-WORLD: Indigo navigation, a light command bar, pale canvas, compact white surfaces, and Segoe UI typography with full Vietnamese support.
    STORY: Users orient by responsibility, scan risk and progress, then move directly into the authorized workflow.
    FIRST VIEWPORT: Internal routes use a fixed navigation rail and command bar; public and authentication routes inherit the same restrained tokens.
    FORM: VietMach operations system, position 1, key VIETMACH-OPERATIONS-SHELL-2026.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    @if (isLoginPage || isLandingPage)
    {
        @RenderBody()
    }
    else
    {
        <a class="app-skip-link" href="#mainContent">Chuyển đến nội dung chính</a>
        <form id="globalAntiForgeryForm" class="d-none">
            @Html.AntiForgeryToken()
        </form>
        <div id="layout-wrapper" class="app-wrapper vietmach-layout-wrapper vietmach-shell">
            <nav id="sidebar" class="sidebar app-menu navbar-menu" aria-label="Điều hướng chính">
                <div class="sidebar-brand navbar-brand-box">
                    <div class="brand-icon">
                        @if (appBranding.HasLogo)
                        {
                            <img class="brand-logo-img" src="@appBranding.LogoUrl" alt="@appBranding.CompanyName logo" />
                        }
                        else
                        {
                            <i class="bi bi-hexagon-fill"></i>
                        }
                    </div>
                    <div class="brand-info">
                        <div class="brand-text">@appBranding.ShortName</div>
                        <div class="brand-sub">@appBranding.Tagline</div>
                    </div>
                </div>

                <div class="sidebar-nav">
                    @{
                        bool isAdmin = User.IsInRole("Admin") || User.IsInRole("Administrator");
                        bool isPlatformAdmin = User.HasClaim(
                            Manage_KPI_or_OKR_System.Helpers.AuthRoleHelper.PlatformAdminClaimType,
                            bool.TrueString);
                        bool isManagerWorkflow = Manage_KPI_or_OKR_System.Helpers.AccessScopeHelper.IsManagerScoped(User);
                        bool isEmployeeWorkflow = Manage_KPI_or_OKR_System.Helpers.AccessScopeHelper.IsEmployeeOrSales(User);
                        bool isProjectManagerAi = Manage_KPI_or_OKR_System.Helpers.ProjectRoleProfileHelper.IsProjectManagerAi(User);
                        bool isKpiOkrDeveloper = Manage_KPI_or_OKR_System.Helpers.ProjectRoleProfileHelper.IsKpiOkrDeveloper(User);
                        bool isOperationsDeveloper = Manage_KPI_or_OKR_System.Helpers.ProjectRoleProfileHelper.IsOperationsDeveloper(User);
                        bool isTester = Manage_KPI_or_OKR_System.Helpers.ProjectRoleProfileHelper.IsTester(User);
                        bool isCatalogDeveloper = Manage_KPI_or_OKR_System.Helpers.ProjectRoleProfileHelper.IsCatalogDeveloper(User);
                        bool hasSpecializedProjectRole = isProjectManagerAi || isKpiOkrDeveloper ||
                            isOperationsDeveloper || isTester || isCatalogDeveloper;

                        var userPermissions = User.Claims
                            .Where(c => c.Type == Manage_KPI_or_OKR_System.Services.PermissionClaimsTransformation.PermissionClaimType)
                            .Select(c => c.Value)
                            .ToHashSet(StringComparer.OrdinalIgnoreCase);

                        bool HasPerm(string code) => isAdmin || userPermissions.Contains(code);
                        bool showDashboard = HasPerm("DASHBOARD_VIEW");
                        bool showWorkProjects = HasPerm("WORKPROJECTS_VIEW");
                        bool showMissionSetup = !isManagerWorkflow && !isEmployeeWorkflow && HasPerm("MISSIONS_VIEW");
                        bool showOkrs = HasPerm("OKRS_VIEW") &&
                            (!hasSpecializedProjectRole || isProjectManagerAi || isKpiOkrDeveloper);
                        bool showEvaluationPeriods = !isManagerWorkflow && !isEmployeeWorkflow && HasPerm("EVALPERIODS_VIEW");
                        bool showKpis = HasPerm("KPIS_VIEW");
                        bool showSelfCheckIns = !isManagerWorkflow && HasPerm("KPICHECKINS_VIEW");
                        bool showManagerTracking = isManagerWorkflow &&
                            (HasPerm("KPICHECKINS_VIEW") || HasPerm("KPICHECKINS_REVIEW") || HasPerm("KPIS_VIEW"));
                        bool showEvaluationResults = !isEmployeeWorkflow && HasPerm("EVALRESULTS_VIEW");
                        bool showEvaluationReview = !isManagerWorkflow && !isEmployeeWorkflow && HasPerm("EVALRESULTS_REVIEW");
                        bool showEvaluationReports = !isManagerWorkflow && !isEmployeeWorkflow &&
                            (HasPerm("EVALREPORTS_VIEW") || HasPerm("REPORTS_VIEW"));
                        bool showBonusRules = !isManagerWorkflow && !isEmployeeWorkflow && HasPerm("BONUSRULES_VIEW");
                        bool showEmployees = !isManagerWorkflow && !isEmployeeWorkflow && HasPerm("EMPLOYEES_VIEW");
                        bool showDepartments = !isManagerWorkflow && !isEmployeeWorkflow && HasPerm("DEPARTMENTS_VIEW");
                        bool showPositions = !isManagerWorkflow && !isEmployeeWorkflow && HasPerm("POSITIONS_VIEW");
                        bool canUseQuickSearch = HasPerm("EMPLOYEES_VIEW") || HasPerm("KPIS_VIEW") ||
                            HasPerm("OKRS_VIEW") || HasPerm("DEPARTMENTS_VIEW");
                        bool canUseAiAdvisor = hasSpecializedProjectRole
                            ? isProjectManagerAi || isKpiOkrDeveloper
                            : HasPerm("KPIS_VIEW") || HasPerm("OKRS_VIEW") ||
                              HasPerm("KPICHECKINS_VIEW") || HasPerm("KPICHECKINS_REVIEW");
                        bool canOpenSystemParameters = User.IsInRole("Admin") || User.IsInRole("Administrator") || User.IsInRole("HR");
                        bool canViewSystemUsers = HasPerm("SYSUSERS_VIEW");
                        bool canViewRoles = isPlatformAdmin && HasPerm("ROLES_VIEW");
                        bool canViewAuditLogs = HasPerm("AUDITLOGS_VIEW");
                        bool canOpenCatalog = isAdmin || isCatalogDeveloper;
                        bool canOpenPlatformAdminTools = isPlatformAdmin;
                        bool canManageKnowledgeDocuments = isAdmin || User.IsInRole("Director") ||
                            User.IsInRole("HR");
                    }

                    @if (showDashboard)
                    {
                        <div class="sidebar-group">
                            <div class="sidebar-group-label">Tổng quan</div>
                            <a href="/Dashboard" class="sidebar-link">
                                <i class="bi bi-grid-1x2-fill"></i> <span>Tổng quan công việc</span>
                            </a>
                        </div>
                    }

                    @if (showWorkProjects)
                    {
                        <div class="sidebar-group">
                            <div class="sidebar-group-label">@(isManagerWorkflow ? "Điều phối" : "Công việc của tôi")</div>
                            <a href="/WorkProjects" class="sidebar-link">
                                <i class="bi bi-kanban-fill"></i>
                                <span>@(isManagerWorkflow ? "Dự án & phân công" : "Công việc được giao")</span>
                            </a>
                        </div>
                    }

                    @if (showMissionSetup || showOkrs)
                    {
                        <div class="sidebar-group">
                            <div class="sidebar-group-label">Mục tiêu</div>
                            @if (showMissionSetup)
                            {
                                <a href="/MissionVisions" class="sidebar-link">
                                    <i class="bi bi-compass-fill"></i> <span>Thiết lập tầm nhìn & sứ mệnh</span>
                                </a>
                            }
                            @if (showOkrs)
                            {
                                <a href="/OKRs" class="sidebar-link">
                                    <i class="bi bi-bullseye"></i>
                                    <span>@(isManagerWorkflow ? "OKR của nhóm" : isEmployeeWorkflow ? "Mục tiêu được giao" : "Quản lý OKR / Mục tiêu")</span>
                                </a>
                            }
                        </div>
                    }

                    @if (showEvaluationPeriods || showKpis || showSelfCheckIns || showManagerTracking)
                    {
                        <div class="sidebar-group">
                            <div class="sidebar-group-label">Tiến độ & KPI</div>
                            @if (showEvaluationPeriods)
                            {
                                <a href="/EvaluationPeriods" class="sidebar-link">
                                    <i class="bi bi-calendar3"></i> <span>Kỳ đánh giá</span>
                                </a>
                            }
                            @if (showKpis)
                            {
                                <a href="/KPIs" class="sidebar-link" data-instant-nav="kpi" data-instant-title="KPI">
                                    <i class="bi bi-speedometer2"></i>
                                    <span>@(isManagerWorkflow ? "KPI của nhóm" : isEmployeeWorkflow ? "KPI cá nhân" : "Quản lý KPI")</span>
                                </a>
                            }
                            @if (showSelfCheckIns)
                            {
                                <a href="/KPICheckIns" class="sidebar-link" data-instant-nav="kpi" data-instant-title="Cập nhật tiến độ KPI">
                                    <i class="bi bi-check2-square"></i> <span>Cập nhật tiến độ KPI</span>
                                </a>
                            }
                            @if (showManagerTracking)
                            {
                                <a href="/KPICheckIns/EmployeeTracking" class="sidebar-link" data-instant-nav="kpi" data-instant-title="Theo dõi và duyệt check-in">
                                    <i class="bi bi-person-check-fill"></i> <span>Theo dõi & duyệt check-in</span>
                                </a>
                            }
                        </div>
                    }

                    @if (showEvaluationResults || showEvaluationReview || showEvaluationReports || showBonusRules)
                    {
                        <div class="sidebar-group">
                            <div class="sidebar-group-label">Đánh giá & Thưởng</div>
                            @if (showEvaluationResults)
                            {
                                <a href="/EvaluationResults" class="sidebar-link">
                                    <i class="bi bi-award-fill"></i> <span>@(isManagerWorkflow ? "Đánh giá thành viên" : "Đánh giá 1-1 / Kết quả")</span>
                                </a>
                            }
                            @if (showEvaluationReview)
                            {
                                <a href="/EvaluationResults/ReviewBoard" class="sidebar-link">
                                    <i class="bi bi-clipboard-check-fill"></i> <span>Duyệt đánh giá & kết quả</span>
                                </a>
                            }
                            @if (showEvaluationReports)
                            {
                                <a href="/EvaluationReports" class="sidebar-link">
                                    <i class="bi bi-file-earmark-bar-graph-fill text-info"></i> <span>Báo cáo Đánh giá (V.Director)</span>
                                </a>
                            }
                            @if (showBonusRules)
                            {
                                <a href="/BonusRules" class="sidebar-link">
                                    <i class="bi bi-cash-coin"></i> <span>Quy tắc thưởng</span>
                                </a>
                            }
                        </div>
                    }

                    @if (showEmployees || showDepartments || showPositions)
                    {
                        <div class="sidebar-group">
                            <div class="sidebar-group-label">Nhân sự</div>
                            @if (showEmployees)
                            {
                                <a href="/Employees" class="sidebar-link">
                                    <i class="bi bi-people-fill"></i> <span>Nhân sự</span>
                                </a>
                            }
                            @if (showDepartments)
                            {
                                <a href="/Departments" class="sidebar-link">
                                    <i class="bi bi-diagram-3-fill"></i> <span>Phòng ban</span>
                                </a>
                            }
                            @if (showPositions)
                            {
                                <a href="/Positions" class="sidebar-link">
                                    <i class="bi bi-person-badge-fill"></i> <span>Chức vụ</span>
                                </a>
                            }
                        </div>
                    }

                    @if (isCatalogDeveloper && canOpenCatalog)
                    {
                        <div class="sidebar-group">
                            <div class="sidebar-group-label">Công cụ chuyên môn</div>
                            <a href="/Catalog" class="sidebar-link">
                                <i class="bi bi-collection-fill"></i> <span>Danh mục chung</span>
                            </a>
                        </div>
                    }

                    @* HỆ THỐNG: Dựa trên permission (Moved to Settings panel)
                    @if (HasPerm("SYSUSERS_VIEW") || HasPerm("ROLES_VIEW") || HasPerm("AUDITLOGS_VIEW"))
                    {
                        <div class="sidebar-group mt-2">
                            <div class="sidebar-group-label">Hệ thống</div>
                            @if (HasPerm("SYSUSERS_VIEW"))
                            {
                                <a href="/SystemUsers" class="sidebar-link">
                                    <i class="bi bi-shield-lock-fill"></i> <span>Người dùng</span>
                                </a>
                            }
                            @if (HasPerm("ROLES_VIEW"))
                            {
                                <a href="/Roles" class="sidebar-link">
                                    <i class="bi bi-person-lines-fill"></i> <span>Phân quyền</span>
                                </a>
                            }
                            @if (HasPerm("AUDITLOGS_VIEW"))
                            {
                                <a href="/AuditLogs" class="sidebar-link">
                                    <i class="bi bi-journal-text"></i> <span>Lịch sử hệ thống</span>
                                </a>
                            }
                            @if (isAdmin)
                            {
                                <a href="/Catalog" class="sidebar-link">
                                    <i class="bi bi-collection-fill"></i> <span>Quản lý danh mục</span>
                                </a>
                                <a href="/SaaSAdmin" class="sidebar-link">
                                    <i class="bi bi-building-gear"></i> <span>Quản trị khách hàng</span>
                                </a>
                            }
                        </div>
                    }
                    *@

                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var userName = User.Identity.Name;
                    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
                    <div class="sidebar-footer dropup">
                        <button type="button" class="sidebar-settings-trigger" data-settings-panel-trigger aria-label="Mở cài đặt" aria-controls="settingsPanel" aria-expanded="false">
                            <i class="bi bi-gear-wide-connected"></i>
                            <span>Cài đặt</span>
                        </button>
                        <div class="sidebar-user sidebar-user-trigger" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar">
                                <span>@(userName?[0].ToString().ToUpper() ?? "U")</span>
                            </div>
                            <div class="user-info">
                                <div class="user-name">@userName</div>
                                <div class="user-role">@userRole</div>
                            </div>
                            <i class="bi bi-three-dots-vertical ms-auto user-dots"></i>
                        </div>
                        
                        <ul class="dropdown-menu sidebar-user-menu shadow-sm border-0 mb-2">
                            <li><a class="dropdown-item py-2 fw-medium" href="/Auth/MyProfile"><i class="bi bi-person me-2 text-muted"></i> Hồ sơ cá nhân</a></li>
                            <li><a class="dropdown-item py-2 fw-medium" href="/Auth/ChangePassword"><i class="bi bi-shield-lock me-2 text-muted"></i> Đổi mật khẩu</a></li>
                            @if (HostingEnvironment.IsDevelopment())
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header text-primary fw-bold"><i class="bi bi-people-fill"></i> TÀI KHOẢN DÙNG THỬ</h6></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="SwitchDemo" method="post"><input type="hidden" name="username" value="director" /><button type="submit" class="dropdown-item py-2 fw-medium"><i class="bi bi-person-badge text-warning me-2"></i> Director (Giám đốc)</button></form>
                                </li>
                                <li>
                                    <form asp-controller="Auth" asp-action="SwitchDemo" method="post"><input type="hidden" name="username" value="manager" /><button type="submit" class="dropdown-item py-2 fw-medium"><i class="bi bi-person-fill-gear text-success me-2"></i> Manager (Trưởng phòng)</button></form>
                                </li>
                                <li>
                                    <form asp-controller="Auth" asp-action="SwitchDemo" method="post"><input type="hidden" name="username" value="hr" /><button type="submit" class="dropdown-item py-2 fw-medium"><i class="bi bi-person-hearts text-danger me-2"></i> HR (Nhân sự)</button></form>
                                </li>
                                <li>
                                    <form asp-controller="Auth" asp-action="SwitchDemo" method="post"><input type="hidden" name="username" value="employee" /><button type="submit" class="dropdown-item py-2 fw-medium"><i class="bi bi-person text-info me-2"></i> Employee (Nhân viên)</button></form>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 text-danger fw-medium" href="/Auth/Logout"><i class="bi bi-box-arrow-right me-2 text-danger"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                }
            </nav>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <aside id="settingsPanel" class="settings-panel" data-settings-panel role="dialog" aria-modal="false" aria-hidden="true" aria-labelledby="settingsPanelTitle">
                    <div class="settings-panel__header">
                        <div>
                            <div class="settings-panel__eyebrow">Bảng điều khiển</div>
                            <h2 id="settingsPanelTitle">Cài đặt</h2>
                        </div>
                        <button type="button" class="settings-panel__close" data-settings-panel-close aria-label="Đóng bảng cài đặt">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="settings-panel__section">
                        <div class="settings-panel__label">Tài khoản</div>
                        <a href="/Auth/MyProfile" class="settings-panel__item">
                            <span class="settings-panel__icon"><i class="bi bi-person-circle"></i></span>
                            <span>
                                <strong>Hồ sơ cá nhân</strong>
                                <small>Thông tin, vai trò và hồ sơ làm việc</small>
                            </span>
                        </a>
                        <a href="/AIHistory" class="settings-panel__item">
                            <span class="settings-panel__icon"><i class="bi bi-clock-history"></i></span>
                            <span>
                                <strong>Lịch sử AI</strong>
                                <small>Hội thoại và các lần hỗ trợ AI của tài khoản</small>
                            </span>
                        </a>
                        <a href="/Auth/ChangePassword" class="settings-panel__item">
                            <span class="settings-panel__icon"><i class="bi bi-shield-lock"></i></span>
                            <span>
                                <strong>Đổi mật khẩu</strong>
                                <small>Bảo vệ tài khoản đăng nhập</small>
                            </span>
                        </a>
                    </div>

                    @if (canOpenSystemParameters || canViewSystemUsers || canViewRoles || canViewAuditLogs || canManageKnowledgeDocuments)
                    {
                        <div class="settings-panel__section">
                            <div class="settings-panel__label">Hệ thống</div>
                            @if (canOpenSystemParameters)
                            {
                                <a href="/SystemParameters" class="settings-panel__item">
                                    <span class="settings-panel__icon"><i class="bi bi-sliders"></i></span>
                                    <span>
                                        <strong>Tham số hệ thống</strong>
                                        <small>Cấu hình KPI, OKR, thương hiệu và vận hành</small>
                                    </span>
                                </a>
                            }
                            @if (canViewSystemUsers)
                            {
                                <a href="/SystemUsers" class="settings-panel__item">
                                    <span class="settings-panel__icon"><i class="bi bi-shield-lock-fill"></i></span>
                                    <span>
                                        <strong>Người dùng</strong>
                                        <small>Tài khoản đăng nhập và trạng thái truy cập</small>
                                    </span>
                                </a>
                            }
                            @if (canViewRoles)
                            {
                                <a href="/Roles" class="settings-panel__item">
                                    <span class="settings-panel__icon"><i class="bi bi-person-lines-fill"></i></span>
                                    <span>
                                        <strong>Phân quyền</strong>
                                        <small>Vai trò và nhóm quyền sử dụng hệ thống</small>
                                    </span>
                                </a>
                            }
                            @if (canViewAuditLogs)
                            {
                                <a href="/AuditLogs" class="settings-panel__item">
                                    <span class="settings-panel__icon"><i class="bi bi-journal-text"></i></span>
                                    <span>
                                        <strong>Lịch sử hệ thống</strong>
                                        <small>Theo dõi các thay đổi quan trọng</small>
                                    </span>
                                </a>
                            }
                            @if (canManageKnowledgeDocuments)
                            {
                                <a href="/KnowledgeDocuments" class="settings-panel__item">
                                    <span class="settings-panel__icon"><i class="bi bi-database-fill-lock"></i></span>
                                    <span>
                                        <strong>Vận hành AI và RAG</strong>
                                        <small>Hàng đợi check-in, upload, ACL và trạng thái RAG</small>
                                    </span>
                                </a>
                            }
                        </div>
                    }

                    @if (canOpenCatalog || canOpenPlatformAdminTools)
                    {
                        <div class="settings-panel__section">
                            <div class="settings-panel__label">Quản trị</div>
                            @if (canOpenCatalog)
                            {
                                <a href="/Catalog" class="settings-panel__item">
                                    <span class="settings-panel__icon"><i class="bi bi-collection-fill"></i></span>
                                    <span>
                                        <strong>Danh mục nền</strong>
