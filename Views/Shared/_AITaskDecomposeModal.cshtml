        border: 1px solid var(--card-border);
        border-radius: 8px;
        background: var(--surface-paper, #f8f9fa);
        color: var(--text-secondary);
        font-size: 0.76rem;
        font-weight: 700;
    }

    .ai-task-meta-chip span {
        overflow: hidden;
