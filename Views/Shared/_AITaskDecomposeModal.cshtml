        }

        .ai-task-review-pill {
            justify-content: center;
            white-space: normal;
        }

        .ai-task-preview-actions {
            justify-content: stretch;
        }

        .ai-task-preview-actions > * {
            flex: 1 1 auto;
            justify-content: center;
        }

        .ai-task-meta-grid {
