@{
    ViewData["Title"] = "Từ chối truy cập";
    Layout = null; // Ẩn layout gốc để hiện trang lỗi full màn hình
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<main class="access-denied-page d-flex align-items-center justify-content-center min-vh-100 bg-light p-3">
    <div class="access-denied-card text-center bg-white shadow-sm rounded-4 p-4 p-md-5" role="alert">
        <div class="display-1 text-danger mb-3">
            <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
        </div>
        <h1 class="h2 mb-3 fw-bold">Từ Chối Truy Cập</h1>
        <p class="text-muted lead mb-4">Xin lỗi, bạn không có quyền (Role) để xem hoặc thực hiện chức năng này.</p>
        <a href="/Dashboard/Index" class="btn btn-primary px-4 py-2 rounded-3">
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i> Về trang chủ
        </a>
    </div>
</main>
<style>
    .access-denied-card { width: min(100%, 560px); }
    .access-denied-card p { max-width: 46ch; }
    .access-denied-card .btn { min-height: 44px; }
</style>
