@{
    ViewData["Title"] = "Từ chối truy cập";
    ViewData["IsLoginPage"] = true;
}
<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<main class="auth-page">
    <partial name="_AuthBrandPanel" />
    <section class="auth-form-panel" aria-labelledby="access-denied-title">
        <a href="/" class="auth-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Về trang chủ</a>
        <div class="auth-card">
            <div class="auth-mobile-brand" aria-label="VietMach System, Manage KPI &amp; OKR"><span class="auth-brand-mark" aria-hidden="true"><i class="bi bi-bullseye"></i></span><span><strong>VietMach System</strong><small>Manage KPI &amp; OKR</small></span></div>
            <div class="auth-status-icon auth-status-icon-danger" aria-hidden="true"><i class="bi bi-shield-lock"></i></div>
            <header class="auth-header"><p class="auth-eyebrow">Quyền truy cập</p><h1 id="access-denied-title">Bạn không có quyền truy cập</h1><p>Tài khoản hiện tại chưa được cấp quyền xem hoặc thực hiện chức năng này.</p></header>
            <div class="auth-status-actions"><a href="/Dashboard/Index" class="auth-submit"><i class="bi bi-grid" aria-hidden="true"></i><span>Về trang tổng quan</span></a><a asp-action="Logout" class="auth-secondary">Đăng xuất</a></div>
        </div>
    </section>
</main>
