@{
    ViewData["Title"] = "Từ chối truy cập";
    ViewData["IsLoginPage"] = true;
}

<main class="auth-status-page access-denied-page d-flex align-items-center justify-content-center min-vh-100 p-3">
    <section class="auth-status-card card text-center" role="alert" aria-labelledby="access-denied-title">
        <div class="card-body p-4 p-md-5">
        <div class="auth-status-icon text-danger mb-3">
            <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
        </div>
        <span class="badge bg-danger-subtle text-danger mb-3">Quyền truy cập</span>
        <h1 id="access-denied-title" class="h3 mb-2">Bạn không có quyền truy cập</h1>
        <p class="text-muted mb-4">Tài khoản hiện tại chưa được cấp quyền xem hoặc thực hiện chức năng này.</p>
        <a href="/Dashboard/Index" class="btn btn-primary">
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Về trang tổng quan
        </a>
        </div>
    </section>
</main>
