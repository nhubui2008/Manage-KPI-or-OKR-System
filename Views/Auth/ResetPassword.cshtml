@model Manage_KPI_or_OKR_System.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["IsLoginPage"] = true;
}
<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<main class="auth-page">
    <partial name="_AuthBrandPanel" />
    <section class="auth-form-panel" aria-labelledby="reset-title">
        <a asp-action="Login" class="auth-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Quay lại đăng nhập</a>
        <div class="auth-card">
            <div class="auth-mobile-brand" aria-label="VietMach System, Manage KPI &amp; OKR"><span class="auth-brand-mark" aria-hidden="true"><i class="bi bi-bullseye"></i></span><span><strong>VietMach System</strong><small>Manage KPI &amp; OKR</small></span></div>
            <header class="auth-header"><h1 id="reset-title">Đặt lại mật khẩu</h1><p>Chọn mật khẩu mới để bảo vệ tài khoản của bạn.</p></header>
            @if (ViewBag.Error != null)
            {
                <div class="auth-alert auth-alert-danger" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>@ViewBag.Error</span></div>
            }
            <form asp-action="ResetPassword" method="post" class="auth-form" id="resetPasswordForm">
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-danger registration-validation-summary" role="alert"></div>
                <div class="auth-field"><label asp-for="NewPassword">Mật khẩu mới</label><div class="auth-password-wrap"><input asp-for="NewPassword" class="auth-control" autocomplete="new-password" placeholder="Nhập mật khẩu mới" aria-describedby="newPasswordValidation newPasswordHint" /><button type="button" class="auth-password-toggle" aria-label="Hiện mật khẩu" aria-controls="NewPassword" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="NewPassword" id="newPasswordValidation" class="auth-field-error" aria-live="polite"></span><small class="auth-hint" id="newPasswordHint">Từ 6 đến 128 ký tự và không chứa khoảng trắng.</small></div>
                <div class="auth-field"><label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label><div class="auth-password-wrap"><input asp-for="ConfirmPassword" class="auth-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" aria-describedby="confirmPasswordValidation" /><button type="button" class="auth-password-toggle" aria-label="Hiện mật khẩu xác nhận" aria-controls="ConfirmPassword" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="ConfirmPassword" id="confirmPasswordValidation" class="auth-field-error" aria-live="polite"></span></div>
                <button type="submit" class="auth-submit"><span class="button-text">Lưu mật khẩu mới</span><span class="button-loader" aria-hidden="true"><span class="auth-spinner"></span></span></button>
            </form>
        </div>
    </section>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/login.js" asp-append-version="true"></script> }
