@model Manage_KPI_or_OKR_System.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["IsLoginPage"] = true;
}
<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="crystal-scene-container" id="crystalScene">
    <!-- Ambient Glow -->
    <div class="crystal-ambient-glow" aria-hidden="true">
        <div class="ambient-orb ambient-orb-1"></div>
        <div class="ambient-orb ambient-orb-2"></div>
        <div class="ambient-orb ambient-orb-3"></div>
    </div>

    <!-- Floating Crystals -->
    <div class="crystal-objects-layer" aria-hidden="true">
        <div class="crystal-item crystal-1" data-depth="0.045">
            <svg viewBox="0 0 140 210" fill="none"><polygon points="70,10 125,75 105,185 35,160 15,65" fill="#c7d2fe" opacity="0.85" stroke="#fff" stroke-width="1.2" /><polygon points="70,10 85,95 35,160 15,65" fill="#bae6fd" opacity="0.9" stroke="#fff" stroke-width="1" /></svg>
        </div>
        <div class="crystal-item crystal-2" data-depth="0.06">
            <svg viewBox="0 0 155 250" fill="none"><polygon points="75,10 135,60 145,190 85,240 20,180 15,70" fill="#e0e7ff" opacity="0.85" stroke="#fff" stroke-width="1.2" /><polygon points="75,10 95,90 85,240 20,180 15,70" fill="#fbcfe8" opacity="0.8" stroke="#fff" stroke-width="1" /></svg>
        </div>
        <div class="crystal-sparkle sparkle-1"></div>
    </div>

    <!-- Top Nav -->
    <nav class="auth-top-nav" aria-label="Điều hướng phụ">
        <a asp-action="Login" class="auth-back-capsule" aria-label="Quay lại đăng nhập">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại đăng nhập</span>
        </a>
    </nav>

    <!-- Main Card -->
    <main class="auth-main-wrapper" id="authMainCard">
        <div class="auth-brand-badge-wrap">
            <a href="/" class="auth-crystal-badge" aria-label="NextGen System - Trang chủ" title="NextGen System">
                <i class="bi bi-shield-lock" aria-hidden="true"></i>
            </a>
        </div>

        <section class="auth-crystal-card" aria-labelledby="reset-title">
            <header class="auth-card-header">
                <h1 id="reset-title">Đặt lại mật khẩu</h1>
                <p>Chọn mật khẩu mới an toàn để tiếp tục sử dụng hệ thống.</p>
            </header>

            @if (ViewBag.Error != null)
            {
                <div class="auth-alert auth-alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-action="ResetPassword" method="post" class="auth-form" id="resetPasswordForm">
                @Html.AntiForgeryToken()
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-danger registration-validation-summary" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="NewPassword">Mật khẩu mới</label>
                    <div class="auth-input-wrapper auth-password-wrap">
                        <i class="bi bi-shield-lock auth-input-icon" aria-hidden="true"></i>
                        <input asp-for="NewPassword" class="auth-control" autocomplete="new-password" placeholder="Nhập mật khẩu mới" aria-describedby="newPasswordValidation newPasswordHint" />
                        <button type="button" class="auth-password-toggle" aria-label="Hiện mật khẩu" aria-controls="NewPassword" aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" id="newPasswordValidation" class="auth-field-error" aria-live="polite"></span>
                    <small class="auth-hint" id="newPasswordHint">Từ 6 đến 128 ký tự và không chứa khoảng trắng.</small>
                </div>

                <div class="auth-field">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                    <div class="auth-input-wrapper auth-password-wrap">
                        <i class="bi bi-shield-check auth-input-icon" aria-hidden="true"></i>
                        <input asp-for="ConfirmPassword" class="auth-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" aria-describedby="confirmPasswordValidation" />
                        <button type="button" class="auth-password-toggle" id="confirmPasswordToggle" aria-label="Hiện mật khẩu xác nhận" aria-controls="ConfirmPassword" aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" id="confirmPasswordValidation" class="auth-field-error" aria-live="polite"></span>
                </div>

                <button type="submit" class="auth-submit-btn">
                    <span class="button-text">Lưu mật khẩu mới</span>
                    <span class="button-loader" aria-hidden="true"><span class="auth-spinner"></span></span>
                </button>
            </form>
        </section>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}
