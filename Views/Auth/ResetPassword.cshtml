@model Manage_KPI_or_OKR_System.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["IsLoginPage"] = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-sm-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-shield-lock-fill text-primary fs-1" aria-hidden="true"></i>
                        <h1 class="h3 mt-3 mb-2">Đặt lại mật khẩu</h1>
                        <p class="text-muted mb-0">Chọn mật khẩu mới cho tài khoản của bạn.</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@ViewBag.Error
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post" novalidate>
                        <input asp-for="Token" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Ít nhất 6 ký tự" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>Lưu mật khẩu mới
                        </button>
                    </form>

                    <p class="text-center mb-0 mt-4">
                        <a asp-action="Login">Quay lại đăng nhập</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
