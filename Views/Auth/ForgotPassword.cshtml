@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["IsLoginPage"] = true;
    var errorMessage = TempData["ErrorMessage"] as string;
}
<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="crystal-scene-container" id="crystalScene">
    <!-- Ambient Glow -->
    <div class="crystal-ambient-glow" aria-hidden="true">
        <div class="ambient-orb ambient-orb-1"></div>
        <div class="ambient-orb ambient-orb-2"></div>
        <div class="ambient-orb ambient-orb-3"></div>
    </div>

    <!-- Floating Crystals -->
    <div class="crystal-objects-layer" aria-hidden="true">
        <div class="crystal-item crystal-1" data-depth="0.045">
            <svg viewBox="0 0 140 210" fill="none"><polygon points="70,10 125,75 105,185 35,160 15,65" fill="#c7d2fe" opacity="0.85" stroke="#fff" stroke-width="1.2" /><polygon points="70,10 85,95 35,160 15,65" fill="#bae6fd" opacity="0.9" stroke="#fff" stroke-width="1" /></svg>
        </div>
        <div class="crystal-item crystal-2" data-depth="0.06">
            <svg viewBox="0 0 155 250" fill="none"><polygon points="75,10 135,60 145,190 85,240 20,180 15,70" fill="#e0e7ff" opacity="0.85" stroke="#fff" stroke-width="1.2" /><polygon points="75,10 95,90 85,240 20,180 15,70" fill="#fbcfe8" opacity="0.8" stroke="#fff" stroke-width="1" /></svg>
        </div>
        <div class="crystal-item crystal-6" data-depth="0.055">
            <svg viewBox="0 0 130 190" fill="none"><polygon points="65,12 115,65 95,175 30,145 15,55" fill="#ddd6fe" opacity="0.85" stroke="#fff" stroke-width="1.2" /></svg>
        </div>
        <div class="crystal-sparkle sparkle-1"></div>
        <div class="crystal-sparkle sparkle-2"></div>
    </div>

    <!-- Top Nav -->
    <nav class="auth-top-nav" aria-label="Điều hướng phụ">
        <a asp-action="Login" class="auth-back-capsule" aria-label="Quay lại trang đăng nhập">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại đăng nhập</span>
        </a>
    </nav>

    <!-- Main Card -->
    <main class="auth-main-wrapper" id="authMainCard">
        <div class="auth-brand-badge-wrap">
            <a href="/" class="auth-crystal-badge" aria-label="VietMach System - Trang chủ" title="VietMach System">
                <i class="bi bi-key" aria-hidden="true"></i>
            </a>
        </div>

        <section class="auth-crystal-card" aria-labelledby="forgot-title">
            <header class="auth-card-header">
                <h1 id="forgot-title">Quên mật khẩu?</h1>
                <p>Nhập email đã đăng ký. Hệ thống sẽ gửi liên kết đặt lại mật khẩu an toàn.</p>
            </header>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="auth-alert auth-alert-success" role="status">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                    <span>@successMessage</span>
                </div>
            }
            @if (ViewBag.Error != null || errorMessage != null)
            {
                <div class="auth-alert auth-alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                    <span>@(ViewBag.Error ?? errorMessage)</span>
                </div>
            }

            <form asp-action="ForgotPassword" method="post" class="auth-form" id="forgotPasswordForm">
                @Html.AntiForgeryToken()
                <div class="auth-field">
                    <label for="email">Email đã đăng ký</label>
                    <div class="auth-input-wrapper">
                        <i class="bi bi-envelope auth-input-icon" aria-hidden="true"></i>
                        <input class="auth-control" type="email" id="email" name="email" required autocomplete="email" inputmode="email" placeholder="name@company.com" />
                    </div>
                </div>

                <button type="submit" class="auth-submit-btn">
                    <span class="button-text">Gửi liên kết đặt lại</span>
                    <span class="button-loader" aria-hidden="true"><span class="auth-spinner"></span></span>
                </button>
            </form>

            <footer class="auth-card-footer">
                <p class="auth-switch-text">
                    Bạn đã nhớ mật khẩu? <a asp-action="Login">Đăng nhập ngay</a>
                </p>
            </footer>
        </section>
    </main>
</div>

@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}
