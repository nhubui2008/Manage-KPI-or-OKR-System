@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["IsLoginPage"] = true;
    var errorMessage = TempData["ErrorMessage"] as string;
}
<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<main class="auth-page">
    <partial name="_AuthBrandPanel" />
    <section class="auth-form-panel" aria-labelledby="forgot-title">
        <a asp-action="Login" class="auth-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Quay lại đăng nhập</a>
        <div class="auth-card">
            <div class="auth-mobile-brand" aria-label="VietMach System, Manage KPI &amp; OKR"><span class="auth-brand-mark" aria-hidden="true"><i class="bi bi-bullseye"></i></span><span><strong>VietMach System</strong><small>Manage KPI &amp; OKR</small></span></div>
            <header class="auth-header"><h1 id="forgot-title">Quên mật khẩu?</h1><p>Nhập email đã đăng ký. Nếu tài khoản tồn tại, hệ thống sẽ gửi liên kết đặt lại mật khẩu dùng một lần.</p></header>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="auth-alert auth-alert-success" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i><span>@successMessage</span></div>
            }
            @if (ViewBag.Error != null || errorMessage != null)
            {
                <div class="auth-alert auth-alert-danger" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>@(ViewBag.Error ?? errorMessage)</span></div>
            }

            <form asp-action="ForgotPassword" method="post" class="auth-form" id="forgotPasswordForm">
                <div class="auth-field"><label for="email">Email đăng ký</label><input class="auth-control" type="email" id="email" name="email" required autocomplete="email" inputmode="email" placeholder="name@company.com" /></div>
                <button type="submit" class="auth-submit"><span class="button-text">Gửi liên kết đặt lại</span><span class="button-loader" aria-hidden="true"><span class="auth-spinner"></span></span></button>
            </form>
            <p class="auth-switch">Bạn đã nhớ mật khẩu? <a asp-action="Login">Đăng nhập</a></p>
        </div>
    </section>
</main>

@section Scripts { <script src="~/js/login.js" asp-append-version="true"></script> }
