@model Manage_KPI_or_OKR_System.Models.SystemUser
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var employee = ViewBag.EmployeeInfo as Manage_KPI_or_OKR_System.Models.Employee;
    var roleName = ViewBag.RoleName as string ?? "Người dùng";
    var displayName = !string.IsNullOrWhiteSpace(employee?.FullName)
        ? employee.FullName
        : !string.IsNullOrWhiteSpace(Model.Username) ? Model.Username : "Người dùng";
    var displayEmail = string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật email" : Model.Email;
    var avatarLetter = !string.IsNullOrWhiteSpace(displayName)
        ? displayName[0].ToString().ToUpperInvariant()
        : "U";
}

@section Styles {
    <link rel="stylesheet" href="~/css/my-profile.css" asp-append-version="true" />
}

<div class="my-profile-page-wrapper">
    <!-- PAGE HEADER -->
    <header class="mp-page-header">
        <div class="mp-header-left">
            <nav class="mp-breadcrumb" aria-label="Điều hướng">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span class="text-dark fw-medium" aria-current="page">Hồ sơ cá nhân</span>
            </nav>
            <div class="mp-title-row">
                <span class="mp-title-badge" aria-hidden="true">
                    <i class="bi bi-person-badge-fill"></i>
                </span>
                <h1 class="mp-header-title">Hồ sơ cá nhân</h1>
            </div>
            <p class="mp-header-desc">Quản lý thông tin tài khoản, hồ sơ nhân sự liên kết và tùy chọn ngôn ngữ trợ lý AI.</p>
        </div>

        <a asp-action="ChangePassword" asp-controller="Auth" class="mp-change-pwd-btn">
            <i class="bi bi-key-fill" aria-hidden="true"></i>
            <span>Đổi mật khẩu</span>
        </a>
    </header>

    <!-- 2-COLUMN BALANCED LAYOUT -->
    <div class="mp-layout">
        <!-- LEFT COLUMN: ACCOUNT PROFILE & AI SETTINGS -->
        <aside class="mp-card" aria-labelledby="summaryName">
            <div class="mp-card-header">
                <div class="mp-card-header-main">
                    <span class="mp-card-header-icon" aria-hidden="true">
                        <i class="bi bi-person-circle"></i>
                    </span>
                    <div class="mp-card-header-text">
                        <h2>Tài khoản hệ thống</h2>
                        <p>Thông tin đăng nhập & tùy chọn</p>
                    </div>
                </div>
            </div>

            <div class="mp-card-body">
                <!-- User Summary -->
                <div class="mp-summary-top">
                    <div class="mp-avatar-wrapper">
                        <div class="mp-avatar" aria-hidden="true">@avatarLetter</div>
                        @if (Model.IsActive == true)
                        {
                            <span class="mp-avatar-badge" title="Đang hoạt động"></span>
                        }
                    </div>

                    <h2 class="mp-summary-name" id="summaryName">@displayName</h2>
                    <p class="mp-summary-email">@displayEmail</p>
                    <div class="d-flex justify-content-center">
                        <span class="mp-role-pill">
                            <i class="bi bi-shield-fill-check" aria-hidden="true"></i>
                            <span>@roleName</span>
                        </span>
                    </div>
                </div>

                <!-- Account Meta Details -->
                <div class="mp-meta-list">
                    <div class="mp-meta-row">
                        <span class="mp-meta-label">Trạng thái</span>
                        <span class="mp-meta-value">
                            @if (Model.IsActive == true)
                            {
                                <span class="mp-status-badge mp-status-active">
                                    <span class="status-dot"></span>
                                    <span>Đang hoạt động</span>
                                </span>
                            }
                            else
                            {
                                <span class="mp-status-badge mp-status-locked">
                                    <i class="bi bi-lock-fill"></i>
                                    <span>Bị khóa</span>
                                </span>
                            }
                        </span>
                    </div>
                    <div class="mp-meta-row">
                        <span class="mp-meta-label">Tên đăng nhập</span>
                        <span class="mp-meta-value">@(string.IsNullOrWhiteSpace(Model.Username) ? "Chưa cập nhật" : Model.Username)</span>
                    </div>
                    <div class="mp-meta-row">
                        <span class="mp-meta-label">Ngày tham gia</span>
                        <span class="mp-meta-value">@(Model.CreatedAt?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                    </div>
                </div>

                <!-- AI Language Preference (Compact Section) -->
                <div class="mp-ai-section">
                    <div class="mp-ai-section-title">
                        <i class="bi bi-stars" aria-hidden="true"></i>
                        <span>Ngôn ngữ trợ lý AI</span>
                    </div>
                    <form asp-action="UpdateLanguage" asp-controller="Auth" method="post" id="language-preference-form">
                        @Html.AntiForgeryToken()
                        <div class="mp-lang-control-row">
                            <div class="mp-select-group">
                                <span class="mp-select-addon" aria-hidden="true">
                                    <i class="bi bi-translate"></i>
                                </span>
                                <select id="language-select" name="language" class="mp-select no-select2" aria-label="Chọn ngôn ngữ đầu ra của AI">
                                    <option value="Auto" selected="@(Model.PreferredLanguage == "Auto" ? "selected" : null)">Tự động theo câu hỏi</option>
                                    <option value="Tiếng Việt" selected="@(Model.PreferredLanguage == "Tiếng Việt" ? "selected" : null)">Tiếng Việt</option>
                                    <option value="English" selected="@(Model.PreferredLanguage == "English" ? "selected" : null)">English</option>
                                    <option value="中文 (Chinese)" selected="@(Model.PreferredLanguage == "中文 (Chinese)" ? "selected" : null)">中文 (Chinese)</option>
                                </select>
                            </div>
                            <button class="mp-btn-save" type="submit" id="btn-save-language" title="Lưu thay đổi ngôn ngữ" aria-label="Lưu ngôn ngữ">
                                <i class="bi bi-check2" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div id="language-feedback" class="mp-lang-feedback" role="status" aria-live="polite"></div>
                    </form>
                </div>
            </div>
        </aside>

        <!-- RIGHT COLUMN: EMPLOYEE PROFILE DETAILS -->
        <main class="mp-card" aria-labelledby="employeeInfoHeading">
            <div class="mp-card-header">
                <div class="mp-card-header-main">
                    <span class="mp-card-header-icon" aria-hidden="true">
                        <i class="bi bi-person-vcard-fill"></i>
                    </span>
                    <div class="mp-card-header-text">
                        <h2 id="employeeInfoHeading">Thông tin hồ sơ nhân sự</h2>
                        <p>Dữ liệu công việc được liên kết với tài khoản của bạn</p>
                    </div>
                </div>
                @if (employee != null)
                {
                    <span class="mp-verified-badge">
                        <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
                        <span>Đã liên kết</span>
                    </span>
                }
            </div>

            <div class="mp-card-body">
                @if (employee != null)
                {
                    <div class="mp-info-grid">
                        <div class="mp-info-tile">
                            <div class="mp-tile-icon icon-code">
                                <i class="bi bi-qr-code"></i>
                            </div>
                            <div class="mp-tile-text">
                                <span class="mp-tile-label">Mã nhân viên</span>
                                <span class="mp-tile-value">@(string.IsNullOrWhiteSpace(employee.EmployeeCode) ? "Chưa cập nhật" : employee.EmployeeCode)</span>
                            </div>
                        </div>

                        <div class="mp-info-tile">
                            <div class="mp-tile-icon icon-name">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <div class="mp-tile-text">
                                <span class="mp-tile-label">Họ và tên</span>
                                <span class="mp-tile-value">@(string.IsNullOrWhiteSpace(employee.FullName) ? "Chưa cập nhật" : employee.FullName)</span>
                            </div>
                        </div>

                        <div class="mp-info-tile">
                            <div class="mp-tile-icon icon-phone">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div class="mp-tile-text">
                                <span class="mp-tile-label">Số điện thoại</span>
                                <span class="mp-tile-value">@(string.IsNullOrWhiteSpace(employee.Phone) ? "Chưa cập nhật" : employee.Phone)</span>
                            </div>
                        </div>

                        <div class="mp-info-tile">
                            <div class="mp-tile-icon icon-email">
                                <i class="bi bi-envelope-at-fill"></i>
                            </div>
                            <div class="mp-tile-text">
                                <span class="mp-tile-label">Email công việc</span>
                                <span class="mp-tile-value">@(string.IsNullOrWhiteSpace(employee.Email) ? "Chưa cập nhật" : employee.Email)</span>
                            </div>
                        </div>

                        <div class="mp-info-tile">
                            <div class="mp-tile-icon icon-dob">
                                <i class="bi bi-calendar-heart-fill"></i>
                            </div>
                            <div class="mp-tile-text">
                                <span class="mp-tile-label">Ngày sinh</span>
                                <span class="mp-tile-value">@(employee.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                            </div>
                        </div>

                        <div class="mp-info-tile">
                            <div class="mp-tile-icon icon-join">
                                <i class="bi bi-building-fill-check"></i>
                            </div>
                            <div class="mp-tile-text">
                                <span class="mp-tile-label">Ngày vào làm</span>
                                <span class="mp-tile-value">@(employee.JoinDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                            </div>
                        </div>
                    </div>

                    <!-- System Sync Notice -->
                    <div class="mp-sync-notice">
                        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                        <span>Dữ liệu hồ sơ nhân sự được đồng bộ tự động từ hệ thống tổ chức. Để cập nhật thông tin, vui lòng liên hệ phòng Nhân sự.</span>
                    </div>
                }
                else
                {
                    <div class="mp-empty-employee" role="status">
                        <i class="bi bi-person-exclamation" aria-hidden="true"></i>
                        <div>
                            <h3>Chưa liên kết hồ sơ nhân viên</h3>
                            <p>Tài khoản hiện chưa được gắn với hồ sơ nhân sự trong hệ thống. Vui lòng liên hệ quản trị viên.</p>
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            'use strict';
            const form = document.getElementById('language-preference-form');
            const button = document.getElementById('btn-save-language');
            const feedback = document.getElementById('language-feedback');
            if (!form || !button || !feedback) return;

            const originalButtonHtml = button.innerHTML;

            form.addEventListener('submit', async event => {
                event.preventDefault();
                feedback.textContent = '';
                feedback.className = 'mp-lang-feedback';
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>';

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        credentials: 'same-origin',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const result = await response.json().catch(() => ({}));

                    if (!response.ok || result.success !== true) {
                        throw new Error(result.message || 'Không thể lưu ngôn ngữ lúc này.');
                    }

                    feedback.textContent = result.message || 'Đã lưu thành công!';
                    feedback.className = 'mp-lang-feedback is-success';
                } catch (error) {
                    feedback.textContent = error.message || 'Không thể lưu lúc này.';
                    feedback.className = 'mp-lang-feedback is-error';
                } finally {
                    button.disabled = false;
                    button.innerHTML = originalButtonHtml;
                    setTimeout(() => {
                        if (feedback.classList.contains('is-success')) {
                            feedback.textContent = '';
                        }
                    }, 4000);
                }
            });
        })();
    </script>
}
