@{
    ViewData["Title"] = "Đang chờ kích hoạt";
    ViewData["IsLoginPage"] = true;
}

<main class="auth-status-page container d-flex min-vh-100 align-items-center justify-content-center py-4">
        <section class="auth-status-card card w-100" aria-labelledby="pending-title">
            <div class="card-body p-4 p-md-5">
                <div class="auth-status-icon text-warning mb-3"><i class="bi bi-hourglass-split" aria-hidden="true"></i></div>
                <span class="badge bg-warning-subtle text-warning-emphasis mb-3">Chờ xác minh</span>
                <h1 id="pending-title" class="h3">Không gian làm việc đang chờ kích hoạt</h1>
                <p class="text-secondary mb-3">
                    Tài khoản <strong>@(ViewBag.Email ?? "của bạn")</strong> đã xác thực thành công.
                    Quản trị viên vẫn cần phê duyệt yêu cầu và cấp tenant trước khi bạn truy cập dữ liệu KPI/OKR.
                </p>
                @if (!string.IsNullOrWhiteSpace(ViewBag.PendingPlan as string))
                {
                    <p class="mb-4">Gói đang chờ: <strong>@ViewBag.PendingPlan</strong>.</p>
                }
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="PendingActivation" class="btn btn-primary">Kiểm tra lại trạng thái</a>
                    <form asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-secondary">Đăng xuất</button>
                    </form>
                </div>
            </div>
        </section>
</main>
