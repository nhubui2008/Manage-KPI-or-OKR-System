@model IReadOnlyList<Manage_KPI_or_OKR_System.Models.Tenancy.Tenant>
@{
    ViewData["Title"] = "Chọn không gian làm việc";
    ViewData["IsLoginPage"] = true;
    var returnUrl = ViewBag.ReturnUrl as string;
}
<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<main class="auth-page">
    <partial name="_AuthBrandPanel" />
    <section class="auth-form-panel" aria-labelledby="tenant-title">
        <div class="auth-card">
            <div class="auth-mobile-brand" aria-label="VietMach System, Manage KPI &amp; OKR"><span class="auth-brand-mark" aria-hidden="true"><i class="bi bi-bullseye"></i></span><span><strong>VietMach System</strong><small>Manage KPI &amp; OKR</small></span></div>
            <header class="auth-header"><p class="auth-eyebrow">Không gian làm việc</p><h1 id="tenant-title">Chọn nơi bạn muốn tiếp tục</h1><p>Mỗi không gian có dữ liệu và quyền truy cập độc lập.</p></header>
            @if (Model.Count == 0)
            {
                <div class="auth-alert auth-alert-warning" role="status"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Tài khoản chưa có membership đang hoạt động. Vui lòng liên hệ quản trị viên nền tảng.</span></div>
            }
            else
            {
                <div class="auth-tenant-list">
                    @foreach (var tenant in Model)
                    {
                        <form asp-action="SelectTenant" method="post"><input type="hidden" name="tenantId" value="@tenant.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" /><button type="submit" class="auth-tenant-button"><span><strong>@tenant.Name</strong><small>@tenant.Code</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i></button></form>
                    }
                </div>
            }
            <div class="auth-status-actions"><a asp-action="Logout" class="auth-secondary">Đăng xuất</a></div>
        </div>
    </section>
</main>
