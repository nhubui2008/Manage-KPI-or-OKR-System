@model IReadOnlyList<Manage_KPI_or_OKR_System.Models.Tenancy.Tenant>
@{
    ViewData["Title"] = "Chọn không gian làm việc";
    ViewData["IsLoginPage"] = true;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<main class="container py-5" style="max-width: 720px">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 mb-2">Chọn không gian làm việc</h1>
            <p class="text-muted mb-4">Mỗi không gian có dữ liệu và quyền truy cập độc lập.</p>

            @if (Model.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    Tài khoản chưa có membership đang hoạt động. Vui lòng liên hệ quản trị viên nền tảng.
                </div>
            }
            else
            {
                <div class="d-grid gap-3">
                    @foreach (var tenant in Model)
                    {
                        <form asp-action="SelectTenant" method="post">
                            <input type="hidden" name="tenantId" value="@tenant.Id" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-outline-primary w-100 text-start p-3">
                                <span class="fw-semibold d-block">@tenant.Name</span>
                                <span class="small text-muted">@tenant.Code</span>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</main>
