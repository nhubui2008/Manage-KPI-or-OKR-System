@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isForced = User.HasClaim("RequiresPasswordChange", "true");
}

@section Styles {
    <link rel="stylesheet" href="~/css/change-password.css" asp-append-version="true" />
}

<div class="change-password-page-wrapper">
    <!-- PAGE HEADER -->
    <header class="cp-page-header">
        <div class="cp-header-left">
            <nav class="cp-breadcrumb" aria-label="Điều hướng">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="MyProfile" asp-controller="Auth">Tài khoản</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span class="text-dark fw-medium" aria-current="page">Đổi mật khẩu</span>
            </nav>
            <div class="cp-title-row">
                <span class="cp-title-badge" aria-hidden="true">
                    <i class="bi bi-shield-lock-fill"></i>
                </span>
                <h1 class="cp-header-title">Đổi mật khẩu</h1>
            </div>
            <p class="cp-header-desc">Bảo vệ tài khoản và dữ liệu hệ thống bằng cách cập nhật mật khẩu định kỳ với độ phức tạp cao.</p>
        </div>

        @if (!isForced)
        {
            <a asp-action="MyProfile" asp-controller="Auth" class="cp-back-btn">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>Hồ sơ cá nhân</span>
            </a>
        }
    </header>

    <!-- MAIN 2-COLUMN GRID -->
    <div class="cp-grid-layout">
        <!-- LEFT COLUMN: FORM CARD -->
        <div class="cp-card">
            <div class="cp-card-header">
                <span class="cp-card-header-icon" aria-hidden="true">
                    <i class="bi bi-key-fill"></i>
                </span>
                <div class="cp-card-header-text">
                    <h2>Thông tin mật khẩu</h2>
                    <p>Xác nhận mật khẩu hiện tại trước khi thiết lập mật khẩu mới</p>
                </div>
            </div>

            <div class="cp-card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="cp-alert cp-alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                        <div>
                            <strong>Lỗi cập nhật:</strong> @ViewBag.Error
                        </div>
                    </div>
                }

                <form asp-action="ChangePassword" asp-controller="Auth" method="post" id="changePasswordForm" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <!-- CURRENT PASSWORD -->
                    <div class="cp-form-group">
                        <label for="oldPassword" class="cp-form-label">
                            <span>Mật khẩu hiện tại <span class="cp-required-star" aria-hidden="true">*</span></span>
                        </label>
                        <div class="cp-input-container">
                            <i class="bi bi-shield-lock cp-input-icon" aria-hidden="true"></i>
                            <input type="password" 
                                   id="oldPassword" 
                                   name="oldPassword" 
                                   class="cp-input" 
                                   required 
                                   maxlength="128" 
                                   autocomplete="current-password" 
                                   placeholder="Nhập mật khẩu bạn đang sử dụng" />
                            <button type="button" 
                                    class="cp-toggle-pwd" 
                                    data-target="oldPassword" 
                                    aria-label="Hiện mật khẩu hiện tại" 
                                    tabindex="-1">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <!-- NEW PASSWORD -->
                    <div class="cp-form-group">
                        <label for="newPassword" class="cp-form-label">
                            <span>Mật khẩu mới <span class="cp-required-star" aria-hidden="true">*</span></span>
                        </label>
                        <div class="cp-input-container">
                            <i class="bi bi-key cp-input-icon" aria-hidden="true"></i>
                            <input type="password" 
                                   id="newPassword" 
                                   name="newPassword" 
                                   class="cp-input" 
                                   required 
                                   minlength="6" 
                                   maxlength="128" 
                                   autocomplete="new-password" 
                                   placeholder="Tạo mật khẩu mới an toàn" />
                            <button type="button" 
                                    class="cp-toggle-pwd" 
                                    data-target="newPassword" 
                                    aria-label="Hiện mật khẩu mới" 
                                    tabindex="-1">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>

                        <!-- PASSWORD STRENGTH METER -->
                        <div class="cp-strength-wrapper strength-none" id="strengthWrapper">
                            <div class="cp-strength-header">
                                <span class="cp-strength-title">Độ mạnh mật khẩu</span>
                                <span class="cp-strength-badge" id="strengthBadge">Chưa nhập</span>
                            </div>
                            <div class="cp-strength-bars">
                                <div class="cp-strength-bar"></div>
                                <div class="cp-strength-bar"></div>
                                <div class="cp-strength-bar"></div>
                                <div class="cp-strength-bar"></div>
                            </div>
                        </div>
                    </div>

                    <!-- CONFIRM NEW PASSWORD -->
                    <div class="cp-form-group mb-0">
                        <label for="confirmPassword" class="cp-form-label">
                            <span>Xác nhận mật khẩu mới <span class="cp-required-star" aria-hidden="true">*</span></span>
                            <span class="cp-match-status" id="matchStatus" style="display: none;"></span>
                        </label>
                        <div class="cp-input-container">
                            <i class="bi bi-shield-check cp-input-icon" aria-hidden="true"></i>
                            <input type="password" 
                                   id="confirmPassword" 
                                   name="confirmPassword" 
                                   class="cp-input" 
                                   required 
                                   minlength="6" 
                                   maxlength="128" 
                                   autocomplete="new-password" 
                                   placeholder="Nhập lại mật khẩu mới vừa tạo" />
                            <button type="button" 
                                    class="cp-toggle-pwd" 
                                    data-target="confirmPassword" 
                                    aria-label="Hiện mật khẩu xác nhận" 
                                    tabindex="-1">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <!-- FORM ACTIONS -->
                    <div class="cp-actions">
                        @if (!isForced)
                        {
                            <a asp-action="MyProfile" asp-controller="Auth" class="cp-btn-cancel">Hủy</a>
                        }
                        <button type="submit" id="btnSubmitPassword" class="cp-btn-submit">
                            <i class="bi bi-check2-circle" aria-hidden="true"></i>
                            <span>Cập nhật mật khẩu</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT COLUMN: INTERACTIVE SECURITY CHECKLIST & GUIDELINES -->
        <aside class="cp-rules-card" aria-labelledby="rulesTitle">
            <div class="cp-card-header">
                <span class="cp-card-header-icon security-icon" aria-hidden="true">
                    <i class="bi bi-shield-check"></i>
                </span>
                <div class="cp-card-header-text">
                    <h2 id="rulesTitle">Quy tắc bảo mật</h2>
                    <p>Tiêu chuẩn giúp tài khoản luôn được an toàn</p>
                </div>
            </div>

            <div class="cp-card-body">
                <!-- LIVE CHECKLIST -->
                <ul class="cp-checklist" id="securityChecklist">
                    <li class="cp-checklist-item" id="ruleLength">
                        <span class="cp-check-icon-wrap" aria-hidden="true">
                            <i class="bi bi-circle"></i>
                        </span>
                        <span>Từ 6 đến 128 ký tự</span>
                    </li>
                    <li class="cp-checklist-item" id="ruleNoSpace">
                        <span class="cp-check-icon-wrap" aria-hidden="true">
                            <i class="bi bi-circle"></i>
                        </span>
                        <span>Không chứa ký tự khoảng trắng</span>
                    </li>
                    <li class="cp-checklist-item" id="ruleDifferent">
                        <span class="cp-check-icon-wrap" aria-hidden="true">
                            <i class="bi bi-circle"></i>
                        </span>
                        <span>Khác với mật khẩu hiện tại</span>
                    </li>
                    <li class="cp-checklist-item" id="ruleMatch">
                        <span class="cp-check-icon-wrap" aria-hidden="true">
                            <i class="bi bi-circle"></i>
                        </span>
                        <span>Mật khẩu xác nhận trùng khớp</span>
                    </li>
                </ul>

                <!-- INFO CALLOUT -->
                <div class="cp-info-callout">
                    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                    <div>
                        <strong>Lưu ý bảo mật:</strong> Phiên đăng nhập hiện tại sẽ được tự động làm mới và đồng bộ sau khi cập nhật thành công.
                    </div>
                </div>

                @if (isForced)
                {
                    <div class="cp-forced-callout">
                        <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
                        <div>
                            <strong>Bắt buộc:</strong> Bạn cần hoàn tất bước đổi mật khẩu này trước khi có thể truy cập các tính năng khác của hệ thống.
                        </div>
                    </div>
                }
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            'use strict';

            // Elements
            const form = document.getElementById('changePasswordForm');
            const submitBtn = document.getElementById('btnSubmitPassword');
            const oldPassInput = document.getElementById('oldPassword');
            const newPassInput = document.getElementById('newPassword');
            const confirmPassInput = document.getElementById('confirmPassword');
            
            const strengthWrapper = document.getElementById('strengthWrapper');
            const strengthBadge = document.getElementById('strengthBadge');
            const matchStatus = document.getElementById('matchStatus');
            
            const ruleLength = document.getElementById('ruleLength');
            const ruleNoSpace = document.getElementById('ruleNoSpace');
            const ruleDifferent = document.getElementById('ruleDifferent');
            const ruleMatch = document.getElementById('ruleMatch');

            // 1. Password Visibility Toggle
            document.querySelectorAll('.cp-toggle-pwd').forEach(button => {
                button.addEventListener('click', () => {
                    const targetId = button.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    if (!input) return;

                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    
                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
                    }
                    button.setAttribute('aria-label', isPassword ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
                });
            });

            // 2. Password Strength Evaluation
            function calculateStrength(pwd) {
                if (!pwd) return 0;
                let score = 0;
                
                // Length check
                if (pwd.length >= 6) score += 1;
                if (pwd.length >= 10) score += 1;
                
                // Complexity checks
                const hasLower = /[a-z]/.test(pwd);
                const hasUpper = /[A-Z]/.test(pwd);
                const hasNumber = /[0-9]/.test(pwd);
                const hasSpecial = /[^A-Za-z0-9]/.test(pwd);
                
                const varietyCount = [hasLower, hasUpper, hasNumber, hasSpecial].filter(Boolean).length;
                if (varietyCount >= 2 && pwd.length >= 6) score += 1;
                if (varietyCount >= 3 && pwd.length >= 8) score += 1;
                
                return Math.min(score, 4);
            }

            function updateStrengthMeter(pwd) {
                if (!strengthWrapper || !strengthBadge) return;
                
                strengthWrapper.className = 'cp-strength-wrapper';
                
                if (!pwd) {
                    strengthWrapper.classList.add('strength-none');
                    strengthBadge.textContent = 'Chưa nhập';
                    return;
                }
                
                const strength = calculateStrength(pwd);
                switch (strength) {
                    case 1:
                        strengthWrapper.classList.add('strength-weak');
                        strengthBadge.textContent = 'Yếu';
                        break;
                    case 2:
                        strengthWrapper.classList.add('strength-fair');
                        strengthBadge.textContent = 'Trung bình';
                        break;
                    case 3:
                        strengthWrapper.classList.add('strength-good');
                        strengthBadge.textContent = 'Khá tốt';
                        break;
                    case 4:
                        strengthWrapper.classList.add('strength-strong');
                        strengthBadge.textContent = 'Rất mạnh';
                        break;
                    default:
                        strengthWrapper.classList.add('strength-none');
                        strengthBadge.textContent = 'Chưa nhập';
                }
            }

            // 3. Update Rule Status Helper
            function updateRule(element, isPassed) {
                if (!element) return;
                const iconWrap = element.querySelector('.cp-check-icon-wrap i');
                if (isPassed) {
                    element.classList.add('is-passed');
                    if (iconWrap) iconWrap.className = 'bi bi-check-lg';
                } else {
                    element.classList.remove('is-passed');
                    if (iconWrap) iconWrap.className = 'bi bi-circle';
                }
            }

            // 4. Validate All Live Rules
            function validateRules() {
                const oldVal = oldPassInput ? oldPassInput.value : '';
                const newVal = newPassInput ? newPassInput.value : '';
                const confirmVal = confirmPassInput ? confirmPassInput.value : '';

                // Rule 1: Length between 6 and 128
                const isLengthValid = newVal.length >= 6 && newVal.length <= 128;
                updateRule(ruleLength, isLengthValid);

                // Rule 2: No whitespace
                const isNoSpaceValid = newVal.length > 0 && !/\s/.test(newVal);
                updateRule(ruleNoSpace, isNoSpaceValid);

                // Rule 3: Different from current password
                const isDifferentValid = newVal.length > 0 && oldVal.length > 0 && newVal !== oldVal;
                updateRule(ruleDifferent, isDifferentValid);

                // Rule 4: Confirmation match
                const isMatchValid = newVal.length > 0 && confirmVal.length > 0 && newVal === confirmVal;
                updateRule(ruleMatch, isMatchValid);

                // Update Match Status Indicator
                if (matchStatus) {
                    if (!confirmVal) {
                        matchStatus.style.display = 'none';
                        confirmPassInput.classList.remove('is-valid-field', 'is-invalid-field');
                    } else if (isMatchValid) {
                        matchStatus.style.display = 'inline-flex';
                        matchStatus.className = 'cp-match-status matched';
                        matchStatus.innerHTML = '<i class="bi bi-check-circle-fill"></i> Mật khẩu trùng khớp';
                        confirmPassInput.classList.add('is-valid-field');
                        confirmPassInput.classList.remove('is-invalid-field');
                    } else {
                        matchStatus.style.display = 'inline-flex';
                        matchStatus.className = 'cp-match-status unmatched';
                        matchStatus.innerHTML = '<i class="bi bi-x-circle-fill"></i> Chưa trùng khớp';
                        confirmPassInput.classList.add('is-invalid-field');
                        confirmPassInput.classList.remove('is-valid-field');
                    }
                }

                // Update strength meter
                updateStrengthMeter(newVal);
            }

            // Event Listeners for Live Inputs
            if (oldPassInput) oldPassInput.addEventListener('input', validateRules);
            if (newPassInput) newPassInput.addEventListener('input', validateRules);
            if (confirmPassInput) confirmPassInput.addEventListener('input', validateRules);

            // 5. Submit Form State
            if (form && submitBtn) {
                form.addEventListener('submit', (e) => {
                    const newVal = newPassInput ? newPassInput.value : '';
                    const confirmVal = confirmPassInput ? confirmPassInput.value : '';

                    if (newVal !== confirmVal) {
                        e.preventDefault();
                        if (confirmPassInput) confirmPassInput.focus();
                        return;
                    }

                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> <span>Đang cập nhật...</span>';
                });
            }
        })();
    </script>
}
