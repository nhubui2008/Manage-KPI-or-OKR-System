@inject Manage_KPI_or_OKR_System.Services.ISystemSettingsService SystemSettingsService
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
    var branding = await SystemSettingsService.GetBrandingAsync();
}

<style>
    body, html {
        margin: 0; padding: 0; height: 100%;
        background-color: #f8fafc; font-family: 'Inter', sans-serif;
    }
    .cp-container {
        display: flex; align-items: center; justify-content: center;
        min-height: 100vh; padding: 1.5rem;
    }
    .reg-modal-premium {
        display: flex; width: 100%; max-width: 900px; min-height: 500px;
        background: #ffffff; border-radius: 20px; overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }
    .reg-modal-left {
        flex: 1; background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%);
        color: white; padding: 3rem; position: relative; overflow: hidden;
        display: flex; flex-direction: column; justify-content: center;
    }
    .reg-modal-brand { font-size: 1.2rem; font-weight: 700; letter-spacing: 1px; margin-bottom: 2rem; color: #e0e7ff; display: flex; align-items: center; gap: 0.5rem; }
    .reg-modal-left h2 { font-size: 2.2rem; font-weight: 800; margin-bottom: 1rem; color: white; line-height: 1.2; }
    .reg-modal-left p { font-size: 1.05rem; color: #c7d2fe; margin-bottom: 2rem; line-height: 1.6; }
    .reg-modal-benefits { list-style: none; padding: 0; margin: 0; }
    .reg-modal-benefits li { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem; font-size: 1rem; color: #e0e7ff; }
    .reg-modal-benefits li i { color: #10b981; font-size: 1.2rem; background: rgba(16, 185, 129, 0.1); border-radius: 50%; padding: 2px; }
    .reg-modal-bg-blob {
        position: absolute; width: 300px; height: 300px; background: rgba(99, 102, 241, 0.3);
        border-radius: 50%; filter: blur(40px); bottom: -100px; left: -100px; pointer-events: none;
    }
    .reg-modal-right { flex: 1.2; padding: 3rem; position: relative; background: #ffffff; display: flex; flex-direction: column; justify-content: center; }
    .reg-form-container h3 { font-size: 1.8rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem; }
    .reg-form-subtitle { color: #64748b; margin-bottom: 2rem; font-size: 1rem; }
    .form-group { margin-bottom: 1.2rem; }
    .reg-modal-right label { display: block; font-weight: 600; color: #334155; margin-bottom: 0.5rem; font-size: 0.9rem; }
    .input-icon-wrapper { position: relative; display: flex; align-items: center; }
    .input-icon-wrapper i { position: absolute; left: 1rem; color: #94a3b8; font-size: 1.1rem; }
    .input-icon-wrapper input {
        width: 100%; padding: 0.85rem 1rem 0.85rem 2.8rem; border: 1px solid #cbd5e1;
        border-radius: 10px; font-size: 1rem; color: #0f172a; transition: all 0.2s;
        background: #f8fafc; margin: 0; box-sizing: border-box;
    }
    .input-icon-wrapper input:focus { border-color: #4f46e5; background: #ffffff; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1); outline: none; }
    .btn-primary-lg {
        display: inline-flex; align-items: center; gap: 10px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white !important; padding: 1rem 2rem; border-radius: 10px;
        font-weight: 700; font-size: 1.05rem; text-decoration: none;
        transition: all 0.3s; border: none; box-shadow: 0 8px 24px rgba(79,70,229,0.3);
    }
    .btn-primary-lg:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(79,70,229,0.4); }
    .alert-error {
        background: #fef2f2; border-left: 4px solid #ef4444; color: #991b1b;
        padding: 0.75rem 1rem; border-radius: 0 8px 8px 0; margin-bottom: 1.5rem;
        display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; font-weight: 500;
    }
    @@media (max-width: 768px) {
        .reg-modal-premium { flex-direction: column; min-height: auto; }
        .reg-modal-left { padding: 2rem; }
        .reg-modal-right { padding: 2rem; }
    }
</style>

<div class="cp-container">
    <div class="reg-modal-premium">
        <div class="reg-modal-left">
            <div class="reg-modal-brand">
                <i class="bi bi-hexagon-fill"></i> VIETMACH
            </div>
            <h2>Đổi Mật Khẩu</h2>
            <p>Bảo mật tài khoản của bạn để tiếp tục trải nghiệm hệ thống Quản trị Hiệu suất Toàn diện (OKR/KPI).</p>
            <ul class="reg-modal-benefits">
                <li><i class="bi bi-shield-check"></i> An toàn dữ liệu tuyệt đối</li>
                <li><i class="bi bi-key-fill"></i> Mật khẩu mạnh & bảo vệ</li>
                <li><i class="bi bi-check-circle-fill"></i> Cập nhật nhanh chóng</li>
            </ul>
            <div class="reg-modal-bg-blob"></div>
        </div>
        <div class="reg-modal-right">
            <div class="reg-form-container">
                <h3>Bảo mật tài khoản</h3>
                <p class="reg-form-subtitle">Vui lòng nhập mật khẩu mới để tiếp tục sử dụng hệ thống.</p>
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert-error">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        @ViewBag.Error
                    </div>
                }

                <form asp-action="ChangePassword" method="post" id="changePasswordForm" onsubmit="document.getElementById('btnSubmit').innerHTML = '<i class=\'spinner-border spinner-border-sm\'></i> Đang xử lý...'; document.getElementById('btnSubmit').disabled = true;">
                    <div class="form-group">
                        <label for="oldPassword">Mật khẩu hiện tại</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-unlock"></i>
                            <input type="password" id="oldPassword" name="oldPassword" required placeholder="Nhập mật khẩu hiện tại" />
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="newPassword">Mật khẩu mới</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-key"></i>
                            <input type="password" id="newPassword" name="newPassword" required placeholder="Nhập mật khẩu mới" />
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="confirmPassword">Xác nhận mật khẩu mới</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-shield-lock"></i>
                            <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="Nhập lại mật khẩu mới" />
                        </div>
                    </div>
                    
                    <button type="submit" id="btnSubmit" class="btn-primary-lg w-100 mt-4" style="justify-content: center; cursor: pointer;">
                        <i class="bi bi-check-circle-fill"></i> Cập nhật Mật khẩu
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a href="/" style="color: #64748b; text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#4f46e5'" onmouseout="this.style.color='#64748b'">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
