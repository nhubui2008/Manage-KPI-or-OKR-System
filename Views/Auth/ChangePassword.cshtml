@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isForced = User.HasClaim("RequiresPasswordChange", "true");
}

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <style>
        .change-password-input-wrap {
            position: relative;
        }

        .change-password-input-icon {
            position: absolute;
            top: 50%;
            left: 0.9rem;
            color: var(--cf-muted);
            transform: translateY(-50%);
            pointer-events: none;
        }

        .change-password-input-wrap input {
            padding-left: 2.35rem;
            padding-right: 2.85rem;
        }

        .change-password-toggle {
            position: absolute;
            top: 50%;
            right: 0.45rem;
            display: grid;
            place-items: center;
            width: 32px;
            height: 32px;
            border: 0;
            border-radius: 6px;
            background: transparent;
            color: var(--cf-muted);
            transform: translateY(-50%);
        }

        .change-password-toggle:hover,
        .change-password-toggle:focus-visible {
            background: var(--cf-soft-accent);
            color: var(--cf-accent);
        }

        .change-password-alert {
            display: flex;
            align-items: flex-start;
            gap: 0.6rem;
        }

        .cf-guide__note.change-password-forced-note {
            margin-top: 0.75rem;
            color: var(--cf-danger);
        }

        .cf-guide__note.change-password-forced-note i {
            color: var(--cf-danger);
        }
    </style>
}

<div class="cf-page change-password-page">
    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Đổi mật khẩu</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Đổi mật khẩu</span>
            </nav>
            <p class="cf-header__description">Bảo mật tài khoản của bạn bằng cách thiết lập một mật khẩu mạnh và không trùng lặp.</p>
        </div>
        @if (!isForced)
        {
            <a asp-action="MyProfile" asp-controller="Auth" class="cf-back-action">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>Hồ sơ cá nhân</span>
            </a>
        }
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="changePasswordHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="changePasswordHeading">Bảo mật tài khoản</h2>
                    <p>Xác nhận mật khẩu hiện tại trước khi thiết lập mật khẩu mới.</p>
                </div>
            </div>

            <form asp-action="ChangePassword" asp-controller="Auth" method="post" id="changePasswordForm" class="cf-form">
                @if (ViewBag.Error != null)
                {
                    <div class="cf-alert change-password-alert" role="alert">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <section class="cf-section" aria-labelledby="passwordSectionHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-shield-lock"></i></span>
                        <div>
                            <h3 id="passwordSectionHeading">Thay đổi mật khẩu</h3>
                            <p>Nhập mật khẩu hiện tại và chọn một mật khẩu mới an toàn.</p>
                        </div>
                    </div>

                    <div class="cf-field-grid">
                        <div class="cf-field cf-field--full">
                            <label for="oldPassword">Mật khẩu hiện tại <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <div class="change-password-input-wrap">
                                <i class="bi bi-lock change-password-input-icon" aria-hidden="true"></i>
                                <input type="password" id="oldPassword" name="oldPassword" class="form-control cf-control" required maxlength="128" autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại" />
                                <button type="button" class="change-password-toggle" data-password-toggle="oldPassword" aria-controls="oldPassword" aria-label="Hiện mật khẩu hiện tại" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
                            </div>
                        </div>

                        <div class="cf-field">
                            <label for="newPassword">Mật khẩu mới <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <div class="change-password-input-wrap">
                                <i class="bi bi-key change-password-input-icon" aria-hidden="true"></i>
                                <input type="password" id="newPassword" name="newPassword" class="form-control cf-control" required minlength="6" maxlength="128" autocomplete="new-password" aria-describedby="newPasswordHint" placeholder="Nhập mật khẩu mới" />
                                <button type="button" class="change-password-toggle" data-password-toggle="newPassword" aria-controls="newPassword" aria-label="Hiện mật khẩu mới" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
                            </div>
                            <p class="cf-hint" id="newPasswordHint">6–128 ký tự, không có khoảng trắng.</p>
                        </div>

                        <div class="cf-field">
                            <label for="confirmPassword">Xác nhận mật khẩu mới <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <div class="change-password-input-wrap">
                                <i class="bi bi-shield-check change-password-input-icon" aria-hidden="true"></i>
                                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control cf-control" required minlength="6" maxlength="128" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                                <button type="button" class="change-password-toggle" data-password-toggle="confirmPassword" aria-controls="confirmPassword" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="cf-actions">
                    @if (!isForced)
                    {
                        <a asp-action="MyProfile" asp-controller="Auth" class="cf-secondary-action">Hủy</a>
                    }
                    <button type="submit" id="btnSubmit" class="cf-primary-action">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span>Cập nhật mật khẩu</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide" aria-labelledby="guideHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                <div>
                    <h2 id="guideHeading">Quy tắc bảo mật</h2>
                </div>
            </div>

            <p>Mật khẩu mới của bạn cần đáp ứng các tiêu chuẩn sau:</p>

            <ul class="cf-guide__list">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Từ 6 đến 128 ký tự.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Không chứa khoảng trắng.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Khác với mật khẩu hiện tại.</span></li>
            </ul>

            <div class="cf-guide__note">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>Phiên đăng nhập hiện tại sẽ được làm mới tự động sau khi cập nhật thành công.</span>
            </div>

            @if (isForced)
            {
                <div class="cf-guide__note change-password-forced-note">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <span>Bạn cần hoàn tất bước này trước khi tiếp tục sử dụng hệ thống.</span>
                </div>
            }
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            document.querySelectorAll('[data-password-toggle]').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.dataset.passwordToggle);
                    if (!input) return;

                    const shouldShow = input.type === 'password';
                    input.type = shouldShow ? 'text' : 'password';
                    button.setAttribute('aria-pressed', shouldShow ? 'true' : 'false');

                    const toggleTarget = button.dataset.passwordToggle;
                    const fieldName = toggleTarget === 'oldPassword' ? 'mật khẩu hiện tại' :
                                      toggleTarget === 'newPassword' ? 'mật khẩu mới' : 'mật khẩu xác nhận';

                    button.setAttribute('aria-label', shouldShow ? 'Ẩn ' + fieldName : 'Hiện ' + fieldName);

                    const icon = button.querySelector('i');
                    if (icon) icon.className = shouldShow ? 'bi bi-eye-slash' : 'bi bi-eye';
                });
            });

            const form = document.getElementById('changePasswordForm');
            const submitButton = document.getElementById('btnSubmit');
            if (!form || !submitButton) return;

            form.addEventListener('submit', () => {
                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Đang cập nhật...</span>';
            });
        })();
    </script>
}
