@inject Manage_KPI_or_OKR_System.Services.ISystemSettingsService SystemSettingsService
@{
    ViewData["Title"] = "Đổi mật khẩu";
    var branding = await SystemSettingsService.GetBrandingAsync();
    var isForced = User.HasClaim("RequiresPasswordChange", "true");
}

@section Styles {
    <style>
        .password-page {
            display: grid;
            place-items: center;
            min-height: 100vh;
            padding: 1.25rem;
            background: #f5f7fb;
            color: #172033;
        }

        .password-shell {
            display: grid;
            grid-template-columns: minmax(280px, 0.85fr) minmax(360px, 1.15fr);
            width: min(920px, 100%);
            overflow: hidden;
            border: 1px solid #dce3ed;
            border-radius: 14px;
            background: #fff;
            box-shadow: 0 18px 50px rgba(23, 32, 51, 0.12);
        }

        .password-context {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-width: 0;
            padding: 2.25rem;
            background: var(--primary, #5b42d6);
            color: #fff;
        }

        .password-brand {
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            align-self: flex-start;
            color: #fff;
            font-size: 0.85rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            text-decoration: none;
        }

        .password-brand:hover { color: #fff; }

        .password-brand-mark {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 9px;
            background: rgba(255, 255, 255, 0.14);
        }

        .password-brand-mark img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #fff;
        }

        .password-context-copy {
            margin-block: 3rem;
        }

        .password-context-copy h1 {
            margin: 0;
            color: #fff;
            font-size: clamp(1.75rem, 4vw, 2.25rem);
            font-weight: 800;
            letter-spacing: -0.025em;
            line-height: 1.15;
        }

        .password-context-copy > p {
            margin: 0.8rem 0 0;
            color: rgba(255, 255, 255, 0.78);
            font-size: 0.9rem;
            line-height: 1.65;
        }

        .password-rules {
            display: grid;
            gap: 0.7rem;
            margin: 1.35rem 0 0;
            padding: 0;
            list-style: none;
        }

        .password-rules li {
            display: flex;
            align-items: flex-start;
            gap: 0.55rem;
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.78rem;
            line-height: 1.45;
        }

        .password-rules i {
            margin-top: 0.1rem;
            color: #bfdbfe;
        }

        .password-context-note {
            margin: 0;
            color: rgba(255, 255, 255, 0.64);
            font-size: 0.7rem;
            line-height: 1.5;
        }

        .password-form-panel {
            display: flex;
            align-items: center;
            min-width: 0;
            padding: 2.25rem;
        }

        .password-form-wrap {
            width: min(440px, 100%);
            margin: 0 auto;
        }

        .password-eyebrow {
            margin: 0 0 0.35rem;
            color: var(--primary, #5b42d6);
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .password-form-wrap h2 {
            margin: 0;
            color: #172033;
            font-size: 1.55rem;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .password-form-subtitle {
            margin: 0.45rem 0 1.4rem;
            color: #64748b;
            font-size: 0.84rem;
            line-height: 1.55;
        }

        .password-alert {
            display: flex;
            align-items: flex-start;
            gap: 0.6rem;
            margin-bottom: 1rem;
            border: 1px solid #f1c9c5;
            border-radius: 8px;
            padding: 0.75rem 0.85rem;
            background: #fff2f0;
            color: #9f261d;
            font-size: 0.78rem;
            line-height: 1.5;
        }

        .password-form {
            display: grid;
            gap: 0.9rem;
        }

        .password-field label {
            display: block;
            margin-bottom: 0.38rem;
            color: #475467;
            font-size: 0.75rem;
            font-weight: 750;
        }

        .password-input-wrap {
            position: relative;
        }

        .password-input-icon {
            position: absolute;
            top: 50%;
            left: 0.8rem;
            color: #8a94a5;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .password-input-wrap input {
            width: 100%;
            min-height: 46px;
            box-sizing: border-box;
            border: 1px solid #d7dbe2;
            border-radius: 8px;
            background: #fff;
            color: #172033;
            padding: 0.7rem 2.75rem 0.7rem 2.35rem;
            font-size: 0.9rem;
            outline: none;
        }

        .password-input-wrap input:focus {
            border-color: var(--primary, #5b42d6);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary, #5b42d6) 18%, transparent);
        }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 0.45rem;
            display: grid;
            place-items: center;
            width: 36px;
            height: 36px;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: #64748b;
            transform: translateY(-50%);
        }

        .password-toggle:hover,
        .password-toggle:focus-visible {
            background: #f1efff;
            color: var(--primary, #5b42d6);
            outline: none;
        }

        .password-field-hint {
            margin: 0.35rem 0 0;
            color: #7c8798;
            font-size: 0.69rem;
            line-height: 1.45;
        }

        .password-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            min-height: 46px;
            margin-top: 0.35rem;
            border: 1px solid var(--primary, #5b42d6);
            border-radius: 8px;
            background: var(--primary, #5b42d6);
            color: #fff;
            font-weight: 750;
            transition: background-color 160ms ease, transform 160ms ease;
        }

        .password-submit:hover {
            border-color: var(--primary-dark, #4f36c9);
            background: var(--primary-dark, #4f36c9);
            transform: translateY(-1px);
        }

        .password-submit:disabled {
            cursor: wait;
            opacity: 0.72;
            transform: none;
        }

        .password-back {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            margin-top: 1rem;
            color: #64748b;
            font-size: 0.76rem;
            font-weight: 700;
            text-decoration: none;
        }

        .password-back:hover { color: var(--primary, #5b42d6); }

        .password-forced-note {
            margin: 1rem 0 0;
            color: #7c8798;
            font-size: 0.72rem;
            line-height: 1.5;
            text-align: center;
        }

        @@media (max-width: 760px) {
            .password-page { padding: 0; }
            .password-shell {
                grid-template-columns: 1fr;
                min-height: 100vh;
                border: 0;
                border-radius: 0;
                box-shadow: none;
            }
            .password-context { padding: 1.3rem; }
            .password-context-copy { margin: 2rem 0 0; }
            .password-context-copy > p,
            .password-rules,
            .password-context-note { display: none; }
            .password-form-panel { align-items: flex-start; padding: 1.4rem 1.2rem 2rem; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .password-page *,
            .password-page *::before,
            .password-page *::after { transition-duration: 0.01ms !important; }
        }
    </style>
}

<main class="password-page">
    <div class="password-shell">
        <aside class="password-context">
            <a href="/" class="password-brand" aria-label="@branding.ProductName">
                <span class="password-brand-mark">
                    @if (branding.HasLogo)
                    {
                        <img src="@branding.LogoUrl" alt="" />
                    }
                    else
                    {
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    }
                </span>
                <span>@branding.ShortName</span>
            </a>

            <div class="password-context-copy">
                <h1>Bảo vệ tài khoản của bạn</h1>
                <p>Mật khẩu mới giúp duy trì an toàn cho dữ liệu công việc và quyền truy cập hệ thống.</p>
                <ul class="password-rules">
                    <li><i class="bi bi-check-circle" aria-hidden="true"></i><span>Sử dụng từ 6 đến 128 ký tự.</span></li>
                    <li><i class="bi bi-check-circle" aria-hidden="true"></i><span>Không chứa khoảng trắng và không trùng mật khẩu hiện tại.</span></li>
                    <li><i class="bi bi-check-circle" aria-hidden="true"></i><span>Không chia sẻ mật khẩu với người khác.</span></li>
                </ul>
            </div>

            <p class="password-context-note">@branding.ProductName · @branding.CompanyName</p>
        </aside>

        <section class="password-form-panel" aria-labelledby="changePasswordHeading">
            <div class="password-form-wrap">
                <p class="password-eyebrow">Bảo mật tài khoản</p>
                <h2 id="changePasswordHeading">Đổi mật khẩu</h2>
                <p class="password-form-subtitle">Xác nhận mật khẩu hiện tại trước khi thiết lập mật khẩu mới.</p>

                @if (ViewBag.Error != null)
                {
                    <div class="password-alert" role="alert">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form asp-action="ChangePassword" asp-controller="Auth" method="post" id="changePasswordForm" class="password-form">
                    <div class="password-field">
                        <label for="oldPassword">Mật khẩu hiện tại</label>
                        <div class="password-input-wrap">
                            <i class="bi bi-lock password-input-icon" aria-hidden="true"></i>
                            <input type="password" id="oldPassword" name="oldPassword" required maxlength="128" autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại" />
                            <button type="button" class="password-toggle" data-password-toggle="oldPassword" aria-label="Hiện mật khẩu hiện tại" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
                        </div>
                    </div>

                    <div class="password-field">
                        <label for="newPassword">Mật khẩu mới</label>
                        <div class="password-input-wrap">
                            <i class="bi bi-key password-input-icon" aria-hidden="true"></i>
                            <input type="password" id="newPassword" name="newPassword" required minlength="6" maxlength="128" autocomplete="new-password" aria-describedby="newPasswordHint" placeholder="Nhập mật khẩu mới" />
                            <button type="button" class="password-toggle" data-password-toggle="newPassword" aria-label="Hiện mật khẩu mới" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
                        </div>
                        <p class="password-field-hint" id="newPasswordHint">6–128 ký tự, không có khoảng trắng và phải khác mật khẩu hiện tại.</p>
                    </div>

                    <div class="password-field">
                        <label for="confirmPassword">Xác nhận mật khẩu mới</label>
                        <div class="password-input-wrap">
                            <i class="bi bi-shield-check password-input-icon" aria-hidden="true"></i>
                            <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" maxlength="128" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                            <button type="button" class="password-toggle" data-password-toggle="confirmPassword" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
                        </div>
                    </div>

                    <button type="submit" id="btnSubmit" class="password-submit">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span>Cập nhật mật khẩu</span>
                    </button>
                </form>

                @if (!isForced)
                {
                    <a asp-action="MyProfile" asp-controller="Auth" class="password-back">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        <span>Quay lại hồ sơ cá nhân</span>
                    </a>
                }
                else
                {
                    <p class="password-forced-note">Bạn cần hoàn tất bước này trước khi tiếp tục sử dụng hệ thống.</p>
                }
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (() => {
            document.querySelectorAll('[data-password-toggle]').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.dataset.passwordToggle);
                    if (!input) return;

                    const shouldShow = input.type === 'password';
                    input.type = shouldShow ? 'text' : 'password';
                    button.setAttribute('aria-pressed', shouldShow ? 'true' : 'false');
                    button.setAttribute('aria-label', shouldShow ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
                    const icon = button.querySelector('i');
                    if (icon) icon.className = shouldShow ? 'bi bi-eye-slash' : 'bi bi-eye';
                });
            });

            const form = document.getElementById('changePasswordForm');
            const submitButton = document.getElementById('btnSubmit');
            if (!form || !submitButton) return;

            form.addEventListener('submit', () => {
                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Đang cập nhật...</span>';
            });
        })();
    </script>
}
