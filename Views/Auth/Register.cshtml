@model Manage_KPI_or_OKR_System.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["IsLoginPage"] = true;
}
<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<main class="auth-page">
    <partial name="_AuthBrandPanel" />
    <section class="auth-form-panel" aria-labelledby="register-title">
        <a href="/" class="auth-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Về trang chủ</a>
        <div class="auth-card auth-card-register">
            <div class="auth-mobile-brand" aria-label="VietMach System, Manage KPI &amp; OKR"><span class="auth-brand-mark" aria-hidden="true"><i class="bi bi-bullseye"></i></span><span><strong>VietMach System</strong><small>Manage KPI &amp; OKR</small></span></div>
            <header class="auth-header"><h1 id="register-title">Tạo tài khoản</h1><p>Khởi tạo tài khoản để quản lý KPI &amp; OKR hiệu quả hơn.</p></header>
            <form asp-controller="Auth" asp-action="Register" method="post" class="auth-form" id="registerForm">
                <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-danger registration-validation-summary" role="alert"></div>
                <div class="auth-field"><label for="username">Tên đăng nhập</label><input asp-for="Username" class="auth-control" type="text" id="username" autocomplete="username" placeholder="Nhập tên đăng nhập" aria-describedby="usernameValidation" /><span asp-validation-for="Username" id="usernameValidation" class="auth-field-error" aria-live="polite"></span></div>
                <div class="auth-field"><label for="email">Email</label><input asp-for="Email" class="auth-control" type="email" id="email" autocomplete="email" inputmode="email" placeholder="name@company.com" aria-describedby="emailValidation" /><span asp-validation-for="Email" id="emailValidation" class="auth-field-error" aria-live="polite"></span></div>
                <div class="auth-field"><label for="password">Mật khẩu</label><div class="auth-password-wrap"><input asp-for="Password" class="auth-control" type="password" id="password" autocomplete="new-password" placeholder="Nhập mật khẩu" aria-describedby="passwordValidation passwordHint" /><button type="button" class="auth-password-toggle" id="passwordToggle" aria-label="Hiện mật khẩu" aria-controls="password" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="Password" id="passwordValidation" class="auth-field-error" aria-live="polite"></span><small class="auth-hint" id="passwordHint">Tối thiểu 6 ký tự, theo chính sách mật khẩu của hệ thống.</small></div>
                <div class="auth-field"><label for="confirmPassword">Xác nhận mật khẩu</label><div class="auth-password-wrap"><input asp-for="ConfirmPassword" class="auth-control" type="password" id="confirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" aria-describedby="confirmPasswordValidation" /><button type="button" class="auth-password-toggle" id="confirmPasswordToggle" aria-label="Hiện mật khẩu xác nhận" aria-controls="confirmPassword" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="ConfirmPassword" id="confirmPasswordValidation" class="auth-field-error" aria-live="polite"></span></div>
                <button type="submit" class="auth-submit"><span class="button-text">Đăng ký</span><span class="button-loader" aria-hidden="true"><span class="auth-spinner"></span></span></button>
            </form>
            <div class="auth-divider"><span>Hoặc tiếp tục với</span></div>
            <a asp-controller="Auth" asp-action="GoogleLogin" class="auth-google"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 7.4v3.2h4.6c-.2 1-.8 1.8-1.6 2.4v2h2.6c1.5-1.4 2.4-3.4 2.4-5.8 0-.6 0-1.1-.1-1.6H9z" fill="#4285F4"/><path d="M9 17c2.2 0 4-.7 5.4-1.9l-2.6-2c-.7.5-1.6.8-2.8.8-2.1 0-3.9-1.4-4.6-3.4H1.7v2.1C3.1 15.2 5.8 17 9 17z" fill="#34A853"/><path d="M4.4 10.5c-.2-.5-.2-1.1 0-1.6V6.8H1.7c-.6 1.2-.6 2.6 0 3.8l2.7-2.1z" fill="#FBBC04"/><path d="M9 4.2c1.2 0 2.3.4 3.1 1.2l2.3-2.3C12.9 1.8 11.1 1 9 1 5.8 1 3.1 2.8 1.7 5.4l2.7 2.1C5.1 5.6 6.9 4.2 9 4.2z" fill="#EA4335"/></svg>Đăng ký bằng Google</a>
            <p class="auth-switch">Bạn đã có tài khoản? <a asp-controller="Auth" asp-action="Login">Đăng nhập</a></p>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}
