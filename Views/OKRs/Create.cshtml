@model Manage_KPI_or_OKR_System.Models.OKR
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Khởi tạo OKR";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var missions = (ViewBag.Missions as IEnumerable<MissionVision> ?? Enumerable.Empty<MissionVision>()).ToList();
    var departments = (ViewBag.Departments as IEnumerable<Department> ?? Enumerable.Empty<Department>()).ToList();
    var employees = (ViewBag.Employees as IEnumerable<Employee> ?? Enumerable.Empty<Employee>()).ToList();
    var okrTypes = (ViewBag.OKRTypes as IEnumerable<OKRType> ?? Enumerable.Empty<OKRType>()).ToList();
    var cycleOptions = ViewBag.CycleOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var employeeDepartmentMap = ViewBag.EmployeeDepartmentMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var selectedMissionId = ViewData["SelectedMissionId"] is int missionIdValue ? (int?)missionIdValue : null;
    var selectedDepartmentId = ViewData["SelectedDepartmentId"] is int departmentIdValue ? (int?)departmentIdValue : null;
    var selectedEmployeeId = ViewData["SelectedEmployeeId"] is int employeeIdValue ? (int?)employeeIdValue : null;
}

<div class="cf-page okr-form-page" data-create-form data-okr-create>
    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Khởi tạo OKR</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Quản lý OKR</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Thêm mới</span>
            </nav>
            <p class="cf-header__description">Viết Objective, chọn chu kỳ và phân bổ đúng phạm vi để hệ thống tạo luồng thực thi liên quan.</p>
        </div>
        <a asp-action="Index" class="cf-back-action">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại</span>
        </a>
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="okrFormHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="okrFormHeading">Thông tin mục tiêu</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
            </div>

            <form asp-action="Create" method="post" class="cf-form" data-create-form-element>
                <div asp-validation-summary="All" class="cf-alert" role="alert" tabindex="-1" data-error-summary></div>

                <section class="cf-section" aria-labelledby="okrObjectiveHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-bullseye"></i></span>
                        <div>
                            <h3 id="okrObjectiveHeading">Objective</h3>
                            <p>Mô tả một kết quả định tính, rõ hướng đi và đủ ngắn để đội ngũ ghi nhớ.</p>
                        </div>
                    </div>
                    <div class="cf-field">
                        <div class="cf-label-row">
                            <label asp-for="ObjectiveName">Nội dung Objective <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <output id="objectiveCounter" class="cf-counter" for="ObjectiveName" data-character-counter>0/255</output>
                        </div>
                        <textarea asp-for="ObjectiveName"
                                  class="form-control cf-control"
                                  rows="3"
                                  maxlength="255"
                                  placeholder="Ví dụ: Nâng cao độ tin cậy của dịch vụ giao hàng trong quý 3"
                                  aria-describedby="objectiveHint objectiveCounter"
                                  required></textarea>
                        <span asp-validation-for="ObjectiveName" class="cf-validation"></span>
                        <p id="objectiveHint" class="cf-hint">Tập trung vào điều cần đạt; chỉ số đo lường cụ thể sẽ được bổ sung bằng Key Result.</p>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="okrConfigurationHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-calendar3"></i></span>
                        <div>
                            <h3 id="okrConfigurationHeading">Loại và chu kỳ</h3>
                            <p>Các lựa chọn được nạp từ cấu hình và chu kỳ hiện tại của hệ thống.</p>
                        </div>
                    </div>
                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label asp-for="OKRTypeId">Loại OKR <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <select asp-for="OKRTypeId"
                                    class="form-select cf-control no-select2"
                                    disabled="@(!okrTypes.Any())"
                                    aria-describedby="okrTypeHint"
                                    required>
                                <option value="">Chọn loại OKR</option>
                                @foreach (var type in okrTypes)
                                {
                                    <option value="@type.Id">@type.TypeName</option>
                                }
                            </select>
                            <span asp-validation-for="OKRTypeId" class="cf-validation"></span>
                            <p id="okrTypeHint" class="cf-hint">Loại OKR quyết định phạm vi tổ chức và cách theo dõi mục tiêu.</p>
                            @if (!okrTypes.Any())
                            {
                                <div class="cf-empty-state" role="alert">
                                    <i class="bi bi-tags" aria-hidden="true"></i>
                                    <span>Chưa có loại OKR trong cấu hình. Cần bổ sung dữ liệu này trước khi tạo.</span>
                                </div>
                            }
                        </div>
                        <div class="cf-field">
                            <label asp-for="Cycle">Chu kỳ thực hiện <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <select asp-for="Cycle"
                                    asp-items="cycleOptions"
                                    class="form-select cf-control no-select2"
                                    aria-describedby="cycleHint"
                                    required></select>
                            <span asp-validation-for="Cycle" class="cf-validation"></span>
                            <p id="cycleHint" class="cf-hint">Chu kỳ hợp lệ gồm quý hoặc cả năm do controller cung cấp.</p>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="okrStrategyHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-signpost-split"></i></span>
                        <div>
                            <h3 id="okrStrategyHeading">Liên kết chiến lược</h3>
                            <p>Chọn Tầm nhìn, Sứ mệnh hoặc Mục tiêu theo năm mà OKR này trực tiếp đóng góp.</p>
                        </div>
                    </div>
                    <div class="cf-field">
                        <label for="missionId">Định hướng chiến lược</label>
                        <select name="missionId"
                                id="missionId"
                                class="form-select cf-control"
                                data-placeholder="Không liên kết định hướng"
                                disabled="@(!missions.Any())"
                                aria-describedby="missionHint">
                            <option value="">Không liên kết định hướng</option>
                            @foreach (var mission in missions)
                            {
                                <option value="@mission.Id" selected="@(selectedMissionId == mission.Id ? "selected" : null)">@MissionOptionLabel(mission)</option>
                            }
                        </select>
                        <p id="missionHint" class="cf-hint">Để trống nếu đây là OKR vận hành chưa gắn trực tiếp với một định hướng cấp cao.</p>
                        @if (!missions.Any())
                        {
                            <div class="cf-empty-state" role="status">
                                <i class="bi bi-signpost" aria-hidden="true"></i>
                                <span>Chưa có Tầm nhìn, Sứ mệnh hoặc Mục tiêu theo năm đang hoạt động.</span>
                            </div>
                        }
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="okrAllocationHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-people"></i></span>
                        <div>
                            <h3 id="okrAllocationHeading">Phòng ban và người phụ trách</h3>
                            <p>Phòng ban lọc danh sách nhân viên; chọn nhân viên sẽ tự đồng bộ về phòng ban đang phân công.</p>
                        </div>
                    </div>
                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label for="departmentId">Phòng ban phụ trách</label>
                            <select name="departmentId"
                                    id="departmentId"
                                    class="form-select cf-control"
                                    data-placeholder="Toàn tổ chức hoặc cá nhân"
                                    aria-describedby="departmentAllocationHint">
                                <option value="">Toàn tổ chức hoặc cá nhân</option>
                                @foreach (var department in departments)
                                {
                                    <option value="@department.Id" selected="@(selectedDepartmentId == department.Id ? "selected" : null)">@department.DepartmentName</option>
                                }
                            </select>
                            <p id="departmentAllocationHint" class="cf-hint">Danh sách chỉ gồm phòng ban nằm trong phạm vi phân bổ của tài khoản hiện tại.</p>
                            @if (!departments.Any())
                            {
                                <div class="cf-empty-state" role="status">
                                    <i class="bi bi-building-x" aria-hidden="true"></i>
                                    <span>Không có phòng ban trong phạm vi phân bổ. Bạn vẫn có thể tạo OKR cấp tổ chức nếu quyền cho phép.</span>
                                </div>
                            }
                        </div>
                        <div class="cf-field">
                            <label for="employeeId">Nhân viên chịu trách nhiệm</label>
                            <select name="employeeId"
                                    id="employeeId"
                                    class="form-select cf-control"
                                    data-placeholder="Không phân bổ cá nhân"
                                    aria-describedby="employeeAllocationHint">
                                <option value="">Không phân bổ cá nhân</option>
                                @foreach (var employee in employees)
                                {
                                    var departmentId = employeeDepartmentMap.TryGetValue(employee.Id, out var mappedDepartmentId)
                                        ? mappedDepartmentId.ToString()
                                        : string.Empty;
                                    <option value="@employee.Id"
                                            data-department-id="@departmentId"
                                            selected="@(selectedEmployeeId == employee.Id ? "selected" : null)">@employee.FullName (@employee.EmployeeCode)</option>
                                }
                            </select>
                            <p id="employeeAllocationHint" class="cf-hint">Nhân viên ngoài phạm vi phân bổ không xuất hiện trong danh sách.</p>
                            <div class="cf-empty-state" role="status" data-employee-empty hidden="@employees.Any()">
                                <i class="bi bi-person-x" aria-hidden="true"></i>
                                <span data-employee-empty-text>Chưa có nhân viên phù hợp trong phạm vi đã chọn.</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="okrConfirmationHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-kanban"></i></span>
                        <div>
                            <h3 id="okrConfirmationHeading">Xác nhận luồng thực thi</h3>
                            <p>Sau khi tạo, hệ thống cố gắng sinh dự án vận hành và liên kết dự án với OKR.</p>
                        </div>
                    </div>
                    <div class="cf-inline-note" role="status">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <span>Nếu dự án chưa tạo được, OKR vẫn được lưu và hệ thống sẽ hiển thị cảnh báo để bạn xử lý tiếp.</span>
                    </div>
                </section>

                <div class="cf-actions">
                    <a asp-action="Index" class="cf-secondary-action">Hủy</a>
                    <button type="submit"
                            class="cf-primary-action"
                            data-submit-button
                            data-default-label="Tạo OKR"
                            data-loading-label="Đang tạo...">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span data-submit-label>Tạo OKR</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide" aria-labelledby="okrGuideHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-compass"></i></span>
                <div>
                    <span class="cf-guide__eyebrow">Viết Objective</span>
                    <h2 id="okrGuideHeading">Rõ hướng, chưa cần con số</h2>
                </div>
            </div>
            <p>Một Objective tốt cho biết đội ngũ muốn thay đổi điều gì trong chu kỳ đã chọn.</p>
            <ul class="cf-guide__list">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Dùng câu ngắn, chủ động và dễ nhắc lại trong check-in.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Không ghép nhiều kết quả không liên quan vào cùng một Objective.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Thêm Key Result sau khi tạo để đo tiến độ bằng dữ liệu.</span></li>
            </ul>
            <div class="cf-guide__note">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>Server xác minh lại loại OKR, định hướng, phòng ban và nhân viên trước khi lưu.</span>
            </div>
        </aside>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/okr-form.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
    <script src="~/js/okr-create.js" asp-append-version="true"></script>
}

@functions {
    private static string MissionOptionLabel(MissionVision mission)
    {
        var prefix = mission.TargetYear.HasValue
            ? $"{mission.TypeDisplayName} {mission.TargetYear}"
            : mission.TypeDisplayName;
        var content = mission.Content ?? string.Empty;
        var summary = content.Length > 72 ? content[..72] + "..." : content;
        return $"{prefix}: {summary}";
    }
}
