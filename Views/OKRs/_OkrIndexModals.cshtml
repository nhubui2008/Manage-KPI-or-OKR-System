@model Manage_KPI_or_OKR_System.Models.ViewModels.OkrIndexViewModel
@{
    var measurementUnits = new[] {
        new { Value = "%", Text = "% - Tỷ lệ phần trăm" },
        new { Value = "VNĐ", Text = "VNĐ - Tiền tệ" },
        new { Value = "Triệu VNĐ", Text = "Triệu VNĐ - Tiền tệ rút gọn" },
        new { Value = "Điểm", Text = "Điểm - Thang điểm" },
        new { Value = "Người", Text = "Người - Nhân sự" },
        new { Value = "Khách hàng", Text = "Khách hàng" },
        new { Value = "Cơ hội", Text = "Cơ hội bán hàng" },
        new { Value = "Hợp đồng", Text = "Hợp đồng" },
        new { Value = "Sản phẩm", Text = "Sản phẩm" },
        new { Value = "Lần", Text = "Lần" },
        new { Value = "Giờ", Text = "Giờ" },
        new { Value = "Ngày", Text = "Ngày" },
        new { Value = "Dự án", Text = "Dự án" },
        new { Value = "Công việc", Text = "Công việc" }
    };
}
<!-- Modal AI Suggest Key Results -->
<div class="modal fade" id="aiSuggestKrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header-soft info">
                <h5 class="modal-title-custom">
                    <i class="bi bi-robot text-info"></i>
                    AI Gợi ý Kết quả then chốt
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body-soft">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="soft-tag-indicator mb-0">
                        <i class="bi bi-bullseye"></i>
                        <span id="aiOkrNameDisplay" class="text-truncate fw-bold">Objective: </span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill js-okr-action"
                            data-action="ai-history-kr">
                        <i class="bi bi-clock-history"></i> Lịch sử AI
                    </button>
                </div>
                <div id="aiLoadingIndicator" class="text-center py-5">
                    <div class="spinner-grow text-info" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">AI đang phân tích và tạo Kết quả then chốt...</p>
                </div>

                <div id="aiSuggestionContent" style="display: none;">
                    <form id="aiSuggestForm">
                        <input type="hidden" id="aiOkrId" name="aiOkrId" />
                        <div class="table-responsive">
                            <table class="table table-borderless table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px;"><input class="form-check-input" type="checkbox" id="checkAllAiKr" checked border-0 shadow-sm></th>
                                        <th>Mô tả (KeyResultName)</th>
                                        <th style="width: 120px;">Chỉ tiêu</th>
                                        <th style="width: 150px;">Đơn vị</th>
                                        <th style="width: 100px;">Thu nhỏ</th>
                                    </tr>
                                </thead>
                                <tbody id="aiKrListTableBody">
                                    <!-- Dynamic content -->
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-end gap-3 mt-4">
                            <button type="button" class="btn-outline-custom px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                            <button type="button" class="btn-primary-custom px-4" id="btnSaveAiKrs">Thêm KR đã chọn</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add Key Result -->
<div class="modal fade" id="addKrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header-soft warning">
                <h5 class="modal-title-custom">
                    <i class="bi bi-key-fill text-warning"></i>
                    Thêm Kết quả then chốt (KR)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body-soft">
                <div class="soft-tag-indicator">
                    <i class="bi bi-bullseye"></i>
                    <span id="krOkrNameDisplay" class="text-truncate">Objective: </span>
                </div>

                <form asp-controller="OKRs" asp-action="AddKeyResult" method="post" id="addKrForm" data-measurement-scope data-submit-guard>
                    <input type="hidden" name="OKRId" id="krOkrId" />

                    <div class="form-icon-group">
                        <label>Mô tả Kết quả then chốt</label>
                        <div class="input-wrapper">
                            <i class="bi bi-pencil-square"></i>
                            <input type="text" name="KeyResultName" class="form-control" placeholder="VD: Đạt 1000 khách hàng mới trong Q1" required>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="form-icon-group">
                                <label>Chỉ tiêu (Target)</label>
                                <div class="input-wrapper input-group">
                                    <i class="bi bi-flag-fill"></i>
                                    <input type="number" step="0.01" name="TargetValue" class="form-control measurement-value-input" data-measurement-role="target" placeholder="0.00" required>
                                    <span class="input-group-text measurement-unit-suffix">đơn vị</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-icon-group">
                                <label>Đơn vị tính</label>
                                <div class="input-wrapper">
                                    <i class="bi bi-rulers"></i>
                                    <select name="Unit" class="form-select measurement-unit-select" data-placeholder="-- Chọn đơn vị đo --" required>
                                        <option value="">-- Chọn đơn vị đo --</option>
                                        @foreach (var unit in measurementUnits)
                                        {
                                            <option value="@unit.Value">@unit.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <label class="form-switch-premium" for="isInverseCheck">
                        <div class="label-content">
                            <span class="label-title">Chỉ tiêu thu nhỏ</span>
                            <span class="label-desc">Kích hoạt nếu giá trị càng thấp càng tốt</span>
                        </div>
                        <input class="form-check-input" type="checkbox" name="IsInverse" value="true" id="isInverseCheck" role="switch">
                    </label>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <button type="button" class="btn-outline-custom px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn-primary-custom px-4">Xác nhận tạo KR</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Allocate OKR -->
<div class="modal fade" id="allocateOkrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header-soft primary">
                <h5 class="modal-title-custom">
                    <i class="bi bi-person-plus-fill text-primary"></i>
                    Phân bổ OKR
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body-soft">
                <form asp-controller="OKRs" asp-action="AllocateTarget" method="post" data-submit-guard>
                    <input type="hidden" name="okrId" id="allocOkrId" />

                    <div class="soft-tag-indicator">
                        <i class="bi bi-person-check"></i>
                        <span>Phân bổ cho nhân viên</span>
                    </div>

                    <div class="form-icon-group">
                        <label>Chọn nhân viên phụ trách</label>
                        <div class="input-wrapper">
                            <i class="bi bi-person-badge"></i>
                            <select name="employeeId" class="form-select" required>
                                <option value="">-- Chọn nhân viên --</option>
                                @foreach (var e in Model?.Employees ?? Array.Empty<Manage_KPI_or_OKR_System.Models.Employee>())
                                {
                                    <option value="@e.Id">@e.FullName (@e.EmployeeCode)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-icon-group">
                        <label>Giá trị phân bổ</label>
                        <div class="input-wrapper">
                            <i class="bi bi-calculator"></i>
                            <input type="number" step="0.01" min="0.01" name="allocatedValue" class="form-control" required placeholder="Nhập con số cụ thể...">
                        </div>
                        <div class="form-text text-muted small mt-2">
                            <i class="bi bi-info-circle me-1"></i> Lưu ý: Tổng các chỉ tiêu phân bổ nên bằng chỉ tiêu chung của OKR.
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <button type="button" class="btn-outline-custom px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn-primary-custom px-4">Xác nhận phân bổ</button>
                    </div>
                </form>

                <hr class="my-4">

                <form asp-controller="OKRs" asp-action="AllocateDepartment" method="post" data-submit-guard>
                    <input type="hidden" name="okrId" id="allocDeptOkrId" />

                    <div class="soft-tag-indicator">
                        <i class="bi bi-building"></i>
                        <span>Phân bổ cho phòng ban</span>
                    </div>

                    <div class="form-icon-group">
                        <label>Chọn phòng ban phụ trách</label>
                        <div class="input-wrapper">
                            <i class="bi bi-building"></i>
                            <select name="departmentId" class="form-select" required>
                                <option value="">-- Chọn phòng ban --</option>
                                @foreach (var d in Model?.Departments ?? Array.Empty<Manage_KPI_or_OKR_System.Models.Department>())
                                {
                                    <option value="@d.Id">@d.DepartmentName (@d.DepartmentCode)</option>
                                }
                            </select>
                        </div>
                        <div class="form-text text-muted small mt-2">
                            <i class="bi bi-info-circle me-1"></i> Nhân viên đang thuộc phòng ban này có thể nhìn thấy và cập nhật OKR theo quyền được cấp.
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <button type="button" class="btn-outline-custom px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn-primary-custom px-4">Phân bổ phòng ban</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Update KR Progress -->
<div class="modal fade" id="updateKrProgressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header-soft primary">
                <h5 class="modal-title-custom">
                    <i class="bi bi-graph-up-arrow text-primary"></i>
                    Cập nhật tiến độ KR
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body-soft">
                <div class="soft-tag-indicator">
                    <i class="bi bi-info-circle"></i>
                    <span id="updateKrNameDisplay" class="text-truncate">KR: </span>
                </div>

                <form asp-controller="OKRs" asp-action="UpdateKeyResultProgress" method="post" data-submit-guard>
                    <input type="hidden" name="krId" id="updateKrId" />

                    <div class="form-icon-group">
                        <label>Thực tế hiện tại</label>
                        <div class="input-wrapper">
                            <i class="bi bi-lightning-charge-fill"></i>
                            <input type="number" step="0.01" min="0" name="currentValue" id="updateKrCurrentValue" class="form-control measurement-value-input" data-measurement-role="current" data-measurement-suffix-target="updateKrUnitDisplay" required>
                            <span class="position-absolute end-0 top-50 translate-middle-y pe-4 fw-bold text-muted" id="updateKrUnitDisplay"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <button type="button" class="btn-outline-custom px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn-primary-custom px-4">Cập nhật ngay</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edit Key Result -->
<div class="modal fade" id="editKrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật Kết quả then chốt (KR)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-controller="OKRs" asp-action="EditKeyResult" method="post" data-measurement-scope data-submit-guard>
                    <input type="hidden" name="Id" id="editKrId" />
                    <div class="mb-3">
                        <label class="form-label">Mô tả Key Result <span class="text-danger">*</span></label>
                        <input type="text" name="KeyResultName" id="editKrName" class="form-control" required>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Hiện tại <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" step="0.01" name="CurrentValue" id="editKrCurrent" class="form-control measurement-value-input" data-measurement-role="current" required>
                                <span class="input-group-text measurement-unit-suffix">đơn vị</span>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Chỉ tiêu (Target) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" step="0.01" name="TargetValue" id="editKrTarget" class="form-control measurement-value-input" data-measurement-role="target" required>
                                <span class="input-group-text measurement-unit-suffix">đơn vị</span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Đơn vị đo lường <span class="text-danger">*</span></label>
                        <select name="Unit" id="editKrUnit" class="form-select measurement-unit-select" data-placeholder="-- Chọn đơn vị đo --" required>
                            <option value="">-- Chọn đơn vị đo --</option>
                            @foreach (var unit in measurementUnits)
                            {
                                <option value="@unit.Value">@unit.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="IsInverse" value="true" id="editKrIsInverse">
                            <label class="form-check-label" for="editKrIsInverse">Chỉ tiêu thu nhỏ (Càng thấp càng tốt)</label>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Cập nhật KR</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_AITaskDecomposeModal")
