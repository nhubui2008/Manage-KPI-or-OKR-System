@section Scripts {
    <script>
        // Đóng tất cả dropdown OKR đang mở (tránh dropdown đè lên modal)
        function closeAllOkrDropdowns() {
            document.querySelectorAll('.okr-index-page .okr-action-dropdown [data-bs-toggle="dropdown"]').forEach(function (toggleEl) {
                var dd = bootstrap.Dropdown.getInstance(toggleEl);
                if (dd) dd.hide();
            });
            // Reset z-index layering
            document.querySelectorAll('.okr-index-page #accordionOKRs .accordion-item').forEach(function (el) {
                el.classList.remove('okr-dropdown-open');
            });
        }

        function openAddKrModal(okrId, okrName) {
            closeAllOkrDropdowns();

            const addKrForm = document.getElementById('addKrForm');
            if (addKrForm) {
                addKrForm.reset();
            }

            document.getElementById('krOkrId').value = okrId;
            document.getElementById('krOkrNameDisplay').innerText = 'Objective: ' + okrName;
            document.getElementById('isInverseCheck').checked = false;

            if (window.applyMeasurementUnitBehavior) {
                window.applyMeasurementUnitBehavior(document.getElementById('addKrModal'));
            }

            var modal = new bootstrap.Modal(document.getElementById('addKrModal'));
            modal.show();
        }

        function openAllocateModal(okrId) {
            closeAllOkrDropdowns();

            document.getElementById('allocOkrId').value = okrId;
            document.getElementById('allocDeptOkrId').value = okrId;
            var modal = new bootstrap.Modal(document.getElementById('allocateOkrModal'));
            modal.show();
        }

        function openEditKrModal(id, name, target, current, unit, isInverse) {
            document.getElementById('editKrId').value = id;
            document.getElementById('editKrName').value = name;
            document.getElementById('editKrTarget').value = normalizeDecimalValue(target);
            document.getElementById('editKrCurrent').value = normalizeDecimalValue(current);
            const editKrUnitSelect = document.getElementById('editKrUnit');
            if (window.setMeasurementUnitSelectValue) {
                window.setMeasurementUnitSelectValue(editKrUnitSelect, unit || '');
            } else {
                editKrUnitSelect.value = unit || '';
            }
            document.getElementById('editKrIsInverse').checked = isInverse === true || isInverse === 'true';
            if (window.applyMeasurementUnitBehavior) {
                window.applyMeasurementUnitBehavior(document.getElementById('editKrModal'));
            }
            new bootstrap.Modal(document.getElementById('editKrModal')).show();
        }

        function openUpdateProgressModal(krId, krName, currentVal, unit) {
            document.getElementById('updateKrId').value = krId;
            document.getElementById('updateKrNameDisplay').innerText = 'KR: ' + krName;
            document.getElementById('updateKrCurrentValue').value = normalizeDecimalValue(currentVal);
            const config = window.applyMeasurementUnitConfigToInputs
                ? window.applyMeasurementUnitConfigToInputs(unit, [document.getElementById('updateKrCurrentValue')])
                : { suffix: unit || '' };
            document.getElementById('updateKrUnitDisplay').innerText = config.suffix || unit || '';
            var modal = new bootstrap.Modal(document.getElementById('updateKrProgressModal'));
            modal.show();
        }

        function normalizeDecimalValue(value) {
            return String(value ?? '').replace(',', '.');
        }

        document.querySelectorAll('.js-edit-kr').forEach(button => {
            button.addEventListener('click', event => {
                event.preventDefault();
                event.stopPropagation();
                openEditKrModal(
                    button.dataset.krId,
                    button.dataset.krName || '',
                    button.dataset.krTarget || '0',
                    button.dataset.krCurrent || '0',
                    button.dataset.krUnit || '',
                    button.dataset.krIsInverse || 'false'
                );
            });
        });

        document.querySelectorAll('.js-update-kr-progress').forEach(button => {
            button.addEventListener('click', event => {
                event.preventDefault();
                event.stopPropagation();
                openUpdateProgressModal(
                    button.dataset.krId,
                    button.dataset.krName || '',
                    button.dataset.krCurrent || '0',
                    button.dataset.krUnit || ''
                );
            });
        });

        function hideOtherOkrDropdowns(currentToggleEl) {
            document.querySelectorAll('.okr-index-page .okr-action-dropdown [data-bs-toggle="dropdown"]').forEach(toggleEl => {
                if (toggleEl !== currentToggleEl) {
                    bootstrap.Dropdown.getOrCreateInstance(toggleEl).hide();
                }
            });
        }

        function getOpenOkrDropdown() {
            return Array.from(document.querySelectorAll('.okr-index-page .okr-action-dropdown'))
                .find(dropdownEl => dropdownEl.querySelector('.dropdown-menu.show'));
        }

        function syncOkrDropdownLayering(activeDropdownEl = null) {
            const openDropdownEl = activeDropdownEl || getOpenOkrDropdown();

            document.querySelectorAll('.okr-index-page #accordionOKRs .accordion-item').forEach(accordionItemEl => {
                accordionItemEl.classList.toggle(
                    'okr-dropdown-open',
                    openDropdownEl !== null && accordionItemEl.contains(openDropdownEl)
                );
            });
        }

        document.querySelectorAll('.okr-index-page .okr-action-dropdown').forEach(dropdownEl => {
            const toggleEl = dropdownEl.querySelector('[data-bs-toggle="dropdown"]');
            if (!toggleEl) {
                return;
            }

            toggleEl.addEventListener('click', () => {
                hideOtherOkrDropdowns(toggleEl);
            });

            dropdownEl.addEventListener('show.bs.dropdown', () => {
                hideOtherOkrDropdowns(toggleEl);
                syncOkrDropdownLayering(dropdownEl);
            });

            dropdownEl.addEventListener('shown.bs.dropdown', () => {
                syncOkrDropdownLayering(dropdownEl);
            });

            dropdownEl.addEventListener('hidden.bs.dropdown', () => {
                syncOkrDropdownLayering();
            });
        });

        // Toggle all accordions functionality
        document.getElementById('toggleAllBtn')?.addEventListener('click', function() {
            const accordions = document.querySelectorAll('#accordionOKRs .accordion-collapse');
            const anyCollapsed = Array.from(accordions).some(a => !a.classList.contains('show'));

            accordions.forEach(acc => {
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(acc);
                if (anyCollapsed) {
                    bsCollapse.show();
                } else {
                    bsCollapse.hide();
                }
            });

            // Cập nhật text & icon: Nếu trước đó có ít nhất 1 cái đóng, giờ đã mở hết -> nút thành "Thu gọn".
            // Nếu trước đó mở hết -> giờ đã đóng hết -> nút thành "Mở rộng".
            if (anyCollapsed) {
                this.innerHTML = '<i class="bi bi-dash-square"></i> Thu gọn tất cả';
            } else {
                this.innerHTML = '<i class="bi bi-list-task"></i> Mở rộng tất cả';
            }
        });

        function renderAiKrResults(data) {
            document.getElementById('aiLoadingIndicator').style.display = 'none';
            document.getElementById('aiSuggestionContent').style.display = 'block';

            const tbody = document.getElementById('aiKrListTableBody');
            let html = '';
            data.forEach((kr, index) => {
                let isInverseChecked = kr.IsInverse || kr.isInverse ? 'checked' : '';
                html += `
                    <tr>
                        <td><input class="form-check-input ai-kr-checkbox" type="checkbox" checked data-index="${index}"></td>
                        <td><input type="text" class="form-control form-control-sm ai-kr-name" value="${kr.KeyResultName || kr.keyResultName}" required></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm ai-kr-target" value="${kr.TargetValue || kr.targetValue}" required></td>
                        <td><input type="text" class="form-control form-control-sm ai-kr-unit" value="${kr.Unit || kr.unit}" list="unitList" required></td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input ai-kr-is-inverse" type="checkbox" ${isInverseChecked}>
                            </div>
                        </td>
                    </tr>
                `;
            });
            // Add datalist for units if not exist
            if (!document.getElementById('unitList')) {
                let datalistHTML = `<datalist id="unitList">`;
                document.querySelectorAll('.measurement-unit-select option').forEach(opt => {
                    if(opt.value) datalistHTML += `<option value="${opt.value}">`;
                });
                datalistHTML += `</datalist>`;
                document.body.insertAdjacentHTML('beforeend', datalistHTML);
            }

            tbody.innerHTML = html;
        }

        function applyAiHistoryKR(parsedData) {
            renderAiKrResults(parsedData);
        }

        // AI Gợi ý KR
        function openAiSuggestKrModal(okrId, okrName) {
            closeAllOkrDropdowns();
            document.getElementById('aiOkrId').value = okrId;
            document.getElementById('aiOkrNameDisplay').innerText = 'Objective: ' + okrName;

            document.getElementById('aiLoadingIndicator').style.display = 'block';
            document.getElementById('aiSuggestionContent').style.display = 'none';
            document.getElementById('aiKrListTableBody').innerHTML = '';

            var modal = new bootstrap.Modal(document.getElementById('aiSuggestKrModal'));
            modal.show();

            fetch(`/OKRs/SuggestKeyResultsAPI/${okrId}`)
                .then(response => {
                    if(!response.ok) throw new Error('Không thể tải gợi ý từ AI');
                    return response.json();
                })
                .then(data => {
                    renderAiKrResults(data);
                })
                .catch(error => {
                    document.getElementById('aiLoadingIndicator').innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
                });
        }

        document.getElementById('checkAllAiKr')?.addEventListener('change', function() {
            document.querySelectorAll('.ai-kr-checkbox').forEach(cb => cb.checked = this.checked);
        });

        document.getElementById('btnSaveAiKrs')?.addEventListener('click', function() {
            const okrId = document.getElementById('aiOkrId').value;
            const rows = document.querySelectorAll('#aiKrListTableBody tr');
            const payload = [];

            rows.forEach(row => {
                const checkbox = row.querySelector('.ai-kr-checkbox');
                if (checkbox.checked) {
                    payload.push({
                        OKRId: parseInt(okrId),
                        KeyResultName: row.querySelector('.ai-kr-name').value,
                        TargetValue: parseFloat(row.querySelector('.ai-kr-target').value),
                        Unit: row.querySelector('.ai-kr-unit').value,
                        IsInverse: row.querySelector('.ai-kr-is-inverse').checked,
                        CurrentValue: 0
                    });
                }
            });

            if (payload.length === 0) {
                alert('Vui lòng chọn ít nhất 1 Key Result.');
                return;
            }

            const btn = this;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang lưu...';
            btn.disabled = true;

            fetch('/OKRs/AddMultipleKeyResults', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(window.antiForgeryHeaders ? window.antiForgeryHeaders() : {})
                },
                body: JSON.stringify(payload)
            })
            .then(response => {
                if(!response.ok) throw new Error('Lỗi khi lưu KR');
                return response.json();
            })
            .then(data => {
                if(data.success) {
                    window.location.reload();
                } else {
                    alert('Có lỗi xảy ra.');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            })
            .catch(error => {
                alert(error.message);
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        });
    </script>

