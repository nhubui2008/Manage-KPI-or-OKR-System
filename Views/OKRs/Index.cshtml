@model Manage_KPI_or_OKR_System.Models.ViewModels.OkrIndexViewModel
@using Manage_KPI_or_OKR_System.Helpers
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý OKR";
    var pageItems = Model?.Items;
    var currentFilter = Model?.SearchString ?? ViewData["CurrentFilter"] as string;
    var currentCycle = Model?.Cycle;
    var currentStatusId = Model?.StatusId;
    var currentOkrTypeId = Model?.OkrTypeId;
    var currentScope = Model?.Scope ?? "";
    var currentQuickFilter = Model?.QuickFilter ?? "";
    var currentSortBy = Model?.SortBy ?? "";
    var hasActiveFilters = Model?.HasActiveFilters == true;
    var isFilteredEmpty = Model?.IsFilteredEmpty == true;
    var summary = Model?.Summary;
    bool canCreateOkr = Model?.CanCreateOkr == true;
    bool canEditOkr = Model?.CanEditOkr == true;
    bool canDeleteOkr = Model?.CanDeleteOkr == true;
    bool canUpdateOwnProgress = Model?.CanUpdateOkrProgress == true;
    bool canViewProjects = Model?.CanViewProjects == true;

    string QuickFilterClass(string value) =>
        string.Equals(value, currentQuickFilter, StringComparison.OrdinalIgnoreCase) ||
        (string.IsNullOrEmpty(value) && string.IsNullOrEmpty(currentQuickFilter))
            ? "is-active"
            : "";

}

<div class="okr-index-page">

    <!-- PAGE TITLE HEADER -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between mb-3">
                <div>
                    <h4 class="mb-1 fw-bold">Quản lý OKR</h4>
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item active">Quản lý OKR</li>
                    </ol>
                </div>
                @if (canCreateOkr)
                {
                    <a asp-action="Create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 page-create-action">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Tạo OKR</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- SUMMARY CARDS (5 WIDGETS) -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3 mb-3" aria-label="Tổng quan OKR">
        <div class="col">
            <div class="card card-animate summary-stat-card mb-0 h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <p class="text-uppercase fw-semibold text-muted text-truncate mb-1 fs-12">Tổng OKR</p>
                            <h4 class="fs-22 fw-bold mb-0 text-primary">@(summary?.TotalCount ?? 0)</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-primary-subtle text-primary rounded-3 fs-3">
                                <i class="bi bi-bullseye"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-12 mb-0 mt-1"><span class="badge bg-primary-subtle text-primary"><i class="bi bi-funnel"></i> Tất cả</span> Tổng mục tiêu</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card card-animate summary-stat-card mb-0 h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <p class="text-uppercase fw-semibold text-muted text-truncate mb-1 fs-12">Cần chú ý</p>
                            <h4 class="fs-22 fw-bold mb-0 text-warning">@(summary?.NeedsAttentionCount ?? 0)</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-warning-subtle text-warning rounded-3 fs-3">
                                <i class="bi bi-exclamation-triangle"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-12 mb-0 mt-1"><span class="badge bg-warning-subtle text-warning"><i class="bi bi-clock-history me-1"></i> Chú ý</span> Chậm / Rủi ro</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card card-animate summary-stat-card mb-0 h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <p class="text-uppercase fw-semibold text-muted text-truncate mb-1 fs-12">Chưa có KR</p>
                            <h4 class="fs-22 fw-bold mb-0 text-secondary">@(summary?.WithoutKeyResultsCount ?? 0)</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-secondary-subtle text-secondary rounded-3 fs-3">
                                <i class="bi bi-key"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-12 mb-0 mt-1"><span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-pencil me-1"></i> Bổ sung</span> Cần thêm KR</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card card-animate summary-stat-card mb-0 h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <p class="text-uppercase fw-semibold text-muted text-truncate mb-1 fs-12">Hoàn thành</p>
                            <h4 class="fs-22 fw-bold mb-0 text-success">@(summary?.CompletedCount ?? 0)</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-success-subtle text-success rounded-3 fs-3">
                                <i class="bi bi-check-circle"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-12 mb-0 mt-1"><span class="badge bg-success-subtle text-success"><i class="bi bi-check2-circle me-1"></i> Tốt</span> Đạt 100%</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card card-animate summary-stat-card mb-0 h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <p class="text-uppercase fw-semibold text-muted text-truncate mb-1 fs-12">Tiến độ TB</p>
                            <h4 class="fs-22 fw-bold mb-0 text-info">@((summary?.AverageProgress ?? 0).ToString("0.#"))%</h4>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-info-subtle text-info rounded-3 fs-3">
                                <i class="bi bi-graph-up-arrow"></i>
                            </span>
                        </div>
                    </div>
                    <p class="text-muted text-truncate fs-12 mb-0 mt-1"><span class="badge bg-info-subtle text-info"><i class="bi bi-speedometer2 me-1"></i> Hiệu suất</span> Toàn chu kỳ</p>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN FILTER & ACCORDION PANEL -->
    <section class="okr-panel" aria-label="Danh sách OKR">
        <form asp-action="Index" method="get" class="okr-filter">
            @if (!string.IsNullOrWhiteSpace(currentQuickFilter))
            {
                <input type="hidden" name="quickFilter" value="@currentQuickFilter" />
            }
            <div class="okr-filter-grid">
                <div class="okr-filter-field okr-filter-field--search">
                    <label class="form-label" for="okr-search">Tìm kiếm</label>
                    <div class="position-relative okr-search-wrapper">
                        <i class="bi bi-search okr-search-icon"></i>
                        <input id="okr-search" type="text" name="searchString" value="@currentFilter" class="form-control okr-search-input" placeholder="Tìm mục tiêu, chu kỳ, phòng ban..." />
                    </div>
                </div>
                <div class="okr-filter-field">
                    <label class="form-label" for="okr-cycle">Chu kỳ</label>
                    <select id="okr-cycle" name="cycle" class="form-select no-select2">
                        <option value="">Tất cả</option>
                        @foreach (var c in Model?.AvailableCycles ?? Array.Empty<string>())
                        {
                            <option value="@c" selected="@(c == currentCycle ? "selected" : null)">@c</option>
                        }
                    </select>
                </div>
                <div class="okr-filter-field">
                    <label class="form-label" for="okr-status">Trạng thái</label>
                    <select id="okr-status" name="statusId" class="form-select no-select2">
                        <option value="">Tất cả</option>
                        @foreach (var s in Model?.AvailableStatuses ?? Array.Empty<Manage_KPI_or_OKR_System.Models.ViewModels.OkrStatusOptionViewModel>())
                        {
                            <option value="@s.Id" selected="@(currentStatusId == s.Id ? "selected" : null)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="okr-filter-field">
                    <label class="form-label" for="okr-type">Loại OKR</label>
                    <select id="okr-type" name="okrTypeId" class="form-select no-select2">
                        <option value="">Tất cả</option>
                        @foreach (var t in Model?.AvailableOkrTypes ?? Array.Empty<Manage_KPI_or_OKR_System.Models.ViewModels.OkrTypeOptionViewModel>())
                        {
                            <option value="@t.Id" selected="@(currentOkrTypeId == t.Id ? "selected" : null)">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="okr-filter-field">
                    <label class="form-label" for="okr-scope">Phạm vi</label>
                    <select id="okr-scope" name="scope" class="form-select no-select2">
                        <option value="" selected="@(string.IsNullOrEmpty(currentScope) ? "selected" : null)">Tất cả</option>
                        <option value="mine" selected="@(currentScope == "mine" ? "selected" : null)">Của tôi</option>
                        <option value="department" selected="@(currentScope == "department" ? "selected" : null)">Phòng ban</option>
                        <option value="company" selected="@(currentScope == "company" ? "selected" : null)">Công ty</option>
                    </select>
                </div>
                <div class="okr-filter-field okr-filter-field--sort">
                    <label class="form-label" for="okr-sort">Sắp xếp</label>
                    <select id="okr-sort" name="sortBy" class="form-select no-select2">
                        <option value="" selected="@(string.IsNullOrEmpty(currentSortBy) ? "selected" : null)">Tất cả</option>
                        <option value="attention" selected="@(currentSortBy == "attention" ? "selected" : null)">Cần chú ý trước</option>
                        <option value="recent" selected="@(currentSortBy == "recent" ? "selected" : null)">Mới cập nhật</option>
                        <option value="progress-low" selected="@(currentSortBy == "progress-low" ? "selected" : null)">Tiến độ thấp</option>
                        <option value="progress-high" selected="@(currentSortBy == "progress-high" ? "selected" : null)">Tiến độ cao</option>
                        <option value="cycle" selected="@(currentSortBy == "cycle" ? "selected" : null)">Chu kỳ gần</option>
                    </select>
                </div>
                <div class="okr-filter-actions">
                    <button type="submit" class="btn btn-primary okr-filter-submit-btn" title="Lọc" aria-label="Lọc">
                        <i class="bi bi-funnel" aria-hidden="true"></i>
                    </button>
                    @if (hasActiveFilters)
                    {
                        <a asp-action="Index" class="btn btn-light" title="Xóa tất cả bộ lọc">Xóa lọc</a>
                    }
                    <button type="button" class="btn btn-outline-secondary" id="toggleAllBtn" aria-label="Mở rộng hoặc thu gọn tất cả Key Results" title="Mở rộng / thu gọn tất cả"><i class="bi bi-list-task" aria-hidden="true"></i></button>
                </div>
            </div>
            <div class="okr-quick-filters" aria-label="Lọc nhanh OKR">
                <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-cycle="@currentCycle" asp-route-statusId="@currentStatusId" asp-route-okrTypeId="@currentOkrTypeId" asp-route-scope="@currentScope" asp-route-sortBy="@currentSortBy" class="@QuickFilterClass("")"><i class="bi bi-grid-3x3-gap"></i> Tất cả</a>
                <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-cycle="@currentCycle" asp-route-statusId="@currentStatusId" asp-route-okrTypeId="@currentOkrTypeId" asp-route-scope="@currentScope" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="mine" class="@QuickFilterClass("mine")"><i class="bi bi-person-check"></i> Của tôi</a>
                <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-cycle="@currentCycle" asp-route-statusId="@currentStatusId" asp-route-okrTypeId="@currentOkrTypeId" asp-route-scope="@currentScope" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="attention" class="@QuickFilterClass("attention")"><i class="bi bi-exclamation-triangle"></i> Cần chú ý</a>
                <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-cycle="@currentCycle" asp-route-statusId="@currentStatusId" asp-route-okrTypeId="@currentOkrTypeId" asp-route-scope="@currentScope" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="no-kr" class="@QuickFilterClass("no-kr")"><i class="bi bi-key"></i> Chưa có KR</a>
                @if (canViewProjects)
                {
                    <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-cycle="@currentCycle" asp-route-statusId="@currentStatusId" asp-route-okrTypeId="@currentOkrTypeId" asp-route-scope="@currentScope" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="has-project" class="@QuickFilterClass("has-project")"><i class="bi bi-kanban"></i> Có dự án</a>
                }
                <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-cycle="@currentCycle" asp-route-statusId="@currentStatusId" asp-route-okrTypeId="@currentOkrTypeId" asp-route-scope="@currentScope" asp-route-sortBy="@currentSortBy" asp-route-quickFilter="unallocated" class="@QuickFilterClass("unallocated")"><i class="bi bi-people"></i> Chưa phân bổ</a>
            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center mb-3 px-1">
            <div class="text-muted small">
                <strong>@(summary?.TotalCount ?? 0)</strong> OKR phù hợp
                @if (hasActiveFilters)
                {
                    <span>· đang áp dụng bộ lọc</span>
                }
            </div>
        </div>

        <div class="accordion" id="accordionOKRs">
            @if (pageItems != null && pageItems.Any())
            {
                var index = 0;
                foreach (var okr in pageItems)
                {
                    index++;
                    ViewData["Index"] = index;
                    ViewData["CanCreateOkr"] = canCreateOkr;
                    ViewData["CanEditOkr"] = canEditOkr;
                    ViewData["CanDeleteOkr"] = canDeleteOkr;
                    @await Html.PartialAsync("_OkrObjectiveCard", okr)
                }
            }
            else if (isFilteredEmpty)
            {
                <div class="okr-empty" role="status">
                    <div class="okr-empty__icon" aria-hidden="true"><i class="bi bi-funnel"></i></div>
                    <h3>Không có OKR khớp bộ lọc</h3>
                    <p>Thử đổi điều kiện hoặc xóa lọc để xem toàn bộ OKR trong phạm vi quyền của bạn.</p>
                    <a asp-action="Index" class="btn btn-outline-primary">Xóa lọc</a>
                </div>
            }
            else
            {
                <div class="okr-empty" role="status">
                    <div class="okr-empty__icon" aria-hidden="true"><i class="bi bi-bullseye"></i></div>
                    <h3>Chưa có mục tiêu OKR nào</h3>
                    <p>Thiết lập objective đầu tiên để theo dõi tiến độ và liên kết dự án vận hành.</p>
                    @if (canCreateOkr)
                    {
                        <a asp-action="Create" class="btn btn-primary page-create-action"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Tạo OKR</span></a>
                    }
                </div>
            }
        </div>

        <!-- PAGINATION -->
        @if (pageItems != null && pageItems.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-4 px-2">
                <div class="text-muted small">
                    Hiển thị trang @pageItems.PageIndex trên tổng số @pageItems.TotalPages
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0 gap-1">
                        <li class="page-item @(!pageItems.HasPreviousPage ? "disabled" : "")">
                            @if (pageItems.HasPreviousPage && pageItems.PreviousPageNumber.HasValue)
                            {
                                <a class="page-link border-0 rounded-circle text-dark shadow-none" asp-action="Index"
                                   asp-route-pageNumber="@pageItems.PreviousPageNumber"
                                   asp-route-searchString="@currentFilter"
                                   asp-route-cycle="@currentCycle"
                                   asp-route-statusId="@currentStatusId"
                                   asp-route-okrTypeId="@currentOkrTypeId"
                                   asp-route-scope="@currentScope"
                                   asp-route-quickFilter="@currentQuickFilter"
                                   asp-route-sortBy="@currentSortBy"
                                   aria-label="Trang trước">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            }
                            else
                            {
                                <span class="page-link border-0 rounded-circle text-dark shadow-none" aria-disabled="true" aria-label="Trang trước">
                                    <i class="bi bi-chevron-left"></i>
                                </span>
                            }
                        </li>

                        @for (int i = 1; i <= pageItems.TotalPages; i++)
                        {
                            if (i == 1 || i == pageItems.TotalPages || (i >= pageItems.PageIndex - 1 && i <= pageItems.PageIndex + 1))
                            {
                                <li class="page-item @(i == pageItems.PageIndex ? "active" : "")">
                                    <a class="page-link border-0 rounded-circle shadow-none @(i == pageItems.PageIndex ? "" : "text-dark")" asp-action="Index"
                                       asp-route-pageNumber="@i"
                                       asp-route-searchString="@currentFilter"
                                       asp-route-cycle="@currentCycle"
                                       asp-route-statusId="@currentStatusId"
                                       asp-route-okrTypeId="@currentOkrTypeId"
                                       asp-route-scope="@currentScope"
                                       asp-route-quickFilter="@currentQuickFilter"
                                       asp-route-sortBy="@currentSortBy">@i</a>
                                </li>
                            }
                            else if (i == pageItems.PageIndex - 2 || i == pageItems.PageIndex + 2)
                            {
                                <li class="page-item disabled"><span class="page-link border-0">...</span></li>
                            }
                        }

                        <li class="page-item @(!pageItems.HasNextPage ? "disabled" : "")">
                            @if (pageItems.HasNextPage && pageItems.NextPageNumber.HasValue)
                            {
                                <a class="page-link border-0 rounded-circle text-dark shadow-none" asp-action="Index"
                                   asp-route-pageNumber="@pageItems.NextPageNumber"
                                   asp-route-searchString="@currentFilter"
                                   asp-route-cycle="@currentCycle"
                                   asp-route-statusId="@currentStatusId"
                                   asp-route-okrTypeId="@currentOkrTypeId"
                                   asp-route-scope="@currentScope"
                                   asp-route-quickFilter="@currentQuickFilter"
                                   asp-route-sortBy="@currentSortBy"
                                   aria-label="Trang sau">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            }
                            else
                            {
                                <span class="page-link border-0 rounded-circle text-dark shadow-none" aria-disabled="true" aria-label="Trang sau">
                                    <i class="bi bi-chevron-right"></i>
                                </span>
                            }
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>
</div>

@await Html.PartialAsync("_OkrIndexModals", Model)

@section Styles {
    <link rel="stylesheet" href="~/css/okrs-index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/okrs-index.js" asp-append-version="true"></script>
}
