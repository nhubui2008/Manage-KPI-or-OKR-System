@model List<Manage_KPI_or_OKR_System.Models.BonusRule>
@{
    ViewData["Title"] = "Chính sách Thưởng/Phạt";
    var rules = Model ?? new List<Manage_KPI_or_OKR_System.Models.BonusRule>();
    var ranks = ViewBag.Ranks as Dictionary<int, string> ?? new Dictionary<int, string>();
    var rankDescriptions = ViewBag.RankDescriptions as Dictionary<int, string> ?? new Dictionary<int, string>();
    var allRanks = ViewBag.AllRanks as List<Manage_KPI_or_OKR_System.Models.GradingRank> ?? new List<Manage_KPI_or_OKR_System.Models.GradingRank>();
    var isAdminRole = User.IsInRole("Admin") || User.IsInRole("Administrator");
    var canCreateRule = isAdminRole || User.HasClaim("Permission", "BONUSRULES_CREATE");
    var canEditRule = isAdminRole || User.HasClaim("Permission", "BONUSRULES_EDIT");
    var canDeleteRule = isAdminRole || User.HasClaim("Permission", "BONUSRULES_DELETE");
    var canManageRule = canEditRule || canDeleteRule;
    var percentageRuleCount = rules.Count(rule => rule.BonusPercentage.GetValueOrDefault() > 0);
    var fixedRuleCount = rules.Count(rule => rule.FixedAmount.GetValueOrDefault() > 0);
    var coveredRankCount = rules.Where(rule => rule.RankId.HasValue).Select(rule => rule.RankId).Distinct().Count();
}

@section Styles {
    <link rel="stylesheet" href="~/css/bonus-rules.css" asp-append-version="true" />
}

<div class="evaluation-page bonus-rules-page">
    <div class="d-none">@Html.AntiForgeryToken()</div>

    <header class="evaluation-page-header">
        <div>
            <h1>Quy định Thưởng &amp; Phạt KPI</h1>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Chính sách thưởng/phạt</span>
            </nav>
        </div>
        @if (canCreateRule)
        {
            <button type="button" class="evaluation-primary-action" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Thêm quy định mới</span>
            </button>
        }
    </header>

    <section class="evaluation-summary bonus-rules-summary" aria-label="Tổng quan quy tắc thưởng">
        <article>
            <span>Tổng quy tắc</span>
            <strong>@rules.Count</strong>
            <small>Chính sách đang cấu hình</small>
        </article>
        <article>
            <span>Thưởng theo tỷ lệ</span>
            <strong>@percentageRuleCount</strong>
            <small>Có phần trăm thưởng</small>
        </article>
        <article>
            <span>Thưởng cố định</span>
            <strong>@fixedRuleCount</strong>
            <small>Có mức tiền cụ thể</small>
        </article>
        <article>
            <span>Xếp loại đã áp dụng</span>
            <strong>@coveredRankCount/@allRanks.Count</strong>
            <small>Mức xếp hạng đã có quy tắc</small>
        </article>
    </section>

    <section class="evaluation-results bonus-rules-results" aria-labelledby="bonusRulesHeading">
        <div class="evaluation-results-heading">
            <div>
                <p class="evaluation-eyebrow" id="bonusRulesHeading">Danh sách quy định</p>
                <strong>@rules.Count quy tắc thưởng đang áp dụng</strong>
            </div>
            <span>Thưởng theo xếp loại đánh giá KPI</span>
        </div>

        <div class="evaluation-table-shell bonus-rules-desktop">
            <table class="evaluation-table bonus-rules-table" aria-label="Danh sách quy tắc thưởng KPI">
                <thead>
                    <tr>
                        <th>Xếp loại áp dụng</th>
                        <th>% Thưởng</th>
                        <th>Số tiền cố định (VNĐ)</th>
                        @if (canManageRule)
                        {
                            <th class="text-end">Thao tác</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (rules.Count > 0)
                    {
                        @foreach (var r in rules)
                        {
                            var rankCode = r.RankId.HasValue && ranks.ContainsKey(r.RankId.Value) ? ranks[r.RankId.Value] : "N/A";
                            var rankDesc = r.RankId.HasValue && rankDescriptions.ContainsKey(r.RankId.Value) ? rankDescriptions[r.RankId.Value] : "";
                            <tr>
                                <td>
                                    <div class="bonus-rule-rank">
                                        <span class="bonus-rule-rank__mark"><i class="bi bi-award" aria-hidden="true"></i></span>
                                        <div>
                                            <strong>Xếp loại @rankCode</strong>
                                            <small>@(string.IsNullOrWhiteSpace(rankDesc) ? "Chưa có mô tả xếp hạng" : rankDesc)</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="bonus-rule-percentage">@(r.BonusPercentage?.ToString("N2") ?? "0")%</span></td>
                                <td><span class="bonus-rule-amount">@(r.FixedAmount?.ToString("N0") ?? "0") VNĐ</span></td>
                                @if (canManageRule)
                                {
                                    <td>
                                        <div class="evaluation-actions">
                                            @if (canEditRule)
                                            {
                                                <button type="button" class="evaluation-icon-button"
                                                        title="Chỉnh sửa" aria-label="Chỉnh sửa quy tắc xếp loại @rankCode"
                                                        onclick="showEditModal('@r.Id', '@r.RankId', '@(r.BonusPercentage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")', '@(r.FixedAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")')">
                                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                </button>
                                            }
                                            @if (canDeleteRule)
                                            {
                                                <form asp-action="Delete" method="post" class="m-0"
                                                      data-app-confirm
                                                      data-confirm-title="Xóa quy tắc thưởng?"
                                                      data-confirm-message="Quy tắc thưởng này sẽ bị xóa khỏi cấu hình. Thao tác không thể hoàn tác."
                                                      data-confirm-tone="danger"
                                                      data-confirm-label="Xóa quy tắc">
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa quy tắc xếp loại @rankCode">
                                                         <i class="bi bi-trash3" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(canManageRule ? "4" : "3")" class="p-0">
                                <div class="evaluation-empty" role="status">
                                    <span class="evaluation-empty-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
                                    <h2>Chưa có quy tắc thưởng nào</h2>
                                    <p>Tạo quy tắc đầu tiên để liên kết mức xếp loại với tỷ lệ hoặc số tiền thưởng.</p>
                                    @if (canCreateRule)
                                    {
                                        <button type="button" class="evaluation-primary-action" data-bs-toggle="modal" data-bs-target="#createModal">Thêm quy định mới</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="evaluation-mobile-list bonus-rules-mobile">
            @if (rules.Count > 0)
            {
                @foreach (var r in rules)
                {
                    var rankCode = r.RankId.HasValue && ranks.ContainsKey(r.RankId.Value) ? ranks[r.RankId.Value] : "N/A";
                    var rankDesc = r.RankId.HasValue && rankDescriptions.ContainsKey(r.RankId.Value) ? rankDescriptions[r.RankId.Value] : "";
                    <article class="evaluation-period-card bonus-rule-card">
                        <div class="evaluation-card-topline">
                            <span class="bonus-rule-percentage">@(r.BonusPercentage?.ToString("N2") ?? "0")%</span>
                            <span class="evaluation-config-status">Quy tắc thưởng KPI</span>
                        </div>
                        <h2>Xếp loại @rankCode</h2>
                        <p>@(string.IsNullOrWhiteSpace(rankDesc) ? "Chưa có mô tả xếp hạng" : rankDesc)</p>
                        <dl>
                            <div><dt>Phần trăm thưởng</dt><dd>@(r.BonusPercentage?.ToString("N2") ?? "0")%</dd></div>
                            <div><dt>Số tiền cố định</dt><dd>@(r.FixedAmount?.ToString("N0") ?? "0") VNĐ</dd></div>
                        </dl>
                        @if (canManageRule)
                        {
                            <div class="evaluation-card-footer">
                                <div class="evaluation-actions">
                                    @if (canEditRule)
                                    {
                                        <button type="button" class="evaluation-icon-button"
                                                title="Chỉnh sửa" aria-label="Chỉnh sửa quy tắc xếp loại @rankCode"
                                                onclick="showEditModal('@r.Id', '@r.RankId', '@(r.BonusPercentage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")', '@(r.FixedAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")')">
                                            <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                        </button>
                                    }
                                    @if (canDeleteRule)
                                    {
                                        <form asp-action="Delete" method="post" class="m-0"
                                              data-app-confirm
                                              data-confirm-title="Xóa quy tắc thưởng?"
                                              data-confirm-message="Quy tắc thưởng này sẽ bị xóa khỏi cấu hình. Thao tác không thể hoàn tác."
                                              data-confirm-tone="danger"
                                              data-confirm-label="Xóa quy tắc">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" title="Xóa" aria-label="Xóa quy tắc xếp loại @rankCode">
                                                <i class="bi bi-trash3" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </article>
                }
            }
            else
            {
                <div class="evaluation-empty" role="status">
                    <span class="evaluation-empty-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
                    <h2>Chưa có quy tắc thưởng nào</h2>
                    <p>Tạo quy tắc đầu tiên để liên kết mức xếp loại với tỷ lệ hoặc số tiền thưởng.</p>
                    @if (canCreateRule)
                    {
                        <button type="button" class="evaluation-primary-action" data-bs-toggle="modal" data-bs-target="#createModal">Thêm quy định mới</button>
                    }
                </div>
            }
        </div>
    </section>
</div>

<!-- Modal Thêm Mới -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content evaluation-modal bonus-rule-modal">
            <div class="modal-header">
                <h2 class="modal-title" id="createModalTitle"><i class="bi bi-cash-coin text-primary me-2" aria-hidden="true"></i>Thêm quy tắc thưởng</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="bonus-rule-form-grid">
                        <label class="bonus-rule-form-field--full" for="createRankCode">
                            <span>Mã xếp hạng <span class="text-danger">*</span></span>
                            <input type="text" id="createRankCode" name="rankCode" required placeholder="VD: A, B, C, EXCELLENT..." maxlength="10" autocomplete="off" />
                            <small class="evaluation-form-hint">Mã ngắn để định danh mức độ, tối đa 10 ký tự.</small>
                        </label>
                        <label class="bonus-rule-form-field--full" for="createRankDescription">
                            <span>Mô tả xếp hạng</span>
                            <input type="text" id="createRankDescription" name="rankDescription" placeholder="VD: Hoàn thành xuất sắc nhiệm vụ" autocomplete="off" />
                        </label>
                        <label for="createBonusPercentage">
                            <span>Phần trăm thưởng</span>
                            <div class="input-group">
                                <input type="number" id="createBonusPercentage" name="BonusPercentage" step="0.01" min="0" max="100" placeholder="0.00" />
                                <span class="input-group-text">%</span>
                            </div>
                        </label>
                        <label for="createFixedAmount">
                            <span>Số tiền cố định</span>
                            <div class="input-group">
                                <input type="text" id="createFixedAmount" name="FixedAmount" class="number-format" inputmode="numeric" placeholder="0" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="evaluation-secondary-action" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="evaluation-primary-action">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Tạo mới</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content evaluation-modal bonus-rule-modal">
            <div class="modal-header">
                <h2 class="modal-title" id="editModalTitle"><i class="bi bi-pencil-square text-primary me-2" aria-hidden="true"></i>Chỉnh sửa quy tắc</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-body">
                    <div class="bonus-rule-form-grid">
                        <label class="bonus-rule-form-field--full" for="editRankId">
                            <span>Xếp hạng áp dụng</span>
                            <select name="RankId" id="editRankId" required>
                                <option value="">-- Chọn xếp hạng --</option>
                                @foreach (var rk in allRanks)
                                {
                                    <option value="@rk.Id">@rk.RankCode - @rk.Description</option>
                                }
                            </select>
                        </label>
                        <label for="editBonusPercentage">
                            <span>Phần trăm thưởng</span>
                            <div class="input-group">
                                <input type="number" name="BonusPercentage" id="editBonusPercentage" step="0.01" min="0" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                        </label>
                        <label for="editFixedAmount">
                            <span>Số tiền cố định</span>
                            <div class="input-group">
                                <input type="text" name="FixedAmount" id="editFixedAmount" class="number-format" inputmode="numeric" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="evaluation-secondary-action" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="evaluation-primary-action">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span>Lưu thay đổi</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/bonus-rules.js" asp-append-version="true"></script>
}
