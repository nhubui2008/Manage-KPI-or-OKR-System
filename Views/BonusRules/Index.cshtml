@model List<Manage_KPI_or_OKR_System.Models.BonusRule>
@using System.Globalization
@{
    ViewData["Title"] = "Quy tắc thưởng KPI";
    var rules = Model ?? new List<Manage_KPI_or_OKR_System.Models.BonusRule>();
    var ranks = ViewBag.Ranks as Dictionary<int, string> ?? new Dictionary<int, string>();
    var rankDescriptions = ViewBag.RankDescriptions as Dictionary<int, string> ?? new Dictionary<int, string>();
    var allRanks = ViewBag.AllRanks as List<Manage_KPI_or_OKR_System.Models.GradingRank> ?? new List<Manage_KPI_or_OKR_System.Models.GradingRank>();
    var isAdminRole = User.IsInRole("Admin") || User.IsInRole("Administrator");
    var canCreateRule = isAdminRole || User.HasClaim("Permission", "BONUSRULES_CREATE");
    var canEditRule = isAdminRole || User.HasClaim("Permission", "BONUSRULES_EDIT");
    var canDeleteRule = isAdminRole || User.HasClaim("Permission", "BONUSRULES_DELETE");
    var canManageRule = canEditRule || canDeleteRule;
    var percentageRuleCount = rules.Count(rule => rule.BonusPercentage.GetValueOrDefault() > 0);
    var fixedRuleCount = rules.Count(rule => rule.FixedAmount.GetValueOrDefault() > 0);
    var coveredRankCount = rules.Where(rule => rule.RankId.HasValue).Select(rule => rule.RankId).Distinct().Count();
    var vi = CultureInfo.GetCultureInfo("vi-VN");
}

@section Styles {
    <link rel="stylesheet" href="~/css/bonus-rules.css" asp-append-version="true" />
}

<div class="bonus-rules-page" data-module="bonus-rules" data-rule-count="@rules.Count">
    <header class="bonus-rules-page-title">
        <div>
            <nav class="bonus-rules-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Quy tắc thưởng KPI</span>
            </nav>
            <h1>Quy tắc thưởng KPI</h1>
            <p>Thiết lập mức thưởng theo xếp loại; phần trăm được tính trên số tiền cố định của quy tắc.</p>
        </div>
        @if (canCreateRule)
        {
            <button type="button" class="bonus-rules-primary-action page-create-action" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i><span>Tạo quy tắc</span>
            </button>
        }
    </header>

    <section class="bonus-rules-summary row g-3" aria-label="Tổng quan quy tắc thưởng">
        <div class="col-6 col-xl-3">
            <article class="bonus-rules-summary-card bonus-rules-summary-card--primary">
                <span class="bonus-rules-summary-icon"><i class="bi bi-collection" aria-hidden="true"></i></span>
                <div>
                    <span>Tổng quy tắc</span>
                    <strong>@rules.Count</strong>
                    <small>Đã được cấu hình</small>
                </div>
            </article>
        </div>
        <div class="col-6 col-xl-3">
            <article class="bonus-rules-summary-card bonus-rules-summary-card--success">
                <span class="bonus-rules-summary-icon"><i class="bi bi-percent" aria-hidden="true"></i></span>
                <div>
                    <span>Có phần trăm</span>
                    <strong>@percentageRuleCount</strong>
                    <small>Giá trị lớn hơn 0</small>
                </div>
            </article>
        </div>
        <div class="col-6 col-xl-3">
            <article class="bonus-rules-summary-card bonus-rules-summary-card--info">
                <span class="bonus-rules-summary-icon"><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
                <div>
                    <span>Có tiền cố định</span>
                    <strong>@fixedRuleCount</strong>
                    <small>Giá trị lớn hơn 0</small>
                </div>
            </article>
        </div>
        <div class="col-6 col-xl-3">
            <article class="bonus-rules-summary-card bonus-rules-summary-card--warning">
                <span class="bonus-rules-summary-icon"><i class="bi bi-award" aria-hidden="true"></i></span>
                <div>
                    <span>Độ phủ xếp loại</span>
                    <strong>@coveredRankCount/@allRanks.Count</strong>
                    <small>Rank đã có quy tắc</small>
                </div>
            </article>
        </div>
    </section>

    <section class="bonus-rules-toolbar" aria-labelledby="bonus-filter-title">
        <div class="bonus-rules-toolbar-heading"><div><h2 id="bonus-filter-title">Tìm và lọc</h2><p>Tìm theo mã hoặc mô tả xếp loại, rồi sắp xếp danh sách ngay trên trang.</p></div><span id="bonusResultCount" role="status" aria-live="polite">@rules.Count quy tắc</span></div>
        <div class="bonus-rules-filter-grid">
            <label class="bonus-rules-search"><span>Tìm kiếm</span><div class="bonus-search-input-wrap"><i class="bi bi-search" aria-hidden="true"></i><input id="bonusSearch" type="search" placeholder="Tìm theo mã hoặc mô tả xếp loại..." autocomplete="off" /><button id="bonusSearchClear" type="button" aria-label="Xóa nội dung tìm kiếm" hidden><i class="bi bi-x-lg" aria-hidden="true"></i></button></div></label>
            <label><span>Loại cấu hình</span><select id="bonusFilter" class="no-select2"><option value="all">Tất cả</option><option value="percentage">Có phần trăm</option><option value="fixed">Có tiền cố định</option><option value="both">Có cả hai</option><option value="empty">Chưa có giá trị thưởng</option></select></label>
            <label><span>Sắp xếp</span><select id="bonusSort" class="no-select2"><option value="default">Thứ tự mặc định</option><option value="rank-asc">Rank A–Z</option><option value="rank-desc">Rank Z–A</option><option value="percentage-asc">Phần trăm tăng dần</option><option value="percentage-desc">Phần trăm giảm dần</option><option value="fixed-asc">Tiền cố định tăng dần</option><option value="fixed-desc">Tiền cố định giảm dần</option></select></label>
            <button id="bonusReset" type="button" class="bonus-rules-secondary-action" disabled><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Đặt lại</button>
        </div>
    </section>

    <section class="bonus-rules-list-card" aria-labelledby="bonus-list-title">
        <div class="bonus-rules-list-heading"><div><h2 id="bonus-list-title">Danh sách quy tắc</h2><p>Thông tin hiển thị gồm xếp loại, mức thưởng và trạng thái cấu hình.</p></div><span aria-hidden="true">@rules.Count mục</span></div>
        @if (rules.Count == 0)
        {
            <div class="bonus-rules-empty" role="status"><span><i class="bi bi-cash-coin" aria-hidden="true"></i></span><h2>Chưa có quy tắc thưởng</h2><p>Tạo quy tắc đầu tiên để liên kết xếp loại với tỷ lệ hoặc số tiền thưởng.</p>@if (canCreateRule) { <button type="button" class="bonus-rules-primary-action page-create-action" data-bs-toggle="modal" data-bs-target="#createModal"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Tạo quy tắc</span></button> }</div>
        }
        else
        {
            <div class="bonus-rules-filter-empty" id="bonusFilterEmpty" hidden><i class="bi bi-search" aria-hidden="true"></i><h3>Không tìm thấy quy tắc phù hợp</h3><p>Thử thay đổi từ khóa hoặc đặt lại bộ lọc.</p><button type="button" class="bonus-rules-secondary-action" data-bonus-reset>Đặt lại bộ lọc</button></div>
            <div class="table-responsive bonus-rules-table-wrap"><table class="table bonus-rules-table align-middle"><caption class="visually-hidden">Danh sách quy tắc thưởng KPI</caption><thead><tr><th scope="col">Xếp loại</th><th scope="col">Phần trăm</th><th scope="col">Tiền cố định</th><th scope="col">Trạng thái</th>@if (canManageRule) { <th scope="col" class="text-end">Thao tác</th> }</tr></thead><tbody id="bonusRulesTableBody">
                @foreach (var rule in rules)
                {
                    var rankCode = rule.RankId.HasValue && ranks.TryGetValue(rule.RankId.Value, out var code) ? code : "Chưa xác định";
                    var description = rule.RankId.HasValue && rankDescriptions.TryGetValue(rule.RankId.Value, out var itemDescription) ? itemDescription ?? "Chưa có mô tả" : "Chưa có mô tả";
                    var percentage = rule.BonusPercentage.GetValueOrDefault(); var fixedAmount = rule.FixedAmount.GetValueOrDefault(); var hasPercentage = percentage > 0; var hasFixed = fixedAmount > 0;
                    <tr class="bonus-rule-item" data-rule-id="@rule.Id" data-rank-code="@rankCode" data-rank-description="@description" data-bonus-percentage="@rule.BonusPercentage?.ToString(CultureInfo.InvariantCulture)" data-fixed-amount="@rule.FixedAmount?.ToString(CultureInfo.InvariantCulture)">
                        <td><div class="bonus-rule-rank"><span><i class="bi bi-award" aria-hidden="true"></i></span><div><strong>@rankCode</strong><small>@description</small></div></div></td>
                        <td><strong>@(rule.BonusPercentage.HasValue ? $"{rule.BonusPercentage:0.##}%" : "—")</strong></td>
                        <td><strong>@(rule.FixedAmount.HasValue ? $"{rule.FixedAmount.Value.ToString("N0", vi)} ₫" : "—")</strong></td>
                        <td><span class="bonus-rule-status @(hasPercentage || hasFixed ? "is-configured" : "")">@(hasPercentage && hasFixed ? "Kết hợp" : hasPercentage ? "Theo phần trăm" : hasFixed ? "Tiền cố định" : "Chưa cấu hình")</span></td>
                        @if (canManageRule) { <td><div class="bonus-rule-actions">@if (canEditRule) { <button type="button" class="bonus-rule-icon-button" title="Sửa quy tắc @rankCode" aria-label="Sửa quy tắc xếp loại @rankCode" onclick="showEditModal('@rule.Id', '@rule.RankId', '@rule.BonusPercentage?.ToString(CultureInfo.InvariantCulture)', '@rule.FixedAmount?.ToString(CultureInfo.InvariantCulture)')"><i class="bi bi-pencil-square" aria-hidden="true"></i></button> } @if (canDeleteRule) { <form asp-action="Delete" method="post" data-app-confirm data-confirm-title="Xóa quy tắc thưởng?" data-confirm-message="Quy tắc của xếp loại @rankCode sẽ bị xóa. Thao tác này không tự cập nhật hồi tố các khoản thưởng đã duyệt." data-confirm-tone="danger" data-confirm-label="Xóa quy tắc"><input type="hidden" name="id" value="@rule.Id" /><button type="submit" class="bonus-rule-icon-button is-danger" title="Xóa quy tắc @rankCode" aria-label="Xóa quy tắc xếp loại @rankCode"><i class="bi bi-trash3" aria-hidden="true"></i></button></form> }</div></td> }
                    </tr>
                }
            </tbody></table></div>
            <div class="bonus-rules-mobile-list" id="bonusRulesMobileList" aria-label="Danh sách quy tắc thưởng trên thiết bị nhỏ">
                @foreach (var rule in rules)
                {
                    var rankCode = rule.RankId.HasValue && ranks.TryGetValue(rule.RankId.Value, out var code) ? code : "Chưa xác định"; var description = rule.RankId.HasValue && rankDescriptions.TryGetValue(rule.RankId.Value, out var itemDescription) ? itemDescription ?? "Chưa có mô tả" : "Chưa có mô tả"; var percentage = rule.BonusPercentage.GetValueOrDefault(); var fixedAmount = rule.FixedAmount.GetValueOrDefault(); var hasPercentage = percentage > 0; var hasFixed = fixedAmount > 0;
                    <article class="bonus-rule-item" data-rule-id="@rule.Id" data-rank-code="@rankCode" data-rank-description="@description" data-bonus-percentage="@rule.BonusPercentage?.ToString(CultureInfo.InvariantCulture)" data-fixed-amount="@rule.FixedAmount?.ToString(CultureInfo.InvariantCulture)"><div class="bonus-rule-mobile-heading"><div><h3>@rankCode</h3><p>@description</p></div><span class="bonus-rule-status @(hasPercentage || hasFixed ? "is-configured" : "")">@(hasPercentage && hasFixed ? "Kết hợp" : hasPercentage ? "Theo phần trăm" : hasFixed ? "Tiền cố định" : "Chưa cấu hình")</span></div><dl><div><dt>Phần trăm thưởng</dt><dd>@(rule.BonusPercentage.HasValue ? $"{rule.BonusPercentage:0.##}%" : "—")</dd></div><div><dt>Tiền cố định</dt><dd>@(rule.FixedAmount.HasValue ? $"{rule.FixedAmount.Value.ToString("N0", vi)} ₫" : "—")</dd></div></dl>@if (canManageRule) { <footer class="bonus-rule-mobile-actions">@if (canEditRule) { <button type="button" class="bonus-rules-secondary-action" onclick="showEditModal('@rule.Id', '@rule.RankId', '@rule.BonusPercentage?.ToString(CultureInfo.InvariantCulture)', '@rule.FixedAmount?.ToString(CultureInfo.InvariantCulture)')"><i class="bi bi-pencil-square" aria-hidden="true"></i>Sửa</button> } @if (canDeleteRule) { <form asp-action="Delete" method="post" data-app-confirm data-confirm-title="Xóa quy tắc thưởng?" data-confirm-message="Quy tắc của xếp loại @rankCode sẽ bị xóa. Thao tác này không tự cập nhật hồi tố các khoản thưởng đã duyệt." data-confirm-tone="danger" data-confirm-label="Xóa quy tắc"><input type="hidden" name="id" value="@rule.Id" /><button type="submit" class="bonus-rules-danger-action"><i class="bi bi-trash3" aria-hidden="true"></i>Xóa</button></form> }</footer> }</article>
                }
            </div>
        }
    </section>
</div>

@if (canCreateRule) { <div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable bonus-rules-modal-dialog"><div class="modal-content bonus-rules-modal"><div class="modal-header"><div class="bonus-rules-modal-title"><span><i class="bi bi-plus-circle" aria-hidden="true"></i></span><div><p>THIẾT LẬP MỚI</p><h2 class="modal-title" id="createModalTitle">Thêm quy tắc thưởng</h2></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><form asp-action="Create" method="post" data-bonus-submit><div class="modal-body"><div class="bonus-rules-modal-intro"><i class="bi bi-info-circle" aria-hidden="true"></i><p>Dùng mã xếp loại mới. Tỷ lệ phần trăm, nếu có, được tính trên tiền cố định.</p></div><div class="bonus-rules-form-grid"><label class="is-full" for="createRankCode"><span>Mã xếp hạng <em>*</em></span><input type="text" id="createRankCode" name="rankCode" required maxlength="10" autocomplete="off" placeholder="VD: A, B, EXCELLENT" /><small>Tối đa 10 ký tự.</small></label><label class="is-full" for="createRankDescription"><span>Mô tả xếp hạng</span><input type="text" id="createRankDescription" name="rankDescription" autocomplete="off" placeholder="Mô tả mức xếp loại" /></label><label for="createBonusPercentage"><span>Phần trăm thưởng</span><div class="input-group"><input type="number" id="createBonusPercentage" name="BonusPercentage" step="0.01" min="0" max="100" placeholder="0.00" /><span class="input-group-text">%</span></div></label><label for="createFixedAmount"><span>Số tiền cố định</span><div class="input-group"><input type="text" id="createFixedAmount" name="FixedAmount" class="number-format" data-number-format inputmode="numeric" placeholder="0" /><span class="input-group-text">VNĐ</span></div></label></div></div><div class="modal-footer"><p><i class="bi bi-shield-check" aria-hidden="true"></i> Kiểm tra lại thông tin trước khi tạo.</p><div><button type="button" class="bonus-rules-secondary-action" data-bs-dismiss="modal">Hủy</button><button type="submit" class="bonus-rules-primary-action"><i class="bi bi-plus-lg" aria-hidden="true"></i><span class="bonus-submit-label">Tạo mới</span><span class="spinner-border spinner-border-sm" aria-hidden="true" hidden></span></button></div></div></form></div></div></div> }
@if (canEditRule) { <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable bonus-rules-modal-dialog"><div class="modal-content bonus-rules-modal"><div class="modal-header"><div class="bonus-rules-modal-title"><span><i class="bi bi-pencil-square" aria-hidden="true"></i></span><div><p>CẬP NHẬT QUY TẮC</p><h2 class="modal-title" id="editModalTitle">Chỉnh sửa quy tắc</h2></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><form asp-action="Edit" method="post" data-bonus-submit><input type="hidden" name="Id" id="editId" /><div class="modal-body"><div class="bonus-rules-modal-intro"><i class="bi bi-info-circle" aria-hidden="true"></i><p>Thay đổi sẽ áp dụng cho các lần tính thưởng tiếp theo.</p></div><p class="bonus-rules-modal-note" id="editModalError" role="alert" hidden></p><div class="bonus-rules-form-grid"><label class="is-full" for="editRankId"><span>Xếp hạng áp dụng <em>*</em></span><select name="RankId" id="editRankId" class="no-select2" required><option value="">-- Chọn xếp hạng --</option>@foreach (var rank in allRanks) { <option value="@rank.Id">@rank.RankCode - @rank.Description</option> }</select></label><label for="editBonusPercentage"><span>Phần trăm thưởng</span><div class="input-group"><input type="number" name="BonusPercentage" id="editBonusPercentage" step="0.01" min="0" max="100" /><span class="input-group-text">%</span></div></label><label for="editFixedAmount"><span>Số tiền cố định</span><div class="input-group"><input type="text" name="FixedAmount" id="editFixedAmount" class="number-format" data-number-format inputmode="numeric" /><span class="input-group-text">VNĐ</span></div></label></div></div><div class="modal-footer"><p><i class="bi bi-shield-check" aria-hidden="true"></i> Chỉ lưu khi thông tin đã chính xác.</p><div><button type="button" class="bonus-rules-secondary-action" data-bs-dismiss="modal">Hủy</button><button type="submit" class="bonus-rules-primary-action"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="bonus-submit-label">Lưu thay đổi</span><span class="spinner-border spinner-border-sm" aria-hidden="true" hidden></span></button></div></div></form></div></div></div> }

@section Scripts { <script src="~/js/bonus-rules.js" asp-append-version="true"></script> }
