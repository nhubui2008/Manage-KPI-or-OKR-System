@model Manage_KPI_or_OKR_System.Models.BonusRule
@{
    ViewData["Title"] = "Thêm Quy tắc thưởng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ranks = ViewBag.AllRanks as List<Manage_KPI_or_OKR_System.Models.GradingRank> ?? new List<Manage_KPI_or_OKR_System.Models.GradingRank>();
}

<div class="cf-page bonus-rule-create" data-create-form>
    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Thêm quy tắc thưởng</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Quy tắc thưởng</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Thêm mới</span>
            </nav>
            <p class="cf-header__description">Liên kết mức xếp loại đánh giá với tỷ lệ phần trăm hoặc số tiền thưởng cố định.</p>
        </div>
        <a asp-action="Index" class="cf-back-action">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại</span>
        </a>
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="bonusRuleFormHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="bonusRuleFormHeading">Thông tin quy tắc</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
            </div>

            <form asp-action="Create" method="post" class="cf-form" data-create-form-element>
                <div asp-validation-summary="ModelOnly" class="cf-alert" role="alert" tabindex="-1"></div>

                <section class="cf-section" aria-labelledby="rankSectionHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-award"></i></span>
                        <div>
                            <h3 id="rankSectionHeading">Xếp loại áp dụng</h3>
                            <p>Chọn mức xếp loại đánh giá cho quy tắc này.</p>
                        </div>
                    </div>
                    <div class="cf-field-grid cf-field-grid--wide-first">
                        <div class="cf-field">
                            <label asp-for="RankId">Mức xếp loại <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <select asp-for="RankId" id="RankId" class="form-select cf-control no-select2" required>
                                <option value="">-- Chọn mức xếp loại --</option>
                                @foreach (var r in ranks)
                                {
                                    <option value="@r.Id">@r.RankCode (@r.Description)</option>
                                }
                            </select>
                            <span asp-validation-for="RankId" class="cf-validation"></span>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="bonusDetailsHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-cash-stack"></i></span>
                        <div>
                            <h3 id="bonusDetailsHeading">Chi tiết thưởng</h3>
                            <p>Nhập tỷ lệ phần trăm thưởng hoặc số tiền thưởng cố định.</p>
                        </div>
                    </div>
                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label asp-for="BonusPercentage">Tỷ lệ thưởng (%) <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="BonusPercentage" id="BonusPercentage" type="number" step="0.1" class="form-control cf-control" placeholder="VD: 5.0, 10..." required />
                            <span asp-validation-for="BonusPercentage" class="cf-validation"></span>
                        </div>
                        <div class="cf-field">
                            <label asp-for="FixedAmount">Số tiền thưởng cố định (VNĐ)</label>
                            <input asp-for="FixedAmount" id="FixedAmount" type="number" step="0.01" class="form-control cf-control" placeholder="Để trống nếu chỉ dùng tỷ lệ %" />
                            <span asp-validation-for="FixedAmount" class="cf-validation"></span>
                        </div>
                    </div>
                </section>

                <div class="cf-actions">
                    <a asp-action="Index" class="cf-secondary-action">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                        <span>Hủy</span>
                    </a>
                    <button type="submit" class="cf-primary-action" data-submit-button data-default-label="Lưu Quy tắc" data-loading-label="Đang lưu...">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span data-submit-label aria-live="polite">Lưu Quy tắc</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide bonus-rule-preview" aria-labelledby="bonusRulePreviewHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-gift"></i></span>
                <div>
                    <span class="cf-guide__eyebrow">Xem trước</span>
                    <h2 id="bonusRulePreviewHeading">Quy tắc thưởng</h2>
                </div>
            </div>
            <p id="previewStatus" role="status" aria-live="polite">Chọn xếp loại và nhập giá trị thưởng để xem trước.</p>
            <dl class="cf-preview-list">
                <div>
                    <dt>Xếp loại</dt>
                    <dd id="previewRank">--</dd>
                </div>
                <div>
                    <dt>Tỷ lệ %</dt>
                    <dd id="previewPct">--</dd>
                </div>
                <div>
                    <dt>Tiền cố định</dt>
                    <dd id="previewFixed">--</dd>
                </div>
            </dl>
            <ul class="cf-guide__list">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Mỗi xếp loại chỉ có một quy tắc thưởng.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Có thể kết hợp cả tỷ lệ và tiền cố định.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Để trống tiền cố định nếu chỉ áp dụng tỷ lệ %.</span></li>
            </ul>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bonus-rules.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
    <script>
        (function() {
            const rankSelect = document.getElementById('RankId');
            const pctInput = document.getElementById('BonusPercentage');
            const fixedInput = document.getElementById('FixedAmount');

            function updatePreview() {
                if (!rankSelect) return;
                const rankOpt = rankSelect.options[rankSelect.selectedIndex];
                const rankText = document.getElementById('previewRank');
                const pctText = document.getElementById('previewPct');
                const fixedText = document.getElementById('previewFixed');

                if (rankText) rankText.textContent = rankOpt && rankOpt.value ? rankOpt.text : '--';
                if (pctText) pctText.textContent = pctInput && pctInput.value ? pctInput.value + '%' : '--';
                if (fixedText) fixedText.textContent = fixedInput && fixedInput.value ? new Intl.NumberFormat('vi-VN').format(fixedInput.value) + ' ₫' : '--';
            }

            rankSelect?.addEventListener('change', updatePreview);
            pctInput?.addEventListener('input', updatePreview);
            fixedInput?.addEventListener('input', updatePreview);
            updatePreview();
        })();
    </script>
}
