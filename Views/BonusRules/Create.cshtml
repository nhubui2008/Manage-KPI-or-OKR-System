@model Manage_KPI_or_OKR_System.Models.BonusRule
@{
    ViewData["Title"] = "Thêm quy tắc thưởng KPI";
    var ranks = ViewBag.AllRanks as List<Manage_KPI_or_OKR_System.Models.GradingRank> ?? new List<Manage_KPI_or_OKR_System.Models.GradingRank>();
}
@section Styles { <link rel="stylesheet" href="~/css/bonus-rules.css" asp-append-version="true" /> }
<div class="bonus-rules-page bonus-rules-create-page" data-module="bonus-rules-create">
    <header class="bonus-rules-page-title"><div><nav class="bonus-rules-breadcrumb" aria-label="Điều hướng trang"><a href="/">Trang chủ</a><i class="bi bi-chevron-right" aria-hidden="true"></i><a asp-action="Index">Quy tắc thưởng KPI</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Thêm mới</span></nav><h1>Thêm quy tắc thưởng KPI</h1><p>Chọn xếp loại hiện có, sau đó thiết lập tỷ lệ hoặc số tiền thưởng phù hợp.</p></div><a asp-action="Index" class="bonus-rules-secondary-action"><i class="bi bi-arrow-left" aria-hidden="true"></i>Quay lại</a></header>
    <div class="row g-4"><div class="col-xl-8"><section class="bonus-rules-form-card"><div class="bonus-rules-card-header"><div><h2>Thông tin quy tắc</h2><p>Các trường có dấu * là bắt buộc.</p></div><i class="bi bi-gift" aria-hidden="true"></i></div><form asp-action="Create" method="post" data-bonus-submit><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div class="bonus-rules-form-grid bonus-rules-create-fields"><label class="is-full" for="RankId"><span>Mức xếp loại <em>*</em></span><select asp-for="RankId" class="no-select2" required><option value="">-- Chọn mức xếp loại --</option>@foreach (var rank in ranks) { <option value="@rank.Id">@rank.RankCode (@rank.Description)</option> }</select><span asp-validation-for="RankId" class="text-danger"></span></label><label for="BonusPercentage"><span>Tỷ lệ thưởng (%) <em>*</em></span><div class="input-group"><input asp-for="BonusPercentage" type="number" step="0.1" min="0" max="100" required placeholder="VD: 5.0, 10" /><span class="input-group-text">%</span></div><small>Được tính trên số tiền cố định của quy tắc.</small><span asp-validation-for="BonusPercentage" class="text-danger"></span></label><label for="FixedAmount"><span>Số tiền thưởng cố định</span><div class="input-group"><input asp-for="FixedAmount" type="number" step="0.01" min="0" placeholder="Để trống nếu chỉ dùng tỷ lệ %" /><span class="input-group-text">VNĐ</span></div><span asp-validation-for="FixedAmount" class="text-danger"></span></label></div><footer class="bonus-rules-form-footer"><a asp-action="Index" class="bonus-rules-secondary-action">Hủy</a><button type="submit" class="bonus-rules-primary-action"><span class="bonus-submit-label">Lưu quy tắc</span><span class="spinner-border spinner-border-sm" aria-hidden="true" hidden></span></button></footer></form></section></div><aside class="col-xl-4"><section class="bonus-rules-preview" aria-live="polite"><span class="bonus-rules-preview-icon"><i class="bi bi-award" aria-hidden="true"></i></span><p>Xếp loại đang chọn</p><h2 id="previewRank">--</h2><dl><div><dt>Tỷ lệ thưởng</dt><dd id="previewPct">--</dd></div><div><dt>Tiền cố định</dt><dd id="previewFixed">--</dd></div></dl></section><section class="bonus-rules-help"><h2><i class="bi bi-info-circle" aria-hidden="true"></i>Lưu ý</h2><ul><li>Mỗi xếp loại chỉ có một quy tắc thưởng.</li><li>Có thể kết hợp tỷ lệ và tiền cố định.</li><li>Không thay đổi hồi tố khoản thưởng đã duyệt.</li></ul></section></aside></div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } <script src="~/js/bonus-rules.js" asp-append-version="true"></script> }
