@model List<Manage_KPI_or_OKR_System.Models.SaaSPackage>
@{
    ViewData["Title"] = "VietMach - Nền tảng Quản trị Hiệu suất Toàn diện";
    ViewData["IsLandingPage"] = true;
    ViewData["Description"] = "Phần mềm SaaS chuyên nghiệp quản trị OKR, đo lường KPI, đánh giá nhân sự 360 độ và tính thưởng tự động với AI Gemini 2.5.";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600&display=swap" rel="stylesheet">

<style>
    /* ===== DESIGN TOKENS ===== */
    :root {
        --primary: #2563eb;
        --primary-light: #60a5fa;
        --primary-dark: #1d4ed8;
        --secondary: #334155;
        --secondary-light: #475569;
        --accent: #0284c7;

        --surface-0: #ffffff;
        --surface-1: #f8fafc;
        --surface-2: #f1f5f9;
        --surface-3: #e2e8f0;

        --text-primary: #0f172a;
        --text-secondary: #334155;
        --text-tertiary: #64748b;
        --text-quaternary: #94a3b8;

        --border: #e2e8f0;
        --border-hover: #cbd5e1;
        --glass: rgba(255, 255, 255, 0.85);
        --glass-heavy: rgba(255, 255, 255, 0.95);

        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 14px;
        --radius-xl: 20px;
        --radius-2xl: 28px;

        --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
        --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
        --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
    }

    /* ===== RESET ===== */
    *, *::before, *::after {
        margin: 0; padding: 0; box-sizing: border-box;
        user-select: none !important; -webkit-user-select: none !important;
        -webkit-user-drag: none !important; cursor: default;
    }
    input, textarea { user-select: text !important; -webkit-user-select: text !important; cursor: text !important; }
    a, button, .tab-btn, .nav-link, i, .clickable { cursor: pointer !important; }

    body {
        font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
        color: var(--text-secondary); background: var(--surface-0);
        overflow-x: hidden; -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    h1, h2, h3, h4, h5 { font-family: 'Be Vietnam Pro', sans-serif; color: var(--text-primary); }

    /* ===== UTILITY ===== */
    .gradient-text {
        color: var(--primary);
    }
    .section-label {
        display: inline-flex; align-items: center; gap: 8px;
        font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px;
        color: var(--primary); margin-bottom: 1rem;
    }
    .section-title {
        font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; line-height: 1.15;
        letter-spacing: -1px; margin-bottom: 1rem;
    }
    .section-desc {
        font-size: 1.1rem; color: var(--text-tertiary); line-height: 1.7;
        max-width: 640px; margin: 0 auto 3rem;
    }

    /* ===== ANIMATED BG ===== */
    .landing-bg {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        z-index: -1; pointer-events: none; overflow: hidden;
        background-color: #f8fafc;
    }
    .grid-pattern {
        position: absolute; inset: 0;
        background-size: 40px 40px;
        background-image:
            linear-gradient(to right, rgba(0,0,0,0.02) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(0,0,0,0.02) 1px, transparent 1px);
    }

    /* ===== NAVBAR ===== */
    .lp-nav {
        position: fixed; top: 0; width: 100%; z-index: 1000;
        padding: 1rem 5%;
        backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
        background: var(--glass-heavy); border-bottom: 1px solid var(--border);
        transition: box-shadow 0.3s, padding 0.3s;
    }
    .lp-nav.scrolled { padding: 0.7rem 5%; box-shadow: var(--shadow-md); }
    .lp-nav-inner {
        max-width: 1320px; margin: 0 auto;
        display: flex; justify-content: space-between; align-items: center;
    }
    .lp-brand {
        display: flex; align-items: center; gap: 10px; text-decoration: none;
        font-family: 'Be Vietnam Pro', sans-serif; font-weight: 900; font-size: 1.5rem;
        color: var(--text-primary); letter-spacing: -0.5px;
    }
    .lp-brand i { font-size: 1.6rem; color: var(--primary); }
    .lp-nav-left { display: flex; align-items: center; gap: 3rem; }
    .lp-nav-links { display: flex; align-items: center; gap: 2rem; }
    .lp-nav-link {
        text-decoration: none; color: var(--text-tertiary); font-size: 0.95rem;
        font-weight: 500; transition: color 0.2s; position: relative;
    }
    .lp-nav-link:hover { color: var(--primary); }
    .lp-nav-link::after {
        content: ''; position: absolute; bottom: -4px; left: 0;
        width: 0; height: 2px; background: var(--primary);
        transition: width 0.3s;
    }
    .lp-nav-link:hover::after { width: 100%; }
    
    /* Header Dropdown */
    .lp-dropdown { position: relative; display: inline-block; padding: 0.5rem 0; }
    .lp-dropdown-menu {
        position: absolute; top: 100%; left: 0; min-width: 260px;
        background: white; border-radius: var(--radius-md); padding: 0.5rem;
        box-shadow: var(--shadow-lg); border: 1px solid var(--border);
        opacity: 0; visibility: hidden; transform: translateY(10px);
        transition: all 0.3s; z-index: 100;
    }
    .lp-dropdown:hover .lp-dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
    .lp-dropdown-menu a {
        display: flex; align-items: center; gap: 12px; padding: 0.8rem 1rem;
        text-decoration: none; color: var(--text-secondary); font-size: 0.95rem; font-weight: 600;
        border-radius: var(--radius-sm); transition: background 0.2s;
    }
    .lp-dropdown-menu a:hover { background: var(--surface-1); color: var(--primary); }
    .lp-dropdown-menu i { color: var(--primary); font-size: 1.2rem; background: rgba(79,70,229,0.1); padding: 6px; border-radius: 8px; }

    .lp-nav-actions { display: flex; align-items: center; gap: 1.5rem; }
    .lp-cart-btn {
        position: relative; color: var(--text-secondary); font-size: 1.4rem; transition: color 0.3s; text-decoration: none;
    }
    .lp-cart-btn:hover { color: var(--primary); }
    .cart-badge {
        position: absolute; top: -6px; right: -8px; background: #ef4444; color: white;
        font-size: 0.65rem; font-weight: 800; width: 18px; height: 18px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .lp-nav-divider { width: 1px; height: 24px; background: var(--border); }
    .lp-nav-link-btn { text-decoration: none; font-weight: 600; font-size: 0.95rem; color: var(--text-secondary); transition: color 0.3s; }
    .lp-nav-link-btn:hover { color: var(--primary); }
    
    .lp-cta-btn {
        display: inline-flex; align-items: center; gap: 8px;
        background: var(--primary); color: white !important;
        padding: 0.7rem 1.6rem; border-radius: var(--radius-sm);
        font-weight: 600; font-size: 0.95rem; text-decoration: none;
        transition: all 0.3s; border: none;
        box-shadow: var(--shadow-sm);
    }
    .lp-cta-btn:hover {
        background: var(--primary-dark); transform: translateY(-1px);
        box-shadow: var(--shadow-md); color: white !important;
    }

    /* ===== HERO ===== */
    .lp-hero {
        padding: 10rem 5% 6rem; position: relative; overflow: hidden;
    }
    .lp-hero-inner {
        max-width: 1320px; margin: 0 auto;
        display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;
    }
    .lp-hero-content { position: relative; z-index: 2; }
    .lp-hero-badge {
        display: inline-flex; align-items: center; gap: 8px;
        background: var(--surface-2);
        color: var(--text-secondary); padding: 0.5rem 1.2rem; border-radius: 50px;
        font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem;
        border: 1px solid var(--border);
    }
    .lp-hero-badge i { font-size: 1rem; color: var(--primary); }
    .lp-hero h1 {
        font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800;
        line-height: 1.1; letter-spacing: -1.5px; margin-bottom: 1.5rem;
    }
    .lp-hero p {
        font-size: 1.15rem; color: var(--text-secondary);
        line-height: 1.75; margin-bottom: 2.5rem; max-width: 520px;
    }
    .lp-hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
    .btn-primary-lg {
        display: inline-flex; align-items: center; gap: 10px;
        background: var(--primary);
        color: white !important; padding: 1rem 2rem; border-radius: var(--radius-sm);
        font-weight: 600; font-size: 1.05rem; text-decoration: none;
        transition: all 0.3s; border: none;
        box-shadow: var(--shadow-md);
    }
    .btn-primary-lg:hover {
        transform: translateY(-2px); background: var(--primary-dark);
        box-shadow: var(--shadow-lg); color: white !important;
    }
    .btn-outline-lg {
        display: inline-flex; align-items: center; gap: 10px;
        background: white; color: var(--text-primary) !important;
        padding: 1rem 2rem; border-radius: var(--radius-sm);
        font-weight: 600; font-size: 1.05rem; text-decoration: none;
        transition: all 0.3s; border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
    }
    .btn-outline-lg:hover {
        border-color: var(--border-hover); background: var(--surface-1);
    }

    .lp-hero-visual { position: relative; z-index: 1; }
    .lp-hero-img-wrap {
        position: relative; border-radius: var(--radius-lg);
        overflow: hidden; box-shadow: var(--shadow-xl);
        border: 1px solid var(--border);
        transform: translateY(0);
        transition: transform 0.5s ease;
    }
    .lp-hero-img-wrap:hover {
        transform: translateY(-8px);
    }
    .lp-hero-img-wrap img { width: 100%; height: auto; display: block; }

    /* ===== TRUSTED / STATS ===== */
    .lp-stats {
        padding: 4rem 5%; background: var(--surface-1);
        border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    }
    .lp-stats-inner {
        max-width: 1100px; margin: 0 auto;
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem;
        text-align: center;
    }
    .stat-item { padding: 1.5rem; }
    .stat-number {
        font-family: 'Be Vietnam Pro', sans-serif; font-size: 2.8rem; font-weight: 900;
        color: var(--primary); line-height: 1; margin-bottom: 0.5rem;
    }
    .stat-number .stat-suffix { font-size: 1.5rem; color: var(--secondary); }
    .stat-label { font-size: 0.95rem; color: var(--text-tertiary); font-weight: 500; }

    /* ===== SHOWCASE TABS ===== */
    .lp-showcase { padding: 6rem 5%; }
    .lp-showcase-header { text-align: center; margin-bottom: 3rem; }
    .lp-showcase-inner {
        max-width: 1320px; margin: 0 auto;
    }
    .lp-tabs-nav {
        display: flex; gap: 0.5rem; margin-bottom: 2rem;
        overflow-x: auto; padding-bottom: 0.5rem;
        scrollbar-width: none; -ms-overflow-style: none;
    }
    .lp-tabs-nav::-webkit-scrollbar { display: none; }
    .lp-tab-btn {
        flex-shrink: 0; display: flex; align-items: center; gap: 8px;
        padding: 0.8rem 1.4rem; border-radius: var(--radius-md);
        background: white; border: 1px solid var(--border);
        font-weight: 600; font-size: 0.9rem; color: var(--text-secondary);
        transition: all 0.2s; white-space: nowrap;
        box-shadow: var(--shadow-sm);
    }
    .lp-tab-btn:hover { color: var(--primary); border-color: var(--border-hover); }
    .lp-tab-btn.active {
        background: var(--surface-1); color: var(--primary);
        border-color: var(--primary); box-shadow: none;
    }
    .lp-tab-btn i { font-size: 1.1rem; }

    /* ===== STICKY SHOWCASE ===== */
    .sticky-showcase { padding: 8rem 5%; background: var(--surface-0); position: relative; }
    .sticky-showcase-header { text-align: center; margin-bottom: 4rem; }
    .sticky-layout {
        max-width: 1320px; margin: 0 auto;
        display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem;
        position: relative; align-items: flex-start;
    }
    .sticky-text-side { display: flex; flex-direction: column; gap: 60vh; padding-bottom: 40vh; margin-top: 10vh; }
    .sticky-block {
        background: white; border: 1px solid var(--border); border-radius: var(--radius-xl);
        padding: 2.5rem; box-shadow: var(--shadow-md);
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); opacity: 0.4; transform: scale(0.95) translateY(10px);
    }
    .sticky-block.is-active { 
        opacity: 1; transform: scale(1) translateY(0); 
        border-color: var(--primary); box-shadow: 0 12px 40px rgba(79, 70, 229, 0.15); 
    }
    .sticky-block h3 { font-size: 1.8rem; font-weight: 800; margin-bottom: 1rem; color: var(--text-primary); letter-spacing: -0.5px; }
    .sticky-block p { font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem; }
    .sticky-block ul { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; }
    .sticky-block li { display: flex; align-items: center; gap: 12px; font-weight: 500; font-size: 0.95rem; color: var(--text-secondary); }
    .sticky-block li i { color: var(--primary); font-size: 1.1rem; }

    .sticky-visual-side {
        position: sticky; top: 120px; padding: 2rem;
        background: var(--surface-1); border-radius: var(--radius-xl);
        display: flex; align-items: center; justify-content: center; overflow: hidden;
        border: 1px solid var(--border); box-shadow: inset 0 0 40px rgba(0,0,0,0.02);
    }
    .browser-mockup {
        width: 100%; aspect-ratio: 16/10; height: auto; background: white; border-radius: 12px;
        box-shadow: 0 24px 60px rgba(0,0,0,0.1); overflow: hidden;
        display: flex; flex-direction: column; border: 1px solid rgba(0,0,0,0.05);
    }
    .browser-header {
        height: 32px; background: #e2e8f0; display: flex; align-items: center; padding: 0 14px; gap: 8px; border-bottom: 1px solid #cbd5e1;
    }
    .browser-dot { width: 12px; height: 12px; border-radius: 50%; }
    .dot-red { background: #ff5f56; } .dot-yellow { background: #ffbd2e; } .dot-green { background: #27c93f; }
    .browser-content { flex: 1; position: relative; background: #fff; overflow: hidden; }
    .sticky-img {
        position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: left top;
        opacity: 0; transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); transform: translateY(20px) scale(1.02);
    }
    .sticky-img.is-active { opacity: 1; transform: translateY(0) scale(1); }

    /* ===== BENTO GRID ===== */
    .bento-features { padding: 8rem 5%; background: var(--surface-0); border-top: 1px solid var(--border); }
    .bento-header { text-align: center; margin-bottom: 4rem; }
    .bento-grid {
        max-width: 1200px; margin: 0 auto;
        display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(180px, auto); gap: 1.5rem;
    }
    .bento-card {
        background: white; border-radius: var(--radius-xl); padding: 2rem;
        border: 1px solid var(--border); box-shadow: var(--shadow-sm);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative; overflow: hidden; display: flex; flex-direction: column;
    }
    .bento-card:hover { transform: translateY(-4px) scale(1.01); box-shadow: var(--shadow-xl); border-color: var(--primary-light); }
    
    .bento-content { position: relative; z-index: 2; display: flex; flex-direction: column; }
    .bento-icon { width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: 1rem; }
    .bento-icon.blue { background: rgba(79,70,229,0.08); color: var(--primary); }
    .bento-icon.purple { background: rgba(124,58,237,0.08); color: var(--secondary); }
    .bento-icon.cyan { background: rgba(6,182,212,0.08); color: var(--accent); }
    .bento-icon.emerald { background: rgba(16,185,129,0.08); color: #10b981; }
    .bento-icon.amber { background: rgba(245,158,11,0.08); color: #f59e0b; }
    .bento-icon.rose { background: rgba(244,63,94,0.08); color: #f43f5e; }
    .bento-title { font-size: 1.25rem; font-weight: 800; margin-bottom: 0.5rem; letter-spacing: -0.5px; color: var(--text-primary); line-height: 1.3; }
    .bento-desc { font-size: 0.95rem; color: var(--text-tertiary); line-height: 1.5; }
    
    .bento-visual { 
        margin-top: 1.5rem; border-radius: var(--radius-lg); overflow: hidden; 
        background: var(--surface-1); display: flex; align-items: center; justify-content: center; 
        position: relative; z-index: 1; border: 1px solid var(--border); flex: 1; min-height: 120px;
    }
    
    /* Grid specific sizing */
    .bento-large { grid-column: span 2; grid-row: span 2; }
    .bento-wide { grid-column: span 2; grid-row: span 1; }
    .bento-tall { grid-column: span 1; grid-row: span 2; }
    .bento-normal { grid-column: span 1; grid-row: span 1; }

    /* Bento Visuals Custom CSS */
    .bv-ai { background: linear-gradient(135deg, rgba(124,58,237,0.05), rgba(79,70,229,0.05)); align-items: flex-end; padding: 1rem; border-color: rgba(124,58,237,0.15); }
    .bv-ai-chat { width: 100%; display: flex; flex-direction: column; gap: 8px; }
    .bv-msg { padding: 8px 12px; border-radius: 12px; font-size: 0.8rem; max-width: 85%; font-weight: 500; }
    .bv-msg.user { background: white; color: var(--text-primary); border: 1px solid var(--border); align-self: flex-end; border-bottom-right-radius: 4px; box-shadow: var(--shadow-sm); }
    .bv-msg.bot { background: var(--primary); color: white; align-self: flex-start; border-bottom-left-radius: 4px; box-shadow: var(--shadow-sm); }
    .bv-typing { display: flex; gap: 4px; padding: 4px 2px; }
    .bv-typing span { width: 4px; height: 4px; background: rgba(255,255,255,0.7); border-radius: 50%; animation: typing 1.4s infinite ease-in-out both; }
    .bv-typing span:nth-child(1) { animation-delay: -0.32s; }
    .bv-typing span:nth-child(2) { animation-delay: -0.16s; }
    @@keyframes typing { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }
    
    .bv-tree { background: var(--surface-1); flex-direction: column; padding: 1.5rem; gap: 1rem; border-color: rgba(79,70,229,0.15); }
    .bv-node { background: white; border: 1px solid var(--primary-light); color: var(--primary-dark); font-size: 0.8rem; font-weight: 700; padding: 6px 16px; border-radius: 20px; box-shadow: var(--shadow-sm); z-index: 2; }
    .bv-branches { display: flex; gap: 2rem; position: relative; }
    .bv-branches::before { content: ''; position: absolute; top: -1rem; left: 50%; width: 2px; height: 1rem; background: var(--primary-light); transform: translateX(-50%); }
    .bv-branches::after { content: ''; position: absolute; top: -1rem; left: 25%; right: 25%; height: 2px; background: var(--primary-light); }
    .bv-leaf { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
    .bv-leaf::before { content: ''; position: absolute; top: -1rem; left: 50%; width: 2px; height: 1rem; background: var(--primary-light); transform: translateX(-50%); }
    .bv-node.sub { background: white; border-color: var(--border); color: var(--text-secondary); }

    .bv-bonus { background: #fffaf0; flex-direction: column; padding: 1.5rem; justify-content: center; gap: 1rem; border-color: #fde68a; }
    .bv-bar-wrap { width: 100%; height: 8px; background: #fef3c7; border-radius: 4px; overflow: hidden; }
    .bv-bar-fill { width: 75%; height: 100%; background: linear-gradient(90deg, #f59e0b, #fbbf24); border-radius: 4px; position: relative; overflow: hidden; }
    .bv-bar-fill::after { content:''; position: absolute; top:0; left:0; bottom:0; width: 200%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); animation: shimmer 2s infinite; }
    @@keyframes shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(50%); } }
    .bv-tags { display: flex; justify-content: space-between; width: 100%; font-size: 0.75rem; font-weight: 700; color: #b45309; }

    .bv-chart { background: #f0fdf4; align-items: flex-end; padding: 1.5rem 1.5rem 0 1.5rem; gap: 12px; border-color: #bbf7d0; }
    .bv-col { flex: 1; background: #10b981; border-top-left-radius: 4px; border-top-right-radius: 4px; opacity: 0.8; transition: height 0.5s; position: relative; overflow: hidden; }
    .bv-col::after { content:''; position: absolute; top:0; left:0; right:0; height: 100%; background: linear-gradient(180deg, rgba(255,255,255,0.2) 0%, transparent 100%); }
    .bv-col:hover { opacity: 1; }

    .bv-log { background: #f8fafc; flex-direction: column; align-items: flex-start; padding: 1.5rem; gap: 12px; border-color: #e2e8f0; }
    .bv-line { height: 8px; border-radius: 4px; background: #cbd5e1; width: 100%; }
    .bv-line.w-70 { width: 70%; background: #94a3b8; }
    .bv-line.w-40 { width: 40%; background: #cbd5e1; }
    
    .bv-lock { background: #f0fdfa; border-color: #ccfbf1; font-size: 3rem; color: #14b8a6; }

    /* Media queries for bento */
    @@media (max-width: 1024px) { .bento-grid { grid-template-columns: repeat(2, 1fr); } .sticky-layout { grid-template-columns: 1fr; } .sticky-visual-side { display: none; } .sticky-text-side { gap: 2rem; padding-bottom: 0; } .sticky-block { opacity: 1; transform: none; } }
