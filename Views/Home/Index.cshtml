<!-- ===== PRICING ===== -->
<section class="lp-pricing" id="pricing">
    <div class="lp-pricing-header reveal">
        <div class="section-label"><i class="bi bi-tags-fill"></i> Bảng giá dịch vụ</div>
        <h2 class="section-title">Giải pháp đầu tư <span class="gradient-text">hiệu quả</span></h2>
        <p class="section-desc">Lựa chọn gói sản phẩm phù hợp với quy mô và nhu cầu quản trị hiệu suất của doanh nghiệp bạn.</p>
    </div>
    <div class="lp-pricing-inner">
        @if (Model != null && Model.Any())
        {
            var delay = 0;
            foreach (var pkg in Model)
            {
                string priceDisplay = "Thỏa thuận";
                if (pkg.PricePerMonth > 0)
                {
                    priceDisplay = pkg.PricePerMonth >= 1000000 ? (pkg.PricePerMonth / 1000000m).ToString("0.#") + "M" : (pkg.PricePerMonth / 1000m).ToString("0.#") + "k";
                }
                
                <div class="pricing-card @(pkg.IsPopular ? "popular" : "") reveal reveal-delay-@delay">
                    @if (pkg.IsPopular)
                    {
                        <div class="pricing-badge">Phổ biến nhất</div>
                    }
                    <h3>@pkg.PackageName</h3>
                    <p>@pkg.Description</p>
                    <div class="pricing-price">@priceDisplay<span>@(pkg.PricePerMonth > 0 ? " /tháng" : "")</span></div>
                    
                    <ul class="pricing-features">
                        <li><i class="bi bi-check-circle-fill"></i> @(pkg.MaxUsers >= 9999 ? "Không giới hạn nhân sự" : $"Tối đa {pkg.MaxUsers} nhân sự")</li>
                        <li><i class="bi bi-check-circle-fill"></i> @(pkg.HasAdvancedOKR ? "Tính năng Đánh giá & Tính thưởng tự động" : "Quản lý OKR & KPI cơ bản")</li>
                        
                        @if (pkg.HasAIInsight)
                        {
                            <li><i class="bi bi-check-circle-fill"></i> Tích hợp <strong>Trợ lý AI Gemini 2.5</strong></li>
                        }
                        else
                        {
                            <li><i class="bi bi-dash-circle text-muted"></i> Trợ lý AI Gemini (Không hỗ trợ)</li>
                        }
                        
                        <li><i class="bi bi-check-circle-fill"></i> @(pkg.PricePerMonth == 0 ? "Triển khai On-Premise (Server riêng)" : "Báo cáo Dashboard chuẩn")</li>
                        <li><i class="bi bi-check-circle-fill"></i> @(pkg.PricePerMonth == 0 ? "Có quản lý tài khoản hỗ trợ riêng 24/7" : (pkg.IsPopular ? "Hỗ trợ ưu tiên qua Hotline & Zalo" : "Hỗ trợ qua Email"))</li>
                    </ul>
                    
                    @if (pkg.PricePerMonth == 0)
                    {
                        <a href="mailto:sales@vietmach.com" class="pricing-btn outline">Liên hệ chuyên viên</a>
                    }
                    else
                    {
                        <a href="javascript:void(0)" onclick="purchasePlan('@pkg.PackageName')" class="pricing-btn @(pkg.IsPopular ? "solid" : "outline")">Mua ngay</a>
                    }
                </div>
                delay++;
            }
        }
    </div>
</section>

