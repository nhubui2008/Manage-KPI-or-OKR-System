        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(8px);
        z-index: 2000; display: flex; align-items: center; justify-content: center;
        opacity: 0; visibility: hidden; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        padding: 1rem;
    }
    .reg-modal-overlay.active { opacity: 1; visibility: visible; }
    
    .reg-modal-premium {
        display: flex; width: 100%; max-width: 900px; min-height: 500px;
        background: #ffffff; border-radius: 20px; overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        transform: scale(0.95) translateY(20px); opacity: 0;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
