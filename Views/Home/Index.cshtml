    .wf-step {
        text-align: center; position: relative; z-index: 1;
        padding: 0 0.5rem;
    }
    .wf-step-num {
        width: 72px; height: 72px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Be Vietnam Pro', sans-serif; font-size: 1.5rem; font-weight: 900;
        margin: 0 auto 1.2rem; transition: all 0.4s;
        border: 2px solid var(--border); background: white; color: var(--text-tertiary);
    }
    .wf-step:hover .wf-step-num {
        background: var(--primary);
        color: white; border-color: var(--primary);
        box-shadow: var(--shadow-md); transform: scale(1.05);
    }
    .wf-step h4 { font-size: 1rem; font-weight: 800; margin-bottom: 0.4rem; }
    .wf-step p { font-size: 0.85rem; color: var(--text-tertiary); line-height: 1.5; }

    /* ===== PRICING ===== */
    .lp-pricing { padding: 6rem 5%; background: var(--surface-0); border-top: 1px solid var(--border); }
