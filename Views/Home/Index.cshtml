            <div class="reg-form-container">
                <h3>Khôi phục mật khẩu</h3>
                <p class="reg-form-subtitle">Làm theo các bước để lấy lại quyền truy cập.</p>
                
                <div id="fpAlertError" class="alert-error" style="display:none; background: #fef2f2; border-left: 4px solid #ef4444; color: #991b1b; padding: 0.75rem 1rem; border-radius: 0 8px 8px 0; margin-bottom: 1.5rem; align-items: center; gap: 0.5rem; font-size: 0.95rem; font-weight: 500;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span id="fpErrorMsg"></span>
                </div>

                <div id="fpAlertSuccess" class="alert-success" style="display:none; background: #f0fdf4; border-left: 4px solid #22c55e; color: #166534; padding: 0.75rem 1rem; border-radius: 0 8px 8px 0; margin-bottom: 1.5rem; align-items: center; gap: 0.5rem; font-size: 0.95rem; font-weight: 500;">
                    <i class="bi bi-check-circle-fill"></i>
                    <span id="fpSuccessMsg"></span>
                </div>

                <!-- STEP 1: REQUEST OTP -->
                <form id="fpStep1Form" onsubmit="submitFpStep1(event)">
                    <div class="form-group">
                        <label for="fpEmail">Email đăng ký</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-envelope"></i>
                            <input type="email" id="fpEmail" required placeholder="Nhập email của bạn" />
                        </div>
                    </div>
                    <button type="submit" id="btnFpStep1" class="btn-primary-lg w-100 mt-4" style="justify-content: center; border: none; cursor: pointer;">
                        <i class="bi bi-send-fill"></i> Nhận mã xác nhận
                    </button>
                </form>

                <!-- STEP 2: VERIFY OTP -->
                <form id="fpStep2Form" style="display:none;" onsubmit="submitFpStep2(event)">
                    <div class="form-group">
                        <label for="fpOtp">Mã xác nhận (OTP)</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-123"></i>
                            <input type="text" id="fpOtp" required placeholder="Nhập mã 6 số từ email" />
                        </div>
                    </div>
                    <button type="submit" id="btnFpStep2" class="btn-primary-lg w-100 mt-4" style="justify-content: center; border: none; cursor: pointer;">
                        <i class="bi bi-check-circle-fill"></i> Xác nhận mã
                    </button>
                </form>

                <!-- STEP 3: NEW PASSWORD -->
                <form id="fpStep3Form" style="display:none;" onsubmit="submitFpStep3(event)">
                    <div class="form-group">
                        <label for="fpNewPassword">Mật khẩu mới</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-key"></i>
                            <input type="password" id="fpNewPassword" required placeholder="Nhập mật khẩu mới" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="fpConfirmPassword">Xác nhận mật khẩu</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-shield-lock"></i>
                            <input type="password" id="fpConfirmPassword" required placeholder="Nhập lại mật khẩu" />
                        </div>
                    </div>
                    <button type="submit" id="btnFpStep3" class="btn-primary-lg w-100 mt-4" style="justify-content: center; border: none; cursor: pointer;">
                        <i class="bi bi-check-circle-fill"></i> Tạo mật khẩu mới
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a href="javascript:void(0)" onclick="closeForgotPasswordModal();" style="color: #64748b; text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#4f46e5'" onmouseout="this.style.color='#64748b'">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
