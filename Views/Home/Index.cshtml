    .reg-modal-brand { font-size: 1.2rem; font-weight: 700; letter-spacing: 1px; margin-bottom: 2rem; color: #f8fafc; display: flex; align-items: center; gap: 0.5rem; }
    .reg-modal-left h2 { font-size: 2.2rem; font-weight: 800; margin-bottom: 1rem; color: white; line-height: 1.2; }
    .reg-modal-left p { font-size: 1.05rem; color: #cbd5e1; margin-bottom: 2rem; line-height: 1.6; }
    
    .reg-modal-benefits { list-style: none; padding: 0; margin: 0; }
    .reg-modal-benefits li { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem; font-size: 1rem; color: #f8fafc; }
    .reg-modal-benefits li i { color: var(--primary); font-size: 1.2rem; background: rgba(255,255,255,0.1); border-radius: 50%; padding: 2px; }
    
    .reg-modal-bg-blob {
        position: absolute; width: 300px; height: 300px; background: rgba(255,255,255,0.03);
        border-radius: 50%; bottom: -100px; left: -100px; pointer-events: none;
