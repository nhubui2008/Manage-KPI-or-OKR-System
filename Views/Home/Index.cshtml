@model List<Manage_KPI_or_OKR_System.Models.SaaSPackage>
@{
    ViewData["Title"] = "Manage KPI & OKR | VietMach System";
    ViewData["Description"] = "VietMach System giúp doanh nghiệp thiết lập, theo dõi, đánh giá và phê duyệt KPI, OKR trên một nền tảng thống nhất.";
    ViewData["IsLandingPage"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<a class="landing-skip-link" href="#landing-main">Bỏ qua điều hướng</a>

<header class="landing-header" data-landing-header>
    <div class="landing-container landing-nav">
        <a class="landing-brand" asp-controller="Home" asp-action="Index" aria-label="VietMach System - Trang chủ">
            <span class="landing-brand-mark" aria-hidden="true">VM</span>
            <span><strong>VietMach System</strong><small>Manage KPI &amp; OKR</small></span>
        </a>

        <button class="landing-menu-button" type="button" aria-expanded="false"
                aria-controls="landing-navigation" data-menu-button>
            <span class="visually-hidden">Mở menu</span>
            <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>

        <nav id="landing-navigation" class="landing-navigation" aria-label="Điều hướng chính" data-menu>
            <a href="#san-pham">Sản phẩm</a>
            <a href="#tinh-nang">Tính năng</a>
            <a href="#quy-trinh">Quy trình</a>
            <a href="#bang-gia">Bảng giá</a>
            <div class="landing-nav-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="landing-button landing-button-secondary" asp-controller="Dashboard" asp-action="Index">Vào hệ thống</a>
                }
                else
                {
                    <a class="landing-button landing-button-secondary" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                    <a class="landing-button landing-button-primary" asp-controller="Auth" asp-action="Register">Bắt đầu sử dụng</a>
                }
            </div>
        </nav>
    </div>
</header>

<main id="landing-main">
    <section class="landing-hero" aria-labelledby="hero-title">
        <div class="landing-container landing-hero-grid">
            <div class="landing-hero-copy" data-reveal>
                <p class="landing-eyebrow">Nền tảng quản trị hiệu suất doanh nghiệp</p>
                <h1 id="hero-title">Biến mục tiêu thành kết quả có thể đo lường</h1>
                <p class="landing-hero-lead">
                    VietMach System kết nối KPI, OKR, check-in và đánh giá trong một quy trình rõ ràng,
                    giúp mỗi người hiểu ưu tiên và mỗi cấp quản lý nhìn thấy tiến độ.
                </p>
                <div class="landing-hero-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="landing-button landing-button-primary landing-button-large" asp-controller="Dashboard" asp-action="Index">
                            Mở bảng điều khiển <span aria-hidden="true">→</span>
                        </a>
                    }
                    else
                    {
                        <a class="landing-button landing-button-primary landing-button-large" asp-controller="Auth" asp-action="Register">
                            Bắt đầu sử dụng <span aria-hidden="true">→</span>
                        </a>
                        <a class="landing-button landing-button-secondary landing-button-large" asp-controller="Auth" asp-action="Login">
                            Đăng nhập
                        </a>
                    }
                </div>
                <ul class="landing-assurance" aria-label="Lợi ích nổi bật">
                    <li><span aria-hidden="true">✓</span> Một nguồn dữ liệu thống nhất</li>
                    <li><span aria-hidden="true">✓</span> Phân quyền theo vai trò</li>
                    <li><span aria-hidden="true">✓</span> Theo dõi xuyên suốt chu kỳ</li>
                </ul>
            </div>

            <div class="landing-product-frame" data-reveal aria-label="Bản xem trước sản phẩm với dữ liệu minh họa">
                <div class="landing-product-bar">
                    <div><span></span><span></span><span></span></div>
                    <strong>Tổng quan hiệu suất</strong>
                    <span class="landing-demo-badge">Dữ liệu minh họa</span>
                </div>
                <div class="landing-product-body">
                    <aside class="landing-preview-sidebar" aria-hidden="true">
                        <span class="is-active"></span><span></span><span></span><span></span><span></span>
                    </aside>
                    <div class="landing-preview-content">
                        <div class="landing-preview-heading">
                            <div><small>Chu kỳ hiện tại</small><strong>Tiến độ tổ chức</strong></div>
                            <span>Cập nhật tuần này</span>
                        </div>
                        <div class="landing-metric-grid">
                            <article><small>KPI hoàn thành</small><strong>78%</strong><span>39 / 50 chỉ tiêu</span></article>
                            <article><small>OKR đúng tiến độ</small><strong>84%</strong><span>21 / 25 mục tiêu</span></article>
                            <article><small>Check-in tuần</small><strong>92%</strong><span>46 / 50 nhân sự</span></article>
                        </div>
                        <div class="landing-chart-grid">
                            <article class="landing-chart-card">
                                <div><strong>Xu hướng tiến độ</strong><small>6 tuần gần nhất</small></div>
                                <div class="landing-chart-wrap">
                                    <canvas id="landingProgressChart" role="img"
                                            aria-label="Biểu đồ minh họa xu hướng tiến độ tăng từ 51 đến 78 phần trăm trong sáu tuần"></canvas>
                                </div>
                            </article>
                            <article class="landing-status-card">
                                <div><strong>Trạng thái mục tiêu</strong><small>Tổng hợp minh họa</small></div>
                                <ul>
                                    <li><span><i class="status-dot is-blue"></i>Đúng tiến độ</span><strong>68%</strong></li>
                                    <li><span><i class="status-dot is-cyan"></i>Cần chú ý</span><strong>22%</strong></li>
                                    <li><span><i class="status-dot is-amber"></i>Chậm tiến độ</span><strong>10%</strong></li>
                                </ul>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="landing-proof" aria-label="Phạm vi quản trị">
        <div class="landing-container landing-proof-grid">
            <div><strong>Một nền tảng</strong><span>cho dữ liệu hiệu suất</span></div>
            <div><strong>Năm bước</strong><span>trong một chu kỳ liền mạch</span></div>
            <div><strong>Bốn vai trò</strong><span>cùng nhìn về một mục tiêu</span></div>
        </div>
    </section>

    <section id="san-pham" class="landing-section landing-product-section">
        <div class="landing-container landing-showcase-grid">
            <div class="landing-showcase-copy" data-reveal>
                <p class="landing-eyebrow">Từ chiến lược đến thực thi</p>
                <h2>Một không gian làm việc, toàn bộ bức tranh <span class="landing-keep-together">hiệu suất</span></h2>
                <p>
                    Mục tiêu, chỉ tiêu và kết quả đánh giá được kết nối theo đúng vai trò.
                    Người dùng theo dõi công việc cần làm; quản lý nắm rủi ro và đưa ra phản hồi kịp thời.
                </p>
                <ul class="landing-check-list">
                    <li><span aria-hidden="true">01</span><div><strong>Quan sát nhanh</strong><small>Tổng hợp tiến độ và trạng thái theo chu kỳ.</small></div></li>
                    <li><span aria-hidden="true">02</span><div><strong>Đi sâu đúng lúc</strong><small>Truy cập chi tiết KPI, OKR và lịch sử check-in.</small></div></li>
                    <li><span aria-hidden="true">03</span><div><strong>Ra quyết định có căn cứ</strong><small>Dùng dữ liệu đã được đánh giá và phê duyệt.</small></div></li>
                </ul>
            </div>
            <figure class="landing-dashboard-shot" data-reveal aria-labelledby="workspace-preview-title">
                <div class="landing-dashboard-carousel" data-dashboard-carousel tabindex="0"
                     aria-roledescription="băng chuyền" aria-label="Các màn hình thực tế của hệ thống">
                    <div class="landing-dashboard-viewport">
                <div class="landing-dashboard-slide is-active" data-dashboard-slide data-slide-title="Tổng quan hiệu suất" aria-hidden="false">
                <div class="landing-workspace-preview">
                    <div class="landing-workspace-topbar">
                        <span class="landing-workspace-logo" aria-hidden="true">VM</span>
                        <div>
                            <strong id="workspace-preview-title">Tổng quan hệ thống</strong>
                            <small>Dữ liệu minh họa</small>
                        </div>
                        <span class="landing-workspace-period">Chu kỳ Q3</span>
                    </div>
                    <div class="landing-workspace-body">
                        <aside class="landing-workspace-nav" aria-label="Menu bản xem trước">
                            <span class="is-active">Tổng quan</span>
                            <span>Công việc</span>
                            <span>KPI &amp; OKR</span>
                            <span>Check-in</span>
                            <span>Đánh giá</span>
                        </aside>
                        <div class="landing-workspace-main">
                            <div class="landing-workspace-heading">
                                <div><small>Xin chào</small><strong>Hiệu suất hôm nay</strong></div>
                                <span>Đã cập nhật</span>
                            </div>
                            <div class="landing-workspace-metrics">
                                <article><small>Tỷ lệ KPI</small><strong>79,7%</strong><span>Đúng tiến độ</span></article>
                                <article><small>Mục tiêu OKR</small><strong>24</strong><span>Đang thực hiện</span></article>
                                <article><small>Lượt check-in</small><strong>269</strong><span>Trong kỳ này</span></article>
                            </div>
                            <div class="landing-workspace-panels">
                                <article class="landing-workspace-chart-card">
                                    <div class="landing-workspace-card-heading">
                                        <div><strong>Xu hướng KPI</strong><small>Chạm hoặc rê vào biểu đồ để xem chi tiết</small></div>
                                        <span>6 tháng</span>
                                    </div>
                                    <div class="landing-workspace-chart-wrap">
                                        <canvas id="landingWorkspaceChart" role="img" tabindex="0"
                                                aria-label="Biểu đồ tương tác minh họa xu hướng KPI từ 61 đến 80 phần trăm trong sáu tháng"></canvas>
                                    </div>
                                </article>
                                <article class="landing-workspace-activity">
                                    <div><strong>Hoạt động gần đây</strong><small>3 cập nhật mới</small></div>
                                    <ul>
                                        <li><span aria-hidden="true">✓</span><div><strong>Đã check-in KPI</strong><small>Phòng Kinh doanh · 09:30</small></div></li>
                                        <li><span aria-hidden="true">✓</span><div><strong>OKR được cập nhật</strong><small>Khối Sản phẩm · 08:45</small></div></li>
                                        <li><span aria-hidden="true">✓</span><div><strong>Đã duyệt kết quả</strong><small>Quản lý trực tiếp · Hôm qua</small></div></li>
                                    </ul>
                                </article>
                            </div>
                        </div>
                    </div>
                </div>
                </div>

                <div class="landing-dashboard-slide" data-dashboard-slide data-slide-title="Danh sách KPI quý III" aria-hidden="true">
                    <div class="landing-workspace-preview">
                        <div class="landing-workspace-topbar">
                            <span class="landing-workspace-logo" aria-hidden="true">VM</span>
                            <div><strong>Quản lý KPI</strong><small>Dữ liệu minh họa</small></div>
                            <span class="landing-workspace-period">Chu kỳ Q3</span>
                        </div>
                        <div class="landing-workspace-body">
                            <aside class="landing-workspace-nav" aria-label="Menu bản xem trước">
                                <span>Tổng quan</span><span>Công việc</span><span class="is-active">KPI &amp; OKR</span><span>Check-in</span><span>Đánh giá</span>
                            </aside>
                            <div class="landing-workspace-main">
                                <div class="landing-workspace-heading">
                                    <div><small>Quản lý chỉ tiêu</small><strong>Danh sách KPI quý III</strong></div>
                                    <span>32 chỉ tiêu</span>
                                </div>
                                <div class="landing-preview-toolbar">
                                    <span class="is-active">Tất cả</span><span>Đúng tiến độ</span><span>Cần chú ý</span><button type="button" tabindex="-1">+ Tạo KPI</button>
                                </div>
                                <div class="landing-kpi-table" role="presentation">
                                    <div class="landing-kpi-row landing-kpi-head"><span>Chỉ tiêu</span><span>Phụ trách</span><span>Tiến độ</span><span>Trạng thái</span></div>
                                    <div class="landing-kpi-row"><strong>Tăng trưởng doanh thu</strong><span>Nguyễn Hoài Anh</span><span><i style="--progress:82%"></i><b>82%</b></span><em>Đúng tiến độ</em></div>
                                    <div class="landing-kpi-row"><strong>Tỷ lệ khách hàng quay lại</strong><span>Trần Minh Khoa</span><span><i style="--progress:68%"></i><b>68%</b></span><em>Đúng tiến độ</em></div>
                                    <div class="landing-kpi-row"><strong>Thời gian xử lý yêu cầu</strong><span>Lê Phương Thảo</span><span><i style="--progress:54%"></i><b>54%</b></span><em class="is-warning">Cần chú ý</em></div>
                                    <div class="landing-kpi-row"><strong>Mức độ hài lòng nội bộ</strong><span>Phạm Tuấn Minh</span><span><i style="--progress:76%"></i><b>76%</b></span><em>Đúng tiến độ</em></div>
                                </div>
                                <div class="landing-table-footer"><span>Hiển thị 4 trong 32 chỉ tiêu</span><span>1 &nbsp; 2 &nbsp; 3 &nbsp; … &nbsp; 8</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="landing-dashboard-slide" data-dashboard-slide data-slide-title="Theo dõi mục tiêu OKR" aria-hidden="true">
                    <div class="landing-workspace-preview">
                        <div class="landing-workspace-topbar">
                            <span class="landing-workspace-logo" aria-hidden="true">VM</span>
                            <div><strong>Mục tiêu &amp; Kết quả then chốt</strong><small>Dữ liệu minh họa</small></div>
                            <span class="landing-workspace-period">Quý III · 2026</span>
                        </div>
                        <div class="landing-workspace-body">
                            <aside class="landing-workspace-nav" aria-label="Menu bản xem trước">
                                <span>Tổng quan</span><span>Công việc</span><span class="is-active">KPI &amp; OKR</span><span>Check-in</span><span>Đánh giá</span>
                            </aside>
                            <div class="landing-workspace-main">
                                <div class="landing-workspace-heading">
                                    <div><small>OKR cấp công ty</small><strong>Tăng tốc tăng trưởng bền vững</strong></div>
                                    <span>Đã check-in hôm nay</span>
                                </div>
                                <div class="landing-okr-layout">
                                    <div class="landing-okr-list">
                                        <article class="is-selected"><div><span>O1</span><strong>Mở rộng thị trường trọng điểm</strong></div><small>Phòng Kinh doanh · 3 kết quả then chốt</small><p><i style="--progress:74%"></i><b>74%</b></p></article>
                                        <article><div><span>O2</span><strong>Nâng cao trải nghiệm khách hàng</strong></div><small>Khối Vận hành · 4 kết quả then chốt</small><p><i style="--progress:61%"></i><b>61%</b></p></article>
                                        <article><div><span>O3</span><strong>Xây dựng đội ngũ hiệu suất cao</strong></div><small>Phòng Nhân sự · 3 kết quả then chốt</small><p><i style="--progress:83%"></i><b>83%</b></p></article>
                                    </div>
                                    <aside class="landing-okr-detail">
                                        <small>CHI TIẾT MỤC TIÊU</small><strong>Mở rộng thị trường trọng điểm</strong>
                                        <div><span>Tiến độ tổng thể</span><b>74%</b></div>
                                        <ul><li><span>KR1 · 120 khách hàng mới</span><b>86%</b></li><li><span>KR2 · Doanh thu tăng 18%</span><b>72%</b></li><li><span>KR3 · Mở 2 khu vực mới</span><b>64%</b></li></ul>
                                    </aside>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                    </div>
                    <div class="landing-carousel-controls">
                        <button type="button" data-carousel-prev aria-label="Xem màn hình trước">←</button>
                        <div role="tablist" aria-label="Chọn màn hình bản xem trước">
                            <button type="button" role="tab" aria-selected="true" aria-label="Tổng quan hiệu suất" data-carousel-dot></button>
                            <button type="button" role="tab" aria-selected="false" aria-label="Danh sách KPI quý III" data-carousel-dot></button>
                            <button type="button" role="tab" aria-selected="false" aria-label="Theo dõi mục tiêu OKR" data-carousel-dot></button>
                        </div>
                        <button type="button" data-carousel-next aria-label="Xem màn hình tiếp theo">→</button>
                    </div>
                </div>
                <figcaption><strong data-carousel-caption>Tổng quan hiệu suất</strong><span>Cuộn chuột, vuốt hoặc dùng phím mũi tên để đổi màn hình.</span></figcaption>
            </figure>
        </div>
    </section>

    <section id="tinh-nang" class="landing-section landing-section-soft" aria-labelledby="features-title">
        <div class="landing-container">
            <div class="landing-section-heading" data-reveal>
                <p class="landing-eyebrow">Năng lực cốt lõi</p>
                <h2 id="features-title">Đủ công cụ để quản trị một chu kỳ hiệu suất hoàn chỉnh</h2>
                <p>Từng chức năng phục vụ một quyết định cụ thể, không làm người dùng bị ngợp bởi dữ liệu.</p>
            </div>
            <div class="landing-feature-grid">
                <article data-reveal><span class="landing-feature-icon" aria-hidden="true">O</span><h3>Quản lý OKR</h3><p>Liên kết mục tiêu tổ chức, phòng ban và cá nhân với kết quả then chốt rõ ràng.</p></article>
                <article data-reveal><span class="landing-feature-icon" aria-hidden="true">K</span><h3>Quản lý KPI</h3><p>Thiết lập chỉ tiêu, trọng số, kỳ đo và người chịu trách nhiệm theo quy trình.</p></article>
                <article data-reveal><span class="landing-feature-icon" aria-hidden="true">C</span><h3>Check-in tiến độ</h3><p>Cập nhật kết quả định kỳ, ghi nhận trở ngại và lưu vết thay đổi minh bạch.</p></article>
                <article data-reveal><span class="landing-feature-icon" aria-hidden="true">Đ</span><h3>Kỳ đánh giá</h3><p>Tổ chức đánh giá nhất quán theo thời gian và phạm vi được phân quyền.</p></article>
                <article data-reveal><span class="landing-feature-icon" aria-hidden="true">P</span><h3>Duyệt kết quả</h3><p>Chuẩn hóa luồng gửi, rà soát và phê duyệt trước khi chốt kết quả.</p></article>
                <article data-reveal><span class="landing-feature-icon" aria-hidden="true">B</span><h3>Báo cáo &amp; thưởng</h3><p>Tổng hợp hiệu suất và áp dụng quy tắc thưởng dựa trên dữ liệu đã xác nhận.</p></article>
            </div>
        </div>
    </section>

    <section id="quy-trinh" class="landing-section" aria-labelledby="process-title">
        <div class="landing-container">
            <div class="landing-section-heading" data-reveal>
                <p class="landing-eyebrow">Quy trình sử dụng</p>
                <h2 id="process-title">Năm bước rõ ràng từ mục tiêu đến báo cáo</h2>
                <p>Mọi vai trò phối hợp trên cùng một dòng dữ liệu, giảm thao tác lặp và hạn chế bỏ sót.</p>
            </div>
            <ol class="landing-process">
                <li data-reveal><span>01</span><div><h3>Thiết lập mục tiêu</h3><p>Xác định ưu tiên và kỳ thực hiện.</p></div></li>
                <li data-reveal><span>02</span><div><h3>Giao KPI/OKR</h3><p>Phân bổ chỉ tiêu và trách nhiệm.</p></div></li>
                <li data-reveal><span>03</span><div><h3>Check-in tiến độ</h3><p>Cập nhật kết quả và trở ngại.</p></div></li>
                <li data-reveal><span>04</span><div><h3>Đánh giá</h3><p>Rà soát kết quả theo tiêu chí.</p></div></li>
                <li data-reveal><span>05</span><div><h3>Phê duyệt &amp; báo cáo</h3><p>Chốt dữ liệu và tổng hợp quyết định.</p></div></li>
            </ol>
        </div>
    </section>

    <section class="landing-section landing-role-section" aria-labelledby="roles-title">
        <div class="landing-container landing-role-grid">
            <div class="landing-role-intro" data-reveal>
                <p class="landing-eyebrow">Giá trị theo vai trò</p>
                <h2 id="roles-title">Đúng thông tin cho đúng người</h2>
                <p>Mỗi vai trò có một góc nhìn phù hợp nhưng vẫn dùng chung nguồn dữ liệu đã được kiểm soát.</p>
            </div>
            <div class="landing-role-tabs" data-role-tabs data-reveal>
                <div class="landing-tab-list" role="tablist" aria-label="Chọn vai trò">
                    <button type="button" role="tab" id="role-employee-tab" aria-selected="true" aria-controls="role-employee">Nhân viên</button>
                    <button type="button" role="tab" id="role-manager-tab" aria-selected="false" aria-controls="role-manager" tabindex="-1">Quản lý</button>
                    <button type="button" role="tab" id="role-hr-tab" aria-selected="false" aria-controls="role-hr" tabindex="-1">HR</button>
                    <button type="button" role="tab" id="role-leader-tab" aria-selected="false" aria-controls="role-leader" tabindex="-1">Ban giám đốc</button>
                </div>
                <div class="landing-tab-panel" role="tabpanel" id="role-employee" aria-labelledby="role-employee-tab">
                    <strong>Biết mình cần ưu tiên điều gì.</strong><p>Theo dõi mục tiêu, check-in tiến độ và nhận phản hồi trong cùng một luồng công việc.</p>
                </div>
                <div class="landing-tab-panel" role="tabpanel" id="role-manager" aria-labelledby="role-manager-tab" hidden>
                    <strong>Phát hiện sớm điểm nghẽn của đội ngũ.</strong><p>Quan sát tiến độ, phản hồi và đánh giá dựa trên dữ liệu được cập nhật liên tục.</p>
                </div>
                <div class="landing-tab-panel" role="tabpanel" id="role-hr" aria-labelledby="role-hr-tab" hidden>
                    <strong>Vận hành chu kỳ nhất quán.</strong><p>Thiết lập kỳ đánh giá, kiểm soát quy trình và tổng hợp kết quả trên toàn tổ chức.</p>
                </div>
                <div class="landing-tab-panel" role="tabpanel" id="role-leader" aria-labelledby="role-leader-tab" hidden>
                    <strong>Nhìn thấy mức độ thực thi chiến lược.</strong><p>Nắm xu hướng hiệu suất và trạng thái mục tiêu để ưu tiên quyết định quan trọng.</p>
                </div>
            </div>
        </div>
    </section>

    @if (Model?.Any() == true)
    {
        <section id="bang-gia" class="landing-section landing-section-soft" aria-labelledby="pricing-title">
            <div class="landing-container">
                <div class="landing-section-heading" data-reveal>
                    <p class="landing-eyebrow">Gói sử dụng</p>
                    <h2 id="pricing-title">Chọn quy mô phù hợp với tổ chức</h2>
                    <p>Thông tin gói được tải trực tiếp từ hệ thống. Đăng ký để bắt đầu quy trình tư vấn và kích hoạt.</p>
                </div>
                <div class="landing-pricing-grid">
                    @foreach (var package in Model)
                    {
                        <article class="landing-price-card @(package.IsPopular ? "is-popular" : "")" data-reveal>
                            @if (package.IsPopular) { <span class="landing-popular-label">Được lựa chọn nhiều</span> }
                            <h3>@package.PackageName</h3>
                            <p>@package.Description</p>
                            <div class="landing-price"><strong>@package.PricePerMonth.ToString("N0")</strong><span>VNĐ / tháng</span></div>
                            <ul>
                                <li><span aria-hidden="true">✓</span> Tối đa @package.MaxUsers người dùng</li>
                                <li><span aria-hidden="true">✓</span> Quản lý KPI và OKR</li>
                                @if (package.HasAdvancedOKR) { <li><span aria-hidden="true">✓</span> OKR nâng cao</li> }
                                @if (package.HasAIInsight) { <li><span aria-hidden="true">✓</span> Phân tích hỗ trợ bằng AI</li> }
                            </ul>
                            <a class="landing-button @(package.IsPopular ? "landing-button-primary" : "landing-button-secondary")"
                               asp-controller="Auth" asp-action="Register" asp-route-plan="@package.PackageName">
                                Chọn gói @package.PackageName
                            </a>
                        </article>
                    }
                </div>
            </div>
        </section>
    }

    <section class="landing-final-cta">
        <div class="landing-container landing-final-cta-inner" data-reveal>
            <div><p class="landing-eyebrow">Sẵn sàng bắt đầu?</p><h2>Đưa mục tiêu vào một quy trình có thể theo dõi</h2><p>Tạo tài khoản VietMach System hoặc đăng nhập để tiếp tục công việc của bạn.</p></div>
            <div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="landing-button landing-button-light landing-button-large" asp-controller="Dashboard" asp-action="Index">Vào hệ thống</a>
                }
                else
                {
                    <a class="landing-button landing-button-light landing-button-large" asp-controller="Auth" asp-action="Register">Tạo tài khoản</a>
                    <a class="landing-text-link" asp-controller="Auth" asp-action="Login">Đã có tài khoản? Đăng nhập</a>
                }
            </div>
        </div>
    </section>
</main>

<footer class="landing-footer">
    <div class="landing-container landing-footer-inner">
        <div class="landing-brand">
            <span class="landing-brand-mark" aria-hidden="true">VM</span>
            <span><strong>VietMach System</strong><small>Manage KPI &amp; OKR</small></span>
        </div>
        <nav aria-label="Liên kết cuối trang">
            <a href="#san-pham">Sản phẩm</a><a href="#tinh-nang">Tính năng</a><a href="#quy-trinh">Quy trình</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                <a asp-controller="Auth" asp-action="Register">Đăng ký</a>
            }
        </nav>
        <p>© @DateTime.Now.Year VietMach System. Manage KPI &amp; OKR.</p>
    </div>
</footer>

@section Scripts {
    <script src="~/js/landing.js" asp-append-version="true"></script>
}
