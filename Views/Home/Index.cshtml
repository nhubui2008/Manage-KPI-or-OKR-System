</style>

<!-- ===== SCRIPTS ===== -->
<script>
    // --- Navbar Scroll Effect ---
    const nav = document.getElementById('lp-nav');
    window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 40);
    });

    // --- Smooth Scroll for anchor links ---
    document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', e => {
            e.preventDefault();
            const target = document.querySelector(a.getAttribute('href'));
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    // --- Scroll Reveal ---
    const revealElements = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                revealObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    revealElements.forEach(el => revealObserver.observe(el));

    // --- Counter Animation ---
    const counters = document.querySelectorAll('.counter');
    const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const counter = entry.target;
                const target = parseInt(counter.getAttribute('data-target'));
                const duration = 2000;
                const step = target / (duration / 16);
                let current = 0;
                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        counter.textContent = target;
                        clearInterval(timer);
                    } else {
                        counter.textContent = Math.floor(current);
                    }
                }, 16);
                counterObserver.unobserve(counter);
            }
        });
    }, { threshold: 0.5 });
    counters.forEach(c => counterObserver.observe(c));

    // --- Sticky Scroll Showcase ---
    const stickyBlocks = document.querySelectorAll('.sticky-block');
    const stickyImages = document.querySelectorAll('.sticky-img');
    
    if (stickyBlocks.length > 0 && stickyImages.length > 0) {
        const stickyObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const index = entry.target.getAttribute('data-index');
                    
                    // Highlight text block
                    stickyBlocks.forEach(b => b.classList.remove('is-active'));
                    entry.target.classList.add('is-active');
                    
                    // Show corresponding image
                    stickyImages.forEach(img => img.classList.remove('is-active'));
                    const targetImg = document.querySelector(`.sticky-img[data-index="${index}"]`);
                    if (targetImg) targetImg.classList.add('is-active');
                }
            });
        }, {
            root: null,
            threshold: 0.5,
            rootMargin: '-20% 0px -40% 0px'
        });

        stickyBlocks.forEach(block => stickyObserver.observe(block));
    }
    
    // --- Registration Modal Functionality ---
    const regModal = document.getElementById('regModal');
    const regPlanName = document.getElementById('regPlanName');
    const regPlanInput = document.getElementById('regPlanInput');
    const regForm = document.getElementById('regForm');
    const regSubmitBtn = document.getElementById('regSubmitBtn');
    let isRegistrationSubmitting = false;

    function getRegisterButtonLabel() {
        const hasPlan = (regPlanInput?.value || '').trim().length > 0;
        return `<i class="bi bi-person-plus-fill"></i> ${hasPlan ? 'Đăng ký & Mua gói' : 'Đăng ký Trải nghiệm'}`;
    }

    function purchasePlan(plan) {
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <text>
            Swal.fire({
                title: 'Xác nhận đăng ký gói',
                text: `Bạn có chắc chắn muốn đăng ký ${plan}? Đội ngũ của chúng tôi sẽ liên hệ để hỗ trợ bạn kích hoạt gói.`,
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch('/Home/PurchasePlanLoggedIn', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ plan: plan })
                        });
                        const data = await response.json();
                        if (data.success) {
                            Swal.fire({
                                title: 'Thành công!',
                                text: data.message,
                                icon: 'success',
                                confirmButtonColor: '#2563eb'
                            });
                        } else {
                            Swal.fire('Lỗi', data.message, 'error');
                        }
                    } catch (err) {
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                    }
                }
            });
            </text>
        }
        else
        {
            <text>
            openRegModal(plan);
            </text>
        }
    }

    function openRegModal(plan) {
        const modal = document.getElementById('regModal');
        const planInput1 = document.getElementById('regPlanInput');
        const planInput2 = document.getElementById('loginPlanInput');
        const planName = document.getElementById('regPlanName');
        const subtitleText = document.getElementById('regSubtitleText');
        const regSubmitBtn = document.getElementById('regSubmitBtn');
        const loginBuySubmitBtn = document.getElementById('loginBuySubmitBtn');
        
        if (plan) {
            planName.textContent = plan;
            planInput1.value = plan;
            planInput2.value = plan;
            if(subtitleText) subtitleText.style.display = 'block';
            if(loginBuySubmitBtn) loginBuySubmitBtn.innerHTML = '<i class="bi bi-box-arrow-in-right"></i> Đăng nhập & Mua gói';
        } else {
            planName.textContent = '';
            planInput1.value = '';
            planInput2.value = '';
            if(subtitleText) subtitleText.style.display = 'none';
            if(loginBuySubmitBtn) loginBuySubmitBtn.innerHTML = '<i class="bi bi-box-arrow-in-right"></i> Đăng nhập Hệ thống';
        }
        isRegistrationSubmitting = false;
        if(regSubmitBtn) {
            regSubmitBtn.disabled = false;
            regSubmitBtn.innerHTML = getRegisterButtonLabel();
        }
        
        modal.classList.add('active');
        setTimeout(() => document.getElementById('regEmail').focus(), 100);
    }

    function closeRegModal() {
        regModal.classList.remove('active');
        regForm.reset();
    }

    async function submitRegistration(e) {
        e.preventDefault();
        if (isRegistrationSubmitting) return;
        
        const emailInput = document.getElementById('regEmail');
        const email = emailInput.value.trim();
        const plan = regPlanInput.value;

        if (!email) return;

        isRegistrationSubmitting = true;
        emailInput.value = email;
        regSubmitBtn.disabled = true;
        regSubmitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...';
        let registrationCompleted = false;

        try {
            const formData = new FormData();
            formData.append('email', email);
            formData.append('plan', plan);

            const response = await fetch('/Home/RegisterPurchase', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                registrationCompleted = true;
                // Pre-fill the login email
                document.getElementById('loginUsername').value = email;
                
                if (typeof window.showAppToast === 'function') {
                    window.showAppToast({ tone: 'success', title: 'Đăng ký thành công!', message: result.message });
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đăng ký thành công!',
                        text: result.message,
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#4f46e5'
                    });
                } else {
                    alert(result.message);
                }
                
                closeRegModal();

                const heroBtn = document.querySelector('.lp-hero-actions .btn-primary-lg');
                if (heroBtn) {
                    heroBtn.innerHTML = '<i class="bi bi-grid-1x2-fill"></i> Truy cập Hệ thống';
                    heroBtn.onclick = null;
                    heroBtn.href = '/Auth/Login?username=' + encodeURIComponent(email) + (result.rawPassword ? '&password=' + encodeURIComponent(result.rawPassword) : '');
                }
            } else {
                if (typeof window.showAppToast === 'function') {
                    window.showAppToast({ tone: 'error', title: 'Lỗi', message: result.message });
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: result.message });
                } else {
                    alert(result.message);
                }
            }
        } catch (error) {
            console.error(error);
            if (typeof window.showAppToast === 'function') {
                window.showAppToast({ tone: 'error', title: 'Lỗi hệ thống', message: 'Có lỗi xảy ra, vui lòng thử lại sau.' });
            } else if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Lỗi hệ thống', text: 'Có lỗi xảy ra, vui lòng thử lại sau.' });
            } else {
                alert('Có lỗi xảy ra, vui lòng thử lại sau.');
            }
        } finally {
            if (!registrationCompleted) {
                isRegistrationSubmitting = false;
                regSubmitBtn.disabled = false;
                regSubmitBtn.innerHTML = getRegisterButtonLabel();
            }
        }
    }

    // --- Scroll Reveal Animation ---
    document.addEventListener('DOMContentLoaded', function() {
        const revealElements = document.querySelectorAll('.reveal');
        
        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target); // Stop observing once revealed
                }
            });
        }, {
            root: null,
            threshold: 0.15,
            rootMargin: '0px 0px -50px 0px'
        });

        revealElements.forEach(el => {
            revealObserver.observe(el);
        });
        
        // Handle navbar background on scroll
        const navbar = document.getElementById('lp-nav');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    });

    function switchRegTab(tab) {
        const tabReg = document.getElementById('tabRegister');
        const tabLog = document.getElementById('tabLogin');
        const formReg = document.getElementById('regForm');
        const formLog = document.getElementById('loginBuyForm');

        if (tab === 'register') {
            tabReg.style.color = 'var(--primary)';
            tabReg.style.borderBottomColor = 'var(--primary)';
            tabLog.style.color = '#64748b';
            tabLog.style.borderBottomColor = 'transparent';
            formReg.style.display = 'block';
            formLog.style.display = 'none';
        } else {
            tabLog.style.color = 'var(--primary)';
            tabLog.style.borderBottomColor = 'var(--primary)';
            tabReg.style.color = '#64748b';
            tabReg.style.borderBottomColor = 'transparent';
            formReg.style.display = 'none';
            formLog.style.display = 'block';
        }
    }

    async function submitLoginBuy(e) {
        e.preventDefault();
        
        const form = e.target;
        const formData = new FormData(form);
        const btn = document.getElementById('loginBuySubmitBtn');
        
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span> Đang xử lý...';
        
        try {
            const response = await fetch('/Home/LoginAndPurchase', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success) {
                if (typeof window.showAppToast === 'function') {
                    window.showAppToast({ tone: 'success', title: 'Thành công!', message: result.message });
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'success', title: 'Thành công', text: result.message });
                } else {
                    alert(result.message);
                }
                // Reload to stay on the landing page or redirect if provided
                setTimeout(() => {
                    if (result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                    } else {
                        window.location.reload();
                    }
                }, 1500);
            } else {
                if (typeof window.showAppToast === 'function') {
                    window.showAppToast({ tone: 'error', title: 'Lỗi', message: result.message });
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: result.message });
                } else {
                    alert(result.message);
                }
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-in-right"></i> Đăng nhập & Mua gói';
            }
        } catch (error) {
            console.error(error);
            if (typeof window.showAppToast === 'function') {
                window.showAppToast({ tone: 'error', title: 'Lỗi hệ thống', message: 'Có lỗi xảy ra, vui lòng thử lại sau.' });
            } else {
                alert('Có lỗi xảy ra, vui lòng thử lại sau.');
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-box-arrow-in-right"></i> Đăng nhập & Mua gói';
        }
    }

    // --- Change Password Modal Logic ---
    function openChangePasswordModal() {
        document.getElementById('changePasswordModal').classList.add('active');
        document.body.style.overflow = 'hidden';
        document.getElementById('changePasswordAjaxForm').reset();
        document.getElementById('cpAlertError').style.display = 'none';
        document.getElementById('cpAlertSuccess').style.display = 'none';
    }

    @if (User.Identity != null && User.Identity.IsAuthenticated && User.HasClaim(c => c.Type == "RequiresPasswordChange" && c.Value == "true"))
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            openChangePasswordModal();
        });
        </text>
    }

    function closeChangePasswordModal() {
        document.getElementById('changePasswordModal').classList.remove('active');
        document.body.style.overflow = '';
    }

    async function submitChangePasswordAjax(event) {
        event.preventDefault();
        const btn = document.getElementById('cpSubmitBtn');
        const errAlert = document.getElementById('cpAlertError');
        const errMsg = document.getElementById('cpErrorMsg');
        const successAlert = document.getElementById('cpAlertSuccess');
        const successMsg = document.getElementById('cpSuccessMsg');

        errAlert.style.display = 'none';
        successAlert.style.display = 'none';

        const oldPw = document.getElementById('oldPasswordAjax').value;
        const newPw = document.getElementById('newPasswordAjax').value;
        const confirmPw = document.getElementById('confirmPasswordAjax').value;

        if (newPw !== confirmPw) {
            errMsg.innerText = "Mật khẩu mới không khớp.";
            errAlert.style.display = 'flex';
            return;
        }

        btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Đang xử lý...';
        btn.disabled = true;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const response = await fetch('/Auth/ChangePasswordAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    oldPassword: oldPw,
                    newPassword: newPw,
                    confirmPassword: confirmPw
                })
            });

            const result = await response.json();
            if (result.success) {
                successMsg.innerText = result.message || "Đổi mật khẩu thành công!";
                successAlert.style.display = 'flex';
                document.getElementById('changePasswordAjaxForm').style.display = 'none';
                setTimeout(() => {
                    closeChangePasswordModal();
                }, 2000);
            } else {
                errMsg.innerText = result.message || "Có lỗi xảy ra.";
                errAlert.style.display = 'flex';
            }
        } catch (err) {
            errMsg.innerText = "Lỗi kết nối. Vui lòng thử lại.";
            errAlert.style.display = 'flex';
        } finally {
            btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Cập nhật Mật khẩu';
            btn.disabled = false;
        }
    }

    // --- Forgot Password Modal Logic ---
    let fpCurrentEmail = '';
    let fpCurrentCode = '';

    function openForgotPasswordModal() {
        // Nếu modal đăng nhập đang mở thì ẩn tạm đi hoặc không cần (do z-index)
        closeRegModal(); 
        
        document.getElementById('forgotPasswordModal').classList.add('active');
        document.body.style.overflow = 'hidden';
        
        document.getElementById('fpStep1Form').reset();
        document.getElementById('fpStep2Form').reset();
        document.getElementById('fpStep3Form').reset();
        
        document.getElementById('fpStep1Form').style.display = 'block';
        document.getElementById('fpStep2Form').style.display = 'none';
        document.getElementById('fpStep3Form').style.display = 'none';
        
        document.getElementById('fpAlertError').style.display = 'none';
        document.getElementById('fpAlertSuccess').style.display = 'none';
    }

    function closeForgotPasswordModal() {
        document.getElementById('forgotPasswordModal').classList.remove('active');
        document.body.style.overflow = '';
    }

    async function submitFpStep1(e) {
        e.preventDefault();
        const email = document.getElementById('fpEmail').value;
        const btn = document.getElementById('btnFpStep1');
        const errAlert = document.getElementById('fpAlertError');
        const errMsg = document.getElementById('fpErrorMsg');
        const successAlert = document.getElementById('fpAlertSuccess');
        const successMsg = document.getElementById('fpSuccessMsg');

        errAlert.style.display = 'none';
        successAlert.style.display = 'none';
        btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Đang xử lý...';
        btn.disabled = true;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('/Auth/ForgotPasswordAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ email: email })
            });
            const data = await res.json();
            if (data.success) {
                fpCurrentEmail = email;
                successMsg.innerText = data.message;
                successAlert.style.display = 'flex';
                document.getElementById('fpStep1Form').style.display = 'none';
                document.getElementById('fpStep2Form').style.display = 'block';
            } else {
                errMsg.innerText = data.message;
                errAlert.style.display = 'flex';
            }
        } catch (err) {
            errMsg.innerText = "Lỗi kết nối mạng.";
            errAlert.style.display = 'flex';
        } finally {
            btn.innerHTML = '<i class="bi bi-send-fill"></i> Nhận mã xác nhận';
            btn.disabled = false;
        }
    }

    async function submitFpStep2(e) {
        e.preventDefault();
        const code = document.getElementById('fpOtp').value;
        const btn = document.getElementById('btnFpStep2');
        const errAlert = document.getElementById('fpAlertError');
        const errMsg = document.getElementById('fpErrorMsg');
        const successAlert = document.getElementById('fpAlertSuccess');
        const successMsg = document.getElementById('fpSuccessMsg');

        errAlert.style.display = 'none';
        successAlert.style.display = 'none';
        btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Đang xử lý...';
        btn.disabled = true;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('/Auth/VerifyOTPAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ email: fpCurrentEmail, code: code })
            });
            const data = await res.json();
            if (data.success) {
                fpCurrentCode = code;
                successMsg.innerText = data.message;
                successAlert.style.display = 'flex';
                document.getElementById('fpStep2Form').style.display = 'none';
                document.getElementById('fpStep3Form').style.display = 'block';
            } else {
                errMsg.innerText = data.message;
                errAlert.style.display = 'flex';
            }
        } catch (err) {
            errMsg.innerText = "Lỗi kết nối mạng.";
            errAlert.style.display = 'flex';
        } finally {
            btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Xác nhận mã';
            btn.disabled = false;
        }
    }

    async function submitFpStep3(e) {
        e.preventDefault();
        const newPw = document.getElementById('fpNewPassword').value;
        const confirmPw = document.getElementById('fpConfirmPassword').value;
        const btn = document.getElementById('btnFpStep3');
        const errAlert = document.getElementById('fpAlertError');
        const errMsg = document.getElementById('fpErrorMsg');
        const successAlert = document.getElementById('fpAlertSuccess');
        const successMsg = document.getElementById('fpSuccessMsg');

        errAlert.style.display = 'none';
        successAlert.style.display = 'none';
        
        if (newPw !== confirmPw) {
            errMsg.innerText = "Mật khẩu không khớp.";
            errAlert.style.display = 'flex';
            return;
        }

        btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Đang xử lý...';
        btn.disabled = true;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('/Auth/SetNewPasswordAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ email: fpCurrentEmail, code: fpCurrentCode, newPassword: newPw, confirmPassword: confirmPw })
            });
            const data = await res.json();
            if (data.success) {
                successMsg.innerText = data.message;
                successAlert.style.display = 'flex';
                document.getElementById('fpStep3Form').style.display = 'none';
                setTimeout(() => {
                    closeForgotPasswordModal();
                    openRegModal('Gói Starter'); // Open login modal again
                    switchRegTab('login');
                }, 2000);
            } else {
                errMsg.innerText = data.message;
                errAlert.style.display = 'flex';
            }
        } catch (err) {
            errMsg.innerText = "Lỗi kết nối mạng.";
            errAlert.style.display = 'flex';
        } finally {
            btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Tạo mật khẩu mới';
            btn.disabled = false;
        }
    }
</script>
