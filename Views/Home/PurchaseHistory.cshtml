@model IEnumerable<Manage_KPI_or_OKR_System.Models.PurchaseRegistration>
@{
    ViewData["Title"] = "Lịch sử đăng ký mua";
    ViewData["IsLandingPage"] = true; // No system dashboard for this standalone page
}

@await Html.PartialAsync("_LandingHeader")

<main class="purchase-history-page">
    <div class="container">
        <!-- Breadcrumb / Back Navigation -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb" style="background: transparent; padding: 0;">
                <li class="breadcrumb-item"><a href="/" style="text-decoration: none; color: var(--primary); font-weight: 500;"><i class="bi bi-house-door"></i> Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Lịch sử đăng ký</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 py-4 px-4 d-flex align-items-center gap-3">
                <div style="width: 48px; height: 48px; border-radius: 8px; background: rgba(123,104,238,0.1); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <h2 class="h4 mb-1 fw-bold text-dark">Lịch sử đăng ký và mua gói</h2>
                    <p class="text-muted mb-0" style="font-size: 0.9rem;">Danh sách các gói dịch vụ bạn đã đăng ký từ trước đến nay.</p>
                </div>
            </div>
            
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 purchase-history-table">
                            <caption class="visually-hidden">Danh sách các gói dịch vụ đã đăng ký</caption>
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4 border-0 text-secondary fw-semibold">Thời gian</th>
                                    <th scope="col" class="border-0 text-secondary fw-semibold">Email tài khoản</th>
                                    <th scope="col" class="border-0 text-secondary fw-semibold">Tên gói dịch vụ</th>
                                    <th scope="col" class="border-0 text-secondary fw-semibold">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4" data-label="Thời gian">
                                            <div class="fw-medium text-dark">@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted small">@item.CreatedAt.ToString("HH:mm")</div>
                                        </td>
                                        <td data-label="Email tài khoản">
                                            <span class="text-dark">@item.Email</span>
                                        </td>
                                        <td data-label="Tên gói dịch vụ">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-box-seam text-primary"></i>
                                                <span class="fw-semibold text-primary">@item.SelectedPlan</span>
                                            </div>
                                        </td>
                                        <td data-label="Trạng thái">
                                            <span class="badge rounded-pill bg-success text-white px-3 py-2">Thành công</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="empty-history-icon" aria-hidden="true"><i class="bi bi-receipt"></i></div>
                        <h5 class="text-muted fw-normal mb-3">Bạn chưa đăng ký gói dịch vụ nào.</h5>
                        <a href="/#pricing" class="btn btn-primary px-4 py-2" style="border-radius: 50px; font-weight: 500;">
                            Xem Bảng giá
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

<style>
    .purchase-history-page {
        background-color: #f8f9fa;
        min-height: 100vh;
        padding: 100px 0 2rem;
    }
    .table-hover tbody tr:hover {
        background-color: rgba(123,104,238,0.04);
    }
    .table td, .table th {
        padding: 1rem 0.5rem;
        vertical-align: middle;
    }
    .empty-history-icon {
        color: var(--primary);
        font-size: 4rem;
        line-height: 1;
        margin-bottom: 1rem;
        opacity: .55;
    }
    @@media (max-width: 575.98px) {
        .purchase-history-page { padding-top: 82px; }
        .purchase-history-page .container { padding-inline: 1rem; }
        .purchase-history-page .card-header { align-items: flex-start !important; padding: 1.25rem !important; }
        .purchase-history-page .table-responsive { overflow: visible; }
        .purchase-history-table thead { display: none; }
        .purchase-history-table,
        .purchase-history-table tbody,
        .purchase-history-table tr,
        .purchase-history-table td { display: block; width: 100%; }
        .purchase-history-table tbody { padding: 0 1rem 1rem; }
        .purchase-history-table tr { border: 1px solid #e5e7eb; border-radius: .75rem; margin-top: 1rem; padding: .5rem 1rem; }
        .purchase-history-table td,
        .purchase-history-table td.ps-4 { display: flex; justify-content: space-between; gap: 1rem; padding: .65rem 0 !important; border: 0; text-align: right; overflow-wrap: anywhere; }
        .purchase-history-table td::before { content: attr(data-label); color: #6c757d; font-weight: 600; text-align: left; }
    }
</style>

@await Html.PartialAsync("_LandingFooter")
