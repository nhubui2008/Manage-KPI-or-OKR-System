@model Manage_KPI_or_OKR_System.Models.ViewModels.EvaluationPeriodIndexViewModel
@{
    ViewData["Title"] = "Quản lý Kỳ Đánh giá";
    var pageItems = Model.Items;
}

@functions {
    private string QuickFilterClass(string value) =>
        string.Equals(Model.QuickFilter, value, StringComparison.OrdinalIgnoreCase)
            ? "evaluation-chip is-active"
            : "evaluation-chip";

    private static string PeriodTypeLabel(string value) => value switch
    {
        "MONTH" => "Hàng tháng",
        "QUARTER" => "Hàng quý",
        "YEAR" => "Hàng năm",
        _ => value
    };
}

<div class="evaluation-page">
    <header class="evaluation-page-header">
        <div>
            <p class="evaluation-eyebrow">Chu kỳ hiệu suất</p>
            <h1>Kỳ đánh giá</h1>
            <nav class="evaluation-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Kỳ đánh giá</span>
            </nav>
        </div>
        @if (Model.CanCreatePeriod)
        {
            <a asp-action="Create" class="evaluation-primary-action">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Thêm kỳ đánh giá</span>
            </a>
        }
    </header>

    <section class="evaluation-summary" aria-label="Tổng quan kỳ đánh giá">
        <article>
            <span>Tổng kỳ đánh giá</span>
            <strong>@Model.Summary.TotalCount</strong>
            <small>Trong phạm vi bộ lọc</small>
        </article>
        <article class="evaluation-summary--running">
            <span>Đang diễn ra</span>
            <strong>@Model.Summary.InProgressCount</strong>
            <small>Đang trong khoảng ngày</small>
        </article>
        <article class="evaluation-summary--upcoming">
            <span>Sắp bắt đầu</span>
            <strong>@Model.Summary.UpcomingCount</strong>
            <small>Chưa đến ngày mở kỳ</small>
        </article>
        <article class="evaluation-summary--ending">
            <span>Sắp kết thúc</span>
            <strong>@Model.Summary.EndingSoonCount</strong>
            <small>Trong 7 ngày tới</small>
        </article>
        <article class="evaluation-summary--completed">
            <span>Đã kết thúc</span>
            <strong>@Model.Summary.CompletedCount</strong>
            <small>Đã đóng hoặc quá ngày</small>
        </article>
    </section>

    <section class="evaluation-filter-panel" aria-labelledby="evaluation-filter-title">
        <div class="evaluation-filter-heading">
            <div>
                <p class="evaluation-eyebrow" id="evaluation-filter-title">Tìm và lọc</p>
                <span>Thu hẹp danh sách theo thời gian và trạng thái vận hành.</span>
            </div>
            @if (Model.HasActiveFilters)
            {
                <a asp-action="Index" class="evaluation-clear-link">
                    <i class="bi bi-x-lg" aria-hidden="true"></i> Xóa lọc
                </a>
            }
        </div>

        <form asp-action="Index" method="get" class="evaluation-filter-form">
            <label class="evaluation-search-field">
                <span class="visually-hidden">Tìm theo tên kỳ đánh giá</span>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="searchString" value="@Model.SearchString" placeholder="Tên kỳ đánh giá..." />
            </label>

            <label>
                <span>Năm</span>
                <select name="year" class="no-select2">
                    <option value="">Tất cả</option>
                    @foreach (var item in Model.AvailableYears)
                    {
                        <option value="@item" selected="@(Model.Year == item ? "selected" : null)">@item</option>
                    }
                </select>
            </label>

            <label>
                <span>Loại kỳ</span>
                <select name="periodType" class="no-select2">
                    <option value="">Tất cả</option>
                    @foreach (var item in Model.AvailablePeriodTypes)
                    {
                        <option value="@item" selected="@(Model.PeriodType == item ? "selected" : null)">@PeriodTypeLabel(item)</option>
                    }
                </select>
            </label>

            <label>
                <span>Trạng thái dữ liệu</span>
                <select name="statusId" class="no-select2">
                    <option value="">Tất cả</option>
                    @foreach (var item in Model.AvailableStatuses)
                    {
                        <option value="@item.Id" selected="@(Model.StatusId == item.Id ? "selected" : null)">@item.Name</option>
                    }
                </select>
            </label>

            <label>
                <span>Sắp xếp</span>
                <select name="sortBy" class="no-select2">
                    <option value="recent" selected="@(Model.SortBy == "recent" ? "selected" : null)">Mới bắt đầu trước</option>
                    <option value="start" selected="@(Model.SortBy == "start" ? "selected" : null)">Sắp bắt đầu trước</option>
                    <option value="ending" selected="@(Model.SortBy == "ending" ? "selected" : null)">Sắp kết thúc trước</option>
                    <option value="name" selected="@(Model.SortBy == "name" ? "selected" : null)">Tên A-Z</option>
                </select>
            </label>

            <input type="hidden" name="quickFilter" value="@Model.QuickFilter" />
            <button type="submit" class="evaluation-filter-button">
                <i class="bi bi-funnel" aria-hidden="true"></i> Lọc
            </button>
        </form>

        <nav class="evaluation-quick-filters" aria-label="Lọc nhanh kỳ đánh giá">
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-year="@Model.Year" asp-route-periodType="@Model.PeriodType" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" class="@QuickFilterClass("")">
                <i class="bi bi-grid" aria-hidden="true"></i> Tất cả
            </a>
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-year="@Model.Year" asp-route-periodType="@Model.PeriodType" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="running" class="@QuickFilterClass("running")">
                <i class="bi bi-play-circle" aria-hidden="true"></i> Đang diễn ra
            </a>
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-year="@Model.Year" asp-route-periodType="@Model.PeriodType" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="upcoming" class="@QuickFilterClass("upcoming")">
                <i class="bi bi-calendar-plus" aria-hidden="true"></i> Sắp bắt đầu
            </a>
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-year="@Model.Year" asp-route-periodType="@Model.PeriodType" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="ending" class="@QuickFilterClass("ending")">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i> Sắp kết thúc
            </a>
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-year="@Model.Year" asp-route-periodType="@Model.PeriodType" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="overdue" class="@QuickFilterClass("overdue")">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Quá hạn
            </a>
            <a asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-year="@Model.Year" asp-route-periodType="@Model.PeriodType" asp-route-statusId="@Model.StatusId" asp-route-sortBy="@Model.SortBy" asp-route-quickFilter="closed" class="@QuickFilterClass("closed")">
                <i class="bi bi-lock" aria-hidden="true"></i> Đã đóng
            </a>
        </nav>
    </section>

    <section class="evaluation-results" aria-labelledby="evaluation-results-title">
        <div class="evaluation-results-heading">
            <div>
                <p class="evaluation-eyebrow" id="evaluation-results-title">Danh sách kỳ</p>
                <strong>@Model.Summary.TotalCount kỳ phù hợp</strong>
            </div>
            <span>Trang @pageItems.PageIndex / @Math.Max(1, pageItems.TotalPages)</span>
        </div>

        @if (pageItems.Count == 0)
        {
            <div class="evaluation-empty">
                <span class="evaluation-empty-icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span>
                <h2>@(Model.IsFilteredEmpty ? "Không có kỳ phù hợp" : "Chưa có kỳ đánh giá")</h2>
                <p>@(Model.IsFilteredEmpty ? "Thử thay đổi bộ lọc hoặc xóa lọc để xem toàn bộ kỳ đánh giá." : "Tạo kỳ đầu tiên để liên kết KPI, check-in và kết quả đánh giá.")</p>
                @if (Model.IsFilteredEmpty)
                {
                    <a asp-action="Index" class="evaluation-secondary-action">Xóa bộ lọc</a>
                }
                else if (Model.CanCreatePeriod)
                {
                    <a asp-action="Create" class="evaluation-primary-action">Tạo kỳ đánh giá</a>
                }
            </div>
        }
        else
        {
            <div class="evaluation-table-shell">
                <table class="evaluation-table">
                    <thead>
                        <tr>
                            <th>Kỳ đánh giá</th>
                            <th>Thời gian</th>
                            <th>Vận hành</th>
                            <th>Liên kết</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pageItems)
                        {
                            <tr>
                                <td>
                                    <div class="evaluation-period-name">
                                        <span class="evaluation-calendar-mark"><i class="bi bi-calendar3" aria-hidden="true"></i></span>
                                        <div>
                                            <strong>@item.PeriodName</strong>
                                            <span>@item.PeriodTypeLabel · @item.StatusName</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="evaluation-date-range">
                                        <strong>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "Chưa đặt")</strong>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                        <strong>@(item.EndDate?.ToString("dd/MM/yyyy") ?? "Chưa đặt")</strong>
                                        @if (item.DurationDays.HasValue)
                                        {
                                            <small>@item.DurationDays ngày</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="@item.OperationalStatusCssClass">
                                        <span aria-hidden="true"></span>@item.OperationalStatusLabel
                                    </span>
                                </td>
                                <td>
                                    <div class="evaluation-dependencies">
                                        <a asp-controller="KPIs" asp-action="Index" asp-route-periodId="@item.Id" aria-label="Xem @item.KpiCount KPI của @item.PeriodName">
                                            <strong>@item.KpiCount</strong><span>KPI</span>
                                        </a>
                                        <span><strong>@item.EvaluationResultCount</strong><span>Kết quả</span></span>
                                    </div>
                                </td>
                                <td>
                                    <div class="evaluation-actions">
                                        @if (Model.CanEditPeriod)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="evaluation-icon-button" aria-label="Sửa kỳ @item.PeriodName">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                            </a>
                                            @if (item.StatusName == "Mở")
                                            {
                                                <form asp-action="StartProcessing" method="post" data-evaluation-confirm
                                                      data-confirm-title="Bắt đầu xử lý kỳ?"
                                                      data-confirm-message="Chuyển @item.PeriodName sang trạng thái Đang xử lý.">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="evaluation-icon-button" aria-label="Bắt đầu xử lý kỳ @item.PeriodName" title="Bắt đầu xử lý">
                                                        <i class="bi bi-play-fill" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (item.StatusName == "Đang xử lý")
                                            {
                                                <form asp-action="Close" method="post" data-evaluation-confirm data-confirm-tone="warning"
                                                      data-confirm-title="Đóng kỳ đánh giá?"
                                                      data-confirm-message="Đóng @item.PeriodName. Hệ thống sẽ kiểm tra KPI, check-in và kết quả chưa hoàn tất trước khi lưu.">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="evaluation-icon-button" aria-label="Đóng kỳ @item.PeriodName" title="Đóng kỳ">
                                                        <i class="bi bi-lock" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (item.StatusName == "Đóng")
                                            {
                                                <form asp-action="Reopen" method="post" data-evaluation-confirm
                                                      data-confirm-title="Mở lại kỳ đánh giá?"
                                                      data-confirm-message="Mở lại @item.PeriodName để tiếp tục xử lý dữ liệu.">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="evaluation-icon-button" aria-label="Mở lại kỳ @item.PeriodName" title="Mở lại kỳ">
                                                        <i class="bi bi-unlock" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }
                                        }
                                        @if (Model.CanDeletePeriod)
                                        {
                                            <form asp-action="Delete" method="post" data-evaluation-confirm data-confirm-tone="danger"
                                                  data-confirm-title="Vô hiệu hóa kỳ đánh giá?"
                                                  data-confirm-message="Vô hiệu hóa @item.PeriodName. Kỳ hiện có @item.KpiCount KPI và @item.EvaluationResultCount kết quả liên kết; nếu còn dependency, hệ thống sẽ từ chối thao tác.">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" aria-label="Vô hiệu hóa kỳ @item.PeriodName">
                                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (!Model.CanEditPeriod && !Model.CanDeletePeriod)
                                        {
                                            <span class="evaluation-no-action">Chỉ xem</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="evaluation-mobile-list">
                @foreach (var item in pageItems)
                {
                    <article class="evaluation-period-card">
                        <div class="evaluation-card-topline">
                            <span class="@item.OperationalStatusCssClass"><span aria-hidden="true"></span>@item.OperationalStatusLabel</span>
                            <span class="evaluation-config-status">@item.StatusName</span>
                        </div>
                        <h2>@item.PeriodName</h2>
                        <p>@item.PeriodTypeLabel</p>
                        <dl>
                            <div><dt>Bắt đầu</dt><dd>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "Chưa đặt")</dd></div>
                            <div><dt>Kết thúc</dt><dd>@(item.EndDate?.ToString("dd/MM/yyyy") ?? "Chưa đặt")</dd></div>
                            <div><dt>KPI</dt><dd>@item.KpiCount</dd></div>
                            <div><dt>Kết quả</dt><dd>@item.EvaluationResultCount</dd></div>
                        </dl>
                        <div class="evaluation-card-footer">
                            <a asp-controller="KPIs" asp-action="Index" asp-route-periodId="@item.Id">Xem KPI liên kết</a>
                            <div class="evaluation-actions">
                                @if (Model.CanEditPeriod)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="evaluation-icon-button" aria-label="Sửa kỳ @item.PeriodName trên thẻ di động">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    </a>
                                    @if (item.StatusName == "Mở")
                                    {
                                        <form asp-action="StartProcessing" method="post" data-evaluation-confirm
                                              data-confirm-title="Bắt đầu xử lý kỳ?"
                                              data-confirm-message="Chuyển @item.PeriodName sang trạng thái Đang xử lý.">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="evaluation-icon-button" aria-label="Bắt đầu xử lý kỳ @item.PeriodName trên thẻ di động">
                                                <i class="bi bi-play-fill" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.StatusName == "Đang xử lý")
                                    {
                                        <form asp-action="Close" method="post" data-evaluation-confirm data-confirm-tone="warning"
                                              data-confirm-title="Đóng kỳ đánh giá?"
                                              data-confirm-message="Đóng @item.PeriodName. Hệ thống sẽ kiểm tra KPI, check-in và kết quả chưa hoàn tất trước khi lưu.">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="evaluation-icon-button" aria-label="Đóng kỳ @item.PeriodName trên thẻ di động">
                                                <i class="bi bi-lock" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.StatusName == "Đóng")
                                    {
                                        <form asp-action="Reopen" method="post" data-evaluation-confirm
                                              data-confirm-title="Mở lại kỳ đánh giá?"
                                              data-confirm-message="Mở lại @item.PeriodName để tiếp tục xử lý dữ liệu.">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="evaluation-icon-button" aria-label="Mở lại kỳ @item.PeriodName trên thẻ di động">
                                                <i class="bi bi-unlock" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                }
                                @if (Model.CanDeletePeriod)
                                {
                                    <form asp-action="Delete" method="post" data-evaluation-confirm data-confirm-tone="danger"
                                          data-confirm-title="Vô hiệu hóa kỳ đánh giá?"
                                          data-confirm-message="Vô hiệu hóa @item.PeriodName. Kỳ hiện có @item.KpiCount KPI và @item.EvaluationResultCount kết quả liên kết; nếu còn dependency, hệ thống sẽ từ chối thao tác.">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="evaluation-icon-button evaluation-icon-button--danger" aria-label="Vô hiệu hóa kỳ @item.PeriodName trên thẻ di động">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }

        @if (pageItems.TotalPages > 1)
        {
            <nav class="evaluation-pagination" aria-label="Phân trang kỳ đánh giá">
                @if (pageItems.PreviousPageNumber.HasValue)
                {
                    <a asp-action="Index" asp-route-pageNumber="@pageItems.PreviousPageNumber" asp-route-searchString="@Model.SearchString" asp-route-year="@Model.Year" asp-route-periodType="@Model.PeriodType" asp-route-statusId="@Model.StatusId" asp-route-quickFilter="@Model.QuickFilter" asp-route-sortBy="@Model.SortBy" aria-label="Trang trước"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                }

                @for (var pageIndex = 1; pageIndex <= pageItems.TotalPages; pageIndex++)
                {
                    <a asp-action="Index" asp-route-pageNumber="@pageIndex" asp-route-searchString="@Model.SearchString" asp-route-year="@Model.Year" asp-route-periodType="@Model.PeriodType" asp-route-statusId="@Model.StatusId" asp-route-quickFilter="@Model.QuickFilter" asp-route-sortBy="@Model.SortBy" class="@(pageIndex == pageItems.PageIndex ? "is-current" : "")" aria-current="@(pageIndex == pageItems.PageIndex ? "page" : null)">@pageIndex</a>
                }

                @if (pageItems.NextPageNumber.HasValue)
                {
                    <a asp-action="Index" asp-route-pageNumber="@pageItems.NextPageNumber" asp-route-searchString="@Model.SearchString" asp-route-year="@Model.Year" asp-route-periodType="@Model.PeriodType" asp-route-statusId="@Model.StatusId" asp-route-quickFilter="@Model.QuickFilter" asp-route-sortBy="@Model.SortBy" aria-label="Trang sau"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                }
            </nav>
        }
    </section>
</div>

@if (Model.CanEditPeriod || Model.CanDeletePeriod)
{
    <div class="modal fade" id="evaluationConfirmModal" tabindex="-1"
         aria-labelledby="evaluationConfirmTitle" aria-describedby="evaluationConfirmMessage" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content evaluation-modal evaluation-confirm-modal">
                <div class="modal-header border-0 pb-0">
                    <div class="evaluation-confirm-heading">
                        <span class="evaluation-confirm-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                        <div>
                            <p class="evaluation-eyebrow">Xác nhận thao tác</p>
                            <h2 class="modal-title" id="evaluationConfirmTitle">Xác nhận thay đổi</h2>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng cửa sổ xác nhận"></button>
                </div>
                <div class="modal-body pt-3">
                    <p id="evaluationConfirmMessage" class="mb-0"></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="evaluation-secondary-action" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="evaluation-primary-action" id="evaluationConfirmSubmit">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/evaluation-periods.js" asp-append-version="true"></script>
}
