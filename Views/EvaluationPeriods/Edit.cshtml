@model Manage_KPI_or_OKR_System.Models.ViewModels.EvaluationPeriodInputViewModel
@{
    ViewData["Title"] = "Sửa Kỳ đánh giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-content">
    <div class="page-header evaluation-form-header d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="mb-2 fw-bold">Sửa kỳ đánh giá</h1>
            <div class="page-breadcrumb">
                <a asp-action="Index">Kỳ đánh giá</a>
                <span class="separator">/</span>
                <span class="text-muted">@Model.PeriodName</span>
            </div>
        </div>
        <a asp-action="Index" class="btn-outline-custom">
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i> Quay lại
        </a>
    </div>

    <div class="content-card evaluation-edit-card border-0 shadow-sm mx-auto">
        <div class="card-body-custom p-4 p-lg-5">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="PeriodName" class="form-label fw-semibold"></label>
                    <input asp-for="PeriodName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="PeriodName" class="text-danger small"></span>
                </div>

                <div class="row g-4">
                    <div class="col-md-4">
                        <label asp-for="PeriodType" class="form-label fw-semibold"></label>
                        <select asp-for="PeriodType" class="form-select no-select2">
                            <option value="MONTH">Hàng tháng</option>
                            <option value="QUARTER">Hàng quý</option>
                            <option value="YEAR">Hàng năm</option>
                        </select>
                        <span asp-validation-for="PeriodType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <p class="text-muted small mt-4 mb-0">
                    Nếu kỳ đã có KPI, check-in hoặc kết quả đánh giá, hệ thống chỉ cho phép đổi tên để bảo toàn lịch sử.
                </p>

                <div class="evaluation-form-actions d-flex flex-wrap justify-content-end gap-3 mt-4 pt-4 border-top">
                    <a asp-action="Index" class="btn-outline-custom">Hủy</a>
                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-check-lg me-2" aria-hidden="true"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
