@model Manage_KPI_or_OKR_System.Models.ViewModels.EvaluationPeriodInputViewModel
@{
    ViewData["Title"] = "Thêm kỳ đánh giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cf-page evaluation-create" data-create-form data-evaluation-preview>
    <header class="cf-header">
        <div class="cf-header__content">
            <h1>Thêm kỳ đánh giá</h1>
            <nav class="cf-breadcrumb" aria-label="Điều hướng trang">
                <a href="/">Trang chủ</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <a asp-action="Index">Kỳ đánh giá</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Thêm mới</span>
            </nav>
            <p class="cf-header__description">Xác định tên, loại và khoảng ngày để liên kết KPI, check-in và kết quả đánh giá đúng chu kỳ.</p>
        </div>
        <a asp-action="Index" class="cf-back-action">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Quay lại</span>
        </a>
    </header>

    <div class="cf-layout">
        <section class="cf-panel" aria-labelledby="evaluationFormHeading">
            <div class="cf-panel__header">
                <div>
                    <h2 id="evaluationFormHeading">Thông tin kỳ</h2>
                    <p>Các trường có dấu <span class="cf-required" aria-hidden="true">*</span> là bắt buộc.</p>
                </div>
            </div>

            <form asp-action="Create" method="post" class="cf-form" data-create-form-element>
                <div asp-validation-summary="All" class="cf-alert" role="alert" tabindex="-1" data-error-summary></div>

                <section class="cf-section" aria-labelledby="evaluationIdentityHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-calendar2-week"></i></span>
                        <div>
                            <h3 id="evaluationIdentityHeading">Thông tin kỳ đánh giá</h3>
                            <p>Đặt tên nhất quán và chọn loại kỳ phù hợp với lịch đo lường.</p>
                        </div>
                    </div>
                    <div class="cf-field-grid cf-field-grid--wide-first">
                        <div class="cf-field">
                            <div class="cf-label-row">
                                <label asp-for="PeriodName">Tên kỳ đánh giá <span class="cf-required" aria-label="bắt buộc">*</span></label>
                                <output id="periodNameCounter" class="cf-counter" for="PeriodName" data-character-counter>0/100</output>
                            </div>
                            <input asp-for="PeriodName"
                                   class="form-control cf-control"
                                   maxlength="100"
                                   autocomplete="off"
                                   placeholder="Ví dụ: Đánh giá quý 3/2026"
                                   aria-describedby="periodNameHint periodNameCounter"
                                   required />
                            <span asp-validation-for="PeriodName" class="cf-validation"></span>
                            <p id="periodNameHint" class="cf-hint">Tên phải khác các kỳ đang hoạt động và không vượt quá 100 ký tự.</p>
                        </div>
                        <div class="cf-field">
                            <label asp-for="PeriodType">Loại kỳ <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <select asp-for="PeriodType"
                                    class="form-select cf-control no-select2"
                                    aria-describedby="periodTypeHint durationRule"
                                    required>
                                <option value="MONTH">Hàng tháng</option>
                                <option value="QUARTER">Hàng quý</option>
                                <option value="YEAR">Hàng năm</option>
                            </select>
                            <span asp-validation-for="PeriodType" class="cf-validation"></span>
                            <p id="periodTypeHint" class="cf-hint">Loại kỳ quyết định khoảng số ngày hợp lệ.</p>
                        </div>
                    </div>
                </section>

                <section class="cf-section" aria-labelledby="evaluationDatesHeading">
                    <div class="cf-section__heading">
                        <span class="cf-section__icon" aria-hidden="true"><i class="bi bi-calendar-range"></i></span>
                        <div>
                            <h3 id="evaluationDatesHeading">Khoảng thời gian</h3>
                            <p>Server kiểm tra thứ tự ngày, độ dài theo loại kỳ và khoảng trùng cùng loại.</p>
                        </div>
                    </div>
                    <div class="cf-field-grid">
                        <div class="cf-field">
                            <label asp-for="StartDate">Ngày bắt đầu <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="StartDate"
                                   asp-format="{0:yyyy-MM-dd}"
                                   type="date"
                                   class="form-control cf-control"
                                   lang="vi"
                                   aria-describedby="dateRangeHint durationRule"
                                   required />
                            <span asp-validation-for="StartDate" class="cf-validation"></span>
                        </div>
                        <div class="cf-field">
                            <label asp-for="EndDate">Ngày kết thúc <span class="cf-required" aria-label="bắt buộc">*</span></label>
                            <input asp-for="EndDate"
                                   asp-format="{0:yyyy-MM-dd}"
                                   type="date"
                                   class="form-control cf-control"
                                   lang="vi"
                                   aria-describedby="dateRangeHint durationRule"
                                   required />
                            <span asp-validation-for="EndDate" class="cf-validation"></span>
                        </div>
                    </div>
                    <p id="durationRule" class="cf-dynamic-hint evaluation-duration-rule" data-duration-rule>Chọn từ 28 đến 31 ngày cho kỳ tháng.</p>
                    <p id="dateRangeHint" class="cf-hint">Ngày kết thúc không được trước ngày bắt đầu; hai kỳ đang hoạt động cùng loại không được chồng lấn.</p>
                    <div class="cf-inline-note" role="status">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <span>Kỳ mới luôn được server tạo ở trạng thái <strong>Mở</strong> và chưa xử lý. Trạng thái được chuyển bằng thao tác vòng đời riêng.</span>
                    </div>
                </section>

                <div class="cf-actions">
                    <a asp-action="Index" class="cf-secondary-action">Hủy</a>
                    <button type="submit"
                            class="cf-primary-action"
                            data-submit-button
                            data-default-label="Tạo kỳ đánh giá"
                            data-loading-label="Đang tạo...">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span data-submit-label>Tạo kỳ đánh giá</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="cf-guide evaluation-preview" aria-labelledby="evaluationPreviewHeading">
            <div class="cf-guide__identity">
                <span class="cf-guide__icon" aria-hidden="true"><i class="bi bi-calendar-check"></i></span>
                <div>
                    <span class="cf-guide__eyebrow">Xem trước</span>
                    <h2 id="evaluationPreviewHeading"><span id="previewName">Chưa đặt tên kỳ</span></h2>
                </div>
            </div>
            <p id="previewStatus" class="evaluation-preview__status" aria-live="polite">Nhập đủ ngày để kiểm tra độ dài kỳ.</p>
            <dl class="cf-preview-list">
                <div>
                    <dt>Loại kỳ</dt>
                    <dd id="previewType">Hàng tháng</dd>
                </div>
                <div>
                    <dt>Bắt đầu</dt>
                    <dd id="previewStart">Chưa chọn</dd>
                </div>
                <div>
                    <dt>Kết thúc</dt>
                    <dd id="previewEnd">Chưa chọn</dd>
                </div>
                <div>
                    <dt>Độ dài</dt>
                    <dd id="previewDuration">Chưa tính</dd>
                </div>
            </dl>
            <ul class="cf-guide__list evaluation-preview__rules">
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Kỳ tháng: 28-31 ngày.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Kỳ quý: 89-92 ngày.</span></li>
                <li><i class="bi bi-check2" aria-hidden="true"></i><span>Kỳ năm: 365-366 ngày.</span></li>
            </ul>
            <div class="cf-guide__note">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>Preview chỉ hỗ trợ nhập liệu; validation server vẫn là kết quả quyết định cuối cùng.</span>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-periods.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-form.js" asp-append-version="true"></script>
    <script src="~/js/evaluation-periods.js" asp-append-version="true"></script>
}
