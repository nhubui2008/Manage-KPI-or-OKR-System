# Complete local-development template.
# Copy this file to .env, then replace only the placeholders you actually use.
# Never commit .env. Existing process environment variables take precedence.

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Local SQL Server Express with Windows authentication.
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=manasys;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=Manage-KPI-or-OKR-System;Connect Timeout=30

# Alternative: local/default SQL Server instance with Windows authentication.
# ConnectionStrings__DefaultConnection=Server=localhost;Database=manasys;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=Manage-KPI-or-OKR-System;Connect Timeout=30

# Alternative: SQL authentication. Keep the password only in .env or a secret store.
# ConnectionStrings__DefaultConnection=Server=127.0.0.1,1433;Database=manasys;User Id=KPI_APP_USER;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=Manage-KPI-or-OKR-System;Connect Timeout=30

# Keep false in production. Apply reviewed migrations through the deployment process.
# Local development may temporarily set this to true when automatic migration is wanted.
Database__RunMigrationsOnStartup=false

# -----------------------------------------------------------------------------
# External sign-in (optional)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI advisory (optional; keep disabled until every dependency is configured)
# -----------------------------------------------------------------------------
DeepSeek__BaseUrl=https://api.deepseek.com/v1/
DeepSeek__Model=deepseek-v4-flash
DeepSeek__ApiKey=

# Valid modes: Disabled, Shadow, Pilot, GeneralAvailability.
AiAdvisoryRollout__KillSwitch=true
AiAdvisoryRollout__CheckInEvaluationMode=Disabled
# AiAdvisoryRollout__PilotTenantIds__0=12
# AiAdvisoryRollout__PilotDepartmentIds__0=24

# -----------------------------------------------------------------------------
# Knowledge/RAG infrastructure (optional)
# -----------------------------------------------------------------------------
# Destructive legacy AI-history cleanup is double-gated. Keep this false until
# a verified backup exists and the tenant has approved AI_HISTORY_CLEANUP_APPROVED.
AiHistoryCleanup__Enabled=false

Qdrant__Endpoint=http://127.0.0.1:6333
Qdrant__CollectionName=kpi-knowledge-v1
Qdrant__ApiKey=
Qdrant__Dimensions=1024
Qdrant__TimeoutSeconds=5

Minio__Endpoint=http://127.0.0.1:9100
Minio__AccessKey=
Minio__SecretKey=
Minio__BucketName=kpi-knowledge
Minio__UseSsl=false
Minio__StableBaseUri=https://knowledge.local/kpi-knowledge

# Endpoint must end with /v1/embeddings.
BgeM3__Endpoint=
BgeM3__ApiKey=
BgeM3__Model=BAAI/bge-m3
BgeM3__Dimensions=1024
BgeM3__TimeoutSeconds=20

# Endpoint must end with /file_parse.
MinerU__Endpoint=
MinerU__ApiKey=
MinerU__TimeoutSeconds=3600
MinerU__MaxFileBytes=26214400

KnowledgeStorage__AllowedReadOrigins__0=https://knowledge.local
KnowledgeStorage__MaxSourceBytes=26214400
KnowledgeStorage__MaxParsedResultBytes=10485760
KnowledgeStorage__MaxChunkCharacters=6000
KnowledgeStorage__MaxChunksPerDocument=1000

MalwareScanner__Host=
MalwareScanner__Port=3310
MalwareScanner__TimeoutSeconds=30

# Pin parser, embedding model and Qdrant schema together, for example:
# mineru-0dfc9460-pipeline-ed6b654c|bge-m3-5617a9f6-tei-939883b2|qdrant-schema-v1
DocumentIngestion__PipelineVersion=

# -----------------------------------------------------------------------------
# Email and password reset (optional in Development, required in Production)
# -----------------------------------------------------------------------------
SmtpSettings__Server=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__SenderName=KPI System
SmtpSettings__SenderEmail=
SmtpSettings__Password=

# Development may use HTTP. Production must use an absolute HTTPS URL.
PasswordReset__PublicBaseUrl=http://127.0.0.1:5208

# -----------------------------------------------------------------------------
# Hosting and data protection
# -----------------------------------------------------------------------------
DataProtection__KeysPath=App_Data/DataProtection-Keys

# Local development: disabled. Enable only behind a trusted reverse proxy.
ForwardedHeaders__Enabled=false
ForwardedHeaders__ForwardLimit=1
ForwardedHeaders__KnownProxies__0=127.0.0.1
ForwardedHeaders__TrustAllProxies=false
