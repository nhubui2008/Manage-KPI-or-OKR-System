# Copy to .env for local development only. Keep production values in the
# deployment secret store. Existing environment variables take precedence.
ConnectionStrings__DefaultConnection=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DeepSeek__BaseUrl=https://api.deepseek.com/v1/
DeepSeek__Model=deepseek-v4-pro
DeepSeek__ApiKey=
DeepSeek__TimeoutSeconds=30

# Check-in AI rollout: Disabled, Shadow, Pilot, or GeneralAvailability.
# Keep the kill switch true outside an explicitly approved rollout.
AiAdvisoryRollout__KillSwitch=true
AiAdvisoryRollout__CheckInEvaluationMode=Disabled
# Pilot allow-lists use indexed keys, for example __0=12, __1=24.
# AiAdvisoryRollout__PilotTenantIds__0=12
# AiAdvisoryRollout__PilotDepartmentIds__0=24

AzureSearch__Endpoint=
AzureSearch__IndexName=
AzureSearch__ApiKey=
AzureSearch__ApiVersion=2024-07-01
AzureSearch__VectorField=contentVector
AzureSearch__EmbeddingDimensions=1024

BgeM3__Endpoint=
BgeM3__Dimensions=1024
BgeM3__TimeoutSeconds=20

MinerU__Endpoint=
MinerU__ApiKey=
MinerU__TimeoutSeconds=120
MinerU__MaxFileBytes=26214400
MinerU__StatusPathTemplate={jobId}

# Private Azure Blob container SAS. Keep the SAS in the deployment secret store.
KnowledgeStorage__ContainerSasUri=
# Use indexed environment keys for exact HTTPS origins (scheme + host + optional port).
KnowledgeStorage__AllowedReadOrigins__0=
KnowledgeStorage__MaxSourceBytes=26214400
KnowledgeStorage__MaxParsedResultBytes=10485760
KnowledgeStorage__MaxChunkCharacters=6000
KnowledgeStorage__MaxChunksPerDocument=1000
KnowledgeStorage__MinerUPollSeconds=10

MalwareScanner__Host=
MalwareScanner__Port=3310
MalwareScanner__TimeoutSeconds=30

# Pin parser, embedding model and Azure index schema together, for example:
# mineru-2.5.4|bge-m3-sha256-abcd|azure-schema-v1
DocumentIngestion__PipelineVersion=

SmtpSettings__Server=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__SenderName=KPI System
SmtpSettings__SenderEmail=
SmtpSettings__Password=

PasswordReset__PublicBaseUrl=https://your-domain.example
Database__RunMigrationsOnStartup=false
